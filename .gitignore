# weights / caches / secrets
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.sif
__pycache__/
*.py[cod]
.venv/
.env
.env.*
*.key
*.pem
id_rsa*
.netrc
wandb/
.DS_Store
.ipynb_checkpoints/
.claude/
# large raw data stays on /scratch; only manifests are committed
data/raw/
data/processed/
*.parquet
*.arrow
*.tar
*.tar.gz
*.tgz
*.zip
# model weights live on HF Hub, not in git
models/*
!models/README.md
# raw eval outputs (benchmark questions/answers, agent trajectories) are not redistributed;
# results/<group>/<bench>/<run_id>.jsonl (normalized per-task outcomes: ids, status, score, tokens; no benchmark
# question/answer text) and aggregated summaries are committed; raw trajectories stay on the cluster
results/**/trajectories/
results/**/raw/
*.traj
*.traj.json
# ASI-Bench seed31415 ships reference answers: never commit anything from it
*seed31415*/
**/reference/
# job logs (keep the hand-written worklog)
*.log
*.out
*.err
# ...except the training / merge job logs that are part of the experiment records
!logs/train/**/*.out
!logs/merge/**/*.out
!logs/merge/*.log

# evaluation / training logs are part of the deliverable (a few MB in total)
!logs/**/*.log
!logs/**/
!logs/eval/**/*.out
