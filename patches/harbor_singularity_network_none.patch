+def _rmtree_force(path: Path) -> None:
+    """[apex patch] rm -rf that also handles dirs a task made read-only/unsearchable."""
+
+    def onexc(func, p, exc):
+        try:
+            os.chmod(os.path.dirname(p), 0o700)
+            if not os.path.islink(p):
+                os.chmod(p, 0o700)
+            func(p)
+        except OSError:
+            pass
+
+    shutil.rmtree(path, onexc=onexc)
+
+
+def _rootfs_resolve(rootfs: Path, path: str) -> Path:
+    """[apex patch] Resolve `path` inside `rootfs`, following symlinks (absolute ones
+    relative to rootfs, never escaping it), e.g. Alpine /bin/sh -> /bin/busybox."""
+    parts = [p for p in path.split("/") if p not in ("", ".")]
+    cur, hops = rootfs, 0
+    while parts:
+        part = parts.pop(0)
+        if part == "..":
+            cur = cur.parent if cur != rootfs else cur
+            continue
+        nxt = cur / part
+        if nxt.is_symlink():
+            hops += 1
+            if hops > 40:
+                raise OSError(f"too many symlinks resolving {path} in {rootfs}")
+            target = os.readlink(nxt)
+            if target.startswith("/"):
+                cur = rootfs
+            parts = [p for p in target.split("/") if p not in ("", ".")] + parts
+            continue
+        cur = nxt
+    return cur
+
+
+def _elf_interp(path: Path) -> str | None:
+    """[apex patch] PT_INTERP of a 64-bit little-endian ELF ("" if static, None if not ELF64)."""
+    try:
+        with open(path, "rb") as f:
+            eh = f.read(64)
+            if len(eh) < 64 or eh[:4] != b"\x7fELF" or eh[4] != 2 or eh[5] != 1:
+                return None
+            phoff = int.from_bytes(eh[0x20:0x28], "little")
+            phentsize = int.from_bytes(eh[0x36:0x38], "little")
+            phnum = int.from_bytes(eh[0x38:0x3A], "little")
+            for i in range(phnum):
+                f.seek(phoff + i * phentsize)
+                ph = f.read(56)
+                if int.from_bytes(ph[0:4], "little") == 3:  # PT_INTERP
+                    f.seek(int.from_bytes(ph[8:16], "little"))
+                    raw = f.read(int.from_bytes(ph[32:40], "little"))
+                    return raw.rstrip(b"\0").decode("ascii", "replace")
+    except OSError:
+        return None
+    return ""
