+# no python3 installed into the task image). HARBOR_OFFLINE=1 => no egress.
+_USE_HOSTPY=0
+if [ -n "${HARBOR_HOSTPY:-}" ] && [ -x "$HARBOR_HOSTPY" ] \
+   && "$HARBOR_HOSTPY" -c "import uvicorn, fastapi" 2>/dev/null; then
+  _USE_HOSTPY=1
